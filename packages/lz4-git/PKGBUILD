pkgname=lz4
pkgver=1.10.0
pkgrel=4
epoch=1
pkgdesc='Extremely fast compression algorithm'
arch=('x86_64')
url='https://lz4.github.io/lz4/'
license=('GPL-2.0-or-later')
depends=('glibc')
makedepends=('git' 'meson' 'ninja' 'clang' 'llvm' 'lld')
checkdepends=('diffutils')
provides=('liblz4.so')
source=(
  "git+https://github.com/lz4/lz4.git#tag=v$pkgver"
  'ms178-1.patch'
)
sha256sums=(
  '487f9bc24fdaf589e2f4bb23dd98b1f21a71b643db09251145616587c9468555'
  '32b776dbd1ceca57aeb0adaaa2bb878ea0c70f20745fe4de6775bc2e9ceab96f'
)
options=('strip')

_setup_llvm_ultimate() {
  local llvm_root=${LLVM_ULTIMATE_ROOT:-/home/user/llvm-ultimate}
  if [[ -x $llvm_root/bin/clang ]]; then
    export PATH="$llvm_root/bin:$PATH"
    export LD_LIBRARY_PATH="$llvm_root/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  fi

  export CC=clang
  export CXX=clang++
  export AR=llvm-ar
  export NM=llvm-nm
  export RANLIB=llvm-ranlib
  export READELF=llvm-readelf
  export OBJCOPY=llvm-objcopy
  export OBJDUMP=llvm-objdump
  export STRIP=llvm-strip

  local tool
  for tool in clang clang++ ld.lld llvm-ar llvm-profdata llvm-bolt merge-fdata; do
    command -v "$tool" >/dev/null || {
      error "llvm-ultimate tool '$tool' is unavailable"
      return 1
    }
  done
}

# Configure a fresh Meson tree. CFLAGS/CXXFLAGS/LDFLAGS from makepkg.conf are
# retained verbatim; each stage appends only the instrumentation/profile flags
# it needs. --buildtype=plain prevents Meson from overriding the user's -O and
# debug policy.
_setup_stage() {
  local build_dir=$1
  local stage_cflags=$2
  local stage_ldflags=$3
  local build_tests=$4

  CC="$CC" CXX="$CXX" AR="$AR" NM="$NM" RANLIB="$RANLIB" \
  CFLAGS="$stage_cflags" CXXFLAGS="$CXXFLAGS" LDFLAGS="$stage_ldflags" \
    meson setup \
      --prefix=/usr \
      --buildtype=plain \
      --wrap-mode=nofallback \
      -Db_lto=false \
      -Dcontrib=false \
      -Dexamples=false \
      -Dossfuzz=false \
      -Dprograms=true \
      -Dtests="$build_tests" \
      "$srcdir/lz4/build/meson" "$build_dir"
}

_compile_training_targets() {
  local build_dir=$1
  meson compile -C "$build_dir" --jobs "$(nproc)" \
    meson/programs/lz4 \
    meson/tests/datagen \
    meson/tests/fuzzer \
    meson/tests/frametest \
    meson/tests/fullbench \
    meson/tests/decompress-partial.c \
    meson/tests/decompress-partial-usingDict.c \
    meson/tests/checkFrame
}

# Deterministic corpus with six compressibility bands, source/build data,
# dictionaries, tiny inputs and sparse data. It is generated once and reused
# byte-for-byte by IR-PGO, CS-PGO and BOLT so profile differences describe the
# optimizer, not corpus noise.
_generate_training_corpus() {
  local datagen=$1
  local corpus=$2

  [[ -e $corpus/.ready ]] && return 0
  mkdir -p "$corpus"
  local p
  for p in 0 20 40 60 80 100; do
    "$datagen" -g8M -P"$p" -s"$((1789 + p))" > "$corpus/p${p}.bin"
  done
  tar -cf "$corpus/source-tree.tar" -C "$srcdir/lz4" \
    lib programs tests build/cmake build/meson
  head -c 65536 "$corpus/source-tree.tar" > "$corpus/dictionary.bin"
  : > "$corpus/empty"
  printf 'x' > "$corpus/one-byte"
  printf 'The quick brown fox jumps over the lazy dog. %.0s' {1..2000} \
    > "$corpus/small-text"
  truncate -s 32M "$corpus/sparse.bin"
  printf 'sparse-tail\n' | dd of="$corpus/sparse.bin" bs=1 \
    seek=$((32 * 1024 * 1024 - 12)) conv=notrunc status=none
  touch "$corpus/.ready"
}

_run_training_workload() {
  local lz4=$1
  local datagen=$2
  local tests_dir=$3
  local root=$4
  local corpus="$srcdir/training-corpus"
  local out="$root/out"
  local roundtrip="$root/roundtrip"

  _generate_training_corpus "$datagen" "$corpus"
  rm -rf "$out" "$roundtrip"
  mkdir -p "$out" "$roundtrip"

  _run_pair() {
    local tag=$1 input=$2
    shift 2
    "$lz4" -q -f "$@" "$input" "$out/$tag.lz4"
    "$lz4" -q -t "$out/$tag.lz4"
    "$lz4" -q -d -f "$out/$tag.lz4" "$roundtrip/$tag"
    cmp -s "$input" "$roundtrip/$tag"
  }

  # Common fast frames and decompression are intentionally weighted above HC.
  local pass
  for pass in 1 2 3; do
    _run_pair "fast-p20-$pass" "$corpus/p20.bin" -1 -T1
    _run_pair "fast-p40-$pass" "$corpus/p40.bin" -1 -T1
    _run_pair "fast-p60-$pass" "$corpus/p60.bin" -1 -T1
    _run_pair "fast-p80-$pass" "$corpus/p80.bin" -1 -T1
    _run_pair "ultra3-$pass" "$corpus/p40.bin" --fast=3 -T1
    _run_pair "ultra9-$pass" "$corpus/p60.bin" --fast=9 -T1
    _run_pair "mt-auto-$pass" "$corpus/source-tree.tar" -1 -T0
    _run_pair "mt-four-$pass" "$corpus/sparse.bin" -1 -T4
    "$lz4" -q -t "$out/fast-p40-$pass.lz4"
    "$lz4" -q -dc "$out/fast-p40-$pass.lz4" > /dev/null
    "$lz4" -q -dc "$out/fast-p60-$pass.lz4" > /dev/null
    "$lz4" -q -dc "$out/mt-auto-$pass.lz4" > /dev/null
  done

  # Frame/block variants and edge inputs.
  _run_pair b4 "$corpus/p40.bin" -1 -B4 -BI
  _run_pair b5-dependent "$corpus/p60.bin" -3 -B5 -BD
  _run_pair b6-checksums "$corpus/p80.bin" -1 -B6 -BX
  _run_pair b7-no-frame-crc "$corpus/p20.bin" -1 -B7 --no-frame-crc
  _run_pair content-size "$corpus/source-tree.tar" -1 --content-size
  _run_pair sparse "$corpus/sparse.bin" -1 --sparse
  _run_pair legacy "$corpus/p60.bin" -l -1
  _run_pair empty "$corpus/empty" -1
  _run_pair one-byte "$corpus/one-byte" -1
  _run_pair small "$corpus/small-text" -1

  # Every materially different HC strategy, plus decompression-speed bias.
  _run_pair hc3 "$corpus/p40.bin" -3 -T1
  _run_pair hc4 "$corpus/p60.bin" -4 -T1
  _run_pair hc6 "$corpus/p40.bin" -6 -T1
  _run_pair hc9 "$corpus/p60.bin" -9 -T1
  _run_pair hc10 "$corpus/p40.bin" -10 -T1
  _run_pair hc11 "$corpus/p60.bin" -11 -T1
  _run_pair hc12 "$corpus/p40.bin" -12 -T1
  _run_pair hc12-dec-speed "$corpus/p60.bin" -12 --favor-decSpeed -T1

  "$lz4" -q -f -1 -D "$corpus/dictionary.bin" \
    "$corpus/source-tree.tar" "$out/dict.lz4"
  "$lz4" -q -t -D "$corpus/dictionary.bin" "$out/dict.lz4"
  "$lz4" -q -d -f -D "$corpus/dictionary.bin" \
    "$out/dict.lz4" "$roundtrip/dict"
  cmp -s "$corpus/source-tree.tar" "$roundtrip/dict"

  "$lz4" -q -1 < "$corpus/p40.bin" > "$out/pipe.lz4"
  "$lz4" -q -dc "$out/pipe.lz4" > "$roundtrip/pipe"
  cmp -s "$corpus/p40.bin" "$roundtrip/pipe"
  cat "$out/fast-p20-1.lz4" "$out/fast-p80-1.lz4" > "$out/concatenated.lz4"
  "$lz4" -q -t "$out/concatenated.lz4"
  "$lz4" -q -dc "$out/concatenated.lz4" > /dev/null
  "$lz4" --list "$out/content-size.lz4" > /dev/null

  "$lz4" -V > /dev/null
  "$lz4" -H > /dev/null 2>&1
  "$lz4" -b1 -e4 -i1 "$corpus/p40.bin" > /dev/null 2>&1
  "$lz4" -b9 -e10 -i1 "$corpus/p60.bin" > /dev/null 2>&1

  # These executables cover raw blocks, streaming dictionaries, partial decode,
  # malformed input, frame state transitions and every public codec family.
  if [[ ${BOLT_TRAIN_ONLY:-0} != 1 ]]; then
    "$tests_dir/fuzzer" -i12000 -s1789 > /dev/null
    "$tests_dir/frametest" -i6000 -s1789 > /dev/null
    "$tests_dir/fullbench" --no-prompt -i1 "$corpus/p40.bin" > /dev/null
    "$tests_dir/decompress-partial.c" > /dev/null
    "$tests_dir/decompress-partial-usingDict.c" > /dev/null
    "$tests_dir/checkFrame" > /dev/null
  fi
}

# Upstream's CLI regression scripts provide hard-to-synthesize parser, failure,
# multi-file, skippable-frame, pass-through and alias-name paths. Multi-gigabyte
# stress-only scripts are deliberately excluded: they add counts, not coverage.
_run_cli_regression_suite() {
  local lz4=$1
  local datagen=$2
  local work=$3
  local tools="$work/tools"
  mkdir -p "$tools"
  ln -sfn "$lz4" "$tools/lz4"
  ln -sfn "$lz4" "$tools/lz4cat"
  ln -sfn "$lz4" "$tools/unlz4"
  ln -sfn "$datagen" "$tools/datagen"

  local test
  local tests=(
    test-lz4-dict.sh
    test-lz4-contentSize.sh
    test-lz4-frame-concatenation.sh
    test-lz4-multiple.sh
    test-lz4-multiple-legacy.sh
    test-lz4-skippable.sh
    test-lz4-sparse.sh
    test-lz4-testmode.sh
    test-lz4-basic.sh
    test-lz4-opt-parser.sh
  )
  for test in "${tests[@]}"; do
    (cd "$srcdir/lz4/tests" && PATH="$tools:$PATH" "./$test")
  done
}

_merge_profraw() {
  local input_dir=$1 output=$2
  local profiles=()
  mapfile -d '' profiles < <(find "$input_dir" -type f -name '*.profraw' -print0)
  ((${#profiles[@]})) || {
    error "no raw profiles were produced in $input_dir"
    return 1
  }
  llvm-profdata merge -sparse "${profiles[@]}" -o "$output"
}

prepare() {
  cd "$srcdir/lz4" || return
  patch -Np1 -i "$srcdir/ms178-1.patch"
}

build() {
  _setup_llvm_ultimate

  local user_cflags=$CFLAGS
  local user_ldflags="$LDFLAGS -fuse-ld=lld"
  local pgo_dir="$srcdir/pgo"
  local cs_dir="$srcdir/cspgo"
  local pgo_profile="$srcdir/pgo.profdata"
  local combined_profile="$srcdir/combined.profdata"
  local pgo_build="$srcdir/build-pgo"
  local cs_build="$srcdir/build-cspgo"
  local final_build="$srcdir/build"

  rm -rf "$pgo_dir" "$cs_dir" "$pgo_build" "$cs_build" "$final_build" \
    "$srcdir/training-work-pgo" "$srcdir/training-work-cs" \
    "$srcdir/training-work-bolt" "$srcdir/bolt-prof"
  mkdir -p "$pgo_dir" "$cs_dir"

  msg 'Building IR-PGO instrumentation stage'
  _setup_stage "$pgo_build" \
    "$user_cflags -fprofile-generate=$pgo_dir -Xclang -mllvm -Xclang -runtime-counter-relocation" \
    "$user_ldflags -fprofile-generate=$pgo_dir -Xclang -mllvm -Xclang -runtime-counter-relocation" true
  _compile_training_targets "$pgo_build"
  LLVM_PROFILE_FILE="$pgo_dir/%m_%p.profraw" \
    _run_training_workload \
      "$pgo_build/meson/programs/lz4" \
      "$pgo_build/meson/tests/datagen" \
      "$pgo_build/meson/tests" "$srcdir/training-work-pgo"
  LLVM_PROFILE_FILE="$pgo_dir/%m_%p.profraw" \
    _run_cli_regression_suite \
      "$pgo_build/meson/programs/lz4" \
      "$pgo_build/meson/tests/datagen" "$srcdir/training-work-pgo/cli-tests"
  _merge_profraw "$pgo_dir" "$pgo_profile"
  llvm-profdata show --detailed-summary "$pgo_profile"

  msg 'Building context-sensitive PGO instrumentation stage'
  _setup_stage "$cs_build" \
    "$user_cflags -fprofile-use=$pgo_profile -fcs-profile-generate=$cs_dir -Xclang -mllvm -Xclang -runtime-counter-relocation" \
    "$user_ldflags -fprofile-use=$pgo_profile -fcs-profile-generate=$cs_dir -Xclang -mllvm -Xclang -runtime-counter-relocation" true
  _compile_training_targets "$cs_build"
  LLVM_PROFILE_FILE="$cs_dir/%m_%p.profraw" \
    _run_training_workload \
      "$cs_build/meson/programs/lz4" \
      "$cs_build/meson/tests/datagen" \
      "$cs_build/meson/tests" "$srcdir/training-work-cs"
  LLVM_PROFILE_FILE="$cs_dir/%m_%p.profraw" \
    _run_cli_regression_suite \
      "$cs_build/meson/programs/lz4" \
      "$cs_build/meson/tests/datagen" "$srcdir/training-work-cs/cli-tests"

  local cs_profiles=()
  mapfile -d '' cs_profiles < <(find "$cs_dir" -type f -name '*.profraw' -print0)
  ((${#cs_profiles[@]})) || {
    error 'CS-PGO did not produce any raw profiles'
    return 1
  }
  llvm-profdata merge -sparse "$pgo_profile" "${cs_profiles[@]}" \
    -o "$combined_profile"
  llvm-profdata show --detailed-summary "$combined_profile"

  msg 'Building the final CS-PGO optimized binaries'
  _setup_stage "$final_build" \
    "$user_cflags -fprofile-use=$combined_profile" \
    "$user_ldflags -fprofile-use=$combined_profile -Wl,--emit-relocs" false
  meson compile -C "$final_build" --jobs "$(nproc)"

  local final_lz4="$final_build/meson/programs/lz4"
  local bolt_dir="$srcdir/bolt-prof"
  local instrumented="$srcdir/lz4.bolt.instrumented"
  local bolt_profile="$srcdir/lz4.fdata"
  mkdir -p "$bolt_dir"

  msg 'Instrumenting and training the final executable for BOLT'
  llvm-bolt "$final_lz4" -o "$instrumented" \
    --instrument \
    --instrumentation-file="$bolt_dir/lz4.fdata" \
    --instrumentation-file-append-pid \
    --instrumentation-binpath="$instrumented"
  BOLT_TRAIN_ONLY=1 _run_training_workload \
    "$instrumented" "$pgo_build/meson/tests/datagen" \
    "$pgo_build/meson/tests" "$srcdir/training-work-bolt"
  _run_cli_regression_suite \
    "$instrumented" "$pgo_build/meson/tests/datagen" \
    "$srcdir/training-work-bolt/cli-tests"

  local fdata=()
  mapfile -d '' fdata < <(find "$bolt_dir" -type f -name '*.fdata' -print0)
  ((${#fdata[@]})) || {
    error 'BOLT instrumentation did not produce any profiles'
    return 1
  }
  merge-fdata "${fdata[@]}" > "$bolt_profile"
  [[ -s $bolt_profile ]] || {
    error 'merged BOLT profile is empty'
    return 1
  }

  # The executable is far smaller than a huge page, hence --no-huge-pages.
  # The remaining passes all changed code/layout in llvm-ultimate testing and
  # survived the complete round-trip/regression workload. Risky ICP, aggressive
  # ICF, jump-table footprint reduction, hugify and speculative inlining were
  # measured or rejected rather than enabled blindly.
  msg 'Applying validated BOLT post-link optimizations'
  llvm-bolt "$final_lz4" -o "$srcdir/lz4.bolt" \
    --data="$bolt_profile" \
    --no-huge-pages \
    --reorder-blocks=ext-tsp \
    --reorder-functions=cdsort \
    --split-functions \
    --split-all-cold \
    --split-eh \
    --icf=safe \
    --plt=hot \
    --reg-reassign \
    --frame-opt=hot \
    --dyno-stats \
    --print-profile-stats \
    --verify-cfg
  chmod --reference="$final_lz4" "$srcdir/lz4.bolt"
  mv -f "$srcdir/lz4.bolt" "$final_lz4"

  "$final_lz4" -q -f -1 "$srcdir/training-corpus/p40.bin" \
    "$srcdir/bolt-final-check.lz4"
  "$final_lz4" -q -t "$srcdir/bolt-final-check.lz4"
  "$final_lz4" -q -dc "$srcdir/bolt-final-check.lz4" | \
    cmp -s - "$srcdir/training-corpus/p40.bin"
}

check() {
  _setup_llvm_ultimate
  local lz4="$srcdir/build/meson/programs/lz4"
  local datagen="$srcdir/build-pgo/meson/tests/datagen"
  [[ -x $lz4 && -x $datagen ]]

  _run_cli_regression_suite "$lz4" "$datagen" "$srcdir/final-cli-tests"
  "$srcdir/build-pgo/meson/tests/fuzzer" -i20000 -s1789 > /dev/null
  "$srcdir/build-pgo/meson/tests/frametest" -i10000 -s1789 > /dev/null
}

package() {
  meson install -C "$srcdir/build" --destdir "$pkgdir"
}

