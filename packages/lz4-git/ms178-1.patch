--- a/lib/lz4hc.c
+++ b/lib/lz4hc.c
@@ -244,9 +244,20 @@ static void LZ4HC_clearTables (LZ4HC_CCtx_internal* hc4)
     MEM_INIT(hc4->chainTable, 0xFF, sizeof(hc4->chainTable));
 }
 
+/* A fresh or reset context has two null pointers: do not subtract them. */
+static size_t LZ4HC_prefixSize(const LZ4HC_CCtx_internal* hc4)
+{
+    if (hc4->prefixStart == NULL) {
+        assert(hc4->end == NULL);
+        return 0;
+    }
+    assert(hc4->end >= hc4->prefixStart);
+    return (size_t)(hc4->end - hc4->prefixStart);
+}
+
 static void LZ4HC_init_internal (LZ4HC_CCtx_internal* hc4, const BYTE* start)
 {
-    size_t const bufferSize = (size_t)(hc4->end - hc4->prefixStart);
+    size_t const bufferSize = LZ4HC_prefixSize(hc4);
     size_t newStartingOffset = bufferSize + hc4->dictLimit;
     DEBUGLOG(5, "LZ4HC_init_internal");
     assert(newStartingOffset >= bufferSize);  /* check overflow */
@@ -1700,8 +1711,7 @@ void LZ4_resetStreamHC_fast (LZ4_streamHC_t* LZ4_streamHCPtr, int compressionLev
     LZ4HC_CCtx_internal* const s = &LZ4_streamHCPtr->internal_donotuse;
     DEBUGLOG(5, "LZ4_resetStreamHC_fast(%p, %d)", LZ4_streamHCPtr, compressionLevel);
     /* also after a failed compression : its positions are below @end, hence out of reach of the next stream */
-    assert(s->end >= s->prefixStart);
-    s->dictLimit += (U32)(s->end - s->prefixStart);
+    s->dictLimit += (U32)LZ4HC_prefixSize(s);
     s->prefixStart = NULL;
     s->end = NULL;
     s->dictCtx = NULL;
@@ -1850,7 +1860,7 @@ int LZ4_compress_HC_continue_destSize (LZ4_streamHC_t* LZ4_streamHCPtr, const ch
 int LZ4_saveDictHC (LZ4_streamHC_t* LZ4_streamHCPtr, char* safeBuffer, int dictSize)
 {
     LZ4HC_CCtx_internal* const streamPtr = &LZ4_streamHCPtr->internal_donotuse;
-    int const prefixSize = (int)(streamPtr->end - streamPtr->prefixStart);
+    int const prefixSize = (int)LZ4HC_prefixSize(streamPtr);
     DEBUGLOG(5, "LZ4_saveDictHC(%p, %p, %d)", LZ4_streamHCPtr, safeBuffer, dictSize);
     /* nothing compressed yet (new or reset stream) : nothing to save,
      * the stream remains to be initialized by next compression (attached dictionary included) */
