+            dst_idx += copy_count;
+            if (dst_idx >= dst_range_size)
+            {
+                dst_idx = 0;
+                ++dst_range_idx;
+            }
+
+            src_idx += copy_count;
+            if (src_idx >= src_range_size)
+            {
+                src_idx = 0;
+                ++src_range_idx;
+            }
