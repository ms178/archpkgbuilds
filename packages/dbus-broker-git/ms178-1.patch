+static void test_acct_ffi_quota(void) {
+        AcctCharge charge = ACCT_CHARGE_INIT;
+        AcctActor *actor;
+        AcctUser *user;
+        Acct *acct;
+        int r;
+
+        r = acct_new(&acct, &(acct_value_t[_ACCT_SLOT_N]){});
+        c_assert(!r);
+        r = acct_ref_user(acct, &user, 1);
+        c_assert(!r);
+        r = acct_user_new_actor(user, &actor);
+        c_assert(!r);
+
+        acct_charge_init(&charge);
+
+        /* A rejected charge must not consume the borrowed user and actor
+         * references at the C/Rust boundary. Repeat the call so sanitizers
+         * catch a premature release immediately. */
+        r = acct_user_charge(
+                user,
+                &charge,
+                actor,
+                &(acct_value_t[_ACCT_SLOT_N]){ [ACCT_SLOT_BYTES] = 1 }
+        );
+        c_assert(r == ACCT_E_QUOTA);
+        r = acct_user_charge(
+                user,
+                &charge,
+                actor,
+                &(acct_value_t[_ACCT_SLOT_N]){ [ACCT_SLOT_BYTES] = 1 }
+        );
+        c_assert(r == ACCT_E_QUOTA);
+
+        acct_charge_deinit(&charge);
+        acct_actor_unref(actor);
+        acct_user_unref(user);
+        acct_free(acct);
+}
+
 int main(int argc, char **argv) {
         test_setup();
         test_quota();
         test_overflow();
+        test_acct_ffi_quota();
         return 0;
 }
