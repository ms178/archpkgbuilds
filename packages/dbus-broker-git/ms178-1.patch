+static void test_quota_cleanup(void) {
+        unsigned int maxima[_USER_SLOT_N] = {};
+        UserRegistry users;
+        ReplyRegistry replies;
+        ReplyOwner owner;
+        ReplySlot *slot = NULL;
+        User *user;
+        int r;
+
+        r = user_registry_init(&users, NULL, _USER_SLOT_N, maxima);
+        c_assert(!r);
+        r = user_registry_ref_user(&users, &user, 1);
+        c_assert(!r);
+        reply_registry_init(&replies);
+        reply_owner_init(&owner);
+
+        r = reply_slot_new(&slot, &replies, &owner, user, NULL, 1, 1);
+        c_assert(r == REPLY_E_QUOTA);
+        c_assert(!slot);
+
+        reply_owner_deinit(&owner);
+        reply_registry_deinit(&replies);
+        user_unref(user);
+        user_registry_deinit(&users);
+}
+
