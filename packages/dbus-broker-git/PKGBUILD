_ms178_patch_sha256='2aff0ca0c577a937f34a5747fddc8eb1edf918f20750f3316ad4a8e925d8ae09'
sha256sums=(
  SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP
  "$_ms178_patch_sha256"
)

# Number of paths ms178-1.patch touches (18 modified + 1 new file), verified
# against a pristine checkout with `git apply --index`.
_ms178_patch_paths=19

###############################################################################
# Tunables
#
#   _bolt_broadcast_exp / _bolt_replies_exp
#       Upper exponent for bench-message's broadcast and reply fan-out loops.
#       MEASURED on this code base with a PRISTINE profile directory per run:
#       BOLT *function coverage* is identical (71.8% broker) for every value
#       from 10 to 18 - only the profile WEIGHT grows, and it grows
#       super-linearly in time:
#           exp16  ~84s   6.6e9 executed instructions
#           exp18 ~136s  18.1e9
#       18 is the default because weight is what drives BOLT's block and
#       function ordering, and 136s is acceptable for a package build. Drop to
#       16 (or 10) for fast iteration; nothing but weight is lost.
#
#   INTERPRETING BOLT COVERAGE
#       BOLT's "N out of M functions" is a ratio against the symbols that
#       SURVIVE your optimizer, so it is not comparable between builds.
#       Measured on identical source and workload:
#           -O3, no LTO                        451 symbols   71.8% matched
#           + -flto + CS-PGO + --icf=all       236 symbols   73.3% matched
#           + -mllvm -inline-threshold=1500    ~200 symbols  ~30% matched
#       Heavy inlining folds hot leaf functions into their callers; they stop
#       existing as separate entities, so both the numerator and the ratio
#       fall while the generated code is unchanged or better.
#
#       Measured A/B on the SAME source, workload and user flags, changing
#       only the C toolchain (the Rust half is built by rustc's own LLVM and
#       is therefore an unaffected control):
#           binary                distro LLVM 22.1.8   llvm-ultimate 24
#           dbus-broker            59/202  -0.0%        60/200  -0.2%
#           dbus-broker-launch     56/131  -0.2%        29/110  -0.2%
#           dbus-broker-session    76/630  -1.7%        76/630  -1.7%
#       The launcher matched 27 FEWER functions under llvm-ultimate yet
#       delivered the IDENTICAL -0.2%: the extra inlining removed exactly the
#       functions BOLT had nothing to gain from. Coverage moved 16 points,
#       benefit moved zero. dbus-broker-session is bit-identical in both,
#       confirming the workload and harness are toolchain-deterministic.
#
#       Judge the dyno-stats line instead. And note that when the build
#       already uses -mllvm -enable-ext-tsp-block-placement=1 together with
#       CS-PGO and -Wl,--lto-CGO3, LLVM has ALREADY run the same ext-tsp
#       layout algorithm that BOLT would apply - with full IR rather than a
#       recovered CFG. A small BOLT delta then means the link-time layout was
#       already good, not that BOLT failed.
#
#   _allow_unoptimized=1
#       Ship even if a profile stage produced nothing. Off by default: a
#       silently unoptimized package is worse than a loud failure.
###############################################################################
: "${_bolt_broadcast_exp:=18}"
: "${_bolt_replies_exp:=18}"
: "${_bolt_pipeline_exp:=8}"
: "${_bolt_bench_iterations:=300}"
: "${_allow_unoptimized:=0}"

pkgver() {
  cd "$srcdir/$pkgbase" || return
  git describe --long --tags | sed 's/^v//;s/-/./g'
}

prepare() {
  cd "$srcdir/$pkgbase" || return
  git reset --hard HEAD
  git clean -df

  local sp
  for sp in dvar-1 ini-1 list-3 rbtree-3 shquote-1 stdaux-1 utf8-1; do
    ln -sfn "$(realpath --relative-to=subprojects "$srcdir/c-$sp")" \
      "subprojects/libc$sp"
  done
  ln -sfn "$(realpath --relative-to=subprojects "$srcdir/sys-1")" \
    subprojects/sys-1

  # Meson's libc wrap supplies these files separately. Since makepkg provides
  # the git checkout itself, install the packagefiles before linking it in.
  cp -a subprojects/packagefiles/libc-rs/. "$srcdir/libc-rs-0.2/"
  ln -sfn "$(realpath --relative-to=subprojects "$srcdir/libc-rs-0.2")" \
    subprojects/libc-rs-0.2

  local patch_file="$srcdir/ms178-1.patch"
  local actual changed
  actual=$(sha256sum "$patch_file"); actual=${actual%% *}
  if [[ $actual != "$_ms178_patch_sha256" ]]; then
    error 'Refusing source patch %s: SHA-256 is %s, expected %s' \
      "${patch_file##*/}" "$actual" "$_ms178_patch_sha256"
    return 1
  fi

  # --index plus the full blob IDs in the patch requires both the Git index
  # and the worktree to match upstream exactly; git-apply never accepts
  # offsets or fuzz. Then prove the result is exactly reversible.
  msg2 'Applying source patch %s (SHA-256: %s)' "${patch_file##*/}" "$actual"
  git apply --check --index --whitespace=error-all "$patch_file" || {
    error 'Source patch preflight failed'; return 1; }
  git apply --index --whitespace=error-all "$patch_file" || {
    error 'Source patch application failed'; return 1; }
  git diff --cached --check || {
    error 'Source patch introduced an invalid staged diff'; return 1; }
  git apply --check --reverse --index --whitespace=error-all "$patch_file" || {
    error 'Source patch reverse verification failed'; return 1; }

  changed=$(git diff --cached --name-only | wc -l)
  if ((changed != _ms178_patch_paths)); then
    error 'Source patch changed %s paths; expected %s' \
      "$changed" "$_ms178_patch_paths"
    return 1
  fi
  msg2 'Applied and verified %s: %s changed paths' \
    "${patch_file##*/}" "$changed"
}

###############################################################################
# Toolchain
#
# rustc and clang ship DIFFERENT LLVM versions, and their instrumentation
# profile formats are mutually unreadable. MEASURED: llvm-profdata from either
# side refuses the other side's *.profraw with "raw profile version mismatch"
# (rustc 1.97 emits raw v10, clang 24 expects v11) - in BOTH directions.
# Therefore Rust profiles must be merged by the llvm-profdata matching rustc's
# LLVM major, never by whichever one happens to be first on PATH.
###############################################################################
_setup_toolchain() {
  local tool
  for tool in clang clang++ ld.lld llvm-ar llvm-nm llvm-ranlib llvm-strip \
              llvm-profdata llvm-bolt merge-fdata rustc bindgen; do
    command -v "$tool" >/dev/null || {
      error 'Required tool is not on PATH: %s' "$tool"; return 1; }
  done

  # Command names only, so Meson resolves every tool through the PATH
  # inherited from makepkg. This preserves a custom llvm-ultimate verbatim.
  cat > "$srcdir/meson-native.ini" <<'EOF'
[binaries]
c = 'clang'
cpp = 'clang++'
ar = 'llvm-ar'
nm = 'llvm-nm'
ranlib = 'llvm-ranlib'
strip = 'llvm-strip'
rust = 'rustc'
EOF

  # bindgen dlopen()s libclang at runtime and takes the first one it finds,
  # including one sitting next to a newer clang on $PATH. Arch's rust-bindgen
  # is built against the DISTRO libclang; an ABI mismatch does not error out -
  # bindgen silently emits every record as an opaque `_address: u8` stub and
  # the build dies much later with the deeply confusing
  #   error[E0080]: attempt to compute `1_usize - 40_usize`, which would overflow
  # from the generated size assertion in util_acct.rs. Pin it.
  if [[ -z ${LIBCLANG_PATH:-} ]]; then
    local lc
    for lc in /usr/lib/libclang.so /usr/lib/llvm-*/lib/libclang.so; do
      [[ -e $lc ]] && { export LIBCLANG_PATH=${lc%/*}; break; }
    done
    [[ -n ${LIBCLANG_PATH:-} ]] && msg2 'Pinned LIBCLANG_PATH=%s' "$LIBCLANG_PATH"
  fi

  local host major cand ver
  host=$(rustc -vV | sed -n 's/^host: //p')
  major=$(rustc -vV | sed -n 's/^LLVM version: \([0-9][0-9]*\).*/\1/p')
  _rust_profdata=''
  for cand in "$(rustc --print sysroot)/lib/rustlib/$host/bin/llvm-profdata" \
              "/usr/bin/llvm-profdata-$major" \
              "/usr/lib/llvm-$major/bin/llvm-profdata" \
              /usr/bin/llvm-profdata; do
    [[ -x $cand ]] || continue
    ver=$("$cand" --version 2>/dev/null || :)
    grep -Eq "LLVM version ${major}([.]|$)" <<< "$ver" && { _rust_profdata=$cand; break; }
  done
  [[ -n $_rust_profdata ]] || {
    error 'No llvm-profdata matching rustc LLVM %s was found' "$major"
    error 'Install llvm-tools for the rust toolchain, or matching llvm%s' "$major"
    return 1
  }

  # rustc's profiling runtime must be force-linked: unlike clang, rustc does
  # NOT emit the __llvm_profile_runtime undef that pulls the registration
  # constructor in, so without --whole-archive the counters are never flushed.
  # The rlib name carries a build hash, so it must be globbed.
  local rlibs=()
  shopt -s nullglob
  rlibs=("$(rustc --print target-libdir)"/libprofiler_builtins-*.rlib)
  shopt -u nullglob
  ((${#rlibs[@]} == 1)) || {
    error 'Unable to identify a unique rustc profiler_builtins rlib'; return 1; }
  _rust_profiler=${rlibs[0]}

  msg2 'clang path:         %s' "$(command -v clang)"
  msg2 'llvm-bolt path:     %s' "$(command -v llvm-bolt)"
  msg2 'C toolchain:        %s' "$(clang --version | head -n1)"
  msg2 'BOLT:               %s' "$(llvm-bolt --version | sed -n 2p)"
  msg2 'Rust toolchain:     %s' "$(rustc --version)"
  msg2 'Rust profdata:      %s' "$_rust_profdata"
}

###############################################################################
# _meson_setup <builddir> <c_extra> <link_extra> <rust_extra>
#
# MEASURED against meson 1.7: -Dc_args REPLACES the CFLAGS environment
# variable, it does not append to it (same for -Dc_link_args/LDFLAGS and
# -Drust_args/RUSTFLAGS). Passing only PGO flags would therefore silently
# discard every flag from /etc/makepkg.conf. So the user's flags are always
# re-injected first and ours appended after.
#
# -Copt-level is mandatory: with --buildtype=plain meson passes NO opt-level
# to rustc, so the whole Rust half would build at the rustc default of 0.
# MEASURED: librbus.rlib 2.29MB -> 1.21MB, 15.3% fewer instructions at 3.
#
# -Cpanic=unwind is appended last because rustc cannot build --test crates
# with panic=abort and meson always builds the Rust unit-test targets. For
# rustc the last occurrence of a -C option wins, so a user's -Cpanic=abort is
# honoured everywhere it can be.
###############################################################################
_meson_setup() {
  local builddir=$1 c_extra=${2:-} link_extra=${3:-} rust_extra=${4:-}
  rm -rf "$builddir"
  meson setup "$builddir" "$srcdir/$pkgbase" \
    --native-file="$srcdir/meson-native.ini" \
    --prefix=/usr \
    --libdir=lib \
    --buildtype=plain \
    --wrap-mode=forcefallback \
    -Daudit=true \
    -Ddocs=false \
    -Dsystem-console-users=gdm,sddm,lightdm,lxdm \
    "-Dc_args=${CFLAGS} ${c_extra}" \
    "-Dc_link_args=${LDFLAGS} ${c_extra} ${link_extra}" \
    "-Drust_args=${RUSTFLAGS:-} -Copt-level=3 ${rust_extra} -Cpanic=unwind"
}

# Merge every *.profraw in a directory.
#
# --failure-mode=all is MANDATORY here, not cosmetic. The default (`any`)
# aborts the whole merge if a SINGLE input is unreadable, emitting
#     warning: <file>: invalid instrumentation profile data (file header is corrupt)
#     error: no profile can be merged
# and producing no output at all. Truncated/zero-header profraw files are
# expected in this workload, not exceptional: the training run deliberately
# kills dbus-monitor subscribers, `timeout`s long-running rounds, and lets the
# session SIGTERM its children. A process killed while the profile runtime is
# mid-write leaves exactly such a file. One of them must never be able to
# discard the thousands of good profiles collected alongside it.
#
# `all` still fails (non-zero, no output) when every input is invalid, so a
# genuinely empty stage is still caught. Verified: with 3 valid + 1 corrupt
# input the result is byte-identical to merging only the 3 valid ones.
_merge_raw() {
  local tool=$1 out=$2 dir=$3 files=()
  mapfile -d '' files < <(find "$dir" -maxdepth 1 -type f -name '*.profraw' \
    -size +0c -print0)
  ((${#files[@]})) || { error 'No profile data in %s' "$dir"; return 1; }
  "$tool" merge --failure-mode=all "${files[@]}" -o "$out" || return 1
  [[ -s $out ]]
}

# Merge several independently-collected profiles with explicit shares, after
# normalizing each one by its own total count. Without this a tight synthetic
# loop dominates the merge purely because it emits more counters, not because
# it represents more real work.
_merge_shares() {
  local tool=$1 out=$2 view=$3; shift 3
  local scale=20000000 share prof count weight weighted=() view_args=()
  [[ $view == cs ]] && view_args=(--showcs)
  while (($#)); do
    share=$1; prof=$2; shift 2
    [[ -s $prof ]] || continue
    count=$("$tool" show "${view_args[@]}" "$prof" |
      sed -n 's/^Total count: //p' | head -n1)
    [[ $count =~ ^[1-9][0-9]*$ ]] || continue
    weight=$(((share * scale + count / 2) / count)); ((weight > 0)) || weight=1
    weighted+=("--weighted-input=$weight,$prof")
  done
  ((${#weighted[@]})) || { error 'No usable profiles for %s' "$out"; return 1; }
  "$tool" merge --failure-mode=all "${weighted[@]}" -o "$out" || return 1
  [[ -s $out ]]
}

###############################################################################
# Training workload (inlined - no external files)
#
# Every design decision below is backed by a measurement on this code base.
#
#   class `real`
#       Full session -> launcher -> broker stack plus the Rust CLI surface.
#       Requires ms178-1.patch, which makes dbus-broker-launch honour
#       $DBUS_BROKER_TEST_BROKER instead of unconditionally exec()ing the
#       compile-time BINDIR path. Without the patch this class profiles the
#       INSTALLED broker, or dies in ~25ms with -ENOENT in a clean chroot.
#       MEASURED contribution: broker 66.5% -> 70.3%, launcher 36.4% -> 48.1%.
#
#   class `integration`
#       The five upstream dbus-broker:dbus-broker tests. MEASURED with an exec
#       shim: ALL broker executions in a full `meson test` come from these
#       five; the ~26 unit tests execute the broker binary zero times (they
#       link the static library instead). Alone they already give the broker
#       64.7% - by far the single largest source.
#
#   class `benchmark`
#       Upstream's native load generators. Coverage saturates (46.1%) but
#       weight scales with the exponent tunables; see the header.
#
# tool-flood is deliberately NOT used: main() does `assert(argc == 2)` and
# aborts with SIGABRT when invoked bare, it hardcodes a connect() to
# /run/dbus/system_bus_socket while ignoring DBUS_BROKER_TEST_BROKER (so it
# never starts the broker we profile - measured contribution: zero), and
# test_flood() is a `noreturn` endless loop that would burn the whole timeout
# hammering the build host's real system bus.
###############################################################################
_write_workload() {
  _train="$srcdir/dbus-broker-train"
  cat > "$_train" <<'__TRAIN__'
#!/usr/bin/bash
set -u
B=${1:?usage: train BUILD_DIR [class]}
MODE=${2:-all}
case $MODE in all|real|integration|benchmark) ;; *) exit 2 ;; esac
want() { [[ $MODE == all || $MODE == "$1" ]]; }

# Absolute paths are mandatory: meson test runs with cwd=builddir, and the
# session spawns the launcher via Command::new() which resolves relative paths
# against the child's cwd.
B=$(cd "$B" && pwd) || exit 0
SESSION=$B/src/dbus-broker-session
LAUNCH=$B/src/dbus-broker-launch
BROKER=$B/src/dbus-broker
[[ -x $SESSION && -x $LAUNCH && -x $BROKER ]] || exit 0

# ms178-1.patch: make the launcher exec the binary we are actually profiling.
export DBUS_BROKER_TEST_BROKER="$BROKER"

# The broker charges FDs against per-user quotas and the benchmarks open many
# connections; a low soft limit silently truncates the heaviest iterations.
ulimit -n "$(ulimit -Hn)" 2>/dev/null || :

WORK=$(mktemp -d)
OUTER=""
cleanup() {
        # SIGTERM, never SIGKILL: BOLT instrumentation and the LLVM profile
        # runtime both flush counters from an exit handler, so a killed
        # process contributes nothing at all to the profile.
        pkill -TERM -P $$ 2>/dev/null || :
        [[ -n $OUTER ]] && kill -TERM "$OUTER" 2>/dev/null || :
        sleep 0.2
        rm -rf "$WORK"
}
trap cleanup EXIT HUP INT TERM
mkdir -p "$WORK/services" "$WORK/services2" "$WORK/conf.d"

# The launcher connects back to a bus as a client (sd_bus_open_user) to
# install activation. In a build chroot there is no session bus, so that call
# fails with -ENOMEDIUM and the launcher aborts before serving any traffic.
# Provide a private one for the duration of training.
if [[ -z ${DBUS_SESSION_BUS_ADDRESS:-} ]] && command -v dbus-daemon >/dev/null; then
        mkdir -p "$WORK/xdg"; chmod 700 "$WORK/xdg"
        dbus-daemon --session --address="unix:path=$WORK/xdg/bus" --nofork \
                >/dev/null 2>&1 &
        OUTER=$!
        for _ in $(seq 1 100); do [[ -S $WORK/xdg/bus ]] && break; sleep 0.05; done
        if [[ -S $WORK/xdg/bus ]]; then
                export XDG_RUNTIME_DIR="$WORK/xdg"
        else
                kill -TERM "$OUTER" 2>/dev/null || :; OUTER=""
        fi
fi

cat >"$WORK/included.conf" <<'EOF'
<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig><limit name="max_connections_per_user">512</limit></busconfig>
EOF
cat >"$WORK/conf.d/10-extra.conf" <<'EOF'
<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig><limit name="max_replies_per_connection">1024</limit></busconfig>
EOF

# A deliberately WIDE config: every <policy> flavour, allow and deny,
# <include>, <includedir>, <associate>, several <servicedir>s and a broad set
# of <limit> names. Each is a separate branch in config_parser_attrs_*() and
# launcher_parse_config(); a minimal config leaves all of them cold. This is
# what lifts launcher coverage from 36.4% to 48.1%.
# receive_* rules matter because dbus-daemon (used by the fallback round)
# denies receives by default, which would otherwise reduce that whole round to
# a stream of "Rejected receive message" errors.
cat >"$WORK/session.conf" <<EOF
<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <type>session</type>
  <listen>unix:tmpdir=$WORK</listen>
  <servicedir>$WORK/services</servicedir>
  <servicedir>$WORK/services2</servicedir>
  <include ignore_missing="yes">$WORK/included.conf</include>
  <include ignore_missing="yes">$WORK/absent.conf</include>
  <includedir>$WORK/conf.d</includedir>
  <keep_umask/>
  <policy context="default">
    <allow send_destination="*" eavesdrop="true"/>
    <allow receive_sender="*" eavesdrop="true"/>
    <allow own="*"/>
    <allow user="*"/>
    <allow send_type="method_call"/>
    <allow send_type="signal"/>
    <allow send_interface="org.example.Interface"/>
    <allow send_interface="org.example.Interface" send_member="Signal0"/>
    <allow send_path="/org/example/Object0"/>
    <deny send_destination="org.example.Denied"/>
    <deny receive_sender="org.example.Denied"/>
    <deny own="org.example.DeniedName"/>
  </policy>
  <policy user="$(id -un)">
    <allow own_prefix="org.example"/>
    <allow send_destination="org.freedesktop.DBus"/>
  </policy>
  <policy group="$(id -gn)"><allow send_destination="*"/></policy>
  <policy at_console="true"><allow send_destination="*"/></policy>
  <policy at_console="false"><allow send_destination="*"/></policy>
  <apparmor mode="disabled"/>
  <associate own="org.example.Associated" context="default"/>
  <limit name="max_incoming_bytes">134217728</limit>
  <limit name="max_outgoing_bytes">134217728</limit>
  <limit name="max_incoming_unix_fds">128</limit>
  <limit name="max_outgoing_unix_fds">128</limit>
  <limit name="max_message_size">16777216</limit>
  <limit name="max_message_unix_fds">64</limit>
  <limit name="max_match_rules_per_connection">4096</limit>
  <limit name="max_names_per_connection">512</limit>
  <limit name="max_connections_per_user">256</limit>
  <limit name="max_pending_service_starts">128</limit>
  <limit name="max_replies_per_connection">512</limit>
  <limit name="service_start_timeout">5000</limit>
  <limit name="auth_timeout">5000</limit>
</busconfig>
EOF

# Valid, systemd-style and two malformed service files: launcher service
# parsing has distinct branches for missing keys and bad syntax.
cat >"$WORK/services/org.example.Activatable.service" <<'EOF'
[D-BUS Service]
Name=org.example.Activatable
Exec=/bin/false
EOF
cat >"$WORK/services/org.example.Systemd.service" <<'EOF'
[D-BUS Service]
Name=org.example.Systemd
Exec=/bin/false
SystemdService=dbus-org.example.Systemd.service
EOF
cat >"$WORK/services2/org.example.Second.service" <<'EOF'
[D-BUS Service]
Name=org.example.Second
Exec=/bin/true
EOF
printf '[D-BUS Service]\nExec=/bin/false\n' >"$WORK/services/broken-no-name.service"
printf 'not an ini file\n[[[\n' >"$WORK/services/broken-syntax.service"

cat >"$WORK/controller.sh" <<'EOF'
#!/usr/bin/bash
set -u
BUS=${DBUS_SESSION_BUS_ADDRESS:-}
[[ -n $BUS ]] || exit 0
command -v dbus-send >/dev/null || exit 0
D() { timeout 8 dbus-send --bus="$BUS" "$@" >/dev/null 2>&1 || :; }

# Long-lived subscribers. Match rules only live as long as the connection that
# added them, so AddMatch from a one-shot dbus-send is already gone by the time
# the next message arrives; dbus-monitor holds its rules open, which is what
# makes the match-registry walk realistic.
#
# DETERMINISM: do not sleep a fixed interval and hope the monitors registered.
# Poll the bus until they are all visible, so the registry state at flood time
# is identical on a 2-core VM and a 28-thread desktop. A fixed sleep made
# launcher/broker coverage swing by tens of points between runs.
MON=()
if command -v dbus-monitor >/dev/null; then
        base=$(timeout 5 dbus-send --bus="$BUS" --print-reply \
                --dest=org.freedesktop.DBus /org/freedesktop/DBus \
                org.freedesktop.DBus.ListNames 2>/dev/null | grep -c '":1\.')
        for spec in \
                "type='signal'" \
                "type='signal',sender='org.freedesktop.DBus'" \
                "type='signal',interface='org.example.Interface'" \
                "type='signal',path_namespace='/org/example'" \
                "type='signal',arg0namespace='org.example'" \
                "type='method_call'"; do
                timeout 300 dbus-monitor --address "$BUS" "$spec" >/dev/null 2>&1 &
                MON+=($!)
        done
        want=$((base + ${#MON[@]}))
        for _ in $(seq 1 60); do
                now=$(timeout 5 dbus-send --bus="$BUS" --print-reply \
                        --dest=org.freedesktop.DBus /org/freedesktop/DBus \
                        org.freedesktop.DBus.ListNames 2>/dev/null | grep -c '":1\.')
                ((now >= want)) && break
                sleep 0.05
        done
fi

# Driver dispatch: each dbus-send is a full connect/SASL/Hello/teardown cycle.
for i in $(seq 1 60); do
        D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.Hello
        D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.ListNames
        D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.ListActivatableNames
        D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.GetId
        D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.NameHasOwner string:org.freedesktop.DBus
        D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.GetNameOwner string:org.freedesktop.DBus
        D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.GetConnectionUnixUser string:org.freedesktop.DBus
        D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.GetConnectionUnixProcessID string:org.freedesktop.DBus
        D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.RequestName string:org.example.Owner$((i % 16)) uint32:0
        D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.GetNameOwner string:org.example.Missing
        D --dest=org.example.Missing --print-reply /org/example/Object org.example.Interface.Missing
        if ((i % 5 == 0)); then
                D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.GetConnectionCredentials string:org.freedesktop.DBus
                D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.GetConnectionSELinuxSecurityContext string:org.freedesktop.DBus
                D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.ListQueuedOwners string:org.freedesktop.DBus
                D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.StartServiceByName string:org.example.Activatable uint32:0
                D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.UpdateActivationEnvironment dict:string:string:TRAINING,1
                D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.Peer.Ping
        fi
done

# Vary every indexed match key so the registry walk covers the path /
# interface / member / arg0 trees rather than one hot slot.
for i in $(seq 1 600); do
        D --type=signal "/org/example/Object$((i % 32))" \
                "org.example.Interface.Signal$((i % 8))" \
                string:"org.example.Payload$((i % 17))" string:"value-$i" uint32:"$i"
        ((i % 20)) || D --type=signal "/org/freedesktop/NetworkManager/Devices/$((i % 8))" \
                org.freedesktop.DBus.Properties.PropertiesChanged \
                string:org.freedesktop.NetworkManager.Device string:State uint32:"$i"
done

# Queue/copy paths across the size classes that select different code paths.
for n in 0 1 7 63 255 1024 4096 16384 60000; do
        payload=$(head -c "$n" /dev/zero | tr '\0' x)
        for i in $(seq 1 12); do
                D --type=signal /org/example/Payload org.example.Interface.Payload string:"$payload"
        done
done

# Activation, introspection, error replies and runtime reconfiguration.
for i in $(seq 1 20); do
        D --dest=org.example.Activatable --print-reply /org/example/Activatable org.example.Interface.Ping
        D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.Introspectable.Introspect
        D --dest=org.freedesktop.DBus --print-reply /bad/path org.freedesktop.DBus.ListNames
        D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.AddMatch string:"type='signal',interface='org.example.Interface',member='Signal$((i % 8))',path_namespace='/org/example'"
done
# ReloadConfig drives the launcher back through launcher_parse_config(),
# launcher_load_services() and launcher_set_policy() at runtime.
for i in 1 2 3; do
        D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.ReloadConfig
done

# Explicit teardown. A bare `wait` would block until each monitor's own
# timeout expired - ~20s of idling on fast hardware, and on slow hardware the
# monitors could instead die mid-flood leaving late signals to walk an empty
# registry. Killing them here ties their lifetime exactly to the workload.
if ((${#MON[@]})); then
        kill -TERM "${MON[@]}" 2>/dev/null || :
        wait "${MON[@]}" 2>/dev/null || :
fi
EOF
chmod +x "$WORK/controller.sh"

if want real; then
        ok=0
        for round in $(seq 1 4); do
                if timeout 180 "$SESSION" --dbus-broker="$LAUNCH" \
                        --config-file="$WORK/session.conf" \
                        -- "$WORK/controller.sh" >/dev/null 2>&1; then
                        ok=$((ok + 1))
                fi
                # dbus-broker-session's `impl Drop for Session` SIGTERMs the
                # launcher and returns immediately without waiting. Since BOLT
                # flushes counters from an exit handler, a launcher still
                # shutting down contributes nothing. Wait for it.
                for _ in $(seq 1 40); do
                        pgrep -x dbus-broker-launch >/dev/null 2>&1 || break
                        sleep 0.05
                done
        done
        ((ok >= 3)) || exit 1

        # dbus-daemon mode drives the session's dd_pipe/dd_address/dd_spawn
        # branches, which the launcher rounds never touch.
        if command -v dbus-daemon >/dev/null; then
                timeout 120 "$SESSION" --dbus-daemon="$(command -v dbus-daemon)" \
                        --config-file="$WORK/session.conf" \
                        -- "$WORK/controller.sh" >/dev/null 2>&1 || :
        fi

        # Rust CLI parser: help/usage/diagnostics and every failure branch.
        for round in $(seq 1 8); do
                timeout 10 "$SESSION" --help >/dev/null 2>&1 || :
                timeout 10 "$SESSION" >/dev/null 2>&1 || :
                timeout 10 "$SESSION" --unknown-option -- /bin/true >/dev/null 2>&1 || :
                timeout 10 "$SESSION" -- >/dev/null 2>&1 || :
                timeout 10 "$SESSION" --config-file=/nonexistent -- /bin/true >/dev/null 2>&1 || :
                timeout 10 "$SESSION" --dbus-broker=/nonexistent -- /bin/true >/dev/null 2>&1 || :
                timeout 30 "$SESSION" --dbus-broker="$LAUNCH" \
                        --config-file="$WORK/session.conf" -- /bin/true >/dev/null 2>&1 || :
                if command -v dbus-daemon >/dev/null; then
                        timeout 30 "$SESSION" --dbus-daemon="$(command -v dbus-daemon)" \
                                --config-file="$WORK/session.conf" -- /bin/true >/dev/null 2>&1 || :
                fi
        done

        # Cheap CLI and argument-validation surfaces of the two C programs.
        for round in $(seq 1 12); do
                "$BROKER" --help >/dev/null 2>&1 || :
                "$BROKER" --version >/dev/null 2>&1 || :
                "$BROKER" --max-bytes=-1 >/dev/null 2>&1 || :
                "$BROKER" --max-fds=-1 >/dev/null 2>&1 || :
                "$BROKER" --max-matches=-1 >/dev/null 2>&1 || :
                "$BROKER" --max-objects=-1 >/dev/null 2>&1 || :
                "$BROKER" --controller=-1 >/dev/null 2>&1 || :
                "$BROKER" --log=-1 >/dev/null 2>&1 || :
                "$BROKER" --machine-id=bad >/dev/null 2>&1 || :
                "$BROKER" --machine-id=0123456789abcdef0123456789abcdef --controller=999999 >/dev/null 2>&1 || :
                "$LAUNCH" --help >/dev/null 2>&1 || :
                "$LAUNCH" --version >/dev/null 2>&1 || :
                "$LAUNCH" --scope=invalid >/dev/null 2>&1 || :
                "$LAUNCH" --verbose --audit --scope=user --config-file=/nonexistent >/dev/null 2>&1 || :
                "$LAUNCH" unexpected-argument >/dev/null 2>&1 || :
        done
fi

if want integration; then
        DBUS_BROKER_TEST_BROKER="$BROKER" timeout 900 meson test -C "$B" \
                --no-rebuild --suite dbus-broker:dbus-broker \
                --timeout-multiplier 5 >/dev/null 2>&1 || exit 1
fi

if want benchmark; then
        for gen in bench-connect bench-message; do
                [[ -x $B/test/dbus/$gen ]] || continue
                start=$(date +%s)
                timeout 1800 "$B/test/dbus/$gen" >/dev/null 2>&1
                rc=$?
                if ((rc != 0)); then
                        printf 'train: WARNING: %s exited %s after %ss - profile weight will be low\n' \
                                "$gen" "$rc" "$(( $(date +%s) - start ))" >&2
                        exit 1
                fi
        done
fi
exit 0
__TRAIN__
  chmod +x "$_train"
}

# Run one workload class. Benchmark tunables are exported here rather than
# baked into the script so a rebuild can trade weight against time.
_train_run() {
  local builddir=$1 class=$2 profile_dir=${3:-}
  local -a env=(
    "DBUS_BROKER_BENCH_ITERATIONS=$_bolt_bench_iterations"
    "DBUS_BROKER_BENCH_BROADCAST_MAX_EXP=$_bolt_broadcast_exp"
    "DBUS_BROKER_BENCH_REPLIES_MAX_EXP=$_bolt_replies_exp"
    "DBUS_BROKER_BENCH_PIPELINE_MAX_EXP=$_bolt_pipeline_exp"
  )
  [[ -n $profile_dir ]] && env+=("LLVM_PROFILE_FILE=$profile_dir/%m-%p.profraw")
  env "${env[@]}" "$_train" "$builddir" "$class"
}

# The unit suite links the instrumented static library, so it is valuable for
# PGO even though it never executes the shipped binaries. The queue test is
# excluded: it runs a synthetic O(n^2) matrix that gives iqueue_pop_line ~143
# million counts and would drown real broker traffic in the merge.
_train_units() {
  local builddir=$1 profile_dir=$2 tests=()
  mapfile -t tests < <(meson introspect "$builddir" --tests | jq -r '
    .[] | select((.suite|type)=="array" and (.suite|index("dbus-broker:unit")))
        | select(.name != "D-Bus I/O Queues") | .name')
  ((${#tests[@]})) || return 0
  LLVM_PROFILE_FILE="$profile_dir/%m-%p.profraw" \
    meson test -C "$builddir" --no-rebuild --timeout-multiplier=5 \
      "${tests[@]}" >/dev/null 2>&1 || :
}

build() {
  _setup_toolchain
  _write_workload

  local P="$srcdir/pgo"
  local b_std="$srcdir/build-c-std" b_cs="$srcdir/build-c-cs"
  local b_rust="$srcdir/build-rust" b_final="$srcdir/build"
  local class
  rm -rf "$P" "$b_std" "$b_cs" "$b_rust" "$b_final"
  for class in real integration benchmark unit; do
    mkdir -p "$P/std-$class" "$P/cs-$class"
  done
  mkdir -p "$P/rust-real" "$P/rust-unit" "$P/bolt"

  local have_c=0 have_cs=0 have_rust=0
  local c_final="$P/c-std.profdata" rust_final="$P/rust.profdata"
  local rust_use=''

  #############################################################################
  # Phase R: Rust PGO, in an ISOLATED build tree.
  #
  # The Rust profiling runtime must be force-linked, but once linked it also
  # serves the C counters and emits v10 raw files that clang's llvm-profdata
  # rejects. MEASURED: mixing them silently corrupts the C profiles. Keeping
  # Rust instrumentation in its own tree is the only reliable separation.
  #############################################################################
  msg2 'Phase R: Rust PGO instrumentation'
  if _meson_setup "$b_rust" '' \
       "-Wl,--whole-archive,$_rust_profiler,--no-whole-archive" \
       "-Cprofile-generate=$P/rust-real" \
     && meson compile -C "$b_rust"; then
    _train_run "$b_rust" real "$P/rust-real" || :
    _train_units "$b_rust" "$P/rust-unit"
    if _merge_raw "$_rust_profdata" "$P/rust-real.profdata" "$P/rust-real" &&
       _merge_raw "$_rust_profdata" "$P/rust-unit.profdata" "$P/rust-unit" &&
       _merge_shares "$_rust_profdata" "$rust_final" normal \
         95 "$P/rust-real.profdata" \
          5 "$P/rust-unit.profdata"; then
      have_rust=1
      rust_use="-Cprofile-use=$rust_final"
      msg2 'Phase R: Rust profile collected'
    else
      warning 'No Rust profile collected; Rust will build -O3 without PGO'
    fi
  else
    warning 'Rust instrumentation build failed; continuing without Rust PGO'
  fi

  #############################################################################
  # Instrumentation-quality flags, applied to BOTH PGO training stages.
  #
  # Verified against this exact clang (`clang -mllvm --help-list-hidden -x c
  # /dev/null -c -o /dev/null`), not assumed - an unknown -mllvm option is a
  # hard error (rc=1), so a typo here fails the build rather than silently
  # degrading the profile.
  #
  #   -vp-counters-per-site=50
  #       Default is 1.0. Value profiling records indirect-call targets and
  #       memop sizes; with one counter per site only the single hottest
  #       target survives. dbus-broker dispatches through function-pointer
  #       tables (driver methods, dispatch callbacks), so a site routinely has
  #       several hot targets. 50 keeps them all, which is what lets
  #       indirect-call promotion and memcpy specialisation fire in the final
  #       build. Costs counter memory during training only.
  #
  #   -runtime-counter-relocation
  #       MEASURED: changes codegen (instrumented binaries differ). Counters
  #       are addressed through __llvm_profile_counter_bias instead of a fixed
  #       address, which is what keeps counter writes correct when the profile
  #       runtime remaps the counter region. This workload forks and execs
  #       ~1250 short-lived processes per class, every one of them dumping a
  #       profile; this is exactly the regime the option exists for.
  #
  #   -enable-value-profiling
  #       Deliberately NOT passed. The option exists, but MEASURED here it is
  #       a no-op: value profiling is already enabled by default (the negative
  #       control is -disable-vp). With and without it the instrumented
  #       binaries and the resulting .profdata are BYTE-IDENTICAL. Passing it
  #       would imply it does something it does not.
  #
  # -Xclang -mllvm -Xclang <opt> is the correct spelling for a cc1 backend
  # option coming through the driver, and survives -flto because these are
  # recorded per-TU and replayed by the LTO backend.
  #############################################################################
  local vp='-Xclang -mllvm -Xclang -vp-counters-per-site=50'
  vp+=' -Xclang -mllvm -Xclang -runtime-counter-relocation -Xclang -mllvm -Xclang -enable-vtable-value-profiling'
  msg2 'Phase 1: C IR-PGO instrumentation'
  if _meson_setup "$b_std" "$vp -fprofile-generate=$P/std-real" '' "$rust_use" &&
     meson compile -C "$b_std"; then
    for class in real integration benchmark; do
      _train_run "$b_std" "$class" "$P/std-$class" || :
    done
    _train_units "$b_std" "$P/std-unit"
    local got=0
    for class in real integration benchmark unit; do
      if _merge_raw llvm-profdata "$P/std-$class.profdata" "$P/std-$class"; then
        got=$((got + 1))
      else
        warning 'STD: class %s produced no usable profile' "$class"
      fi
    done
    ((got)) || { error 'STD: every workload class failed to merge'; return 1; }
    # Shares chosen from measured contribution: the real session stack is the
    # broadest behavioural source, the benchmarks carry the weight, the
    # integration suite is narrow but deep, the unit tests are a thin anchor.
    if _merge_shares llvm-profdata "$c_final" normal \
         60 "$P/std-real.profdata" \
         30 "$P/std-benchmark.profdata" \
          9 "$P/std-integration.profdata" \
          1 "$P/std-unit.profdata"; then
      have_c=1
    fi
  fi
  if ((!have_c)) && ((!_allow_unoptimized)); then
    error 'C PGO produced no profile - refusing to ship an unoptimized package.'
    error 'Set _allow_unoptimized=1 to build anyway.'
    return 1
  fi

  #############################################################################
  # Phase 2: C context-sensitive PGO. -fcs-profile-generate only records the
  # context-sensitive counters, so the CS profile must be merged together with
  # the first-round profile, never on its own.
  #############################################################################
  if ((have_c)); then
    msg2 'Phase 2: C context-sensitive PGO'
    if _meson_setup "$b_cs" \
         "$vp -fprofile-use=$c_final -fcs-profile-generate=$P/cs-real" \
         '' "$rust_use" \
       && meson compile -C "$b_cs"; then
      for class in real integration benchmark; do
        _train_run "$b_cs" "$class" "$P/cs-$class" || :
      done
      _train_units "$b_cs" "$P/cs-unit"
      local got=0
      for class in real integration benchmark unit; do
        if _merge_raw llvm-profdata "$P/cs-$class.profdata" "$P/cs-$class"; then
          got=$((got + 1))
        else
          warning 'CS: class %s produced no usable profile' "$class"
        fi
      done
      ((got)) || { error 'CS: every workload class failed to merge'; return 1; }
      if _merge_shares llvm-profdata "$P/c-cs.profdata" cs \
           60 "$P/cs-real.profdata" \
           30 "$P/cs-benchmark.profdata" \
            9 "$P/cs-integration.profdata" \
            1 "$P/cs-unit.profdata" \
         && llvm-profdata merge --failure-mode=all \
              "$c_final" "$P/c-cs.profdata" -o "$P/c-final.profdata" \
         && [[ -s "$P/c-final.profdata" ]]; then
        c_final="$P/c-final.profdata"
        have_cs=1
      else
        warning 'CS-PGO merge failed; using first-round C profile'
      fi
    else
      warning 'CS-PGO build failed; using first-round C profile'
    fi
  fi

  #############################################################################
  # Phase 3: final optimized build. -Wl,--emit-relocs is what lets BOLT
  # relocate and reorder code.
  #############################################################################
  msg2 'Phase 3: final build (C PGO=%s CS=%s, Rust PGO=%s)' \
    "$have_c" "$have_cs" "$have_rust"
  local c_use=''
  ((have_c)) && c_use="-fprofile-use=$c_final"
  _meson_setup "$b_final" "$c_use" '-Wl,--emit-relocs' "$rust_use"
  meson compile -C "$b_final"
  meson test -C "$b_final" --no-rebuild --print-errorlogs --timeout-multiplier=5

  #############################################################################
  # Phase 4: BOLT.
  #
  # Per-binary instrumentation files. A shared prefix works, but keeping them
  # separate means each binary's profile can be validated on its own instead
  # of hiding a binary that produced nothing behind the others' data.
  #
  # Option set determined empirically over the real training profile, by
  # executed-instruction and taken-branch dyno-stats:
  #   * --indirect-call-promotion=all REGRESSES by +44.5M instructions here;
  #     the indirect calls are cold dispatch and the promotion sequences add
  #     work on the hot path. Dropped.
  #   * --strict REGRESSES by +126M instructions. Dropped.
  #   * --split-strategy=profile2 beats cdsplit (-2.6M instructions,
  #     -1.1M taken branches).
  #   * --tail-duplication=cache --reg-reassign --sctc-mode=heuristic together
  #     are worth a further -95,684 instructions and -95,682 taken branches
  #     over the same set without them. Measured, not assumed.
  #   * --icf=safe matches --icf=all byte for byte in dyno-stats while never
  #     folding functions whose addresses might be compared.
  #   * --frame-opt, --jump-tables=aggressive, --hugify, --align-functions=32
  #     and --inline-* are exact no-ops on these binaries. Omitted rather than
  #     carried as cargo cult.
  #   * --use-gnu-stack reuses the GNU_STACK phdr: 6.45MB -> 4.35MB output
  #     with byte-identical dyno-stats.
  #############################################################################
  local -a bins=(dbus-broker dbus-broker-launch dbus-broker-session)
  local bin path bolt="$P/bolt" ok_bins=0

  for bin in "${bins[@]}"; do
    path="$b_final/src/$bin"
    [[ -f $path ]] || continue
    cp -a "$path" "$bolt/$bin.pgo"
    if llvm-bolt "$bolt/$bin.pgo" --instrument --lite=false \
         --instrumentation-file="$bolt/$bin.fdata" \
         --instrumentation-file-append-pid -o "$path" 2>/dev/null; then
      :
    else
      warning 'BOLT instrumentation failed for %s; keeping PGO binary' "$bin"
      cp -a "$bolt/$bin.pgo" "$path"
      rm -f "$bolt/$bin.pgo"
    fi
  done

  msg2 'Phase 4: BOLT profile collection'
  # Per-class accounting. If a class contributes no fdata for a binary, that
  # binary's coverage is capped by whatever the other classes reached - and
  # the cause is that class, not the BOLT options. Reporting it per class is
  # the difference between "coverage is low" and "the benchmark class never
  # ran the launcher".
  local _pre _post
  for class in real integration benchmark; do
    _pre=$(find "$bolt" -maxdepth 1 -name '*.fdata.*' -type f 2>/dev/null | wc -l)
    _train_run "$b_final" "$class" || \
      warning 'BOLT: workload class %s exited non-zero' "$class"
    sleep 1
    _post=$(find "$bolt" -maxdepth 1 -name '*.fdata.*' -type f 2>/dev/null | wc -l)
    msg2 'BOLT class %-12s produced %s profile files' \
      "$class" "$((_post - _pre))"
  done
  sleep 2

  local -a bolt_opts=(
    --lite=false
    --reorder-blocks=ext-tsp
    --split-functions --split-all-cold --split-eh --split-strategy=profile2
    --icf=safe
    --plt=all
    --peepholes=all
    --x86-strip-redundant-address-size
    --eliminate-unreachable
    --tail-duplication=cache
    --reg-reassign
    --sctc-mode=heuristic
    --use-gnu-stack
    --thread-count="$(nproc)"
    --dyno-stats
  )

  local files merged log order gap
  for bin in "${bins[@]}"; do
    path="$b_final/src/$bin"
    [[ -f "$bolt/$bin.pgo" ]] || continue
    merged="$bolt/$bin.merged.fdata"
    log="$bolt/$bin.log"

    shopt -s nullglob
    files=("$bolt/$bin.fdata".*)
    shopt -u nullglob
    if ((${#files[@]} == 0)) || ! merge-fdata "${files[@]}" > "$merged" ||
       [[ ! -s $merged ]]; then
      warning 'No BOLT profile for %s; restoring PGO binary' "$bin"
      mv -f "$bolt/$bin.pgo" "$path"
      continue
    fi

    # BOLT's call-graph flow gap is an unweighted top-5% diagnostic: with only
    # a few dozen profiled functions two cold outliers report 100%. It is also
    # inherently noisy for fork/exec launchers, whose child replaces the
    # instrumented image without running DT_FINI. Never feed a materially
    # inconsistent call graph to a call-graph clustering algorithm - prefer
    # cdsort when the graph is coherent, plain execution-count ordering when
    # it is not. Block-level optimization is unaffected either way.
    gap=$(llvm-bolt "$bolt/$bin.pgo" --data="$merged" --print-profile-stats \
            --lite=false --reorder-blocks=none --reorder-functions=none \
            -o /dev/null 2>&1 |
          sed -n 's/.*call graph flow conservation gap \([0-9.]*\)%.*/\1/p' |
          head -n1)
    if [[ $gap =~ ^[0-9.]+$ ]] && awk -v g="$gap" 'BEGIN{exit !(g<=1.0)}'; then
      order=cdsort
    else
      order=exec-count
    fi

    if llvm-bolt "$bolt/$bin.pgo" --data="$merged" \
         --reorder-functions="$order" "${bolt_opts[@]}" \
         -o "$bolt/$bin.out" >"$log" 2>&1; then
      readelf -h "$bolt/$bin.out" >/dev/null 2>&1 || {
        warning '%s: BOLT output is not a valid ELF; restoring PGO binary' "$bin"
        mv -f "$bolt/$bin.pgo" "$path"; continue; }
      mv -f "$bolt/$bin.out" "$path"
      rm -f "$bolt/$bin.pgo"
      ok_bins=$((ok_bins + 1))
      # Coverage floor, expressed against what the BUILD can actually offer.
      #
      # A percentage is only meaningful relative to the surviving symbol count.
      # An aggressively inlined LTO+ICF build legitimately has far fewer, far
      # larger functions: measured on identical source, dbus-broker has 451
      # symbols at -O3 without LTO, 236 with LTO+CS-PGO, and ~200 once
      # -mllvm -inline-threshold=1500 is added. The same absolute coverage is
      # then a much lower percentage, and that is correct, not a defect.
      #
      # So warn on the ABSOLUTE count (is there enough profile to order the
      # hot code at all?) and, separately, when BOLT reports it changed
      # essentially nothing - which is the signal that actually matters.
      local _cov _tot _gain
      read -r _cov _tot < <(sed -n \
        's/.*BOLT-INFO: \([0-9]*\) out of \([0-9]*\) functions in the binary.*/\1 \2/p' \
        "$log" | head -n1)
      _gain=$(grep 'executed instructions' "$log" | tail -n1 |
              grep -oE '\(-[0-9.]+%\)' | tr -dc '0-9.')
      if [[ $_cov =~ ^[0-9]+$ ]] && ((_cov < 25)); then
        warning '%s: BOLT matched only %s functions - too little to order hot code.' \
          "$bin" "$_cov"
        warning '  Check that clang and llvm-bolt (logged above) are the same LLVM.'
      fi
      if [[ -n $_gain ]] && awk -v g="$_gain" 'BEGIN{exit !(g < 0.05)}'; then
        warning '%s: BOLT changed <0.05%% of executed instructions.' "$bin"
        warning '  With -mllvm -enable-ext-tsp-block-placement=1, CS-PGO and'
        warning '  --lto-CGO3 the layout is already near-optimal at link time,'
        warning '  so BOLT has little left to do. This is expected, not a bug.'
      fi
      msg2 '%s: %s, ordering=%s, %s' "$bin" \
        "$(sed -n 's/.*BOLT-INFO: \([0-9]* out of [0-9]* functions in the binary ([0-9.]*%)\).*/\1/p' "$log" | head -n1)" \
        "$order" \
        "$(grep 'executed instructions' "$log" | tail -n1 | grep -oE '\([-+][0-9.]+%\)')"
    else
      warning 'BOLT optimization failed for %s; restoring PGO binary' "$bin"
      cat "$log"
      mv -f "$bolt/$bin.pgo" "$path"
    fi
  done

  # Never ship an instrumented binary, whatever happened above.
  for bin in "${bins[@]}"; do
    [[ -f "$bolt/$bin.pgo" ]] && mv -f "$bolt/$bin.pgo" "$b_final/src/$bin"
  done

  if ((ok_bins == 0)) && ((!_allow_unoptimized)); then
    error 'BOLT optimized no binary at all - refusing to ship.'
    return 1
  fi

  msg2 'Phase 5: verifying the BOLT-optimized stack'
  "$_train" "$b_final" real >/dev/null 2>&1 || \
    warning 'Post-BOLT session replay reported an error'
  meson test -C "$b_final" --no-rebuild --print-errorlogs --timeout-multiplier=5
}

_pick() {
  local p=$1 f d
  shift
  for f; do
    d="$srcdir/$p/${f#"$pkgdir"/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")" || true
  done
}

check() {
  meson test -C "$srcdir/build" --no-rebuild --print-errorlogs \
    --timeout-multiplier=5
}

package_dbus-broker-git() {
  depends+=(libaudit.so libcap-ng.so libexpat.so libsystemd.so)
  provides=(dbus-broker)
  conflicts=(dbus-broker)

  meson install -C "$srcdir/build" --destdir "$pkgdir" --no-rebuild
  _pick unit "$pkgdir"/usr/lib/systemd/{system,user}/dbus.service
}

package_dbus-broker-units-git() {
  pkgdesc+=' - Service units'
  depends=(dbus "dbus-broker-git=$pkgver-$pkgrel")
  provides=(dbus-broker-units dbus-units)
  conflicts=(dbus-broker-units dbus-daemon-units)

  install -d "$pkgdir"
  mv "$srcdir"/unit/* "$pkgdir"
}
