pkgbase=dbus-broker-git
pkgname=(
  dbus-broker-git
  dbus-broker-units-git
)
pkgver=37.102.g2956b5d
pkgrel=3
pkgdesc='Linux D-Bus Message Broker'
arch=(x86_64)
url='https://github.com/bus1/dbus-broker/wiki'
license=(GPL-3.0-or-later)
depends=(
  'audit>=3.0'
  'expat>=2.2'
  glibc
  'libcap-ng>=0.6'
  libgcc
  'systemd-libs>=230'
)
makedepends=(
  bolt
  clang
  dbus
  git
  jq
  lld
  llvm
  'meson>=1.3'
  mimalloc
  ninja
  procps-ng
  python
  rust
  rust-bindgen
  systemd
)
source=(
  "$pkgbase::git+https://github.com/bus1/dbus-broker"
  'c-dvar-1::git+https://github.com/c-util/c-dvar#branch=v1'
  'c-ini-1::git+https://github.com/c-util/c-ini#branch=v1'
  'c-list-3::git+https://github.com/c-util/c-list#branch=v3'
  'c-rbtree-3::git+https://github.com/c-util/c-rbtree#branch=v3'
  'c-shquote-1::git+https://github.com/c-util/c-shquote#branch=v1'
  'c-stdaux-1::git+https://github.com/c-util/c-stdaux#branch=v1'
  'c-utf8-1::git+https://github.com/c-util/c-utf8#branch=v1'
  'libc-rs-0.2::git+https://github.com/rust-lang/libc#branch=libc-0.2'
  'sys-1::git+https://github.com/bus1/sys#branch=v1'
  ms178-1.patch
)
_ms178_patch_sha256='2aff0ca0c577a937f34a5747fddc8eb1edf918f20750f3316ad4a8e925d8ae09'
sha256sums=(
  SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP
  "$_ms178_patch_sha256"
)

pkgver() {
  cd "$srcdir/$pkgbase" || return
  git describe --long --tags | sed 's/^v//;s/-/./g'
}

prepare() {
  cd "$srcdir/$pkgbase" || return
  git reset --hard HEAD
  git clean -df

  local sp
  for sp in dvar-1 ini-1 list-3 rbtree-3 shquote-1 stdaux-1 utf8-1; do
    ln -sfn "$(realpath --relative-to=subprojects "$srcdir/c-$sp")" \
      "subprojects/libc$sp"
  done
  ln -sfn "$(realpath --relative-to=subprojects "$srcdir/sys-1")" \
    subprojects/sys-1

  # Meson's libc wrap supplies these files separately. Since makepkg provides
  # the git checkout itself, install the packagefiles before linking it in.
  cp -a subprojects/packagefiles/libc-rs/. "$srcdir/libc-rs-0.2/"
  ln -sfn "$(realpath --relative-to=subprojects "$srcdir/libc-rs-0.2")" \
    subprojects/libc-rs-0.2

  local patch_file="$srcdir/ms178-1.patch"
  local actual_patch_sha256 changed_count
  actual_patch_sha256=$(sha256sum "$patch_file")
  actual_patch_sha256=${actual_patch_sha256%% *}
  if [[ $actual_patch_sha256 != "$_ms178_patch_sha256" ]]; then
    error 'Refusing source patch %s: SHA-256 is %s, expected %s' \
      "${patch_file##*/}" "$actual_patch_sha256" "$_ms178_patch_sha256"
    return 1
  fi

  # Keep this deliberately visible in makepkg output. --index plus the full
  # blob IDs in the patch requires both the Git index and worktree to match
  # upstream exactly; git-apply never accepts offsets or fuzz. We then prove
  # the complete patch is reversible from the resulting staged source.
  msg2 'Applying source patch %s (SHA-256: %s)' \
    "${patch_file##*/}" "$actual_patch_sha256"
  if ! git apply --check --index --whitespace=error-all "$patch_file"; then
    error 'Source patch preflight failed: %s' "${patch_file##*/}"
    return 1
  fi
  if ! git apply --index --whitespace=error-all "$patch_file"; then
    error 'Source patch application failed: %s' "${patch_file##*/}"
    return 1
  fi
  if ! git diff --cached --check; then
    error 'Source patch introduced an invalid staged diff: %s' \
      "${patch_file##*/}"
    return 1
  fi
  if ! git apply --check --reverse --index --whitespace=error-all \
      "$patch_file"; then
    error 'Source patch reverse verification failed: %s' \
      "${patch_file##*/}"
    return 1
  fi

  changed_count=$(git diff --cached --name-only | wc -l)
  if ((changed_count != 19)); then
    error 'Source patch verification found %s changed paths; expected 19' \
      "$changed_count"
    return 1
  fi
  msg2 'Applied and verified %s: %s changed paths' \
    "${patch_file##*/}" "$changed_count"
  git diff --cached --stat --no-renames
}

_setup_toolchains() {
  local tool
  local required_tools=(
    clang clang++ ld.lld llvm-ar llvm-nm llvm-ranlib llvm-strip
    llvm-profdata llvm-bolt merge-fdata rustc cargo bindgen
  )

  # The caller supplies llvm-ultimate through PATH. Never guess or override
  # its installation directory; preserve the makepkg environment verbatim.
  for tool in "${required_tools[@]}"; do
    command -v "$tool" >/dev/null || {
      error 'Required tool is not on PATH: %s' "$tool"
      return 1
    }
  done

  # Use command names so Meson resolves every tool through the PATH inherited
  # from makepkg. This preserves the user's llvm-ultimate selection verbatim.
  cat > "$srcdir/meson-native.ini" <<'EOF'
[binaries]
c = 'clang'
cpp = 'clang++'
ar = 'llvm-ar'
nm = 'llvm-nm'
ranlib = 'llvm-ranlib'
strip = 'llvm-strip'
rust = 'rustc'
EOF

  msg2 'C toolchain: %s' "$(clang --version | head -n1)"
  msg2 'BOLT toolchain: %s' "$(llvm-bolt --version | sed -n '1p')"
  msg2 'Rust toolchain: %s' "$(rustc --version)"

  local host rust_llvm_major candidate version
  host=$(rustc -vV | sed -n 's/^host: //p')
  rust_llvm_major=$(rustc -vV | sed -n 's/^LLVM version: \([0-9][0-9]*\).*/\1/p')
  _rust_profdata=''

  # Rust profiles must be merged by llvm-profdata from rustc's LLVM major,
  # not by the llvm-ultimate version that is first on PATH. Prefer a tool
  # shipped in the Rust sysroot, then probe normal Arch LLVM locations.
  for candidate in \
    "$(rustc --print sysroot)/lib/rustlib/$host/bin/llvm-profdata" \
    "/usr/bin/llvm-profdata-$rust_llvm_major" \
    /usr/lib/llvm-"$rust_llvm_major"/bin/llvm-profdata \
    /usr/bin/llvm-profdata; do
    [[ -x $candidate ]] || continue
    version=$($candidate --version 2>/dev/null || :)
    if grep -Eq "LLVM version ${rust_llvm_major}([.]|$)" <<< "$version"; then
      _rust_profdata=$candidate
      break
    fi
  done
  [[ -n $_rust_profdata ]] || {
    error 'No llvm-profdata matching rustc LLVM %s was found' \
      "$rust_llvm_major"
    return 1
  }
  msg2 'Rust profile merger: %s' "$_rust_profdata"
}

_meson_setup() {
  local builddir=$1
  local c_pgo=${2:-}
  local c_link_pgo=${3:-}
  local rust_pgo=${4:-}

  rm -rf "$builddir"

  # rustc stable cannot build --test crates with panic=abort. Meson always
  # builds the Rust unit-test targets, so a trailing unwind override is
  # required when makepkg.conf contains -Cpanic=abort. All other user Rust
  # flags are preserved verbatim.
  meson setup "$builddir" "$srcdir/$pkgbase" \
    --native-file="$srcdir/meson-native.ini" \
    --prefix=/usr \
    --libdir=lib \
    --buildtype=plain \
    --wrap-mode=forcefallback \
    -Daudit=true \
    -Ddocs=false \
    -Dsystem-console-users=gdm,sddm,lightdm,lxdm \
    "-Dc_args=${CFLAGS} ${c_pgo}" \
    "-Dc_link_args=${LDFLAGS} ${c_link_pgo}" \
    "-Drust_args=${RUSTFLAGS:-} ${rust_pgo} -Cpanic=unwind"
}

_merge_raw() {
  local tool=$1 output=$2 directory=$3
  local files=()

  mapfile -d '' files < <(find "$directory" -maxdepth 1 \
    -type f -name '*.profraw' -size +0c -print0)
  ((${#files[@]})) || {
    error 'No profile data was produced in %s' "$directory"
    return 1
  }
  "$tool" merge "${files[@]}" -o "$output"
}

_profile_function_count() {
  local tool=$1 profile=$2
  shift 2
  "$tool" show "$@" "$profile" |
    sed -n 's/^Total functions: //p' | head -n1
}

_profile_nonzero_function_count() {
  local tool=$1 profile=$2
  shift 2
  "$tool" show --all-functions --counts "$@" "$profile" | awk '
    /^  [^ ].*:$/ { in_function = 1; next }
    in_function && /Block counts:/ {
      line = $0
      gsub(/[^0-9]+/, " ", line)
      n = split(line, values, " ")
      for (i = 1; i <= n; ++i) {
        if (values[i] + 0 > 0) {
          ++executed
          break
        }
      }
      in_function = 0
    }
    END { print executed + 0 }'
}

_require_profile() {
  local tool=$1 profile=$2 minimum_nonzero=$3 minimum_percent=$4 label=$5
  shift 5
  local total nonzero

  total=$(_profile_function_count "$tool" "$profile" "$@")
  nonzero=$(_profile_nonzero_function_count "$tool" "$profile" "$@")
  if [[ ! $total =~ ^[1-9][0-9]*$ || ! $nonzero =~ ^[0-9]+$ ]] ||
     ((nonzero < minimum_nonzero || nonzero * 100 < minimum_percent * total)); then
    error '%s profile has %s records/%s executed functions; expected at least %s and %s%%' \
      "$label" "${total:-0}" "${nonzero:-0}" \
      "$minimum_nonzero" "$minimum_percent"
    return 1
  fi
  msg2 '%s profile: %s records, %s executed functions (%s%%)' \
    "$label" "$total" "$nonzero" "$((nonzero * 100 / total))"
}

_run_selected_units() {
  local builddir=$1 profile_dir=$2
  local tests=()

  # The queue unit test intentionally executes a synthetic O(n^2) matrix and
  # gives iqueue_pop_line ~143 million counts.  It is excellent verification,
  # but it overwhelms real broker traffic and is therefore kept out of PGO.
  mapfile -t tests < <(
    meson introspect "$builddir" --tests | jq -r '
      .[] |
      select((.suite | type) == "array" and
             (.suite | index("dbus-broker:unit"))) |
      select(.name != "D-Bus I/O Queues") |
      .name'
  )
  ((${#tests[@]})) || return 1

  LLVM_PROFILE_FILE="$profile_dir/%m-%p.profraw" \
    meson test -C "$builddir" --no-rebuild --print-errorlogs \
      --timeout-multiplier=5 "${tests[@]}"
}

_write_training_workload() {
  _train_script="$srcdir/dbus-broker-train"
  cat > "$_train_script" <<'__DBUS_BROKER_TRAIN__'
#!/usr/bin/bash
set -u

B=${1:?usage: train.sh BUILD_DIR}
MODE=${2:-all}
case $MODE in
        all|real|integration|benchmark) ;;
        *) exit 2 ;;
esac
want() { [[ $MODE == all || $MODE == "$1" ]]; }

SESSION=$B/src/dbus-broker-session
LAUNCH=$B/src/dbus-broker-launch
BROKER=$B/src/dbus-broker

[[ -x $SESSION && -x $LAUNCH && -x $BROKER ]] || exit 0

# The launcher normally executes BINDIR/dbus-broker. Point its explicit test
# hook at the just-built binary so the full stack really profiles this build.
export DBUS_BROKER_TEST_BROKER="$BROKER"

WORK=$(mktemp -d)
cleanup() {
        pkill -P $$ dbus-monitor 2>/dev/null || :
        rm -rf "$WORK"
}
trap cleanup EXIT HUP INT TERM
mkdir -p "$WORK/services"

cat >"$WORK/session.conf" <<EOF
<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <type>session</type>
  <listen>unix:tmpdir=$WORK</listen>
  <servicedir>$WORK/services</servicedir>
  <policy context="default">
    <allow send_destination="*"/>
    <allow own="*"/>
    <allow user="*"/>
  </policy>
  <limit name="max_incoming_bytes">134217728</limit>
  <limit name="max_outgoing_bytes">134217728</limit>
  <limit name="max_message_size">16777216</limit>
  <limit name="max_match_rules_per_connection">4096</limit>
</busconfig>
EOF
cat >"$WORK/services/org.example.Activatable.service" <<'EOF'
[D-BUS Service]
Name=org.example.Activatable
Exec=/bin/false
EOF

cat >"$WORK/controller.sh" <<'EOF'
#!/usr/bin/bash
set -u
BUS=${DBUS_SESSION_BUS_ADDRESS:-}
[[ -n $BUS ]] || exit 0
D() { timeout 8 dbus-send --bus="$BUS" "$@" >/dev/null 2>&1 || :; }

# Keep several broad and indexed match rules live while traffic is generated.
if command -v dbus-monitor >/dev/null; then
        for spec in \
                "type='signal'" \
                "type='signal',sender='org.freedesktop.DBus'" \
                "type='signal',interface='org.example.Interface'" \
                "type='signal',path_namespace='/org/example'" \
                "type='signal',arg0namespace='org.example'" \
                "type='method_call'"; do
                timeout 12 dbus-monitor --address "$BUS" "$spec" >/dev/null 2>&1 &
        done
        sleep 0.15
fi

# Driver dispatch, connection setup/teardown, lookup, ownership and error paths.
for i in $(seq 1 40); do
        D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.Hello
        D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.ListNames
        D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.ListActivatableNames
        D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.GetId
        D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.NameHasOwner string:org.freedesktop.DBus
        D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.GetNameOwner string:org.freedesktop.DBus
        D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.GetConnectionUnixUser string:org.freedesktop.DBus
        D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.GetConnectionUnixProcessID string:org.freedesktop.DBus
        D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.RequestName string:org.example.Owner$((i % 16)) uint32:0
        D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.GetNameOwner string:org.example.Missing
        D --dest=org.example.Missing --print-reply /org/example/Object org.example.Interface.Missing
        if ((i % 5 == 0)); then
                D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.GetConnectionCredentials string:org.freedesktop.DBus
                D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.GetConnectionSELinuxSecurityContext string:org.freedesktop.DBus
                D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.ListQueuedOwners string:org.freedesktop.DBus
                D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.StartServiceByName string:org.example.Activatable uint32:0
                D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.UpdateActivationEnvironment dict:string:string:TRAINING,1
                D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.Peer.Ping
        fi

done

# Vary all match keys and message fields to cover indexed and wildcard routing.
for i in $(seq 1 400); do
        D --type=signal "/org/example/Object$((i % 32))" \
                "org.example.Interface.Signal$((i % 8))" \
                string:"org.example.Payload$((i % 17))" string:"value-$i" uint32:"$i"
        (( i % 20 )) || D --type=signal /org/freedesktop/NetworkManager/Devices/$((i % 8)) \
                org.freedesktop.DBus.Properties.PropertiesChanged \
                string:org.freedesktop.NetworkManager.Device string:State uint32:"$i"
done

# Queue and copy paths from tiny through near-64-KiB payloads.
for n in 0 1 7 63 255 1024 4096 16384 60000; do
        payload=$(head -c "$n" /dev/zero | tr '\0' x)
        for i in $(seq 1 12); do
                D --type=signal /org/example/Payload org.example.Interface.Payload string:"$payload"
        done
done

# Activation request/failure and introspection/error replies.
for i in $(seq 1 16); do
        D --dest=org.example.Activatable --print-reply /org/example/Activatable org.example.Interface.Ping
        D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.Introspectable.Introspect
        D --dest=org.freedesktop.DBus --print-reply /bad/path org.freedesktop.DBus.ListNames
        D --dest=org.freedesktop.DBus --print-reply /org/freedesktop/DBus org.freedesktop.DBus.AddMatch string:"type='signal',interface='org.example.Interface',member='Signal$((i % 8))',path_namespace='/org/example'"
done
wait || :
EOF
chmod +x "$WORK/controller.sh"

if want real; then
# Full Rust session -> launcher -> broker stack. Repetition is intentional: it
# stabilizes edge counts and gives short-lived launcher/session code enough data.
successful_rounds=0
for round in $(seq 1 4); do
        if timeout 120 "$SESSION" \
                --dbus-broker="$LAUNCH" \
                --config-file="$WORK/session.conf" \
                -- "$WORK/controller.sh" >/dev/null 2>&1; then
                successful_rounds=$((successful_rounds + 1))
        fi
done
((successful_rounds >= 3)) || exit 1

# Rust CLI parser and all failure/selection branches, including dbus-daemon mode.
for round in $(seq 1 8); do
        timeout 10 "$SESSION" --help >/dev/null 2>&1 || :
        timeout 10 "$SESSION" >/dev/null 2>&1 || :
        timeout 10 "$SESSION" --unknown-option -- /bin/true >/dev/null 2>&1 || :
        timeout 10 "$SESSION" --config-file=/nonexistent -- /bin/true >/dev/null 2>&1 || :
        timeout 10 "$SESSION" --dbus-broker=/nonexistent -- /bin/true >/dev/null 2>&1 || :
        timeout 20 "$SESSION" --dbus-broker="$LAUNCH" --config-file="$WORK/session.conf" -- /bin/true >/dev/null 2>&1 || :
        if command -v dbus-daemon >/dev/null; then
                timeout 20 "$SESSION" --dbus-daemon="$(command -v dbus-daemon)" --config-file="$WORK/session.conf" -- /bin/true >/dev/null 2>&1 || :
        fi
done
fi

if want integration; then
# Native integration tests exercise malformed protocol, FD passing, quota,
# replies, monitor conversion, match parsing and process-lifetime paths.
DBUS_BROKER_TEST_BROKER="$BROKER" meson test -C "$B" --no-rebuild \
        --suite dbus-broker:dbus-broker --print-errorlogs --timeout-multiplier 5 >/dev/null 2>&1 || exit 1
fi

if want benchmark; then
# Upstream's native load generators keep connections alive and drive far more
# broker work per process than command-line clients. Their normal exhaustive
# ranges remain unchanged; bounded environment overrides are training-only.
if [[ -x $B/test/dbus/bench-connect ]]; then
        DBUS_BROKER_TEST_BROKER="$BROKER" \
        DBUS_BROKER_BENCH_ITERATIONS=300 \
                timeout 120 "$B/test/dbus/bench-connect" >/dev/null 2>&1 || exit 1
fi
if [[ -x $B/test/dbus/bench-message ]]; then
        DBUS_BROKER_TEST_BROKER="$BROKER" \
        DBUS_BROKER_BENCH_ITERATIONS=300 \
        DBUS_BROKER_BENCH_BROADCAST_MAX_EXP=10 \
        DBUS_BROKER_BENCH_REPLIES_MAX_EXP=10 \
        DBUS_BROKER_BENCH_PIPELINE_MAX_EXP=8 \
                timeout 120 "$B/test/dbus/bench-message" >/dev/null 2>&1 || exit 1
fi
fi

if want real; then
# Cheap CLI surfaces for the two C programs.
for round in $(seq 1 12); do
        "$BROKER" --help >/dev/null 2>&1 || :
        "$BROKER" --version >/dev/null 2>&1 || :
        "$BROKER" --max-bytes=-1 >/dev/null 2>&1 || :
        "$BROKER" --max-fds=-1 >/dev/null 2>&1 || :
        "$BROKER" --max-matches=-1 >/dev/null 2>&1 || :
        "$BROKER" --max-objects=-1 >/dev/null 2>&1 || :
        "$BROKER" --controller=-1 >/dev/null 2>&1 || :
        "$BROKER" --log=-1 >/dev/null 2>&1 || :
        "$BROKER" --machine-id=bad >/dev/null 2>&1 || :
        "$BROKER" --machine-id=0123456789abcdef0123456789abcdef --controller=999999 >/dev/null 2>&1 || :
        "$LAUNCH" --help >/dev/null 2>&1 || :
        "$LAUNCH" --version >/dev/null 2>&1 || :
        "$LAUNCH" --scope=invalid >/dev/null 2>&1 || :
        "$LAUNCH" --verbose --audit --scope=user --config-file=/nonexistent >/dev/null 2>&1 || :
        "$LAUNCH" unexpected-argument >/dev/null 2>&1 || :
done
fi

exit 0
__DBUS_BROKER_TRAIN__
  chmod +x "$_train_script"
}

_run_profile_workload() {
  local builddir=$1 profile_dir=$2 mode=$3
  LLVM_PROFILE_FILE="$profile_dir/%m-%p.profraw" \
    "$_train_script" "$builddir" "$mode"
}

_profile_total_count() {
  local tool=$1 profile=$2 view=$3
  local view_args=()
  [[ $view == cs ]] && view_args+=(--showcs)
  "$tool" show "${view_args[@]}" "$profile" |
    sed -n 's/^Total count: //p' | head -n1
}

_merge_normalized() {
  local tool=$1 output=$2 view=$3
  shift 3
  local scale=20000000 share profile count weight
  local weighted=()

  while (($#)); do
    share=$1
    profile=$2
    shift 2
    count=$(_profile_total_count "$tool" "$profile" "$view")
    [[ $count =~ ^[1-9][0-9]*$ ]] || {
      error 'Cannot normalize empty profile %s' "$profile"
      return 1
    }
    weight=$(((share * scale + count / 2) / count))
    ((weight > 0)) || weight=1
    weighted+=("--weighted-input=$weight,$profile")
    msg2 'Normalized profile share %s: count=%s weight=%s (%s)' \
      "$share" "$count" "$weight" "$(basename "$profile")"
  done
  "$tool" merge "${weighted[@]}" -o "$output"
}

_bolt_initial_instruction_count() {
  awk '/executed instructions/{ print $1; exit }' "$1"
}

_scale_fdata() {
  local input=$1 output=$2 target=$3 observed=$4
  python3 - "$input" "$output" "$target" "$observed" <<'PY'
from pathlib import Path
import sys
source, destination = map(Path, sys.argv[1:3])
target, observed = map(int, sys.argv[3:5])
with source.open() as src, destination.open('w') as dst:
    for line in src:
        fields = line.split()
        if not fields:
            continue
        value = int(fields[-1])
        scaled = (value * target + observed // 2) // observed
        if value and not scaled:
            scaled = 1
        fields[-1] = str(scaled)
        dst.write(' '.join(fields) + '\n')
PY
}

_merge_bolt_normalized() {
  local binary=$1 output=$2
  shift 2
  local share profile log count target scaled_profile
  local inputs=()

  while (($#)); do
    share=$1
    profile=$2
    shift 2
    log="$output.$(basename "$profile").count.log"
    llvm-bolt "$binary" --data="$profile" --dyno-stats --lite=false \
      --reorder-blocks=none --reorder-functions=none \
      -o "$output.count.bin" >"$log" 2>&1
    count=$(_bolt_initial_instruction_count "$log")
    rm -f "$output.count.bin"
    [[ $count =~ ^[1-9][0-9]*$ ]] || {
      error 'Cannot normalize empty BOLT profile %s' "$profile"
      return 1
    }
    printf '%s\n' "$count" > "$profile.instructions"
    target=$((share * 10000000))
    scaled_profile="$output.$(basename "$profile").scaled.fdata"
    _scale_fdata "$profile" "$scaled_profile" "$target" "$count"
    inputs+=("$scaled_profile")
    msg2 'Normalized BOLT share %s: instructions=%s target=%s (%s)' \
      "$share" "$count" "$target" "$(basename "$profile")"
  done
  merge-fdata "${inputs[@]}" > "$output"
}

_bolt_profile_count() {
  sed -n 's/.*BOLT-INFO: \([0-9][0-9]*\) out of \([0-9][0-9]*\) functions in the binary.*/\1 \2/p' "$1" |
    head -n1
}

_bolt_quality_metrics() {
  local log=$1 line bias cfg_discontinuity call_gap cfg_weighted cfg_worst

  bias=$(sed -n 's/.*Profile bias score: \([0-9.]*\)%.*/\1/p' "$log" |
    head -n1)
  line=$(grep -F 'profile quality metrics for the hottest' "$log" | head -n1)
  cfg_discontinuity=$(sed -n \
    's/.*function CFG discontinuity \([0-9.]*\)%;.*/\1/p' <<< "$line")
  call_gap=$(sed -n \
    's/.*call graph flow conservation gap \([0-9.]*\)%;.*/\1/p' <<< "$line")
  cfg_weighted=$(sed -n \
    's/.*CFG flow conservation gap \([0-9.]*\)% (weighted).*/\1/p' <<< "$line")
  cfg_worst=$(sed -n \
    's/.*(weighted) \([0-9.]*\)% (worst).*/\1/p' <<< "$line")

  [[ $bias =~ ^[0-9]+([.][0-9]+)?$ &&
     $cfg_discontinuity =~ ^[0-9]+([.][0-9]+)?$ &&
     $call_gap =~ ^[0-9]+([.][0-9]+)?$ &&
     $cfg_weighted =~ ^[0-9]+([.][0-9]+)?$ &&
     $cfg_worst =~ ^[0-9]+([.][0-9]+)?$ ]] || return 1
  printf '%s %s %s %s %s\n' \
    "$bias" "$cfg_discontinuity" "$call_gap" "$cfg_weighted" "$cfg_worst"
}

build() {
  _setup_toolchains
  _write_training_workload

  local profile_root="$srcdir/dbus-broker-profile"
  local c_std_real_raw="$profile_root/c-std-real"
  local c_std_integration_raw="$profile_root/c-std-integration"
  local c_std_benchmark_raw="$profile_root/c-std-benchmark"
  local c_std_unit_raw="$profile_root/c-std-unit"
  local c_cs_real_raw="$profile_root/c-cs-real"
  local c_cs_integration_raw="$profile_root/c-cs-integration"
  local c_cs_benchmark_raw="$profile_root/c-cs-benchmark"
  local c_cs_unit_raw="$profile_root/c-cs-unit"
  local rust_real_raw="$profile_root/rust-real"
  local rust_unit_raw="$profile_root/rust-unit"
  local c_std_real="$profile_root/c-std-real.profdata"
  local c_std_integration="$profile_root/c-std-integration.profdata"
  local c_std_benchmark="$profile_root/c-std-benchmark.profdata"
  local c_std_unit="$profile_root/c-std-unit.profdata"
  local c_std="$profile_root/c-std.profdata"
  local c_cs_real="$profile_root/c-cs-real.profdata"
  local c_cs_integration="$profile_root/c-cs-integration.profdata"
  local c_cs_benchmark="$profile_root/c-cs-benchmark.profdata"
  local c_cs_unit="$profile_root/c-cs-unit.profdata"
  local c_cs="$profile_root/c-cs.profdata"
  local c_final="$profile_root/c-final.profdata"
  local rust_real="$profile_root/rust-real.profdata"
  local rust_unit="$profile_root/rust-unit.profdata"
  local rust_final="$profile_root/rust-final.profdata"
  local build_c_std="$srcdir/build-c-std"
  local build_c_cs="$srcdir/build-c-cs"
  local build_rust="$srcdir/build-rust"
  local build_final="$srcdir/build"
  local rust_target_lib rust_profiler candidates=()

  rm -rf "$profile_root" "$build_c_std" "$build_c_cs" \
    "$build_rust" "$build_final"
  mkdir -p "$c_std_real_raw" "$c_std_integration_raw" \
    "$c_std_benchmark_raw" "$c_std_unit_raw" \
    "$c_cs_real_raw" "$c_cs_integration_raw" \
    "$c_cs_benchmark_raw" "$c_cs_unit_raw" \
    "$rust_real_raw" "$rust_unit_raw"

  msg2 'C PGO: generating independently normalized workload profiles'
  _meson_setup "$build_c_std" \
    "-fprofile-generate=$c_std_real_raw" \
    "-fprofile-generate=$c_std_real_raw"
  meson compile -C "$build_c_std"
  _run_profile_workload "$build_c_std" "$c_std_real_raw" real
  _run_profile_workload "$build_c_std" "$c_std_integration_raw" integration
  _run_profile_workload "$build_c_std" "$c_std_benchmark_raw" benchmark
  _run_selected_units "$build_c_std" "$c_std_unit_raw"
  _merge_raw llvm-profdata "$c_std_real" "$c_std_real_raw"
  _merge_raw llvm-profdata "$c_std_integration" "$c_std_integration_raw"
  _merge_raw llvm-profdata "$c_std_benchmark" "$c_std_benchmark_raw"
  _merge_raw llvm-profdata "$c_std_unit" "$c_std_unit_raw"
  # Normalize by measured profile totals before assigning shares. This avoids
  # a tight synthetic loop dominating merely because it emits more counters.
  _merge_normalized llvm-profdata "$c_std" normal \
    60 "$c_std_real" \
    30 "$c_std_benchmark" \
    9 "$c_std_integration" \
    1 "$c_std_unit"
  _require_profile llvm-profdata "$c_std_real" 100 40 'C real-session IR-PGO'
  _require_profile llvm-profdata "$c_std" 200 65 'C normalized IR-PGO'

  msg2 'C PGO: generating normalized context-sensitive profiles'
  _meson_setup "$build_c_cs" \
    "-fprofile-use=$c_std -fcs-profile-generate=$c_cs_real_raw" \
    "-fprofile-use=$c_std -fcs-profile-generate=$c_cs_real_raw"
  meson compile -C "$build_c_cs"
  _run_profile_workload "$build_c_cs" "$c_cs_real_raw" real
  _run_profile_workload "$build_c_cs" "$c_cs_integration_raw" integration
  _run_profile_workload "$build_c_cs" "$c_cs_benchmark_raw" benchmark
  _run_selected_units "$build_c_cs" "$c_cs_unit_raw"
  _merge_raw llvm-profdata "$c_cs_real" "$c_cs_real_raw"
  _merge_raw llvm-profdata "$c_cs_integration" "$c_cs_integration_raw"
  _merge_raw llvm-profdata "$c_cs_benchmark" "$c_cs_benchmark_raw"
  _merge_raw llvm-profdata "$c_cs_unit" "$c_cs_unit_raw"
  _merge_normalized llvm-profdata "$c_cs" cs \
    60 "$c_cs_real" \
    30 "$c_cs_benchmark" \
    9 "$c_cs_integration" \
    1 "$c_cs_unit"
  _require_profile llvm-profdata "$c_cs_real" 80 25 'C real-session CS-PGO' --showcs
  _require_profile llvm-profdata "$c_cs" 180 60 'C normalized CS-PGO' --showcs
  llvm-profdata merge "$c_std" "$c_cs" -o "$c_final"

  msg2 'Rust PGO: generating a separate, rustc-compatible profile'
  rust_target_lib=$(rustc --print target-libdir)
  shopt -s nullglob
  candidates=("$rust_target_lib"/libprofiler_builtins-*.rlib)
  shopt -u nullglob
  ((${#candidates[@]} == 1)) || {
    error 'Unable to identify rustc profiler_builtins'
    return 1
  }
  rust_profiler=${candidates[0]}

  # Rust static libraries are linked by the C driver.  Force the matching
  # rustc profiling runtime into every executable during profile generation.
  _meson_setup "$build_rust" '' \
    "-Wl,--whole-archive,$rust_profiler,--no-whole-archive" \
    "-Cprofile-generate=$rust_real_raw"
  meson compile -C "$build_rust"
  _run_profile_workload "$build_rust" "$rust_real_raw" real
  _run_selected_units "$build_rust" "$rust_unit_raw"
  _merge_raw "$_rust_profdata" "$rust_real" "$rust_real_raw"
  _merge_raw "$_rust_profdata" "$rust_unit" "$rust_unit_raw"
  _merge_normalized "$_rust_profdata" "$rust_final" normal \
    95 "$rust_real" \
    5 "$rust_unit"
  _require_profile "$_rust_profdata" "$rust_real" 40 20 'Rust real-session IR-PGO'
  _require_profile "$_rust_profdata" "$rust_final" 80 40 'Rust normalized IR-PGO'

  msg2 'Building with separate C CS-PGO and Rust IR-PGO profiles'
  _meson_setup "$build_final" \
    "-fprofile-use=$c_final" \
    "-fprofile-use=$c_final -Wl,--emit-relocs" \
    "-Cprofile-use=$rust_final"
  meson compile -C "$build_final"
  meson test -C "$build_final" --no-rebuild --print-errorlogs \
    --timeout-multiplier=5

  msg2 'Collecting one independent BOLT profile per shipped executable'
  local bolt_root="$profile_root/bolt"
  local bins=(dbus-broker dbus-broker-launch dbus-broker-session)
  local bin path merged log optimized
  local quality_log quality_binary reorder_functions
  local files=() coverage total minimum minimum_count benchmark_instructions
  local bias cfg_discontinuity call_gap cfg_weighted cfg_worst
  mkdir -p "$bolt_root"

  for bin in "${bins[@]}"; do
    path="$build_final/src/$bin"
    cp -a "$path" "$bolt_root/$bin.pgo"
    llvm-bolt "$bolt_root/$bin.pgo" \
      --instrument \
      --conservative-instrumentation \
      --lite=false \
      --instrumentation-file="$bolt_root/$bin.fdata" \
      --instrumentation-file-append-pid \
      -o "$path"
  done

  # Keep workload classes independent so their dynamic counts can be
  # normalized before merging. Otherwise a synthetic message loop can dwarf
  # desktop-style session traffic despite covering fewer behaviors.
  local category category_root category_profile
  for category in real integration benchmark; do
    "$_train_script" "$build_final" "$category"
    category_root="$bolt_root/$category"
    mkdir -p "$category_root"
    for bin in "${bins[@]}"; do
      mapfile -t files < <(find "$bolt_root" -maxdepth 1 -type f \
        -name "$bin.fdata.*" -size +0c -print | sort)
      ((${#files[@]})) || continue
      mv "${files[@]}" "$category_root/"
    done
  done

  for bin in "${bins[@]}"; do
    path="$build_final/src/$bin"
    merged="$bolt_root/$bin-merged.fdata"
    log="$bolt_root/$bin-bolt.log"
    optimized="$bolt_root/$bin.bolt"

    case $bin in
      dbus-broker)
        for category in real integration benchmark; do
          category_profile="$bolt_root/$bin-$category.fdata"
          mapfile -t files < <(find "$bolt_root/$category" -maxdepth 1 \
            -type f -name "$bin.fdata.*" -size +0c -print | sort)
          ((${#files[@]})) || {
            error 'BOLT produced no %s profile for %s' "$category" "$bin"
            return 1
          }
          merge-fdata "${files[@]}" > "$category_profile"
        done
        # A/B sessions favored this balanced mix over both the raw-count merge
        # and a 55/30/15 desktop-heavy mix.
        _merge_bolt_normalized "$bolt_root/$bin.pgo" "$merged" \
          45 "$bolt_root/$bin-real.fdata" \
          40 "$bolt_root/$bin-benchmark.fdata" \
          15 "$bolt_root/$bin-integration.fdata"
        read -r benchmark_instructions < "$bolt_root/$bin-benchmark.fdata.instructions"
        # Full-LTO/user flags can reduce the same workload by two orders of
        # magnitude. Require substantial *observed* weight, then normalize the
        # three classes without fabricating extra profile files.
        if ((benchmark_instructions < 10000000)); then
          error 'BOLT benchmark profile covers fewer than ten million instructions'
          return 1
        fi
        ;;
      *)
        category_profile="$bolt_root/$bin-real.fdata"
        mapfile -t files < <(find "$bolt_root/real" -maxdepth 1 \
          -type f -name "$bin.fdata.*" -size +0c -print | sort)
        ((${#files[@]})) || {
          error 'BOLT produced no real-session profile for %s' "$bin"
          return 1
        }
        merge-fdata "${files[@]}" > "$category_profile"
        cp "$category_profile" "$merged"
        ;;
    esac
    [[ -s $merged ]] || return 1

    # Audit inter- and intra-function flow before selecting function ordering.
    # BOLT's call-graph statistic is an unweighted 95th-percentile diagnostic:
    # two cold outliers are enough to report 100% with 37 profiled functions.
    # It is also sensitive to fork/exec launchers, whose child replaces its
    # instrumented image without running DT_FINI. Never feed a materially
    # inconsistent call graph to a call-graph clustering algorithm. Retain the
    # measured cdsort winner for coherent profiles and fall back to execution-
    # count ordering otherwise; all block-level optimizations remain enabled.
    quality_log="$bolt_root/$bin-quality-preflight.log"
    quality_binary="$bolt_root/$bin-quality-preflight.bin"
    if ! llvm-bolt "$bolt_root/$bin.pgo" \
      --data="$merged" \
      --print-profile-stats \
      --verify-cfg \
      --report-stale \
      --stale-threshold=0 \
      --lite=false \
      --reorder-blocks=none \
      --reorder-functions=none \
      --use-gnu-stack \
      -o "$quality_binary" >"$quality_log" 2>&1; then
      cat "$quality_log"
      error 'BOLT profile preflight failed for %s' "$bin"
      return 1
    fi
    rm -f "$quality_binary"
    if ! read -r bias cfg_discontinuity call_gap cfg_weighted cfg_worst \
        < <(_bolt_quality_metrics "$quality_log"); then
      cat "$quality_log"
      error 'Unable to parse BOLT profile quality for %s' "$bin"
      return 1
    fi
    if awk -v value="$call_gap" 'BEGIN { exit !(value <= 1.0) }'; then
      reorder_functions=cdsort
    else
      reorder_functions=exec-count
      warning '%s call-graph flow gap is %s%%; using exec-count rather than cdsort ordering' \
        "$bin" "$call_gap"
    fi
    msg2 '%s BOLT preflight: bias=%s%% CFG=%s%%/%s%%/%s%% call-graph=%s%% ordering=%s' \
      "$bin" "$bias" "$cfg_discontinuity" "$cfg_weighted" "$cfg_worst" \
      "$call_gap" "$reorder_functions"

    # Exact-commit sweeps, Raptor Lake llvm-mca, and interleaved A/B runs with
    # the packager's full-LTO flags rejected ICP, frame-opt, cdsplit/aggressive
    # reg-reassign, JT footprint, and forced inlining. Cache-directed sort was
    # the best balanced session/connect/message choice when inter-function flow
    # is coherent. Huge-page-aware placement beat --no-huge-pages.
    if ! llvm-bolt "$bolt_root/$bin.pgo" \
      --data="$merged" \
      --dyno-stats \
      --print-profile-stats \
      --verify-cfg \
      --report-stale \
      --stale-threshold=0 \
      --lite=false \
      --reorder-blocks=ext-tsp \
      --reorder-functions="$reorder_functions" \
      --split-functions \
      --split-all-cold \
      --split-eh \
      --split-strategy=profile2 \
      --icf=safe \
      --plt=all \
      --peepholes=all \
      --x86-strip-redundant-address-size \
      --eliminate-unreachable \
      --tail-duplication=cache \
      --reg-reassign \
      --sctc-mode=heuristic \
      --thread-count="$(nproc)" \
      --use-gnu-stack \
      -o "$optimized" >"$log" 2>&1; then
      cat "$log"
      error 'BOLT optimization failed for %s' "$bin"
      return 1
    fi
    cat "$log"

    read -r coverage total < <(_bolt_profile_count "$log")
    # Rust std/generic code inflates the session binary to >2500 symbols;
    # its session implementation is emitted mainly as two very large simple
    # functions and both are profiled.  The lower raw percentage is therefore
    # expected and is additionally guarded by perfect hottest-function flow
    # metrics plus the strict full-stack replay below.
    # Full LTO aggressively internalizes/inlines functions, so absolute symbol
    # counts are lower than in non-LTO builds. Require both a meaningful count
    # and percentage, then enforce flow/bias quality independently below.
    case $bin in
      dbus-broker)         minimum=10; minimum_count=20 ;;
      dbus-broker-launch)  minimum=10; minimum_count=15 ;;
      dbus-broker-session) minimum=3;  minimum_count=30 ;;
    esac
    if [[ ! $coverage =~ ^[0-9]+$ || ! $total =~ ^[1-9][0-9]*$ ]] ||
       ((coverage < minimum_count || coverage * 100 < minimum * total)); then
      error '%s BOLT function coverage is below %s functions/%s%%' \
        "$bin" "$minimum_count" "$minimum"
      return 1
    fi
    if ! read -r bias cfg_discontinuity call_gap cfg_weighted cfg_worst \
        < <(_bolt_quality_metrics "$log"); then
      error 'Unable to parse final BOLT profile quality for %s' "$bin"
      return 1
    fi
    # Instrumentation counters are integral. Rescaling independently collected
    # workload classes can introduce sub-percent rounding gaps even when every
    # source profile is exact, so use strict measured bounds rather than a
    # brittle textual demand for five independently rounded 0.00% values.
    if ! awk -v bias="$bias" \
             -v discontinuity="$cfg_discontinuity" \
             -v weighted="$cfg_weighted" \
             -v worst="$cfg_worst" \
             'BEGIN {
                exit !(bias <= 0.1 && discontinuity <= 0.1 &&
                       weighted <= 0.1 && worst <= 1.0)
              }'; then
      error '%s BOLT profile failed quality bounds: bias=%s%% CFG=%s%%/%s%%/%s%%' \
        "$bin" "$bias" "$cfg_discontinuity" "$cfg_weighted" "$cfg_worst"
      return 1
    fi
    if [[ $reorder_functions == cdsort ]] &&
       ! awk -v value="$call_gap" 'BEGIN { exit !(value <= 1.0) }'; then
      error '%s BOLT call-graph gap changed after cdsort selection: %s%%' \
        "$bin" "$call_gap"
      return 1
    fi
    if ! grep -Eq 'taken branches \(-[0-9]' "$log"; then
      error '%s BOLT layout did not reduce modeled taken branches' "$bin"
      return 1
    fi

    readelf -h "$optimized" >/dev/null
    mv -f "$optimized" "$path"
  done

  msg2 'Verifying the complete BOLT-optimized stack'
  "$_train_script" "$build_final"
  meson test -C "$build_final" --no-rebuild --print-errorlogs \
    --timeout-multiplier=5
}

_pick() {
  local p=$1 f d
  shift
  for f; do
    d="$srcdir/$p/${f#"$pkgdir"/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")" || true
  done
}

check() {
  meson test -C "$srcdir/build" --no-rebuild --print-errorlogs \
    --timeout-multiplier=5
}

package_dbus-broker-git() {
  depends+=(libaudit.so libcap-ng.so libexpat.so libsystemd.so)
  provides=(dbus-broker)
  conflicts=(dbus-broker)

  meson install -C "$srcdir/build" --destdir "$pkgdir" --no-rebuild
  _pick unit "$pkgdir"/usr/lib/systemd/{system,user}/dbus.service
}

package_dbus-broker-units-git() {
  pkgdesc+=' - Service units'
  depends=(dbus "dbus-broker-git=$pkgver-$pkgrel")
  provides=(dbus-broker-units dbus-units)
  conflicts=(dbus-broker-units dbus-daemon-units)

  install -d "$pkgdir"
  mv "$srcdir"/unit/* "$pkgdir"
}
