+++ b/src/amd/vulkan/meta/radv_meta_copy.c
@@ -154,6 +154,30 @@ transfer_copy_memory_image(struct radv_cmd_buffer *cmd_buffer, VkAddressCopyFlag
       radv_transfer_fixup_copy_dst_metadata(cmd_buffer, image, &region->imageSubresource);
 }
 
+/*
+ * Compute image stores cannot generally consume TC-compatible HTILE in GENERAL,
+ * so radv_layout_is_htile_compressed() deliberately reports that layout as
+ * uncompressed for an exclusive compute queue. A copy destination still needs
+ * its physical HTILE metadata repaired around compute copies, however. Keep
+ * that narrow metadata-fixup case separate from the global layout predicate:
+ * the latter also controls render-state, transition, and SDMA decisions.
+ */
+static bool
+radv_copy_dst_needs_htile_metadata_fixup(const struct radv_device *device, const struct radv_image *image,
+                                         unsigned level, VkImageLayout image_layout, unsigned queue_mask)
+{
+   if (radv_layout_is_htile_compressed(device, image, level, image_layout, queue_mask))
+      return true;
+
+   if (image_layout != VK_IMAGE_LAYOUT_GENERAL || !(queue_mask & BITFIELD_BIT(RADV_QUEUE_COMPUTE)) ||
+       !radv_tc_compat_htile_enabled(image, level))
+      return false;
+
+   const struct radv_physical_device *pdev = radv_device_physical(device);
+   /* upstream e8e771ce42e moved drirc from radv_instance to radv_physical_device */
+   return !pdev->drirc.debug.disable_tc_compat_htile_general;
+}
+
 static void
 radv_fixup_copy_dst_metadata(struct radv_cmd_buffer *cmd_buffer, struct radv_image *image, VkImageLayout image_layout,
                              const VkImageSubresourceLayers *subresource, const VkOffset3D *offset,
@@ -178,7 +202,7 @@ radv_fixup_copy_dst_metadata(struct radv_cmd_buffer *cmd_buffer, struct radv_ima
          radv_expand_hiz_range(cmd_buffer, image, &range);
    } else {
       const uint32_t queue_mask = radv_image_queue_family_mask(image, cmd_buffer->qf);
-      if (!radv_layout_is_htile_compressed(device, image, subresource->mipLevel, image_layout, queue_mask))
+      if (!radv_copy_dst_needs_htile_metadata_fixup(device, image, subresource->mipLevel, image_layout, queue_mask))
          return;
 
       if (radv_image_decompress_htile_on_image_stores(device, image))
@@ -974,6 +998,7 @@ radv_CmdCopyMemoryToImageIndirectKHR(VkCommandBuffer commandBuffer,
                                                             VK_ACCESS_TRANSFER_READ_BIT, 0, dst_image, NULL);
 
       const enum util_format_layout format_layout = radv_format_description(dst_image->vk.format)->layout;
+      (void)format_layout;
       assert(format_layout == UTIL_FORMAT_LAYOUT_ETC);
 
       radv_meta_decode_etc_indirect(cmd_buffer, pCopyMemoryToImageIndirectInfo);
