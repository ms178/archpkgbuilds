+static int32_t
+get_alu_src_signed_upper_bound(isel_context* ctx, nir_alu_instr* instr, int src_idx)
+{
+   if (!ctx->signed_upper_ht)
+      ctx->signed_upper_ht = _mesa_pointer_hash_table_create(NULL);
+
+   nir_scalar scalar = nir_scalar{instr->src[src_idx].src.ssa, instr->src[src_idx].swizzle[0]};
+   return nir_signed_upper_bound(ctx->shader, ctx->signed_upper_ht, scalar);
+}
+
+static int32_t
+get_alu_src_signed_lower_bound(isel_context* ctx, nir_alu_instr* instr, int src_idx)
+{
+   if (!ctx->signed_lower_ht)
+      ctx->signed_lower_ht = _mesa_pointer_hash_table_create(NULL);
+
+   nir_scalar scalar = nir_scalar{instr->src[src_idx].src.ssa, instr->src[src_idx].swizzle[0]};
+   return nir_signed_lower_bound(ctx->shader, ctx->signed_lower_ht, scalar);
+}
