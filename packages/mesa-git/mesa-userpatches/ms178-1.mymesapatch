+BEGIN_TEST(optimize.s_pack_hl_constant_gfx9)
+   //>> s1: %a:s[0] = p_startpgm
+   if (!setup_cs("s1", GFX9))
+      return;
+
+   Temp constant = bld.copy(bld.def(s1), Operand::c32(0x12345678u));
+   Temp hi_const = bld.pseudo(aco_opcode::p_extract, bld.def(s1), bld.def(s1, scc), constant,
+                              Operand::c32(1), Operand::c32(16u), Operand::c32(false));
+
+   //! s1: %res0 = s_pack_ll_b32_b16 0x1234, %a
+   //! p_unit_test 0, %res0
+   writeout(0, bld.sop2(aco_opcode::s_pack_ll_b32_b16, bld.def(s1), hi_const, inputs[0]));
+
+   Temp neg_constant = bld.copy(bld.def(s1), Operand::c32(0xffff8001u));
+   Temp signed_hi = bld.pseudo(aco_opcode::p_extract, bld.def(s1), bld.def(s1, scc), neg_constant,
+                               Operand::c32(1), Operand::c32(16u), Operand::c32(true));
+
+   //! s1: %res1 = s_pack_ll_b32_b16 -1, %a
+   //! p_unit_test 1, %res1
+   writeout(1, bld.sop2(aco_opcode::s_pack_ll_b32_b16, bld.def(s1), signed_hi, inputs[0]));
+
+   finish_opt_test();
+END_TEST
+
+BEGIN_TEST(optimize.s_pack_hl_second_constant_gfx8)
+   //>> s1: %a:s[0], s1: %b:s[1] = p_startpgm
+   if (!setup_cs("s1 s1", GFX8))
+      return;
+
+   Temp hi = bld.pseudo(aco_opcode::p_extract, bld.def(s1), bld.def(s1, scc), inputs[1], Operand::c32(1),
+                        Operand::c32(16u), Operand::c32(false));
+
+   /* s_pack_hh is unavailable before GFX9, so the original form must remain. */
+   //! s1: %hi0, s1: %_:scc = p_extract %b, 1, 16, 0
+   //! s1: %res0 = s_pack_ll_b32_b16 %hi0, 0x1234
+   //! p_unit_test 0, %res0
+   writeout(0, bld.sop2(aco_opcode::s_pack_ll_b32_b16, bld.def(s1), hi, Operand::c32(0x1234u)));
+
+   finish_opt_test();
+END_TEST
+
+BEGIN_TEST(optimize.s_pack_hl_second_constant)
+   for (amd_gfx_level level : {GFX9, GFX10, GFX10_3, GFX11}) {
       //>> s1: %a:s[0], s1: %b:s[1] = p_startpgm
-      if (!setup_cs("s1 s1", (amd_gfx_level)i))
