+                                  true /* commutative */);
          } else if (nir_src_is_const(instr->src[0].src)) {
             bld.v_mul_imm(Definition(dst), get_alu_src(ctx, instr->src[1]),
                           nir_src_as_uint(instr->src[0].src), src1_ub <= 0xffffff,
@@ -3331,6 +3360,16 @@ visit_alu_instr(isel_context* ctx, nir_alu_instr* instr)
             if (camount == 16 && ctx->program->gfx_level >= GFX11) {
                bld.sop2(aco_opcode::s_pack_hl_b32_b16, Definition(dst), src1, src0);
                break;
+            } else if (camount == 16 && ctx->program->gfx_level >= GFX9 &&
+                       nir_src_is_const(instr->src[1].src)) {
+               bld.sop2(aco_opcode::s_pack_ll_b32_b16, Definition(dst),
+                        Operand::c32(nir_src_as_uint(instr->src[1].src) >> 16), src0);
+               break;
+            } else if (camount == 16 && ctx->program->gfx_level >= GFX9 &&
+                       nir_src_is_const(instr->src[0].src)) {
+               bld.sop2(aco_opcode::s_pack_hh_b32_b16, Definition(dst), src1,
+                        Operand::c32((nir_src_as_uint(instr->src[0].src) & 0xffffu) << 16));
+               break;
             }
             amount = bld.copy(bld.def(s1), Operand::c32(camount));
          } else if (get_alu_src_ub(ctx, instr, 2) >= 32) {
diff --git a/src/amd/compiler/instruction_selection/aco_select_nir_intrinsics.cpp b/src/amd/compiler/instruction_selection/aco_select_nir_intrinsics.cpp
index 268515bcb70..560e62a7a27 100644
--- a/src/amd/compiler/instruction_selection/aco_select_nir_intrinsics.cpp
+++ b/src/amd/compiler/instruction_selection/aco_select_nir_intrinsics.cpp
@@ -2372,7 +2372,12 @@ visit_load_global(isel_context* ctx, nir_intrinsic_instr* instr)
    unsigned component_size = instr->def.bit_size / 8;
    unsigned access = nir_intrinsic_access(instr);
 
-   if (access & ACCESS_SMEM_AMD)
+   /* Pre-GFX12 SMEM cannot encode byte or halfword loads. Normally
+    * ac_nir_lower_global_access clears ACCESS_SMEM_AMD for this case, but keep
+    * instruction selection robust against late NIR producers as well. */
+   const bool smem_subdword_legal = ctx->program->gfx_level >= GFX12 ||
+                                    num_components * component_size >= 4;
+   if ((access & ACCESS_SMEM_AMD) && smem_subdword_legal)
       return visit_load_global_smem(ctx, instr);
 
    Temp addr, offset;
diff --git a/src/amd/compiler/tests/framework.h b/src/amd/compiler/tests/framework.h
index 7f27e60ee98..ae4b950a1ad 100644
--- a/src/amd/compiler/tests/framework.h
+++ b/src/amd/compiler/tests/framework.h
@@ -28,19 +28,20 @@ bool set_variant(const char* name);
 inline bool
 set_variant(amd_gfx_level cls, const char* rest = "")
 {
-   char buf[8 + strlen(rest)];
+   std::string variant;
    if (cls == GFX10_3) {
-      snprintf(buf, sizeof(buf), "gfx10_3%s", rest);
+      variant = "gfx10_3";
    } else if (cls == GFX11_5) {
-      snprintf(buf, sizeof(buf), "gfx11_5%s", rest);
+      variant = "gfx11_5";
    } else if (cls == GFX11_7) {
-      snprintf(buf, sizeof(buf), "gfx11_7%s", rest);
+      variant = "gfx11_7";
    } else {
       unsigned num = cls - GFX6 + 6;
       num -= (cls > GFX10_3) + ((cls > GFX11_7) ? 2 : 0);
-      snprintf(buf, sizeof(buf), "gfx%d%s", num, rest);
+      variant = "gfx" + std::to_string(num);
    }
-   return set_variant(buf);
+   variant += rest;
+   return set_variant(variant.c_str());
 }
 
 void fail_test(const char* fmt, ...);
diff --git a/src/amd/compiler/tests/heap_pipeline_exp.c b/src/amd/compiler/tests/heap_pipeline_exp.c
new file mode 100644
index 00000000000..e3c02f04449
--- /dev/null
+++ b/src/amd/compiler/tests/heap_pipeline_exp.c
@@ -0,0 +1,358 @@
+/*
+ * EXPERIMENTAL (v9.2 investigation, ms178):
+ * Headless driver for the full RADV VK_EXT_descriptor_heap NIR pipeline:
+ *
+ *   shader-shaped NIR (deref + divergent index, nonuniform annotated)
+ *   -> vk_nir_lower_descriptor_heaps()   (DXVK-style INDIRECT_INDEX mapping)
+ *   -> nir_lower_non_uniform_access()    (RADV-equivalent options)
+ *   -> radv_nir_lower_descriptors()
+ *   -> printed NIR (the caller feeds the result to ACO isel via
+ *      the aco_tests framework and validates).
+ */
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+
+#include "heap_pipeline_exp.h"
+
+#include "nir_builder.h"
+
+#include "vk_nir_lower_descriptor_heaps.h"
+#include "vk_sampler.h"
+#include "ac_gpu_info.h"
+#include "radv_nir.h"
+#include "radv_sampler.h"
+#include "radv_shader.h"
+#include "amd_family.h"
+
+struct exp_state {
+   struct radeon_info ri;
+   struct radv_compiler_info ci;
+   struct radv_shader_stage stage;
+};
+
+static bool
+exp_rewrite_scalar_args(nir_builder *b, nir_instr *instr, void *data)
+{
+   if (instr->type != nir_instr_type_intrinsic)
+      return false;
+   nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+   if (intr->intrinsic != nir_intrinsic_load_scalar_arg_amd)
+      return false;
+   /* replace with a uniform test input so isel-test arg plumbing isn't needed */
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_def *u = nir_unit_test_uniform_input(b, 1, 32, nir_intrinsic_base(intr) + 8);
+   nir_def_rewrite_uses(&intr->def, u);
+   nir_instr_remove(&intr->instr);
+   return true;
+}
+
+nir_shader *
+exp_build_heap_tex_shader(const void *nir_options)
+{
+   nir_builder _b = nir_builder_init_simple_shader(MESA_SHADER_COMPUTE, nir_options, "exp_heap");
+   nir_builder *b = &_b;
+
+   const struct glsl_type *tex_type = glsl_array_type(
+      glsl_sampler_type(GLSL_SAMPLER_DIM_2D, false, false, GLSL_TYPE_FLOAT), 16, 0);
+   nir_variable *tex_var = nir_variable_create(b->shader, nir_var_uniform, tex_type, "tex");
+   tex_var->data.descriptor_set = 0;
+   tex_var->data.binding = 0;
+   tex_var->data.resource_type = nir_resource_type_sampled_image;
+
+   nir_variable *samp_var = nir_variable_create(
+      b->shader, nir_var_uniform, glsl_array_type(glsl_bare_sampler_type(), 16, 0), "samp");
+   samp_var->data.descriptor_set = 0;
+   samp_var->data.binding = 1;
+   samp_var->data.resource_type = nir_resource_type_sampler;
+
+   nir_def *idx = nir_unit_test_divergent_input(b, 1, 32, 0);
+   nir_deref_instr *tarr_d = nir_build_deref_array(b, nir_build_deref_var(b, tex_var), idx);
+   nir_deref_instr *sarr_d = nir_build_deref_array(b, nir_build_deref_var(b, samp_var), idx);
+
+   nir_def *coord = nir_vec2(b, nir_unit_test_divergent_input(b, 1, 32, 2),
+                             nir_unit_test_divergent_input(b, 1, 32, 3));
+
+   nir_tex_instr *tex = nir_tex_instr_create(b->shader, 3);
+   tex->op = nir_texop_tex;
+   tex->sampler_dim = GLSL_SAMPLER_DIM_2D;
+   tex->dest_type = nir_type_float32;
+   tex->coord_components = 2;
+   tex->src[0].src = nir_src_for_ssa(coord);
+   tex->src[0].src_type = nir_tex_src_coord;
+   tex->src[1].src = nir_src_for_ssa(&tarr_d->def);
+   tex->src[1].src_type = nir_tex_src_texture_deref;
+   tex->src[2].src = nir_src_for_ssa(&sarr_d->def);
+   tex->src[2].src_type = nir_tex_src_sampler_deref;
+   tex->texture_non_uniform = true;
+   tex->sampler_non_uniform = true;
+   nir_def_init(&tex->instr, &tex->def, 4, 32);
+   nir_builder_instr_insert(b, &tex->instr);
+   nir_unit_test_output(b, &tex->def, 2);
+
+   return b->shader;
+}
+
+nir_shader *
+exp_build_shader_for(enum amd_gfx_level gfx)
+{
+   static struct radeon_info ri;
+   static struct nir_shader_compiler_options opts;
+   memset(&ri, 0, sizeof(ri));
+   ri.gfx_level = gfx;
+   ri.family = (gfx == GFX9) ? CHIP_VEGA10 : CHIP_NAVI10;
+   ac_fill_compiler_info(&ri, NULL, false);
+   memset(&opts, 0, sizeof(opts));
+   ac_nir_set_options(&ri.compiler_info, false, &opts);
+   glsl_type_singleton_init_or_ref();
+   return exp_build_heap_tex_shader(&opts);
+}
+
+static bool
+exp_split_packs(nir_builder *b, nir_instr *instr, void *data)
+{
+   /* ACO has no plain pack_64_2x32; the real pipeline never produces it
+    * because its opt rounds canonicalize to pack_64_2x32_split. */
+   if (instr->type != nir_instr_type_alu)
+      return false;
+   nir_alu_instr *alu = nir_instr_as_alu(instr);
+   if (alu->op != nir_op_pack_64_2x32)
+      return false;
+   b->cursor = nir_before_instr(&alu->instr);
+   nir_def *x = nir_channel(b, alu->src[0].src.ssa, 0);
+   nir_def *y = nir_channel(b, alu->src[0].src.ssa, 1);
+   nir_def *packed = nir_pack_64_2x32_split(b, x, y);
+   nir_def_rewrite_uses(&alu->def, packed);
+   nir_instr_remove(&alu->instr);
+   return true;
+}
+
+nir_shader *
+exp_build_embedded_cis_shader(const void *nir_options)
+{
+   nir_builder _b = nir_builder_init_simple_shader(MESA_SHADER_COMPUTE, nir_options, "exp_embedded");
+   nir_builder *b = &_b;
+
+   /* Combined image/sampler (sampler2D): the texture deref doubles as the
+    * sampler source -> sampler_src_idx == -1 in lower_heaps_tex(). With an
+    * embedded sampler mapped, this used to hit
+    * nir_tex_instr_remove_src(tex, (unsigned)-1). */
+   const struct glsl_type *cis_type = glsl_array_type(
+      glsl_sampler_type(GLSL_SAMPLER_DIM_2D, false, false, GLSL_TYPE_FLOAT), 16, 0);
+   nir_variable *cis_var = nir_variable_create(b->shader, nir_var_uniform, cis_type, "cis");
+   cis_var->data.descriptor_set = 0;
+   cis_var->data.binding = 2;
+   cis_var->data.resource_type = nir_resource_type_combined_sampled_image;
+
+   /* Embedded (static) samplers always use a constant array index, matching
+    * D3D12 static samplers / SPIR-V immutable samplers. */
+   nir_def *idx = nir_imm_int(b, 3);
+   nir_deref_instr *tarr_d = nir_build_deref_array(b, nir_build_deref_var(b, cis_var), idx);
+
+   nir_def *coord = nir_vec2(b, nir_unit_test_divergent_input(b, 1, 32, 2),
+                             nir_unit_test_divergent_input(b, 1, 32, 3));
+
+   nir_tex_instr *tex = nir_tex_instr_create(b->shader, 2);
+   tex->op = nir_texop_tex;
+   tex->sampler_dim = GLSL_SAMPLER_DIM_2D;
+   tex->dest_type = nir_type_float32;
+   tex->coord_components = 2;
+   tex->src[0].src = nir_src_for_ssa(coord);
+   tex->src[0].src_type = nir_tex_src_coord;
+   tex->src[1].src = nir_src_for_ssa(&tarr_d->def);
+   tex->src[1].src_type = nir_tex_src_texture_deref;
+   tex->texture_non_uniform = true;
+   nir_def_init(&tex->instr, &tex->def, 4, 32);
+   nir_builder_instr_insert(b, &tex->instr);
+   nir_unit_test_output(b, &tex->def, 2);
+
+   return b->shader;
+}
+
+bool
+exp_run_heap_pipeline(enum amd_gfx_level gfx, nir_shader *nir, FILE *out)
+{
+   /* ---- mapping info: DXVK-style HEAP_WITH_INDIRECT_INDEX ---- */
+   VkDescriptorSetAndBindingMappingEXT mappings[3];
+   memset(mappings, 0, sizeof(mappings));
+
+   mappings[0].descriptorSet = 0;
+   mappings[0].firstBinding = 0;
+   mappings[0].bindingCount = 1;
+   mappings[0].resourceMask = VK_SPIRV_RESOURCE_TYPE_SAMPLED_IMAGE_BIT_EXT;
+   mappings[0].source = VK_DESCRIPTOR_MAPPING_SOURCE_HEAP_WITH_INDIRECT_INDEX_EXT;
+   mappings[0].sourceData.indirectIndex.heapOffset = 0;
+   mappings[0].sourceData.indirectIndex.pushOffset = 0;
+   mappings[0].sourceData.indirectIndex.addressOffset = 0;
+   mappings[0].sourceData.indirectIndex.heapIndexStride = 64;
+   mappings[0].sourceData.indirectIndex.heapArrayStride = 64;
+
+   mappings[1].descriptorSet = 0;
+   mappings[1].firstBinding = 1;
+   mappings[1].bindingCount = 1;
+   mappings[1].resourceMask = VK_SPIRV_RESOURCE_TYPE_SAMPLER_BIT_EXT;
+   mappings[1].source = VK_DESCRIPTOR_MAPPING_SOURCE_HEAP_WITH_CONSTANT_OFFSET_EXT;
+   mappings[1].sourceData.constantOffset.heapOffset = 0;
+   mappings[1].sourceData.constantOffset.heapArrayStride = 16;
+
+   static VkSamplerCreateInfo embedded_sampler_create_info = {
+      .sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO,
+      .magFilter = VK_FILTER_LINEAR,
+      .minFilter = VK_FILTER_LINEAR,
+      .mipmapMode = VK_SAMPLER_MIPMAP_MODE_LINEAR,
+      .addressModeU = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+      .addressModeV = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+      .addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+      .maxLod = 1000.0f,
+   };
+   mappings[2].descriptorSet = 0;
+   mappings[2].firstBinding = 2;
+   mappings[2].bindingCount = 1;
+   mappings[2].resourceMask = VK_SPIRV_RESOURCE_TYPE_COMBINED_SAMPLED_IMAGE_BIT_EXT;
+   mappings[2].source = VK_DESCRIPTOR_MAPPING_SOURCE_HEAP_WITH_INDIRECT_INDEX_EXT;
+   mappings[2].sourceData.indirectIndex.heapOffset = 0;
+   mappings[2].sourceData.indirectIndex.pushOffset = 0;
+   mappings[2].sourceData.indirectIndex.addressOffset = 0;
+   mappings[2].sourceData.indirectIndex.heapIndexStride = 64;
+   mappings[2].sourceData.indirectIndex.heapArrayStride = 64;
+   mappings[2].sourceData.indirectIndex.pEmbeddedSampler = &embedded_sampler_create_info;
+
+   VkShaderDescriptorSetAndBindingMappingInfoEXT map_info;
+   memset(&map_info, 0, sizeof(map_info));
+   map_info.sType = VK_STRUCTURE_TYPE_SHADER_DESCRIPTOR_SET_AND_BINDING_MAPPING_INFO_EXT;
+   map_info.mappingCount = 3;
+   map_info.pMappings = mappings;
+
+   const vk_nir_lower_descriptor_heaps_options hopts = {
+      .lower_shader_record_index_to_non_uniform = true,
+   };
+   struct vk_sampler_state_array samplers;
+   static struct exp_state st;
+   memset(&samplers, 0, sizeof(samplers));
+
+   bool progress = vk_nir_lower_descriptor_heaps(nir, &map_info, &hopts, &samplers);
+   if (!progress) {
+      fprintf(out, "EXP: heap lowering made no progress\\n");
+      return false;
+   }
+   nir_validate_shader(nir, "after heap lowering");
+
+   /* Prepare the compiler state early: the immediate-sampler lowering below
+    * needs it. */
+   memset(&st, 0, sizeof(st));
+   st.ri.gfx_level = gfx;
+   st.ri.family = (gfx == GFX9) ? CHIP_VEGA10 : CHIP_NAVI10;
+   ac_fill_compiler_info(&st.ri, NULL, false);
+   st.ci.ac = &st.ri.compiler_info;
+   st.ci.hw.address32_hi = 0xfffffff0u;
+   {
+      uint32_t sampled_sz = (gfx == GFX9) ? 64 : 32;
+      st.ci.sampled_image_desc_size = sampled_sz;
+      st.ci.combined_image_sampler_desc_size = align(sampled_sz + RADV_SAMPLER_DESC_SIZE, 32);
+      st.ci.combined_image_sampler_offset =
+         st.ci.combined_image_sampler_desc_size - RADV_SAMPLER_DESC_SIZE;
+   }
+   st.stage.stage = MESA_SHADER_COMPUTE;
+   st.stage.info.descriptor_heap = true;
+   st.stage.args.descriptors[0].used = true; /* RADV_HEAP_RESOURCE */
+   st.stage.args.descriptors[1].used = true; /* RADV_HEAP_SAMPLER */
+   st.stage.args.descriptors[0].arg_index = 0;
+   st.stage.args.descriptors[1].arg_index = 1;
+   st.stage.args.ac.push_constants.used = true;
+   st.stage.args.ac.push_constants.arg_index = 2;
+   st.stage.args.cs_state.used = true;
+   st.stage.args.cs_state.arg_index = 3;
+   st.stage.args.ac.args[3].file = AC_ARG_SGPR;
+   st.stage.args.ac.args[3].size = 1;
+
+   /* Lower embedded samplers to constants, like radv_shader.c does. */
+   if (nir->info.uses_embedded_samplers)
+      radv_nir_lower_immediate_samplers(nir, &st.ci, &st.stage, &samplers);
+
+   /* ---- non-uniform waterfall, RADV-equivalent options ---- */
+   enum nir_lower_non_uniform_access_type types =
+      (enum nir_lower_non_uniform_access_type)(nir_lower_non_uniform_ubo_access |
+                                          nir_lower_non_uniform_ssbo_access |
+                                          nir_lower_non_uniform_texture_access |
+                                          nir_lower_non_uniform_image_access |
+                                          nir_lower_non_uniform_texture_query |
+                                          nir_lower_non_uniform_image_query);
+   if (nir_has_non_uniform_access(nir, types)) {
+      struct nir_lower_non_uniform_access_options nopts;
+      memset(&nopts, 0, sizeof(nopts));
+      nopts.types = types;
+      nir_lower_non_uniform_access(nir, &nopts);
+      nir_validate_shader(nir, "after non-uniform");
+   }
+
+   /* ---- radv_nir_lower_descriptors ---- */
+
+
+   radv_nir_lower_descriptors(nir, &st.ci, &st.stage);
+   nir_validate_shader(nir, "after radv_nir_lower_descriptors");
+
+   /* minimal subset of radv_postprocess_nir() finishing passes so the shader
+    * reaches ACO in the same canonical form as the real pipeline */
+   nir_function_impl *entry = nir_shader_get_entrypoint(nir);
+   (void)entry;
+   nir_lower_int64(nir);
+   nir_opt_algebraic(nir);
+   nir_opt_constant_folding(nir);
+   nir_opt_dce(nir);
+   ac_nir_lower_global_access(nir, gfx);
+   /* split vector consts LAST, like radv_pipeline.c does, so nothing folds
+    * them back into vector load_consts (ACO requires scalar consts) */
+   nir_lower_load_const_to_scalar(nir);
+   nir_opt_dce(nir);
+
+   if (getenv("EXP_DUMP_NIR")) {
+      FILE *f = fopen("/tmp/exp_nir.txt", "w");
+      nir_print_shader(nir, f);
+      fclose(f);
+   }
+
+   /* make arg loads isel-test friendly */
+   nir_shader_instructions_pass(nir, exp_rewrite_scalar_args, nir_metadata_all, NULL);
+   nir_shader_instructions_pass(nir, exp_split_packs, nir_metadata_all, NULL);
+   nir_validate_shader(nir, "after arg rewrite");
+
+   vk_sampler_state_array_finish(&samplers);
+   fprintf(out, "EXP: pipeline complete for gfx=%u\\n", gfx);
+   return true;
+}
+
+/* runtime stub: heap lowering only touches this for embedded samplers, which
+ * this experiment's mappings do not use */
+void
+vk_sampler_state_init(struct vk_sampler_state *state, const VkSamplerCreateInfo *info)
+{
+   (void)info;
+   memset(state, 0, sizeof(*state));
+}
+
+nir_shader *
+exp_build_embedded_for(enum amd_gfx_level gfx)
+{
+   static struct radeon_info ri;
+   static struct nir_shader_compiler_options opts;
+   memset(&ri, 0, sizeof(ri));
+   ri.gfx_level = gfx;
+   ri.family = (gfx == GFX9) ? CHIP_VEGA10 : CHIP_NAVI10;
+   ac_fill_compiler_info(&ri, NULL, false);
+   memset(&opts, 0, sizeof(opts));
+   ac_nir_set_options(&ri.compiler_info, false, &opts);
+   glsl_type_singleton_init_or_ref();
+   return exp_build_embedded_cis_shader(&opts);
+}
+
+/* Stub: descriptor contents are irrelevant for isel validation. */
+void
+radv_make_sampler_descriptor(const struct radv_compiler_info *compiler_info,
+                             const struct vk_sampler_state *sampler_state, uint32_t *desc)
+{
+   (void)compiler_info; (void)sampler_state;
+   desc[0] = 0x1000u;
+   desc[1] = 0x2000u;
+   desc[2] = 0x3000u;
+   desc[3] = 0x4000u;
+}
diff --git a/src/amd/compiler/tests/heap_pipeline_exp.h b/src/amd/compiler/tests/heap_pipeline_exp.h
new file mode 100644
index 00000000000..004103dc06e
--- /dev/null
+++ b/src/amd/compiler/tests/heap_pipeline_exp.h
@@ -0,0 +1,14 @@
+#ifndef HEAP_PIPELINE_EXP_H
+#define HEAP_PIPELINE_EXP_H
+
+#include "nir.h"
+#include "amd_family.h"
+#include <stdio.h>
+
+nir_shader *exp_build_shader_for(enum amd_gfx_level gfx);
+nir_shader *exp_build_embedded_for(enum amd_gfx_level gfx);
+bool exp_run_heap_pipeline(enum amd_gfx_level gfx, nir_shader *nir, FILE *out);
+nir_shader *exp_build_heap_tex_shader(const void *nir_options);
+nir_shader *exp_build_embedded_cis_shader(const void *nir_options);
+
+#endif
diff --git a/src/amd/compiler/tests/helpers.cpp b/src/amd/compiler/tests/helpers.cpp
index 97280afa56c..b0e53203aa8 100644
--- a/src/amd/compiler/tests/helpers.cpp
+++ b/src/amd/compiler/tests/helpers.cpp
