+type                                                                           \
+name(struct blob_reader *blob)                                                 \
+{                                                                              \
+   type ret = (type)0;                                                         \
+   blob_reader_align(blob, sizeof(type));                                      \
+   if (ensure_can_read(blob, sizeof(type))) {                                  \
+      memcpy(&ret, blob->current, sizeof(type));                               \
+      blob->current += sizeof(type);                                           \
