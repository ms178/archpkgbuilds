 radv_amdgpu_bo_va_op(struct radv_amdgpu_winsys *ws, uint32_t bo_handle, uint64_t offset, uint64_t size, uint64_t addr,
-                     uint32_t bo_flags, uint64_t internal_flags, uint32_t ops)
+                     uint32_t bo_flags, uint64_t internal_flags, uint32_t ops, uint32_t wait_count,
+                     const struct vk_sync_wait *waits)
 {
+   uint64_t wait_idx = 0;
+
+   STACK_ARRAY(uint32_t, wait_syncobj, wait_count);
+
+   if (!wait_syncobj)
+      return -ENOMEM;
+
+   if (ws->info.has_explicit_sync_vm_ops) {
+      for (uint32_t i = 0; i < wait_count; ++i) {
+         if (waits[i].sync->type == &vk_sync_dummy_type)
+            continue;
+
+         assert(waits[i].sync->type == &ws->syncobj_sync_type);
+         wait_syncobj[wait_idx] = ((struct vk_drm_syncobj *)waits[i].sync)->syncobj;
+         ++wait_idx;
+      }
+   }
+
    uint64_t flags = internal_flags;
    int r;
 
@@ -68,15 +90,21 @@ radv_amdgpu_bo_va_op(struct radv_amdgpu_winsys *ws, uint32_t bo_handle, uint64_t
       simple_mtx_unlock(&ws->vm_ioctl_lock);
 
       if (r)
-         return r;
+         goto out;
 
       r = ac_drm_cs_syncobj_timeline_wait(ws->dev, &ws->vm_timeline_syncobj, &vm_timeline_point, 1, INT64_MAX,
                                           DRM_SYNCOBJ_WAIT_FLAGS_WAIT_ALL | DRM_SYNCOBJ_WAIT_FLAGS_WAIT_FOR_SUBMIT,
                                           NULL);
+   } else if (ws->info.has_explicit_sync_vm_ops) {
+      flags |= AMDGPU_VM_EXPLICIT_SYNC;
+      r = ac_drm_bo_va_op_raw2(ws->dev, bo_handle, offset, size, addr, flags, ops, 0, 0,
+                               (uint64_t)(uintptr_t)wait_syncobj, wait_idx);
    } else {
       r = ac_drm_bo_va_op_raw(ws->dev, bo_handle, offset, size, addr, flags, ops);
    }
 
+out:
+   STACK_ARRAY_FINISH(wait_syncobj);
    return r;
 }
 
@@ -92,7 +120,11 @@ radv_amdgpu_canonicalize_va(uint64_t va)
 static uint64_t
 radv_amdgpu_bo_va_size(uint64_t bo_size, uint32_t flags)
 {
-   if (flags & RADEON_FLAG_VM_PAD_1PAGE) {
+   /* VM_PAD_1PAGE maps the first physical page of a real BO after its rounded-up VA range.
+    * Virtual sparse BOs are PRT-backed VA reservations and must not get this padding; padding
+    * those ranges can make the kernel reject the PRT mapping with EINVAL.
+    */
+   if ((flags & (RADEON_FLAG_VM_PAD_1PAGE | RADEON_FLAG_VIRTUAL)) == RADEON_FLAG_VM_PAD_1PAGE) {
       const uint64_t va_padding = 4096;
       return align64(bo_size, 4096) + va_padding;
    }
@@ -100,12 +132,25 @@ radv_amdgpu_bo_va_size(uint64_t bo_size, uint32_t flags)
    return bo_size;
 }
 
+static bool
+radv_amdgpu_add_va_gap_size(uint64_t va_size, uint64_t va_gap_size, uint64_t *total_size)
+{
+   if (va_size > ~0ull - va_gap_size)
+      return false;
+
+   *total_size = va_size + va_gap_size;
+   return true;
+}
+
 static void
 radv_amdgpu_log_va_op(struct radv_amdgpu_winsys *ws, struct radv_amdgpu_winsys_bo *bo, uint64_t offset, uint64_t size,
                       uint64_t virtual_va)
 {
+   if (!ws->debug_log_bos && !ws->bo_history_logfile)
+      return;
+
    const uint64_t timestamp = os_time_get_nano();
-   uint64_t mapped_va = bo ? (bo->base.va + offset) : 0;
+   const uint64_t mapped_va = bo ? (bo->base.va + offset) : 0;
 
