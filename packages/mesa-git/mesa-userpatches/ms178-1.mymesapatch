    &vlVaQueryVideoProcPipelineCaps
 };
 
+static void
+vlVaCleanupContextAlloc(vlVaContext *context)
+{
+   if (!context)
+      return;
+
+   /* NOTE: vlVaContext no longer owns the surface/buffer sets or a per-context
+    * mutex. Upstream moved both -- surfaces and buffers keep their own codec
+    * reference (see vlVaSurface::codec / vlVaBuffer::codec) and are unlinked
+    * through that reference, so there is nothing to release here.
+    */
+   FREE(context->desc.h264.pps ? context->desc.h264.pps->sps : NULL);
+   FREE(context->desc.h264.pps);
+   FREE(context->desc.h265.pps ? context->desc.h265.pps->sps : NULL);
+   FREE(context->desc.h265.pps);
+
+   if (context->desc.h264enc.frame_idx)
+      _mesa_hash_table_destroy(context->desc.h264enc.frame_idx, NULL);
+   if (context->desc.h265enc.frame_idx)
+      _mesa_hash_table_destroy(context->desc.h265enc.frame_idx, NULL);
+
+   util_dynarray_fini(&context->desc.h264enc.raw_headers);
+   util_dynarray_fini(&context->desc.h265enc.raw_headers);
+   util_dynarray_fini(&context->desc.av1enc.raw_headers);
+   util_dynarray_fini(&context->bs.buffers);
+   util_dynarray_fini(&context->bs.sizes);
+
+   FREE(context);
+}
