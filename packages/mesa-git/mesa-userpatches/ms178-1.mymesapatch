diff --git a/src/amd/vulkan/tests/heap_gfx9_exp.cpp b/src/amd/vulkan/tests/heap_gfx9_exp.cpp
new file mode 100644
index 00000000000..33df34c78be
--- /dev/null
+++ b/src/amd/vulkan/tests/heap_gfx9_exp.cpp
@@ -0,0 +1,809 @@
+/*
+ * ms178 v9.3 investigation: full driver-level reproduction of the DXVK v3.1
+ * descriptor-heap flow on the amdgpu noop drm-shim (VEGA10 = gfx9 / Vega 64,
+ * NAVI10 = gfx10 control).
+ *
+ * Reproduces exactly what DXVK does at device init + first draw:
+ *  - heap buffer: SHADER_DEVICE_ADDRESS|DESCRIPTOR_HEAP usage,
+ *    DEVICE_LOCAL|HOST_VISIBLE|HOST_COHERENT memory, memset to zero
+ *  - graphics pipeline with VkShaderDescriptorSetAndBindingMappingInfoEXT
+ *    on both stages + VK_PIPELINE_CREATE_2_DESCRIPTOR_HEAP_BIT_EXT
+ *    (sampler heap via CONSTANT_OFFSET, texture array via PUSH_INDEX —
+ *    the two mappings DXVK's DxvkPipelineLayout::initMappings() builds)
+ *  - CmdBindSamplerHeapEXT / CmdBindResourceHeapEXT / CmdPushDataEXT +
+ *    a draw, then EndCommandBuffer
+ *
+ * Any crash, ASAN report, or miscompilation here is a driver defect.
+ */
+
+#include "helpers.h"
+
+#include "drm-shim/amdgpu_noop_drm_shim.h"
+
+#include <cstdio>
+#include <cstring>
+#include <csignal>
+#include <execinfo.h>
+#include <unistd.h>
+
+extern "C" {
+#include "fs_spv.h"
+#include "vs_spv.h"
+
+PFN_vkVoidFunction VKAPI_CALL vk_icdGetInstanceProcAddr(VkInstance instance, const char *pName);
+}
+
+#include "heap_state_probe.h"
+
+namespace {
+
+struct heap_funcs {
+   PFN_vkCmdBindSamplerHeapEXT CmdBindSamplerHeapEXT;
+   PFN_vkCmdBindResourceHeapEXT CmdBindResourceHeapEXT;
+   PFN_vkCmdPushDataEXT CmdPushDataEXT;
+   PFN_vkGetBufferDeviceAddressEXT GetBufferDeviceAddress;
+   PFN_vkAllocateMemory AllocateMemory;
+   PFN_vkFreeMemory FreeMemory;
+   PFN_vkMapMemory MapMemory;
+   PFN_vkUnmapMemory UnmapMemory;
+   PFN_vkCreateBuffer CreateBuffer;
+   PFN_vkDestroyBuffer DestroyBuffer;
+   PFN_vkBindBufferMemory2 BindBufferMemory2;
+   PFN_vkGetBufferMemoryRequirements GetBufferMemoryRequirements;
+   PFN_vkGetPhysicalDeviceMemoryProperties GetPhysicalDeviceMemoryProperties;
+};
+
+bool
+get_heap_funcs(radv_test *test, heap_funcs *f)
+{
+   auto gpa = (PFN_vkGetDeviceProcAddr)vk_icdGetInstanceProcAddr(test->instance, "vkGetDeviceProcAddr");
+   if (!gpa)
+      return false;
+
+#define GET(name) f->name = (PFN_vk##name)gpa(test->device, "vk" #name)
+   GET(CmdBindSamplerHeapEXT);
+   GET(CmdBindResourceHeapEXT);
+   GET(CmdPushDataEXT);
+   GET(GetBufferDeviceAddress);
+   GET(AllocateMemory);
+   GET(FreeMemory);
+   GET(MapMemory);
+   GET(UnmapMemory);
+   GET(CreateBuffer);
+   GET(DestroyBuffer);
+   GET(BindBufferMemory2);
+   GET(GetBufferMemoryRequirements);
+#undef GET
+   f->GetPhysicalDeviceMemoryProperties = (PFN_vkGetPhysicalDeviceMemoryProperties)vk_icdGetInstanceProcAddr(
+      test->instance, "vkGetPhysicalDeviceMemoryProperties");
+   return f->CmdBindSamplerHeapEXT && f->CmdBindResourceHeapEXT && f->CmdPushDataEXT;
+}
+
+struct heap_bo {
+   VkBuffer buffer = VK_NULL_HANDLE;
+   VkDeviceMemory memory = VK_NULL_HANDLE;
+   void *map = nullptr;
+   VkDeviceAddress address = 0;
+};
+
+bool
+create_heap_bo(radv_test *test, heap_funcs *f, VkDeviceSize size, heap_bo *out)
+{
+   VkBufferCreateInfo buf_info = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .size = size,
+      .usage = VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT | VK_BUFFER_USAGE_DESCRIPTOR_HEAP_BIT_EXT,
+   };
+
+   if (f->CreateBuffer(test->device, &buf_info, nullptr, &out->buffer) != VK_SUCCESS)
+      return false;
+
+   VkMemoryRequirements reqs;
+   f->GetBufferMemoryRequirements(test->device, out->buffer, &reqs);
+
+   /* DXVK requests DEVICE_LOCAL|HOST_VISIBLE|HOST_COHERENT (falls back to
+    * HOST_VISIBLE|HOST_COHERENT when there is no visible VRAM type).
+    */
+   VkPhysicalDeviceMemoryProperties mem_props;
+   f->GetPhysicalDeviceMemoryProperties(test->physical_device, &mem_props);
+
+   int32_t type = -1, fallback = -1;
+   for (uint32_t i = 0; i < mem_props.memoryTypeCount; i++) {
+      if (!(reqs.memoryTypeBits & (1u << i)))
+         continue;
+      VkMemoryPropertyFlags flags = mem_props.memoryTypes[i].propertyFlags;
+      if ((flags & (VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT | VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                    VK_MEMORY_PROPERTY_HOST_COHERENT_BIT)) ==
+          (VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT | VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+           VK_MEMORY_PROPERTY_HOST_COHERENT_BIT)) {
+         type = i;
+         break;
+      }
+      if ((flags & (VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT)) ==
+             (VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT) &&
+          fallback < 0)
+         fallback = i;
+   }
+   if (type < 0)
+      type = fallback;
+   if (type < 0)
+      return false;
+
+   VkMemoryAllocateInfo alloc_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = reqs.size,
+      .memoryTypeIndex = (uint32_t)type,
+   };
+
+   if (f->AllocateMemory(test->device, &alloc_info, nullptr, &out->memory) != VK_SUCCESS)
+      return false;
+
+   VkBindBufferMemoryInfo bind_info = {
+      .sType = VK_STRUCTURE_TYPE_BIND_BUFFER_MEMORY_INFO,
+      .buffer = out->buffer,
+      .memory = out->memory,
+      .memoryOffset = 0,
+   };
+   if (f->BindBufferMemory2(test->device, 1, &bind_info) != VK_SUCCESS)
+      return false;
+
+   if (f->MapMemory(test->device, out->memory, 0, VK_WHOLE_SIZE, 0, &out->map) != VK_SUCCESS)
+      return false;
+
+   /* Zero the heap: never expose stale contents to the GPU. */
+   memset(out->map, 0, size);
+
+   VkBufferDeviceAddressInfo addr_info = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_DEVICE_ADDRESS_INFO,
+      .buffer = out->buffer,
+   };
+   out->address = f->GetBufferDeviceAddress(test->device, &addr_info);
+   return out->address != 0;
+}
+
+} /* namespace */
+
+/* radv_test is an abstract gtest fixture; make it instantiable. */
+struct exp_test : public radv_test {
+   void TestBody() override {}
+};
+
+/* create_device() with VK_EXT_descriptor_heap + the descriptorHeap feature
+ * enabled, mirroring what DXVK does.
+ */
+static bool
+create_heap_device(radv_test *test)
+{
+   VkApplicationInfo app_info = {
+      .sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+      .pApplicationName = "radv_heap_exp",
+      .apiVersion = VK_API_VERSION_1_3,
+   };
+
+   VkInstanceCreateInfo instance_info = {
+      .sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+      .pApplicationInfo = &app_info,
+   };
+
+   auto icd_gipa = (PFN_vkGetInstanceProcAddr)vk_icdGetInstanceProcAddr(NULL, "vkGetInstanceProcAddr");
+   auto CreateInstance = (PFN_vkCreateInstance)vk_icdGetInstanceProcAddr(NULL, "vkCreateInstance");
+   if (!CreateInstance || CreateInstance(&instance_info, nullptr, &test->instance) != VK_SUCCESS)
+      return false;
+
+#define ITEM(n) test->n = (PFN_vk##n)icd_gipa(test->instance, "vk" #n);
+   FUNCTION_LIST
+#undef ITEM
+
+   uint32_t device_count = 1;
+   if (test->EnumeratePhysicalDevices(test->instance, &device_count, &test->physical_device) != VK_SUCCESS)
+      return false;
+
+   static const char *extensions[] = {
+      "VK_KHR_pipeline_executable_properties",
+      "VK_EXT_descriptor_heap",
+   };
+
+   VkPhysicalDeviceDescriptorHeapFeaturesEXT heap_feature = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DESCRIPTOR_HEAP_FEATURES_EXT,
+      .descriptorHeap = VK_TRUE,
+   };
+   VkPhysicalDeviceVulkan13Features features13 = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES,
+      .pNext = &heap_feature,
+      .dynamicRendering = VK_TRUE,
+   };
+
+   VkDeviceCreateInfo device_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+      .pNext = &features13,
+      .enabledExtensionCount = ARRAY_SIZE(extensions),
+      .ppEnabledExtensionNames = extensions,
+   };
+
+   return test->CreateDevice(test->physical_device, &device_info, nullptr, &test->device) == VK_SUCCESS;
+}
+
+static void
+destroy_heap_device(radv_test *test)
+{
+   test->DestroyDevice(test->device, nullptr);
+   test->DestroyInstance(test->instance, nullptr);
+   test->unset_envvars();
+}
+
+struct exp_result {
+   bool ok;
+   uint32_t res_hi32, samp_hi32, res_lo32, samp_lo32;
+};
+
+static PFN_vkCreateGraphicsPipelines
+get_create_graphics_pipelines(VkInstance instance)
+{
+   return (PFN_vkCreateGraphicsPipelines)vk_icdGetInstanceProcAddr(instance, "vkCreateGraphicsPipelines");
+}
+
+/* Runs the full DXVK-style descriptor heap flow on a faked GPU. */
+static exp_result
+run_family(radv_test *test, heap_funcs *f, const char *family)
+{
+   exp_result r = {};
+
+   drm_shim_amdgpu_select_device(family);
+   if (!create_heap_device(test)) {
+      fprintf(stderr, "EXP: %s: device creation failed\n", family);
+      exp_result fail = {};
+      return fail;
+   }
+   if (!get_heap_funcs(test, f)) {
+      fprintf(stderr, "EXP: %s: heap entry points unavailable\n", family);
+      destroy_heap_device(test);
+      r.ok = false;
+      return r;
+   }
+
+   heap_bo resource_heap, sampler_heap;
+   if (!create_heap_bo(test, f, 8u << 20, &resource_heap) ||
+       !create_heap_bo(test, f, 64u << 10, &sampler_heap)) {
+      fprintf(stderr, "EXP: %s: heap buffer creation failed\n", family);
+      r.ok = false;
+   } else {
+      r.res_hi32 = (uint32_t)(resource_heap.address >> 32);
+      r.res_lo32 = (uint32_t)(resource_heap.address & 0xffffffffu);
+      r.samp_hi32 = (uint32_t)(sampler_heap.address >> 32);
+      r.samp_lo32 = (uint32_t)(sampler_heap.address & 0xffffffffu);
+      printf("EXP: %s: resource heap VA = 0x%08x_%08x, sampler heap VA = 0x%08x_%08x\n", family,
+             r.res_hi32, r.res_lo32, r.samp_hi32, r.samp_lo32);
+      r.ok = true;
+
+      /* ---------- pipeline layout ---------- */
+      VkPushConstantRange pc_range = {
+         .stageFlags = VK_SHADER_STAGE_FRAGMENT_BIT,
+         .offset = 0,
+         .size = 8,
+      };
+
+      /* Mapping #0: sampler heap at set 0, binding 0 (DXVK's UsesSamplerHeap).
+       * Mapping #1: texture array at set 1, binding 0 with PUSH_INDEX.
+       */
+      VkDescriptorSetAndBindingMappingEXT mappings[2] = {};
+
+      mappings[0].sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_AND_BINDING_MAPPING_EXT;
+      mappings[0].descriptorSet = 0;
+      mappings[0].firstBinding = 0;
+      mappings[0].bindingCount = 1;
+      mappings[0].resourceMask = VK_SPIRV_RESOURCE_TYPE_SAMPLER_BIT_EXT;
+      mappings[0].source = VK_DESCRIPTOR_MAPPING_SOURCE_HEAP_WITH_CONSTANT_OFFSET_EXT;
+      mappings[0].sourceData.constantOffset.heapOffset = 0; /* no reserved range */
+      mappings[0].sourceData.constantOffset.heapArrayStride = 16;
+
+      mappings[1].sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_AND_BINDING_MAPPING_EXT;
+      mappings[1].descriptorSet = 1;
+      mappings[1].firstBinding = 0;
+      mappings[1].bindingCount = 1;
+      mappings[1].resourceMask = VK_SPIRV_RESOURCE_TYPE_SAMPLED_IMAGE_BIT_EXT;
+      mappings[1].source = VK_DESCRIPTOR_MAPPING_SOURCE_HEAP_WITH_PUSH_INDEX_EXT;
+      mappings[1].sourceData.pushIndex.heapOffset = 0;
+      mappings[1].sourceData.pushIndex.pushOffset = 0;
+      mappings[1].sourceData.pushIndex.heapIndexStride = 64; /* set-alignment shift, like DXVK */
+      mappings[1].sourceData.pushIndex.heapArrayStride = 64; /* sampled image desc size on GFX9 */
+
+      VkShaderDescriptorSetAndBindingMappingInfoEXT mapping_info = {
+         .sType = VK_STRUCTURE_TYPE_SHADER_DESCRIPTOR_SET_AND_BINDING_MAPPING_INFO_EXT,
+         .mappingCount = 2,
+         .pMappings = mappings,
+      };
+
+      VkPipelineLayoutCreateInfo layout_info = {
+         .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+         .setLayoutCount = 0,
+         .pushConstantRangeCount = 1,
+         .pPushConstantRanges = &pc_range,
+      };
+
+      VkPipelineLayout layout;
+      if (test->CreatePipelineLayout(test->device, &layout_info, nullptr, &layout) != VK_SUCCESS) {
+         fprintf(stderr, "EXP: %s: pipeline layout creation failed\n", family);
+         r.ok = false;
+      } else {
+         VkShaderModuleCreateInfo fs_info = {
+            .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+            .codeSize = sizeof(fs_spv),
+            .pCode = fs_spv,
+         };
+         VkShaderModuleCreateInfo vs_info = {
+            .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+            .codeSize = sizeof(vs_spv),
+            .pCode = vs_spv,
+         };
+         VkShaderModule fs_module, vs_module;
+         test->CreateShaderModule(test->device, &fs_info, nullptr, &fs_module);
+         test->CreateShaderModule(test->device, &vs_info, nullptr, &vs_module);
+
+         VkPipelineShaderStageCreateInfo stages[2] = {
+            {
+               .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+               .pNext = &mapping_info,
+               .stage = VK_SHADER_STAGE_VERTEX_BIT,
+               .module = vs_module,
+               .pName = "main",
+            },
+            {
+               .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+               .pNext = &mapping_info,
+               .stage = VK_SHADER_STAGE_FRAGMENT_BIT,
+               .module = fs_module,
+               .pName = "main",
+            },
+         };
+
+         VkPipelineVertexInputStateCreateInfo vertex_input = {
+            .sType = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO,
+         };
+
+         VkPipelineInputAssemblyStateCreateInfo ia = {
+            .sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO,
+            .topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST,
+         };
+
+         VkPipelineViewportStateCreateInfo vp = {
+            .sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO,
+            .viewportCount = 1,
+            .scissorCount = 1,
+         };
+
+         VkPipelineRasterizationStateCreateInfo rs = {
+            .sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO,
+            .lineWidth = 1.0f,
+         };
+
+         VkPipelineMultisampleStateCreateInfo ms = {
+            .sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO,
+            .rasterizationSamples = VK_SAMPLE_COUNT_1_BIT,
+         };
+
+         VkPipelineColorBlendAttachmentState blend_att = {
+            .colorWriteMask = VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT | VK_COLOR_COMPONENT_B_BIT |
+                              VK_COLOR_COMPONENT_A_BIT,
+         };
+         VkPipelineColorBlendStateCreateInfo cb = {
+            .sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO,
+            .attachmentCount = 1,
+            .pAttachments = &blend_att,
+         };
+
+         static const VkDynamicState dyn_states[] = {VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR};
+         VkPipelineDynamicStateCreateInfo dyn = {
+            .sType = VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO,
+            .dynamicStateCount = 2,
+            .pDynamicStates = dyn_states,
+         };
+
+         static const VkFormat color_formats[] = {VK_FORMAT_B8G8R8A8_UNORM};
+         VkPipelineRenderingCreateInfo rendering = {
+            .sType = VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO,
+            .colorAttachmentCount = 1,
+            .pColorAttachmentFormats = color_formats,
+         };
+         VkPipelineCreateFlags2CreateInfo flags2 = {
+            .sType = VK_STRUCTURE_TYPE_PIPELINE_CREATE_FLAGS_2_CREATE_INFO,
+            .pNext = &rendering,
+            .flags = VK_PIPELINE_CREATE_2_DESCRIPTOR_HEAP_BIT_EXT |
+                   VK_PIPELINE_CREATE_2_CAPTURE_INTERNAL_REPRESENTATIONS_BIT_KHR,
+         };
+
+         VkGraphicsPipelineCreateInfo pipe_info = {
+            .sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO,
+            .pNext = &flags2,
+            .stageCount = 2,
+            .pStages = stages,
+            .pVertexInputState = &vertex_input,
+            .pInputAssemblyState = &ia,
+            .pViewportState = &vp,
+            .pRasterizationState = &rs,
+            .pMultisampleState = &ms,
+            .pColorBlendState = &cb,
+            .pDynamicState = &dyn,
+            .layout = layout,
+            .renderPass = VK_NULL_HANDLE,
+            .subpass = 0,
+         };
+
+         VkPipeline pipeline;
+         PFN_vkCreateGraphicsPipelines CreateGraphicsPipelines = get_create_graphics_pipelines(test->instance);
+         VkResult result = CreateGraphicsPipelines(test->device, VK_NULL_HANDLE, 1, &pipe_info, nullptr,
+                                                    &pipeline);
+         if (result != VK_SUCCESS) {
+            fprintf(stderr, "EXP: %s: graphics pipeline creation failed: %d\n", family, result);
+            r.ok = false;
+         } else {
+            /* ---------- record a draw ---------- */
+            PFN_vkAllocateCommandBuffers AllocateCommandBuffers = (PFN_vkAllocateCommandBuffers)
+               vk_icdGetInstanceProcAddr(test->instance, "vkAllocateCommandBuffers");
+            PFN_vkBeginCommandBuffer BeginCommandBuffer = (PFN_vkBeginCommandBuffer)
+               vk_icdGetInstanceProcAddr(test->instance, "vkBeginCommandBuffer");
+            PFN_vkEndCommandBuffer EndCommandBuffer =
+               (PFN_vkEndCommandBuffer)vk_icdGetInstanceProcAddr(test->instance, "vkEndCommandBuffer");
+            PFN_vkCreateCommandPool CreateCommandPool = (PFN_vkCreateCommandPool)vk_icdGetInstanceProcAddr(
+               test->instance, "vkCreateCommandPool");
+            PFN_vkCmdBeginRendering CmdBeginRendering = (PFN_vkCmdBeginRendering)vk_icdGetInstanceProcAddr(
+               test->instance, "vkCmdBeginRendering");
+            PFN_vkCmdEndRendering CmdEndRendering = (PFN_vkCmdEndRendering)vk_icdGetInstanceProcAddr(
+               test->instance, "vkCmdEndRendering");
+            PFN_vkCmdBindPipeline CmdBindPipeline = (PFN_vkCmdBindPipeline)vk_icdGetInstanceProcAddr(
+               test->instance, "vkCmdBindPipeline");
+            PFN_vkCmdSetViewport CmdSetViewport =
+               (PFN_vkCmdSetViewport)vk_icdGetInstanceProcAddr(test->instance, "vkCmdSetViewport");
+            PFN_vkCmdSetScissor CmdSetScissor =
+               (PFN_vkCmdSetScissor)vk_icdGetInstanceProcAddr(test->instance, "vkCmdSetScissor");
+            PFN_vkCmdDraw CmdDraw = (PFN_vkCmdDraw)vk_icdGetInstanceProcAddr(test->instance, "vkCmdDraw");
+
+            VkCommandPoolCreateInfo pool_info = {
+               .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+               .flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT,
+            };
+            VkCommandPool pool;
+            CreateCommandPool(test->device, &pool_info, nullptr, &pool);
+
+            VkCommandBufferAllocateInfo cb_info = {
+               .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+               .commandPool = pool,
+               .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+               .commandBufferCount = 1,
+            };
+            VkCommandBuffer cmd;
+            AllocateCommandBuffers(test->device, &cb_info, &cmd);
+
+            VkCommandBufferBeginInfo begin_info = {
+               .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+            };
+            BeginCommandBuffer(cmd, &begin_info);
+
+            /* DXVK: bind sampler + resource heaps */
+            VkBindHeapInfoEXT sampler_bind = {
+               .sType = VK_STRUCTURE_TYPE_BIND_HEAP_INFO_EXT,
+            };
+            sampler_bind.heapRange.address = sampler_heap.address;
+            sampler_bind.heapRange.size = 64u << 10;
+            f->CmdBindSamplerHeapEXT(cmd, &sampler_bind);
+
+            VkBindHeapInfoEXT resource_bind = {
+               .sType = VK_STRUCTURE_TYPE_BIND_HEAP_INFO_EXT,
+            };
+            resource_bind.heapRange.address = resource_heap.address;
+            resource_bind.heapRange.size = 8u << 20;
+            f->CmdBindResourceHeapEXT(cmd, &resource_bind);
+
+            /* DXVK: push the set offset + sampler index */
+            uint32_t push_data[2] = {0 /* set offset: heap offset >> 6 */, 0 /* sampIndex */};
+            VkPushDataInfoEXT push_info = {
+               .sType = VK_STRUCTURE_TYPE_PUSH_DATA_INFO_EXT,
+               .offset = 0,
+               .data = {
+                  .address = push_data,
+                  .size = sizeof(push_data),
+               },
+            };
+            f->CmdPushDataEXT(cmd, &push_info);
+
+            VkRenderingInfo rendering_info = {
+               .sType = VK_STRUCTURE_TYPE_RENDERING_INFO,
+               .renderArea = {{0, 0}, {64, 64}},
+               .layerCount = 1,
+               .colorAttachmentCount = 0,
+            };
+            CmdBeginRendering(cmd, &rendering_info);
+            CmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+            VkViewport viewport = {};
+            viewport.width = 64; viewport.height = 64;
+            viewport.maxDepth = 1.0f;
+            VkRect2D scissor = {};
+            scissor.extent = {64, 64};
+            CmdSetViewport(cmd, 0, 1, &viewport);
+            CmdSetScissor(cmd, 0, 1, &scissor);
+            CmdDraw(cmd, 3, 1, 0, 0);
+            CmdEndRendering(cmd);
+
+            result = EndCommandBuffer(cmd);
+            printf("EXP: %s: command buffer recorded, EndCommandBuffer=%d\n", family, result);
+            if (result != VK_SUCCESS)
+               r.ok = false;
+
+            PFN_vkDestroyCommandPool DestroyCommandPool = (PFN_vkDestroyCommandPool)vk_icdGetInstanceProcAddr(
+               test->instance, "vkDestroyCommandPool");
+            DestroyCommandPool(test->device, pool, nullptr);
+
+            /* Dump the final ISA of every executable (requires
+             * VK_PIPELINE_CREATE_2_CAPTURE_INTERNAL_REPRESENTATIONS + heap
+             * mappings). */
+            {
+               auto gpa2 = (PFN_vkGetDeviceProcAddr)vk_icdGetInstanceProcAddr(test->instance, "vkGetDeviceProcAddr");
+               auto GetExecProps = (PFN_vkGetPipelineExecutablePropertiesKHR)gpa2(test->device,
+                                                                                    "vkGetPipelineExecutablePropertiesKHR");
+               auto GetExecIR = (PFN_vkGetPipelineExecutableInternalRepresentationsKHR)gpa2(
+                  test->device, "vkGetPipelineExecutableInternalRepresentationsKHR");
+
+               VkPipelineInfoKHR pinfo = {
+                  .sType = VK_STRUCTURE_TYPE_PIPELINE_INFO_KHR,
+                  .pipeline = pipeline,
+               };
+               uint32_t count = 0;
+               if (GetExecProps(test->device, &pinfo, &count, nullptr) == VK_SUCCESS && count) {
+                  VkPipelineExecutablePropertiesKHR *props =
+                     (VkPipelineExecutablePropertiesKHR *)calloc(count, sizeof(*props));
+                  GetExecProps(test->device, &pinfo, &count, props);
+
+                  for (uint32_t e = 0; e < count; e++) {
+                     printf("EXP: %s: === %s (%s) ===\n", family, props[e].name,
+                            props[e].stages & VK_SHADER_STAGE_FRAGMENT_BIT ? "fragment" : "other");
+                     VkPipelineExecutableInfoKHR einfo = {
+                        .sType = VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_INFO_KHR,
+                        .pipeline = pipeline,
+                        .executableIndex = e,
+                     };
+                     uint32_t ir_count = 0;
+                     if (GetExecIR(test->device, &einfo, &ir_count, nullptr) != VK_SUCCESS || !ir_count)
+                        continue;
+                     VkPipelineExecutableInternalRepresentationKHR *irs =
+                        (VkPipelineExecutableInternalRepresentationKHR *)calloc(ir_count, sizeof(*irs));
+                     if (GetExecIR(test->device, &einfo, &ir_count, irs) != VK_SUCCESS) {
+                        free(irs);
+                        continue;
+                     }
+                     for (uint32_t i = 0; i < ir_count; i++) {
+                        if (strcmp(irs[i].name, "Assembly") && strcmp(irs[i].name, "asm"))
+                           continue;
+                        size_t sz = irs[i].dataSize;
+                        char *buf = (char *)malloc(sz + 1);
+                        irs[i].pData = buf;
+                        irs[i].dataSize = sz;
+                        if (GetExecIR(test->device, &einfo, &ir_count, irs) == VK_SUCCESS) {
+                           buf[sz] = 0;
+                           printf("EXP-BEGIN-%s-%s\n%s\nEXP-END\n", family, props[e].name, buf);
+                        }
+                        free(buf);
+                        break;
+                     }
+                     free(irs);
+                  }
+                  free(props);
+               }
+            }
+
+            test->DestroyPipeline(test->device, pipeline, nullptr);
+         }
+
+         test->DestroyShaderModule(test->device, fs_module, nullptr);
+         test->DestroyShaderModule(test->device, vs_module, nullptr);
+         test->DestroyPipelineLayout(test->device, layout, nullptr);
+      }
+
+      f->UnmapMemory(test->device, resource_heap.memory);
+      f->FreeMemory(test->device, resource_heap.memory, nullptr);
+      f->DestroyBuffer(test->device, resource_heap.buffer, nullptr);
+      f->UnmapMemory(test->device, sampler_heap.memory);
+      f->FreeMemory(test->device, sampler_heap.memory, nullptr);
+      f->DestroyBuffer(test->device, sampler_heap.buffer, nullptr);
+   }
+
+   destroy_heap_device(test);
+   return r;
+}
+
+int
+heap_gfx9_exp_main(int argc, char **argv)
+{
+   exp_test test;
+   heap_funcs f = {};
+
+   for (const char *family : {"vega10", "navi10"}) {
+      exp_result r = run_family(&test, &f, family);
+      if (r.ok) {
+         if (r.res_hi32 != r.samp_hi32) {
+            fprintf(stderr, "EXP: %s: heap VA high halves differ (%08x vs %08x)\n", family, r.res_hi32,
+                    r.samp_hi32);
+         }
+      }
+   }
+
+   (void)argc;
+   (void)argv;
+   return 0;
+}
+
+static void
+segv_handler(int sig, siginfo_t *info, void *ctx)
+{
+   fprintf(stderr, "\nEXP: SIGSEGV at address %p\n", info->si_addr);
+   void *bt[32];
+   int n = backtrace(bt, 32);
+   backtrace_symbols_fd(bt, n, STDERR_FILENO);
+   _exit(99);
+}
+
+TEST(misc_heap_exp, dxvk_flow)
+{
+   struct sigaction sa = {};
+   sa.sa_sigaction = segv_handler;
+   sa.sa_flags = SA_SIGINFO;
+   sigaction(SIGSEGV, &sa, NULL);
+   sigaction(SIGABRT, &sa, NULL);
+
+   heap_gfx9_exp_main(0, nullptr);
+}
+
+/* --------------------------------------------------------------------------
+ * Regression test for the Total War: Troy GFX9 hang:
+ *
+ *   radv_reset_cmd_buffer() cleared descriptors[].dirty_heaps/valid_heaps but
+ *   not cmd_buffer->descriptor_heaps[] (the per-recording heap address cache).
+ *   When an application (DXVK resets its command buffers/pool every frame)
+ *   re-recorded a command buffer and re-bound the *same* heap addresses,
+ *   radv_bind_descriptor_heap()'s address compare early-out skipped setting
+ *   the dirty+valid bits, so the heap base user SGPRs (descriptors[0/1]) were
+ *   never emitted for the new recording. Shaders then computed descriptor
+ *   addresses from uninitialized SGPRs, and on GFX9 a partially out-of-bounds
+ *   SMEM load hangs the shader pipes instead of faulting -> GPU hang at the
+ *   first heap draw of the frame.
+ *
+ * Verified through a C state probe (heap_state_probe.c) because the noop drm
+ * shim cannot observe emitted PM4 user data.
+ * ------------------------------------------------------------------------ */
+TEST(misc_heap_exp, heap_rebind_after_reset)
+{
+   exp_test test;
+   heap_funcs f = {};
+   bool failed = false;
+
+   for (const char *family : {"vega10", "navi10"}) {
+      drm_shim_amdgpu_select_device(family);
+      if (!create_heap_device(&test)) {
+         fprintf(stderr, "REBIND: %s: device creation failed\n", family);
+         failed = true;
+         continue;
+      }
+      if (!get_heap_funcs(&test, &f)) {
+         fprintf(stderr, "REBIND: %s: heap entry points unavailable\n", family);
+         destroy_heap_device(&test);
+         failed = true;
+         continue;
+      }
+
+      heap_bo resource_heap, sampler_heap;
+      if (!create_heap_bo(&test, &f, 8u << 20, &resource_heap) ||
+          !create_heap_bo(&test, &f, 64u << 10, &sampler_heap)) {
+         fprintf(stderr, "REBIND: %s: heap buffer creation failed\n", family);
+         destroy_heap_device(&test);
+         failed = true;
+         continue;
+      }
+
+      auto icd_gpa = (PFN_vkGetInstanceProcAddr)vk_icdGetInstanceProcAddr(NULL, "vkGetInstanceProcAddr");
+      auto CreateCommandPool = (PFN_vkCreateCommandPool)icd_gpa(test.instance, "vkCreateCommandPool");
+      auto DestroyCommandPool = (PFN_vkDestroyCommandPool)icd_gpa(test.instance, "vkDestroyCommandPool");
+      auto AllocateCommandBuffers =
+         (PFN_vkAllocateCommandBuffers)icd_gpa(test.instance, "vkAllocateCommandBuffers");
+      auto FreeCommandBuffers = (PFN_vkFreeCommandBuffers)icd_gpa(test.instance, "vkFreeCommandBuffers");
+      auto BeginCommandBuffer = (PFN_vkBeginCommandBuffer)icd_gpa(test.instance, "vkBeginCommandBuffer");
+      auto EndCommandBuffer = (PFN_vkEndCommandBuffer)icd_gpa(test.instance, "vkEndCommandBuffer");
+      auto ResetCommandBuffer = (PFN_vkResetCommandBuffer)icd_gpa(test.instance, "vkResetCommandBuffer");
+
+      VkCommandPoolCreateInfo pool_info = {
+         .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+         .flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT,
+      };
+      VkCommandPool pool;
+      VkResult res = CreateCommandPool(test.device, &pool_info, nullptr, &pool);
+      ASSERT_EQ(VK_SUCCESS, res);
+
+      VkCommandBufferAllocateInfo cb_info = {
+         .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+         .commandPool = pool,
+         .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+         .commandBufferCount = 1,
+      };
+      VkCommandBuffer cmd;
+      res = AllocateCommandBuffers(test.device, &cb_info, &cmd);
+      ASSERT_EQ(VK_SUCCESS, res);
+
+      const uint32_t heap_bits = 0x3; /* (1 << RADV_HEAP_RESOURCE) | (1 << RADV_HEAP_SAMPLER) */
+      uint32_t dirty_heaps = 0, valid_heaps = 0;
+      uint64_t probe_resource_va = 0, probe_sampler_va = 0;
+      auto probe = [&]() {
+         return radv_test_probe_heap_state(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, &dirty_heaps, &valid_heaps,
+                                           &probe_resource_va, &probe_sampler_va);
+      };
+
+      VkBindHeapInfoEXT sampler_bind = {.sType = VK_STRUCTURE_TYPE_BIND_HEAP_INFO_EXT};
+      sampler_bind.heapRange.address = sampler_heap.address;
+      sampler_bind.heapRange.size = 64u << 10;
+      VkBindHeapInfoEXT resource_bind = {.sType = VK_STRUCTURE_TYPE_BIND_HEAP_INFO_EXT};
+      resource_bind.heapRange.address = resource_heap.address;
+      resource_bind.heapRange.size = 8u << 20;
+
+      /* First recording: bind both heaps. */
+      VkCommandBufferBeginInfo begin_info = {
+         .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+      };
+      res = BeginCommandBuffer(cmd, &begin_info);
+      ASSERT_EQ(VK_SUCCESS, res);
+      f.CmdBindSamplerHeapEXT(cmd, &sampler_bind);
+      f.CmdBindResourceHeapEXT(cmd, &resource_bind);
+      ASSERT_TRUE(probe());
+      EXPECT_EQ(heap_bits, valid_heaps & heap_bits);
+      EXPECT_EQ(heap_bits, dirty_heaps & heap_bits);
+      EXPECT_EQ(resource_heap.address, probe_resource_va);
+      EXPECT_EQ(sampler_heap.address, probe_sampler_va);
+      /* Rebinding the same addresses within one recording is a no-op. */
+      f.CmdBindSamplerHeapEXT(cmd, &sampler_bind);
+      f.CmdBindResourceHeapEXT(cmd, &resource_bind);
+      probe();
+      EXPECT_EQ(heap_bits, valid_heaps & heap_bits);
+      EXPECT_EQ(heap_bits, dirty_heaps & heap_bits);
+      res = EndCommandBuffer(cmd);
+      ASSERT_EQ(VK_SUCCESS, res);
+
+      /* DXVK's per-frame pattern: reset the command buffer, then re-record it
+       * and re-bind the *same* heap addresses.
+       */
+      res = ResetCommandBuffer(cmd, 0);
+      ASSERT_EQ(VK_SUCCESS, res);
+      probe();
+      EXPECT_EQ(0u, valid_heaps & heap_bits);
+      EXPECT_EQ(0u, dirty_heaps & heap_bits);
+      EXPECT_EQ(0u, probe_resource_va);
+      EXPECT_EQ(0u, probe_sampler_va);
+
+      /* The exact hang scenario: same heap VAs after a reset. The bind must
+       * re-mark the heaps dirty so the heap base user SGPRs are re-emitted.
+       */
+      res = BeginCommandBuffer(cmd, &begin_info);
+      ASSERT_EQ(VK_SUCCESS, res);
+      f.CmdBindSamplerHeapEXT(cmd, &sampler_bind);
+      f.CmdBindResourceHeapEXT(cmd, &resource_bind);
+      probe();
+      if ((dirty_heaps & heap_bits) != heap_bits || (valid_heaps & heap_bits) != heap_bits) {
+         fprintf(stderr, "REBIND: %s: heap bind after reset did not re-dirty "
+                         "(dirty=%u valid=%u); heap user SGPRs would never be emitted\n",
+                 family, dirty_heaps, valid_heaps);
+         failed = true;
+      }
+      EXPECT_EQ(resource_heap.address, probe_resource_va);
+      EXPECT_EQ(sampler_heap.address, probe_sampler_va);
+      res = EndCommandBuffer(cmd);
+      ASSERT_EQ(VK_SUCCESS, res);
+
+      FreeCommandBuffers(test.device, pool, 1, &cmd);
+      DestroyCommandPool(test.device, pool, nullptr);
+
+      f.UnmapMemory(test.device, resource_heap.memory);
+      f.FreeMemory(test.device, resource_heap.memory, nullptr);
+      f.DestroyBuffer(test.device, resource_heap.buffer, nullptr);
+      f.UnmapMemory(test.device, sampler_heap.memory);
+      f.FreeMemory(test.device, sampler_heap.memory, nullptr);
+      f.DestroyBuffer(test.device, sampler_heap.buffer, nullptr);
+
+      destroy_heap_device(&test);
+   }
+
+   EXPECT_FALSE(failed) << "heap rebind after reset regressed";
+}
diff --git a/src/amd/vulkan/tests/heap_state_probe.c b/src/amd/vulkan/tests/heap_state_probe.c
new file mode 100644
index 00000000000..c8227c70b9f
--- /dev/null
+++ b/src/amd/vulkan/tests/heap_state_probe.c
@@ -0,0 +1,31 @@
+/*
+ * ms178 v9.4: C probe exposing internal descriptor-heap command buffer state
+ * to the C++ gtest. The RADV headers are not C++-safe, so the state is read
+ * from a small C translation unit linked into the same test binary.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "heap_state_probe.h"
+
+#include "radv_cmd_buffer.h"
+
+#include "radv_constants.h"
+
+bool
+radv_test_probe_heap_state(VkCommandBuffer cmdBuffer, VkPipelineBindPoint bindPoint, uint32_t *dirty_heaps,
+                           uint32_t *valid_heaps, uint64_t *resource_va, uint64_t *sampler_va)
+{
+   VK_FROM_HANDLE(radv_cmd_buffer, cmd_buffer, cmdBuffer);
+
+   if (!cmd_buffer)
+      return false;
+
+   const struct radv_descriptor_state *descs = &cmd_buffer->descriptors[vk_to_bind_point(bindPoint)];
+
+   *dirty_heaps = descs->dirty_heaps;
+   *valid_heaps = descs->valid_heaps;
+   *resource_va = cmd_buffer->descriptor_heaps[RADV_HEAP_RESOURCE];
+   *sampler_va = cmd_buffer->descriptor_heaps[RADV_HEAP_SAMPLER];
+   return true;
+}
diff --git a/src/amd/vulkan/tests/heap_state_probe.h b/src/amd/vulkan/tests/heap_state_probe.h
new file mode 100644
index 00000000000..fe4907f0ed2
--- /dev/null
+++ b/src/amd/vulkan/tests/heap_state_probe.h
@@ -0,0 +1,29 @@
+/*
+ * ms178 v9.4: C probe exposing internal descriptor-heap command buffer state
+ * to the C++ gtest. The RADV headers are not C++-safe, so the state is read
+ * from a small C translation unit linked into the same test binary.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef RADV_TESTS_HEAP_STATE_PROBE_H
+#define RADV_TESTS_HEAP_STATE_PROBE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include <vulkan/vulkan.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Returns false if the command buffer handle is invalid. */
+bool radv_test_probe_heap_state(VkCommandBuffer cmdBuffer, VkPipelineBindPoint bindPoint, uint32_t *dirty_heaps,
+                                uint32_t *valid_heaps, uint64_t *resource_va, uint64_t *sampler_va);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* RADV_TESTS_HEAP_STATE_PROBE_H */
