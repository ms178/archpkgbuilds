+      //~gfx10! v2b: %0:v[0][0:16] = v_add_u16_e64 0x4200, 0
+      //~gfx11! v2b: %0:v[0][0:16] = v_mov_b16 0x4200
+      bld.pseudo(aco_opcode::p_unit_test, Operand::zero());
+      bld.pseudo(aco_opcode::p_create_vector, Definition(v0_lo, v2b), Operand(v1b),
+                 Operand::c8(0x42));
+
+      //! p_unit_test 1
+      //! v1: %0:v[0] = v_mov_b32 0x42050000
+      bld.pseudo(aco_opcode::p_unit_test, Operand::c32(1));
+      bld.pseudo(aco_opcode::p_create_vector, Definition(v0_lo, v4b), Operand(v2b),
+                 Operand::c16(0x4205));
+
+      //! p_unit_test 2
+      //! v1: %0:v[0] = v_mov_b32 0x34561200
+      bld.pseudo(aco_opcode::p_unit_test, Operand::c32(2));
+      bld.pseudo(aco_opcode::p_create_vector, Definition(v0_lo, v1), Operand(v1b),
+                 Operand::c8(0x12), Operand::c16(0x3456));
+
+      //! p_unit_test 3
+      //! v1: %0:v[0] = v_mov_b32 0x34560012
+      bld.pseudo(aco_opcode::p_unit_test, Operand::c32(3));
+      bld.pseudo(aco_opcode::p_create_vector, Definition(v0_lo, v1), Operand::c8(0x12),
+                 Operand(v1b), Operand::c16(0x3456));
+
+      //! p_unit_test 4
+      //! v1: %0:v[0] = v_mov_b32 0x120000
+      bld.pseudo(aco_opcode::p_unit_test, Operand::c32(4));
+      bld.pseudo(aco_opcode::p_create_vector, Definition(v0_lo, v1), Operand(v2b),
+                 Operand::c8(0x12), Operand(v1b));
+
+      finish_to_hw_instr_test();
+   }
+END_TEST
+
 BEGIN_TEST(to_hw_instr.self_intersecting_swap)
    if (!setup_cs(NULL, GFX9))
       return;
