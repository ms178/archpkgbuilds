diff --git a/src/amd/vulkan/radv_cmd_buffer.c b/src/amd/vulkan/radv_cmd_buffer.c
index cf03f2b347a..f191843bd2d 100644
--- a/src/amd/vulkan/radv_cmd_buffer.c
+++ b/src/amd/vulkan/radv_cmd_buffer.c
@@ -1493,6 +1493,14 @@ radv_reset_cmd_buffer(struct vk_command_buffer *vk_cmd_buffer, UNUSED VkCommandB
       cmd_buffer->descriptors[i].dirty_heaps = 0;
       cmd_buffer->descriptors[i].valid_heaps = 0;
    }
+
+   /* Clear the bound descriptor-heap VAs as well: after a reset the command
+    * buffer has no heaps bound.  Leaving stale addresses behind breaks the
+    * DXVK per-frame pattern (reset -> re-record -> bind the same heap
+    * addresses), where the heaps must be re-dirtied and the heap base user
+    * SGPRs re-emitted from a clean slate.
+    */
+   memset(cmd_buffer->descriptor_heaps, 0, sizeof(cmd_buffer->descriptor_heaps));
 }
 
