diff --git a/src/amd/vulkan/radv_anti_lag.c b/src/amd/vulkan/radv_anti_lag.c
index d31039debed..62be901528d 100644
--- a/src/amd/vulkan/radv_anti_lag.c
+++ b/src/amd/vulkan/radv_anti_lag.c
@@ -9,6 +9,10 @@
 #include "radv_entrypoints.h"
 #include "vk_frame_pacer.h"
 
+#if defined(__x86_64__) || defined(_M_X64)
+#include <immintrin.h> /* _mm_pause for the deadline spin-wait */
+#endif
+
 #define ONE_MS_IN_NS INT64_C(1000000)
 
 struct anti_lag_data {
@@ -85,6 +89,38 @@ get_wait_time(struct anti_lag_data *data)
    return MAX2(delay, 0);
 }
 
+/* Anti-Lag pacing is latency-critical: the whole point is to release the CPU
+ * exactly at the deadline.  os_time_nanosleep_until() alone can overshoot the
+ * deadline by the scheduler's timer granularity (CONFIG_HZ / timer slack,
+ * commonly 0.25-1 ms on Linux), which directly translates into added input
+ * latency.  Sleep only until shortly before the deadline, then busy-wait the
+ * remainder: the spin window is small enough to keep the CPU-cost negligible
+ * (at 144 fps one 250 us spin is ~0.9% of one core per frame) while removing
+ * the wakeup-jitter term from the latency budget.
+ */
+#define ANTI_LAG_SPIN_WINDOW_NS UINT64_C(250000)
+
+static void
+anti_lag_wait_until(uint64_t deadline)
+{
+   const uint64_t now = os_time_get_nano();
+   if (deadline <= now)
+      return;
+
+   if (deadline - now > ANTI_LAG_SPIN_WINDOW_NS)
+      os_time_nanosleep_until(deadline - ANTI_LAG_SPIN_WINDOW_NS);
+
+   while (os_time_get_nano() < deadline) {
+#if defined(__x86_64__) || defined(_M_X64)
+      /* PAUSE: hint the core this is a spin-wait.  It reduces pipeline
+       * power, avoids a memory-order mispredict penalty on exit, and lets
+       * the sibling hyper-thread make full progress while we wait.
+       */
+      _mm_pause();
+#endif
+   }
+}
+
 VKAPI_ATTR void VKAPI_CALL
 radv_AntiLagUpdateAMD(VkDevice _device, const VkAntiLagDataAMD *pData)
 {
@@ -93,6 +129,14 @@ radv_AntiLagUpdateAMD(VkDevice _device, const VkAntiLagDataAMD *pData)
 
    VK_FROM_HANDLE(vk_device, device, _device);
    struct vk_frame_pacer *frame_pacer = device->frame_pacer;
+
+   /* The frame pacer only exists when the antiLag feature was enabled at
+    * device creation time.  Do nothing otherwise instead of dereferencing
+    * a NULL pacer (robustness against layers/apps calling unconditionally).
+    */
+   if (!frame_pacer)
+      return;
+
    struct anti_lag_data *data = vk_frame_pacer_get_user_data(frame_pacer);
 
    /* Lock this function, in order to avoid race conditions on frame evaluation. */
@@ -148,6 +192,6 @@ radv_AntiLagUpdateAMD(VkDevice _device, const VkAntiLagDataAMD *pData)
 
    simple_mtx_unlock(&data->mtx);
 
-   /* Sleep until deadline is met. */
-   os_time_nanosleep_until(next_deadline);
-}
\ No newline at end of file
+   /* Sleep until deadline is met (hybrid sleep/spin for low wakeup jitter). */
+   anti_lag_wait_until(next_deadline);
+}
