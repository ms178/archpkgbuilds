 }
 
+void
+finish_schedule_test()
+{
+   finish_program(program.get(), true, true);
+   if (!aco::validate_ir(program.get())) { fail_test("Validation before scheduling failed"); return; }
+   program->workgroup_size=program->wave_size; aco::live_var_analysis(program.get()); aco::schedule_program(program.get());
+   if (!aco::validate_ir(program.get())) { fail_test("Validation after scheduling failed"); return; }
+   aco_print_program(program.get(), output);
+}
