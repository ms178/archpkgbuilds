+BEGIN_TEST(isel.shfr.const16.scalar_pack_gfx9)
+   for (amd_gfx_level gfx : {GFX9, GFX10}) {
+      if (!setup_nir_cs(gfx))
+         continue;
+
+      nir_def* src0 = nir_unit_test_uniform_input(nb, 1, 32, 0);
+      nir_def* src1 = nir_unit_test_uniform_input(nb, 1, 32, 1);
+
+      //>> p_startpgm
+      //>> s1: %src0 = p_unit_test 0
+      //! s1: %src1 = p_unit_test 1
+      //>> s1: %res0 = s_pack_ll_b32_b16 0x1234, %src0
+      //! p_unit_test 2, %res0
+      nir_def* res0 = nir_build_alu3(nb, nir_op_shfr, src0, nir_imm_int(nb, 0x12345678),
+                                     nir_imm_int(nb, 16));
+      nir_unit_test_output(nb, res0, 2);
+
+      //>> s1: %res1 = s_pack_hh_b32_b16 %src1, 0xcdef0000
+      //! p_unit_test 3, %res1
+      nir_def* res1 = nir_build_alu3(nb, nir_op_shfr, nir_imm_int(nb, 0x89abcdef), src1,
+                                     nir_imm_int(nb, 16));
+      nir_unit_test_output(nb, res1, 3);
+
+      //>> s_endpgm
+      finish_isel_test();
+   }
+END_TEST
+
+/* ============================================ *
+ * EXPERIMENTAL (v9.2 investigation, ms178):
+ * Full headless RADV heap pipeline driver lives in
+ * heap_pipeline_exp.c (C linkage); see header there.
+ * ============================================ */
+extern "C" {
+bool exp_run_heap_pipeline(enum amd_gfx_level gfx, nir_shader *nir, FILE *out);
+nir_shader *exp_build_shader_for(enum amd_gfx_level gfx);
+}
+
+extern "C" nir_shader *exp_build_embedded_for(enum amd_gfx_level gfx);
+
+BEGIN_TEST(isel.heap_descriptors.pipeline)
+   /* DXVK-style: divergent index, annotated nonuniform (the legal combo) */
+   for (amd_gfx_level gfx : {GFX9, GFX10}) {
+      if (!setup_nir_cs(gfx))
+         continue;
+      nir_shader *heap_nir = exp_build_shader_for(gfx);
+      if (!exp_run_heap_pipeline(gfx, heap_nir, output))
+         continue;
+      /* steal nb to point at the pipeline-produced shader */
+      ralloc_free(nb->shader);
+      nb->shader = heap_nir;
+      nb->cursor = nir_after_impl(nir_shader_get_entrypoint(heap_nir));
+      //>> p_startpgm
+      finish_isel_test();
+   }
+END_TEST
+
+BEGIN_TEST(isel.heap_descriptors.embedded_sampler_cis)
+   /* Combined image/sampler with an embedded (static) sampler: regression
+    * test for nir_tex_instr_remove_src(tex, (unsigned)-1). */
+   for (amd_gfx_level gfx : {GFX9, GFX10}) {
+      if (!setup_nir_cs(gfx))
+         continue;
+      nir_shader *heap_nir = exp_build_embedded_for(gfx);
+      if (!exp_run_heap_pipeline(gfx, heap_nir, output))
+         continue;
+      ralloc_free(nb->shader);
+      nb->shader = heap_nir;
+      nb->cursor = nir_after_impl(nir_shader_get_entrypoint(heap_nir));
+      //>> p_startpgm
+      finish_isel_test();
+   }
+END_TEST
