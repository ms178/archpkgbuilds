+    int rt = pthread_mutex_trylock(mtx);
+
+    if (likely(rt == 0)) {
+        return thrd_success;
+    }
+
+    /* EBUSY = locked by another thread (temporary condition) */
+    if (rt == EBUSY) {
+        return thrd_busy;
+    }
+
+    /* EINVAL, EDEADLK, etc. = permanent errors */
+    return thrd_error;
 }
 
