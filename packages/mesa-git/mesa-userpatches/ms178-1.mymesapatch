+#define U_VECTOR_COLD
+#endif
+
+static void * U_VECTOR_COLD
+u_vector_grow(struct u_vector *vector)
 {
-   uint32_t offset, size, split, src_tail, dst_tail;
-   void *data;
-
-   if (vector->head - vector->tail == vector->size) {
-      size = vector->size * 2;
-      data = malloc(size);
-      if (data == NULL)
-         return NULL;
-      src_tail = vector->tail & (vector->size - 1);
-      dst_tail = vector->tail & (size - 1);
-      if (src_tail == 0) {
-         /* Since we know that the vector is full, this means that it's
-          * linear from start to end so we can do one copy.
-          */
-         memcpy((char *)data + dst_tail, vector->data, vector->size);
-      } else {
-         /* In this case, the vector is split into two pieces and we have
-          * to do two copies.  We have to be careful to make sure each
-          * piece goes to the right locations.  Thanks to the change in
-          * size, it may or may not still wrap around.
-          */
-         split = align(vector->tail, vector->size);
-         assert(vector->tail <= split && split < vector->head);
-         memcpy((char *)data + dst_tail, (char *)vector->data + src_tail,
-                split - vector->tail);
-         memcpy((char *)data + (split & (size - 1)), vector->data,
-                vector->head - split);
-      }
-      free(vector->data);
-      vector->data = data;
-      vector->size = size;
+   const uint32_t old_size = vector->size;
+   const uint32_t size = old_size * 2;
+   void *data = malloc(size);
+   if (data == NULL)
+      return NULL;
+
+   const uint32_t src_tail = vector->tail & (old_size - 1);
+   const uint32_t dst_tail = vector->tail & (size - 1);
+   if (src_tail == 0) {
+      memcpy((char *)data + dst_tail, vector->data, old_size);
+   } else {
+      const uint32_t split = align(vector->tail, old_size);
+      assert(vector->tail <= split && split < vector->head);
+      memcpy((char *)data + dst_tail, (char *)vector->data + src_tail,
+             split - vector->tail);
+      memcpy((char *)data + (split & (size - 1)), vector->data,
+             vector->head - split);
    }
 
-   assert(vector->head - vector->tail < vector->size);
+   free(vector->data);
+   vector->data = data;
+   vector->size = size;
 
-   offset = vector->head & (vector->size - 1);
+   const uint32_t offset = vector->head & (size - 1);
    vector->head += vector->element_size;
+   return (char *)data + offset;
+}
 
+void *
+u_vector_add(struct u_vector *vector)
+{
+   if (__builtin_expect(vector->head - vector->tail == vector->size, 0))
+      return u_vector_grow(vector);
+
+   assert(vector->head - vector->tail < vector->size);
+   const uint32_t offset = vector->head & (vector->size - 1);
+   vector->head += vector->element_size;
    return (char *)vector->data + offset;
 }
 
