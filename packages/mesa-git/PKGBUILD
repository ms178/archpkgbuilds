MESA_WHICH_LLVM="${MESA_WHICH_LLVM:-4}"
[[ ! "${MESA_WHICH_LLVM}" =~ ^[1-4]$ ]] && MESA_WHICH_LLVM=4

if [[ -z "${MESA_WHICH_LLVM}" ]] && [[ ! -e "${_where}/frogminer" ]]; then
    plain "Which LLVM package tree do you want to use to build mesa-tkg-git against?"
    read -rp "$(cat <<'EOF'
     1. llvm-minimal-git (AUR)
     2. llvm-git (AUR)
     3. llvm-git from LordHeavy unofficial repo
   > 4. llvm (default)
    choice [1-4]:
EOF
)" MESA_WHICH_LLVM
    touch "${_where}/frogminer"
fi

case "${MESA_WHICH_LLVM}" in
    1)
        makedepends+=('llvm-minimal-git')
        [[ "${_compiler}" == "clang" || "${_needs_clc}" == "true" ]] && makedepends+=('clang-minimal-git')
        _llvm='llvm-libs-minimal-git'
        if [[ "${_lib32}" == "true" ]]; then
            makedepends+=('lib32-llvm-minimal-git')
            _lib32_llvm='lib32-llvm-libs-minimal-git'
        fi
        ;;
    2)
        makedepends+=('aur-llvm-git')
        [[ "${_compiler}" == "clang" || "${_needs_clc}" == "true" ]] && makedepends+=('aur-clang-git')
        _llvm='aur-llvm-libs-git'
        if [[ "${_lib32}" == "true" ]]; then
            makedepends+=('aur-lib32-llvm-git')
            _lib32_llvm='aur-lib32-llvm-libs-git'
        fi
        ;;
    3)
        makedepends+=('llvm-git')
        [[ "${_compiler}" == "clang" || "${_needs_clc}" == "true" ]] && makedepends+=('clang-git')
        _llvm='llvm-libs-git'
        if [[ "${_lib32}" == "true" ]]; then
            makedepends+=('lib32-llvm-git')
            _lib32_llvm='lib32-llvm-libs-git'
        fi
        ;;
    4|*)
        makedepends+=('llvm>=18.0.0')
        [[ "${_compiler}" == "clang" || "${_needs_clc}" == "true" ]] && makedepends+=('clang>=18.0.0')
        _llvm='llvm-libs>=18.0.0'
        if [[ "${_lib32}" == "true" ]]; then
            makedepends+=('lib32-llvm>=18.0.0')
            [[ "${_compiler}" == "clang" || "${_needs_clc}" == "true" ]] && makedepends+=('lib32-clang>=18.0.0')
            _lib32_llvm='lib32-llvm-libs>=18.0.0'
        fi
        MESA_WHICH_LLVM=4
        ;;
esac

