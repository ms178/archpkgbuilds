    'SKIP'
    'SKIP'
)

_user_patcher() {
    local _userpatch_target="$1"
    local _userpatch_ext="$2"
    local _CONDITION=""

    local -a _patches
    mapfile -t _patches < <(find "${_where}" -maxdepth 1 -name "*.${_userpatch_ext}revert" -type f 2>/dev/null | sort -V)

    if [[ ${#_patches[@]} -gt 0 ]]; then
        if [[ "${_user_patches_no_confirm}" != "true" ]]; then
            msg2 "Found ${#_patches[@]} 'to revert' userpatches for ${_userpatch_target}:"
            printf '%s\n' "${_patches[@]##*/}"
            read -rp "Do you want to revert them? [N/y]: " _CONDITION
        fi
        if [[ "${_CONDITION,,}" == "y" ]] || [[ "${_user_patches_no_confirm}" == "true" ]]; then
            for _f in "${_patches[@]}"; do
                msg2 "Reverting patch: ${_f##*/}"
                if ! patch -Np1 -R < "${_f}"; then
                    error "Failed to revert patch: ${_f##*/}"
                    return 1
                fi
                echo "Reverted patch: ${_f##*/}" >> "${_where}/last_build_config.log"
            done
        fi
    fi

    _CONDITION=""
    mapfile -t _patches < <(find "${_where}" -maxdepth 1 -name "*.${_userpatch_ext}patch" -type f 2>/dev/null | sort -V)

    if [[ ${#_patches[@]} -gt 0 ]]; then
        if [[ "${_user_patches_no_confirm}" != "true" ]]; then
            msg2 "Found ${#_patches[@]} userpatches for ${_userpatch_target}:"
            printf '%s\n' "${_patches[@]##*/}"
            read -rp "Do you want to apply them? [N/y]: " _CONDITION
        fi
        if [[ "${_CONDITION,,}" == "y" ]] || [[ "${_user_patches_no_confirm}" == "true" ]]; then
            for _f in "${_patches[@]}"; do
                msg2 "Applying patch: ${_f##*/}"
                if ! patch -Np1 < "${_f}"; then
                    error "Failed to apply patch: ${_f##*/}"
                    return 1
                fi
                echo "Applied patch: ${_f##*/}" >> "${_where}/last_build_config.log"
            done
        fi
    fi
}

pkgver() {
    cd "${_mesa_srcdir}" || exit 1
    local _ver
    _ver=$(cat VERSION)
    printf '%s.%s.%s' "${_ver//-/_}" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "${srcdir}/${_mesa_srcdir}" || exit 1

    git reset --hard HEAD
    git clean -xdf

    if [[ -n "${_mesa_commit}" ]]; then
        git checkout "${_mesa_commit}" || {
            error "Failed to checkout commit: ${_mesa_commit}"
            return 1
        }
    fi
    msg2 "Tree cleaned"

    # Chromium GPU cache invalidation (matches upstream practice)
    local _ver
    _ver=$(cat VERSION)
    echo "${_ver}-tkg${pkgrel}" > VERSION

    mkdir -p "${_where}/mesa-userpatches"

    rm -f "${_where}"/*.mymesa*
    cp "${_where}"/mesa-userpatches/*.mymesa* "${_where}/" 2>/dev/null || true

    if [[ -n "${_mesa_prs}" ]]; then
        for _pr in ${_mesa_prs}; do
            msg2 "Fetching MR ${_pr}..."
            if ! wget -q -O "${_where}/${_pr}.mymesapatch" \
                "https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/${_pr}.diff"; then
                warning "Failed to fetch MR ${_pr}"
            fi
        done
    fi

    if [[ -n "${_community_patches}" ]]; then
        if [[ ! -d "${_where}/../community-patches" ]]; then
            msg2 "Cloning community-patches repository..."
            git clone --depth=1 https://github.com/Frogging-Family/community-patches.git \
                "${_where}/../community-patches"
        fi
        for _p in ${_community_patches}; do
            if [[ -e "${_where}/../community-patches/mesa-git/${_p}" ]]; then
                ln -sf "${_where}/../community-patches/mesa-git/${_p}" "${_where}/"
            else
                warning "Community patch not found: ${_p}"
            fi
        done
    fi

    {
        echo "# Mesa TKG Build Configuration - $(date)"
        echo "# ============================================"
        echo "# LLVM: ${MESA_WHICH_LLVM}"
        echo "# Compiler: ${_compiler}"
        echo "# Build type: ${_build_type:-release}"
        echo "# LTO: ${_enable_lto} (forced: ${_force_broken_lto})"
        echo "# Gallium drivers: ${_gallium_drivers}"
        echo "# Vulkan drivers: ${_vulkan_drivers}"
        echo "# Vulkan layers: ${_vulkan_layers:-device-select,overlay}"
        echo "# Video codecs: ${_codecs}"
        echo "# Rusticl: ${_rusticl}"
        echo "# Shader cache: ${_shader_cache}"
        echo "# AMD options: ${_meson_amd_options}"
        echo ""
    } > "${_where}/last_build_config.log"

    if [[ "${_user_patches}" == "true" ]]; then
        _user_patcher "mesa" "mymesa"
    fi

    for _p in ${_community_patches}; do
        rm -f "${_where}/${_p}"
    done
    for _pr in ${_mesa_prs}; do
        rm -f "${_where}/${_pr}.mymesapatch"
    done

    cd "${srcdir}" || exit 1

    if [[ "${_NUKR}" == "true" ]]; then
        for _bdir in _build64 _build32; do
            if [[ -d "${_bdir}" ]]; then
                if [[ "${_additional_meson_flags}" == *-Db_pgo=use* ]]; then
                    find "./${_bdir}" -type f ! -name '*.gcda' -delete 2>/dev/null || true
                else
                    rm -rf "${_bdir}"
                fi
            fi
        done
    fi
}

build() {
    _has_gallium_driver() {
        [[ ",${_gallium_drivers// /}," == *",$1,"* ]]
    }

    _has_any_gallium_driver() {
        local driver
        for driver in "$@"; do
            _has_gallium_driver "${driver}" && return 0
        done
        return 1
    }

    _setup_compiler() {
        local _m32_flag="$1"

        if [[ "${_compiler}" == "clang" ]]; then
            export CC="clang"
            export CXX="clang++"
            if [[ -n "${_m32_flag}" ]]; then
                export LLVM_CONFIG="/usr/bin/llvm-config32"
            else
                export LLVM_CONFIG="/usr/bin/llvm-config"
            fi
        else
            export CC="gcc"
            export CXX="g++"
            unset LLVM_CONFIG
        fi

        if [[ -n "${_m32_flag}" ]]; then
            export CC="${CC} -m32"
            export CXX="${CXX} -m32"
        fi

        if [[ -n "${CUSTOM_GCC_PATH}" ]] && [[ "${_compiler}" != "clang" ]]; then
            if [[ -d "${CUSTOM_GCC_PATH}" ]]; then
                export PATH="${CUSTOM_GCC_PATH}/bin:${PATH}"
                msg2 "Using custom GCC from: ${CUSTOM_GCC_PATH}"
            else
                warning "Custom GCC path does not exist: ${CUSTOM_GCC_PATH}"
            fi
        fi
    }

    _configure_build() {
        local _build_dir="$1"
        local _lib_dir="$2"
        local _extra_flags="$3"
        local _is_32bit="$4"

        # Determine VA availability from selected gallium drivers
        local _gallium_va="disabled"

        if _has_any_gallium_driver r600 radeonsi nouveau virgl; then
            _gallium_va="enabled"
        fi

        local _vk_layers="${_vulkan_layers:-device-select,overlay}"

        local -a _meson_args=(
            --wrap-mode=default

            --buildtype="${_build_type:-release}"

            # Compiler flags via -Dc_args / -Dcpp_args method
            -D c_args="${_cflags}"
            -D cpp_args="${_cxxflags}"

            # Linker flags via -Dc_link_args / -Dcpp_link_args method
            -D c_link_args="${_ldflags}"
            -D cpp_link_args="${_ldflags}"

            -D b_ndebug=true
            -D python.bytecompile=2
            -D c_std=gnu23
            -D cpp_std=gnu++23

            -D build-tests=false
            -D enable-glcpp-tests=false

            # Platform
            -D platforms=x11,wayland
            -D egl-native-platform=auto

            # API
            -D egl=enabled
            -D gbm=enabled
            -D glvnd=enabled
            -D glx=dri
            -D opengl=true
            -D gles1=disabled
            -D gles2=enabled

            # LLVM & AMD options (Mesa 27.0+ 'amd-options' replaces amd-use-llvm/amdgpu-virtio)
            -D llvm=enabled
            -D shared-llvm=enabled
            -D amd-options="${_meson_amd_options}"
            -D draw-use-llvm="${_draw_use_llvm}"

            # Drivers
            -D gallium-drivers="${_gallium_drivers}"
            -D vulkan-drivers="${_vulkan_drivers}"
            -D vulkan-layers="${_vk_layers}"

            # Media / video
            -D video-codecs="${_codecs}"
            -D gallium-va="${_gallium_va}"

            # Features matching upstream
            -D zstd=enabled
            -D lmsensors=enabled
            -D libunwind=disabled
            -D valgrind=disabled
            -D sysprof=false

            # Explicitly disabled (not relevant for our hardware/platform)
            -D android-libbacktrace=disabled
            -D intel-rt=disabled
            -D microsoft-clc=disabled
            -D gallium-mediafoundation=disabled
        )

        [[ -n "${_lib_dir}" ]] && _meson_args+=(--libdir="${_lib_dir}")

        # Shader cache
        if [[ "${_shader_cache}" == "true" ]]; then
            _meson_args+=(-D shader-cache=enabled)
            _meson_args+=(-D shader-cache-default=true)
            [[ -n "${_shader_cache_max_size}" ]] && \
                _meson_args+=(-D shader-cache-max-size="${_shader_cache_max_size}")
        else
            _meson_args+=(-D shader-cache=disabled)
        fi

        # Rusticl (64-bit only)
        if [[ "${_rusticl}" == "true" ]] && [[ "${_is_32bit}" != "true" ]]; then
            _meson_args+=(
                -D gallium-rusticl=true
                -D gallium-rusticl-enable-drivers=radeonsi
            )
        else
            _meson_args+=(-D gallium-rusticl=false)
        fi

        # LTO (upstream considers this broken — requires explicit force)
        if [[ "${_enable_lto}" == "true" ]]; then
            if [[ "${_force_broken_lto}" == "true" ]]; then
                _meson_args+=(
                    -D b_lto=true
                    -D allow-broken-lto=true
                )
                warning "LTO enabled with force override - UNSUPPORTED upstream!"
            else
                error "LTO requested but _force_broken_lto is not 'true'"
                return 1
            fi
        else
            _meson_args+=(-D b_lto=false)
        fi

        # Additional flags from config (properly word-split, stripping removed AMD booleans)
        local _flag
        for _flag in ${_extra_flags}; do
            case "${_flag}" in
                -Damd-use-llvm=*|-Damdgpu-virtio=*)
                    warning "Ignoring deprecated extra flag '${_flag}' (use _amd_options instead)"
                    continue
                    ;;
            esac
            _meson_args+=("${_flag}")
        done

        if [[ "${_is_32bit}" == "true" ]]; then
            # Pass 32-bit native configuration so Meson locates llvm-config32 correctly
            _meson_args+=(--native-file "${srcdir}/llvm32.native")
        fi

        arch-meson "${_mesa_srcdir}" "${_build_dir}" "${_meson_args[@]}"
    }

    # Store original CFLAGS, CXXFLAGS, and LDFLAGS (which respect /etc/makepkg.conf)
    local _cflags="${CFLAGS}"
    local _cxxflags="${CXXFLAGS}"
    local _ldflags="${LDFLAGS}"

    # Custom optimization flags (replaces system flags if set)
    if [[ -n "${_custom_opt_flags}" ]]; then
        _cflags="${_custom_opt_flags}"
        _cxxflags="${_custom_opt_flags}"
    fi

    # Minimal debug info for crash analysis unless explicitly disabled via -g0
    [[ " ${_cflags} " != *" -g0 "* ]] && _cflags+=" -g1"
    [[ " ${_cxxflags} " != *" -g0 "* ]] && _cxxflags+=" -g1"

    # ========== 64-bit Build ==========
    msg2 "Configuring 64-bit build..."
    unset PKG_CONFIG
    _setup_compiler ""
    _configure_build "_build64" "" \
        "${_additional_meson_flags} ${_additional_meson_flags_64}" "false"

    msg2 "Building 64-bit..."
    meson compile -C _build64

    # ========== 32-bit Build ==========
    if [[ "${_lib32}" == "true" ]]; then
        msg2 "Configuring 32-bit build..."
        _setup_compiler "-m32"
        export PKG_CONFIG="i686-pc-linux-gnu-pkg-config"

        _configure_build "_build32" "/usr/lib32" \
            "${_additional_meson_flags} ${_additional_meson_flags_32}" "true"

        msg2 "Building 32-bit..."
        meson compile -C _build32
    fi
}

package_mesa-tkg-git() {
    depends=(
        'libdrm'
        'wayland'
        'libxxf86vm'
        'libxdamage'
        'libxshmfence'
        'libelf'
        'lm_sensors'
        'libglvnd'
        'expat'
        'libx11'
        'libxcb'
        'libxext'
        'spirv-tools'
        'zlib'
        'zstd'
        'vulkan-icd-loader'
        "${_llvm}"
    )

    # Vulkan drivers need these at runtime
    if [[ -n "${_vulkan_drivers}" ]]; then
        depends+=(
            'systemd-libs'
            'xcb-util-keysyms'
        )
    fi

    # Optional runtime deps when enabled in Meson flags
    if [[ "${_additional_meson_flags} ${_additional_meson_flags_64}" == *"display-info=enabled"* ]]; then
        depends+=('libdisplay-info')
    fi
    if [[ "${_additional_meson_flags} ${_additional_meson_flags_64}" == *"libunwind=enabled"* ]]; then
        depends+=('libunwind')
    fi

    provides=(
        "mesa=${pkgver}-${pkgrel}"
        "vulkan-radeon=${pkgver}-${pkgrel}"
        "vulkan-swrast=${pkgver}-${pkgrel}"
        "vulkan-mesa-layers=${pkgver}-${pkgrel}"
        "vulkan-mesa-implicit-layers=${pkgver}-${pkgrel}"
        "mesa-vulkan-layers=${pkgver}-${pkgrel}"
        "libva-mesa-driver=${pkgver}-${pkgrel}"
        "mesa-vdpau=${pkgver}-${pkgrel}"
        'vulkan-driver'
        'opengl-driver'
        'libva-driver'
        'ati-dri'
        'mesa-dri'
        'mesa-libgl'
    )

    conflicts=(
        'mesa'
        'vulkan-radeon'
        'vulkan-swrast'
        'vulkan-mesa-layers'
        'vulkan-mesa-implicit-layers'
        'mesa-vulkan-layers'
        'libva-mesa-driver'
        'mesa-vdpau'
    )

    # OpenCL only when rusticl is actually built
    if [[ "${_rusticl}" == "true" ]]; then
        depends+=('libclc')
        provides+=(
            "opencl-mesa=${pkgver}-${pkgrel}"
            'opencl-driver'
        )
        conflicts+=('opencl-mesa')
        optdepends+=('opencl-headers: for OpenCL development')
    fi

    # --skip-subprojects prevents Meson's wayland-protocols>=1.49 wrap fallback
    # from installing conflicting headers/xml/pc files into pkgdir.
    DESTDIR="${pkgdir}" meson install -C _build64 --no-rebuild --skip-subprojects

    # Remove helper scripts not needed in package
    rm -f "${pkgdir}/usr/bin/mesa-overlay-control.py"
    rm -f "${pkgdir}/usr/bin/mesa-screenshot-control.py"
    rmdir --ignore-fail-on-non-empty "${pkgdir}/usr/bin" 2>/dev/null || true

    # Indirect rendering symlink (required by libglvnd)
    ln -sf /usr/lib/libGLX_mesa.so.0 "${pkgdir}/usr/lib/libGLX_indirect.so.0"

    if [[ "${_localglesv2pc}" == "true" ]]; then
        install -dm755 "${pkgdir}/usr/lib/pkgconfig"
        cat > "${pkgdir}/usr/lib/pkgconfig/glesv2.pc" <<EOF
prefix=/usr
libdir=\${prefix}/lib
includedir=\${prefix}/include
Name: glesv2
Description: Mesa OpenGL ES 2.0 library
Version: ${pkgver}
Libs: -L\${libdir} -lGLESv2
Libs.private: -lpthread -pthread -lm -ldl
Cflags: -I\${includedir}
EOF
    fi

    if [[ "${_localeglpc}" == "true" ]]; then
        install -dm755 "${pkgdir}/usr/lib/pkgconfig"
        cat > "${pkgdir}/usr/lib/pkgconfig/egl.pc" <<EOF
prefix=/usr
libdir=\${prefix}/lib
includedir=\${prefix}/include
Name: egl
Description: Mesa EGL Library
Version: ${pkgver}
Requires.private: x11, xext, xdamage, xfixes, x11-xcb, xcb, xcb-glx, xcb-dri2, xxf86vm, libdrm
Libs: -L\${libdir} -lEGL
Libs.private: -lpthread -pthread -lm -ldl
Cflags: -I\${includedir}
EOF
    fi

    install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/mesa-tkg-git/LICENSE"
}

package_lib32-mesa-tkg-git() {
    depends=(
        'lib32-libdrm'
        'lib32-libxxf86vm'
        'lib32-libxdamage'
        'lib32-libxshmfence'
        'lib32-lm_sensors'
        'lib32-libelf'
        'lib32-wayland'
        'lib32-libglvnd'
        'lib32-libx11'
        'lib32-libxcb'
        'lib32-libxext'
        'lib32-zlib'
        'lib32-zstd'
        'lib32-expat'
        'lib32-vulkan-icd-loader'
        'lib32-systemd'
        'mesa'
        "${_lib32_llvm}"
    )

    if [[ "${_additional_meson_flags} ${_additional_meson_flags_32}" == *"libunwind=enabled"* ]]; then
        depends+=('lib32-libunwind')
    fi

    provides=(
        "lib32-mesa=${pkgver}-${pkgrel}"
        "lib32-vulkan-radeon=${pkgver}-${pkgrel}"
        "lib32-vulkan-swrast=${pkgver}-${pkgrel}"
        "lib32-vulkan-mesa-layers=${pkgver}-${pkgrel}"
        "lib32-vulkan-mesa-implicit-layers=${pkgver}-${pkgrel}"
        "lib32-mesa-vulkan-layers=${pkgver}-${pkgrel}"
        "lib32-libva-mesa-driver=${pkgver}-${pkgrel}"
        "lib32-mesa-vdpau=${pkgver}-${pkgrel}"
        'lib32-opengl-driver'
        'lib32-vulkan-driver'
        'lib32-ati-dri'
        'lib32-mesa-dri'
        'lib32-mesa-libgl'
    )

    conflicts=(
        'lib32-mesa'
        'lib32-vulkan-radeon'
        'lib32-vulkan-swrast'
        'lib32-vulkan-mesa-layers'
        'lib32-vulkan-mesa-implicit-layers'
        'lib32-mesa-vulkan-layers'
        'lib32-libva-mesa-driver'
        'lib32-mesa-vdpau'
    )

    DESTDIR="${pkgdir}" meson install -C _build32 --no-rebuild --skip-subprojects

    # Remove all arch-independent / 64-bit-owned paths (including /usr/bin helper
    # scripts like mesa-overlay-control.py, headers, drirc.d, glvnd, and layer JSONs).
    rm -rf "${pkgdir}/usr/bin"
    rm -rf "${pkgdir}/usr/include"
    rm -rf "${pkgdir}/usr/share/drirc.d"
    rm -rf "${pkgdir}/usr/share/glvnd"
    rm -rf "${pkgdir}/usr/share/vulkan/explicit_layer.d"
    rm -rf "${pkgdir}/usr/share/vulkan/implicit_layer.d"

    # Indirect rendering symlink
    ln -sf /usr/lib32/libGLX_mesa.so.0 "${pkgdir}/usr/lib32/libGLX_indirect.so.0"

    if [[ "${_localglesv2pc}" == "true" ]]; then
        install -dm755 "${pkgdir}/usr/lib32/pkgconfig"
        cat > "${pkgdir}/usr/lib32/pkgconfig/glesv2.pc" <<EOF
prefix=/usr
libdir=\${prefix}/lib32
includedir=\${prefix}/include
Name: glesv2
Description: Mesa OpenGL ES 2.0 library
Version: ${pkgver}
Libs: -L\${libdir} -lGLESv2
Libs.private: -lpthread -pthread -lm -ldl
Cflags: -I\${includedir}
EOF
    fi

    if [[ "${_localeglpc}" == "true" ]]; then
        install -dm755 "${pkgdir}/usr/lib32/pkgconfig"
        cat > "${pkgdir}/usr/lib32/pkgconfig/egl.pc" <<EOF
prefix=/usr
libdir=\${prefix}/lib32
includedir=\${prefix}/include
Name: egl
Description: Mesa EGL Library
Version: ${pkgver}
Requires.private: x11, xext, xdamage >= 1.1, xfixes, x11-xcb, xcb, xcb-glx >= 1.8.1, xcb-dri2 >= 1.8, xxf86vm, libdrm >= 2.4.75
Libs: -L\${libdir} -lEGL
Libs.private: -lpthread -pthread -lm -ldl
Cflags: -I\${includedir}
EOF
    fi

    install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/lib32-mesa-tkg-git/LICENSE"
}

trap '_exit_cleanup' EXIT

_exit_cleanup() {
    if [[ "${pkgver}" != "0" ]]; then
        sed -i "s/^pkgver=.*/pkgver=0/" "${_where}/PKGBUILD" 2>/dev/null || true
    fi

    rm -f "${_where}"/*.mymesa* 2>/dev/null || true
    rm -f "${_where}/frogminer" 2>/dev/null || true

    _log_msg2 "Cleanup done"
}
