# Optimized for: AMD Vega 64 + Intel Core i7-14700KF
# vim: set ft=bash :

_where="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

_log_msg2() {
    if declare -F msg2 >/dev/null; then
        msg2 "$@"
    fi
}

_log_warn() {
    if declare -F warning >/dev/null; then
        warning "$@"
    fi
}

source "${_where}/customization.cfg"

# Track default _amd_options before sourcing optional external overrides so
# legacy _amd_use_llvm / _amdgpu_virtio settings in user.cfg or mesa-git.cfg
# migrate seamlessly to Mesa 27.0+'s array option 'amd-options'.
_default_amd_options="${_amd_options-}"
unset _amd_options _amd_use_llvm _amdgpu_virtio

if [[ -e "${_where}/mesa-userpatches/user.cfg" ]]; then
    source "${_where}/mesa-userpatches/user.cfg"
    _log_msg2 "User.cfg config loaded"
elif [[ -n "${_EXT_CONFIG_PATH}" ]]; then
    _expanded_config="${_EXT_CONFIG_PATH/#\~/$HOME}"
    if [[ -e "${_expanded_config}" ]]; then
        source "${_expanded_config}"
        _log_msg2 "External configuration file ${_EXT_CONFIG_PATH} loaded"
    fi
fi

_normalize_bool() {
    local varname="$1"
    local val="${!varname}"
    case "${val,,}" in
        true|yes|1|on) printf -v "$varname" '%s' "true" ;;
        *) printf -v "$varname" '%s' "false" ;;
    esac
}

if [[ ! -v _amd_options ]]; then
    if [[ -v _amd_use_llvm || -v _amdgpu_virtio ]]; then
        _migrated_opts=()
        if [[ -v _amd_use_llvm ]]; then
            _normalize_bool _amd_use_llvm
            [[ "${_amd_use_llvm}" == "true" ]] && _migrated_opts+=("use-llvm")
        fi
        if [[ -v _amdgpu_virtio ]]; then
            _normalize_bool _amdgpu_virtio
            [[ "${_amdgpu_virtio}" == "true" ]] && _migrated_opts+=("virtio")
        fi
        _amd_options="$(IFS=,; echo "${_migrated_opts[*]}")"
        _log_msg2 "Migrated legacy AMD config to _amd_options='${_amd_options}'"
    else
        _amd_options="${_default_amd_options}"
    fi
fi
unset _default_amd_options _migrated_opts

_normalize_amd_options() {
    local raw="${1-}"
    # Strip surrounding brackets, quotes, and whitespace
    raw="${raw//[\[\]\'\" ]/}"
    local -a tokens=()
    local -a valid=()
    local tok seen
    IFS=',' read -r -a tokens <<< "${raw}"
    for tok in "${tokens[@]}"; do
        case "${tok,,}" in
            ""|none|false|off|0)
                continue
                ;;
            true|yes|1|on|use-llvm)
                tok="use-llvm"
                ;;
            virtio)
                tok="virtio"
                ;;
            *)
                if declare -F error >/dev/null; then
                    error "Invalid token '${tok}' in _amd_options (allowed: use-llvm, virtio, or empty)"
                else
                    printf 'ERROR: Invalid token %s in _amd_options\n' "${tok}" >&2
                fi
                return 1
                ;;
        esac
        seen="false"
        local existing
        for existing in "${valid[@]}"; do
            [[ "${existing}" == "${tok}" ]] && seen="true"
        done
        [[ "${seen}" == "false" ]] && valid+=("${tok}")
    done

    if [[ ${#valid[@]} -eq 0 ]]; then
        printf '%s' "[]"
    else
        local IFS=','
        printf '%s' "${valid[*]}"
    fi
}

_meson_amd_options="$(_normalize_amd_options "${_amd_options}")" || exit 1

_normalize_bool _lib32
_normalize_bool _NUKR
_normalize_bool _localglesv2pc
_normalize_bool _localeglpc
_normalize_bool _enable_lto
_normalize_bool _force_broken_lto
_normalize_bool _user_patches
_normalize_bool _user_patches_no_confirm
_normalize_bool _rusticl
_normalize_bool _shader_cache
_normalize_bool _draw_use_llvm

_csv_has_any() {
    local csv=",${1// /},"
    shift
    local item
    for item in "$@"; do
        [[ "${csv}" == *",${item},"* ]] && return 0
    done
    return 1
}

_needs_rust="false"
if [[ "${_rusticl}" == "true" ]] || \
   _csv_has_any "${_vulkan_drivers}" nouveau panfrost || \
   _csv_has_any "${_gallium_drivers}" panfrost; then
    _needs_rust="true"
fi

_needs_clc="false"
if [[ "${_rusticl}" == "true" ]] || \
   _csv_has_any "${_gallium_drivers}" iris crocus asahi panfrost || \
   _csv_has_any "${_vulkan_drivers}" intel intel_hasvk asahi panfrost nouveau imagination kosmickrisp; then
    _needs_clc="true"
fi

