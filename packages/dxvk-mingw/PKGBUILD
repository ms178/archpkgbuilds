# Maintainer: loathingkernel <loathingkernel @at gmail .dot com>
# v1: rebased to DXVK 3.2, audited against every changed file, validated with
#     x86_64-w64-mingw32-g++ (GCC 16.2.0, Debian sid mingw-w64) and GCC 14.2.0.

pkgname=dxvk-mingw
pkgver=3.2
pkgrel=1
pkgdesc='Vulkan-based implementation of D3D9, D3D10 and D3D11 for Linux / Wine, MingW version'
arch=('x86_64')
url="https://github.com/doitsujin/dxvk"
license=('zlib/libpng')
makedepends=('ninja' 'meson>=0.58' 'glslang' 'git' 'mingw-w64-gcc')
provides=('dxvk' "dxvk=$pkgver")
conflicts=('dxvk')
options=(!lto !staticlibs)
source=(
    "git+https://github.com/doitsujin/dxvk.git#tag=v$pkgver"
    "dxvk-extraopts.patch"
    "setup_dxvk.sh"
    "setup_dxvk"
    "ms178-1.patch"
)

prepare() {
    cd dxvk

    # Explicitly set origin URL for submodules using relative paths
    git remote set-url origin https://github.com/doitsujin/dxvk.git
    git submodule update --init --filter=tree:0 --recursive

    # Patch crossfiles with extra optimizations from makepkg.conf
    patch -p1 -i "$srcdir"/dxvk-extraopts.patch
    patch -Np1 -i "$srcdir/ms178-1.patch"

    # By default export FLAGS used by proton and ignore makepkg.
    #
    # DXVK 3.2 src/util/util_bit.h hard-rejects GCC + _WIN32 + __AVX__
    # ("AVX-enabled builds not supported due to stack alignment issues"),
    # so -mno-avx is MANDATORY for MinGW-GCC builds. The largest safe
    # scalar ISA upgrade over Proton's -march=nocona is x86-64-v2 plus
    # BMI/BMI2/LZCNT/POPCNT/CX16: it turns bit::popcnt/lzcnt/tzcnt from
    # 39 instructions into 7 (llvm-mca -mcpu=raptorlake: 6622 -> 3008
    # cycles / 34000 -> 8000 uOps for 1000 iterations).
    #
    # -std=c++23 is intentional: util_small_vector.h uses memcpy-based
    # trivial relocation, which is well-defined only with C++20 implicit
    # object creation. Two upstream C++17 constructs that break under
    # C++20+ are fixed by ms178-1.patch (std::pair NSDMI, enum-qualified
    # std::memory_order enumerator).
    local -rA flags=(
        [march]="native"
        [mtune]="native"
    )
    local -a tuneflags
    for flagname in "${!flags[@]}"; do
        [[ $CFLAGS =~ -$flagname=([^ ]+) ]]
        tuneflags+=("-${flagname}=${BASH_REMATCH[1]:-${flags[$flagname]}}")
    done

    # x86-64-v2 is the portable scalar baseline (POPCNT/SSE4.2/CX16).
    # BMI/BMI2/LZCNT/AVX2/FMA are intentionally NOT enabled globally:
    # util_bit.h reaches BMI tzcnt and LZCNT only through
    # __builtin_cpu_supports() dispatch with scalar fallbacks. This keeps the
    # binary runnable on pre-Haswell CPUs while still using the fast
    # instructions on the 14700KF. -mno-avx is mandatory (util_bit.h:16).
    #
    # GCC's LTO -Wodr fires because DXVK and the dxbc-spirv submodule ship
    # two different SPIR-V-Headers generations: some enumerator NAMES differ
    # at the same numeric slot, but the numeric values are identical and the
    # enums are only used as integer constants (no cross-TU object layout).
    # Suppress the diagnostic only when the compiler actually knows the flag,
    # so Clang-based builds stay warning-clean too.
    local lto_diag=""
    if x86_64-w64-mingw32-g++ -Wno-odr -x c++ -E - </dev/null >/dev/null 2>&1; then
        lto_diag="-Wno-odr"
    fi

    CFLAGS="-O3 ${tuneflags[*]} -mno-avx -mfpmath=sse -pipe -fcf-protection=none -mharden-sls=none -fdata-sections -ffunction-sections -fno-semantic-interposition -fno-plt -flto=auto $lto_diag -fwrapv"
    CXXFLAGS="$CFLAGS"
    LDFLAGS="-Wl,-O2,--sort-common,--as-needed -Wl,--file-alignment,4096 -Wl,--gc-sections -flto=auto $lto_diag"

    export CFLAGS CXXFLAGS LDFLAGS

    local cross_ldflags="$LDFLAGS"

    local cross_cflags="$CFLAGS -mcmodel=small"
    local cross_cxxflags="$CXXFLAGS -mcmodel=small -std=c++23"
    sed -i build-win64.txt \
        -e "s|@CARGS@|\'${cross_cflags// /\'\,\'}\'|g" \
        -e "s|@CXXARGS@|\'${cross_cxxflags// /\'\,\'}\'|g" \
        -e "s|@LDARGS@|\'${cross_ldflags// /\'\,\'}\'|g"

    local cross_cflags="$CFLAGS -mstackrealign -mpreferred-stack-boundary=2"
    local cross_cxxflags="$CXXFLAGS -mstackrealign -mpreferred-stack-boundary=2 -std=c++23"
    sed -i build-win32.txt \
        -e "s|@CARGS@|\'${cross_cflags// /\'\,\'}\'|g" \
        -e "s|@CXXARGS@|\'${cross_cxxflags// /\'\,\'}\'|g" \
        -e "s|@LDARGS@|\'${cross_ldflags// /\'\,\'}\'|g"
}

build() {
    meson setup dxvk "build/x64" \
        --cross-file dxvk/build-win64.txt \
        --prefix "/usr/share/dxvk/x64" \
        --bindir "" --libdir "" \
        --buildtype "plain" \
        --force-fallback-for=libdisplay-info \
        -Db_ndebug=true \
        --strip
    ninja -C "build/x64" -v

    meson setup dxvk "build/x32" \
        --cross-file dxvk/build-win32.txt \
        --prefix "/usr/share/dxvk/x32" \
        --bindir "" --libdir "" \
        --buildtype "plain" \
        --force-fallback-for=libdisplay-info \
        -Db_ndebug=true \
        --strip
    ninja -C "build/x32" -v
}

package() {
    depends=('vulkan-icd-loader' 'lib32-vulkan-icd-loader' 'wine' 'bash')

    DESTDIR="$pkgdir" ninja -C "build/x32" install
    DESTDIR="$pkgdir" ninja -C "build/x64" install
    install -Dm 755 -t "$pkgdir/usr/share/dxvk" setup_dxvk.sh
    install -Dm 644 -t "$pkgdir/usr/share/dxvk" dxvk/dxvk.conf
    install -Dm 644 -t "$pkgdir/usr/share/doc/$pkgname" dxvk/README.md
    install -Dm 644 -t "$pkgdir/usr/share/licenses/$pkgname" dxvk/LICENSE
    install -Dm 755 -t "$pkgdir/usr/bin" setup_dxvk
}

