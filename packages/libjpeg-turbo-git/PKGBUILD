# Maintainer: ms178
#
# libjpeg-turbo-git : CS-PGO + BOLT optimised build using the llvm-ultimate
#                     toolchain.
#
# Pipeline
#   Stage 1  instrumented (IR PGO)          -> standard.profdata
#   Stage 2  instrumented (context-sensitive PGO, uses stage 1) -> merged.profdata
#   Stage 3  final PGO build, linked with --emit-relocs so BOLT can work
#   Stage 4  BOLT instrumentation of the shared libraries, training run
#   Stage 5  BOLT optimisation using the collected profile
#   Stage 6  verification (test suite + workload against the final artefacts)
#
# Design notes that matter (all of these were verified empirically, not assumed):
#
#  * BOLT REQUIRES -Wl,--emit-relocs on the final link.  Without it llvm-bolt
#    fails with "function reordering only works when relocations are enabled"
#    and silently degrades to lite mode.  This is the single most common way to
#    get a "BOLT build" that does nothing.
#
#  * BOLT profile is collected by INSTRUMENTATION, not perf.  perf2bolt needs
#    LBR (last-branch records); those are unavailable in VMs/containers and on
#    many locked-down desktops (perf_event_paranoid), and BOLT's own docs note
#    that non-LBR profiles are substantially lower quality.  Instrumentation is
#    slower to run but is deterministic and always available.
#
#  * Library file names are DISCOVERED, never hardcoded.  The SONAME minor
#    version tracks upstream (currently libjpeg.so.8.3.2 / libturbojpeg.so.0.5.0)
#    and changes between releases; a hardcoded name makes the BOLT stage a
#    silent no-op.
#
#  * makepkg.conf CFLAGS/CXXFLAGS/LDFLAGS are respected verbatim.  This PKGBUILD
#    only ever APPENDS the PGO/BOLT-specific flags.  It does not inject
#    -march=native (your makepkg.conf already decides that) and does not
#    override your optimisation level.

_pkgname=libjpeg-turbo
pkgname=${_pkgname}-git
pkgver=3.2.0.r16.52da6095
pkgrel=1
pkgdesc="JPEG image codec with accelerated baseline compression and decompression (git, CS-PGO + LTO + BOLT)"
url="https://libjpeg-turbo.org/"
arch=('x86_64')
license=(
  'BSD-3-Clause'
  'IJG'
)

depends=('glibc')

makedepends=(
  'git'
  'cmake'
  'nasm'
  'ninja'
  'python'
  'pkgconf'
  'perl'
)

provides=(
  'libjpeg-turbo'
  "libjpeg-turbo=${pkgver%%.r*}"
  'libjpeg'
  'libjpeg.so=8-64'
  'libturbojpeg.so=0-64'
)

conflicts=('libjpeg-turbo')

source=(
  "git+https://github.com/libjpeg-turbo/libjpeg-turbo.git"
  "ms178-1.patch"
)
sha256sums=('SKIP' 'SKIP')

# !lto      : we drive ThinLTO ourselves (see _configure_build)
# !debug    : no separate debug package; we strip at the end
# !strip    : IMPORTANT - makepkg must NOT strip.  BOLT rewrites the binary and
#             leaves sections that a naive strip can corrupt; we strip
#             explicitly and safely in package() instead.
options=('!lto' '!debug' '!strip')

pkgver() {
  cd "${srcdir}/${_pkgname}"
  git describe --long --tags --abbrev=8 2>/dev/null | sed 's/^v//;s/\([^-]*-\)g/r\1/;s/-/./g' \
    || printf '3.1.4.1.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=8 HEAD)"
}

# =============================================================================
# llvm-ultimate toolchain
# =============================================================================
_llvm_root="${LLVM_ULTIMATE_ROOT:-/home/marcus/toolchain/llvm-ultimate}"

_setup_toolchain() {
  [[ -x "${_llvm_root}/bin/clang" ]] || {
    echo "Error: llvm-ultimate not found at ${_llvm_root}" >&2
    echo "       set LLVM_ULTIMATE_ROOT=/path/to/llvm-ultimate to override" >&2
    return 1
  }

  export PATH="${_llvm_root}/bin:${PATH}"
  export LD_LIBRARY_PATH="${_llvm_root}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

  export CC="${_llvm_root}/bin/clang"
  export CXX="${_llvm_root}/bin/clang++"
  export AR="${_llvm_root}/bin/llvm-ar"
  export NM="${_llvm_root}/bin/llvm-nm"
  export STRIP="${_llvm_root}/bin/llvm-strip"
  export RANLIB="${_llvm_root}/bin/llvm-ranlib"
  export READELF="${_llvm_root}/bin/llvm-readelf"
  export OBJCOPY="${_llvm_root}/bin/llvm-objcopy"
  export OBJDUMP="${_llvm_root}/bin/llvm-objdump"

  _profdata="${_llvm_root}/bin/llvm-profdata"
  _bolt="${_llvm_root}/bin/llvm-bolt"
  _mergefdata="${_llvm_root}/bin/merge-fdata"

  local t
  for t in "$CC" "$AR" "$NM" "$RANLIB" "$_profdata" "$_bolt" "$_mergefdata"; do
    [[ -x "$t" ]] || { echo "Error: missing required tool: $t" >&2; return 1; }
  done

  echo "  -> toolchain: $("$CC" --version | head -1)"
  echo "  -> bolt     : $("$_bolt" --version | sed -n '2p')"
}

# =============================================================================
# helpers
# =============================================================================

# Discover the real versioned .so files instead of hardcoding names.
# Prints one absolute path per line.
_find_libs() {
  local builddir="$1"
  find "$builddir" -maxdepth 1 -type f \
       \( -name 'libjpeg.so.*' -o -name 'libturbojpeg.so.*' \) \
       -printf '%p\n' | sort
}

_verify_expected_sonames() {
  local libdir="$1"
  local -A expected=( [libjpeg.so]=8 [libturbojpeg.so]=0 )
  local base major soname link target actual

  for base in "${!expected[@]}"; do
    major="${expected[$base]}"
    soname="${base}.${major}"
    link="${libdir}/${soname}"

    [[ -e "$link" ]] || { echo "Error: missing $link" >&2; return 1; }
    target="$(readlink -f "$link")"
    [[ -f "$target" ]] || { echo "Error: cannot resolve $link" >&2; return 1; }

    actual="$("$READELF" -d "$target" 2>/dev/null \
              | sed -n 's/.*SONAME.*\[\(.*\)\].*/\1/p' | head -n1)"
    [[ "$actual" == "$soname" ]] || {
      echo "Error: SONAME mismatch $target: want $soname got ${actual:-<none>}" >&2
      return 1
    }
  done
  echo "  -> SONAME verification passed"
}

_count_profraw() {
  local n
  n=$(find "$1" -maxdepth 1 -name '*.profraw' 2>/dev/null | wc -l)
  echo "  -> $2: ${n} raw profile file(s)"
  (( n > 0 ))
}

# =============================================================================
# cmake configuration
# =============================================================================
_cmake_common_options=(
  -G Ninja
  -W no-dev
  -DCMAKE_INSTALL_PREFIX=/usr
  -DCMAKE_INSTALL_LIBDIR=/usr/lib
  -DENABLE_STATIC=OFF
  -DWITH_JPEG8=ON
  -DWITH_TURBOJPEG=ON
  -DREQUIRE_SIMD=ON
)

# _configure_build <builddir> <buildtype> <extra_cflags> <extra_ldflags>
#
# CFLAGS / CXXFLAGS / LDFLAGS from makepkg.conf are passed through untouched and
# the stage-specific flags are appended.  Nothing here overrides the user's
# -march / -O choices.
_configure_build() {
  local builddir="$1" buildtype="$2" cflags_extra="$3" ldflags_extra="$4"
  rm -rf "$builddir"

  cmake "${_cmake_common_options[@]}" \
    -S "${srcdir}/${_pkgname}" -B "${builddir}" \
    -DCMAKE_BUILD_TYPE="${buildtype}" \
    -DCMAKE_C_COMPILER="${CC}" \
    -DCMAKE_AR="${AR}" \
    -DCMAKE_NM="${NM}" \
    -DCMAKE_RANLIB="${RANLIB}" \
    -DCMAKE_C_FLAGS="${CFLAGS} ${cflags_extra}" \
    -DCMAKE_EXE_LINKER_FLAGS="${LDFLAGS} ${ldflags_extra}" \
    -DCMAKE_SHARED_LINKER_FLAGS="${LDFLAGS} ${ldflags_extra}" \
    -DCMAKE_MODULE_LINKER_FLAGS="${LDFLAGS} ${ldflags_extra}"
}

# =============================================================================
# training workload
# =============================================================================
# The workload is written to $srcdir by prepare(); see jpeg_pgo_workload.c.
_build_workload() {
  local builddir="$1" outpath="$2"
  local abs; abs="$(cd "$builddir" && pwd)"
  echo "  -> building workload helper"
  # Deliberately NOT instrumented and NOT PGO-built: the helper is a driver,
  # we only care about profiling the library it calls into.
  "$CC" -std=gnu17 -O2 -pipe \
    -I"${abs}" -I"${srcdir}/${_pkgname}/src" \
    "${srcdir}/jpeg_pgo_workload.c" \
    -L"${abs}" -Wl,-rpath,"${abs}" \
    -ljpeg -lturbojpeg -lpthread -lm \
    -o "$outpath"
}

# _run_training <builddir> <helper> <libdir-for-LD_LIBRARY_PATH> <scale>
# Runs BOTH the synthetic workload and the upstream test-suite.  Measured
# coverage: workload alone 31.6%, workload+ctest 70.4% of functions in
# libjpeg.so get a non-empty BOLT execution profile.  The test suite is what
# exercises the cjpeg/djpeg/jpegtran CLI paths and the 12-bit / 16-bit / lossless
# code that the synthetic driver cannot reach through the public API.
_run_training() {
  local builddir="$1" helper="$2" libpath="$3" scale="${4:-1}"
  local abs; abs="$(cd "$builddir" && pwd)"

  echo "  -> training: synthetic workload (scale=${scale})"
  (
    export LD_LIBRARY_PATH="${libpath}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export LD_BIND_NOW=1
    "$helper" "$scale"
  ) || { echo "Error: workload failed" >&2; return 1; }

  echo "  -> training: upstream test suite"
  (
    export LD_LIBRARY_PATH="${libpath}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export LD_BIND_NOW=1
    ctest --test-dir "$abs" -j"$(nproc)" --output-on-failure
  ) || echo "  -> note: some tests failed during training (non-fatal)"

  return 0
}

# =============================================================================
# BOLT
# =============================================================================
# Option set rationale (every option below was validated against
# `llvm-bolt --help-hidden` of the llvm-ultimate build actually in use):
#
#   --relocs                 mandatory for function reordering; requires the
#                            binary to have been linked with --emit-relocs.
#   --reorder-blocks=ext-tsp the current best-known basic-block layout
#                            algorithm (extended TSP model). Strictly better
#                            than the older 'cache+'/'cache' heuristics.
#   --reorder-functions=cdsort
#                            Cache-Directed Sort. Successor to hfsort/hfsort+;
#                            it models i-cache and iTLB pressure rather than
#                            just call counts. hfsort (what a naive config
#                            picks) is the older, weaker algorithm.
#   --split-functions
#   --split-strategy=cdsplit Cache-Directed Splitting: 3-way hot/warm/cold
#                            split. Better than --split-all-cold, which is a
#                            blunt 2-way split that can push warm-but-not-hot
#                            blocks far away and cost branch range.
#   --icf=safe               Identical Code Folding restricted to functions
#                            whose address is provably not taken.  Plain
#                            `--icf=all` on a SHARED LIBRARY is dangerous:
#                            merging two exported functions makes their
#                            addresses compare equal, which is observable and
#                            can break callers that use function pointers as
#                            identity keys.
#   --use-gnu-stack          keep a PT_GNU_STACK header (non-exec stack).
#   --dyno-stats             report the modelled improvement.
#
# Deliberately NOT used:
#   --indirect-call-promotion  needs value-profile data that instrumentation
#                              mode does not provide well; without it BOLT can
#                              guess badly.
#   --jump-tables=move         only meaningful with -instrument; BOLT sets what
#                              it needs itself.
#   a second BOLT pass         re-optimising an already-BOLTed binary is not a
#                              supported workflow and provides no benefit; the
#                              profile no longer matches the rewritten layout.
_bolt_common_opts=(
  --relocs
  --reorder-blocks=ext-tsp
  --reorder-functions=cdsort
  --split-functions
  --split-strategy=cdsplit
  --icf=safe
  --use-gnu-stack
  --dyno-stats
)

prepare() {
  cd "${srcdir}/${_pkgname}"

  # Submodules (src/spng, src/md5) are required by the test suite.
  git submodule update --init --recursive --depth 1 || true

  echo "  -> applying ms178-1.patch"
  # No '|| true' here: if the patch does not apply we WANT the build to stop
  # rather than silently produce an unpatched package.
  patch -Np1 -i "${srcdir}/ms178-1.patch"

  cd "${srcdir}"
  _create_pgo_workload_source
}

build() {
  _setup_toolchain || return 1

  local abs_srcdir; abs_srcdir="$(cd "${srcdir}" && pwd)"
  local pgo_dir="${abs_srcdir}/pgo"
  local cs_dir="${abs_srcdir}/cspgo"
  local bolt_prof="${abs_srcdir}/bolt-prof"
  local bolt_inst="${abs_srcdir}/bolt-inst"

  rm -rf build-pgo build-cs build-final "$pgo_dir" "$cs_dir" "$bolt_prof" "$bolt_inst"
  rm -f "${abs_srcdir}"/*.profdata
  mkdir -p "$pgo_dir" "$cs_dir" "$bolt_prof" "$bolt_inst"

  # Instrumentation-time tuning.
  #   -g1                        line tables only: enough for profile
  #                              attribution, far cheaper than -g3.
  #   -fno-omit-frame-pointer    stable unwinding during the training runs.
  #   -mllvm -vp-counters-per-site=8
  #                              value-profiling slots.  The stock value (1) is
  #                              too low for the indirect calls in this code
  #                              base; 50 (a common cargo-culted value) bloats
  #                              the counter arrays and slows training a lot for
  #                              no extra signal here.
  local -a tuning=(
    -g1
    -fno-omit-frame-pointer
    -mllvm -vp-counters-per-site=12
    -mllvm -runtime-counter-relocation
  )
  local -a pwarn=(
    -Wno-profile-instr-out-of-date
    -Wno-profile-instr-unprofiled
    -Wno-backend-plugin
  )

  # ---------------------------------------------------------------------------
  echo "=== Stage 1/6: IR-PGO instrumented build ==="
  # No ThinLTO during instrumentation: it slows the build substantially and the
  # profile is consumed at the IR level anyway.
  _configure_build build-pgo None \
    "${tuning[*]} -fprofile-generate=${pgo_dir}" \
    "-fprofile-generate=${pgo_dir}"
  cmake --build build-pgo

  local helper1="${abs_srcdir}/workload-s1"
  _build_workload build-pgo "$helper1"

  export LLVM_PROFILE_FILE="${pgo_dir}/%m-%p.profraw"
  _run_training build-pgo "$helper1" "$(cd build-pgo && pwd)" 2 || return 1
  unset LLVM_PROFILE_FILE

  _count_profraw "$pgo_dir" "Stage 1" || { echo "Error: no stage-1 profiles" >&2; return 1; }
  "$_profdata" merge -output="${abs_srcdir}/standard.profdata" "${pgo_dir}"/*.profraw

  # ---------------------------------------------------------------------------
  echo "=== Stage 2/6: context-sensitive PGO instrumented build ==="
  _configure_build build-cs None \
    "${tuning[*]} -fprofile-use=${abs_srcdir}/standard.profdata -fcs-profile-generate=${cs_dir} ${pwarn[*]}" \
    "-fprofile-use=${abs_srcdir}/standard.profdata -fcs-profile-generate=${cs_dir}"
  cmake --build build-cs

  local helper2="${abs_srcdir}/workload-s2"
  _build_workload build-cs "$helper2"

  export LLVM_PROFILE_FILE="${cs_dir}/%m-%p.profraw"
  _run_training build-cs "$helper2" "$(cd build-cs && pwd)" 2 || return 1
  unset LLVM_PROFILE_FILE

  _count_profraw "$cs_dir" "Stage 2" || { echo "Error: no stage-2 profiles" >&2; return 1; }
  # The CS profile is merged ON TOP of the standard one; both are needed.
  "$_profdata" merge -output="${abs_srcdir}/merged.profdata" \
    "${abs_srcdir}/standard.profdata" "${cs_dir}"/*.profraw
  "$_profdata" show --detailed-summary "${abs_srcdir}/merged.profdata" | head -20

  # ---------------------------------------------------------------------------
  echo "=== Stage 3/6: final PGO build (BOLT-ready) ==="
  # --emit-relocs is what makes the BOLT stage possible at all.
  # -Wl,-z,now is required for BOLT instrumentation of shared objects.
  _configure_build build-final Release \
    "-fprofile-use=${abs_srcdir}/merged.profdata -fno-omit-frame-pointer ${pwarn[*]}" \
    "-fprofile-use=${abs_srcdir}/merged.profdata -Wl,--emit-relocs -Wl,-z,now"
  cmake --build build-final

  local -a libs
  mapfile -t libs < <(_find_libs "$(cd build-final && pwd)")
  (( ${#libs[@]} )) || { echo "Error: no shared libraries found in build-final" >&2; return 1; }
  echo "  -> libraries discovered:"; printf '       %s\n' "${libs[@]}"

  # Sanity: the relocations BOLT needs must actually be present.
  local l
  for l in "${libs[@]}"; do
    "$READELF" -S "$l" | grep -q '\.rela\.text' || {
      echo "Error: $l has no .rela.text - --emit-relocs did not take effect" >&2
      return 1
    }
  done
  echo "  -> .rela.text present in all libraries (BOLT can run in relocs mode)"

  # ---------------------------------------------------------------------------
  echo "=== Stage 4/6: BOLT instrumentation + training ==="
  # Instrumented copies live in $bolt_inst and are injected via LD_LIBRARY_PATH,
  # so the build tree itself stays clean.
  local base soname
  for l in "${libs[@]}"; do
    base="$(basename "$l")"
    "$_bolt" "$l" -o "${bolt_inst}/${base}" \
      --instrument \
      --instrumentation-file="${bolt_prof}/${base}.fdata" \
      --instrumentation-file-append-pid
    # Provide the SONAME symlink the loader will actually look for.
    soname="$("$READELF" -d "$l" | sed -n 's/.*SONAME.*\[\(.*\)\].*/\1/p' | head -n1)"
    [[ -n "$soname" && "$soname" != "$base" ]] && ln -sf "$base" "${bolt_inst}/${soname}"
  done
  echo "  -> instrumented $(ls -1 "${bolt_inst}"/*.so.* 2>/dev/null | wc -l) library file(s)"

  local helper3="${abs_srcdir}/workload-bolt"
  _build_workload build-final "$helper3"
  _run_training build-final "$helper3" "$bolt_inst" 2 || return 1

  local nfdata; nfdata=$(find "$bolt_prof" -name '*.fdata*' | wc -l)
  echo "  -> collected ${nfdata} BOLT profile fragment(s)"
  (( nfdata )) || { echo "Error: BOLT profile collection produced nothing" >&2; return 1; }

  "$_mergefdata" "${bolt_prof}"/*.fdata* > "${abs_srcdir}/bolt-merged.fdata" 2>/dev/null
  [[ -s "${abs_srcdir}/bolt-merged.fdata" ]] || {
    echo "Error: merge-fdata produced an empty profile" >&2; return 1; }

  # ---------------------------------------------------------------------------
  echo "=== Stage 5/6: BOLT optimisation ==="
  for l in "${libs[@]}"; do
    base="$(basename "$l")"
    echo "  -> BOLT ${base}"
    if "$_bolt" "$l" -o "${l}.bolt" \
         --data="${abs_srcdir}/bolt-merged.fdata" \
         "${_bolt_common_opts[@]}" 2>&1 | \
         grep -E 'non-empty execution profile|BOLT-ERROR|BOLT-WARNING: .*profile'
    then :; fi

    if [[ -s "${l}.bolt" ]]; then
      mv -f "${l}.bolt" "$l"
      echo "     applied"
    else
      rm -f "${l}.bolt"
      echo "     WARNING: BOLT produced no output for ${base}; keeping PGO-only build" >&2
    fi
  done

  # ---------------------------------------------------------------------------
  echo "=== Stage 6/6: verification against the final artefacts ==="
  local helperv="${abs_srcdir}/workload-verify"
  _build_workload build-final "$helperv"
  (
    export LD_LIBRARY_PATH="$(cd build-final && pwd)${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    "$helperv" 1
  ) || { echo "Error: verification workload failed on the BOLTed libraries" >&2; return 1; }

  echo "=== build complete ==="
}

check() {
  _setup_toolchain || return 1
  # Full upstream suite against the final (PGO+ThinLTO+BOLT) libraries.
  ctest --test-dir build-final -j"$(nproc)" --output-on-failure
}

package() {
  _setup_toolchain || return 1

  DESTDIR="${pkgdir}" cmake --install build-final

  # jpegint.h is not installed by upstream but several consumers expect it.
  install -vDm644 "${_pkgname}/src/jpegint.h" "${pkgdir}/usr/include/jpegint.h"

  _verify_expected_sonames "${pkgdir}/usr/lib"

  # Strip explicitly with llvm-strip.  We keep .text/.rodata intact and only
  # drop debug + symbol tables; using --strip-unneeded rather than a blanket
  # strip avoids disturbing the BOLT-generated layout and the extra text
  # sections (.text.cold / .text.warm) that cdsplit creates.
  local f
  while IFS= read -r -d '' f; do
    "$STRIP" --strip-unneeded "$f" 2>/dev/null || true
  done < <(find "${pkgdir}/usr/lib" -type f -name '*.so.*' -print0)
  while IFS= read -r -d '' f; do
    "$STRIP" --strip-all "$f" 2>/dev/null || true
  done < <(find "${pkgdir}/usr/bin" -type f -print0)

  # Post-strip sanity: the libraries must still load and resolve.
  local lib
  for lib in "${pkgdir}"/usr/lib/libjpeg.so.8.* "${pkgdir}"/usr/lib/libturbojpeg.so.0.*; do
    [[ -f "$lib" ]] || continue
    "$READELF" -d "$lib" >/dev/null || {
      echo "Error: $lib is malformed after strip" >&2; return 1; }
  done
  echo "  -> post-strip ELF validation passed"

  install -vDm644 "${_pkgname}/LICENSE.md" -t "${pkgdir}/usr/share/licenses/${pkgname}/"
  install -vDm644 "${_pkgname}/README.ijg" -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}

# =============================================================================
# The training workload
# =============================================================================
# Rationale for the design (this is where profile QUALITY actually comes from):
#
#  * Content statistics matter more than API coverage.  The previous workload
#    fed WHITE NOISE to the TurboJPEG matrix.  After quantisation white noise
#    leaves almost every AC coefficient non-zero, which trains the Huffman
#    coder's branches in exactly the OPPOSITE direction from real photographs
#    (where 20-40 of 63 AC coefficients are zero and long zero-runs dominate).
#    A profile gathered on noise actively pessimises real workloads.  Here the
#    bulk of the time is spent on fBm-based synthetic photographs with genuine
#    edges, and noise is used only in small doses for coverage.
#
#  * Weighting matters.  Time is spent roughly in proportion to real-world
#    usage: 4:2:0 / 4:4:4 photographic encode+decode dominates; exotica
#    (CMYK, arithmetic coding, 1x1 images, corrupt streams) is visited for
#    coverage but kept cheap so it cannot skew branch weights.
#
#  * The error handler is replaced with a setjmp-based one.  The stock handler
#    calls exit() on error, so the previous workload could not probe malformed
#    input at all.  Robustness paths are real hot paths for anything that
#    decodes untrusted data.
#
#  * Everything is deterministic (fixed seeds, no wall-clock branching) so the
#    profile is reproducible between the two PGO stages and the BOLT stage.
_create_pgo_workload_source() {
  cat > "${srcdir}/jpeg_pgo_workload.c" <<'WORKLOAD_EOF'
/*
 * libjpeg-turbo PGO/BOLT training workload  (ms178 / godlike edition)
 *
 * Design goals, in priority order:
 *   1. COVERAGE  - touch every hot decision path that real users hit:
 *                  baseline+progressive+lossless+arithmetic, all subsampling
 *                  modes, all pixel formats, upsampling variants, scaled &
 *                  partial decode, transforms, buffered-image mode, quant.
 *   2. WEIGHTING - spend *time* roughly in proportion to real-world usage so
 *                  PGO branch weights & BOLT block ordering reflect reality.
 *                  Photographic 420/444 encode+decode dominates; exotica is
 *                  visited for coverage but not allowed to skew the profile.
 *   3. REALISM   - train on photographic statistics (smooth + textured +
 *                  edges), not white noise. White noise makes every AC
 *                  coefficient nonzero, which trains the *opposite* branch
 *                  bias from real images and actively harms the profile.
 *   4. DETERMINISM - fixed seeds, no wall-clock dependence, no unbounded
 *                  memory. Reproducible profiles across runs.
 *
 * Everything is bounded so the whole thing runs in a couple of minutes and
 * fits in a modest RAM budget.
 */
#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <math.h>
#include <time.h>
#include <setjmp.h>
#include <pthread.h>
#include <jpeglib.h>
#include <turbojpeg.h>

/* ------------------------------------------------------------------ utils */

static double now_sec(void)
{
  struct timespec ts;
  clock_gettime(CLOCK_MONOTONIC, &ts);
  return (double)ts.tv_sec + (double)ts.tv_nsec * 1e-9;
}

static uint32_t xs32(uint32_t *s)
{
  uint32_t x = *s;
  x ^= x << 13; x ^= x >> 17; x ^= x << 5;
  return *s = x;
}

typedef struct { uint8_t *data; int w, h, c; } img_t;

static void img_free(img_t *im) { free(im->data); im->data = NULL; }

static int img_alloc(img_t *im, int w, int h, int c)
{
  im->w = w; im->h = h; im->c = c;
  im->data = (uint8_t *)malloc((size_t)w * h * c);
  return im->data != NULL;
}

/* ------------------------------------------------------- image generators */
/*
 * A real photograph, statistically, is: low-frequency dominant, locally
 * smooth, with sparse high-frequency edges and mild sensor noise. After the
 * DCT+quantise that yields MANY zero AC coefficients and long zero runs.
 * That is precisely the branch behaviour we want the Huffman coder trained
 * on. Pure white noise (used by the previous workload for the tj matrix)
 * produces dense nonzero coefficients and trains the wrong way, so it is
 * used here only sparingly and deliberately.
 */

/* Value-noise + fBm: smooth, photographic, cheap, deterministic. */
static float vnoise(int x, int y, uint32_t seed)
{
  uint32_t h = (uint32_t)x * 374761393u + (uint32_t)y * 668265263u + seed;
  h = (h ^ (h >> 13)) * 1274126177u;
  return (float)((h ^ (h >> 16)) & 0xFFFF) / 65535.0f;
}

static float smoothn(float fx, float fy, uint32_t seed)
{
  int xi = (int)fx, yi = (int)fy;
  float tx = fx - (float)xi, ty = fy - (float)yi;
  tx = tx * tx * (3.0f - 2.0f * tx);
  ty = ty * ty * (3.0f - 2.0f * ty);
  float a = vnoise(xi,     yi,     seed), b = vnoise(xi + 1, yi,     seed);
  float c = vnoise(xi,     yi + 1, seed), d = vnoise(xi + 1, yi + 1, seed);
  return (a + (b - a) * tx) + ((c + (d - c) * tx) - (a + (b - a) * tx)) * ty;
}

/* The workhorse: photographic content with edges. This is what most of the
 * profile weight is spent on, because it is what users actually encode. */
static int mk_photo(img_t *im, int w, int h, int c, uint32_t seed)
{
  if (!img_alloc(im, w, h, c)) return 0;
  uint32_t ns = seed ? seed : 1u;
  for (int y = 0; y < h; y++) {
    for (int x = 0; x < w; x++) {
      float fx = (float)x, fy = (float)y;
      /* 4-octave fBm => smooth gradients + texture */
      float v = 0.0f, amp = 0.5f, sc = 1.0f / 64.0f;
      for (int o = 0; o < 4; o++) {
        v += smoothn(fx * sc, fy * sc, seed + (uint32_t)o * 7919u) * amp;
        amp *= 0.5f; sc *= 2.0f;
      }
      /* hard edges: objects/occlusions produce the high-frequency content
       * that exercises the long-code Huffman paths */
      float edge = ((x / 97 + y / 89) & 1) ? 0.16f : -0.16f;
      if (((x * 7 + y * 13) % 311) < 6) edge += 0.35f;      /* thin lines */
      float base = v + edge;
      /* mild sensor noise (never dominant) */
      float n = ((float)(xs32(&ns) & 0xFF) - 128.0f) * (1.0f / 255.0f) * 0.06f;
      float r = (base + n) * 255.0f;
      float g = (base * 0.94f + n * 0.8f) * 255.0f + 6.0f;
      float b = (base * 1.06f + n * 1.2f) * 255.0f - 6.0f;
      int i = (y * w + x) * c;
      uint8_t R = (uint8_t)(r < 0 ? 0 : r > 255 ? 255 : r);
      uint8_t G = (uint8_t)(g < 0 ? 0 : g > 255 ? 255 : g);
      uint8_t B = (uint8_t)(b < 0 ? 0 : b > 255 ? 255 : b);
      if (c == 1) { im->data[i] = R; }
      else {
        im->data[i] = R; im->data[i + 1] = G; im->data[i + 2] = B;
        if (c >= 4) im->data[i + 3] = 255;
      }
    }
  }
  return 1;
}

/* Flat / near-flat: trains the EOB and zero-run-length paths hard. Very
 * common in real content (sky, walls, synthetic UI, document scans). */
static int mk_flat(img_t *im, int w, int h, int c, uint32_t seed)
{
  if (!img_alloc(im, w, h, c)) return 0;
  uint32_t ns = seed ? seed : 1u;
  for (int i = 0; i < w * h * c; i++) {
    int v = 128 + (int)((xs32(&ns) & 3u)) - 1;          /* +-1 LSB dither */
    im->data[i] = (uint8_t)v;
  }
  return 1;
}

/* Sharp synthetic: text/line-art, maximal high-frequency, exercises the
 * large-magnitude coefficient and 16-zero-run (0xF0) paths. */
static int mk_sharp(img_t *im, int w, int h, int c, uint32_t seed)
{
  if (!img_alloc(im, w, h, c)) return 0;
  (void)seed;
  for (int y = 0; y < h; y++)
    for (int x = 0; x < w; x++) {
      int i = (y * w + x) * c;
      int on = (((x >> 1) ^ (y >> 1)) & 1) || ((x % 13) < 2) || ((y % 17) < 2);
      uint8_t v = on ? 255 : 0;
      if (c == 1) im->data[i] = v;
      else {
        im->data[i] = v;
        im->data[i + 1] = (uint8_t)(on ? 16 : 240);
        im->data[i + 2] = (uint8_t)(((x + y) & 1) ? 255 : 0);
        if (c >= 4) im->data[i + 3] = 255;
      }
    }
  return 1;
}

/* Deliberate noise - kept SMALL and rare, only to cover the dense-coefficient
 * branches without polluting the overall branch weights. */
static int mk_noise(img_t *im, int w, int h, int c, uint32_t seed)
{
  if (!img_alloc(im, w, h, c)) return 0;
  uint32_t s = seed ? seed : 1u;
  for (int i = 0; i < w * h * c; i++) im->data[i] = (uint8_t)(xs32(&s) & 0xFF);
  return 1;
}

/* ------------------------------------------------ libjpeg error management */
/*
 * The stock error handler calls exit() on any error. A training workload that
 * deliberately probes edge cases MUST NOT die, and equally must not train the
 * profile on a longjmp storm. We use setjmp recovery and count errors.
 */
struct jerr_t { struct jpeg_error_mgr pub; jmp_buf jb; };
static void jerr_exit(j_common_ptr ci) { longjmp(((struct jerr_t *)ci->err)->jb, 1); }
static void jerr_quiet(j_common_ptr ci, int lvl) { (void)ci; (void)lvl; }
static void jerr_nop(j_common_ptr ci) { (void)ci; }

static void jerr_setup(struct jerr_t *e)
{
  jpeg_std_error(&e->pub);
  e->pub.error_exit     = jerr_exit;
  e->pub.emit_message   = jerr_quiet;   /* no stderr spam, no I/O in profile */
  e->pub.output_message = jerr_nop;
}

/* --------------------------------------------------------- libjpeg codecs */

typedef struct {
  int quality;
  J_COLOR_SPACE in_cs;
  int progressive;
  int optimize;
  int arithmetic;
  int hsamp, vsamp;      /* 0 => leave defaults */
  int smoothing;
  int restart_rows;
  J_DCT_METHOD dct;
} enc_opt_t;

static unsigned char *jenc(const img_t *im, const enc_opt_t *o, unsigned long *osz)
{
  struct jpeg_compress_struct ci;
  struct jerr_t err;
  unsigned char *ob = NULL;
  unsigned long os = 0;

  jerr_setup(&err);
  ci.err = &err.pub;
  if (setjmp(err.jb)) { jpeg_destroy_compress(&ci); free(ob); *osz = 0; return NULL; }

  jpeg_create_compress(&ci);
  jpeg_mem_dest(&ci, &ob, &os);
  ci.image_width      = (JDIMENSION)im->w;
  ci.image_height     = (JDIMENSION)im->h;
  ci.input_components = im->c;
  ci.in_color_space   = o->in_cs;
  jpeg_set_defaults(&ci);
  jpeg_set_quality(&ci, o->quality, TRUE);
  ci.dct_method      = o->dct;
  ci.optimize_coding = o->optimize ? TRUE : FALSE;
  ci.smoothing_factor = o->smoothing;
  if (o->restart_rows) ci.restart_in_rows = o->restart_rows;
  if (o->arithmetic) ci.arith_code = TRUE;
  if (o->progressive) jpeg_simple_progression(&ci);
  if (im->c == 3 && o->hsamp) {
    ci.comp_info[0].h_samp_factor = o->hsamp;
    ci.comp_info[0].v_samp_factor = o->vsamp;
    for (int k = 1; k < 3; k++) {
      ci.comp_info[k].h_samp_factor = 1;
      ci.comp_info[k].v_samp_factor = 1;
    }
  }
  jpeg_start_compress(&ci, TRUE);
  {
    int stride = im->w * im->c;
    /* multi-row writes: the realistic call pattern, and it exercises the
     * main-controller loop rather than the 1-row special case only */
    JSAMPROW rp[8];
    while (ci.next_scanline < ci.image_height) {
      int n = 0;
      while (n < 8 && ci.next_scanline + (JDIMENSION)n < ci.image_height) {
        rp[n] = (JSAMPLE *)&im->data[(size_t)(ci.next_scanline + (JDIMENSION)n) * stride];
        n++;
      }
      jpeg_write_scanlines(&ci, rp, (JDIMENSION)n);
    }
  }
  jpeg_finish_compress(&ci);
  jpeg_destroy_compress(&ci);
  *osz = os;
  return ob;
}

typedef struct {
  J_COLOR_SPACE out_cs;
  int sn, sd;
  J_DCT_METHOD dct;
  int fancy;
  int block_smoothing;
  int two_pass_quant;
  int quantize;
  int n_colors;
  int buffered;          /* buffered-image (multi-scan) decode */
  int crop;              /* exercise jpeg_crop_scanline */
  int skip;              /* exercise jpeg_skip_scanlines */
} dec_opt_t;

static int jdec(const unsigned char *jd, unsigned long jsz, const dec_opt_t *o)
{
  struct jpeg_decompress_struct di;
  struct jerr_t err;
  uint8_t *row = NULL;

  jerr_setup(&err);
  di.err = &err.pub;
  if (setjmp(err.jb)) { jpeg_destroy_decompress(&di); free(row); return 0; }

  jpeg_create_decompress(&di);
  jpeg_mem_src(&di, jd, jsz);
  if (jpeg_read_header(&di, TRUE) != JPEG_HEADER_OK) {
    jpeg_destroy_decompress(&di); return 0;
  }
  di.out_color_space      = o->out_cs;
  di.scale_num            = o->sn;
  di.scale_denom          = o->sd;
  di.dct_method           = o->dct;
  di.do_fancy_upsampling  = o->fancy ? TRUE : FALSE;
  di.do_block_smoothing   = o->block_smoothing ? TRUE : FALSE;
  if (o->quantize) {
    di.quantize_colors  = TRUE;
    di.desired_number_of_colors = o->n_colors;
    di.two_pass_quantize = o->two_pass_quant ? TRUE : FALSE;
    di.dither_mode = o->two_pass_quant ? JDITHER_FS : JDITHER_ORDERED;
  }
  if (o->buffered) di.buffered_image = TRUE;

  jpeg_start_decompress(&di);

  {
    int rs = (int)di.output_width * di.output_components;
    if (rs <= 0) { jpeg_finish_decompress(&di); jpeg_destroy_decompress(&di); return 0; }
    row = (uint8_t *)malloc((size_t)rs * 4);
    if (!row) { jpeg_finish_decompress(&di); jpeg_destroy_decompress(&di); return 0; }

    if (o->buffered) {
      /* progressive multi-scan display loop: the real browser pattern */
      while (!jpeg_input_complete(&di)) {
        jpeg_start_output(&di, di.input_scan_number);
        while (di.output_scanline < di.output_height) {
          JSAMPROW r[1] = { row };
          if (jpeg_read_scanlines(&di, r, 1) == 0) break;
        }
        jpeg_finish_output(&di);
      }
    } else {
      if (o->crop && di.output_width > 16) {
        JDIMENSION xoff = 4, wid = di.output_width / 2;
        if (wid < 1) wid = 1;
        jpeg_crop_scanline(&di, &xoff, &wid);
        rs = (int)wid * di.output_components;
      }
      while (di.output_scanline < di.output_height) {
        if (o->skip && di.output_scanline + 4 < di.output_height &&
            (di.output_scanline & 7) == 0) {
          jpeg_skip_scanlines(&di, 2);
          continue;
        }
        JSAMPROW r[4];
        int n = 0;
        while (n < 4 && di.output_scanline + (JDIMENSION)n < di.output_height) {
          r[n] = row + (size_t)n * rs; n++;
        }
        if (jpeg_read_scanlines(&di, r, (JDIMENSION)n) == 0) break;
      }
    }
    free(row); row = NULL;
  }
  jpeg_finish_decompress(&di);
  jpeg_destroy_decompress(&di);
  return 1;
}

/* ============================ PHASE 1: the dominant real-world path =======
 * Photographic 420/444 baseline + progressive encode/decode at the qualities
 * people actually use. This gets the LION'S SHARE of the profile weight, on
 * purpose: it is what the optimizer should be tuned for.
 */
static void phase_mainstream(int reps)
{
  static const int QS[] = { 75, 82, 85, 90, 92, 95 };
  struct { int w, h; } SZ[] = { { 1920, 1080 }, { 1280, 720 }, { 640, 480 } };
  printf("  [1] mainstream photographic encode/decode (weighted heaviest)\n");

  for (int r = 0; r < reps; r++) {
    for (size_t si = 0; si < sizeof(SZ) / sizeof(SZ[0]); si++) {
      img_t im;
      if (!mk_photo(&im, SZ[si].w, SZ[si].h, 3, 0xC0FFEEu + (uint32_t)si)) continue;

      for (size_t qi = 0; qi < sizeof(QS) / sizeof(QS[0]); qi++) {
        enc_opt_t eo = { QS[qi], JCS_RGB, 0, 0, 0, 2, 2, 0, 0, JDCT_ISLOW };
        unsigned long sz = 0;
        unsigned char *j;

        /* 4:2:0 baseline - by far the most common JPEG on earth */
        j = jenc(&im, &eo, &sz);
        if (j && sz) {
          dec_opt_t d = { JCS_RGB, 1, 1, JDCT_ISLOW, 1, 0, 0, 0, 0, 0, 0, 0 };
          jdec(j, sz, &d);
          d.out_cs = JCS_EXT_BGRX; jdec(j, sz, &d);      /* common blit format */
          d.out_cs = JCS_RGB; d.fancy = 0; jdec(j, sz, &d);
        }
        free(j);

        /* 4:4:4 baseline - quality-critical path */
        eo.hsamp = 1; eo.vsamp = 1;
        j = jenc(&im, &eo, &sz);
        if (j && sz) {
          dec_opt_t d = { JCS_RGB, 1, 1, JDCT_ISLOW, 1, 0, 0, 0, 0, 0, 0, 0 };
          jdec(j, sz, &d);
        }
        free(j);

        /* progressive 4:2:0 - dominant on the web */
        eo.hsamp = 2; eo.vsamp = 2; eo.progressive = 1; eo.optimize = 1;
        j = jenc(&im, &eo, &sz);
        if (j && sz) {
          dec_opt_t d = { JCS_RGB, 1, 1, JDCT_ISLOW, 1, 1, 0, 0, 0, 0, 0, 0 };
          jdec(j, sz, &d);
          d.buffered = 1; jdec(j, sz, &d);               /* incremental display */
        }
        free(j);
        eo.progressive = 0; eo.optimize = 0;
      }
      img_free(&im);
    }
  }
}

/* ============================ PHASE 2: content-type coverage ==============
 * Flat, sharp and noisy content drive very different branches inside the
 * Huffman coder (EOB runs vs long codes vs dense coefficients).
 */
static void phase_content(int reps)
{
  printf("  [2] content-type coverage (flat / sharp / noise)\n");
  for (int r = 0; r < reps; r++) {
    img_t f, s, n;
    int okf = mk_flat(&f, 640, 480, 3, 11u + (uint32_t)r);
    int oks = mk_sharp(&s, 640, 480, 3, 22u + (uint32_t)r);
    int okn = mk_noise(&n, 256, 256, 3, 33u + (uint32_t)r);  /* small on purpose */

    static const int QS[] = { 50, 80, 95 };
    for (size_t qi = 0; qi < sizeof(QS) / sizeof(QS[0]); qi++) {
      enc_opt_t eo = { QS[qi], JCS_RGB, 0, 1, 0, 2, 2, 0, 0, JDCT_ISLOW };
      unsigned long sz;
      unsigned char *j;
      dec_opt_t d = { JCS_RGB, 1, 1, JDCT_ISLOW, 1, 0, 0, 0, 0, 0, 0, 0 };

      if (okf) { j = jenc(&f, &eo, &sz); if (j && sz) jdec(j, sz, &d); free(j); }
      if (oks) { j = jenc(&s, &eo, &sz); if (j && sz) jdec(j, sz, &d); free(j); }
      if (okn) { j = jenc(&n, &eo, &sz); if (j && sz) jdec(j, sz, &d); free(j); }

      /* progressive variants of the same content */
      eo.progressive = 1;
      if (okf) { j = jenc(&f, &eo, &sz); if (j && sz) jdec(j, sz, &d); free(j); }
      if (oks) { j = jenc(&s, &eo, &sz); if (j && sz) jdec(j, sz, &d); free(j); }
    }
    if (okf) img_free(&f);
    if (oks) img_free(&s);
    if (okn) img_free(&n);
  }
}

/* ============================ PHASE 3: grayscale + CMYK + colorspaces ===== */
static void phase_colorspaces(int reps)
{
  printf("  [3] colorspace / grayscale / CMYK paths\n");
  for (int r = 0; r < reps; r++) {
    img_t g, c4;
    if (mk_photo(&g, 800, 600, 1, 0x5EEDu + (uint32_t)r)) {
      static const int QS[] = { 60, 85, 95 };
      for (size_t qi = 0; qi < sizeof(QS) / sizeof(QS[0]); qi++) {
        enc_opt_t eo = { QS[qi], JCS_GRAYSCALE, 0, 1, 0, 0, 0, 0, 0, JDCT_ISLOW };
        unsigned long sz; unsigned char *j = jenc(&g, &eo, &sz);
        if (j && sz) {
          dec_opt_t d = { JCS_GRAYSCALE, 1, 1, JDCT_ISLOW, 1, 0, 0, 0, 0, 0, 0, 0 };
          jdec(j, sz, &d);
          d.out_cs = JCS_RGB; jdec(j, sz, &d);   /* gray->RGB expansion path */
        }
        free(j);
        eo.progressive = 1;
        j = jenc(&g, &eo, &sz);
        if (j && sz) { dec_opt_t d = { JCS_GRAYSCALE,1,1,JDCT_ISLOW,1,1,0,0,0,0,0,0 }; jdec(j, sz, &d); }
        free(j);
      }
      img_free(&g);
    }
    /* CMYK / YCCK: printing pipelines, and a distinct color-convert path */
    if (mk_photo(&c4, 320, 240, 4, 0xABCDu + (uint32_t)r)) {
      enc_opt_t eo = { 88, JCS_CMYK, 0, 0, 0, 0, 0, 0, 0, JDCT_ISLOW };
      unsigned long sz; unsigned char *j = jenc(&c4, &eo, &sz);
      if (j && sz) { dec_opt_t d = { JCS_CMYK, 1, 1, JDCT_ISLOW, 1, 0, 0, 0, 0, 0, 0, 0 }; jdec(j, sz, &d); }
      free(j);
      eo.in_cs = JCS_YCCK;
      j = jenc(&c4, &eo, &sz);
      if (j && sz) { dec_opt_t d = { JCS_CMYK, 1, 1, JDCT_ISLOW, 1, 0, 0, 0, 0, 0, 0, 0 }; jdec(j, sz, &d); }
      free(j);
      img_free(&c4);
    }
  }
}

/* ============================ PHASE 4: decoder feature matrix =============
 * Scaled decode, DCT method variants, quantisation, crop/skip. These are
 * genuinely used (thumbnailing, previews, 8-bit displays) and each lights up
 * a distinct module (jdsample/jdmerge/jquant1/jquant2/jdapistd).
 */
static void phase_decoder_matrix(int reps)
{
  printf("  [4] decoder feature matrix (scaling / DCT / quantise / crop / skip)\n");
  img_t im;
  if (!mk_photo(&im, 1024, 768, 3, 0xD00Du)) return;

  enc_opt_t eo420 = { 85, JCS_RGB, 0, 0, 0, 2, 2, 0, 0, JDCT_ISLOW };
  enc_opt_t eo444 = { 85, JCS_RGB, 0, 0, 0, 1, 1, 0, 0, JDCT_ISLOW };
  unsigned long s420 = 0, s444 = 0;
  unsigned char *j420 = jenc(&im, &eo420, &s420);
  unsigned char *j444 = jenc(&im, &eo444, &s444);
  img_free(&im);

  /* the full M/8 scaling ladder - thumbnailers use these constantly */
  static const int SN[] = { 1, 1, 1, 1, 3, 5, 7, 1, 9, 15 };
  static const int SD[] = { 8, 4, 2, 1, 8, 8, 8, 8, 8,  8 };

  for (int r = 0; r < reps; r++) {
    for (size_t k = 0; k < sizeof(SN) / sizeof(SN[0]); k++) {
      dec_opt_t d = { JCS_RGB, SN[k], SD[k], JDCT_ISLOW, 1, 0, 0, 0, 0, 0, 0, 0 };
      if (j420 && s420) jdec(j420, s420, &d);
      if (j444 && s444 && k < 4) jdec(j444, s444, &d);
    }
    /* DCT method variants (islow/ifast/float all have separate SIMD kernels) */
    if (j420 && s420) {
      dec_opt_t d = { JCS_RGB, 1, 1, JDCT_ISLOW, 1, 0, 0, 0, 0, 0, 0, 0 };
      d.dct = JDCT_IFAST; jdec(j420, s420, &d);
      d.dct = JDCT_FLOAT; jdec(j420, s420, &d);
      d.dct = JDCT_ISLOW;
      /* merged upsampling (non-fancy) - the fast blit path */
      d.fancy = 0; jdec(j420, s420, &d);
      d.fancy = 1;
      /* colour quantisation: 1-pass and 2-pass, both dither modes */
      d.quantize = 1; d.n_colors = 256; d.two_pass_quant = 0; jdec(j420, s420, &d);
      d.two_pass_quant = 1; jdec(j420, s420, &d);
      d.n_colors = 16; jdec(j420, s420, &d);
      d.quantize = 0;
      /* partial decode APIs */
      d.crop = 1; jdec(j420, s420, &d); d.crop = 0;
      d.skip = 1; jdec(j420, s420, &d); d.skip = 0;
      /* common output formats for real applications */
      d.out_cs = JCS_EXT_RGBA; jdec(j420, s420, &d);
      d.out_cs = JCS_EXT_BGR;  jdec(j420, s420, &d);
      d.out_cs = JCS_GRAYSCALE; jdec(j420, s420, &d);
    }
  }
  free(j420); free(j444);
}

/* ============================ PHASE 5: arithmetic + restart + smoothing === */
static void phase_special_coding(int reps)
{
  printf("  [5] arithmetic coding / restart markers / smoothing\n");
  img_t im;
  if (!mk_photo(&im, 512, 384, 3, 0xFACEu)) return;
  for (int r = 0; r < reps; r++) {
    /* arithmetic coding: jcarith.c / jdarith.c, entirely separate coder */
    enc_opt_t eo = { 85, JCS_RGB, 0, 0, 1, 2, 2, 0, 0, JDCT_ISLOW };
    unsigned long sz; unsigned char *j = jenc(&im, &eo, &sz);
    if (j && sz) { dec_opt_t d = { JCS_RGB,1,1,JDCT_ISLOW,1,0,0,0,0,0,0,0 }; jdec(j, sz, &d); }
    free(j);
    /* progressive + arithmetic */
    eo.progressive = 1;
    j = jenc(&im, &eo, &sz);
    if (j && sz) { dec_opt_t d = { JCS_RGB,1,1,JDCT_ISLOW,1,1,0,0,0,0,0,0 }; jdec(j, sz, &d); }
    free(j);
    /* restart markers: error-resilient streams (broadcast, DCIM) */
    eo.progressive = 0; eo.arithmetic = 0; eo.restart_rows = 4;
    j = jenc(&im, &eo, &sz);
    if (j && sz) { dec_opt_t d = { JCS_RGB,1,1,JDCT_ISLOW,1,0,0,0,0,0,0,0 }; jdec(j, sz, &d); }
    free(j);
    /* input smoothing (jcprepct downsample path) */
    eo.restart_rows = 0; eo.smoothing = 40;
    j = jenc(&im, &eo, &sz);
    if (j && sz) { dec_opt_t d = { JCS_RGB,1,1,JDCT_ISLOW,1,0,0,0,0,0,0,0 }; jdec(j, sz, &d); }
    free(j);
  }
  img_free(&im);
}

/* ============================ PHASE 6: TurboJPEG API ======================
 * The TurboJPEG wrapper is what most downstream applications actually link
 * against, so it must be profiled - including its own buffer management,
 * subsampling detection, scaling and lossless transform engine.
 */
static void phase_turbojpeg(int reps)
{
  printf("  [6] TurboJPEG API (compress / decompress / transform / YUV)\n");
  static const int SS[]  = { TJSAMP_420, TJSAMP_422, TJSAMP_444, TJSAMP_GRAY, TJSAMP_440, TJSAMP_411 };
  static const int PF[]  = { TJPF_RGB, TJPF_BGR, TJPF_RGBX, TJPF_BGRA, TJPF_XRGB, TJPF_GRAY, TJPF_RGBA };
  static const int QS[]  = { 75, 85, 95 };
  struct { int w, h; } SZ[] = { { 1280, 720 }, { 640, 480 }, { 320, 240 } };

  for (int r = 0; r < reps; r++) {
    for (size_t si = 0; si < sizeof(SZ) / sizeof(SZ[0]); si++) {
      int w = SZ[si].w, h = SZ[si].h;
      img_t im;
      if (!mk_photo(&im, w, h, 4, 0x77u + (uint32_t)si)) continue;   /* 4ch source */

      for (size_t pi = 0; pi < sizeof(PF) / sizeof(PF[0]); pi++) {
        int pf = PF[pi], ps = tjPixelSize[pf];
        /* build a correctly-sized buffer for this pixel format */
        size_t need = (size_t)w * h * ps;
        uint8_t *src = (uint8_t *)malloc(need);
        if (!src) continue;
        for (int y = 0; y < h; y++)
          for (int x = 0; x < w; x++) {
            const uint8_t *s = &im.data[((size_t)y * w + x) * 4];
            uint8_t *d = &src[((size_t)y * w + x) * ps];
            for (int k = 0; k < ps; k++) d[k] = s[k & 3];
          }

        for (size_t qi = 0; qi < sizeof(QS) / sizeof(QS[0]); qi++) {
          /* weight: only the common subsamplings for every pf, all for 420 */
          size_t nss = (pi == 0) ? sizeof(SS) / sizeof(SS[0]) : 2;
          for (size_t ssi = 0; ssi < nss; ssi++) {
            tjhandle c = tj3Init(TJINIT_COMPRESS);
            if (!c) continue;
            tj3Set(c, TJPARAM_SUBSAMP, SS[ssi]);
            tj3Set(c, TJPARAM_QUALITY, QS[qi]);
            tj3Set(c, TJPARAM_OPTIMIZE, (qi == 2) ? 1 : 0);
            tj3Set(c, TJPARAM_PROGRESSIVE, (qi == 1) ? 1 : 0);
            tj3Set(c, TJPARAM_FASTDCT, 0);
            unsigned char *jb = NULL; size_t jsz = 0;
            int rc = tj3Compress8(c, src, w, 0, h, pf, &jb, &jsz);
            tj3Destroy(c);
            if (rc || !jb || !jsz) { tj3Free(jb); continue; }

            /* decompress to a couple of realistic output formats */
            tjhandle d = tj3Init(TJINIT_DECOMPRESS);
            if (d) {
              if (tj3DecompressHeader(d, jb, jsz) == 0) {
                int dw = tj3Get(d, TJPARAM_JPEGWIDTH), dh = tj3Get(d, TJPARAM_JPEGHEIGHT);
                if (dw > 0 && dh > 0) {
                  uint8_t *db = (uint8_t *)malloc((size_t)dw * dh * 4);
                  if (db) {
                    tj3Decompress8(d, jb, jsz, db, 0, TJPF_RGB);
                    if (ssi == 0) tj3Decompress8(d, jb, jsz, db, 0, TJPF_BGRX);
                    free(db);
                  }
                  /* scaled decode via TurboJPEG (thumbnail path) */
                  if (ssi == 0 && qi == 0) {
                    int nsf = 0; const tjscalingfactor *sf = tj3GetScalingFactors(&nsf);
                    for (int k = 0; sf && k < nsf && k < 6; k++) {
                      tjhandle sdh = tj3Init(TJINIT_DECOMPRESS);
                      if (!sdh) continue;
                      tj3SetScalingFactor(sdh, sf[k]);
                      if (tj3DecompressHeader(sdh, jb, jsz) == 0) {
                        int sw = TJSCALED(dw, sf[k]), sh = TJSCALED(dh, sf[k]);
                        if (sw > 0 && sh > 0) {
                          uint8_t *sb = (uint8_t *)malloc((size_t)sw * sh * 3);
                          if (sb) { tj3Decompress8(sdh, jb, jsz, sb, 0, TJPF_RGB); free(sb); }
                        }
                      }
                      tj3Destroy(sdh);
                    }
                  }
                  /* YUV planar path (video pipelines) */
                  if (ssi == 0 && qi == 0) {
                    size_t ysz = tj3YUVBufSize(dw, 4, dh, SS[ssi]);
                    if (ysz) {
                      uint8_t *yb = (uint8_t *)malloc(ysz);
                      if (yb) {
                        tjhandle yd = tj3Init(TJINIT_DECOMPRESS);
                        if (yd && tj3DecompressHeader(yd, jb, jsz) == 0)
                          tj3DecompressToYUV8(yd, jb, jsz, yb, 4);
                        if (yd) tj3Destroy(yd);
                        tjhandle yc = tj3Init(TJINIT_COMPRESS);
                        if (yc) {
                          tj3Set(yc, TJPARAM_SUBSAMP, SS[ssi]);
                          tj3Set(yc, TJPARAM_QUALITY, QS[qi]);
                          unsigned char *yj = NULL; size_t yjs = 0;
                          tj3CompressFromYUV8(yc, yb, dw, 4, dh, &yj, &yjs);
                          tj3Free(yj); tj3Destroy(yc);
                        }
                        free(yb);
                      }
                    }
                  }
                }
              }
              tj3Destroy(d);
            }

            /* lossless transforms - jpegtran engine, only on the base case */
            if (pi == 0 && qi == 0 && ssi == 0 && w >= 64 && h >= 64) {
              for (int op = TJXOP_NONE; op <= TJXOP_ROT270; op++) {
                tjhandle xf = tj3Init(TJINIT_TRANSFORM);
                if (!xf) continue;
                tjtransform t; memset(&t, 0, sizeof(t));
                t.op = op; t.options = TJXOPT_TRIM | (op == TJXOP_NONE ? TJXOPT_PROGRESSIVE : 0);
                unsigned char *xj = NULL; size_t xs = 0;
                if (tj3Transform(xf, jb, jsz, 1, &xj, &xs, &t) == 0 && xj && xs) {
                  tjhandle vd = tj3Init(TJINIT_DECOMPRESS);
                  if (vd) {
                    if (tj3DecompressHeader(vd, xj, xs) == 0) {
                      int tw = tj3Get(vd, TJPARAM_JPEGWIDTH), th = tj3Get(vd, TJPARAM_JPEGHEIGHT);
                      if (tw > 0 && th > 0) {
                        uint8_t *tb = (uint8_t *)malloc((size_t)tw * th * 3);
                        if (tb) { tj3Decompress8(vd, xj, xs, tb, 0, TJPF_RGB); free(tb); }
                      }
                    }
                    tj3Destroy(vd);
                  }
                }
                tj3Free(xj); tj3Destroy(xf);
              }
              /* crop transform: distinct code path from the rotations */
              tjhandle xf = tj3Init(TJINIT_TRANSFORM);
              if (xf) {
                tjtransform t; memset(&t, 0, sizeof(t));
                t.op = TJXOP_NONE; t.options = TJXOPT_CROP | TJXOPT_TRIM;
                t.r.x = 0; t.r.y = 0; t.r.w = (w / 16) * 8; t.r.h = (h / 16) * 8;
                unsigned char *xj = NULL; size_t xs = 0;
                if (t.r.w > 0 && t.r.h > 0)
                  tj3Transform(xf, jb, jsz, 1, &xj, &xs, &t);
                tj3Free(xj); tj3Destroy(xf);
              }
            }
            tj3Free(jb);
          }
        }
        free(src);
      }
      img_free(&im);
    }
  }
}

/* ============================ PHASE 7: edge geometry ======================
 * Tiny / odd / extreme-aspect images exercise the partial-MCU and edge-expand
 * code. Kept cheap so it cannot distort the profile weighting.
 */
static void phase_edges(void)
{
  printf("  [7] edge geometry (partial MCU / odd sizes / extreme aspect)\n");
  static const int DIM[][2] = {
    {1,1},{2,3},{7,7},{8,8},{9,9},{15,16},{16,15},{17,17},{31,33},{63,65},
    {1,512},{512,1},{127,3},{3,127},{129,129}
  };
  for (size_t i = 0; i < sizeof(DIM) / sizeof(DIM[0]); i++) {
    img_t im;
    if (!mk_photo(&im, DIM[i][0], DIM[i][1], 3, 0x1234u + (uint32_t)i)) continue;
    for (int prog = 0; prog < 2; prog++) {
      enc_opt_t eo = { 80, JCS_RGB, prog, 1, 0, prog ? 2 : 1, prog ? 2 : 1, 0, 0, JDCT_ISLOW };
      unsigned long sz; unsigned char *j = jenc(&im, &eo, &sz);
      if (j && sz) {
        dec_opt_t d = { JCS_RGB, 1, 1, JDCT_ISLOW, 1, prog, 0, 0, 0, 0, 0, 0 };
        jdec(j, sz, &d);
        d.sn = 1; d.sd = 2; jdec(j, sz, &d);
      }
      free(j);
    }
    img_free(&im);
    /* grayscale variant of the same geometry */
    if (mk_photo(&im, DIM[i][0], DIM[i][1], 1, 0x99u + (uint32_t)i)) {
      enc_opt_t eo = { 70, JCS_GRAYSCALE, 0, 1, 0, 0, 0, 0, 0, JDCT_ISLOW };
      unsigned long sz; unsigned char *j = jenc(&im, &eo, &sz);
      if (j && sz) { dec_opt_t d = { JCS_GRAYSCALE,1,1,JDCT_ISLOW,1,0,0,0,0,0,0,0 }; jdec(j, sz, &d); }
      free(j); img_free(&im);
    }
  }
}

/* ============================ PHASE 8: malformed input ====================
 * Real decoders eat corrupt data constantly. This trains the error/recovery
 * branches WITHOUT letting them dominate (bounded iteration count).
 */
static void phase_robustness(void)
{
  printf("  [8] robustness (truncated / corrupted streams)\n");
  img_t im;
  if (!mk_photo(&im, 320, 240, 3, 0xBADu)) return;
  enc_opt_t eo = { 85, JCS_RGB, 0, 0, 0, 2, 2, 0, 0, JDCT_ISLOW };
  unsigned long sz = 0;
  unsigned char *j = jenc(&im, &eo, &sz);
  img_free(&im);
  if (!j || !sz) { free(j); return; }

  /* truncation at several points */
  for (int frac = 1; frac <= 8; frac++) {
    unsigned long n = sz * (unsigned long)frac / 9UL;
    if (n < 4) continue;
    dec_opt_t d = { JCS_RGB, 1, 1, JDCT_ISLOW, 1, 0, 0, 0, 0, 0, 0, 0 };
    jdec(j, n, &d);
  }
  /* bit corruption in the entropy-coded segment */
  {
    unsigned char *cp = (unsigned char *)malloc(sz);
    if (cp) {
      uint32_t s = 0x5A5Au;
      for (int t = 0; t < 24; t++) {
        memcpy(cp, j, sz);
        for (int k = 0; k < 6; k++) {
          unsigned long off = 200 + (xs32(&s) % (sz > 220 ? sz - 210 : 1));
          if (off < sz) cp[off] ^= (unsigned char)(1u << (xs32(&s) & 7));
        }
        dec_opt_t d = { JCS_RGB, 1, 1, JDCT_ISLOW, 1, 0, 0, 0, 0, 0, 0, 0 };
        jdec(cp, sz, &d);
      }
      free(cp);
    }
  }
  free(j);
}

/* ============================ PHASE 9: multithreaded ======================
 * Concurrent codec instances: exercises the allocator and per-instance state
 * exactly as a server/thumbnailer would. Modest thread count so the profile
 * is not dominated by scheduler noise.
 */
struct mt_arg { int id, loops; };
static void *mt_worker(void *p)
{
  struct mt_arg *a = (struct mt_arg *)p;
  img_t im;
  if (!mk_photo(&im, 480 + (a->id % 3) * 160, 360 + (a->id % 3) * 120, 3,
                0xE1E1u + (uint32_t)a->id))
    return NULL;
  for (int i = 0; i < a->loops; i++) {
    tjhandle c = tj3Init(TJINIT_COMPRESS);
    if (!c) break;
    tj3Set(c, TJPARAM_SUBSAMP, (i & 1) ? TJSAMP_420 : TJSAMP_444);
    tj3Set(c, TJPARAM_QUALITY, 75 + (a->id * 5 + i * 3) % 21);
    tj3Set(c, TJPARAM_PROGRESSIVE, (i % 3) == 0 ? 1 : 0);
    unsigned char *jb = NULL; size_t jsz = 0;
    if (tj3Compress8(c, im.data, im.w, 0, im.h, TJPF_RGB, &jb, &jsz) == 0 && jb && jsz) {
      tjhandle d = tj3Init(TJINIT_DECOMPRESS);
      if (d) {
        if (tj3DecompressHeader(d, jb, jsz) == 0) {
          uint8_t *db = (uint8_t *)malloc((size_t)im.w * im.h * 3);
          if (db) { tj3Decompress8(d, jb, jsz, db, 0, TJPF_RGB); free(db); }
        }
        tj3Destroy(d);
      }
    }
    tj3Free(jb);
    tj3Destroy(c);
  }
  img_free(&im);
  return NULL;
}

static void phase_mt(int nth, int loops)
{
  printf("  [9] multithreaded codec instances (%d threads)\n", nth);
  pthread_t *t = (pthread_t *)calloc((size_t)nth, sizeof(*t));
  struct mt_arg *a = (struct mt_arg *)calloc((size_t)nth, sizeof(*a));
  if (!t || !a) { free(t); free(a); return; }
  for (int i = 0; i < nth; i++) {
    a[i].id = i; a[i].loops = loops;
    if (pthread_create(&t[i], NULL, mt_worker, &a[i]) != 0) { a[i].loops = 0; t[i] = 0; }
  }
  for (int i = 0; i < nth; i++) if (t[i]) pthread_join(t[i], NULL);
  free(t); free(a);
}

/* ---------------------------------------------------------------- driver */

int main(int argc, char **argv)
{
  /* scale: 1 = quick (BOLT/instrumented runs), 2 = thorough */
  int scale = (argc > 1) ? atoi(argv[1]) : 1;
  if (scale < 1) scale = 1;
  if (scale > 4) scale = 4;

  setvbuf(stdout, NULL, _IOLBF, 0);
  printf("libjpeg-turbo training workload (scale=%d, JPEG_LIB_VERSION=%d)\n",
         scale, JPEG_LIB_VERSION);
  double t0 = now_sec();

  phase_mainstream(scale);          /* heaviest weight: real-world path      */
  phase_content(scale);
  phase_colorspaces(scale);
  phase_decoder_matrix(scale);
  phase_special_coding(scale);
  phase_turbojpeg(scale);
  phase_edges();                    /* cheap, once                           */
  phase_robustness();               /* cheap, once                           */
  phase_mt(4, 6 * scale);

  printf("workload complete in %.2fs\n", now_sec() - t0);
  fflush(stdout);
  return 0;
}
WORKLOAD_EOF
}
