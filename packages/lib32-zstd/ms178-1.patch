diff --git a/lib/compress/zstd_lazy.c b/lib/compress/zstd_lazy.c
--- a/lib/compress/zstd_lazy.c
+++ b/lib/compress/zstd_lazy.c
@@ -983,6 +983,22 @@
     return 1;
 }
 
+#if defined(ZSTD_ARCH_X86_AVX2)
+/* AVX2 specialization for a 64-entry row. The 16- and 32-entry cases keep
+ * using the existing SSE2 path; this removes four SSE2 compares and mask
+ * assembly from the 64-entry case without changing its bit layout. */
+FORCE_INLINE_TEMPLATE ZSTD_VecMask
+ZSTD_row_getAVX2Mask64(const BYTE* const src, const BYTE tag, const U32 head)
+{
+    const __m256i tagVector = _mm256_set1_epi8((char)tag);
+    const __m256i lowVector = _mm256_loadu_si256((const __m256i*)(const void*)src);
+    const __m256i highVector = _mm256_loadu_si256((const __m256i*)(const void*)(src + 32));
+    U64 const lowMask = (U32)_mm256_movemask_epi8(_mm256_cmpeq_epi8(lowVector, tagVector));
+    U64 const highMask = (U32)_mm256_movemask_epi8(_mm256_cmpeq_epi8(highVector, tagVector));
+    return ZSTD_rotateRight_U64((highMask << 32) | lowMask, head);
+}
+#endif
+
 #if defined(ZSTD_ARCH_X86_SSE2)
 FORCE_INLINE_TEMPLATE ZSTD_VecMask
 ZSTD_row_getSSEMask(int nbChunks, const BYTE* const src, const BYTE tag, const U32 head)
@@ -1103,6 +1119,11 @@
     assert(rowEntries <= ZSTD_ROW_HASH_MAX_ENTRIES);
     assert(ZSTD_row_matchMaskGroupWidth(rowEntries) * rowEntries <= sizeof(ZSTD_VecMask) * 8);
 
+#if defined(ZSTD_ARCH_X86_AVX2)
+    if (rowEntries == 64) {
+        return ZSTD_row_getAVX2Mask64(src, tag, headGrouped);
+    }
+#endif
 #if defined(ZSTD_ARCH_X86_SSE2)
 
     return ZSTD_row_getSSEMask(rowEntries / 16, src, tag, headGrouped);
