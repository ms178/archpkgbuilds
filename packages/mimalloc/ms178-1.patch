diff -ruN -x .git pristine-353/CMakeLists.txt opt-353/CMakeLists.txt
--- a/CMakeLists.txt	2026-09-23 14:09:17.003749655 +0000
+++ b/CMakeLists.txt	2026-09-23 16:27:45.050478902 +0000
@@ -290,6 +290,15 @@
     list(APPEND mi_cflags -Wall)
 endif()
 
+# NEW_DISCOVERY (layout stabilization): pin function/loop placement. LTO otherwise places
+# hot entries at arbitrary offsets; that alone moved tight-loop microbenchmarks by up to
+# ±35% between instruction-identical builds (validated with paired A/A noise floors and
+# no-LTO asm equality). Pinned placement makes performance reproducible across builds and
+# removed the residual calloc-path placement penalty (see REPORT §3.5/§4).
+if(CMAKE_C_COMPILER_ID MATCHES "AppleClang|Clang|GNU" AND NOT MSVC)
+  list(APPEND mi_cflags -falign-functions=64 -falign-loops=32)
+endif()
+
 if(CMAKE_CXX_COMPILER_ID MATCHES "AppleClang|Clang")
   list(APPEND mi_cflags -Wno-deprecated)
 endif()
