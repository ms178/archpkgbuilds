+/*
+ * EGL native fence sync is a display-level property, so its answer never
+ * changes for the lifetime of the process. Both fence entry points run once
+ * per present, so cache it rather than re-walking the EGL extension string
+ * every frame. The cache stays below zero until probed, so a driver that
+ * genuinely lacks the extension has its "no" remembered too.
+ */
+static int egl_fence_sync_supported = -1;
