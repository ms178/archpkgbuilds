index ecc6bcc..4cf0b2f 100644
--- a/os/osdep.h
+++ b/os/osdep.h
@@ -67,11 +67,13 @@ SOFTWARE.
  * systems are broken and return EWOULDBLOCK when they should return EAGAIN
  */
 #ifndef WIN32
-# if (EAGAIN != EWOULDBLOCK)
-#  define ETEST(err) (err == EAGAIN || err == EWOULDBLOCK)
-# else
-#  define ETEST(err) (err == EAGAIN)
-# endif
+/* EAGAIN and EWOULDBLOCK are plain enum constants on Linux (they come from
+ * <asm-generic/errno.h>, not from a #define), so the old `# if (EAGAIN !=
+ * EWOULDBLOCK)` was decided by the preprocessor with both names replaced by
+ * 0 -- it always took the #else branch, and -Wundef said so. Decide it in C
+ * instead; both operands are compile-time constants, so the comparison
+ * folds away and a platform where they differ still tests both. */
+# define ETEST(err) ((err) == EAGAIN || (err) == EWOULDBLOCK)
 #else   /* WIN32 The socket errorcodes differ from the normal errors */
 #define ETEST(err) (err == EAGAIN || err == WSAEWOULDBLOCK)
 #endif
