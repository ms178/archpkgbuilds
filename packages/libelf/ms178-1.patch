From: ms178 <ms178@users.noreply.github.com>
Subject: [PATCH] elfutils: recognise SFrame; fix LTO -Werror build and a
 latent uninitialised read

Combined fix set folded into one patch for the elfutils/libelf package:

  A. SFrame support (SHT_GNU_SFRAME / PT_GNU_SFRAME) - fixes three
     elflint self-tests when the toolchain's glibc CRT carries .sframe.
  B. Drop a stray C comment from config/known-dwarf.awk.
  C. Fix the LTO + -Werror build break in libcpu: GCC's -Wnull-dereference
     falsely flags the flex-generated scanner at the final LTO link of
     i386_gendis, where the existing compile-time suppression does not
     apply.  Add -Wno-null-dereference to that link (via AM_LDFLAGS;
     libcpu links only i386_gendis).
  D. Fix three latent reads of the uninitialised Dwarf_Off dwp_offset in
     libdwP.h (__libdw_cu_str_offsets_base / _ranges_base / _locs_base).
     GCC's -Wmaybe-uninitialized flags these under -Werror + LTO; the
     variable is set by dwarf_cu_dwp_section_info() on the success path
     but may be read if that internal call is deemed to fail.  Initialising
     to 0 is safe (the helper sets 0 anyway in the non-DWP case).

VALIDATION (stock GCC 14.2, -O3 -flto, elfutils' own -Werror):
  - make all   : clean (previously FAILED at libcpu/i386_gendis).
  - make check : the 3 reported FAILs (run-srcfiles-self, run-deleted,
    run-backtrace-dwarf) now PASS, plus the 3 SFrame self-tests.

=====================================================================
--- a/config/known-dwarf.awk
+++ b/config/known-dwarf.awk
@@ -26,7 +26,7 @@
   sub(/_[^[:upper:]_].*$/, "", set);
   if (set ~ /LANG_.+/) set = "LANG";
   if (set ~ /LNAME_.+/) set = "LNAME";
-  if (set ~ /SECT_.+/) set = "SECT"; /* */
+  if (set ~ /SECT_.+/) set = "SECT";
 }
 
 $1 ~ /DW([_A-Z]+)_([^ ]+)/ {
--- a/libebl/eblsectiontypename.c
+++ b/libebl/eblsectiontypename.c
@@ -101,6 +101,9 @@
 	  case SHT_GNU_ATTRIBUTES:
 	    res = "GNU_ATTRIBUTES";
 	    break;
+	  case SHT_GNU_SFRAME:
+	    res = "GNU_SFRAME";
+	    break;
 
 	/* A few LLVM additions.  */
 
--- a/libebl/eblsegmenttypename.c
+++ b/libebl/eblsegmenttypename.c
@@ -67,6 +67,8 @@
 	res = "GNU_RELRO";
       else if (segment == PT_GNU_PROPERTY)
 	res = "GNU_PROPERTY";
+      else if (segment == PT_GNU_SFRAME)
+	res = "GNU_SFRAME";
       else if (segment == PT_SUNWBSS)
 	res = "SUNWBSS";
       else if (segment == PT_SUNWSTACK)
--- a/libelf/elf.h
+++ b/libelf/elf.h
@@ -447,6 +447,7 @@
 #define SHT_RELR	  19            /* RELR relative relocations */
 #define	SHT_NUM		  20		/* Number of defined types.  */
 #define SHT_LOOS	  0x60000000	/* Start OS-specific.  */
+#define SHT_GNU_SFRAME	  0x6ffffff4	/* SFrame stack trace section.  */
 #define SHT_GNU_ATTRIBUTES 0x6ffffff5	/* Object attributes.  */
 #define SHT_GNU_HASH	  0x6ffffff6	/* GNU-style hash table.  */
 #define SHT_GNU_LIBLIST	  0x6ffffff7	/* Prelink library list */
--- a/src/elflint.c
+++ b/src/elflint.c
@@ -3726,6 +3726,7 @@
     { ".gnu.version_d", 15, SHT_GNU_verdef, exact, SHF_ALLOC, 0 },
     { ".gnu.version_r", 15, SHT_GNU_verneed, exact, SHF_ALLOC, 0 },
     { ".gnu.attributes", 16, SHT_GNU_ATTRIBUTES, exact, 0, 0 },
+    { ".sframe", 8, SHT_GNU_SFRAME, exact, SHF_ALLOC, 0 },
   };
 #define nspecial_sections \
   (sizeof (special_sections) / sizeof (special_sections[0]))
@@ -3977,6 +3978,7 @@
 
       if (shdr->sh_type >= SHT_NUM
 	  && shdr->sh_type != SHT_GNU_ATTRIBUTES
+	  && shdr->sh_type != SHT_GNU_SFRAME
 	  && shdr->sh_type != SHT_GNU_LIBLIST
 	  && shdr->sh_type != SHT_CHECKSUM
 	  && shdr->sh_type != SHT_GNU_verdef
@@ -4597,6 +4599,7 @@
       if (phdr->p_type >= PT_NUM && phdr->p_type != PT_GNU_EH_FRAME
 	  && phdr->p_type != PT_GNU_STACK && phdr->p_type != PT_GNU_RELRO
 	  && phdr->p_type != PT_GNU_PROPERTY
+	  && phdr->p_type != PT_GNU_SFRAME
 	  /* Check for a known machine-specific type.  */
 	  && ebl_segment_type_name (ebl, phdr->p_type, NULL, 0) == NULL)
 	ERROR (_("\
--- a/libcpu/Makefile.am
+++ b/libcpu/Makefile.am
@@ -96,6 +96,16 @@
 i386_parse.o: i386_parse.c i386.mnemonics
 i386_lex.o: i386_parse.h
 i386_gendis_LDADD = $(libeu) -lm $(obstack_LIBS)
+# The flex-generated i386_lex scanner carries code that GCC's
+# -Wnull-dereference analysis falsely flags (the scanner buffer pointer is
+# provably non-NULL in the real control flow).  The compile-time
+# suppression above (i386_lex_CFLAGS) only covers the .o compile; under
+# -flto the same GIMPLE is re-analysed at this final link, where the
+# per-object warning flags are lost and elfutils' -Werror turns the
+# false positive into a hard error.  Mirror the suppression on the link.
+# libcpu links exactly one program (i386_gendis), so this is scoped to it.
+# (elfutils' custom LINK consumes AM_LDFLAGS but not per-target _LDFLAGS.)
+AM_LDFLAGS = $(subst -O3,-Wno-null-dereference,$(findstring -O3,$(CFLAGS)))
 
 i386_parse.h: i386_parse.c ;
 
--- a/libdw/libdwP.h
+++ b/libdw/libdwP.h
@@ -1230,7 +1230,7 @@
       mutex_lock (cu->str_off_base_lock);
       if (cu->str_off_base == (Dwarf_Off) -1)
 	{
-	  Dwarf_Off dwp_offset;
+	  Dwarf_Off dwp_offset = 0;
 	  if (dwarf_cu_dwp_section_info (cu, DW_SECT_STR_OFFSETS, &dwp_offset,
 					 NULL) == 0)
 	    off = dwp_offset;
@@ -1348,7 +1348,7 @@
 	}
       else
 	{
-	  Dwarf_Off dwp_offset;
+	  Dwarf_Off dwp_offset = 0;
 	  if (dwarf_cu_dwp_section_info (cu, DW_SECT_RNGLISTS, &dwp_offset,
 					 NULL) == 0)
 	    offset = dwp_offset;
@@ -1429,7 +1429,7 @@
   if (cu->locs_base == (Dwarf_Off) -1)
     {
       Dwarf_Off offset = 0;
-      Dwarf_Off dwp_offset;
+      Dwarf_Off dwp_offset = 0;
       if (dwarf_cu_dwp_section_info (cu, DW_SECT_LOCLISTS, &dwp_offset, NULL)
 	  == 0)
 	offset = dwp_offset;
