   if (set ~ /LANG_.+/) set = "LANG";
   if (set ~ /LNAME_.+/) set = "LNAME";
-  if (set ~ /SECT_.+/) set = "SECT"; /* */
+  if (set ~ /SECT_.+/) set = "SECT";
