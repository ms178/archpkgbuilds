  perl-parse-yapp
  pkg-config
  popt
  python
  readline
  rpcsvc-proto
  systemd
  talloc
  tdb
  tevent
)
source=(
  "https://download.samba.org/samba/ftp/stable/${pkgbase}-${pkgver}.tar.gz"
  "https://download.samba.org/samba/ftp/stable/${pkgbase}-${pkgver}.tar.asc"
  samba.logrotate
  samba.pam
  samba.tmpfiles
)
