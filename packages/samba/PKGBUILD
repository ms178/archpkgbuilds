# Focused desktop/file-server build:
# - SMB2/SMB3 server, client tools, ADS member support and winbind
# - io_uring, Windows ACL/streams, macOS fruit/catia and snapshot/Btrfs VFS
# - no AD domain controller, SMB1 server, GlusterFS, CephFS or Spotlight
# - three-stage GCC PGO (instrument -> train -> PGO+LTO rebuild)

pkgbase=samba
pkgname=(libwbclient ldb smbclient samba)
pkgver=4.24.5
pkgrel=3.1
epoch=2
arch=(x86_64)
url='https://www.samba.org'
license=('GPL-3.0-or-later')
# LTO is applied only to the final PGO build; !lto keeps the instrumented
# stage free of makepkg's global LTO injection.
options=('!lto' '!debug')
makedepends=(
  acl
  avahi
  dbus
  docbook-xsl
  gnutls
  icu
  jansson
  krb5
  libarchive
  libbsd
