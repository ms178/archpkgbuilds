+/*
+ * Linux-PAM deprecated _pam_overwrite() and _pam_drop_reply() because
+ * their ordinary stores can be optimized away.  Samba's BURN_STR() uses
+ * memset_explicit(), so credentials are reliably erased before release.
+ */
+static void pam_winbind_drop_reply(struct pam_response *reply, int replies)
+{
+	int i;
+
+	if (reply == NULL) {
+		return;
+	}
+
+	for (i = 0; i < replies; i++) {
+		BURN_STR(reply[i].resp);
+		SAFE_FREE(reply[i].resp);
+	}
+	free(reply);
+}
