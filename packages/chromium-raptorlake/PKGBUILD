# Personal/local build: no Google API keys baked in (sign-in/sync disabled),
# matching the RobRich build (google_api_key="no").
_google_api_key=no

# Reject context drift before changing a file. GNU patch's exit status alone
# does not reject offsets; inspect both the dry run and actual application.
# ── Cross-language ThinLTO probe (rustc <-> clang/lld) ──────────────────────
# LLVM's alias-scope *domain* metadata changed format inside the 24 series:
#   LLVM <= 22  : domain = distinct !{!self}            or {!self, !"name"}
#                 Verifier: "domain must have one or two operands"
#   LLVM >= 24  : domain = distinct !{!self, i1, !"name"}
#                 Verifier: "domain must have two or three operands"
# A rustc and a clang from different sides of that change cannot share ThinLTO
# bitcode: the newer side emits a domain the older side's verifier rejects, and
# the build dies mid-link with "LLVM ERROR: Broken module found". Version
# *strings* do not capture this (both can say "24"), so we measure it: build a
# tiny rust staticlib as bitcode and link it with a tiny C++ TU through lld.
#   0 = compatible (full cross-language LTO is safe -> fastest build)
#   2 = rustc failed, 3 = c++ failed, 4 = LTO link failed (any -> incompatible)
_rust_cxx_lto_probe() {
  local _dir=$1 _rustc=$2 _cxx=$3 rc
  rm -rf "$_dir"
  mkdir -p "$_dir" || return 1
  cat > "$_dir/lib.rs" <<'RUSTEOF'
#[no_mangle]
pub extern "C" fn probe_sum(n: i32) -> i32 {
    let v: Vec<i32> = (0..n).collect();
    v.iter().sum()
}
RUSTEOF
  cat > "$_dir/main.cc" <<'CCEOF'
extern "C" int probe_sum(int);
int main() { return probe_sum(4) == 6 ? 0 : 1; }
CCEOF
  (
    cd "$_dir" || exit 1
    "$_rustc" --edition 2021 -C opt-level=3 -C lto=thin -C linker-plugin-lto \
      --crate-type=staticlib --crate-name raptorlake_ltoprobe lib.rs \
      -o libraptorlake_ltoprobe.a >rustc.log 2>&1 || exit 2
    # rustc tags its objects x86_64-unknown-linux-gnu; match it so llvm's
    # "linking two modules of different target triples" warning stays silent.
    "$_cxx" -O3 -flto=thin -std=c++17 --target=x86_64-unknown-linux-gnu \
      -c main.cc -o main.o >cc.log 2>&1 || exit 3
    "$_cxx" -flto=thin -fuse-ld=lld --target=x86_64-unknown-linux-gnu \
      main.o libraptorlake_ltoprobe.a -o raptorlake_ltoprobe \
      -lpthread -ldl >link.log 2>&1 || exit 4
    ./raptorlake_ltoprobe >run.log 2>&1 || exit 5
    # rustc packs std's bitcode into the staticlib (~50 MB); the binary has
    # already proven the point, so do not leave that behind.
    rm -f libraptorlake_ltoprobe.a main.o
  )
  rc=$?
  return $rc
}

_apply_patch_strict() {
  local _patch=$1 _log
  _log=$(mktemp "$srcdir/.patch-check.XXXXXX") || return 1
  if ! LC_ALL=C patch --batch --forward --fuzz=0 --no-backup-if-mismatch \
      --dry-run -Np1 -i "$_patch" >"$_log" 2>&1 ||
      grep -Eiq 'offset|fuzz|FAILED|reject|malformed|Reversed|Skipping' "$_log"; then
    cat "$_log"
    rm -f "$_log"
    error "Patch is not an exact match: $_patch"
    return 1
  fi
  if ! LC_ALL=C patch --batch --forward --fuzz=0 --no-backup-if-mismatch \
      -Np1 -i "$_patch" >"$_log" 2>&1 ||
      grep -Eiq 'offset|fuzz|FAILED|reject|malformed|Reversed|Skipping' "$_log"; then
    cat "$_log"
    rm -f "$_log"
    error "Strict patch application failed: $_patch"
    return 1
  fi
  cat "$_log"
  rm -f "$_log"
}

prepare() {
  cd "$srcdir/chromium-$pkgver"

  msg2 "Applying Raptor Lake performance patch (RobRich999 AVX2 -> raptorlake, data-tuned)..."
  _apply_patch_strict "$srcdir/linux64-raptorlake.patch" || return 1

  msg2 "Applying adopted upstream/distro fixes + log-spam cleanup..."
  # Curated set of source fixes (see chromium-raptorlake-fixes.patch):
  #   * sandbox/.../linux_seccomp.h         : +#include <signal.h>  (Arch chromium-145-fix-SYS_SECCOMP;
  #                                           SIGSYS/seccomp header drift -> avoids a sandbox build break)
  #   * media/gpu/sandbox/...hook_linux.cc  : +#include "base/logging.h" (Arch chromium-149; LOG() in a
  #                                           VA-API sandbox hook -> avoids use-of-undeclared-identifier)
  #   * services/device/serial/..._posix.cc : select legacy encoded __Bxxxx constants when available.
  #                                           glibc >= 2.42 made Bxxxx numeric, but Chromium writes the
  #                                           result directly into termios2.c_cflag, which requires the
  #                                           kernel encoding. Older glibc/musl/macOS fall back to Bxxxx.
  #   * chrome/browser/resources/glic/.../parse.py : replace Python 3.14-deprecated codecs.open()
  #                                           with built-in open(..., encoding='utf-8', newline='') and remove the
  #                                           now-unused codecs import. Semantics and generated JSON are
  #                                           preserved while eliminating the build-time warning.
  #   * (159) media/gpu/.../hardware_video_decoding_sandbox_hook_linux.cc :
  #                                           the v5 #include "base/logging.h" fix is DROPPED --
  #                                           upstream 159 already adds it, so the hunk would
  #                                           only conflict (patch reports "previously applied").
  #   * (159) build/rust/crubit/BUILD.gn     : rebased onto 159's new import set
  #                                           (c++/c++.gni + rust_api_from_cpp/rust_static_library)
  #                                           plus the import("//build/config/rust.gni") that
  #                                           components/cbor/BUILD.gn relies on.
#   * components/viz/.../display.cc       : demote the sub-millisecond "Frame latency is negative"
  #                                           LOG(ERROR) clock-jitter spam to a >1ms DLOG(WARNING).
  #   * ui/gfx/geometry/matrix44.cc         : MapVector4 column-load + FMA (no transpose/hadd);
  #                                           ~7x RThroughput on raptorlake (llvm-mca verified).
  #   * base/strings/string_util_impl_helpers.h : ToLower/UpperASCIIImpl resize()+indexed write
  #                                           instead of push_back -> vectorizes the ASCII fold
  #                                           (~1.6x char / ~4.5x char16, byte-identical; very hot path).
  #   * build/rust/gni_impl/run_bindgen.py  : point rustfmt at a stable-only --config-path so it
  #                                           stops discovering //.rustfmt.toml's nightly-only keys
  #                                           (wrap_comments/ignore) under STABLE rustfmt. Removes two
  #                                           "unstable features ... nightly channel" warnings per
  #                                           bindgen target; output byte-identical (verified).
  #   * google_apis/gcm/engine/registration_request.{h,cc} : the GCM server returns
  #                                           Error=DEPRECATED_ENDPOINT for retired endpoints.
  #                                           Upstream has no branch -> UNKNOWN_ERROR -> RETRYABLE ->
  #                                           infinite retry+re-register loop, one LOG(ERROR) each
  #                                           time (the registration_request.cc:291 spam). We add it
  #                                           as a first-class TERMINAL, non-retryable status and log
  #                                           it once at WARNING. Stops the loop, the wakeups and the
  #                                           spam. (enums.xml is UMA metadata, not a build input,
  #                                           so it's intentionally not touched for a local build.)
  #   * Rust CBOR / Crubit guards: retained from the local 153 patchset.
  #     These guards are not a complete system-Rust compatibility layer for 155.
  #     New unconditional bindings in fonts, signed web bundles and private
  #     verification tokens require the pinned Rust/Crubit bundle below. With
  #     that bundle the normal Crubit/CBOR dependencies remain enabled.
  #   * base/message_loop/message_pump_glib.h : guard g_main_context_pop_thread_default() so it only
  #                                           pops when our context is the current thread-default.
  #                                           On shutdown the pump can be torn down after GLib already
  #                                           unwound the thread-default stack, making an unconditional
  #                                           pop emit "assertion 'stack != NULL'" (a GLib CRITICAL
  #                                           that content forwards to LOG(ERROR), browser_main_loop.cc
  #                                           :273). unref() still always runs -> no leak.
  _apply_patch_strict "$srcdir/chromium-raptorlake-fixes.patch" || return 1

  msg2 "Separating bindgen executable and libclang paths (custom LLVM toolchain)..."
  _apply_patch_strict "$srcdir/chromium-bindgen-custom-libclang.patch" || return 1

  msg2 "Fixing vendored bytemuck for Rust >= 1.95 (core::simd::LaneCount bound)..."
  # bytemuck v1.25's portable_simd impls carry a `where core::simd::LaneCount<N>:
  # core::simd::SupportedLaneCount` bound. In Rust >= 1.95 that bound no longer
  # resolves in this position, so rustc aborts with E0405/E0425. bytemuck ships
  # two cfg-gated variants selected by rustversion (before/since 2026-01-27); the
  # `before` variant still has the broken bound and is what a 1.96 rustc built
  # before that date selects. We drop the offending bound line from the vendored
  # sources (matches Arch's chromium-rust-bytemuck patch). Only the buggy bound
  # line is removed; the `T: SimdElement + Pod/Zeroable` bound and the fixed
  # `since` variant are left intact, so it's correct regardless of which variant
  # rustversion picks. Idempotent + fails loud if the vendored layout changes.
  python3 - <<'PYEOF'
import sys, os
files = [
    "third_party/rust/chromium_crates_io/vendor/bytemuck-v1/src/pod.rs",
    "third_party/rust/chromium_crates_io/vendor/bytemuck-v1/src/zeroable.rs",
]
needle = "  core::simd::LaneCount<N>: core::simd::SupportedLaneCount,\n"
touched = 0
for p in files:
    if not os.path.exists(p):
        sys.exit(f"bytemuck fix: expected file missing: {p} "
                 "(vendored layout changed; update the PKGBUILD).")
    s = open(p).read()
    n = s.count(needle)
    if n == 0:
        # Already fixed upstream / different version -> nothing to do.
        print(f"  {os.path.basename(p)}: no LaneCount bound (skip)")
        continue
    s = s.replace(needle, "")          # drop ALL occurrences of the broken bound
    open(p, "w").write(s)
    touched += 1
    print(f"  {os.path.basename(p)}: removed {n} LaneCount/SupportedLaneCount bound(s)")
if touched == 0:
    print("  bytemuck: nothing to patch (already compatible)")
PYEOF

  msg2 "Allow building against system libraries in official builds..."
  sed -i 's/OFFICIAL_BUILD/GOOGLE_CHROME_BUILD/' \
    tools/generate_shim_headers/generate_shim_headers.py

  # https://crbug.com/893950
  sed -i -e 's/\<xmlMalloc\>/malloc/' -e 's/\<xmlFree\>/free/' \
         -e '1i #include <cstdlib>' \
    third_party/blink/renderer/core/xml/*.cc \
    third_party/blink/renderer/core/xml/parser/xml_document_parser.cc \
    third_party/libxml/chromium/*.cc 2>/dev/null || true

  msg2 "Removing the strict NodeJS version check (system node is API-compatible)..."
  # Chromium pins an EXACT node version and asserts on it via
  # //third_party/node:check_version (check_version.js). Your CachyOS node
  # (v26) != the pinned version, so the build aborts with
  #   ERR_ASSERTION: Failed NodeJS version check: Expected 'vX', found 'vY'.
  # This is a gclient footgun-guard, irrelevant when a distro provides a
  # compatible node. The canonical Arch/Gentoo fix removes the check_version
  # *dependency* from the two .gni files that inject it, so it never runs.
  # (Version-agnostic: no spoofing, survives future node bumps.) We also blank
  # check_version.js as defense-in-depth in case a new caller re-adds the dep.
  python3 - <<'PYEOF'
import sys

# 1) node.gni: drop the auto-added ":check_version" dependency block.
p = "third_party/node/node.gni"
s = open(p).read()
if "chromium-raptorlake" not in s:
    anchor = (
        '    # Automatically add a dependency to ":check_version" to ensure NodeJS is\n'
        '    # always running the expected version, except when the \':check_version\'\n'
        '    # target itself is running in which case it shouldn\'t depend on itself.\n'
        '    if (get_label_info(":" + target_name, "label_no_toolchain") !=\n'
        '        "//third_party/node:check_version") {\n'
        '      if (!defined(deps)) {\n'
        '        deps = []\n'
        '      }\n'
        '      deps += [ "//third_party/node:check_version" ]\n'
        '    }\n'
    )
    if anchor not in s:
        sys.exit("node.gni: check_version block anchor not found "
                 "(upstream changed); update the NodeJS-check removal in the PKGBUILD.")
    s = s.replace(
        anchor,
        "    # chromium-raptorlake: NodeJS version check removed (system node is fine)\n",
        1)
    open(p, "w").write(s)
    print("  node.gni: check_version dependency removed")

# 2) proto_library.gni: drop its explicit ":check_version" dep line.
p = "third_party/protobuf/proto_library.gni"
s = open(p).read()
needle = '      deps += [ "//third_party/node:check_version" ]\n'
if needle in s:
    s = s.replace(needle, "", 1)
    open(p, "w").write(s)
    print("  proto_library.gni: check_version dependency removed")

# 3) Defense-in-depth: make check_version.js a no-op so it can never assert.
p = "third_party/node/check_version.js"
open(p, "w").write(
    "// chromium-raptorlake: NodeJS version check disabled (system node is "
    "API-compatible).\nprocess.exit(0);\n")
print("  check_version.js neutralized")
PYEOF

  msg2 "Linking system/host build tools into the paths Chromium expects..."
  # Chromium/Dawn hard-code paths to gclient-managed host tools (node, java,
  # rustc, gperf, go, ...). The official source tarball does NOT ship them, so
  # downstream must provide compatible system copies at those exact paths. This
  # table maps "Chromium-expected path" -> "system tool name". Each tool is
  # resolved with `command -v` and we FAIL LOUDLY if it's missing, so a missing
  # host tool aborts in prepare() with a clear message instead of thousands of
  # targets into the compile. Add new entries here if a future build step needs
  # another bundled tool.
  local -A _host_tools=(
    [third_party/node/linux/node-linux-x64/bin/node]=node
    [third_party/jdk/current/bin/java]=java
    [third_party/gperf/cipd/bin/gperf]=gperf
    # Dawn's tint code generator runs `go run` from this bundled path.
    [third_party/dawn/tools/golang/linux-amd64/bin/go]=go
  )
  local _dest _tool _src
  for _dest in "${!_host_tools[@]}"; do
    _tool=${_host_tools[$_dest]}
    _src=$(command -v "$_tool") \
      || error "required host tool '$_tool' not found on PATH (install it; see makedepends)."
    install -d "$(dirname "$_dest")"
    ln -sfv "$_src" "$_dest"
  done

  msg2 "Installing Chromium-pinned Rust/Crubit (required by Chromium 159)..."
  # Font parsing, signed web bundles and private verification tokens now have
  # unconditional cpp_api_from_rust dependencies. System Rust without Chromium's
  # matching Crubit is no longer sufficient; do not disable browser features to
  # hide unresolved GN targets. This does not replace the custom C/C++ LLVM.
  python3 tools/rust/update_rust.py || return 1
  python3 tools/rust/update_rust.py --print-revision validate || return 1

  if (( _pgo_phase == 2 )); then
    msg2 "Fetching UPSTREAM PGO profile (linux) from the official bucket..."
    # chrome/build/linux.pgo.txt holds the exact profile filename that matches
    # THIS Chromium revision. GN's pgo config expects the profile to live in
    # chrome/build/pgo_profiles/<name>. We download it directly over public
    # HTTPS instead of via tools/update_pgo_profiles.py, because that script
    # needs third_party/depot_tools + gsutil, which the official *-lite.tar.xz
    # does not ship. The public bucket serves the file over plain HTTPS.
    local _pgo_name _pgo_dir _pgo_file _gs
    _pgo_name=$(tr -d '[:space:]' < chrome/build/linux.pgo.txt)
    [[ -n $_pgo_name ]] || error "could not read chrome/build/linux.pgo.txt"
    _pgo_dir="$PWD/chrome/build/pgo_profiles"
    _pgo_file="$_pgo_dir/$_pgo_name"
    mkdir -p "$_pgo_dir"
    _gs="https://storage.googleapis.com/chromium-optimization-profiles/pgo_profiles/$_pgo_name"
    if [[ ! -f $_pgo_file || $(stat -c%s "$_pgo_file") -le 1000000 ]]; then
      msg2 "  downloading $_pgo_name ..."
      # -C - lets a retried makepkg resume a partial download.
      curl -fL --retry 3 --retry-delay 2 -C - -o "$_pgo_file" "$_gs" \
        || error "failed to download upstream PGO profile from $_gs"
    fi
    # Sanity: it must be a real LLVM profile (magic) and non-trivial in size.
    [[ $(stat -c%s "$_pgo_file") -gt 1000000 ]] \
      || error "downloaded PGO profile looks too small: $_pgo_file"
    echo "$_pgo_file" > "$srcdir/.pgo_data_path"
    msg2 "PGO profile ready: $_pgo_file"
  fi

  msg2 "Generating missing Dawn commit-hash header..."
  # The official tarball is NOT a git/jj checkout, so build/util/lastchange.py's
  # GetVersion() returns None and main() then crashes with:
  #   AttributeError: 'NoneType' object has no attribute 'revision'
  # (older M-versions silently fell back to a 0.0.0 dummy; M151 does not on this
  # code path). lastchange.py has an OFFICIAL no-VCS escape hatch: if
  # BASE_COMMIT_SUBMISSION_MS is set it uses GetVersionInfoFromEnv() and reads
  # the hash from BASE_COMMIT_HASH instead of touching git. We feed it the REAL
  # Dawn revision pinned in the tarball's own DEPS, so the generated header
  # carries the correct hash (used for Dawn/WebGPU cache keying & about:gpu),
  # not a meaningless zero. If DEPS can't be parsed for any reason we fall back
  # to the upstream all-zero dummy (same value as build/util/LASTCHANGE.dummy)
  # so the build still completes.
  local _dawn_rev
  _dawn_rev=$(sed -nE "s/.*'dawn_revision'[[:space:]]*:[[:space:]]*'([0-9a-f]{40})'.*/\1/p" DEPS | head -1)
  if [[ -z $_dawn_rev ]]; then
    warning "Could not parse dawn_revision from DEPS; using all-zero dummy hash."
    _dawn_rev=0000000000000000000000000000000000000000
  fi
  BASE_COMMIT_HASH="$_dawn_rev" BASE_COMMIT_SUBMISSION_MS=0 \
  python3 build/util/lastchange.py -m DAWN_COMMIT_HASH \
    -s third_party/dawn --revision gpu/webgpu/DAWN_VERSION \
    --header gpu/webgpu/dawn_commit_hash.h
  msg2 "Dawn commit hash: $_dawn_rev"

  # ── Build the version-matched GN from the tarball's own sources ────────────
  # WHY: Chromium 159 pins a very recent gn (DEPS: gn_version git_revision).
  # That gn introduced the `public_inputs`
  # target variable on 2026-07-07. //third_party/devtools-frontend's copy.gni
  # sets `public_inputs = filter_include(sources, ["*.ts"])` inside a
  # node_action(); on any OLDER gn (e.g. Arch's system `gn`/generate-ninja) that
  # variable is unknown, so gn's strict unused-variable check aborts `gn gen`
  # with:  "ERROR ... Assignment had no effect ... public_inputs".
  #
  # Rather than depend on whatever `gn` the distro ships (a moving target that
  # WILL keep breaking as Chromium bumps its gn pin), we want the EXACT gn that
  # matches this tree. The -lite tarball ships BOTH candidates:
  #   * buildtools/linux64/gn  -- the pinned, prebuilt host binary (fast path).
  #   * tools/gn/build/gen.py  -- the sources, for a from-source bootstrap.
  # The prebuilt binary wins by default: it is the same gn Chromium's own bots
  # use, so `gn gen` and every later regeneration stay version-matched at zero
  # build cost. (v5 always recompiled gn from tools/gn -- ~10 minutes of pure
  # overhead on a 2-core box for a binary that was already inside the tarball.)
  # With _force_bootstrap_gn=1, or when the prebuilt is missing, we fall back to
  # a git-free from-source build: bootstrap/bootstrap.py wants a
  # last_commit_position.h the -lite tarball does not ship, so we invoke
  # tools/gn/build/gen.py directly -- its GenerateLastCommitPosition() has a
  # documented no-VCS fallback (num=0, id="UNKNOWN") when there is no .git.
  # gen.py honours CC/CXX/AR from the environment, which build() sets to the
  # llvm-ultimate clang; but prepare() runs before that, so we detect clang here
  # too and keep the whole gn build inside a scoped subshell so none of its env
  # leaks into the rest of prepare().
  local _gn_dir=""
  if (( ! _force_bootstrap_gn )) && [[ -x buildtools/linux64/gn ]]; then
    msg2 "Using the tarball's version-matched prebuilt gn..."
    _gn_dir="$PWD/buildtools/linux64"
    msg2 "prebuilt gn version: $(buildtools/linux64/gn --version)"
  else
    msg2 "Bootstrapping version-matched gn (tarball tools/gn, git-free)..."
    [[ -f tools/gn/build/gen.py ]] || error "tools/gn/build/gen.py missing from tarball; cannot bootstrap gn."
    (
      set -e
      local _cc _cxx _base
      _cc=$(command -v clang)   || error "clang not found on PATH (export your llvm-ultimate bin dir)"
      _cxx=$(command -v clang++) || error "clang++ not found on PATH"
      _base=$(dirname "$(dirname "$(realpath "$_cc")")")
      export CC="$_cc" CXX="$_cxx"
      export AR="$_base/bin/llvm-ar"; [[ -x $AR ]] || export AR=ar
      # gen.py + ninja build gn into tools/gn/out/. Keep it self-contained there.
      python3 tools/gn/build/gen.py --out-path=tools/gn/out
      ninja -j "${_jobs:-$(nproc)}" -C tools/gn/out gn
    ) || error "gn bootstrap failed."
    [[ -x tools/gn/out/gn ]] || error "gn bootstrap produced no binary at tools/gn/out/gn."
    _gn_dir="$PWD/tools/gn/out"
    msg2 "Bootstrapped gn version: $("$_gn_dir/gn" --version)"
  fi
  printf '%s\n' "$_gn_dir" > "$srcdir/.gn_dir"
}

build() {
  msg2 "Building chromium-launcher..."
  make -C "$srcdir/chromium-launcher-$_launcher_ver"

  cd "$srcdir/chromium-$pkgver"

  # ── Use the custom llvm-ultimate toolchain that is first on PATH ───────────
  local _clang _clangxx _clang_base _clang_version
  _clang=$(command -v clang)   || error "clang not found on PATH (export your llvm-ultimate bin dir)"
  _clangxx=$(command -v clang++)
  # clang_base_path is the dir CONTAINING bin/clang (i.e. the prefix).
  _clang_base=$(dirname "$(dirname "$(realpath "$_clang")")")
  _clang_version=$("$_clang" --version | sed -nE 's/.*clang version ([0-9]+).*/\1/p' | head -1)
  # rust-bindgen loads libclang dynamically. Require the matching C API library
  # from llvm-ultimate rather than silently falling back to the distro LLVM.
  [[ -e $_clang_base/lib/libclang.so ]] || {
    error "matching libclang missing: $_clang_base/lib/libclang.so"
    return 1
  }
  export CC="$_clang"
  export CXX="$_clangxx"
  export AR="$_clang_base/bin/llvm-ar"
  export NM="$_clang_base/bin/llvm-nm"
  [[ -x $AR ]] || export AR=ar
  [[ -x $NM ]] || export NM=nm
  # Allow stable rustc to accept the nightly -Z flags Chromium/RobRich use.
  export RUSTC_BOOTSTRAP=1

  msg2 "Using clang prefix: $_clang_base  (LLVM major $_clang_version)"

  # ── compiler-rt layout reconciliation (auto-detected) ─────────────────────
  # Chromium's build/config/clang/BUILD.gn hard-codes the clang runtime path in
  # the "per-target runtime dir" layout:
  #     <resource-dir>/lib/<triple>/libclang_rt.builtins.a
  # That is what an upstream LLVM built with LLVM_ENABLE_RUNTIMES=compiler-rt
  # produces (PER_TARGET_RUNTIME_DIR defaults ON) -- i.e. exactly what your
  # llvm-ultimate emits, so NO change is needed there. But the CachyOS/Arch
  # *system* `compiler-rt` package ships the older distro layout:
  #     <resource-dir>/lib/linux/libclang_rt.builtins-<arch>.a
  # which makes ninja fail with "missing libclang_rt.builtins.a". Rather than
  # always patching (which would BREAK your llvm-ultimate), we probe the ACTIVE
  # clang's resource dir and only rewrite the gn path logic to the distro layout
  # when that's what the active clang actually uses. Correct for BOTH toolchains.
  local _resdir _rt_native _rt_distro _cfi_system_ignorelist
  _resdir=$("$_clang" -print-resource-dir 2>/dev/null)

  # Enabling CFI makes the clang driver implicitly pass
  #   -fsanitize-system-ignorelist=<resource-dir>/share/cfi_ignorelist.txt
  # The file is not optional: it excludes ABI-mandated standard-library casts
  # that CFI would otherwise reject at runtime. llvm-ultimate was installed
  # without compiler-rt's `sanitizer-ignorelists` component, so clang correctly
  # aborts rather than silently producing a mis-instrumented binary. Repair the
  # incomplete toolchain resource installation with the canonical ignorelist
  # from the exact llvm-project revision used to build llvm-ultimate. Do NOT use
  # -fno-sanitize-ignorelist and do NOT disable CFI: both are security regressions.
  _cfi_system_ignorelist="$_resdir/share/cfi_ignorelist.txt"
  if [[ ! -s $_cfi_system_ignorelist ]]; then
    msg2 "Installing missing LLVM CFI system ignorelist into $_resdir/share..."
    if [[ ! -s $srcdir/cfi_ignorelist.txt ]]; then
      error "packaged cfi_ignorelist.txt is missing or empty"
      return 1
    fi
    if ! install -Dm644 "$srcdir/cfi_ignorelist.txt" "$_cfi_system_ignorelist"; then
      error "Cannot repair llvm-ultimate resource dir $_resdir (is the toolchain writable?)"
      return 1
    fi
  else
    msg2 "LLVM CFI system ignorelist present: $_cfi_system_ignorelist"
  fi

  # Fail immediately with a focused diagnostic instead of launching ~57k ninja
  # edges and reporting the same driver error from every C++ compilation.
  if ! printf 'int chromium_cfi_toolchain_probe;\n' |
      "$_clangxx" --target=x86_64-unknown-linux-gnu -march=raptorlake \
        -x c++ -c -o /dev/null -flto=thin -fvisibility=hidden \
        -fsanitize=cfi-vcall -fsanitize=cfi-icall -; then
    error "llvm-ultimate CFI smoke test failed after resource-dir repair"
    return 1
  fi

  _rt_native="$_resdir/lib/x86_64-unknown-linux-gnu/libclang_rt.builtins.a"
  _rt_distro="$_resdir/lib/linux/libclang_rt.builtins-x86_64.a"
  if [[ -f $_rt_native ]]; then
    msg2 "compiler-rt: per-target layout detected ($_resdir/lib/x86_64-unknown-linux-gnu) -- no patch needed."
  elif [[ -f $_rt_distro ]]; then
    msg2 "compiler-rt: distro layout detected ($_resdir/lib/linux) -- adjusting gn runtime paths."
    python3 - <<'PYEOF'
import sys
p = "build/config/clang/BUILD.gn"
s = open(p).read()
if "RAPTORLAKE_COMPILER_RT_LAYOUT_B" in s:
    sys.exit(0)  # idempotent
# 1) add a per-cpu _suffix beside each linux/chromeos triple (matches Arch).
repl = [
    ('          _dir = "x86_64-unknown-linux-gnu"\n',
     '          _dir = "x86_64-unknown-linux-gnu"\n          _suffix = "-x86_64"  # RAPTORLAKE_COMPILER_RT_LAYOUT_B\n'),
    ('          _dir = "i386-unknown-linux-gnu"\n',
     '          _dir = "i386-unknown-linux-gnu"\n          _suffix = "-i386"\n'),
    ('          _dir = "aarch64-unknown-linux-gnu"\n',
     '          _dir = "aarch64-unknown-linux-gnu"\n          _suffix = "-aarch64"\n'),
    ('          _dir = "loongarch64-unknown-linux-gnu"\n',
     '          _dir = "loongarch64-unknown-linux-gnu"\n          _suffix = "-loongarch64"\n'),
    ('          _dir = "riscv64-unknown-linux-gnu"\n',
     '          _dir = "riscv64-unknown-linux-gnu"\n          _suffix = "-riscv64"\n'),
]
for a, b in repl:
    if a in s:
        s = s.replace(a, b, 1)
# 2) collapse the per-target <triple> dir to the distro "linux" dir, at the end
#    of the (is_linux || is_chromeos) branch only.
anchor = ('          assert(false)  # Unhandled cpu type\n        }\n'
          '      } else if (is_fuchsia) {')
if anchor not in s:
    sys.exit("compiler-rt path patch: linux-branch anchor not found "
             "(upstream build/config/clang/BUILD.gn changed); update the PKGBUILD.")
s = s.replace(anchor,
              '          assert(false)  # Unhandled cpu type\n        }\n'
              '        _dir = "linux"  # RAPTORLAKE_COMPILER_RT_LAYOUT_B\n'
              '      } else if (is_fuchsia) {', 1)
open(p, "w").write(s)
print("  build/config/clang/BUILD.gn adjusted to distro compiler-rt layout")
PYEOF
  else
    warning "compiler-rt: neither layout found under $_resdir/lib (builtins may be missing)."
    warning "  If the build fails on libclang_rt.builtins, install 'compiler-rt' or check your toolchain."
  fi

  # ── Rust: exactly one rustc, the Chromium-pinned one ──────────────────────
  # prepare() installed the pinned toolchain into third_party/rust-toolchain,
  # but GN and ninja resolve `rustc` from PATH, so the distro toolchain (kept in
  # makedepends only to supply rustfmt for the bindgen CLI) was silently doing
  # the Rust half of the build. Two LLVM trees in one build is what produced
  #   LLVM ERROR: Broken module found
  #   domain must have one or two operands
  # at edge ~4639: that message is LLVM <=22's alias-scope domain verifier,
  # rejecting LLVM >=24 metadata (see _rust_cxx_lto_probe above). Pin the pinned
  # rustc for every child process, and prove the pairing before generating
  # 58k edges instead of discovering it 4.6k edges in.
  local _rust_root="$PWD/third_party/rust-toolchain" _rustc _rustc_llvm _clang_llvm
  local _rust_thinlto=false
  _rustc="$_rust_root/bin/rustc"
  [[ -x $_rustc ]] || {
    error "Chromium-pinned rustc missing at $_rustc (did prepare() run update_rust.py?)"
    return 1
  }
  export RUSTC="$_rustc"
  export PATH="$_rust_root/bin:$PATH"
  _rustc_llvm=$("$_rustc" --version --verbose 2>/dev/null \
                | sed -nE 's/.*LLVM version: ([0-9]+\.?[0-9]*).*/\1/p')
  _clang_llvm=$("$_clang" --version | sed -nE 's/.*LLVM version: ([0-9]+\.?[0-9]*).*/\1/p')
  [[ -n $_clang_llvm ]] || _clang_llvm=$_clang_version
  msg2 "rustc: $("$_rustc" --version 2>/dev/null)  (LLVM ${_rustc_llvm:-?})"
  msg2 "clang: $("$_clang" --version | head -1)  (LLVM ${_clang_llvm:-?})"

  # Probe, don't guess: can these two LLVM trees share ThinLTO bitcode?
  msg2 "Probing rustc <-> clang cross-language ThinLTO compatibility..."
  if _rust_cxx_lto_probe "$srcdir/.rust-lto-probe" "$_rustc" "$_clangxx"; then
    _rust_thinlto=true
    msg2 "  probe passed: enabling Rust cross-language LTO (full ThinLTO)."
    rm -rf "$srcdir/.rust-lto-probe"
  else
    local _probe_rc=$?
    _rust_thinlto=false
    warning "rustc(LLVM ${_rustc_llvm:-?}) and clang(LLVM ${_clang_llvm:-?}) cannot share ThinLTO"
    warning "  bitcode (probe exit $_probe_rc). Disabling Rust cross-LTO; Rust is still"
    warning "  compiled with -Copt-level=3 to native objects, so this costs little speed."
    warning "  Probe logs (kept for diagnosis): $srcdir/.rust-lto-probe/*.log"
    local _logf
    for _logf in rustc.log cc.log link.log; do
      [[ -s $srcdir/.rust-lto-probe/$_logf ]] || continue
      warning "  --- $_logf ---"
      sed -n '1,20p' "$srcdir/.rust-lto-probe/$_logf" | while IFS= read -r _line; do
        warning "  | $_line"
      done
    done
    if grep -q "domain must have one or two operands" \
         "$srcdir/.rust-lto-probe/link.log" 2>/dev/null; then
      warning "  diagnosed: LLVM alias-scope domain format mismatch (<=22 vs >=24)."
      warning "  Rust cross-LTO is OFF for this build, so the link cannot hit it."
    fi
  fi

  local _bindgen _bindgen_root
  _bindgen=$(command -v bindgen) || { error "bindgen not found on PATH"; return 1; }
  _bindgen_root=$(dirname "$(dirname "$(realpath "$_bindgen")")")
  [[ -x $_bindgen_root/bin/rustfmt ]] || {
    error "rustfmt is missing beside the selected bindgen: $_bindgen_root/bin"
    return 1
  }

  # ── GN args: RobRich args.gn merged with a known-good Arch base ────────────
  local _flags=(
    'is_clang=true'
    'is_component_build=false'
    'is_debug=false'
    'is_official_build=true'          # implies is_cfi=true on x86_64
    'use_lld=true'
    'use_thin_lto=true'
    'thin_lto_enable_optimizations=true'
    'thin_lto_enable_cache=false'
    'symbol_level=0'
    'blink_symbol_level=0'
    'v8_symbol_level=0'
    'target_cpu="x64"'
    'treat_warnings_as_errors=false'
    'fatal_linker_warnings=false'
    'clang_use_chrome_plugins=false'
    'enable_resource_allowlist_generation=false'
    'enable_precompiled_headers=false'
    'blink_enable_generated_code_formatting=false'

    # media / codecs (RobRich: full proprietary + HEVC/AC3/EAC3/DolbyVision)
    'proprietary_codecs=true'
    'ffmpeg_branding="Chrome"'
    'enable_ffmpeg_video_decoders=true'
    'enable_platform_hevc=true'
    'enable_hevc_parser_and_hw_decoder=true'
    'enable_platform_ac3_eac3_audio=true'
    'enable_platform_dolby_vision=true'
    'enable_platform_mpeg_h_audio=true'
    'enable_mse_mpeg2ts_stream_parser=true'

    # widevine / drm
    'enable_media_drm_storage=true'
    'enable_widevine=true'
    'bundle_widevine_cdm=false'
    'ignore_missing_widevine_signing_cert=true'

    # hardware accel (Raptor Lake iGPU)
    'use_vaapi=true'
    'rtc_use_pipewire=true'
    'link_pulseaudio=true'

    # privacy / local-only (no baked Google creds, like RobRich)
    "google_api_key=\"$_google_api_key\""
    'google_default_client_id="no"'
    'google_default_client_secret="no"'
    'use_official_google_api_keys=false'
    'enable_remoting=false'
    'disable_fieldtrial_testing_config=true'
    'dcheck_always_on=false'

    # perf knobs (RobRich)
    'use_icf=true'
    'optimize_for_size=false'
    'use_text_section_splitting=true'
    'init_stack_vars_zero=true'
    'use_sized_deallocation=true'
    'use_custom_libcxx=true'

    # native build against CachyOS system libs (NOT the downloaded Debian
    # sysroot). use_sysroot defaults to true and would assert on a missing
    # //build/linux/debian_bullseye_amd64-sysroot; we build natively instead.
    # libffi is not bundled in the lite tarball and use_system_libffi defaults
    # to false off-ChromeOS, so we must opt into the system copy explicitly.
    'use_sysroot=false'
    'use_system_libffi=true'
    'use_clang_modules=false'
    # use_unified_system_module defaults to TRUE on Linux and is a SEPARATE
    # toggle from use_clang_modules. Its only consumer, //build/modules/BUILD.gn,
    # does rebase_path(sysroot,...) to scan system headers for a libc++
    # modulemap -> with use_sysroot=false (sysroot="") that's an "Empty
    # directory path" error during `gn gen` (gn parses the whole gn_all graph,
    # incl. //build/modules, even though we only ninja chrome). We don't build
    # with libc++ modules (use_clang_modules=false), and //build/modules is only
    # referenced via the strict_deps config (enable_strict_deps defaults false),
    # so disabling unified modules is safe and removes the bad rebase_path.
    'use_unified_system_module=false'

    # Chromium-pinned Rust/Crubit; custom Clang still owns C/C++ and linking.
    'enable_rust=true'
    "toolchain_supports_rust_thin_lto=$_rust_thinlto"
    # Make the -O3 intent real for the whole build instead of only for the few
    # targets that request optimize_max. 0 restores upstream's -O2.
    "chromium_raptorlake_o3_all=$( (( _o3_everywhere )) && echo true || echo false )"

    # build infra
    'use_siso=false'
    'use_remoteexec=false'
    # We do NOT build .deb/.rpm packages (this is an Arch/CachyOS package that
    # installs out/Release files directly). enable_linux_installer's own default
    # is `is_linux && !is_component_build && use_sysroot && !using_sanitizer`, so
    # it REQUIRES a sysroot; forcing it true together with use_sysroot=false made
    # chrome/installer/linux/BUILD.gn call rebase_path("" ,...) -> "Empty
    # directory path". We never ninja the //chrome/installer target, so disable
    # it outright. (Arch does the same by leaving it at its now-false default.)
    'enable_linux_installer=false'
    # NOTE: enable_distro_version_check is intentionally NOT set. It is declared
    # only inside chrome/installer/linux/BUILD.gn, which is no longer loaded once
    # enable_linux_installer=false, so setting it triggers gn's "Build argument
    # has no effect / never appeared in a declare_args()" warning. Omitting it is
    # correct (the distro check only applies to the deb/rpm we don't build).
    'enable_hangout_services_extension=true'
    'use_qt5=false'
    'use_qt6=true'
    'moc_qt6_path="/usr/lib/qt6"'

    # custom clang toolchain
    "clang_base_path=\"$_clang_base\""
    "clang_version=\"$_clang_version\""
    "rust_bindgen_root=\"$_bindgen_root\""
    "bindgen_libclang_path=\"$_clang_base/lib\""
  )

  # ── PGO ───────────────────────────────────────────────────────────────────
  _flags+=("chrome_pgo_phase=$_pgo_phase")
  if (( _pgo_phase == 2 )); then
    local _pgo_path
    _pgo_path=$(cat "$srcdir/.pgo_data_path")
    # Make it absolute relative to the chromium src dir if needed.
    [[ $_pgo_path = /* ]] || _pgo_path="$PWD/$_pgo_path"
    [[ -f $_pgo_path ]] || error "PGO profile not found at $_pgo_path"
    _flags+=("pgo_data_path=\"$_pgo_path\"")
    msg2 "Using upstream PGO profile: $_pgo_path"
  fi

  # ── Flag environment ──────────────────────────────────────────────────────
  # options=('!buildflags') already made makepkg unset CPPFLAGS/CFLAGS/CXXFLAGS/
  # LDFLAGS/RUSTFLAGS, so NONE of your /etc/makepkg.conf flags are present here.
  # Chromium's GN owns all compile/link flags, and the raptorlake patch sets the
  # arch/tune inside the build, so we deliberately do NOT re-add any optimization
  # flags. We only append the few deterministic-build hardening switches Chromium
  # itself recommends (these start from an empty CFLAGS thanks to !buildflags).
  # Guard with :- so this is robust even if the vars are unset under `set -u`.
  CFLAGS="${CFLAGS:-} -Wno-builtin-macro-redefined -Wno-unknown-warning-option"
  CXXFLAGS="${CXXFLAGS:-} -Wno-builtin-macro-redefined -Wno-unknown-warning-option"
  CPPFLAGS="${CPPFLAGS:-} -D__DATE__= -D__TIME__= -D__TIMESTAMP__="
  export CFLAGS CXXFLAGS CPPFLAGS

  # Prove that the distro bindgen CLI can load llvm-ultimate's matching
  # libclang and that this exact LLVM 24 C API accepts the four options rejected
  # by the distro LLVM 22 libclang in the failed build. This tests the actual
  # executable/library pair before generating 57k Ninja edges.
  msg2 "Smoke-testing selected bindgen with llvm-ultimate libclang..."
  local _bindgen_probe_dir="$srcdir/.bindgen-llvm24-probe"
  rm -rf "$_bindgen_probe_dir"
  mkdir -p "$_bindgen_probe_dir"
  printf '%s\n' \
    'struct ChromiumBindgenProbe { int value; };' \
    'int chromium_bindgen_probe(struct ChromiumBindgenProbe*, int);' \
    > "$_bindgen_probe_dir/probe.h"
  if ! env \
      LIBCLANG_PATH="$_clang_base/lib" \
      LD_LIBRARY_PATH="$_clang_base/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
      "$_bindgen" \
        --no-layout-tests --no-rustfmt-bindings \
        --output "$_bindgen_probe_dir/bindings.rs" \
        "$_bindgen_probe_dir/probe.h" -- \
        -x c++ --target=x86_64-unknown-linux-gnu -march=raptorlake \
        -fdiagnostics-show-inlining-chain -fno-lifetime-dse \
        -fsanitize-ignore-for-ubsan-feature=array-bounds \
        -fsanitize-ignore-for-ubsan-feature=return; then
    error "rust-bindgen cannot parse LLVM 24 flags with $_clang_base/lib/libclang.so"
    return 1
  fi
  [[ -s $_bindgen_probe_dir/bindings.rs ]] || {
    error "rust-bindgen smoke test produced no bindings"
    return 1
  }
  rm -rf "$_bindgen_probe_dir"

  # Use the version-matched gn selected in prepare() -- the tarball's own prebuilt
  # buildtools/linux64/gn by default (see _force_bootstrap_gn) -- and never the
  # distro's system `gn`, which is too old for the `public_inputs` variable that
  # //third_party/devtools-frontend's copy.gni sets and fails `gn gen`. ninja
  # records this exact binary in build.ninja, so regeneration stays version-matched.
  local _gn
  _gn="$(cat "$srcdir/.gn_dir")/gn"
  [[ -x $_gn ]] || error "gn missing at $_gn (prepare() gn step failed?)."
  msg2 "Generating build files with the version-matched gn ($_gn)..."
  "$_gn" gen out/Release --fail-on-unused-args --args="${_flags[*]}"

  # Verify the generated action graph, not merely args.gn. v3 patched the unused
  # _libclang_path in rust_bindgen.gni while rust_bindgen_generator.gni owned the
  # failing action, so GN still emitted --libclang-path /usr/lib. Resolve every
  # emitted --libclang-path relative to out/Release and require the custom path.
  python3 - "$_clang_base/lib" <<'PYEOF'
import os, re, sys
root = os.path.realpath("out/Release")
expected = os.path.realpath(sys.argv[1])
hits = []
for base, _, files in os.walk(root):
    for name in files:
        if not name.endswith(".ninja"):
            continue
        path = os.path.join(base, name)
        with open(path, encoding="utf-8", errors="replace") as f:
            for lineno, line in enumerate(f, 1):
                for match in re.finditer(r"--libclang-path[ =]([^ \n]+)", line):
                    token = match.group(1).strip("'\"").replace("$ ", " ")
                    resolved = os.path.realpath(
                        token if os.path.isabs(token) else os.path.join(root, token))
                    hits.append((path, lineno, token, resolved))
if not hits:
    sys.exit("bindgen graph audit: no --libclang-path action found")
bad = [h for h in hits if h[3] != expected]
if bad:
    for path, lineno, token, resolved in bad[:20]:
        print(f"{path}:{lineno}: {token} -> {resolved}", file=sys.stderr)
    sys.exit(f"bindgen graph audit: {len(bad)} action(s) do not use {expected}")
print(f"  bindgen graph audit: {len(hits)} action reference(s) use {expected}")
PYEOF

  # Audit the generated graph for the one path that aborted the last build: rust
  # bitcode reaching lld while cross-language LTO is disabled. When cross-LTO is
  # off, no rust module may carry -Clinker-plugin-lto, otherwise the <=22
  # verifier aborts thousands of edges in.
  python3 - "$_rust_thinlto" <<'AUDITEOF'
import os, sys
enable = sys.argv[1] == "true"
needle = "linker-plugin-lto"
hits = 0
for base, _, files in os.walk("out/Release"):
    for name in files:
        if not (name.endswith(".ninja") or "rustflags" in name):
            continue
        try:
            with open(os.path.join(base, name), encoding="utf-8",
                      errors="replace") as fh:
                hits += fh.read().count(needle)
        except OSError:
            pass
if enable:
    if not hits:
        print("  rust LTO audit: cross-LTO enabled but no bitcode edges found?")
    else:
        print(f"  rust LTO audit: {hits} rust-bitcode edge(s), cross-LTO enabled")
else:
    if hits:
        sys.exit(f"rust LTO audit: {hits} edge(s) still hand rust bitcode to lld "
                 "while cross-LTO is disabled; the LLVM <=22 domain verifier "
                 "would abort the link")
    print("  rust LTO audit: no rust bitcode reaches lld (safe path)")
AUDITEOF

  msg2 "Building chrome, chrome_sandbox, chromedriver (long)..."
  local _ninja_jobs=()
  [[ -n $_jobs ]] && _ninja_jobs=(-j "$_jobs")
  ninja "${_ninja_jobs[@]}" -C out/Release chrome chrome_sandbox chromedriver.unstripped
}

package() {
  cd "$srcdir/chromium-launcher-$_launcher_ver"
  make PREFIX=/usr DESTDIR="$pkgdir" install
  install -Dvm644 LICENSE \
    "$pkgdir/usr/share/licenses/chromium/LICENSE.launcher"

  cd "$srcdir/chromium-$pkgver"

  install -Dv out/Release/chrome "$pkgdir/usr/lib/chromium/chromium"
  install -Dv out/Release/chromedriver.unstripped "$pkgdir/usr/bin/chromedriver"
  install -Dvm4755 out/Release/chrome_sandbox "$pkgdir/usr/lib/chromium/chrome-sandbox"

  install -Dvm644 chrome/installer/linux/common/desktop.template \
    "$pkgdir/usr/share/applications/chromium.desktop"
  install -Dvm644 chrome/app/resources/manpage.1.in \
    "$pkgdir/usr/share/man/man1/chromium.1"
  sed -i \
    -e 's/@@MENUNAME/Chromium (Raptor Lake)/g' \
    -e 's/@@PACKAGE/chromium/g' \
    -e 's/@@usr_bin_symlink_name/chromium/g' \
    -e 's|@@uri_scheme|x-scheme-handler/chromium;|g' \
    -e 's/@@extra_desktop_entries//g' \
    "$pkgdir/usr/share/applications/chromium.desktop" \
    "$pkgdir/usr/share/man/man1/chromium.1"

  ( tmpl_file=chrome/installer/linux/common/appdata.xml.template
    info_file=chrome/installer/linux/common/chromium-browser.info
    . "$info_file"; PACKAGE=chromium
    export $(grep -o '^[A-Z_]*' "$info_file")
    sed -E -e 's/@@([A-Z_]*)/\${\1}/g' -e '/<update_contact>/d' "$tmpl_file" | envsubst
  ) | install -Dvm644 /dev/stdin "$pkgdir/usr/share/metainfo/chromium.appdata.xml"

  local toplevel_files=(
    chrome_100_percent.pak
    chrome_200_percent.pak
    chrome_crashpad_handler
    resources.pak
    v8_context_snapshot.bin
    icudtl.dat
    libEGL.so
    libGLESv2.so
    libvk_swiftshader.so
    libvulkan.so.1
    vk_swiftshader_icd.json
  )
  [[ -f out/Release/libqt6_shim.so ]] && toplevel_files+=(libqt6_shim.so)

  cp "${toplevel_files[@]/#/out/Release/}" "$pkgdir/usr/lib/chromium/"
  install -Dvm644 -t "$pkgdir/usr/lib/chromium/locales" out/Release/locales/*.pak

  # Preloaded runtime data Chrome reads from its module dir. Verified against
  # the official RobRich RPM payload (chrome/installer/linux/BUILD.gn lists both
  # under packaging_files). Shipped conditionally since they only exist when the
  # corresponding data targets were built.
  #   MEIPreload                          -> Media Engagement Index preload
  #   PrivacySandboxAttestationsPreloaded -> Privacy Sandbox attestations
  local _preload
  for _preload in MEIPreload PrivacySandboxAttestationsPreloaded; do
    if [[ -d out/Release/$_preload ]]; then
      install -dvm755 "$pkgdir/usr/lib/chromium/$_preload"
      install -Dvm644 -t "$pkgdir/usr/lib/chromium/$_preload" out/Release/"$_preload"/*
    fi
  done

  for size in 24 48 64 128 256; do
    install -Dvm644 "chrome/app/theme/chromium/product_logo_$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/chromium.png"
  done
  for size in 16 32; do
    install -Dvm644 "chrome/app/theme/default_100_percent/chromium/product_logo_$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/chromium.png"
  done

  install -Dvm644 LICENSE "$pkgdir/usr/share/licenses/chromium/LICENSE"
}

