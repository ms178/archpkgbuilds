+static int rtl8169_alloc_rings(struct rtl8169_private *tp)
+{
+	struct pci_dev *pdev = tp->pci_dev;
+
+	/* Rx and Tx descriptors need 256 byte alignment;
+	 * dma_alloc_coherent() provides more.
+	 */
+	tp->TxDescArray = dma_alloc_coherent(&pdev->dev,
+					     R8169_TX_RING_BYTES(tp),
+					     &tp->TxPhyAddr, GFP_KERNEL);
+	if (!tp->TxDescArray)
+		return -ENOMEM;
+
+	tp->RxDescArray = dma_alloc_coherent(&pdev->dev,
+					     R8169_RX_RING_BYTES(tp),
+					     &tp->RxPhyAddr, GFP_KERNEL);
+	if (!tp->RxDescArray) {
+		dma_free_coherent(&pdev->dev, R8169_TX_RING_BYTES(tp),
+				  tp->TxDescArray, tp->TxPhyAddr);
+		tp->TxDescArray = NULL;
+		return -ENOMEM;
+	}
+
+	return 0;
+}
+
+static void rtl8169_free_rings(struct rtl8169_private *tp)
+{
+	struct pci_dev *pdev = tp->pci_dev;
+
+	if (tp->RxDescArray) {
