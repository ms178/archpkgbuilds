+static int rtl8169_alloc_rx_resources(struct rtl8169_private *tp)
+{
+	int rc;
+
+	rc = rtl8169_create_page_pool(tp);
+	if (rc)
+		return rc;
+
+	rc = xdp_rxq_info_reg(&tp->xdp_rxq, tp->dev, 0, tp->napi.napi_id);
+	if (rc)
+		goto err_pool;
+
+	rc = xdp_rxq_info_reg_mem_model(&tp->xdp_rxq, MEM_TYPE_PAGE_POOL,
+					tp->page_pool);
+	if (rc)
+		goto err_rxq;
+
+	tp->xdp_rxq_registered = true;
+
+	return 0;
+
+err_rxq:
+	xdp_rxq_info_unreg(&tp->xdp_rxq);
+err_pool:
+	rtl8169_destroy_page_pool(tp);
+	return rc;
+}
+
+static void rtl8169_free_rx_resources(struct rtl8169_private *tp)
+{
+	rtl8169_rx_clear(tp);
+
+	if (tp->xdp_rxq_registered) {
+		xdp_rxq_info_unreg(&tp->xdp_rxq);
+		tp->xdp_rxq_registered = false;
+	}
+
+	rtl8169_destroy_page_pool(tp);
+}
