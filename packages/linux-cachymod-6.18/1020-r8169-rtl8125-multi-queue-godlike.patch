+	rss_ctrl |= (ilog2(RSS_INDIR_TBL_ENTRIES_8125) & 0x7) <<
+		    RSS_MASK_BITS_OFFSET;
+	rss_ctrl |= (ilog2(tp->num_rx_queues) & 0x7) << RSS_CPU_NUM_OFFSET;
