+
+static void rtl8125_store_reta(struct rtl8169_private *tp)
+{
+	u16 reg = RSS_INDIRECTION_TBL_8125_V2;
+	u32 reta = 0;
+	unsigned int i;
+
+	for (i = 0; i < RSS_INDIR_TBL_ENTRIES_8125; i++) {
+		reta |= (u32)tp->rss_indir_tbl[i] << ((i & 3) * 8);
+		if ((i & 3) == 3) {
+			RTL_W32(tp, reg, reta);
+			reg += 4;
+			reta = 0;
+		}
+	}
