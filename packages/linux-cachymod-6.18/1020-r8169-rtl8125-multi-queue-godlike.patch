+/* RTL8125 "new" transmit descriptor, 32 bytes.
+ *
+ * The multi-queue transmit design is built around this layout: the vendor
+ * driver enables it unconditionally with MAC OCP 0xEB58 bit 0 and sizes its
+ * rings with sizeof(struct TxDesc) == 32 (r8125_n.c:18922-18925,
+ * r8125.h:2029-2037, r8125_n.c:18445).
+ *
+ * Upstream r8169 explicitly *disables* the new format
+ * (mac_ocp_modify(0xeb58, 0x0001, 0x0000)) and uses the 16 byte layout, which
+ * is correct for a single transmit ring. Arming the second ring through
+ * TNPDS_Q1_LOW_8125 while the MAC walks descriptors with the legacy stride
+ * makes the hardware read every ring-1 descriptor from the wrong offset, so
+ * the frames it transmits are malformed. The two settings must therefore
+ * always agree, which is what rtl8169_set_tx_desc_type() enforces.
+ */
+struct TxDescV3 {
+	__le32 opts1;
+	__le32 opts2;
+	__le64 addr;
+	__le32 rsv0;
+	__le32 rsv1;
+	__le32 rsv2;
+	__le32 rsv3;
+};
+
+static_assert(sizeof(struct TxDescV3) == 32);
+
 struct RxDesc {
 	__le32 opts1;
 	__le32 opts2;
 	__le64 addr;
 };
 
+/* RTL8125 "type 3" receive descriptor, 32 bytes.
+ *
+ * The RSS engine only reports the hash when the MAC is switched to this
+ * layout via EnableRxDescV3 (RxConfig bit 24), which is exactly what the
+ * vendor driver does whenever RSS is enabled
+ * (r8125_n.c:15879-15898, r8125.h:2045-2091,1639).
+ *
+ * Note that opts1/opts2 live at the *end* of this descriptor, not at the
+ * start as in the legacy layout.
+ */
+struct RxDescV3 {
+	__le32 rsv1;
+	__le32 rsv2;
+	__le32 RSSResult;
+	__le16 HeaderBufferLen;
+	__le16 HeaderInfo;
+	__le64 addr;
+	__le32 opts2;
+	__le32 opts1;
+};
+
+static_assert(sizeof(struct RxDescV3) == 32);
+
+/* The type 3 descriptor moves every status bit in opts1/opts2 to a different
+ * position. Decoding a V3 descriptor with the legacy constants misreads a
+ * perfectly good frame: e.g. opts1 0x03200040 (a 64 byte frame with
+ * FirstFrag_V3 | LastFrag_V3 set) hits the legacy RxRES at bit 21 and is
+ * dropped as "Rx ERROR". Values from r8125.h:1595-1598,1859-1860,1922-1930.
+ */
+#define FirstFrag_V3			BIT(25)
+#define LastFrag_V3			BIT(24)
+#define RxRES_V3			BIT(20)
+#define RxRUNT_V3			BIT(19)
+#define RxRWT_V3			BIT(18)
+#define RxCRC_V3			BIT(17)
+
+#define RxUDPT_V3			BIT(29)
+#define RxTCPT_V3			BIT(28)
+#define RxIPF_V3			BIT(26)
+#define RxUDPF_V3			BIT(25)
+#define RxTCPF_V3			BIT(24)
+
+/* RSS type bits reported in RxDescV3.HeaderInfo (r8125_rss.c:494-499). */
+#define RXS_8125_RSS_UDP		BIT(9)
+#define RXS_8125_RSS_IPV4		BIT(10)
+#define RXS_8125_RSS_IPV6		BIT(12)
+#define RXS_8125_RSS_TCP		BIT(13)
+#define RTL8125_RXS_RSS_L3_TYPE_MASK	(RXS_8125_RSS_IPV4 | RXS_8125_RSS_IPV6)
+#define RTL8125_RXS_RSS_L4_TYPE_MASK	(RXS_8125_RSS_TCP | RXS_8125_RSS_UDP)
