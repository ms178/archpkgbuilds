+#define RDSAR_Q1_LOW_8125		0x4000
+
+/* TxNoClose (r8125.h:1515-1516, r8125_n.c:15191-15212).
+ *
+ * The 32 byte "new" transmit descriptor and TxNoClose are one feature, not
+ * two. When MAC OCP 0xEB58 bit 0 selects the new format the MAC stops writing
+ * DescOwn back into the descriptor on completion; instead it publishes a
+ * monotonically increasing count of closed descriptors in HW_CLO_PTR, and the
+ * driver publishes its producer index in SW_TAIL_PTR instead of ringing
+ * TxPoll. TxConfig bit 6 arms it.
+ *
+ * RTL8125B is HwSuppTxNoCloseVer 3 (r8125_n.c:15550-15554), which uses the
+ * 16-bit register pair at 0x2800/0x2802 with a 4 byte per-queue stride and a
+ * 16-bit pointer mask (MAX_TX_NO_CLOSE_DESC_PTR_MASK_V2, r8125.h:828).
+ */
+#define SW_TAIL_PTR0_8125		0x2800
+#define HW_CLO_PTR0_8125		0x2802
+#define TX_NO_CLOSE_PTR_STRIDE_8125	4
+#define TX_NO_CLOSE_PTR_MASK_8125	0xffff
+#define TXCFG_TX_NO_CLOSE		BIT(6)
+
+/* Packed 16-bit per-queue IMR/ISR window, used by the ISR v1 multi-queue
+ * path (r8125.h:1478-1479). Access MUST be 16-bit.
+ */
+#define IMR1_8125			0x0800
+#define ISR1_8125			0x0802
+
+/* ISR v2 interrupt block. RTL8125B reports HwSuppIsrVer = 2
+ * (r8125_n.c:15705-15708) and therefore masks and acknowledges interrupts
+ * here rather than through the packed 0x800 window
+ * (r8125.h:1498-1500, r8125_n.c:4590/4610/4623).
+ */
+#define IMR_V2_CLEAR_REG_8125		0x0D00
+#define ISR_V2_8125			0x0D04
+#define IMR_V2_SET_REG_8125		0x0D0C
+
+/* ISR v2 bit assignments (r8125.h:1820-1823). The MSI-X message id is the
+ * ISR bit index, so RX queue i owns vector i.
+ */
+#define ISRIMR_V2_ROK_Q0		BIT(0)
+#define ISRIMR_TOK_Q0			BIT(16)
+#define ISRIMR_TOK_Q1			BIT(18)
+#define ISRIMR_V2_LINKCHG		BIT(21)
+
+/* MSI-X vector budget for RTL8125B (r8125.h:696,698). Fewer than
+ * R8125_MIN_MSIX_VEC_8125B vectors forces the hardware back to ISR v1
+ * (r8125_n.c:15732-15735), which has no per-queue vectors at all.
+ */
+#define R8125_MAX_MSIX_VEC_8125B	32
+#define R8125_MIN_MSIX_VEC_8125B	22
+
+/* Queue counts for RTL8125B == CFG_METHOD_4/5 (r8125_n.c:15673-15674). */
+#define R8169_MAX_RX_QUEUES		8
+#define R8169_MAX_TX_QUEUES		2
+
+/* MSI-X vector index of the TX queues and of the link-change event. */
+#define R8125_TX_Q0_VECTOR		16
+#define R8125_TX_Q1_VECTOR		18
+#define R8125_LINKCHG_VECTOR		21
+
+#define R8125_Config5_ASPM		BIT(0)
+#define R8125_Config2_CLKREQ		BIT(7)
