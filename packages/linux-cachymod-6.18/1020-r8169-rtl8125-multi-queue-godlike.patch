+/* Spread the RX queues over distinct CPUs. Without this every vector can
+ * land on CPU0 and the whole point of multiple queues is lost.
+ */
+static void rtl8169_set_irq_affinity(struct rtl8169_private *tp)
+{
+	unsigned int i;
+
+	if (tp->isr_ver < 2)
+		return;
+
+	for (i = 0; i < tp->num_rx_queues; i++) {
+		struct rtl8169_rx_ring *ring = &tp->rx_ring[i];
+		int cpu = cpumask_local_spread(i, dev_to_node(&tp->pci_dev->dev));
+
+		if (ring->irq < 0)
+			continue;
+
+		netif_set_xps_queue(tp->dev, cpumask_of(cpu),
+				    i % tp->num_tx_queues);
+		irq_update_affinity_hint(ring->irq, cpumask_of(cpu));
+	}
+
+	/* Put each TX completion vector on the same CPU as the RX queue that
+	 * XPS steers to it, so a flow's transmit and its completion stay on
+	 * one core and the descriptor ring stays in that core's cache.
+	 */
+	for (i = 0; i < tp->num_tx_queues; i++) {
+		struct rtl8169_tx_ring *ring = &tp->tx_ring[i];
+		int cpu = cpumask_local_spread(i, dev_to_node(&tp->pci_dev->dev));
+
+		if (ring->irq < 0)
+			continue;
+
+		irq_update_affinity_hint(ring->irq, cpumask_of(cpu));
+	}
 }
 
