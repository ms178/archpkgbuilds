+ *   RSS_CTRL_8125 hash-type bits          r8125_rss.c:40-49
+ *   RSS_MASK_BITS_OFFSET / CPU_NUM_OFFSET r8125_rss.c:117-118
+ *   RETA packing, 4 entries per dword     r8125_rss.c:340-350
+ *   key, 40 bytes as 10 LE dwords         r8125_rss.c:355-367
+ */
+static void rtl8125_store_rss_key(struct rtl8169_private *tp)
+{
+	unsigned int i;
+
+	for (i = 0; i < RSS_KEY_SIZE_8125; i += 4)
+		RTL_W32(tp, RSS_KEY_8125 + i,
+			get_unaligned_le32(tp->rss_key + i));
