+	rss_ctrl = RSS_CTRL_TCP_IPV4_SUPP | RSS_CTRL_IPV4_SUPP |
+		   RSS_CTRL_TCP_IPV6_SUPP | RSS_CTRL_IPV6_SUPP |
+		   RSS_CTRL_IPV6_EXT_SUPP | RSS_CTRL_TCP_IPV6_EXT_SUPP |
+		   RSS_CTRL_UDP_IPV4_SUPP | RSS_CTRL_UDP_IPV6_SUPP |
+		   RSS_CTRL_UDP_IPV6_EXT_SUPP;
