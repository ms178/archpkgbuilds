Subject: [PATCH] 0300-oom-reaper-check-ms178.patch

---
 mm/oom_kill.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/mm/oom_kill.c b/mm/oom_kill.c
index e6a69fa0b7b21ff232ab8b28e75582eefb1fde84..e21d63cf316f698d8aa694b1b9bfd288dbdb4dfe 100644
--- a/mm/oom_kill.c
+++ b/mm/oom_kill.c
@@ -741,6 +741,11 @@ static const struct ctl_table vm_oom_kill_table[] = {
 static int __init oom_init(void)
 {
 	oom_reaper_th = kthread_run(oom_reaper, NULL, "oom_reaper");
+	if (IS_ERR(oom_reaper_th)) {
+		pr_err("Unable to start OOM reaper: %ld. Continuing regardless\n",
+		       PTR_ERR(oom_reaper_th));
+		oom_reaper_th = NULL;
+	}
 #ifdef CONFIG_SYSCTL
 	register_sysctl_init("vm", vm_oom_kill_table);
 #endif
