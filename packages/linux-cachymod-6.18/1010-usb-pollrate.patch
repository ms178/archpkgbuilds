From 40460dd4b001e4eae732f4f1eef2d51027855014 Mon Sep 17 00:00:00 2001
From: ms178 linux-cachymod rebase <rebase@localhost>
Date: Sun, 8 Nov 2026 18:49:39 +0000
Subject: [PATCH] 1010-usb-pollrate.patch

USB core: gaming poll-rate override module parameters (usbcore).

Six knobs (pollrate_{int,iso}_{low,full,high}) replace the sanitized
bInterval of interrupt/isochronous endpoints at enumeration time;
sentinel 8191 (default) keeps the descriptor value, so the steady-state
cost is one predictable load+compare per endpoint parse.  Values are
clamped per speed class: 1-255 ms for low/full-speed interrupt, 1-16
(micro)frame exponents for high/super-speed interrupt and all
isochronous endpoints - a blanket min(255) clamp would admit illegal
exponents on high/super speed.  Applied to endpoint->desc AFTER the
low-speed bulk-to-interrupt quirk so quirked devices honor the int-low
knob.  Parameter callback parses fully before installing: rejected
input never mutates published state.  kernel-parameters.txt documents
all six including the 8000 Hz high-speed example.

Placement: after 0410 per the v3 merge-record lineage decision.
Validation: audit/harness4/test_pollrate_logic.c (sentinel, per-class
clamp incl. the exponent-defect refutation, zero floor, bulk exclusion,
7 parse-ordering cases): ALL PASS; in-tree config.o build RC=0 with
zero warnings; PKGBUILD occurrence unique.

Signed-off-by: ms178 linux-cachymod rebase <rebase@localhost>
---
 .../admin-guide/kernel-parameters.txt         |  21 +++
 drivers/usb/core/config.c                     | 130 ++++++++++++++++++
 2 files changed, 151 insertions(+)

diff --git a/Documentation/admin-guide/kernel-parameters.txt b/Documentation/admin-guide/kernel-parameters.txt
index 4a80554ad7ab215fdaaa28a505fdbe51017e9d4e..d7d0e51acf913a8252a7ec041abecffff73f3b15 100644
--- a/Documentation/admin-guide/kernel-parameters.txt
+++ b/Documentation/admin-guide/kernel-parameters.txt
@@ -7851,6 +7851,27 @@
 			autosuspended.  Devices for which the delay is set
 			to a negative value won't be autosuspended at all.
 
+	usbcore.pollrate_int_low=
+	usbcore.pollrate_int_full=
+	usbcore.pollrate_int_high=
+	usbcore.pollrate_iso_low=
+	usbcore.pollrate_iso_full=
+	usbcore.pollrate_iso_high=
+			[USB] Gaming poll-rate overrides: replace the
+			bInterval of interrupt (int) or isochronous (iso)
+			endpoints at low/full/high(+super) speed with the
+			given raw value when the device is enumerated.
+			Low/full-speed interrupt values are milliseconds
+			(legal range 1-255); high/super-speed interrupt
+			and all isochronous values are (micro)frame
+			exponents (legal range 1-16; e.g. 1 = 125 us =
+			8000 Hz ceiling on high speed).  Out-of-range
+			values are clamped.  Default 8191 keeps the
+			descriptor value (after core sanitization).
+			Example: usbcore.pollrate_int_high=1 polls
+			high-speed interrupt IN endpoints (mice,
+			keyboards) every microframe.
+
 	usbcore.usbfs_snoop=
 			[USB] Set to log all usbfs traffic (default 0 = off).
 
diff --git a/drivers/usb/core/config.c b/drivers/usb/core/config.c
index a09633f1dd940052e73bd354f8d2ed61896061b4..13b5ca7553ae8aeba4d2b46213118a08bfbe6a31 100644
--- a/drivers/usb/core/config.c
+++ b/drivers/usb/core/config.c
@@ -290,6 +290,133 @@ static bool config_endpoint_is_duplicate(struct usb_host_config *config,
 	return false;
 }
 
+/*
+ * Gaming poll-rate overrides for interrupt/isochronous endpoints.
+ *
+ * Six knobs (usbcore.pollrate_{int,iso}_{low,full,high}), one per
+ * transfer-type/speed class; 'high' covers high, super and super-plus
+ * speed.  Each knob holds a raw bInterval replacement value with the
+ * sentinel 8191 meaning "keep the descriptor/sanitized value" (the
+ * default — the override is then a single predictable compare per
+ * endpoint parse).  Applied values are clamped to the legal bInterval
+ * range of the class: 1..255 ms for low/full-speed interrupt endpoints,
+ * 1..16 (micro)frame exponents for high/super-speed interrupt and
+ * all isochronous endpoints.  Parameter writes parse fully before
+ * installing, so a rejected value never mutates published state.
+ */
+#define USB_POLLRATE_KEEP	8191u
+
+enum {
+	POLLRATE_INT_LOW,
+	POLLRATE_INT_FULL,
+	POLLRATE_INT_HIGH,
+	POLLRATE_ISO_LOW,
+	POLLRATE_ISO_FULL,
+	POLLRATE_ISO_HIGH,
+	POLLRATE_NUM,
+};
+
+static unsigned short pollrate_ivals[POLLRATE_NUM] = {
+	[0 ... POLLRATE_NUM - 1] = USB_POLLRATE_KEEP,
+};
+
+static int pollrate_param_set(const char *val, const struct kernel_param *kp)
+{
+	unsigned int tmp;
+	int rc;
+
+	/* Parse first, install second: no state mutation on failure. */
+	rc = kstrtouint(val, 0, &tmp);
+	if (rc)
+		return rc;
+	WRITE_ONCE(*(unsigned short *)kp->arg, (unsigned short)tmp);
+	return 0;
+}
+
+static int pollrate_param_get(char *buf, const struct kernel_param *kp)
+{
+	return sysfs_emit(buf, "%u\n", READ_ONCE(*(unsigned short *)kp->arg));
+}
+
+static const struct kernel_param_ops pollrate_param_ops = {
+	.set	= pollrate_param_set,
+	.get	= pollrate_param_get,
+};
+
+#define POLLRATE_DESC(what, unit, lo, hi)				\
+	"bInterval override for " what " endpoints (" unit "); "	\
+	"clamped to " #lo "-" #hi ", " __stringify(USB_POLLRATE_KEEP)	\
+	" (default) keeps the sanitized descriptor value"
+
+module_param_cb(pollrate_int_low, &pollrate_param_ops,
+		&pollrate_ivals[POLLRATE_INT_LOW], 0644);
+MODULE_PARM_DESC(pollrate_int_low,
+		 POLLRATE_DESC("low-speed interrupt", "ms", 1, 255));
+module_param_cb(pollrate_int_full, &pollrate_param_ops,
+		&pollrate_ivals[POLLRATE_INT_FULL], 0644);
+MODULE_PARM_DESC(pollrate_int_full,
+		 POLLRATE_DESC("full-speed interrupt", "ms", 1, 255));
+module_param_cb(pollrate_int_high, &pollrate_param_ops,
+		&pollrate_ivals[POLLRATE_INT_HIGH], 0644);
+MODULE_PARM_DESC(pollrate_int_high,
+		 POLLRATE_DESC("high/super-speed interrupt", "exponent", 1, 16));
+module_param_cb(pollrate_iso_low, &pollrate_param_ops,
+		&pollrate_ivals[POLLRATE_ISO_LOW], 0644);
+MODULE_PARM_DESC(pollrate_iso_low,
+		 POLLRATE_DESC("low-speed isochronous", "exponent", 1, 16));
+module_param_cb(pollrate_iso_full, &pollrate_param_ops,
+		&pollrate_ivals[POLLRATE_ISO_FULL], 0644);
+MODULE_PARM_DESC(pollrate_iso_full,
+		 POLLRATE_DESC("full-speed isochronous", "exponent", 1, 16));
+module_param_cb(pollrate_iso_high, &pollrate_param_ops,
+		&pollrate_ivals[POLLRATE_ISO_HIGH], 0644);
+MODULE_PARM_DESC(pollrate_iso_high,
+		 POLLRATE_DESC("high/super-speed isochronous", "exponent", 1, 16));
+
+static void usb_apply_pollrate(struct usb_device *udev,
+			       const struct usb_endpoint_descriptor *d,
+			       struct usb_host_endpoint *endpoint)
+{
+	/* Legal bInterval maximum per knob: ms for LS/FS interrupt,
+	 * (micro)frame exponent everywhere else.
+	 */
+	static const unsigned short pollrate_max[POLLRATE_NUM] = {
+		[POLLRATE_INT_LOW]	= 255,
+		[POLLRATE_INT_FULL]	= 255,
+		[POLLRATE_INT_HIGH]	= 16,
+		[POLLRATE_ISO_LOW]	= 16,
+		[POLLRATE_ISO_FULL]	= 16,
+		[POLLRATE_ISO_HIGH]	= 16,
+	};
+	unsigned short ival;
+	unsigned int idx;
+
+	if (usb_endpoint_xfer_int(d))
+		idx = POLLRATE_INT_LOW;
+	else if (usb_endpoint_xfer_isoc(d))
+		idx = POLLRATE_ISO_LOW;
+	else
+		return;
+
+	switch (udev->speed) {
+	case USB_SPEED_LOW:
+		break;
+	case USB_SPEED_FULL:
+		idx += 1;
+		break;
+	default:	/* HIGH, SUPER and SUPER_PLUS share the exponent knob */
+		idx += 2;
+		break;
+	}
+
+	ival = READ_ONCE(pollrate_ivals[idx]);
+	if (ival == USB_POLLRATE_KEEP)
+		return;
+
+	endpoint->desc.bInterval = clamp_t(unsigned int, ival, 1,
+					   pollrate_max[idx]);
+}
+
 static int usb_parse_endpoint(struct device *ddev, int cfgno,
 		struct usb_host_config *config, int inum, int asnum,
 		struct usb_host_interface *ifp, int num_ep,
@@ -453,6 +580,9 @@ static int usb_parse_endpoint(struct device *ddev, int cfgno,
 			endpoint->desc.wMaxPacketSize = cpu_to_le16(8);
 	}
 
+	/* Gaming poll-rate override; sees the quirk-converted descriptor. */
+	usb_apply_pollrate(udev, &endpoint->desc, endpoint);
+
 	/*
 	 * Validate the wMaxPacketSize field.
 	 * eUSB2 devices (see USB 2.0 Double Isochronous IN ECN 9.6.6 Endpoint)
