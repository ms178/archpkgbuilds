From 81b324025cfc78232e1db8cae829fb9cd6423073 Mon Sep 17 00:00:00 2001
From: Rebase Bot <rebase@localhost>
Date: Sat, 3 Oct 2026 23:02:54 +0000
Subject: [PATCH] dkms-clang.patch

---
 Makefile                   | 22 ++++++++++++++++++----
 scripts/Makefile.clang     |  2 --
 scripts/Makefile.extrawarn |  4 ----
 scripts/Makefile.lib       |  7 +++++++
 4 files changed, 25 insertions(+), 10 deletions(-)

diff --git a/Makefile b/Makefile
index b0864d6022fa7f4a0401ddb539883b16898e7269..bd0cd1d2d341a0a818344b798a6196ec18ec21f6 100644
--- a/Makefile
+++ b/Makefile
@@ -964,10 +964,24 @@ endif
 
 ifdef CONFIG_FUNCTION_TRACER
 ifdef CONFIG_FTRACE_MCOUNT_USE_CC
-  CC_FLAGS_FTRACE	+= -mrecord-mcount
-  ifdef CONFIG_HAVE_NOP_MCOUNT
-    ifeq ($(call cc-option-yn, -mnop-mcount),y)
-      CC_FLAGS_FTRACE	+= -mnop-mcount
+  # CONFIG_FTRACE_MCOUNT_USE_CC is selected by a config-time $(cc-option)
+  # probe, so it is only guaranteed for the compiler the kernel was
+  # configured with. Out-of-tree module builds may run a different (older)
+  # compiler that lacks -mrecord-mcount support. Re-validate at build time
+  # and fall back to objtool-based __mcount_loc generation when the active
+  # compiler cannot record mcount sites itself.
+  ifeq ($(call cc-option-yn, -mrecord-mcount),y)
+    CC_FLAGS_FTRACE	+= -mrecord-mcount
+    ifdef CONFIG_HAVE_NOP_MCOUNT
+      ifeq ($(call cc-option-yn, -mnop-mcount),y)
+        CC_FLAGS_FTRACE	+= -mnop-mcount
+        CC_FLAGS_USING	+= -DCC_USING_NOP_MCOUNT
+      endif
+    endif
+  else ifdef CONFIG_HAVE_OBJTOOL_MCOUNT
+    FTRACE_MCOUNT_USE_OBJTOOL_FALLBACK := y
+    export FTRACE_MCOUNT_USE_OBJTOOL_FALLBACK
+    ifdef CONFIG_HAVE_OBJTOOL_NOP_MCOUNT
       CC_FLAGS_USING	+= -DCC_USING_NOP_MCOUNT
     endif
   endif
diff --git a/scripts/Makefile.clang b/scripts/Makefile.clang
index b67636b28c35dd1e9ce46197edc9107aa9070370..062ee0211c9ce7a870f223d5fb9b089d007fa1bb 100644
--- a/scripts/Makefile.clang
+++ b/scripts/Makefile.clang
@@ -34,9 +34,7 @@ endif
 # certain optimization flags it knows it has not implemented.
 # Make it behave more like gcc by erroring when these flags are encountered
 # so they can be implemented or wrapped in cc-option.
-CLANG_FLAGS	+= -Werror=unknown-warning-option
 CLANG_FLAGS	+= -Werror=ignored-optimization-argument
 CLANG_FLAGS	+= -Werror=option-ignored
-CLANG_FLAGS	+= -Werror=unused-command-line-argument
 KBUILD_CPPFLAGS	+= $(CLANG_FLAGS)
 export CLANG_FLAGS
diff --git a/scripts/Makefile.extrawarn b/scripts/Makefile.extrawarn
index 6af392f9cd0227449db8bcfb97d8bad4dfbe3a8e..45ca411e0739f950ea65b38244789c512902a0a9 100644
--- a/scripts/Makefile.extrawarn
+++ b/scripts/Makefile.extrawarn
@@ -13,7 +13,6 @@ KBUILD_CFLAGS += -Wundef
 KBUILD_CFLAGS += -Werror=implicit-function-declaration
 KBUILD_CFLAGS += -Werror=implicit-int
 KBUILD_CFLAGS += -Werror=return-type
-KBUILD_CFLAGS += -Werror=strict-prototypes
 KBUILD_CFLAGS += -Wno-format-security
 KBUILD_CFLAGS += -Wno-trigraphs
 KBUILD_CFLAGS += $(call cc-option, -Wno-frame-address)
@@ -96,9 +95,6 @@ KBUILD_CFLAGS += $(KBUILD_CFLAGS-y) $(CONFIG_CC_IMPLICIT_FALLTHROUGH)
 # Prohibit date/time macros, which would make the build non-deterministic
 KBUILD_CFLAGS += -Werror=date-time
 
-# enforce correct pointer usage
-KBUILD_CFLAGS += $(call cc-option,-Werror=incompatible-pointer-types)
-
 # Require designated initializers for all marked structures
 KBUILD_CFLAGS += $(call cc-option,-Werror=designated-init)
 
diff --git a/scripts/Makefile.lib b/scripts/Makefile.lib
index 14e2c680e0f68a9954d02fcb89b13981ea8b3672..034ddeed45ff0b284880af5b212d404ded6deeb6 100644
--- a/scripts/Makefile.lib
+++ b/scripts/Makefile.lib
@@ -181,6 +181,13 @@ objtool-args-$(CONFIG_FTRACE_MCOUNT_USE_OBJTOOL)	+= --mcount
 ifdef CONFIG_FTRACE_MCOUNT_USE_OBJTOOL
 objtool-args-$(CONFIG_HAVE_OBJTOOL_NOP_MCOUNT)		+= --mnop
 endif
+# Fallback for out-of-tree builds whose compiler lacks -mrecord-mcount
+# support (see the CONFIG_FTRACE_MCOUNT_USE_CC block in the top Makefile):
+# generate __mcount_loc with objtool, exactly like USE_OBJTOOL kernels do.
+ifdef FTRACE_MCOUNT_USE_OBJTOOL_FALLBACK
+objtool-args-y						+= --mcount
+objtool-args-$(CONFIG_HAVE_OBJTOOL_NOP_MCOUNT)		+= --mnop
+endif
 objtool-args-$(CONFIG_UNWINDER_ORC)			+= --orc
 objtool-args-$(CONFIG_MITIGATION_RETPOLINE)		+= --retpoline
 objtool-args-$(CONFIG_MITIGATION_RETHUNK)		+= --rethunk
