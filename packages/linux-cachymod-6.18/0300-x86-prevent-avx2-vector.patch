From ce18b76de85ec2e4b99563849ad8183aa3b4bece Mon Sep 17 00:00:00 2001
From: Arena Agent <agent@arena.ai>
Date: Fri, 24 Jul 2026 18:03:13 +0000
Subject: [PATCH] Apply 0300-x86-prevent-avx2-vector.patch

---
 arch/x86/Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/x86/Makefile b/arch/x86/Makefile
index 34c665379dd525f3fef1eb0678edfe459c3abedc..3997c114d763130527576884f819cc6df4dbbd32 100644
--- a/arch/x86/Makefile
+++ b/arch/x86/Makefile
@@ -75,7 +75,7 @@ export BITS
 #
 #    https://gcc.gnu.org/bugzilla/show_bug.cgi?id=53383
 #
-KBUILD_CFLAGS += -mno-sse -mno-mmx -mno-sse2 -mno-3dnow -mno-avx -mno-sse4a
+KBUILD_CFLAGS += -mno-sse -mno-mmx -mno-sse2 -mno-3dnow -mno-avx -mno-sse4a -mno-avx2 -fno-tree-vectorize -mpopcnt
 KBUILD_RUSTFLAGS += --target=$(objtree)/scripts/target.json
 KBUILD_RUSTFLAGS += -Ctarget-feature=-sse,-sse2,-sse3,-ssse3,-sse4.1,-sse4.2,-avx,-avx2
 
