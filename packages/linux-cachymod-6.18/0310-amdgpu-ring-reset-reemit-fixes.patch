From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ms178 linux-cachymod rebase <rebase@localhost>
Date: Fri, 09 Oct 2026 21:30:00 +0200
Subject: [PATCH] 0310-amdgpu-ring-reset-reemit-fixes.patch

Backport of the upstream v6.19.14 ring-reset re-emission hardening for the
backup-unprocessed-commands machinery that landed between 6.18.52 and
6.18.55.  6.18.y went EOL at 6.18.55 before upstream fixed the races in
that machinery, so this tree (6.18.55 + full patchset, fence code retained
verbatim) hangs repeatedly under load: a ring timeout on a Vega gfx9 build
triggers the per-ring soft reset, whose re-emit pass replays already
submitted IBs on the second reset because there is no per-fence wptr
bracket and no re-emission counter.  Symptom on the user's machine:
"ring comp_1.1.1 (KIQ) timeout, signaled seq=N, emitted seq=N+2" storms at
Cyberpunk 2077 level loads/quits, absent on the 6.18.52-based build where
the machinery does not exist.

Adopted changes (adapted to the 6.18.55 fence API kept by this set):
 - amdgpu_fence_save_fence_wptr_start()/end() bracket the fence packet in
   amdgpu_fence_emit() exactly like v6.19.14;
 - amdgpu_ring_backup_unprocessed_commands(): never re-back a fence that
   was already re-emitted (fence->reemitted), and always save the fence
   packet itself (bracket range) for same-context fences;
 - amdgpu_fence_driver_guilty_force_completion(): after a fence has been
   re-emitted more than once, cancel everything via
   amdgpu_fence_driver_force_completion(ring, &af->base) - the 6.18.55
   signature, preserving its -ETIME-on-timedout-fence semantics - and drop
   the stale pending backup instead of replaying it.

Hot-path cost: two u64 stores per fence submission; all remaining changes
execute only during ring resets.  No fast-path (gem/ib/vm/cs) semantics are
touched.  See audit/18_amdgpu_ring_reset_root_cause.md.

Fixes: upstream ring-reset machinery as introduced between v6.18.52 and v6.18.55
Signed-off-by: ms178 linux-cachymod rebase <rebase@localhost>
---
 drivers/gpu/drm/amd/amdgpu/amdgpu_fence.c |   43 +++++++++++++++++++++++++++++++++++++++++--
 drivers/gpu/drm/amd/amdgpu/amdgpu_ring.h |    5 +++++
 2 files changed, 46 insertions(+), 2 deletions(-)
---
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_fence.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_fence.c
index d163df9..516e5e2 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_fence.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_fence.c
@@ -94,6 +94,24 @@ static u32 amdgpu_fence_read(struct amdgpu_ring *ring)
 	return seq;
 }
 
+/**
+ * amdgpu_fence_save_fence_wptr_start - save the ring wptr at fence emission
+ * @af: the amdgpu fence to save the wptr for
+ *
+ * Together with amdgpu_fence_save_fence_wptr_end() this brackets exactly the
+ * dwords written for the fence command itself. Ring resets re-emit unprocessed
+ * commands from other contexts based on these values.
+ */
+static void amdgpu_fence_save_fence_wptr_start(struct amdgpu_fence *af)
+{
+	af->fence_wptr_start = af->ring->wptr;
+}
+
+static void amdgpu_fence_save_fence_wptr_end(struct amdgpu_fence *af)
+{
+	af->fence_wptr_end = af->ring->wptr;
+}
+
 /**
  * amdgpu_fence_emit - emit a fence on the requested ring
  *
@@ -139,8 +157,10 @@ int amdgpu_fence_emit(struct amdgpu_ring *ring, struct dma_fence **f,
 			       adev->fence_context + ring->idx, seq);
 	}
 
+	amdgpu_fence_save_fence_wptr_start(am_fence);
 	amdgpu_ring_emit_fence(ring, ring->fence_drv.gpu_addr,
 			       seq, flags | AMDGPU_FENCE_FLAG_INT);
+	amdgpu_fence_save_fence_wptr_end(am_fence);
 	amdgpu_fence_save_wptr(fence);
 	pm_runtime_get_noresume(adev_to_drm(adev)->dev);
 	ptr = &ring->fence_drv.fences[seq & ring->fence_drv.num_fences_mask];
@@ -789,6 +809,7 @@ void amdgpu_fence_driver_guilty_force_completion(struct amdgpu_fence *af)
 	struct amdgpu_ring *ring = af->ring;
 	unsigned long flags;
 	u32 seq, last_seq;
+	bool reemitted = false;
 
 	last_seq = amdgpu_fence_read(ring) & ring->fence_drv.num_fences_mask;
 	seq = ring->fence_drv.sync_seq & ring->fence_drv.num_fences_mask;
@@ -806,7 +827,9 @@ void amdgpu_fence_driver_guilty_force_completion(struct amdgpu_fence *af)
 		if (unprocessed && !dma_fence_is_signaled_locked(unprocessed)) {
 			fence = container_of(unprocessed, struct amdgpu_fence, base);
 
-			if (fence == af)
+			if (fence->reemitted > 1)
+				reemitted = true;
+			else if (fence == af)
 				dma_fence_set_error(&fence->base, -ETIME);
 			else if (fence->context == af->context)
 				dma_fence_set_error(&fence->base, -ECANCELED);
@@ -814,6 +837,14 @@ void amdgpu_fence_driver_guilty_force_completion(struct amdgpu_fence *af)
 		rcu_read_unlock();
 	} while (last_seq != seq);
 	spin_unlock_irqrestore(&ring->fence_drv.lock, flags);
+
+	if (reemitted) {
+		/* if we've already reemitted once then just cancel everything */
+		amdgpu_fence_driver_force_completion(ring, &af->base);
+		ring->ring_backup_entries_to_copy = 0;
+		return;
+	}
+
 	/* signal the guilty fence */
 	amdgpu_fence_write(ring, af->seq);
 	amdgpu_fence_process(ring);
@@ -887,10 +918,18 @@ void amdgpu_ring_backup_unprocessed_commands(struct amdgpu_ring *ring,
 			/* save everything if the ring is not guilty, otherwise
 			 * just save the content from other contexts.
 			 */
-			if (!guilty_fence || (fence->context != guilty_fence->context))
+			if (!fence->reemitted &&
+			    (!guilty_fence || (fence->context != guilty_fence->context))) {
 				amdgpu_ring_backup_unprocessed_command(ring, wptr,
 								       fence->wptr);
+			} else if (!fence->reemitted) {
+				/* always save the fence */
+				amdgpu_ring_backup_unprocessed_command(ring,
+								       fence->fence_wptr_start,
+								       fence->fence_wptr_end);
+			}
 			wptr = fence->wptr;
+			fence->reemitted++;
 		}
 		rcu_read_unlock();
 	} while (last_seq != seq);
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_ring.h b/drivers/gpu/drm/amd/amdgpu/amdgpu_ring.h
index 2024aa6..2c6ab4c 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_ring.h
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_ring.h
@@ -147,6 +147,11 @@ struct amdgpu_fence {
 	u64				wptr;
 	/* fence context for resets */
 	u64				context;
+	/* has this fence been reemitted */
+	unsigned int			reemitted;
+	/* wptr for the fence for the submission */
+	u64				fence_wptr_start;
+	u64				fence_wptr_end;
 	uint32_t			seq;
 };
 
