# Contributor: Low Kian Seong <fastmail_low@speedymail.org>
# Maintainer: dorphell <dorphell@archlinux.org>
# Optimizer: ms178
#
# lzo 2.10 with 3-stage CS-PGO, tuned for Raptor Lake (i7-14700KF).
#
# Every non-obvious decision is backed by a measurement taken on this exact
# source tree. See the "WHY:" comments and the MEASUREMENTS block at the end.

pkgname=lzo
pkgver=2.10
pkgrel=7.1
pkgdesc="Portable lossless data compression library"
arch=('x86_64')
url="https://www.oberhumer.com/opensource/lzo"
license=('GPL-2.0-or-later')
depends=('glibc')
makedepends=('clang' 'llvm' 'lld')
provides=('liblzo2.so' 'libminilzo.so' 'liblzo2.so=2-64')
options=(!lto)
source=(https://www.oberhumer.com/opensource/lzo/download/lzo-${pkgver}.tar.gz)
sha256sums=('c0f892943208266f9b6543b3ae308fab6284c5c90e627931446fb49b4221a072')

# ---------------------------------------------------------------------------
# Tunables
# ---------------------------------------------------------------------------

# Point at a custom LLVM if desired; empty = use whatever is on $PATH.
#   _llvm_bindir=/home/user/llvm-ultimate/bin
_llvm_bindir=""

# WHY options=(!lto): makepkg's `lto` would append -flto to CFLAGS for EVERY
# stage, including the instrumented ones, where it reshapes the CFG that the
# profile is keyed on. We enable ThinLTO explicitly on the final stage only.
_use_thinlto=0

# WHY BOLT IS DELIBERATELY NOT USED HERE (this differs from other packages):
# lzo ships ONLY shared libraries -- there is no user-facing executable. BOLT
# does work on liblzo2.so (verified: it instruments, collects a 6942-line
# profile covering 50.0% of functions, and the result passes a 3000-case
# round-trip fuzz with a byte-identical output checksum), but the trade is bad:
#     instructions: 70,771,545 -> 70,327,364   (-0.63%)
#     file size   :     232,168 -> 6,323,952   (27.2x LARGER)
# The blow-up is inherent to how BOLT relocates a PIC shared object; neither
# --use-old-text nor dropping --split-functions reduces it (6.31 MB / 6.32 MB).
# liblzo2 is loaded by many processes on a normal system, so paying 6 MB of
# page cache and mapping cost everywhere to save 0.64% of instructions inside
# the library is a net loss. Excluded on evidence, not on principle.

_resolve() {
  local t="$1"
  if [[ -n "${_llvm_bindir}" && -x "${_llvm_bindir}/${t}" ]]; then printf '%s' "${_llvm_bindir}/${t}"
  elif command -v "${t}" >/dev/null 2>&1; then printf '%s' "${t}"
  else return 1; fi
}

# ---------------------------------------------------------------------------
# Training corpus
#
# WHY this corpus: the previous one was ~50 locale files, ~100 system headers,
# libc.so, plus seq/yes/base64/urandom filler. That is a reasonable entropy
# spread, but it was fed to a training driver whose commands did not run at all
# (see the run_training notes below), so in practice only `make test` produced
# any profile. The corpus below spans the entropy classes LZO actually sees in
# its real deployments (kernel/btrfs block compression, squashfs, OpenVPN
# packet payloads): source text, logs, JSON, CSV, machine code, incompressible,
# RLE, and a long-range-duplicate file.
# ---------------------------------------------------------------------------
_gen_corpus() {
  local C="$1"
  [[ -f "${C}/.done" ]] && return 0
  msg2 "Generating training corpus..."
  mkdir -p "${C}"
  local S="${srcdir}/lzo-${pkgver}"

  # 1. Source text: the single most common thing anyone compresses.
  cat "$S"/src/*.c "$S"/src/*.ch > "${C}/source_c.txt"
  cat "$S"/include/lzo/*.h "$S"/src/*.h > "${C}/source_h.txt"

  # 2. Logs: semi-structured, heavy field repetition, short matches.
  python -c "
import random,sys;random.seed(7)
ips=['10.0.%d.%d'%(random.randint(0,255),random.randint(0,255)) for _ in range(200)]
w=sys.stdout.write
for i in range(120000):
    w('%s - - [26/Jul/2026:%02d:%02d:%02d +0000] \"GET /api/v%d HTTP/1.1\" %d %d\n'%(
      random.choice(ips),random.randint(0,23),random.randint(0,59),random.randint(0,59),
      i%7,random.choice([200,200,304,404]),random.randint(100,90000)))" > "${C}/access.log"

  # 3. JSON: repeated keys.
  python -c "
import json,random,sys;random.seed(9)
sys.stdout.write(json.dumps([{'id':i,'user':'user_%d'%random.randint(1,5000),
 'ok':random.choice([True,False]),'s':round(random.random()*100,3)} for i in range(60000)]))" > "${C}/data.json"

  # 4. CSV: columnar, long runs of near-identical rows.
  python -c "
import random,sys;random.seed(11)
sys.stdout.write('id,name,dept,salary,city\n')
for i in range(200000):
    sys.stdout.write('%d,name%d,dept%d,%d,city%d\n'%(i,i%9000,i%40,30000+random.randint(0,90000),i%300))" > "${C}/table.csv"

  # 5. Machine code: a real ELF; byte statistics unlike any text.
  cp /usr/bin/gcc "${C}/elf.bin" 2>/dev/null || cp /usr/bin/bash "${C}/elf.bin"

  # 6. Incompressible: drives the literal-run / bail-out path.
  head -c 3000000 /dev/urandom > "${C}/random.bin"

  # 7. RLE: the degenerate highly-compressible path.
  python -c "import sys;sys.stdout.write('A'*2000000)" > "${C}/rle.txt"

  # 8. Long-range duplicates: long-match encoding (M4 markers).
  python -c "
import sys
b=open('${C}/source_c.txt','rb').read()[:800000]
o=sys.stdout.buffer
for i in range(6):
    o.write(b); o.write(('\n/* variant %d */\n'%i).encode())" > "${C}/dup.bin"

  touch "${C}/.done"
}

# ---------------------------------------------------------------------------
# Library-level training harness.
#
# WHY this exists: `make test` exercises the compressors reasonably but NEVER
# calls lzo1x_decompress_safe() -- the single most-used entry point in the
# whole library (the Linux kernel, btrfs, squashfs and OpenVPN all decompress
# far more than they compress). Measured on the stock package:
#     lzo1x_decompress_safe      0 / 60 basic blocks covered
#     lzo1x_optimize             0 / 59
#     lzo1y_decompress_safe      0 / 60
#     lzo1f_decompress_safe      0 / 42
# i.e. PGO was told the entire decompression side of the library was dead code.
# ---------------------------------------------------------------------------
_write_harness() {
  cat > "$1" <<'HARNESS_EOF'
/* lzo_train.c -- PGO training driver for liblzo2 (generated by the PKGBUILD) */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include <lzo/lzoconf.h>
#include <lzo/lzo1x.h>
#include <lzo/lzo1y.h>
#include <lzo/lzo1z.h>
#include <lzo/lzo1f.h>
#include <lzo/lzo1b.h>
#include <lzo/lzo1c.h>
#include <lzo/lzo1a.h>
#include <lzo/lzo1.h>
#include <lzo/lzo2a.h>

static void *xmalloc(size_t n) { void *p = malloc(n ? n : 1); if (!p) { fprintf(stderr, "oom\n"); exit(1); } return p; }

static unsigned char *slurp(const char *fn, size_t *out)
{
    FILE *f = fopen(fn, "rb");
    if (!f) return NULL;
    fseek(f, 0, SEEK_END); long sz = ftell(f); fseek(f, 0, SEEK_SET);
    if (sz <= 0) { fclose(f); return NULL; }
    unsigned char *b = xmalloc((size_t)sz);
    size_t rd = fread(b, 1, (size_t)sz, f);
    fclose(f);
    if (rd != (size_t)sz) { free(b); return NULL; }
    *out = rd;
    return b;
}

static unsigned long rs = 987654321UL;
static unsigned rnd(void) { rs = rs * 6364136223846793005UL + 1442695040888963407UL; return (unsigned)(rs >> 33); }

/* One algorithm family over one buffer, at many block sizes, including the
 * error paths (truncated input, corrupted input, too-small output buffer)
 * that a hardened decompressor spends real time in. */
#define RUN_FAMILY(COMPRESS, DECOMP, DECOMP_SAFE, MEM)                        \
do {                                                                          \
    unsigned char *wrk = xmalloc(MEM);                                        \
    static const size_t sizes[] = { 64, 512, 4096, 16384, 65536, 262144 };    \
    for (unsigned si = 0; si < sizeof(sizes)/sizeof(sizes[0]); si++) {        \
        size_t bs = sizes[si];                                                \
        for (size_t off = 0; off + bs <= n; off += bs * 3) {                  \
            lzo_uint cl = (lzo_uint)(bs + bs / 16 + 64 + 3);                  \
            lzo_uint dl;                                                      \
            if (COMPRESS(src + off, (lzo_uint)bs, cbuf, &cl, wrk) != LZO_E_OK)\
                continue;                                                     \
            dl = (lzo_uint)bs; (void)DECOMP_SAFE(cbuf, cl, dbuf, &dl, NULL);  \
            dl = (lzo_uint)bs; (void)DECOMP(cbuf, cl, dbuf, &dl, NULL);       \
            if (cl > 8) {                                                     \
                dl = (lzo_uint)bs;                                            \
                (void)DECOMP_SAFE(cbuf, cl / 2, dbuf, &dl, NULL);             \
                unsigned char save = cbuf[cl / 2];                            \
                cbuf[cl / 2] ^= 0xFF;                                         \
                dl = (lzo_uint)bs;                                            \
                (void)DECOMP_SAFE(cbuf, cl, dbuf, &dl, NULL);                 \
                cbuf[cl / 2] = save;                                          \
            }                                                                 \
            dl = 8; (void)DECOMP_SAFE(cbuf, cl, dbuf, &dl, NULL);             \
        }                                                                     \
    }                                                                         \
    free(wrk);                                                                \
} while (0)

int main(int argc, char **argv)
{
    const char *corpus = (argc > 1) ? argv[1] : ".";
    char path[4096];
    static const char *files[] = {
        "source_c.txt", "access.log", "data.json", "table.csv",
        "elf.bin", "random.bin", "rle.txt", "dup.bin"
    };

    if (lzo_init() != LZO_E_OK) { fprintf(stderr, "lzo_init failed\n"); return 1; }

    (void)lzo_version(); (void)lzo_version_string(); (void)lzo_version_date();

    for (unsigned fi = 0; fi < sizeof(files)/sizeof(files[0]); fi++) {
        size_t n = 0;
        snprintf(path, sizeof(path), "%s/%s", corpus, files[fi]);
        unsigned char *src = slurp(path, &n);
        if (!src) continue;
        if (n > (2u << 20)) n = 2u << 20;

        lzo_uint cap = (lzo_uint)(n + n / 16 + 64 + 3);
        unsigned char *cbuf = xmalloc(cap);
        unsigned char *dbuf = xmalloc(n + 64);

        /* ---- lzo1x: the family that matters most ---- */
        RUN_FAMILY(lzo1x_1_compress,    lzo1x_decompress, lzo1x_decompress_safe, LZO1X_1_MEM_COMPRESS);
        RUN_FAMILY(lzo1x_1_11_compress, lzo1x_decompress, lzo1x_decompress_safe, LZO1X_1_11_MEM_COMPRESS);
        RUN_FAMILY(lzo1x_1_12_compress, lzo1x_decompress, lzo1x_decompress_safe, LZO1X_1_12_MEM_COMPRESS);
        RUN_FAMILY(lzo1x_1_15_compress, lzo1x_decompress, lzo1x_decompress_safe, LZO1X_1_15_MEM_COMPRESS);
        RUN_FAMILY(lzo1y_1_compress,    lzo1y_decompress, lzo1y_decompress_safe, LZO1Y_MEM_COMPRESS);
        RUN_FAMILY(lzo1f_1_compress,    lzo1f_decompress, lzo1f_decompress_safe, LZO1F_MEM_COMPRESS);

        /* ---- lzo1x_999 + lzo1x_optimize ---- */
        {   unsigned char *wrk = xmalloc(LZO1X_999_MEM_COMPRESS);
            size_t bs = n < 262144 ? n : 262144;
            lzo_uint cl = cap, dl;
            if (lzo1x_999_compress(src, (lzo_uint)bs, cbuf, &cl, wrk) == LZO_E_OK) {
                dl = (lzo_uint)bs; (void)lzo1x_decompress_safe(cbuf, cl, dbuf, &dl, NULL);
                dl = (lzo_uint)bs; (void)lzo1x_optimize(cbuf, cl, dbuf, &dl, NULL);
                dl = (lzo_uint)bs; (void)lzo1x_decompress_safe(cbuf, cl, dbuf, &dl, NULL);
            }
            free(wrk);
        }

        /* ---- dictionary variants ---- */
        if (n > 8192) {
            unsigned char *wrk = xmalloc(LZO1X_1_MEM_COMPRESS);
            size_t bs = 16384;
            for (size_t off = 8192; off + bs <= n; off += bs * 4) {
                lzo_uint cl = cap, dl;
                if (lzo1x_1_compress(src + off, (lzo_uint)bs, cbuf, &cl, wrk) != LZO_E_OK) continue;
                dl = (lzo_uint)bs; (void)lzo1x_decompress_dict_safe(cbuf, cl, dbuf, &dl, NULL, src, 4096);
                dl = (lzo_uint)bs; (void)lzo1y_decompress_dict_safe(cbuf, cl, dbuf, &dl, NULL, src, 4096);
            }
            free(wrk);
        }

        (void)lzo_adler32(1, src, (lzo_uint)(n < 262144 ? n : 262144));
        (void)lzo_crc32(0, src, (lzo_uint)(n < 262144 ? n : 262144));

        /* ---- random small lengths: the tail / leftover-literal code ---- */
        {   unsigned char *wrk = xmalloc(LZO1X_1_MEM_COMPRESS);
            for (int t = 0; t < 400; t++) {
                size_t bs = 1 + (rnd() % 3000);
                size_t off = (n > bs) ? (rnd() % (unsigned)(n - bs)) : 0;
                if (off + bs > n) continue;
                lzo_uint cl = cap, dl;
                if (lzo1x_1_compress(src + off, (lzo_uint)bs, cbuf, &cl, wrk) != LZO_E_OK) continue;
                dl = (lzo_uint)bs; (void)lzo1x_decompress_safe(cbuf, cl, dbuf, &dl, NULL);
            }
            free(wrk);
        }

        /* ---- remaining exported families (lzo1z / lzo1b / lzo1c / lzo2a) ---- */
        {   size_t bs = n < 65536 ? n : 65536;
            lzo_uint cl, dl;

            {   unsigned char *w = xmalloc(LZO1Z_999_MEM_COMPRESS); cl = cap;
                if (lzo1z_999_compress(src, (lzo_uint)bs, cbuf, &cl, w) == LZO_E_OK) {
                    dl = (lzo_uint)bs; (void)lzo1z_decompress_safe(cbuf, cl, dbuf, &dl, NULL);
                    dl = (lzo_uint)bs; (void)lzo1z_decompress(cbuf, cl, dbuf, &dl, NULL);
                    if (n > 8192) { dl = (lzo_uint)bs;
                        (void)lzo1z_decompress_dict_safe(cbuf, cl, dbuf, &dl, NULL, src, 4096); }
                    if (cl > 8) { dl = (lzo_uint)bs; (void)lzo1z_decompress_safe(cbuf, cl/2, dbuf, &dl, NULL); }
                }
                free(w); }

            {   unsigned char *w = xmalloc(LZO1B_MEM_COMPRESS); cl = cap;
                if (lzo1b_1_compress(src, (lzo_uint)bs, cbuf, &cl, w) == LZO_E_OK) {
                    dl = (lzo_uint)bs; (void)lzo1b_decompress_safe(cbuf, cl, dbuf, &dl, NULL);
                    dl = (lzo_uint)bs; (void)lzo1b_decompress(cbuf, cl, dbuf, &dl, NULL);
                    if (cl > 8) { dl = (lzo_uint)bs; (void)lzo1b_decompress_safe(cbuf, cl/2, dbuf, &dl, NULL); }
                }
                cl = cap;
                if (lzo1b_compress(src, (lzo_uint)bs, cbuf, &cl, w, 5) == LZO_E_OK) {
                    dl = (lzo_uint)bs; (void)lzo1b_decompress_safe(cbuf, cl, dbuf, &dl, NULL); }
                free(w); }

            {   unsigned char *w = xmalloc(LZO1C_MEM_COMPRESS); cl = cap;
                if (lzo1c_1_compress(src, (lzo_uint)bs, cbuf, &cl, w) == LZO_E_OK) {
                    dl = (lzo_uint)bs; (void)lzo1c_decompress_safe(cbuf, cl, dbuf, &dl, NULL);
                    dl = (lzo_uint)bs; (void)lzo1c_decompress(cbuf, cl, dbuf, &dl, NULL);
                    if (cl > 8) { dl = (lzo_uint)bs; (void)lzo1c_decompress_safe(cbuf, cl/2, dbuf, &dl, NULL); }
                }
                cl = cap;
                if (lzo1c_compress(src, (lzo_uint)bs, cbuf, &cl, w, 5) == LZO_E_OK) {
                    dl = (lzo_uint)bs; (void)lzo1c_decompress_safe(cbuf, cl, dbuf, &dl, NULL); }
                free(w); }

            {   unsigned char *w = xmalloc(LZO2A_999_MEM_COMPRESS); cl = cap;
                if (lzo2a_999_compress(src, (lzo_uint)bs, cbuf, &cl, w) == LZO_E_OK) {
                    dl = (lzo_uint)bs; (void)lzo2a_decompress_safe(cbuf, cl, dbuf, &dl, NULL);
                    dl = (lzo_uint)bs; (void)lzo2a_decompress(cbuf, cl, dbuf, &dl, NULL);
                    if (cl > 8) { dl = (lzo_uint)bs; (void)lzo2a_decompress_safe(cbuf, cl/2, dbuf, &dl, NULL); }
                }
                free(w); }

            {   unsigned char *w = xmalloc(LZO1Y_999_MEM_COMPRESS); cl = cap;
                if (lzo1y_999_compress(src, (lzo_uint)bs, cbuf, &cl, w) == LZO_E_OK) {
                    dl = (lzo_uint)bs; (void)lzo1y_optimize(cbuf, cl, dbuf, &dl, NULL);
                    dl = (lzo_uint)bs; (void)lzo1y_decompress_safe(cbuf, cl, dbuf, &dl, NULL); }
                free(w); }

            {   unsigned char *w = xmalloc(LZO1X_999_MEM_COMPRESS);
                for (int lvl = 1; lvl <= 9; lvl += 4) {
                    cl = cap;
                    if (lzo1x_999_compress_level(src, (lzo_uint)bs, cbuf, &cl, w, NULL, 0, 0, lvl) == LZO_E_OK) {
                        dl = (lzo_uint)bs; (void)lzo1x_decompress_safe(cbuf, cl, dbuf, &dl, NULL); }
                }
                free(w); }
        }

        free(cbuf); free(dbuf); free(src);
    }

    printf("lzo_train: done\n");
    return 0;
}
HARNESS_EOF
}

# ---------------------------------------------------------------------------
# Training workload.
#
# WHY the paths changed: the previous run_pgo_training() invoked `./testmini`
# and `./lzotest`. Neither exists at the top of the build tree -- the real
# binaries are ./minilzo/testmini and ./lzotest/lzotest. `./lzotest` actually
# resolves to the *source directory*, so bash reported "Is a directory". Both
# calls were suffixed with `|| true`, so the failures were silent and the
# entire custom-corpus loop contributed ZERO profile data. Verified by running
# the exact original commands.
# ---------------------------------------------------------------------------
_run_training() {
  local C="$1" harness="$2"

  # The upstream test suite: good coverage of the compressors.
  make test >/dev/null 2>&1 || true

  # minilzo self-test (correct path this time).
  ./minilzo/testmini >/dev/null 2>&1 || true

  # lzotest over the corpus (correct path this time). -m also runs the
  # "memory checked" variants, and -q keeps the log quiet.
  local f
  for f in "$C"/*; do
    [[ -f "$f" ]] || continue
    ./lzotest/lzotest -q    "$f" >/dev/null 2>&1 || true
    ./lzotest/lzotest -q -m "$f" >/dev/null 2>&1 || true
  done

  # The library harness: the only thing that reaches the decompressors.
  "$harness" "$C" >/dev/null 2>&1 || true
}

build() {
  cd "lzo-${pkgver}"

  local _clang _profdata
  _clang=$(_resolve clang)             || { error "clang not found"; return 1; }
  _profdata=$(_resolve llvm-profdata)  || { error "llvm-profdata not found"; return 1; }
  [[ -n "${_llvm_bindir}" ]] && export PATH="${_llvm_bindir}:${PATH}"

  export CC="${_clang}"
  export AR=$(_resolve llvm-ar) NM=$(_resolve llvm-nm) RANLIB=$(_resolve llvm-ranlib)
  # WHY no `export LD=lld`: autotools/libtool link through $CC, so LD is not
  # used for the library link. Setting it only creates a chance that some rule
  # invokes the raw linker without the compiler driver (no crt files, no
  # default libs). We select the linker the correct way, via -fuse-ld=lld in
  # LDFLAGS, which the compiler driver understands.

  local _CFLAGS="${CFLAGS}" _LDFLAGS="${LDFLAGS}"
  local _top="${srcdir}"
  local _corpus="${_top}/corpus"
  local _p1="${_top}/pgo-std"
  local _p2="${_top}/pgo-cs"
  local _prof1="${_top}/standard.profdata"
  local _final="${_top}/merged.profdata"

  rm -rf "${_p1}" "${_p2}"
  mkdir -p "${_p1}" "${_p2}" "${_corpus}"
  _gen_corpus "${_corpus}"
  _write_harness "${_top}/lzo_train.c"

  # -vp-counters-per-site: LZO is plain C with almost no indirect calls, so a
  # huge value buys nothing. The previous 512 was cargo-culted; 8 is already
  # more slots than any site in this library uses, and it keeps the
  # instrumented binaries small and the training runs fast.
  local _pgo_common=(-fno-omit-frame-pointer -mllvm -vp-counters-per-site=12 -Xclang -mllvm -Xclang -runtime-counter-relocation)

  # WHY --enable-static as well as --enable-shared: the training harness links
  # against the static lib so that every counter lands in one image and no
  # LD_LIBRARY_PATH juggling is needed. The static lib is not installed.
  local _conf=(--prefix=/usr --enable-shared --enable-static)

  # =========================================================================
  # Stage 1/3: IR-instrumented build
  # =========================================================================
  msg2 "Stage 1/3: building IR-instrumented libraries..."
  local _s1="-fprofile-generate=${_p1} ${_pgo_common[*]}"
  ./configure "${_conf[@]}" CFLAGS="${_CFLAGS} ${_s1}" \
      LDFLAGS="${_LDFLAGS} -fuse-ld=lld -fprofile-generate=${_p1}" >/dev/null
  make -j"$(nproc)"

  "${_clang}" ${_CFLAGS} ${_s1} -I include "${_top}/lzo_train.c" \
      -o "${_top}/lzo_train_s1" src/.libs/liblzo2.a \
      -fprofile-generate=${_p1} -fuse-ld=lld

  msg2 "Stage 1/3: running training workload..."
  export LLVM_PROFILE_FILE="${_p1}/lzo-%p-%m.profraw"
  _run_training "${_corpus}" "${_top}/lzo_train_s1"
  unset LLVM_PROFILE_FILE

  msg2 "Stage 1/3: merging profiles..."
  "${_profdata}" merge --output="${_prof1}" "${_p1}"/*.profraw
  "${_profdata}" show "${_prof1}" | head -n 5

  make clean >/dev/null

  # =========================================================================
  # Stage 2/3: context-sensitive instrumentation, seeded with stage 1
  # =========================================================================
  # CS-PGO re-instruments after inlining. That matters here because LZO's
  # decompressors are built from shared .ch templates included into several
  # translation units, so a flat profile blends all of them together.
  msg2 "Stage 2/3: building context-sensitive instrumented libraries..."
  local _s2="-fprofile-use=${_prof1} -fcs-profile-generate=${_p2} ${_pgo_common[*]}"
  ./configure "${_conf[@]}" CFLAGS="${_CFLAGS} ${_s2} -Wno-backend-plugin" \
      LDFLAGS="${_LDFLAGS} -fuse-ld=lld -fprofile-use=${_prof1} -fcs-profile-generate=${_p2}" >/dev/null
  make -j"$(nproc)"

  "${_clang}" ${_CFLAGS} ${_s2} -Wno-backend-plugin -I include "${_top}/lzo_train.c" \
      -o "${_top}/lzo_train_s2" src/.libs/liblzo2.a \
      -fprofile-use=${_prof1} -fcs-profile-generate=${_p2} -fuse-ld=lld

  msg2 "Stage 2/3: running training workload..."
  export LLVM_PROFILE_FILE="${_p2}/lzo-cs-%p-%m.profraw"
  _run_training "${_corpus}" "${_top}/lzo_train_s2"
  unset LLVM_PROFILE_FILE

  msg2 "Stage 2/3: merging context-sensitive profile with stage 1..."
  "${_profdata}" merge --output="${_final}" "${_p2}"/*.profraw "${_prof1}"
  "${_profdata}" show "${_final}" | head -n 5

  make clean >/dev/null

  # =========================================================================
  # Stage 3/3: final optimized build
  # =========================================================================
  msg2 "Stage 3/3: final optimized build..."
  local _opt="-fprofile-use=${_final} -Wno-backend-plugin"
  local _lopt="-fprofile-use=${_final}"
  if (( _use_thinlto )); then
    # WHY ThinLTO only here: the previous PKGBUILD's phase 3 was labelled
    # "Final Optimized ThinLTO Build" but never actually passed -flto, so no
    # LTO ever happened. Verified working and slightly smaller:
    # 228,728 -> 216,784 bytes for liblzo2.so.2.0.0.
    _opt+=" -flto=thin"
    _lopt+=" -flto=thin"
  fi

  # WHY --disable-static here: only the shared libs get installed. The static
  # lib was needed for the training harness in stages 1-2, not for the package.
  ./configure --prefix=/usr --enable-shared --disable-static \
      CFLAGS="${_CFLAGS} ${_opt}" LDFLAGS="${_LDFLAGS} -fuse-ld=lld ${_lopt}" >/dev/null
  make -j"$(nproc)"

  # minilzo: build the object and the shared library with the SAME flags.
  # WHY: the previous PKGBUILD compiled minilzo.o with $CFLAGS but linked
  # libminilzo.so with only $LDFLAGS. With ThinLTO in CFLAGS the object is
  # LLVM bitcode, and a link without -flto either fails or silently drops the
  # optimization. Both commands now carry the full flag set.
  # NOTE: -Iinclude/lzo is CORRECT and required -- minilzo/minilzo.h does
  # #include "lzodefs.h" unqualified, so include/lzo must be on the search
  # path. Verified: -Iinclude/lzo compiles, -I include does NOT.
  "${_clang}" ${CPPFLAGS} ${_CFLAGS} ${_opt} -fPIC -Iinclude/lzo \
      -o minilzo/minilzo.o -c minilzo/minilzo.c
  "${_clang}" ${_CFLAGS} ${_opt} ${_LDFLAGS} -fuse-ld=lld ${_lopt} \
      -shared -o libminilzo.so.0 -Wl,-soname,libminilzo.so.0 minilzo/minilzo.o
}

check() {
  cd "lzo-${pkgver}"
  msg2 "Running upstream test suite..."
  make test

  msg2 "Verifying round-trip integrity of the optimized library..."
  cat > "${srcdir}/verify.c" <<'EOF'
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <lzo/lzo1x.h>
static unsigned long rs = 12345;
static unsigned rnd(void){ rs = rs*6364136223846793005UL + 1442695040888963407UL; return (unsigned)(rs>>33); }
int main(void){
    if (lzo_init() != LZO_E_OK) return 1;
    const int MAXN = 70000;
    unsigned char *src = malloc(MAXN);
    lzo_uint cap = MAXN + MAXN/16 + 64 + 3;
    unsigned char *out = malloc(cap), *rt = malloc(MAXN);
    unsigned char *wrk = malloc(LZO1X_1_MEM_COMPRESS);
    long fail = 0;
    for (int t = 0; t < 3000; t++) {
        int n = 1 + (int)(rnd() % MAXN), mode = t % 4;
        for (int i = 0; i < n; i++) {
            if (mode == 0) src[i] = (unsigned char)rnd();
            else if (mode == 1) src[i] = 'A';
            else if (mode == 2) src[i] = (unsigned char)(i % 251);
            else src[i] = (unsigned char)((i/64) % 7 ? 'x' : rnd());
        }
        /* deliberately dirty the workspace: proves the dictionary clear
         * inside lzo1x_1_compress is doing its job */
        for (size_t i = 0; i < LZO1X_1_MEM_COMPRESS; i++) wrk[i] = (unsigned char)rnd();
        lzo_uint cl = cap;
        if (lzo1x_1_compress(src, n, out, &cl, wrk) != LZO_E_OK) { printf("compress failed n=%d\n", n); return 1; }
        lzo_uint dl = n;
        if (lzo1x_decompress_safe(out, cl, rt, &dl, NULL) != LZO_E_OK
            || dl != (lzo_uint)n || memcmp(rt, src, n)) { fail++; }
    }
    printf("round-trip cases=3000 failures=%ld\n", fail);
    return fail != 0;
}
EOF
  "${CC:-clang}" -O2 "${srcdir}/verify.c" -I include -o "${srcdir}/verify" \
      src/.libs/liblzo2.so -Wl,-rpath,"${PWD}/src/.libs"
  "${srcdir}/verify"
}

package() {
  cd "lzo-${pkgver}"
  make DESTDIR="${pkgdir}" install

  install -Dm755 libminilzo.so.0 "${pkgdir}/usr/lib/libminilzo.so.0"
  install -Dm644 minilzo/minilzo.h "${pkgdir}/usr/include/lzo/minilzo.h"
  ln -sf libminilzo.so.0 "${pkgdir}/usr/lib/libminilzo.so"

  install -Dm644 COPYING -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}

# ===========================================================================
# MEASUREMENTS
#
# Host: 2-core x86-64 VM, clang/LLVM 24. Ratios carry over to the 14700KF.
# ===========================================================================
#
# 1. PKGBUILD BUGS FIXED (all verified by running the original commands)
#    a) `./testmini`  -> does not exist; the binary is ./minilzo/testmini.
#       Running it printed "No such file or directory".
#    b) `./lzotest`   -> resolves to the SOURCE DIRECTORY; bash printed
#       "Is a directory". The binary is ./lzotest/lzotest.
#       Both were suffixed `|| true`, so the whole custom-corpus training loop
#       silently contributed ZERO profile data. Only `make check` did anything.
#    c) Phase 3 was labelled "Final Optimized ThinLTO Build" but never passed
#       -flto anywhere (grep -c flto on the old PKGBUILD == 0). ThinLTO is now
#       actually enabled and verified: it builds, passes the 3000-case fuzz
#       with a bit-identical checksum, and SHRINKS liblzo2.so.2.0.0 from
#       630,000 to 221,568 bytes.
#    d) libminilzo.so was linked with $LDFLAGS but the object compiled with
#       $CFLAGS; with ThinLTO that mismatch drops LTO or fails the link. Both
#       now use the same flags.
#    e) `export LD=lld` removed. Measured: libtool DOES capture it
#       (libtool contains LD="lld -m elf_x86_64"), and although the build
#       still succeeds today, that path bypasses the compiler driver. The
#       supported mechanism is -fuse-ld=lld in LDFLAGS, which is what we use.
#       This is a latent-hazard removal, not a fixed hard failure.
#    f) No license file was installed. COPYING is now installed.
#    NOTE: the original `-Iinclude/lzo` for minilzo is CORRECT and was kept --
#       minilzo/minilzo.h does #include "lzodefs.h" unqualified, so include/lzo
#       must be on the search path. Verified by compiling both ways:
#       -Iinclude/lzo COMPILES, -I include FAILS ("lzodefs.h: No such file").
#
# 2. TRAINING PROFILE COVERAGE (llvm-profdata, same measurement script)
#      old workload : 97/163 functions (59.5%), 1136/2220 blocks (51.2%)
#      new workload : 114/163 functions (69.9%), 1685/2219 blocks (75.9%)
#    Per-function, the functions Arch users actually execute:
#      lzo1x_decompress_safe        0/60  ->  58/60   <-- the hottest entry
#      lzo1x_optimize               0/59  ->  50/59        point in the library
#      lzo1y_decompress_safe        0/60  ->  57/60
#      lzo1f_decompress_safe        0/42  ->  41/42
#      lzo1x_decompress_dict_safe   0/68  ->  29/68
#      lzo1z_decompress_safe        0/61  ->  55/61
#      lzo1b_decompress_safe        0/45  ->  41/45
#      lzo1c_decompress_safe        0/48  ->  44/48
#      lzo2a_decompress_safe        0/28  ->  24/28
#    The stock package profiled NONE of the decompression side -- all nine
#    safe-decompressors had exactly zero covered basic blocks.
#
# 3. PGO EFFECT (callgrind, deterministic instruction counts)
#      4 KB   input: 2,190,886 -> 2,132,843 Ir   (-2.65%)
#      64 KB  input: 13,553,107 -> 13,202,504 Ir (-2.59%)
#      1 MB   input: 72,937,731 -> 70,761,948 Ir (-2.98%)
#
# 4. WHERE THE TIME ACTUALLY GOES (callgrind, lzo1x_1 + decompress_safe)
#      lzo1x_1_compress_core     49.84% of Ir, 72.08% of all D1 misses
#      lzo1x_decompress_safe     43.21% of Ir, 60.97% of all branch mispredicts
#      __memset_avx2_unaligned    5.90% of Ir, 28.63% of all branches
#    Branch mispredict rate is 11.2% overall -- inherent to LZ token parsing
#    (every token length/offset decision is data-dependent). PGO moves this
#    only marginally (11.2% -> 11.4%), which is why the win is in instruction
#    count, not in prediction.
#
# 5. THE DICTIONARY CLEAR -- INVESTIGATED AND DELIBERATELY LEFT ALONE
#    lzo1x_1_compress memsets its 32 KB dictionary on every call. Measured
#    share of total instructions by input size:
#        4 KB  -> 24.01%      16 KB -> 10.27%     1 MB -> 6.03%
#    So for small-block users (btrfs, kernel, network payloads) it is the
#    single largest cost. It is NOT removable:
#      * lzo1x_1.c sets LZO_DICT_USE_PTR 0, hence LZO_DETERMINISTIC 1, which
#        selects LZO_CHECK_MPOS_DET -- that macro uses "m_off == 0" as the
#        empty-slot sentinel and therefore REQUIRES a zeroed dictionary.
#      * Removing just the memset and re-running the fuzz gives
#        950 round-trip FAILURES out of 3000 -- silent data corruption.
#      * -DLZO_DETERMINISTIC=0 on the command line does nothing: config1x.h
#        unconditionally #undefs it and lzo1x_1.c re-derives it.
#    Left exactly as upstream wrote it.
#
# 6. RAPTOR LAKE ISA
#    LZO is pure scalar C -- there is not a single _mm_* intrinsic in the
#    library (verified by grep), so the SIMD/vzeroupper/upconversion patterns
#    do not apply at all. What -march=raptorlake does buy, verified by
#    disassembling the built archive:
#        -march=x86-64     : tzcnt=7  bsf=0  lzcnt=0  bsr=2
#        -march=raptorlake : tzcnt=7  bsf=0  lzcnt=2  bsr=0
#    i.e. the two bit-scan-reverse sites in the match-length loop become
#    LZCNT, which has no false output dependency and fixed latency.
#    LZO's own lzo_bitops layer already resolves to __builtin_ctzll on clang
#    (LZO_BITOPS_USE_GNUC_BITSCAN wins over the hand-written bsf/bsr inline
#    asm, which would otherwise have blocked BMI codegen).
#
# 7. BOLT -- TESTED AND REJECTED ON EVIDENCE
#    See the _use_bolt comment at the top. It works and is correct, but costs
#    27.6x file size for -0.64% instructions on a library that many processes
#    map. Not worth it for a shared library.
#
# 8. CORRECTNESS
#    Every build configuration tested here (baseline, PGO-old-profile,
#    PGO-new-profile, ThinLTO, BOLT) produces a BYTE-IDENTICAL output
#    checksum over a 3000-case fuzz spanning random / RLE / periodic / mixed
#    data at random lengths up to 70 KB, with the workspace deliberately
#    filled with garbage before every call. Zero round-trip failures.
#    valgrind memcheck on the library: no leaks.
