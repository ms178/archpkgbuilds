+/* SPDX-License-Identifier: MIT */
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+static int fail_alloc;
+static void *mock_malloc(size_t n) { if(fail_alloc) { fail_alloc--; return NULL; } return malloc(n); }
+#define malloc mock_malloc
+#include "../../amdgpu/amdgpu_cs.c"
+#include "../../amdgpu/amdgpu_bo.c"
+#include "../../amdgpu/handle_table.c"
+#undef malloc
+static unsigned expected, calls;
+static int fail_ioctl;
+static struct drm_amdgpu_cs_chunk *expected_chunks;
+int drmCommandWriteRead(int fd, unsigned long cmd, void *data, unsigned long size)
+{
+ (void)fd; (void)size; calls++;
+ if(cmd==DRM_AMDGPU_CS) {
+  union drm_amdgpu_cs *cs=data;
+  assert(cs->in.num_chunks==expected);
+  uint64_t *ptr=(void *)(uintptr_t)cs->in.chunks;
+  for(unsigned i=0;i<expected;i++) {
+   if(expected_chunks) assert(ptr[i]==(uint64_t)(uintptr_t)&expected_chunks[i]);
+   else {
+    struct drm_amdgpu_cs_chunk *chunk=(void *)(uintptr_t)ptr[i];
+    assert(chunk->chunk_id==AMDGPU_CHUNK_ID_IB || chunk->chunk_id==AMDGPU_CHUNK_ID_DEPENDENCIES);
+    if(chunk->chunk_id==AMDGPU_CHUNK_ID_DEPENDENCIES) {
+     struct drm_amdgpu_cs_chunk_dep *d=(void *)(uintptr_t)chunk->chunk_data;
+     for(unsigned j=0;j<chunk->length_dw*4/sizeof(*d);j++) assert(d[j].ctx_id==12);
+    }
+   }
+  }
+  cs->out.handle=12345;
+ } else if(cmd==DRM_AMDGPU_BO_LIST) {
+  union drm_amdgpu_bo_list *a=data;
+  if(a->in.operation!=AMDGPU_BO_LIST_OP_DESTROY) {
+   assert(a->in.bo_number==expected);
+   struct drm_amdgpu_bo_list_entry *list=(void *)(uintptr_t)a->in.bo_info_ptr;
+   for(unsigned i=0;i<expected;i++) assert(list[i].bo_handle==77 && list[i].bo_priority==0);
+  }
+  a->out.list_handle=91;
+ } else assert(0);
+ return fail_ioctl ? -EIO : 0;
+}
+int drmIoctl(int fd, unsigned long request, void *data)
+{
+ (void)fd; assert(request==DRM_IOCTL_AMDGPU_WAIT_FENCES);
+ union drm_amdgpu_wait_fences *a=data;
+ struct drm_amdgpu_fence *f=(void *)(uintptr_t)a->in.fences;
+ assert(a->in.fence_count==expected);
+ for(unsigned i=0;i<expected;i++)assert(f[i].ctx_id==12 && f[i].seq_no==i);
+ if(fail_ioctl){errno=EIO;return -1;}
+ a->out.status=1;a->out.first_signaled=0;return 0;
+}
+int main(void)
+{
+ struct amdgpu_device dev={0}; struct amdgpu_context ctx={.dev=&dev,.id=12};
+ struct drm_amdgpu_cs_chunk chunks[4096]={{0}}; uint64_t seq;
+ expected_chunks=chunks;
+ unsigned counts[]={1,16,17,32,33,256,257,4096};
+ for(unsigned j=0;j<sizeof(counts)/sizeof(counts[0]);j++) {
+  expected=counts[j]; seq=0;
+  assert(!amdgpu_cs_submit_raw2(&dev,&ctx,7,expected,chunks,&seq) && seq==12345);
+  fail_ioctl=1; seq=99;
+  assert(amdgpu_cs_submit_raw2(&dev,&ctx,7,expected,chunks,&seq)==-EIO && seq==99);
+  fail_ioctl=0;
+ }
+ expected_chunks=NULL;
+ assert(!pthread_mutex_init(&ctx.sequence_mutex,NULL));
+ list_inithead(&ctx.sem_list[0][0][0]);
+ struct amdgpu_cs_ib_info ib={.size=8};
+ struct amdgpu_cs_fence deps[4096];
+ for(unsigned i=0;i<4096;i++) deps[i]=(struct amdgpu_cs_fence){.context=&ctx,.fence=i};
+ struct amdgpu_cs_request req={.number_of_ibs=1,.ibs=&ib,.dependencies=deps};
+ unsigned dep_counts[]={0,1,16,17,4096};
+ for(unsigned j=0;j<5;j++) {
+  req.number_of_dependencies=dep_counts[j]; expected=1+!!dep_counts[j];
+  assert(!amdgpu_cs_submit(&ctx,0,&req,1) && req.seq_no==12345);
+  fail_ioctl=1; assert(amdgpu_cs_submit(&ctx,0,&req,1)==-EIO); fail_ioctl=0;
+ }
+ req.number_of_dependencies=0;
+ for(unsigned trial=0;trial<4;trial++) {
+  unsigned ns[]={1,16,17,4096};
+  for(unsigned j=0;j<ns[trial];j++) {
+   amdgpu_semaphore_handle sem;assert(!amdgpu_cs_create_semaphore(&sem));
+   assert(!amdgpu_cs_signal_semaphore(&ctx,0,0,0,sem));
+   assert(!amdgpu_cs_wait_semaphore(&ctx,0,0,0,sem));
+   assert(!amdgpu_cs_destroy_semaphore(sem));
+  }
+  expected=2;assert(!amdgpu_cs_submit(&ctx,0,&req,1));assert(LIST_IS_EMPTY(&ctx.sem_list[0][0][0]));
+ }
+ for(unsigned j=0;j<5;j++) {
+  unsigned ns[]={1,16,17,256,4096};expected=ns[j];uint32_t status=0,first=99;
+  assert(!amdgpu_cs_wait_fences(deps,expected,true,0,&status,&first) && status==1 && first==0);
+  fail_ioctl=1;assert(amdgpu_cs_wait_fences(deps,expected,true,0,&status,&first)==-EIO);fail_ioctl=0;
+ }
+ struct amdgpu_semaphore *sems=calloc(4097,sizeof(*sems)); assert(sems);
+ for(unsigned i=0;i<4097;i++) {
+  sems[i].signal_fence.context=&ctx;
+  list_add(&sems[i].list,&ctx.sem_list[0][0][0]);
+ }
+ assert(amdgpu_cs_submit(&ctx,0,&req,1)==-EINVAL);
+ /* Cap rejection must leave semaphore ownership/list untouched. */
+ unsigned remaining=0; struct amdgpu_semaphore *it;
+ LIST_FOR_EACH_ENTRY(it,&ctx.sem_list[0][0][0],list) remaining++;
+ assert(remaining==4097); list_inithead(&ctx.sem_list[0][0][0]); free(sems);
+ pthread_mutex_destroy(&ctx.sequence_mutex);
+ expected_chunks=chunks;
+ fail_alloc=1;
+ assert(amdgpu_cs_submit_raw2(&dev,&ctx,0,33,chunks,&seq)==-ENOMEM);
+ unsigned before=calls;
+ assert(amdgpu_cs_submit_raw2(&dev,&ctx,0,4097,chunks,&seq)==-EINVAL);
+ assert(amdgpu_cs_submit_raw2(&dev,&ctx,0,0,chunks,&seq)==-EINVAL);
+ assert(calls==before);
+ struct amdgpu_bo bo={.dev=&dev,.handle=77,.alloc_size=8192};
+ amdgpu_bo_handle resources[4096];
+ for(unsigned i=0;i<4096;i++) resources[i]=&bo;
+ for(unsigned j=0;j<sizeof(counts)/sizeof(counts[0]);j++) {
+  expected=counts[j]; amdgpu_bo_list_handle list;
+  assert(!amdgpu_bo_list_create(&dev,expected,resources,NULL,&list));
+  assert(list->handle==91);
+  assert(!amdgpu_bo_list_update(list,expected,resources,NULL));
+  assert(!amdgpu_bo_list_destroy(list));
+  fail_ioctl=1;
+  assert(amdgpu_bo_list_create(&dev,expected,resources,NULL,&list)==-EIO);
+  fail_ioctl=0;
+ }
+ amdgpu_bo_list_handle oom_list;
+ fail_alloc=1; assert(amdgpu_bo_list_create(&dev,257,resources,NULL,&oom_list)==-ENOMEM);
+ fail_alloc=1; assert(amdgpu_bo_list_create(&dev,1,resources,NULL,&oom_list)==-ENOMEM);
+ assert(!pthread_mutex_init(&dev.bo_table_mutex,NULL));
+ assert(!pthread_mutex_init(&bo.cpu_access_mutex,NULL));
+ unsigned char memory[8192]; bo.cpu_ptr=memory;
+ atomic_set(&bo.refcount,1); assert(!handle_table_insert(&dev.bo_handles,77,&bo));
+ amdgpu_bo_handle found; uint64_t off;
+ assert(!amdgpu_find_bo_by_cpu_mapping(&dev,memory+8191,1,&found,&off) && found==&bo && off==8191);
+ assert(atomic_read(&bo.refcount)==2);
+ assert(amdgpu_find_bo_by_cpu_mapping(&dev,memory+8191,2,&found,&off)!=0 && !found);
+ assert(amdgpu_find_bo_by_cpu_mapping(&dev,(void *)(UINTPTR_MAX-1),4,&found,&off)==-EINVAL);
+ handle_table_fini(&dev.bo_handles);
+ pthread_mutex_destroy(&bo.cpu_access_mutex); pthread_mutex_destroy(&dev.bo_table_mutex);
+ puts("PASS: raw-CS and BO-list stack/heap boundaries and ioctl-error cleanup; CPU mapping full-range lookup and reference ownership");
+ return 0;
+}
