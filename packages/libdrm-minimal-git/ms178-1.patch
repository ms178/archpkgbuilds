+++ b/tests/ms178/proofs.py
@@ -0,0 +1,16 @@
+#!/usr/bin/env python3
+"""Limited arithmetic/layout proofs, not a proof of whole-library behavior."""
+import z3
+x=z3.BitVec('offset',64)
+for n in range(64):
+ a=z3.BitVecVal(1<<n,64);s=z3.Solver();s.set(timeout=5000);s.add(z3.URem(x,a)!=(x & (a-1)))
+ result=s.check();assert result==z3.unsat;print('uint64 remainder, power',n,result)
+u,m=z3.Ints('unique objects');s=z3.Solver();s.add(u>=1,m>=1,m<=u)
+values_end=8*u;objects_end=8*u+4*m;counts_end=8*u+8*m;props_end=12*u+8*m
+s.add(z3.Or(values_end>objects_end,objects_end>counts_end,counts_end>props_end))
+assert s.check()==z3.unsat;print('array ordering/disjointness: unsat')
+s=z3.Solver();s.add(u>=1,u<=64,m>=1,m<=u,props_end>1280);assert s.check()==z3.unsat;print('small scratch bound 1280 bytes: unsat')
+for bits in [32,64]:
+ limit=(1<<bits)-1;s=z3.Solver();s.add(u>=1,m>=1,m<=u,12*u<=limit,m<=(limit-12*u)/8,12*u+8*m>limit)
+ assert s.check()==z3.unsat;print('checked allocation sum, size_t',bits,': unsat')
+print('PASS: 68 UNSAT arithmetic/layout counterexample queries; excludes threading, ABI/client lifetime and performance')
