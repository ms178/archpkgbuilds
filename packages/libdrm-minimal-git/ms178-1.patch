+/* SPDX-License-Identifier: MIT */
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <errno.h>
+#include <pthread.h>
+static _Thread_local unsigned alloc_calls, fail_at, ioctl_calls;
+static void *fault_malloc(size_t n) { if(++alloc_calls==fail_at){errno=ENOMEM;return NULL;}return malloc(n); }
+static void *fault_calloc(size_t n,size_t s) { if(++alloc_calls==fail_at){errno=ENOMEM;return NULL;}return calloc(n,s); }
+static void *fault_realloc(void *p,size_t n) { if(++alloc_calls==fail_at){errno=ENOMEM;return NULL;}return realloc(p,n); }
+#define malloc fault_malloc
+#define calloc fault_calloc
+#define realloc fault_realloc
+#include "../../xf86drmMode.c"
+#undef malloc
+#undef calloc
+#undef realloc
+void *drmMalloc(int n) {return fault_calloc(1,n);}
+void drmFree(void *p) {free(p);}
+static _Thread_local uint64_t expected[16][128];
+static _Thread_local int ioctl_error;
+static uint32_t id(unsigned i) {return i&1 ? 0x80000000u+i : i+1;}
+static unsigned index_of(uint32_t x) {return x&0x80000000u ? x&0x7fffffffu : x-1;}
+int drmIoctl(int fd,unsigned long cmd,void *data) {
+ (void)fd;assert(cmd==DRM_IOCTL_MODE_ATOMIC);ioctl_calls++;
+ struct drm_mode_atomic *a=data;
+ assert(a->flags==DRM_MODE_ATOMIC_NONBLOCK && a->user_data==42);
+ uint32_t *objs=(void *)(uintptr_t)a->objs_ptr,*counts=(void *)(uintptr_t)a->count_props_ptr,*props=(void *)(uintptr_t)a->props_ptr;
+ uint64_t *vals=(void *)(uintptr_t)a->prop_values_ptr;
+ assert((uintptr_t)vals%_Alignof(uint64_t)==0);
+ unsigned pos=0;unsigned char seen[16][128]={{0}};
+ for(unsigned o=0;o<a->count_objs;o++) {
+  assert(!o || objs[o-1]<objs[o]);unsigned oi=index_of(objs[o]);assert(oi<16 && counts[o]);
+  for(unsigned p=0;p<counts[o];p++,pos++) {
+   assert(!p || props[pos-1]<props[pos]);unsigned pi=index_of(props[pos]);assert(pi<128);
+   assert(!seen[oi][pi] && expected[oi][pi]==vals[pos]);seen[oi][pi]=1;
+  }
+ }
+ for(unsigned o=0;o<16;o++)for(unsigned p=0;p<128;p++)assert(!!expected[o][p]==!!seen[o][p]);
+ if(ioctl_error){errno=EBUSY;return -1;}return 0;
+}
+static void oracle(drmModeAtomicReqPtr r) {
+ memset(expected,0,sizeof expected);
+ for(unsigned i=0;i<r->cursor;i++)expected[index_of(r->items[i].object_id)][index_of(r->items[i].property_id)]=r->items[i].value;
+}
+static void check_commit(drmModeAtomicReqPtr r) {
+ oracle(r);unsigned n=r->cursor;drmModeAtomicReqItem *copy=malloc((size_t)n*sizeof(*copy)+1);assert(copy);
+ if(n)memcpy(copy,r->items,(size_t)n*sizeof(*copy));
+ assert(!drmModeAtomicCommit(-1,r,DRM_MODE_ATOMIC_NONBLOCK,(void *)42));assert(n==r->cursor);
+ for(unsigned i=0;i<n;i++)assert(copy[i].object_id==r->items[i].object_id && copy[i].property_id==r->items[i].property_id && copy[i].value==r->items[i].value && copy[i].cursor==r->items[i].cursor);
+ free(copy);
+}
+static void fault_tests(void) {
+ unsigned counts[]={1,63,64,65,256,4096};
+ for(unsigned c=0;c<6;c++)for(unsigned dup=0;dup<2;dup++) {
+  drmModeAtomicReqPtr r=drmModeAtomicAlloc();assert(r);
+  for(unsigned i=0;i<counts[c];i++)assert(drmModeAtomicAddProperty(r,id(dup?0:i/128%16),id(dup?0:i%128),i+1)>0);
+  oracle(r);alloc_calls=0;assert(!drmModeAtomicCommit(-1,r,DRM_MODE_ATOMIC_NONBLOCK,(void *)42));unsigned needed=alloc_calls;
+  assert(needed==(counts[c]<=64?0:dup?1:2));
+  for(unsigned f=1;f<=needed;f++) {
+   alloc_calls=0;fail_at=f;unsigned before=ioctl_calls;
+   assert(drmModeAtomicCommit(-1,r,DRM_MODE_ATOMIC_NONBLOCK,(void *)42)<0);assert(before==ioctl_calls);fail_at=0;
+   check_commit(r);
+  }
+  ioctl_error=1;assert(drmModeAtomicCommit(-1,r,DRM_MODE_ATOMIC_NONBLOCK,(void *)42)==-EBUSY);ioctl_error=0;
+  for(unsigned f=1;f<=2;f++) {alloc_calls=0;fail_at=f;assert(!drmModeAtomicDuplicate(r));fail_at=0;}
+  drmModeAtomicFree(r);
+ }
+ drmModeAtomicReqPtr r=drmModeAtomicAlloc();assert(r);
+ alloc_calls=0;fail_at=1;assert(drmModeAtomicAddProperty(r,1,1,1)==-ENOMEM && !r->cursor && !r->size_items);fail_at=0;
+ assert(drmModeAtomicAddProperty(r,1,1,1)==1);
+ drmModeAtomicSetCursor(r,-1);assert(r->cursor==1);
+ drmModeAtomicSetCursor(r,INT_MAX);assert(r->cursor==1);
+ drmModeAtomicSetCursor(r,0);assert(!r->cursor);
+ drmModeAtomicReqPtr d=drmModeAtomicDuplicate(r);assert(d);drmModeAtomicSetCursor(d,1);check_commit(d);drmModeAtomicFree(d);
+ drmModeAtomicSetCursor(r,1);check_commit(r);
+ assert(!drmModeAtomicMerge(r,r));assert(r->cursor==2);check_commit(r);
+ drmModeAtomicReqPtr a=drmModeAtomicAlloc();assert(a);
+ for(unsigned i=0;i<256;i++)assert(drmModeAtomicAddProperty(a,id(i/128),id(i%128),i+2)>0);
+ alloc_calls=0;fail_at=1;unsigned before=r->cursor;
+ assert(drmModeAtomicMerge(r,a)==-ENOMEM && r->cursor==before);fail_at=0;
+ assert(!drmModeAtomicMerge(r,a));check_commit(r);
+ drmModeAtomicFree(a);drmModeAtomicFree(r);
+}
+static void *worker(void *arg) {
+ unsigned seed=(unsigned)(uintptr_t)arg;unsigned counts[]={0,1,2,3,63,64,65,127,256,1024,4096};
+ unsigned rounds=getenv("MS178_STRESS_ROUNDS")?strtoul(getenv("MS178_STRESS_ROUNDS"),NULL,0):300;
+ for(unsigned round=0;round<rounds;round++) {
+  drmModeAtomicReqPtr r=drmModeAtomicAlloc();assert(r);unsigned count=counts[round%11];
+  for(unsigned i=0;i<count;i++){unsigned o=rand_r(&seed)%16,p=rand_r(&seed)%128;assert(drmModeAtomicAddProperty(r,id(o),id(p),i+1)>0);}
+  check_commit(r);
+  if(count){unsigned saved=r->cursor;drmModeAtomicSetCursor(r,count/2);check_commit(r);drmModeAtomicSetCursor(r,saved);check_commit(r);}
+  drmModeAtomicFree(r);
+ }
+ return NULL;
+}
+int main(void) {
+ fault_tests();pthread_t threads[8];
+ for(uintptr_t i=0;i<8;i++)assert(!pthread_create(&threads[i],NULL,worker,(void *)(1778+i)));
+ for(unsigned i=0;i<8;i++)assert(!pthread_join(threads[i],NULL));
+ puts("PASS: KMS independent oracle, 8 threads, boundary/randomized/rewind/restore/self-merge, exact caller preservation, every reached commit/duplicate allocation failure, ioctl errors");return 0;
+}
