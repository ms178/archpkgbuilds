+ for(unsigned i=0;i<history;i++)assert(drmModeAtomicAddProperty(req,1,i+1,i)>0);
+ if(history)drmModeAtomicSetCursor(req,0);
+ unsigned *permutation=malloc((size_t)n*sizeof(*permutation)+1);assert(permutation);
+ for(unsigned i=0;i<n;i++)permutation[i]=i+1;
+ unsigned seed=1778;
+ if(order==1)for(unsigned i=0;i<n;i++)permutation[i]=n-i;
+ if(order==2)for(unsigned i=n;i>1;i--){unsigned j=rand_r(&seed)%i,tmp=permutation[i-1];permutation[i-1]=permutation[j];permutation[j]=tmp;}
+ for(unsigned i=0;i<n;i++) assert(drmModeAtomicAddProperty(req,1,duplicates?1:permutation[i],i+1)>0);
+ free(permutation);
+ for(unsigned i=0;i<100;i++) assert(!drmModeAtomicCommit(-1,req,DRM_MODE_ATOMIC_NONBLOCK,(void *)42));
+ uint64_t calibrate=ns();
+ for(unsigned i=0;i<20;i++)assert(!drmModeAtomicCommit(-1,req,DRM_MODE_ATOMIC_NONBLOCK,(void *)42));
+ uint64_t cost=(ns()-calibrate)/20; if(!cost)cost=1;
+ unsigned iters=30000000/cost;if(iters<8)iters=8;if(iters>200000)iters=200000;
+ alloc_calls=0;
+ uint64_t start=ns();for(unsigned i=0;i<iters;i++)assert(!drmModeAtomicCommit(-1,req,DRM_MODE_ATOMIC_NONBLOCK,(void *)42));
+ uint64_t elapsed=ns()-start;
+ printf("%u,%u,%u,%.3f,%.3f,%u,%u\n",n,duplicates,iters,(double)elapsed/iters,(double)alloc_calls/iters,order,history);
+ drmModeAtomicFree(req);return 0;
+}
diff --git a/tests/ms178/mca.py b/tests/ms178/mca.py
new file mode 100644
index 00000000..3947f964
--- /dev/null
+++ b/tests/ms178/mca.py
@@ -0,0 +1,20 @@
+#!/usr/bin/env python3
+"""Model verified arithmetic slices, not whole functions or syscall timings."""
+import argparse,pathlib,subprocess,re,json
+p=argparse.ArgumentParser();p.add_argument('--assembly',required=True);p.add_argument('--mca',required=True);p.add_argument('--out',required=True);a=p.parse_args();asm=pathlib.Path(a.assembly).read_text();out=pathlib.Path(a.out);out.mkdir(parents=True,exist_ok=True)
+# Actual register allocation from the pinned Clang23 production assembly.
+# rbp is divisor on the generic branch and a hoisted negative mask on pow2.
+paths={'generic-align-down':'movq %rsi, %rax\nxorl %edx, %edx\ndivq %rbp\nsubq %rdx, %rsi\n','pow2-align-down':'andq %rbp, %rsi\n'}
+normalized=[re.sub(r'\s+',' ',s.split('#')[0].strip()) for s in asm.splitlines()]
+verified={}
+for name,code in paths.items():
+ verified[name]=[]
+ for instruction in code.splitlines():
+  assert instruction in normalized,(name,instruction,'not found in production assembly')
+  verified[name].append({'instruction':instruction,'assembly_lines':[i+1 for i,x in enumerate(normalized) if x==instruction]})
+ f=out/(name+'.s');f.write_text('# Arithmetic-only production path. Excludes guards, loop, memory, locking, allocators, kernel and GPU.\n'+code)
+ cmd=[a.mca,'-mtriple=x86_64-unknown-linux-gnu','-mcpu=raptorlake','-iterations=1000','-all-stats',str(f)]
+ proc=subprocess.run(cmd,check=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True)
+ (out/(name+'.txt')).write_text('$ '+' '.join(cmd)+'\n'+proc.stdout+'\n'+proc.stderr)
+(out/'source-instruction-locations.json').write_text(json.dumps(verified,indent=2)+'\n')
+print('PASS: instructions verified in actual production assembly and modeled with raptorlake. Generic path joins its shared remainder block; no full-control-flow timing claim.')
