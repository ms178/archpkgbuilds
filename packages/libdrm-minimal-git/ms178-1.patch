+static void public_threads(void) {
+ amdgpu_va_manager_init(&shared_public,4096,257*4096,0,0,4096);
+ pthread_t threads[4];
+ for(uintptr_t i=0;i<4;i++)assert(!pthread_create(&threads[i],NULL,public_worker,(void *)(i+1)));
