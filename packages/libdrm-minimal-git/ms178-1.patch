+void *drmMalloc(int n) { return test_calloc(1,n); }
+void drmFree(void *p) { free(p); }
+static int verify=1, ioctl_failure;
+static uint64_t oracle[4][4];
+static const uint32_t ids[]={1,7,0x80000001u,0xfffffffeu};
+static unsigned find_id(uint32_t id) {
+ for(unsigned i=0;i<4;i++) if(ids[i]==id) return i;
+ assert(0); return 0;
+}
+int drmIoctl(int fd,unsigned long cmd,void *arg) {
+ (void)fd; assert(cmd==DRM_IOCTL_MODE_ATOMIC); ioctl_calls++;
+ struct drm_mode_atomic *a=arg;
+ assert(a->flags==DRM_MODE_ATOMIC_NONBLOCK && a->user_data==42);
+ if(verify) {
+  uint32_t *objs=(void *)(uintptr_t)a->objs_ptr;
+  uint32_t *counts=(void *)(uintptr_t)a->count_props_ptr;
+  uint32_t *props=(void *)(uintptr_t)a->props_ptr;
+  uint64_t *vals=(void *)(uintptr_t)a->prop_values_ptr;
+  uint64_t observed[4][4]={{0}}; unsigned pos=0;
+  for(unsigned o=0;o<a->count_objs;o++) {
+   assert(!o || objs[o]>objs[o-1]);
+   for(unsigned p=0;p<counts[o];p++,pos++) {
+    assert(!p || props[pos]>props[pos-1]);
+    unsigned oi=find_id(objs[o]), pi=find_id(props[pos]);
+    assert(vals[pos]==oracle[oi][pi]); observed[oi][pi]=vals[pos];
+   }
+  }
+  assert(!memcmp(observed,oracle,sizeof oracle));
+ }
+ if(ioctl_failure) {errno=EBUSY;return -1;} return 0;
+}
+static void test_atomic(void) {
+ drmModeAtomicReqPtr triple=drmModeAtomicAlloc(); assert(triple);
+ memset(oracle,0,sizeof oracle); oracle[0][0]=3;
+ for(unsigned i=1;i<=3;i++) assert(drmModeAtomicAddProperty(triple,1,1,i)>0);
+ assert(!drmModeAtomicCommit(-1,triple,DRM_MODE_ATOMIC_NONBLOCK,(void *)42));
+ drmModeAtomicFree(triple);
+ unsigned seed=134;
+ for(unsigned round=0;round<200;round++) {
+  drmModeAtomicReqPtr req=drmModeAtomicAlloc(); assert(req);
+  memset(oracle,0,sizeof oracle);
+  for(unsigned i=0;i<1+round*3;i++) {
+   unsigned o=rand_r(&seed)%4,p=rand_r(&seed)%4;
+   assert(drmModeAtomicAddProperty(req,ids[o],ids[p],i+1)>0);
+   oracle[o][p]=i+1;
+  }
+  unsigned cursor=req->cursor;
+  assert(!drmModeAtomicCommit(-1,req,DRM_MODE_ATOMIC_NONBLOCK,(void *)42));
+  assert(req->cursor==cursor); /* Never mutate caller request. */
+  ioctl_failure=1;
+  assert(drmModeAtomicCommit(-1,req,DRM_MODE_ATOMIC_NONBLOCK,(void *)42)==-EBUSY);
+  ioctl_failure=0; drmModeAtomicFree(req);
+ }
+ drmModeAtomicReqPtr req=drmModeAtomicAlloc(); assert(req);
+ for(unsigned i=0;i<65;i++) assert(drmModeAtomicAddProperty(req,1,i+1,i)>0);
+ verify=0;
+ alloc_calls=0; assert(!drmModeAtomicCommit(-1,req,DRM_MODE_ATOMIC_NONBLOCK,(void *)42));
