+static uint64_t ns(void) {struct timespec t;assert(!clock_gettime(CLOCK_MONOTONIC,&t));return (uint64_t)t.tv_sec*1000000000+t.tv_nsec;}
+int main(int argc,char **argv) {
+ uint64_t alignment=argc>1?strtoull(argv[1],NULL,0):4096,va;
+ unsigned fragments=argc>2?strtoul(argv[2],NULL,0):1024;
+ struct amdgpu_bo_va_mgr m;
