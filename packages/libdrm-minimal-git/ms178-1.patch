+#include <stdlib.h>
+#include <time.h>
+static unsigned alloc_calls, fail_at, ioctl_calls;
+static void *test_calloc(size_t n,size_t s) {
+ if(++alloc_calls==fail_at) return NULL;
+ return calloc(n,s);
+}
+static void *test_malloc(size_t n) { if(++alloc_calls==fail_at) return NULL; return malloc(n); }
+static void *test_realloc(void *p,size_t n) { if(++alloc_calls==fail_at) return NULL; return realloc(p,n); }
+#define malloc test_malloc
