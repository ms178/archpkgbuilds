+ for(unsigned i=0;i<fragments;i++) assert(!amdgpu_vamgr_find_va(&m,4096,4096,4096ULL*(2*i+2),false,&va));
+ uint64_t hash=0,start=ns();unsigned iterations=fragments>100?30000:200000;
+ for(unsigned i=0;i<iterations;i++) {
+  int r=amdgpu_vamgr_find_va(&m,8192,alignment,0,i&1,&va);assert(!r);
+  assert(va%alignment==0); hash=hash*33+va;
+  amdgpu_vamgr_free_va(&m,va,8192);
+ }
+ printf("%llu,%u,%.3f,%llu,%u\n",(unsigned long long)alignment,iterations,(double)(ns()-start)/iterations,(unsigned long long)hash,fragments);
