+#!/usr/bin/env python3
+"""Runtime sensitivity checks. Temporarily edits ONE source; always restores it.
+Run only on a disposable patched tree, never concurrently with builds/tests.
+"""
+import pathlib,subprocess,os,argparse
+p=argparse.ArgumentParser();p.add_argument('--out',required=True);p.add_argument('--cc',required=True);p.add_argument('--config',default='build-llvm23');a=p.parse_args();r=pathlib.Path(__file__).resolve().parents[2];out=pathlib.Path(a.out).resolve();out.mkdir(exist_ok=True,parents=True)
+cases=[
+ ('kms-sort-bypass','xf86drmMode.c','if (i < req->cursor)\n\t\tqsort','if (false && i < req->cursor)\n\t\tqsort','kms-stress'),
+ ('kms-stack-overflow','xf86drmMode.c','items = req->cursor <= DRM_MODE_ATOMIC_STACK_ITEMS ?', 'items = req->cursor <= DRM_MODE_ATOMIC_STACK_ITEMS + 1 ?', 'kms-stress'),
+ ('kms-count-init','xf86drmMode.c','count_props_ptr[obj_idx] = 1;','count_props_ptr[obj_idx] = 0;','kms-stress'),
+ ('kms-initialized-tail','xf86drmMode.c','old->initialized * sizeof(*new->items)','old->cursor * sizeof(*new->items)','kms-stress'),
+ ('kms-negative-cursor','xf86drmMode.c','if (req && cursor >= 0 && (uint32_t)cursor <= req->initialized)','if (req)','kms-stress'),
+ ('va-free-oom','amdgpu/amdgpu_vamgr.c','&allocation->reserve);','NULL);','va-stress'),
+ ('va-exact-fit','amdgpu/amdgpu_vamgr.c','if (aligned_size > hole->size)','if (aligned_size >= hole->size)','va-stress'),
+ ('sync-dup-failure','libsync.h','return *fd1 < 0 ? -1 : 0;','return 0;','sync'),
+ ('bo-mapping-span','amdgpu/amdgpu_bo.c','size <= bo->alloc_size - offset','size <= bo->alloc_size','mock'),
+ ('cs-count-cap','amdgpu/amdgpu_cs.c','num_chunks > AMDGPU_CS_MAX_ALLOCA_COUNT','num_chunks > AMDGPU_CS_MAX_ALLOCA_COUNT + 1','mock'),
+]
+for name,file,old,new,test in cases:
+ f=r/file;s=f.read_text();assert old in s,(name,'pattern missing')
+ try:
+  f.write_text(s.replace(old,new))
+  exe=out/name
+  cmd=[a.cc,'-std=c11','-UNDEBUG','-D_GNU_SOURCE','-g','-O1','-fsanitize=address,undefined','-fno-omit-frame-pointer','-ffunction-sections','-fdata-sections','-include',str(r/a.config/'config.h'),'-I'+str(r),'-I'+str(r/'include/drm'),'-I'+str(r/'amdgpu'),str(r/f'tests/ms178/{test}.c'),'-pthread','-Wl,--gc-sections','-o',str(exe)]
+  subprocess.run(cmd,check=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
+  proc=subprocess.run([str(exe)],stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,env=dict(os.environ,UBSAN_OPTIONS='halt_on_error=1'))
+  (out/(name+'.log')).write_text(proc.stdout)
+  assert proc.returncode and any(x in proc.stdout for x in ['Assertion','assertion','ERROR: AddressSanitizer','runtime error:']),(name,'survived or invalid runtime failure',proc.stdout)
+  print(name,'DETECTED',proc.returncode,flush=True);exe.unlink()
+ finally:
+  f.write_text(s)
+  (out/name).unlink(missing_ok=True)
+print('PASS all 10 intentional regressions detected at runtime; sources restored')
