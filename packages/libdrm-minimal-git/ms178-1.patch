+#undef malloc
+static unsigned char used[257];
+static uint64_t expected_fit(unsigned size,unsigned align,unsigned fixed,int top) {
+ if(fixed && fixed%align)return UINT64_MAX-1;
+ for(unsigned i=1;i+size<=257;i++) {
+  unsigned va=top?257-size+1-i:i;
+  if(fixed && va!=fixed)continue;
+  if(va<1 || va%align)continue;
+  unsigned j;for(j=0;j<size;j++)if(used[va+j])break;
+  if(j==size)return va;
+ }
+ return UINT64_MAX;
+}
+static void validate(struct amdgpu_bo_va_mgr *m) {
+ unsigned char holes[257]={0};struct amdgpu_bo_va_hole *h;uint64_t end=257;
+ LIST_FOR_EACH_ENTRY(h,&m->va_holes,list) {
+  assert(h->size && h->offset>=1 && h->offset+h->size<=end);end=h->offset;
+  for(uint64_t j=h->offset;j<h->offset+h->size;j++){assert(!holes[j] && !used[j]);holes[j]=1;}
+ }
+ for(unsigned i=1;i<257;i++)assert(holes[i]+used[i]==1);
+}
+static void model_test(unsigned seed,unsigned steps) {
+ struct amdgpu_bo_va_mgr m;struct {unsigned va,size;} live[64]={{0}};
+ memset(used,0,sizeof used);amdgpu_vamgr_init(&m,1,257,1);
+ unsigned alignments[]={1,2,3,4,5,7,16,17,64};
+ for(unsigned i=0;i<steps;i++) {
+  unsigned slot=rand_r(&seed)%64;
+  if(live[slot].size) {
+   amdgpu_vamgr_free_va(&m,live[slot].va,live[slot].size);
+   for(unsigned j=0;j<live[slot].size;j++)used[live[slot].va+j]=0;
+   live[slot].size=0;
+  }else{
+   unsigned size=1+rand_r(&seed)%20,align=alignments[rand_r(&seed)%9],fixed=rand_r(&seed)%4?0:1+rand_r(&seed)%280;
+   int top=rand_r(&seed)&1;uint64_t want=expected_fit(size,align,fixed,top),va=0;
+   int ret=amdgpu_vamgr_find_va(&m,size,align,fixed,top,&va);
+   if(want==UINT64_MAX-1)assert(ret==-EINVAL);
+   else if(want==UINT64_MAX)assert(ret==-ENOMEM);
+   else {assert(!ret && va==want);live[slot].va=va;live[slot].size=size;for(unsigned j=0;j<size;j++){assert(!used[va+j]);used[va+j]=1;}}
+  }
+  validate(&m);
+ }
+ for(unsigned i=0;i<64;i++)if(live[i].size)amdgpu_vamgr_free_va(&m,live[i].va,live[i].size);
+ amdgpu_vamgr_deinit(&m);
+}
+static uint64_t free_bytes(struct amdgpu_bo_va_mgr *m){uint64_t sum=0;struct amdgpu_bo_va_hole *h;LIST_FOR_EACH_ENTRY(h,&m->va_holes,list)sum+=h->size;return sum;}
+static void public_oom_free(void) {
+ struct amdgpu_va_manager m={0};amdgpu_va_handle handles[64],large;uint64_t va;
+ amdgpu_va_manager_init(&m,4096,257*4096,0,0,4096);
+ for(unsigned i=0;i<64;i++)assert(!amdgpu_va_range_alloc2(&m,amdgpu_gpu_va_range_general,4096,4096,0,&va,&handles[i],AMDGPU_VA_RANGE_32_BIT));
+ fail_all=1;unsigned calls=allocation_calls;
+ for(unsigned i=0;i<64;i+=2)assert(!amdgpu_va_range_free(handles[i]));
+ assert(allocation_calls==calls && free_bytes(&m.vamgr_32)==224*4096);
+ for(unsigned i=1;i<64;i+=2)assert(!amdgpu_va_range_free(handles[i]));
+ assert(allocation_calls==calls && free_bytes(&m.vamgr_32)==256*4096);
+ fail_all=0;
+ assert(!amdgpu_va_range_alloc2(&m,amdgpu_gpu_va_range_general,256*4096,4096,0,&va,&large,AMDGPU_VA_RANGE_32_BIT));
+ fail_all=1;calls=allocation_calls;assert(!amdgpu_va_range_free(large));assert(allocation_calls==calls);fail_all=0;
+ amdgpu_va_manager_deinit(&m);
+}
+static struct amdgpu_va_manager shared_public;
+static void *public_worker(void *arg) {
+ unsigned seed=(unsigned)(uintptr_t)arg;
+ for(unsigned i=0;i<20000;i++) {
+  amdgpu_va_handle h;uint64_t va;
+  unsigned flags=AMDGPU_VA_RANGE_32_BIT | (i&1 ? AMDGPU_VA_RANGE_REPLAYABLE : 0);
