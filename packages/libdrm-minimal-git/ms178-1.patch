diff --git a/tests/ms178/host.c b/tests/ms178/host.c
new file mode 100644
index 0000000000000000000000000000000000000000..1ed701c8c1ed913ec234811257fcf9a63133b6c3
--- /dev/null
+++ b/tests/ms178/host.c
@@ -0,0 +1,107 @@
+/* SPDX-License-Identifier: MIT
+ * Hardware-independent tests of the actual production implementation.
+ * Compile via run-host.sh; no substitute VA allocator is used.
+ */
+#include <assert.h>
+#include <stdio.h>
+#include <pthread.h>
+#include <stdlib.h>
+static int fail_alloc;
+static void *host_malloc(size_t n) { if(fail_alloc) { fail_alloc--; return NULL; } return malloc(n); }
+#define malloc host_malloc
+#include "../../amdgpu/amdgpu_vamgr.c"
+#undef malloc
+#include "../../amdgpu/handle_table.c"
+
+static unsigned long operations;
+static void invariant(struct amdgpu_bo_va_mgr *m, uint64_t used)
+{
+ struct amdgpu_bo_va_hole *h;
+ uint64_t end = UINT64_MAX, total = 0;
+ LIST_FOR_EACH_ENTRY(h, &m->va_holes, list) {
+  assert(h->size && h->offset + h->size <= end);
+  end = h->offset; total += h->size;
+ }
+ assert(total + used == 256 * 4096);
+}
+static void random_test(void)
+{
+ struct amdgpu_bo_va_mgr m;
+ struct { uint64_t va, size; } live[128] = {{0}};
+ uint64_t used = 0; unsigned seed = 1778;
+ amdgpu_vamgr_init(&m, 4096, 257 * 4096, 4096);
+ for (unsigned i=0; i<100000; ++i) {
+  unsigned j=rand_r(&seed)%128;
+  if (live[j].size) {
+   amdgpu_vamgr_free_va(&m,live[j].va,live[j].size);
+   used-=live[j].size; live[j].size=0;
+  } else {
+   uint64_t sz=(1+rand_r(&seed)%8)*4096, va;
+   int r=amdgpu_vamgr_find_va(&m,sz,4096ULL << (rand_r(&seed)%4),0,i&1,&va);
+   assert(r==0 || r==-ENOMEM);
+   if (!r) {
+    assert(va>=4096 && va+sz<=257*4096);
+    for (unsigned k=0;k<128;k++) if(live[k].size)
+     assert(va+sz<=live[k].va || live[k].va+live[k].size<=va);
+    live[j].va=va; live[j].size=sz; used+=sz;
+   }
+  }
+  invariant(&m,used); operations++;
+ }
+ for(unsigned i=0;i<128;i++) if(live[i].size)
+  amdgpu_vamgr_free_va(&m,live[i].va,live[i].size);
+ invariant(&m,0); amdgpu_vamgr_deinit(&m);
+}
+static struct amdgpu_bo_va_mgr shared;
+static void *worker(void *arg)
+{
+ unsigned seed=(unsigned)(uintptr_t)arg;
+ for(unsigned i=0;i<10000;i++) {
+  uint64_t va, sz=(1+rand_r(&seed)%4)*4096;
+  int r=amdgpu_vamgr_find_va(&shared,sz,4096,0,i&1,&va);
+  assert(r==0 || r==-ENOMEM);
+  if(!r) amdgpu_vamgr_free_va(&shared,va,sz);
+ }
+ return NULL;
+}
+int main(void)
+{
+ struct amdgpu_bo_va_mgr m;
+ uint64_t va, x;
+ assert(amdgpu_align_up_u64(UINT64_MAX,4096,&x)==-EOVERFLOW);
+ assert(amdgpu_align_up_u64(1,3,&x)==-EINVAL);
+ amdgpu_vamgr_init(&m,4096,257*4096,4096);
+ assert(amdgpu_vamgr_find_va(&m,4096,12288,0,false,&va)==0);
+ assert(va%12288==0); amdgpu_vamgr_free_va(&m,va,4096);
+ fail_alloc=1;
+ assert(amdgpu_vamgr_find_va(&m,4096,4096,8192,false,&va)==-ENOMEM);
+ invariant(&m,0);
+ assert(amdgpu_vamgr_find_va(&m,4096,4096,8192,false,&va)==0 && va==8192);
+ amdgpu_vamgr_free_va(&m,va,4096);
+ /* Duplicate free must not create overlapping holes. */
+ amdgpu_vamgr_free_va(&m,va,4096); invariant(&m,0);
+ assert(amdgpu_vamgr_find_va(&m,UINT64_MAX,4096,0,false,&va)==-EOVERFLOW);
+ assert(amdgpu_vamgr_find_va(&m,4096,4096,UINT64_MAX-4095,false,&va)==-EOVERFLOW);
+ amdgpu_vamgr_deinit(&m);
+ random_test();
+ amdgpu_vamgr_init(&shared,4096,257*4096,4096);
+ pthread_t threads[4];
+ for(uintptr_t i=0;i<4;i++) assert(!pthread_create(&threads[i],NULL,worker,(void *)(i+1)));
+ for(unsigned i=0;i<4;i++) assert(!pthread_join(threads[i],NULL));
+ invariant(&shared,0); amdgpu_vamgr_deinit(&shared);
+ struct handle_table table={0};
+ for(unsigned i=0;i<10000;i+=17) assert(!handle_table_insert(&table,i,(void *)(uintptr_t)(i+1)));
+ for(unsigned i=0;i<10000;i++) assert(handle_table_lookup(&table,i)==(i%17?NULL:(void *)(uintptr_t)(i+1)));
+ assert(handle_table_insert(&table,1u<<28,(void *)1)==-EINVAL);
+ handle_table_remove(&table,17); assert(!handle_table_lookup(&table,17));
+ handle_table_fini(&table); assert(!table.values && !table.max_key);
+ struct amdgpu_va_manager mgr={0}; amdgpu_va_handle h;
+ amdgpu_va_manager_init(&mgr,4096,1ULL<<36,0,0,4096);
+ fail_alloc=1;
+ assert(amdgpu_va_range_alloc2(&mgr,amdgpu_gpu_va_range_general,8192,4096,0,&va,&h,0)==-ENOMEM);
+ assert(!amdgpu_va_range_alloc2(&mgr,amdgpu_gpu_va_range_general,8192,4096,0,&va,&h,0));
+ assert(amdgpu_va_get_start_addr(h)==va); assert(!amdgpu_va_range_free(h));
+ amdgpu_va_manager_deinit(&mgr);
+ puts("PASS: 100000 randomized VA steps; 40000 concurrent alloc/free attempts; VA boundaries, duplicate-free rejection, handle-table growth/cap, public alloc/free");
+ return 0;
+}
