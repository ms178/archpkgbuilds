+ assert(free_bytes(&shared_public.vamgr_32)==256*4096);
+ amdgpu_va_manager_deinit(&shared_public);
+}
+int main(void) {
+ unsigned steps=getenv("MS178_VA_STEPS")?strtoul(getenv("MS178_VA_STEPS"),NULL,0):50000;
+ for(unsigned seed=0;seed<8;seed++)model_test(1778+seed,steps);
