+#!/bin/sh
+set -eu
+cd "$(dirname "$0")/../.."
+: "${CC:=cc}"
+if [ -z "${CONFIG_DIR:-}" ]; then
+  if [ -f build-llvm23/config.h ]; then CONFIG_DIR=build-llvm23; else CONFIG_DIR=build-clang; fi
+fi
+if [ -z "${TEST_OUTPUT:-}" ]; then
+  scratch=$(mktemp -d)
+  trap 'rm -rf "$scratch"' EXIT HUP INT TERM
+  TEST_OUTPUT="$scratch/host"
+fi
+for name in host mock kms sync kms-stress va-stress device queries; do
+  $CC -std=c11 -UNDEBUG -D_GNU_SOURCE -g -O1 -Wall -Wextra -Werror \
+    -Wno-unused-function -Wno-unused-parameter ${SANITIZE_FLAGS:-} \
+    -ffunction-sections -fdata-sections -include "$CONFIG_DIR/config.h" \
+    -I. -Iinclude/drm -Iamdgpu -I"$CONFIG_DIR" "tests/ms178/$name.c" \
+    -pthread -Wl,--gc-sections -o "$TEST_OUTPUT-$name"
+  "$TEST_OUTPUT-$name"
+done
