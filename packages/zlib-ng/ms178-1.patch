 /* ===========================================================================
+ * Head-only variant of QUICK_INSERT_STRING.
+ *
+ * deflate_quick (level 1) only ever inspects the HEAD of a hash chain: it
+ * compares against s->head[hm] and never dereferences s->prev.  Writing the
+ * prev link there is therefore pure overhead - a dependent store into a
+ * w_size-sized table plus two extra loads (s->prev and s->w_mask).
+ *
+ * Leaving prev stale is safe even if the level is raised mid-stream, because
+ * longest_match only accepts candidates with cur_match < strstart and always
+ * verifies the bytes with an explicit comparison before recording a match.
+ */
+Z_INTERNAL Pos QUICK_INSERT_STRING_HEAD(deflate_state *const s, uint32_t str) {
+    uint8_t *strstart = s->window + str + HASH_CALC_OFFSET;
+    uint32_t val, hm;
+    Pos head;
+
+    HASH_CALC_VAR_INIT;
+    HASH_CALC_READ;
+    HASH_CALC(HASH_CALC_VAR, val);
+    HASH_CALC_VAR &= HASH_CALC_MASK;
+    hm = HASH_CALC_VAR;
+
+    head = s->head[hm];
+    if (LIKELY(head != str))
+        s->head[hm] = (Pos)str;
+    return head;
+}
