+/* pgo_trainer.c -- high-coverage PGO/BOLT training driver for zlib-ng
+ * Copyright (C) 2026 zlib-ng contributors
+ * For conditions of distribution and use, see copyright notice in zlib.h
+ *
+ * This deliberately exercises *every* hot code path that a real workload can
+ * reach, so that instrumentation-based PGO and BOLT profiles have dense,
+ * representative counter coverage:
+ *
+ *   - all deflate levels (0-9) x all strategies (default/filtered/huffman/rle/fixed)
+ *   - deflate_stored / quick / fast / medium / slow engines
+ *   - every windowBits (9..15), raw (-9..-15) and gzip (16+9..16+15) wrapper
+ *   - memLevel 1..9
+ *   - all flush modes incl. Z_PARTIAL_FLUSH / Z_BLOCK / Z_FULL_FLUSH
+ *   - dictionaries (set/get), deflateParams mid-stream, copy, prime, header,
+ *     bound, pending, tune
+ *   - inflate with tiny/odd/large buffers (drives chunkcopy + chunkmemset tails),
+ *     inflateSync, inflateCopy, inflateReset2, inflatePrime, inflateGetHeader,
+ *     inflateBack
+ *   - gzip file API (gzopen/gzwrite/gzprintf/gzread/gzgets/gzseek/gzflush/...)
+ *   - adler32 / crc32 (+ _z and _combine) over many alignments and lengths,
+ *     which is what selects the SIMD folding paths
+ *
+ * Data is synthesised to span the entropy/structure space that real corpora
+ * occupy (text, source code, DNA, binary, already-compressed, RLE runs,
+ * sparse zeros), so the profile is not biased toward one branch mix.
+ */
+
+#include "zbuild.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+
+#include "zutil.h"
+
+#if defined(_WIN32) || defined(__CYGWIN__)
+#  include <fcntl.h>
+#  include <io.h>
+#endif
+
+#define CHUNK_MAX (1 << 16)
+
+/* ------------------------------------------------------------------ */
+/* Deterministic PRNG - no libc rand() dependency, reproducible builds */
+/* ------------------------------------------------------------------ */
+static uint64_t rng_state = 0x9E3779B97F4A7C15ULL;
+
+static inline uint32_t rnd(void) {
+    uint64_t x = rng_state;
+    x ^= x << 13;
+    x ^= x >> 7;
+    x ^= x << 17;
+    rng_state = x;
+    return (uint32_t)(x >> 32);
+}
+
+static inline uint32_t rnd_max(uint32_t n) {
+    return n ? (rnd() % n) : 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* Synthetic corpora spanning the compressibility spectrum             */
+/* ------------------------------------------------------------------ */
+enum {
+    DATA_TEXT, DATA_SOURCE, DATA_DNA, DATA_BINARY, DATA_RANDOM,
+    DATA_RLE, DATA_SPARSE, DATA_MIXED, DATA_NKINDS
+};
+
+static const char *const words[] = {
+    "the","quick","brown","fox","jumps","over","lazy","dog","compression",
+    "deflate","inflate","window","buffer","stream","match","literal","length",
+    "distance","huffman","entropy","symbol","block","chunk","checksum","adler",
+    "table","encode","decode","binary","tree","node","hash","index","offset"
+};
+#define NWORDS (sizeof(words) / sizeof(words[0]))
+
+static void gen_text(uint8_t *b, size_t n) {
+    size_t i = 0;
+    while (i < n) {
+        const char *w = words[rnd_max(NWORDS)];
+        size_t l = strlen(w);
+        if (i + l + 1 > n) break;
+        memcpy(b + i, w, l);
+        i += l;
+        b[i++] = (rnd_max(16) == 0) ? '\n' : ' ';
+    }
+    while (i < n) b[i++] = ' ';
+}
+
+static void gen_source(uint8_t *b, size_t n) {
+    static const char *const frag[] = {
+        "static inline int ", "for (i = 0; i < n; i++) {\n", "    return 0;\n",
+        "}\n\n", "if (x != NULL) {\n", "        memcpy(dst, src, len);\n",
+        "/* comment */\n", "#include <stdio.h>\n", "    uint32_t val = 0;\n",
+        "    } else {\n", "struct foo {\n", "    void *ptr;\n"
+    };
+    size_t i = 0;
+    while (i < n) {
+        const char *f = frag[rnd_max(sizeof(frag) / sizeof(frag[0]))];
+        size_t l = strlen(f);
+        if (i + l > n) break;
+        memcpy(b + i, f, l);
+        i += l;
+    }
+    while (i < n) b[i++] = '\n';
+}
+
+static void gen_dna(uint8_t *b, size_t n) {
+    static const char acgt[4] = { 'A', 'C', 'G', 'T' };
+    for (size_t i = 0; i < n; i++) b[i] = (uint8_t)acgt[rnd_max(4)];
+}
+
+static void gen_binary(uint8_t *b, size_t n) {
+    /* structured binary: repeated records with small deltas - lots of
+       medium-distance matches, exercises the chain walk in longest_match */
+    uint32_t v = 0;
+    size_t i = 0;
+    while (i + 16 <= n) {
+        v += rnd_max(4);
+        memcpy(b + i, &v, 4);
+        uint32_t z = 0;
+        memcpy(b + i + 4, &z, 4);
+        uint32_t t = 0x40000000u + rnd_max(1024);
+        memcpy(b + i + 8, &t, 4);
+        memcpy(b + i + 12, &v, 4);
+        i += 16;
+    }
+    while (i < n) b[i++] = 0;
+}
+
+static void gen_random(uint8_t *b, size_t n) {
+    size_t i = 0;
+    while (i + 4 <= n) { uint32_t r = rnd(); memcpy(b + i, &r, 4); i += 4; }
+    while (i < n) b[i++] = (uint8_t)rnd();
+}
+
+static void gen_rle(uint8_t *b, size_t n) {
+    size_t i = 0;
+    while (i < n) {
+        uint8_t v = (uint8_t)rnd();
+        uint32_t run = 3 + rnd_max(300);
+        while (run-- && i < n) b[i++] = v;
+    }
+}
+
+static void gen_sparse(uint8_t *b, size_t n) {
+    memset(b, 0, n);
+    for (size_t i = 0; i < n / 64; i++) b[rnd_max((uint32_t)n)] = (uint8_t)rnd();
+}
+
+static void gen_mixed(uint8_t *b, size_t n) {
+    size_t off = 0, seg = n / 8;
+    if (seg == 0) seg = n;
+    for (int k = 0; off < n; k++) {
+        size_t l = (off + seg > n) ? n - off : seg;
+        switch (k % 6) {
+            case 0: gen_text(b + off, l);   break;
+            case 1: gen_binary(b + off, l); break;
+            case 2: gen_random(b + off, l); break;
+            case 3: gen_rle(b + off, l);    break;
+            case 4: gen_source(b + off, l); break;
+            default: gen_dna(b + off, l);   break;
+        }
+        off += l;
+    }
+}
+
+static void gen_data(int kind, uint8_t *b, size_t n) {
+    switch (kind) {
+        case DATA_TEXT:   gen_text(b, n);   break;
+        case DATA_SOURCE: gen_source(b, n); break;
+        case DATA_DNA:    gen_dna(b, n);    break;
+        case DATA_BINARY: gen_binary(b, n); break;
+        case DATA_RANDOM: gen_random(b, n); break;
+        case DATA_RLE:    gen_rle(b, n);    break;
+        case DATA_SPARSE: gen_sparse(b, n); break;
+        default:          gen_mixed(b, n);  break;
+    }
+}
+
+/* ------------------------------------------------------------------ */
+static void *xmalloc(size_t n) {
+    void *p = malloc(n ? n : 1);
+    if (!p) { fprintf(stderr, "pgo_trainer: out of memory\n"); exit(1); }
+    return p;
+}
+
+/* Streaming deflate then inflate, verifying round-trip.
+ * in_chunk/out_chunk deliberately vary to hit every buffer-boundary branch. */
+static void roundtrip(const uint8_t *src, size_t len, int level, int strategy,
+                      int win, int memlevel, int flush_mode,
+                      size_t in_chunk, size_t out_chunk,
+                      const uint8_t *dict, size_t dictlen) {
+    PREFIX3(stream) ds;
+    PREFIX3(stream) is;
+    uint8_t *comp, *decomp, *obuf;
+    size_t comp_cap = len + (len >> 2) + 4096;
+    size_t comp_len = 0;
+    int err;
+
+    memset(&ds, 0, sizeof(ds));
+    if (PREFIX(deflateInit2)(&ds, level, Z_DEFLATED, win, memlevel, strategy) != Z_OK)
+        return;
+
+    comp = (uint8_t *)xmalloc(comp_cap);
+    obuf = (uint8_t *)xmalloc(out_chunk);
+
+    if (dict && dictlen && win > 0)
+        PREFIX(deflateSetDictionary)(&ds, dict, (uint32_t)dictlen);
+
+    /* exercise the informational / tuning entry points */
+    (void)PREFIX(deflateBound)(&ds, (z_uintmax_t)len);
+    {
+        uint32_t pending = 0; int bits = 0;
+        PREFIX(deflatePending)(&ds, &pending, &bits);
+    }
+
+    ds.next_in = (void *)(uintptr_t)src;
+    ds.avail_in = 0;
+    size_t consumed = 0;
+    int done = 0;
+
+    while (!done) {
+        if (ds.avail_in == 0 && consumed < len) {
+            size_t take = len - consumed;
+            if (take > in_chunk) take = in_chunk;
+            ds.next_in = (void *)(uintptr_t)(src + consumed);
+            ds.avail_in = (uint32_t)take;
+            consumed += take;
+        }
+        int f = (consumed >= len && ds.avail_in == 0) ? Z_FINISH : flush_mode;
+        ds.next_out = obuf;
+        ds.avail_out = (uint32_t)out_chunk;
+        err = PREFIX(deflate)(&ds, f);
+        size_t produced = out_chunk - ds.avail_out;
+        if (produced) {
+            if (comp_len + produced > comp_cap) {
+                comp_cap = (comp_len + produced) * 2;
+                comp = (uint8_t *)realloc(comp, comp_cap);
+                if (!comp) { fprintf(stderr, "oom\n"); exit(1); }
+            }
+            memcpy(comp + comp_len, obuf, produced);
+            comp_len += produced;
+        }
+        if (err == Z_STREAM_END) done = 1;
+        else if (err != Z_OK && err != Z_BUF_ERROR) break;
+        else if (f == Z_FINISH && produced == 0 && ds.avail_out != 0) break;
+    }
+    PREFIX(deflateEnd)(&ds);
+    free(obuf);
+
+    /* ---------------- inflate side ---------------- */
+    memset(&is, 0, sizeof(is));
+    if (PREFIX(inflateInit2)(&is, win) != Z_OK) { free(comp); return; }
+
+    if (dict && dictlen && win < 0)
+        PREFIX(inflateSetDictionary)(&is, dict, (uint32_t)dictlen);
+
+    decomp = (uint8_t *)xmalloc(len + 64);
+    is.next_in = comp;
+    is.avail_in = 0;
+    is.next_out = decomp;
+    is.avail_out = (uint32_t)(len + 64);
+
+    size_t ic = 0;
+    for (;;) {
+        if (is.avail_in == 0 && ic < comp_len) {
+            size_t take = comp_len - ic;
+            if (take > in_chunk) take = in_chunk;
+            is.next_in = comp + ic;
+            is.avail_in = (uint32_t)take;
+            ic += take;
+        }
+        err = PREFIX(inflate)(&is, Z_NO_FLUSH);
+        if (err == Z_NEED_DICT && dict && dictlen) {
+            PREFIX(inflateSetDictionary)(&is, dict, (uint32_t)dictlen);
+            continue;
+        }
+        if (err == Z_STREAM_END || err == Z_DATA_ERROR || err == Z_MEM_ERROR ||
+            err == Z_STREAM_ERROR)
+            break;
+        if (err == Z_BUF_ERROR && ic >= comp_len) break;
+        if (is.avail_out == 0) break;
+    }
+    PREFIX(inflateEnd)(&is);
+
+    free(decomp);
+    free(comp);
+}
+
+/* deflateParams mid-stream + deflateCopy + deflateGetDictionary */
+static void exercise_params_copy(const uint8_t *src, size_t len) {
+    PREFIX3(stream) ds, cp;
+    uint8_t *out = (uint8_t *)xmalloc(len + 4096);
+    memset(&ds, 0, sizeof(ds));
+    if (PREFIX(deflateInit)(&ds, 6) != Z_OK) { free(out); return; }
+
+    ds.next_in = (void *)(uintptr_t)src;
+    ds.avail_in = (uint32_t)(len / 2);
+    ds.next_out = out;
+    ds.avail_out = (uint32_t)(len + 4096);
+    PREFIX(deflate)(&ds, Z_NO_FLUSH);
+
+    /* switch level and strategy mid-stream: forces a block flush and
+       (upstream) hash-chain rebuild - a path shell training never reaches */
+    PREFIX(deflateParams)(&ds, 1, Z_HUFFMAN_ONLY);
+    ds.avail_in = (uint32_t)(len - len / 2);
+    PREFIX(deflate)(&ds, Z_NO_FLUSH);
+    PREFIX(deflateParams)(&ds, 9, Z_FILTERED);
+    PREFIX(deflate)(&ds, Z_NO_FLUSH);
+    PREFIX(deflateParams)(&ds, 4, Z_RLE);
+    PREFIX(deflate)(&ds, Z_NO_FLUSH);
+    PREFIX(deflateParams)(&ds, 6, Z_DEFAULT_STRATEGY);
+
+    memset(&cp, 0, sizeof(cp));
+    if (PREFIX(deflateCopy)(&cp, &ds) == Z_OK) {
+        /* deflateGetDictionary may write up to the full window (w_size, max
+         * 32 KiB); the API has no output-capacity parameter, so the buffer
+         * must be worst-case sized. */
+        uint8_t *dbuf = (uint8_t *)xmalloc(1u << 15);
+        uint32_t dlen = 0;
+        PREFIX(deflateGetDictionary)(&cp, dbuf, &dlen);
+        free(dbuf);
+        PREFIX(deflateEnd)(&cp);
+    }
+    PREFIX(deflate)(&ds, Z_FINISH);
+    PREFIX(deflateEnd)(&ds);
+    free(out);
+}
+
+/* gzip header set/get + deflatePrime + inflate header parse */
+static void exercise_gzip_header(const uint8_t *src, size_t len) {
+    PREFIX3(stream) ds, is;
+    PREFIX(gz_header) hd, hi;
+    uint8_t extra[64], name[64], comment[128];
+    uint8_t namebuf[64], commbuf[128], extrabuf[64];
+    uint8_t *out = (uint8_t *)xmalloc(len + 8192);
+    uint8_t *dec = (uint8_t *)xmalloc(len + 64);
+
+    memset(&ds, 0, sizeof(ds));
+    if (PREFIX(deflateInit2)(&ds, 6, Z_DEFLATED, 16 + 15, 8, Z_DEFAULT_STRATEGY) != Z_OK)
+        goto out_free;
+
+    memset(&hd, 0, sizeof(hd));
+    memset(extra, 0xAB, sizeof(extra));
+    snprintf((char *)name, sizeof(name), "training-file.bin");
+    snprintf((char *)comment, sizeof(comment), "zlib-ng profile guided optimisation corpus");
+    hd.text = 1; hd.time = 0x5F000000; hd.os = 3;
+    hd.extra = extra; hd.extra_len = (uint32_t)sizeof(extra);
+    hd.name = name; hd.comment = comment; hd.hcrc = 1;
+    PREFIX(deflateSetHeader)(&ds, &hd);
+
+    ds.next_in = (void *)(uintptr_t)src;
+    ds.avail_in = (uint32_t)len;
+    ds.next_out = out;
+    ds.avail_out = (uint32_t)(len + 8192);
+    PREFIX(deflate)(&ds, Z_FINISH);
+    size_t clen = (len + 8192) - ds.avail_out;
+    PREFIX(deflateEnd)(&ds);
+
+    memset(&is, 0, sizeof(is));
+    if (PREFIX(inflateInit2)(&is, 16 + 15) == Z_OK) {
+        memset(&hi, 0, sizeof(hi));
+        hi.extra = extrabuf; hi.extra_max = (uint32_t)sizeof(extrabuf);
+        hi.name = namebuf;   hi.name_max = (uint32_t)sizeof(namebuf);
+        hi.comment = commbuf; hi.comm_max = (uint32_t)sizeof(commbuf);
+        PREFIX(inflateGetHeader)(&is, &hi);
+        is.next_in = out; is.avail_in = (uint32_t)clen;
+        is.next_out = dec; is.avail_out = (uint32_t)(len + 64);
+        PREFIX(inflate)(&is, Z_FINISH);
+        PREFIX(inflateEnd)(&is);
+    }
+out_free:
+    free(out);
+    free(dec);
+}
+
+/* inflateSync / inflateCopy / inflateReset2 / inflatePrime / inflateMark */
+static void exercise_inflate_misc(const uint8_t *src, size_t len) {
+    PREFIX3(stream) ds, is, ic;
+    uint8_t *out = (uint8_t *)xmalloc(len + 8192);
+    uint8_t *dec = (uint8_t *)xmalloc(len + 64);
+
+    memset(&ds, 0, sizeof(ds));
+    if (PREFIX(deflateInit)(&ds, 6) != Z_OK) goto done;
+    ds.next_in = (void *)(uintptr_t)src;
+    ds.avail_in = (uint32_t)(len / 2);
+    ds.next_out = out;
+    ds.avail_out = (uint32_t)(len + 8192);
+    PREFIX(deflate)(&ds, Z_FULL_FLUSH);   /* recovery point for inflateSync */
+    ds.avail_in = (uint32_t)(len - len / 2);
+    PREFIX(deflate)(&ds, Z_FINISH);
+    size_t clen = (len + 8192) - ds.avail_out;
+    PREFIX(deflateEnd)(&ds);
+
+    /* corrupt a byte early, then resynchronise */
+    if (clen > 64) out[16] ^= 0xFF;
+
+    memset(&is, 0, sizeof(is));
+    if (PREFIX(inflateInit)(&is) == Z_OK) {
+        is.next_in = out; is.avail_in = (uint32_t)clen;
+        is.next_out = dec; is.avail_out = (uint32_t)(len + 64);
+        int e = PREFIX(inflate)(&is, Z_NO_FLUSH);
+        if (e == Z_DATA_ERROR)
+            PREFIX(inflateSync)(&is);
+        (void)PREFIX(inflateMark)(&is);
+        memset(&ic, 0, sizeof(ic));
+        if (PREFIX(inflateCopy)(&ic, &is) == Z_OK)
+            PREFIX(inflateEnd)(&ic);
+        PREFIX(inflateReset2)(&is, -15);
+        PREFIX(inflatePrime)(&is, 8, 0);
+        PREFIX(inflateReset)(&is);
+        PREFIX(inflateEnd)(&is);
+    }
+done:
+    free(out);
+    free(dec);
+}
+
+/* deflatePrime + raw-stream bit stuffing: must run immediately after init,
+ * before any deflate() call, so it needs its own stream. */
+static void exercise_prime(const uint8_t *src, size_t len) {
+    PREFIX3(stream) ds;
+    uint8_t *out = (uint8_t *)xmalloc(len + 8192);
+
+    memset(&ds, 0, sizeof(ds));
+    if (PREFIX(deflateInit2)(&ds, 6, Z_DEFLATED, -15, 8, Z_DEFAULT_STRATEGY) != Z_OK) {
+        free(out);
+        return;
+    }
+    /* insert a few odd bit-widths to drive the bi_buf/bi_valid spill paths */
+    PREFIX(deflatePrime)(&ds, 5, 0x1F);
+    PREFIX(deflatePrime)(&ds, 3, 0x05);
+    PREFIX(deflatePrime)(&ds, 16, 0xBEEF);
+    ds.next_in = (void *)(uintptr_t)src;
+    ds.avail_in = (uint32_t)len;
+    ds.next_out = out;
+    ds.avail_out = (uint32_t)(len + 8192);
+    PREFIX(deflate)(&ds, Z_FINISH);
+    PREFIX(deflateEnd)(&ds);
+    free(out);
+}
+
+/* deflateTune: exercises the match-heuristic tuning entry point */
+static void exercise_tune(const uint8_t *src, size_t len) {
+    PREFIX3(stream) ds;
+    uint8_t *out = (uint8_t *)xmalloc(len + 8192);
+
+    memset(&ds, 0, sizeof(ds));
+    if (PREFIX(deflateInit)(&ds, 9) != Z_OK) {
+        free(out);
+        return;
+    }
+    PREFIX(deflateTune)(&ds, 32, 258, 258, 4096);
+    ds.next_in = (void *)(uintptr_t)src;
+    ds.avail_in = (uint32_t)len;
+    ds.next_out = out;
+    ds.avail_out = (uint32_t)(len + 8192);
+    PREFIX(deflate)(&ds, Z_FINISH);
+    PREFIX(deflateEnd)(&ds);
+    free(out);
+}
+
+/* ---------------- inflateBack ---------------- */
+struct ib_ctx {
+    const uint8_t *in; size_t inlen, inpos;
+    uint8_t *out; size_t outcap, outpos;
+};
+
+/* The in_func signature differs between the zlib-compat and native zlib-ng
+ * headers: compat uses `z_const unsigned char **` (which is plain
+ * `unsigned char **` unless ZLIB_CONST is defined) and returns `unsigned`,
+ * while zlib-ng uses `const uint8_t **`.  Spell the buffer parameter with the
+ * matching type in each configuration so no cast is needed and -Werror builds
+ * stay clean. */
+#ifdef ZLIB_COMPAT
+#  define IB_IN_BUF_T z_const unsigned char **
+#  define IB_OUT_RET  int
+#else
+#  define IB_IN_BUF_T const uint8_t **
+#  define IB_OUT_RET  int32_t
+#endif
+
+static uint32_t ib_in(void *desc, IB_IN_BUF_T buf) {
+    struct ib_ctx *c = (struct ib_ctx *)desc;
+    size_t left = c->inlen - c->inpos;
+    if (left == 0) return 0;
+    if (left > 4096) left = 4096;
+    *buf = (void *)(uintptr_t)(c->in + c->inpos);
+    c->inpos += left;
+    return (uint32_t)left;
+}
+
+static IB_OUT_RET ib_out(void *desc, uint8_t *buf, uint32_t len) {
+    struct ib_ctx *c = (struct ib_ctx *)desc;
+    if (c->outpos + len > c->outcap) return 1;
+    memcpy(c->out + c->outpos, buf, len);
+    c->outpos += len;
+    return 0;
+}
+
+static void exercise_inflate_back(const uint8_t *src, size_t len) {
+    PREFIX3(stream) ds, is;
+    uint8_t *comp = (uint8_t *)xmalloc(len + 8192);
+    uint8_t *dec = (uint8_t *)xmalloc(len + 64);
+    uint8_t *window = (uint8_t *)xmalloc(1u << 15);
+    struct ib_ctx ctx;
+
+    memset(&ds, 0, sizeof(ds));
+    if (PREFIX(deflateInit2)(&ds, 6, Z_DEFLATED, -15, 8, Z_DEFAULT_STRATEGY) != Z_OK)
+        goto done;
+    ds.next_in = (void *)(uintptr_t)src; ds.avail_in = (uint32_t)len;
+    ds.next_out = comp; ds.avail_out = (uint32_t)(len + 8192);
+    PREFIX(deflate)(&ds, Z_FINISH);
+    size_t clen = (len + 8192) - ds.avail_out;
+    PREFIX(deflateEnd)(&ds);
+
+    memset(&is, 0, sizeof(is));
+    if (PREFIX(inflateBackInit)(&is, 15, window) == Z_OK) {
+        ctx.in = comp; ctx.inlen = clen; ctx.inpos = 0;
+        ctx.out = dec; ctx.outcap = len + 64; ctx.outpos = 0;
+        PREFIX(inflateBack)(&is, ib_in, &ctx, ib_out, &ctx);
+        PREFIX(inflateBackEnd)(&is);
+    }
+done:
+    free(comp); free(dec); free(window);
+}
+
+/* one-shot helpers: compress/compress2/uncompress/uncompress2 */
+static void exercise_oneshot(const uint8_t *src, size_t len) {
+    for (int lvl = 0; lvl <= 9; lvl++) {
+        size_t cb = PREFIX(compressBound)((z_uintmax_t)len);
+        uint8_t *c = (uint8_t *)xmalloc(cb);
+        uint8_t *u = (uint8_t *)xmalloc(len + 16);
+        size_t clen = cb, ulen = len + 16;
+        if (PREFIX(compress2)(c, &clen, src, (z_uintmax_t)len, lvl) == Z_OK) {
+            PREFIX(uncompress)(u, &ulen, c, clen);
+            size_t src_used = clen;
+            ulen = len + 16;
+            PREFIX(uncompress2)(u, &ulen, c, &src_used);
+        }
+        free(c); free(u);
+    }
+    {
+        size_t cb = PREFIX(compressBound)((z_uintmax_t)len);
+        uint8_t *c = (uint8_t *)xmalloc(cb);
+        size_t clen = cb;
+        PREFIX(compress)(c, &clen, src, (z_uintmax_t)len);
+        free(c);
+    }
+}
+
+/* checksums across many alignments/lengths: this is what selects between the
+   scalar tail, SSE, AVX2 and folding-copy variants inside adler32/crc32 */
+static void exercise_checksums(const uint8_t *src, size_t len) {
+    volatile uint32_t sink = 0;
+    for (unsigned align = 0; align < 16; align++) {
+        if (align >= len) break;
+        const uint8_t *p = src + align;
+        size_t avail = len - align;
+        static const size_t sizes[] = { 1, 3, 7, 15, 16, 17, 31, 32, 33, 63, 64, 65,
+                                        127, 128, 129, 255, 256, 257, 1023, 1024,
+                                        4096, 16384, 65536 };
+        for (size_t i = 0; i < sizeof(sizes) / sizeof(sizes[0]); i++) {
+            size_t n = sizes[i];
+            if (n > avail) break;
+            sink ^= PREFIX(adler32)(1, p, (uint32_t)n);
+            sink ^= PREFIX(crc32)(0, p, (uint32_t)n);
+            sink ^= (uint32_t)PREFIX(adler32_z)(1, p, n);
+            sink ^= (uint32_t)PREFIX(crc32_z)(0, p, n);
+        }
+    }
+    /* long buffers drive the NMAX wrap and the big folding loops */
+    uint32_t a1 = PREFIX(adler32)(1, src, (uint32_t)len);
+    uint32_t c1 = PREFIX(crc32)(0, src, (uint32_t)len);
+    sink ^= (uint32_t)PREFIX(adler32_combine)(a1, a1, (z_off64_t)len);
+    sink ^= (uint32_t)PREFIX(crc32_combine)(c1, c1, (z_off64_t)len);
+    (void)sink;
+}
+
+#ifdef WITH_GZFILEOP
+static void exercise_gzfile(const uint8_t *src, size_t len, const char *path) {
+    gzFile f;
+    char mode[8];
+    static const char *const modes[] = { "wb1", "wb6", "wb9", "wb6f", "wb6h", "wb6R", "wb6F" };
+    for (size_t m = 0; m < sizeof(modes) / sizeof(modes[0]); m++) {
+        snprintf(mode, sizeof(mode), "%s", modes[m]);
+        f = PREFIX(gzopen)(path, mode);
+        if (!f) continue;
+        PREFIX(gzbuffer)(f, 32768);
+        PREFIX(gzputc)(f, 'H');
+        PREFIX(gzputs)(f, "eader line\n");
+        PREFIX(gzprintf)(f, "record %d %s\n", 42, "value");
+        PREFIX(gzfwrite)(src, 1, len > (1 << 18) ? (1 << 18) : len, f);
+        PREFIX(gzflush)(f, Z_SYNC_FLUSH);
+        PREFIX(gzsetparams)(f, 9, Z_FILTERED);
+        PREFIX(gzwrite)(f, src, (uint32_t)(len > 65536 ? 65536 : len));
+        PREFIX(gzclose)(f);
+
+        f = PREFIX(gzopen)(path, "rb");
+        if (!f) continue;
+        PREFIX(gzbuffer)(f, 16384);
+        char line[256];
+        PREFIX(gzgets)(f, line, (int)sizeof(line));
+        PREFIX(gzgetc)(f);
+        PREFIX(gzungetc)('x', f);
+        uint8_t buf[8192];
+        while (PREFIX(gzread)(f, buf, (uint32_t)sizeof(buf)) > 0) { }
+        (void)PREFIX(gzdirect)(f);
+        (void)PREFIX(gzeof)(f);
+        PREFIX(gzrewind)(f);
+        PREFIX(gzseek)(f, 1024, SEEK_SET);
+        (void)PREFIX(gztell)(f);
+        (void)PREFIX(gzoffset)(f);
+        PREFIX(gzfread)(buf, 1, sizeof(buf), f);
+        PREFIX(gzclose)(f);
+    }
+    remove(path);
+}
+#endif
+
+int main(int argc, char **argv) {
+    /* size defaults chosen so a full pass is a few seconds of real work per
+       build phase; scale with argv[1] (MiB) when a longer profile is wanted */
+    size_t mib = (argc > 1) ? (size_t)strtoul(argv[1], NULL, 10) : 4;
+    if (mib < 1) mib = 1;
+    if (mib > 64) mib = 64;
+    const char *tmpl = (argc > 2) ? argv[2] : "pgo_trainer_tmp.gz";
+
+    size_t big = mib * 1024 * 1024;
+    uint8_t *buf = (uint8_t *)xmalloc(big);
+    uint8_t *dict = (uint8_t *)xmalloc(32768);
+
+    gen_text(dict, 32768);
+
+    static const int strategies[] = {
+        Z_DEFAULT_STRATEGY, Z_FILTERED, Z_HUFFMAN_ONLY, Z_RLE, Z_FIXED
+    };
+    static const int flushes[] = {
+        Z_NO_FLUSH, Z_PARTIAL_FLUSH, Z_SYNC_FLUSH, Z_FULL_FLUSH, Z_BLOCK
+    };
+
+    for (int kind = 0; kind < DATA_NKINDS; kind++) {
+        rng_state = 0x9E3779B97F4A7C15ULL ^ (uint64_t)(kind + 1) * 0x100000001B3ULL;
+        gen_data(kind, buf, big);
+
+        /* --- the level x strategy matrix: this is the bulk of deflate work --- */
+        for (int level = 0; level <= 9; level++) {
+            for (size_t si = 0; si < sizeof(strategies) / sizeof(strategies[0]); si++) {
+                /* keep the per-cell slice modest so all cells are reached */
+                size_t slice = big / 8;
+                if (slice < 65536) slice = big;
+                roundtrip(buf, slice, level, strategies[si], 15, 8,
+                          Z_NO_FLUSH, 1 << 14, 1 << 14, NULL, 0);
+            }
+        }
+
+        /* --- window bits / memLevel / wrapper sweep --- */
+        size_t s2 = big / 16 ? big / 16 : big;
+        for (int win = 9; win <= 15; win++) {
+            roundtrip(buf, s2, 6, Z_DEFAULT_STRATEGY, win, 8, Z_NO_FLUSH,
+                      1 << 13, 1 << 13, NULL, 0);
+            roundtrip(buf, s2, 6, Z_DEFAULT_STRATEGY, -win, 8, Z_NO_FLUSH,
+                      1 << 13, 1 << 13, dict, 32768);
+            roundtrip(buf, s2, 6, Z_DEFAULT_STRATEGY, 16 + win, 8, Z_NO_FLUSH,
+                      1 << 13, 1 << 13, NULL, 0);
+        }
+        for (int ml = 1; ml <= 9; ml++)
+            roundtrip(buf, s2, 6, Z_DEFAULT_STRATEGY, 15, ml, Z_NO_FLUSH,
+                      1 << 13, 1 << 13, NULL, 0);
+
+        /* --- flush modes and awkward buffer sizes (tail/boundary paths) --- */
+        for (size_t fi = 0; fi < sizeof(flushes) / sizeof(flushes[0]); fi++)
+            roundtrip(buf, s2, 6, Z_DEFAULT_STRATEGY, 15, 8, flushes[fi],
+                      4096, 4096, NULL, 0);
+
+        static const size_t odd[] = { 1, 2, 3, 7, 13, 61, 257, 1021, 4093, 16381 };
+        for (size_t oi = 0; oi < sizeof(odd) / sizeof(odd[0]); oi++)
+            roundtrip(buf, big / 32 ? big / 32 : big, 6, Z_DEFAULT_STRATEGY, 15, 8,
+                      Z_NO_FLUSH, odd[oi], odd[oi], NULL, 0);
+
+        /* --- dictionaries --- */
+        roundtrip(buf, s2, 6, Z_DEFAULT_STRATEGY, 15, 8, Z_NO_FLUSH,
+                  1 << 13, 1 << 13, dict, 32768);
+        roundtrip(buf, s2, 9, Z_DEFAULT_STRATEGY, 15, 8, Z_NO_FLUSH,
+                  1 << 13, 1 << 13, dict, 1024);
+
+        /* --- API surface --- */
+        exercise_params_copy(buf, s2);
+        exercise_prime(buf, s2);
+        exercise_tune(buf, big / 32 ? big / 32 : big);
+        exercise_gzip_header(buf, s2);
+        exercise_inflate_misc(buf, s2);
+        exercise_inflate_back(buf, s2);
+        exercise_oneshot(buf, big / 64 ? big / 64 : big);
+        exercise_checksums(buf, big / 4 ? big / 4 : big);
+#ifdef WITH_GZFILEOP
+        exercise_gzfile(buf, big / 8 ? big / 8 : big, tmpl);
+#else
+        (void)tmpl;
+#endif
+    }
+
+    free(buf);
+    free(dict);
+    return 0;
+}
