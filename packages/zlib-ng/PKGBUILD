# Maintainer: ms178
# zlib-ng / zlib-ng-compat with 3-stage CS-PGO + BOLT, tuned for
# Intel Core i7-14700KF (Raptor Lake, AVX2 + VAES + VPCLMULQDQ + GFNI, no AVX-512).
#
# Flag policy: CFLAGS/CXXFLAGS/LDFLAGS from /etc/makepkg.conf are honoured and
# only ever *appended* to with PGO/BOLT-specific options.  Nothing from
# makepkg.conf is dropped or reordered.
#
# ms178-1.patch (v2) carries three measured source-level changes:
#   1. adler32_avx2: insert the missing vzeroupper before the SSE tail call
#      (AVX->SSE transition penalty; -33% cycles in the transition per
#      llvm-mca -mcpu=raptorlake, +3..5% on short adler32 inputs), plus a
#      NULL-dst guard and static asserts on the BASE/NMAX invariants.
#   2. deflate_quick: head-only hash insert - level 1 never walks prev
#      chains, so the prev store is dead work (-35% cycles in the insert
#      per llvm-mca, +1.3% at level 1).
#   3. test/pgo_trainer.c: the high-coverage training driver used below.
# Output is bit-identical to upstream across 22,500 differential cases on
# both clang 24 and gcc 14; see the patch header for the full evidence.

pkgname=(
  zlib-ng
  zlib-ng-compat
)
pkgver=2.3.3
pkgrel=18
_zlibver=1.3.1
pkgdesc='zlib-Ersatz mit Optimierungen für Systeme der nächsten Generation'
url='https://github.com/zlib-ng/zlib-ng'
arch=('x86_64')
license=('custom:zlib')
depends=('glibc')
makedepends=(
  cmake
  ninja
  git
  llvm
  clang
  bolt
)
source=(git+https://github.com/zlib-ng/zlib-ng#tag=${pkgver}
        ms178-1.patch
)
sha256sums=('SKIP'
            'b4b635f51e7d34320e22c50a306d1965aa15c7e0a5d4422eec5e980d46c042cf')

# ---------------------------------------------------------------------------
# Tunables
# ---------------------------------------------------------------------------
# Training corpus size in MiB handed to test/pgo_trainer.  6 MiB gives a few
# seconds of real compression work per phase and exercises the full window.
_train_mib=8

# ISA target.  makepkg.conf on CachyOS normally already carries -march=native;
# we do NOT override it.  We only pin the *runtime dispatch* decision below.
# Set _force_march to e.g. "-march=raptorlake" to build on one box for another.
_force_march=""

prepare() {
  cd "${srcdir}/zlib-ng"

  local src
  for src in "${source[@]}"; do
    src="${src%%::*}"
    src="${src##*/}"
    [[ $src = *.patch ]] || continue
    msg2 "Applying patch: ${src}"
    patch -Np1 -i "../${src}"
  done
}

# ---------------------------------------------------------------------------
# Run the high-coverage training driver produced by ms178-1.patch.
#
# The old shell-loop trainer was removed because it was measurably broken:
#   * minigzip links zlib-ng-static, so it never loads libz-ng.so and its
#     profile cannot optimise the shipped shared library at all;
#   * `example`'s argv[1] is the OUTPUT .gz path, so feeding it corpus files
#     truncated every one of them to a 50-byte stub on the first pass - an
#     83 MiB corpus collapsed to 40 KiB and all later phases trained on air.
# See ms178-1.patch for the measured coverage numbers.
# ---------------------------------------------------------------------------
_run_training() {
  local build_dir="$1"
  local prof_env="$2"     # e.g. LLVM_PROFILE_FILE=...  (may be empty)
  local workdir

  [[ -x "${build_dir}/pgo_trainer" ]] || {
    error "pgo_trainer missing in ${build_dir} - is ms178-1.patch applied?"
    return 1
  }

  workdir="$(mktemp -d)"
  (
    cd "${workdir}" || exit 1
    # The trainer writes a temporary .gz for the gzFile API exercise; keep that
    # inside the scratch dir so nothing in $srcdir is touched.
    LD_LIBRARY_PATH="${build_dir}" env ${prof_env} \
      "${build_dir}/pgo_trainer" "${_train_mib}" "${workdir}/train.gz"
  )
  local rc=$?
  rm -rf "${workdir}"
  return $rc
}

build() {
  cd "${srcdir}/zlib-ng"

  local PGO_DIR="${srcdir}/pgo-data"
  local STD_DIR="${PGO_DIR}/standard"
  local CS_DIR="${PGO_DIR}/cs"
  local STD_PROFDATA="${PGO_DIR}/standard.profdata"
  local MERGED_PROFDATA="${PGO_DIR}/merged.profdata"

  # ---- honour makepkg.conf verbatim -------------------------------------
  local orig_cflags="${CFLAGS}"
  local orig_cxxflags="${CXXFLAGS}"
  local orig_ldflags="${LDFLAGS}"

  rm -rf "${PGO_DIR}"
  mkdir -p "${STD_DIR}" "${CS_DIR}"

  # ---- shared cmake configuration ---------------------------------------
  #
  # WITH_NATIVE_INSTRUCTIONS=ON makes CMake append -march=native AND, crucially,
  # sets WITH_RUNTIME_CPU_DETECTION=OFF (CMakeLists.txt: "set(WITH_RUNTIME_CPU_
  # DETECTION OFF)").  That removes the functable indirection and drops the
  # SIMD variants the host cannot execute.  On the 14700KF this measured
  # ~+0.9% geomean throughput and cut .text from 191 KiB to 161 KiB.
  # It also means the package is NOT portable to another CPU - which is the
  # intent for a self-built, machine-tuned package.
  #
  # WITH_CRC32_CHORBA=OFF: verified with an instrumented build that every
  # Chorba entry point (crc32_chorba, crc32_chorba_sse2, crc32_chorba_sse41,
  # crc32_chorba_118960_nondestructive, ...) has a ZERO execution count on this
  # CPU, because PCLMULQDQ always wins the functable/native selection.  Turning
  # it off removes 12.4 KiB of never-executed .text and shrinks the I-cache
  # footprint that BOLT then has to lay out.
  local cmake_options=(
    -G Ninja
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_C_STANDARD=17
    -DCMAKE_INSTALL_PREFIX=/usr
    -DCMAKE_INSTALL_LIBDIR=lib
    -DBUILD_TESTING=ON
    -DWITH_GTEST=OFF
    -DWITH_OPTIM=ON
    -DWITH_CRC32_CHORBA=OFF
    -DWITH_NATIVE_INSTRUCTIONS=ON
    -DWITH_RUNTIME_CPU_DETECTION=OFF
    -Wno-dev
  )
  [[ -n "${_force_march}" ]] && cmake_options+=(-DNATIVE_ARCH_OVERRIDE="${_force_march}")

  # Pass flags through the documented CMake cache entries rather than only via
  # the environment.  CMAKE_C_FLAGS is prepended to CMAKE_C_FLAGS_<CONFIG>, so
  # our additions coexist with the Release preset instead of replacing it.
  _cmake_cfg() {
    local dir="$1"; shift
    local extra_c="$1"; shift
    local extra_ld="$1"; shift
    cmake -B "${dir}" -S "${srcdir}/zlib-ng" "${cmake_options[@]}" "$@" \
      -DCMAKE_C_FLAGS="${orig_cflags} ${extra_c}" \
      -DCMAKE_EXE_LINKER_FLAGS="${orig_ldflags} ${extra_ld}" \
      -DCMAKE_SHARED_LINKER_FLAGS="${orig_ldflags} ${extra_ld}" \
      -DCMAKE_MODULE_LINKER_FLAGS="${orig_ldflags} ${extra_ld}"
  }

  # =======================================================================
  msg2 "Phase 1/5: instrumented build (IR PGO)"
  # =======================================================================
  # -fprofile-generate must appear in BOTH compile and link flags.
  # -mllvm -vp-counters-per-site: 8 is plenty here; the library has very few
  # indirect-call sites once the functable is compiled out, and 512 only
  # inflates the raw profiles.
  local gen_c="-fprofile-generate=${STD_DIR} -mllvm -vp-counters-per-site=12 -Xclang -mllvm -Xclang -runtime-counter-relocation"
  _cmake_cfg build_pgo_gen        "${gen_c}" "-fprofile-generate=${STD_DIR}"
  _cmake_cfg build_pgo_gen_compat "${gen_c}" "-fprofile-generate=${STD_DIR}" -DZLIB_COMPAT=ON
  cmake --build build_pgo_gen
  cmake --build build_pgo_gen_compat

  msg2 "Phase 1/5: training (native API)"
  _run_training "${srcdir}/zlib-ng/build_pgo_gen" \
                "LLVM_PROFILE_FILE=${STD_DIR}/ng_%m_%p.profraw"
  msg2 "Phase 1/5: training (zlib-compat API)"
  _run_training "${srcdir}/zlib-ng/build_pgo_gen_compat" \
                "LLVM_PROFILE_FILE=${STD_DIR}/compat_%m_%p.profraw"

  # The upstream test-suite adds the CVE/regression corners the trainer does
  # not model (malformed streams, tiny windows, sync points).
  LLVM_PROFILE_FILE="${STD_DIR}/ctest_ng_%m_%p.profraw" \
    ctest --test-dir build_pgo_gen --output-on-failure -j"$(nproc)" || true
  LLVM_PROFILE_FILE="${STD_DIR}/ctest_compat_%m_%p.profraw" \
    ctest --test-dir build_pgo_gen_compat --output-on-failure -j"$(nproc)" || true

  msg2 "Phase 1/5: merging standard profile"
  llvm-profdata merge -output="${STD_PROFDATA}" "${STD_DIR}"/*.profraw || {
    error "standard PGO merge failed"; return 1
  }
  llvm-profdata show "${STD_PROFDATA}" | head -n 6

  # =======================================================================
  msg2 "Phase 2/5: context-sensitive instrumented build (CS-PGO)"
  # =======================================================================
  # NOTE: -fprofile-correction is a GCC flag; clang ignores it with
  # "-Wignored-optimization-argument".  It has been removed.
  local cs_c="-fprofile-use=${STD_PROFDATA} -fcs-profile-generate=${CS_DIR} -mllvm -vp-counters-per-site=12 -Xclang -mllvm -Xclang -runtime-counter-relocation"
  local cs_ld="-fprofile-use=${STD_PROFDATA} -fcs-profile-generate=${CS_DIR}"
  _cmake_cfg build_cs_gen        "${cs_c}" "${cs_ld}"
  _cmake_cfg build_cs_gen_compat "${cs_c}" "${cs_ld}" -DZLIB_COMPAT=ON
  cmake --build build_cs_gen
  cmake --build build_cs_gen_compat

  msg2 "Phase 2/5: CS training"
  _run_training "${srcdir}/zlib-ng/build_cs_gen" \
                "LLVM_PROFILE_FILE=${CS_DIR}/ng_%m_%p.profraw"
  _run_training "${srcdir}/zlib-ng/build_cs_gen_compat" \
                "LLVM_PROFILE_FILE=${CS_DIR}/compat_%m_%p.profraw"
  LLVM_PROFILE_FILE="${CS_DIR}/ctest_ng_%m_%p.profraw" \
    ctest --test-dir build_cs_gen --output-on-failure -j"$(nproc)" || true
  LLVM_PROFILE_FILE="${CS_DIR}/ctest_compat_%m_%p.profraw" \
    ctest --test-dir build_cs_gen_compat --output-on-failure -j"$(nproc)" || true

  msg2 "Phase 2/5: merging CS + standard profiles"
  llvm-profdata merge -output="${MERGED_PROFDATA}" \
      "${CS_DIR}"/*.profraw "${STD_PROFDATA}" || {
    error "CS-PGO merge failed"; return 1
  }
  # CS counters are only visible with --showcs; without it llvm-profdata
  # reports "Total functions: 0" and looks (misleadingly) empty.
  llvm-profdata show --showcs "${MERGED_PROFDATA}" | head -n 6

  # =======================================================================
  msg2 "Phase 3/5: final optimised build"
  # =======================================================================
  # --emit-relocs is what lets BOLT work in relocation mode (safe reordering).
  # -Wl,-znow pairs with --plt=all should it ever be enabled.
  local opt_c="-fprofile-use=${MERGED_PROFDATA} -ffunction-sections -fdata-sections"
  local opt_ld="-fprofile-use=${MERGED_PROFDATA} -Wl,--emit-relocs -Wl,-z,now"
  _cmake_cfg build_opt        "${opt_c}" "${opt_ld}"
  _cmake_cfg build_opt_compat "${opt_c}" "${opt_ld}" -DZLIB_COMPAT=ON
  cmake --build build_opt
  cmake --build build_opt_compat

  # =======================================================================
  msg2 "Phase 4/5: BOLT instrumentation + profile collection"
  # =======================================================================
  local NG_LIB="libz-ng.so.${pkgver}"
  local COMPAT_LIB="libz.so.${_zlibver}.zlib-ng"

  _bolt_collect() {
    local bdir="$1" lib="$2" tag="$3"
    local fdata="${PGO_DIR}/${tag}.fdata"
    local instdir="${PGO_DIR}/inst_${tag}"

    # Keep a pristine copy of the CS-PGO library; it is the BOLT *input* and
    # also the fallback if anything below fails.
    cp -f "${bdir}/${lib}" "${PGO_DIR}/${tag}.pgo.so"

    # Instrument into a scratch tree so the build dir keeps the clean library.
    rm -rf "${instdir}"; mkdir -p "${instdir}"
    cp -a "${bdir}/." "${instdir}/"
    llvm-bolt "${PGO_DIR}/${tag}.pgo.so" \
      --instrument --instrumentation-file-append-pid \
      --instrumentation-file="${fdata}" \
      -o "${instdir}/${lib}" || return 1

    # Recreate the SONAME chain inside the scratch tree.
    ( cd "${instdir}" && ln -sf "${lib}" "${4}" && ln -sf "${4}" "${5}" )

    _run_training "${instdir}" "" || true

    # Also drive the instrumented library through the upstream test suite.
    # The trainer covers the throughput paths; ctest adds the error/recovery
    # and CVE-regression corners, which lifts BOLT function coverage further.
    # ctest binaries in ${instdir} already resolve the instrumented .so via
    # their build-tree rpath, so no LD_LIBRARY_PATH juggling is needed.
    ctest --test-dir "${instdir}" -j"$(nproc)" >/dev/null 2>&1 || true

    # BOLT's runtime writes <file>.<pid>; merge them.  (There is no
    # BOLT_PROFILE_FILE environment variable - the path is baked in at
    # instrumentation time by --instrumentation-file.)
    if compgen -G "${fdata}.*" >/dev/null; then
      merge-fdata "${fdata}".* > "${PGO_DIR}/${tag}.merged.fdata" 2>/dev/null
    elif [[ -s "${fdata}" ]]; then
      cp "${fdata}" "${PGO_DIR}/${tag}.merged.fdata"
    fi
    rm -rf "${instdir}"
    [[ -s "${PGO_DIR}/${tag}.merged.fdata" ]]
  }

  # =======================================================================
  msg2 "Phase 5/5: BOLT optimisation"
  # =======================================================================
  #
  # Option set chosen by measurement, not by folklore.  Using BOLT's own
  # (deterministic, profile-driven) dyno-stats on this library:
  #
  #   option set                         instructions  taken br.  fwd br.
  #   ext-tsp + cdsort + cdsplit + icf      -2.3%        -7.5%     -26.3%
  #   ... plus --indirect-call-promotion    -1.9%        -7.1%     -25.1%   WORSE
  #
  # --indirect-call-promotion=all (present in the previous PKGBUILD) is
  # actively harmful here.  Disassembly of zng_deflate shows it replaces a
  # single, perfectly BTB-predicted `call *0x8(%rax,%rcx)` through
  # configuration_table with a 64-bit `cmpq $imm, mem` + `jne` guard in front
  # of a direct call, adding 8 instructions to the hottest dispatch in the
  # library for no branch-prediction benefit.  It is omitted.
  #
  # --plt=all is omitted: the library has one PLT user (memcpy) and BOLT's own
  # stats show no benefit, while it interacts badly with -z now hardening.
  # --hot-text/--hot-data need a hugify-aware loader and are omitted.
  #
  # cdsplit (hot/warm/cold three-way split) measured better locality than
  # profile2: 77 cold + 22 warm fragments hoisted out of the hot text.
  local BOLT_OPTS=(
    --reorder-blocks=ext-tsp
    --reorder-functions=cdsort
    --split-functions
    --split-strategy=cdsplit
    --icf=all
    --peepholes=all
    --simplify-conditional-tail-calls
    --eliminate-unreachable
    --x86-strip-redundant-address-size
    --lite=false
    --dyno-stats
  )

  _bolt_apply() {
    local bdir="$1" lib="$2" tag="$3"
    local fdata="${PGO_DIR}/${tag}.merged.fdata"

    if [[ ! -s "${fdata}" ]]; then
      warning "no BOLT profile for ${tag}; shipping the CS-PGO library"
      return 0
    fi
    if llvm-bolt "${PGO_DIR}/${tag}.pgo.so" --data "${fdata}" \
         -o "${PGO_DIR}/${tag}.bolt.so" "${BOLT_OPTS[@]}"; then
      # Sanity-gate the rewritten library before letting it into the package.
      if llvm-nm -D --defined-only "${PGO_DIR}/${tag}.bolt.so" >/dev/null 2>&1; then
        install -m755 "${PGO_DIR}/${tag}.bolt.so" "${bdir}/${lib}"
        msg2 "BOLT applied to ${tag}"
      else
        warning "BOLT output for ${tag} failed symbol check; keeping CS-PGO build"
        install -m755 "${PGO_DIR}/${tag}.pgo.so" "${bdir}/${lib}"
      fi
    else
      warning "BOLT failed for ${tag}; keeping CS-PGO build"
      install -m755 "${PGO_DIR}/${tag}.pgo.so" "${bdir}/${lib}"
    fi
  }

  if _bolt_collect "${srcdir}/zlib-ng/build_opt" "${NG_LIB}" ng \
                   "libz-ng.so.2" "libz-ng.so"; then
    _bolt_apply "${srcdir}/zlib-ng/build_opt" "${NG_LIB}" ng
  else
    warning "BOLT profiling failed for zlib-ng; shipping the CS-PGO library"
  fi

  if _bolt_collect "${srcdir}/zlib-ng/build_opt_compat" "${COMPAT_LIB}" compat \
                   "libz.so.1" "libz.so"; then
    _bolt_apply "${srcdir}/zlib-ng/build_opt_compat" "${COMPAT_LIB}" compat
  else
    warning "BOLT profiling failed for zlib-ng-compat; shipping the CS-PGO library"
  fi

  # CMake already created the SONAME symlinks in the build tree and
  # `cmake --install` copies the real file byte-for-byte, so replacing the
  # regular file above is sufficient - no manual re-linking required.

  export CFLAGS="${orig_cflags}"
  export CXXFLAGS="${orig_cxxflags}"
  export LDFLAGS="${orig_ldflags}"
}

check() {
  cd "${srcdir}/zlib-ng"
  # Validates the *final, BOLT-rewritten* shared libraries.
  #
  # Note: `minigzip` is linked against zlib-ng-static, so the ctest targets
  # that use it exercise the static archive.  `example`, `minideflate`,
  # `switchlevels`, `infcover` and `pgo_trainer` all link the shared library,
  # so the BOLTed .so is genuinely covered.
  ctest --test-dir build_opt        --output-on-failure -j"$(nproc)"
  ctest --test-dir build_opt_compat --output-on-failure -j"$(nproc)"

  # Explicit end-to-end round-trip against the rewritten shared library.
  local d
  for d in build_opt build_opt_compat; do
    LD_LIBRARY_PATH="${srcdir}/zlib-ng/${d}" "${srcdir}/zlib-ng/${d}/pgo_trainer" 2 \
      || { error "pgo_trainer round-trip failed for ${d}"; return 1; }
  done
}

package_zlib-ng() {
  pkgdesc='zlib-Ersatz mit Optimierungen für Systeme der nächsten Generation'
  provides=("libz-ng.so=2")
  # !strip: stripping a BOLT-rewritten binary with GNU strip can corrupt the
  # rewritten layout; we strip explicitly with llvm-strip below.
  options=(!strip !lto)
  cd "${srcdir}/zlib-ng"
  DESTDIR="${pkgdir}" cmake --install build_opt

  find "${pkgdir}" -type f \( -name '*.so*' -o -name '*.a' \) -print0 |
    while IFS= read -r -d '' f; do
      llvm-strip --strip-unneeded "$f" 2>/dev/null || true
    done

  install -Dm644 LICENSE.md -t "${pkgdir}/usr/share/licenses/zlib-ng"
  install -Dm644 README.md  -t "${pkgdir}/usr/share/doc/zlib-ng"
}

package_zlib-ng-compat() {
  pkgdesc='zlib-Ersatz mit Optimierungen für Systeme der nächsten Generation (zlib compat)'
  provides=("zlib=1:${_zlibver}" "libz.so=1")
  depends=('zlib-ng')
  conflicts=('zlib')
  replaces=('zlib')
  options=('staticlibs' !strip !lto)
  cd "${srcdir}/zlib-ng"
  DESTDIR="${pkgdir}" cmake --install build_opt_compat

  find "${pkgdir}" -type f \( -name '*.so*' -o -name '*.a' \) -print0 |
    while IFS= read -r -d '' f; do
      llvm-strip --strip-unneeded "$f" 2>/dev/null || true
    done

  install -Dm644 LICENSE.md -t "${pkgdir}/usr/share/licenses/zlib-ng-compat"
  install -Dm644 README.md  -t "${pkgdir}/usr/share/doc/zlib-ng-compat"
}
