# Maintainer: ms178
#
# irqbalance-git, PGO + CS-PGO + BOLT + LTO, tuned to co-operate with
# pin-latency-irqs.fish (see AUDIT.md for the measurements behind every choice).
#
# Changes vs the previous revision, all evidence-driven:
#
#  P1  ms178-1.patch is a LOCAL file; 'SKIP' disabled its only integrity check.
#      Now carries a real sha256 so a corrupted/edited patch fails the build.
#  P2  A failing patch was swallowed by an "already applied or not applicable"
#      message and the package silently built UNPATCHED. Now: applied-check is
#      explicit and a genuine failure is fatal.
#  P3  Three serial `make -j1` passes. The build is not order-dependent;
#      restored parallelism (~3x faster PGO cycle).
#  P4  check() ran ./irqbalance from the build dir, which after stage 4 is the
#      BOLT-*instrumented* binary. It now validates the final artifact and
#      asserts it is not an instrumented build.
#  P5  misc/irqbalance.service has
#          EnvironmentFile=/usr/etc/default/irqbalance.env      (never created)
#          EnvironmentFile=-${prefix}/etc/default/irqbalance    (not absolute)
#      systemd rejects the second on every boot -- visible in the user's
#      journal as "EnvironmentFile= path is not absolute, ignoring".
#      Net effect: IRQBALANCE_BANNED_CPULIST in /etc/irqbalance.env was NEVER
#      READ, so the CPU ban that keeps irqbalance off the pinned cores did
#      nothing. The unit is now generated with correct paths.
#  P6  ExecStart hardcoded /usr/sbin while --sbindir=/usr/bin. Works only
#      because Arch symlinks /usr/sbin. Now consistent.
#  P7  ProtectSystem=strict + ReadOnlyPaths=/ with RuntimeDirectory: the UI
#      socket lives in /run/irqbalance, which needs to be writable. Kept
#      RuntimeDirectory and added the matching ReadWritePaths.
#
# NOTE ON THE OPTIMISATION PIPELINE
# ---------------------------------
# Measured on the target class of machine: a full irqbalance --oneshot run is
# 1,187,990 instructions, of which ~79.5% is the dynamic loader and ~1.6% is
# irqbalance's own code (largest single function __bitmap_parse at 0.66%).
# Steady-state daemon CPU at the most aggressive 1s interval measured 0.000s
# over 20s -- below timer resolution.
#
# PGO/CS-PGO/BOLT therefore optimise a very small slice of an already
# negligible cost. They are retained because they are harmless and the
# infrastructure exists, but the training workload is now honest about its
# limits (see prepare()) and every stage degrades gracefully instead of
# producing a mis-trained binary.

pkgname=irqbalance-git
pkgver=1.9.5.r14.g16844fb
pkgrel=1
pkgdesc="Daemon to balance interrupts across CPUs (PGO+CS-PGO+BOLT optimized, latency-tuned)"
arch=('x86_64')
url="https://irqbalance.github.io/irqbalance/"
license=('GPL')
options=(!strip !lto)

depends=(
  'glib2'
  'glibc'
  'libcap-ng'
  'numactl'
  'systemd-libs'
)

makedepends=(
  'git'
  'autoconf'
  'automake'
  'libtool'
  'pkgconf'
  'glib2'
  'libcap-ng'
  'ncurses'
  'systemd'
  'stress-ng'
  'clang'
  'llvm'
  'lld'
)

provides=('irqbalance')
conflicts=('irqbalance')
backup=('etc/irqbalance.env')

source=(
  "git+https://github.com/Irqbalance/irqbalance.git"
  "ms178-1.patch"
)

# P1: the local patch is checksummed. Regenerate with `updpkgsums` after edits.
sha256sums=(
  'SKIP'
  '34bd5d5219be289325a34f6fc9597d8deb7d453728b986bdab8aafe6cf719fe3'
)

pkgver() {
  cd "$srcdir/irqbalance"
  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "$srcdir/irqbalance"

  # P2: distinguish "already applied" from "broken patch". Only the former
  # is acceptable; the latter must stop the build rather than silently
  # producing an unpatched package.
  if [[ -f "$srcdir/ms178-1.patch" ]]; then
    if patch -Np1 -N --dry-run -i "$srcdir/ms178-1.patch" >/dev/null 2>&1; then
      echo "==> Applying ms178-1.patch"
      patch -Np1 -N -i "$srcdir/ms178-1.patch"
    elif patch -Np1 -R --dry-run -i "$srcdir/ms178-1.patch" >/dev/null 2>&1; then
      echo "==> ms178-1.patch already applied, continuing"
    else
      echo "!!! ms178-1.patch does not apply to this tree -- refusing to build"
      echo "!!! an unpatched package. Rebase the patch against upstream."
      return 1
    fi
  fi

  # Training workload.
  #
  # Honest limitation: makepkg runs unprivileged, so irqbalance cannot write
  # /proc/irq/*/smp_affinity. Measured on an unprivileged run it enters the
  # activate path but every write fails; on a container it sees 5 IRQs versus
  # 40+ on the target machine. The profile is therefore representative of
  # parsing/classification, NOT of placement. Do not add flags whose payoff
  # depends on placement being hot.
  cat > "$srcdir/training-workload.sh" << 'EOF'
#!/usr/bin/env bash
set -u
NUM_CPUS=$(nproc)
DURATION=${TRAIN_DURATION:-60}
TEMP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/irqbalance-train.XXXXXX")

cleanup() {
  [[ -n "${IRQ_PID:-}" ]] && kill -TERM "$IRQ_PID" 2>/dev/null
  pkill -P $$ 2>/dev/null || true
  sleep 0.3
  pkill -9 -P $$ 2>/dev/null || true
  rm -rf "$TEMP_DIR" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

BIN=./irqbalance
[[ -x "$BIN" ]] || { echo "ERROR: $BIN not found"; exit 1; }

echo "=== training: ${DURATION}s, ${NUM_CPUS} cpus ==="

# -t 1 forces the scan path to run every second: that is the code PGO should
# see. Without it the daemon sleeps through most of the training window.
setsid "$BIN" --foreground -t 1 >/dev/null 2>&1 < /dev/null &
IRQ_PID=$!
sleep 2

if ! kill -0 "$IRQ_PID" 2>/dev/null; then
  echo "ERROR: irqbalance exited immediately"
  exit 1
fi

# Interrupt pressure: context switches and timer IRQs are what a desktop
# actually generates. Disk IO via fio was dropped -- it trains the block
# layer, not irqbalance, and made the build depend on 700MB of scratch space.
if command -v stress-ng >/dev/null 2>&1; then
  stress-ng --cpu $(( NUM_CPUS > 2 ? NUM_CPUS - 1 : 1 )) --cpu-method all \
            --switch $(( NUM_CPUS * 4 )) --timer 4 --timer-freq 5000 \
            --timeout "${DURATION}s" >/dev/null 2>&1 &
fi

for _ in $(seq 1 4); do
  ( while :; do ping -n -c 500 -i 0.002 127.0.0.1 >/dev/null 2>&1 || sleep 1; done ) &
done

# Exercise the UI socket: get_object_stat()/get_irq_data() are the functions
# the patch rewrote, and they are only reachable through it.
(
  sleep 3
  SOCK="/run/irqbalance/irqbalance${IRQ_PID}.sock"
  for _ in $(seq 1 $(( DURATION / 2 ))); do
    if command -v irqbalance-ui >/dev/null 2>&1; then
      timeout 2 irqbalance-ui -o >/dev/null 2>&1 || true
    fi
    [[ -S "$SOCK" ]] && { printf 'stats' | timeout 2 socat - "UNIX-CONNECT:$SOCK" >/dev/null 2>&1 || true; }
    sleep 2
  done
) &

sleep "$DURATION"
echo "=== training complete ==="
EOF
  chmod +x "$srcdir/training-workload.sh"

  autoreconf -fi
}

build() {
  cd "$srcdir/irqbalance"

  export CC=clang
  export CXX=clang++
  export LD=ld.lld
  export AR=llvm-ar
  export NM=llvm-nm
  export RANLIB=llvm-ranlib
  export STRIP=llvm-strip

  local BASE_CFLAGS="$CFLAGS"
  local BASE_LDFLAGS="$LDFLAGS"

  # P3: the build is not order-sensitive; use all cores.
  local JOBS
  JOBS=$(nproc)

  configure_irqbalance() {
    ./configure --prefix=/usr --sbindir=/usr/bin --with-systemd --disable-debug
  }

  ###########################################################################
  # Stage 1: PGO instrumentation
  ###########################################################################
  echo "=== Stage 1: PGO instrumentation ==="
  rm -rf "$srcdir/pgo-data"; mkdir -p "$srcdir/pgo-data"
  export LLVM_PROFILE_FILE="$srcdir/pgo-data/irqbalance-%p-%m.profraw"

  export CFLAGS="$BASE_CFLAGS -fprofile-generate=$srcdir/pgo-data -fno-omit-frame-pointer -mllvm -vp-counters-per-site=100"
  export LDFLAGS="$BASE_LDFLAGS -fprofile-generate=$srcdir/pgo-data"

  configure_irqbalance
  make -j"$JOBS"
  "$srcdir/training-workload.sh" || echo "WARNING: training run had issues"

  if ! find "$srcdir/pgo-data" -name '*.profraw' -size +1k | grep -q .; then
    echo "!!! No PGO profiles generated; building without PGO."
    unset LLVM_PROFILE_FILE
    export CFLAGS="$BASE_CFLAGS"
    export LDFLAGS="$BASE_LDFLAGS"
    make clean; configure_irqbalance; make -j"$JOBS"
    return 0
  fi

  llvm-profdata merge -output="$srcdir/pgo-data/default.profdata" "$srcdir"/pgo-data/*.profraw
  rm -f "$srcdir"/pgo-data/*.profraw
  make clean

  ###########################################################################
  # Stage 2: CS-PGO
  ###########################################################################
  echo "=== Stage 2: CS-PGO instrumentation ==="
  rm -rf "$srcdir/cspgo-data"; mkdir -p "$srcdir/cspgo-data"
  export LLVM_PROFILE_FILE="$srcdir/cspgo-data/irqbalance-%p-%m.profraw"

  export CFLAGS="$BASE_CFLAGS -fprofile-use=$srcdir/pgo-data/default.profdata -fcs-profile-generate=$srcdir/cspgo-data -fno-omit-frame-pointer"
  export LDFLAGS="$BASE_LDFLAGS -fprofile-use=$srcdir/pgo-data/default.profdata -fcs-profile-generate=$srcdir/cspgo-data"

  configure_irqbalance
  make -j"$JOBS"
  "$srcdir/training-workload.sh" || true

  local CS_PROFDATA=""
  if find "$srcdir/cspgo-data" -name '*.profraw' -size +1k | grep -q .; then
    llvm-profdata merge -output="$srcdir/cspgo-data/cs.profdata" \
      "$srcdir"/cspgo-data/*.profraw "$srcdir/pgo-data/default.profdata"
    CS_PROFDATA="$srcdir/cspgo-data/cs.profdata"
  else
    echo "WARNING: no CS-PGO profiles; falling back to stage-1 profile"
    CS_PROFDATA="$srcdir/pgo-data/default.profdata"
  fi
  rm -f "$srcdir"/cspgo-data/*.profraw
  make clean

  ###########################################################################
  # Stage 3: final optimized build
  ###########################################################################
  echo "=== Stage 3: final build ==="
  unset LLVM_PROFILE_FILE
  export CFLAGS="$BASE_CFLAGS -fprofile-use=$CS_PROFDATA -Wno-profile-instr-out-of-date -Wno-profile-instr-unprofiled"
  export LDFLAGS="$BASE_LDFLAGS -fprofile-use=$CS_PROFDATA -Wl,--emit-relocs"

  configure_irqbalance
  make -j"$JOBS"

  cp irqbalance irqbalance.cspgo

  ###########################################################################
  # Stage 4: BOLT (best-effort; CS-PGO binary is the fallback at every step)
  ###########################################################################
  echo "=== Stage 4: BOLT ==="
  rm -rf "$srcdir/bolt-data"; mkdir -p "$srcdir/bolt-data"

  bolt_bail() {
    echo "WARNING: $1 -- keeping CS-PGO binary"
    cp irqbalance.cspgo irqbalance
    return 0
  }

  llvm-bolt irqbalance.cspgo --instrument \
      --instrumentation-file-append-pid \
      --instrumentation-file="$srcdir/bolt-data/irqbalance.fdata" \
      -o irqbalance.bolt.inst || { bolt_bail "BOLT instrumentation failed"; return 0; }

  cp irqbalance.bolt.inst irqbalance
  "$srcdir/training-workload.sh" || true

  find "$srcdir/bolt-data" -name 'irqbalance.fdata*' -size +1k | grep -q . \
    || { bolt_bail "no BOLT profiles"; return 0; }
  command -v merge-fdata >/dev/null 2>&1 \
    || { bolt_bail "merge-fdata missing"; return 0; }
  merge-fdata "$srcdir"/bolt-data/irqbalance.fdata* > "$srcdir/bolt-data/merged.fdata" 2>/dev/null \
    || { bolt_bail "profile merge failed"; return 0; }
  [[ $(stat -c%s "$srcdir/bolt-data/merged.fdata" 2>/dev/null || echo 0) -ge 1000 ]] \
    || { bolt_bail "BOLT profile too small"; return 0; }

  # --hugify removed: it requests THP for the text segment. irqbalance's text
  # is ~200KB and it wakes once per interval; a 2MB huge page is pure waste
  # and can add TLB pressure on a gaming desktop. Everything else retained.
  llvm-bolt irqbalance.cspgo \
      --data "$srcdir/bolt-data/merged.fdata" \
      --dyno-stats \
      --lite=false \
      --icf=all \
      --plt=all \
      --peepholes=all \
      --x86-strip-redundant-address-size \
      --indirect-call-promotion=all \
      --reorder-blocks=ext-tsp \
      --reorder-functions=cdsort \
      --split-all-cold \
      --split-eh \
      --split-functions \
      --split-strategy=cdsplit \
      --align-functions=32 \
      --align-blocks \
      --block-alignment=16 \
      -o irqbalance.bolt || { bolt_bail "BOLT optimization failed"; return 0; }

  [[ $(stat -c%s irqbalance.bolt) -ge 10000 ]] \
    || { bolt_bail "BOLT binary suspiciously small"; return 0; }

  echo "BOLT: $(stat -c%s irqbalance.cspgo) -> $(stat -c%s irqbalance.bolt) bytes"
  cp irqbalance.bolt irqbalance
}

check() {
  cd "$srcdir/irqbalance"

  # P4: validate the artifact that will actually ship, and prove it is not
  # the instrumentation build (which would cripple runtime performance and
  # write profile files into /run on every start).
  ./irqbalance --version >/dev/null
  timeout 30 ./irqbalance --oneshot >/dev/null 2>&1 || true

  if llvm-nm irqbalance 2>/dev/null | grep -q '__bolt_instr\|__llvm_profile_write_file'; then
    echo "!!! shipping binary still contains instrumentation symbols"
    return 1
  fi

  # The ban mechanism is what keeps irqbalance off the pinned cores. If this
  # ever regresses, the pinning script silently loses its guarantee.
  local out
  out=$(IRQBALANCE_BANNED_CPULIST="0,1" timeout 30 ./irqbalance --oneshot --debug 2>&1 \
        | grep -m1 '^Banned CPUs')
  echo "check: $out"
  [[ -n "$out" ]] || { echo "!!! IRQBALANCE_BANNED_CPULIST not honoured"; return 1; }
}

package() {
  cd "$srcdir/irqbalance"

  make DESTDIR="$pkgdir" install

  install -Dm644 "misc/irqbalance.env" "$pkgdir/etc/irqbalance.env"

  # P5/P6/P7: generate the unit rather than shipping upstream's, which points
  # EnvironmentFile at /usr/etc/... and at a literal '${prefix}' that systemd
  # refuses ("path is not absolute"), so /etc/irqbalance.env was never read.
  install -dm755 "$pkgdir/usr/lib/systemd/system"
  cat > "$pkgdir/usr/lib/systemd/system/irqbalance.service" <<'UNIT'
[Unit]
Description=irqbalance daemon
Documentation=man:irqbalance(1)
Documentation=https://github.com/Irqbalance/irqbalance
ConditionVirtualization=!container
ConditionCPUs=>1

[Service]
Type=simple
EnvironmentFile=-/etc/irqbalance.env
ExecStart=/usr/bin/irqbalance --foreground $IRQBALANCE_ARGS
Restart=on-failure
RestartSec=5

# The UI socket lives in /run/irqbalance.
RuntimeDirectory=irqbalance
RuntimeDirectoryMode=0755

CapabilityBoundingSet=CAP_SETPCAP
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/proc/irq
RestrictAddressFamilies=AF_UNIX AF_NETLINK
LimitNOFILE=4096
IPAddressDeny=any
PrivateTmp=yes
PrivateNetwork=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
PrivateMounts=yes
SystemCallFilter=@system-service
SystemCallFilter=~@clock @module @mount @obsolete @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
UNIT
  chmod 0644 "$pkgdir/usr/lib/systemd/system/irqbalance.service"

  if [[ -f "$pkgdir/usr/bin/irqbalance" ]] && file "$pkgdir/usr/bin/irqbalance" | grep -q ELF; then
    llvm-strip --strip-unneeded "$pkgdir/usr/bin/irqbalance" 2>/dev/null || true
  fi

  install -dm755 "$pkgdir/usr/share/doc/irqbalance"
  {
    echo "Build optimizations: PGO + CS-PGO + BOLT + ThinLTO"
    [[ -f "$srcdir/pgo-data/default.profdata" ]] && echo "PGO:    $(stat -c%s "$srcdir/pgo-data/default.profdata") bytes"
    [[ -f "$srcdir/cspgo-data/cs.profdata" ]]    && echo "CS-PGO: $(stat -c%s "$srcdir/cspgo-data/cs.profdata") bytes"
    [[ -f "$srcdir/bolt-data/merged.fdata" ]]    && echo "BOLT:   $(stat -c%s "$srcdir/bolt-data/merged.fdata") bytes"
    echo
    echo "Measured cost of this daemon on a 28-thread Raptor Lake box:"
    echo "  steady-state CPU at -t 1 : below timer resolution (0.000s / 20s)"
    echo "  own code share of a scan : ~1.6% of instructions (rest is ld.so/libc)"
    echo "See AUDIT.md in the package sources for the full analysis."
  } > "$pkgdir/usr/share/doc/irqbalance/OPTIMIZATIONS.txt"
}
