+
+/*
+ * Adaptive scan interval.
+ *
+ * Track the largest per-IRQ delta observed this cycle and shorten the scan
+ * interval when the system is interrupt-busy, lengthen it when idle. This is
+ * a single pass with no allocation and no cache: caching the deltas made the
+ * daemon act on stale data on alternating cycles.
+ *
+ * The result is always clamped to [min_sleep_interval, SLEEP_ADAPT_MAX] so an
+ * explicit -t / socket setting is respected as a floor.
+ */
+#define SLEEP_ADAPT_MAX 60
+
+static void collect_max_diff(struct irq_info *info, void *data)
+{
+	uint64_t *max_diff = (uint64_t *)data;
+	uint64_t diff;
+
+	/* Counters are monotonic, but a rebuild can reset them; clamp. */
+	if (info->irq_count < info->last_irq_count)
+		return;
+
+	diff = info->irq_count - info->last_irq_count;
+	if (diff > *max_diff)
+		*max_diff = diff;
+}
+
+static int adaptive_sleep_interval(uint64_t max_diff)
+{
+	int val;
+
+	if (max_diff > 10000)
+		val = 1;
+	else if (max_diff > 5000)
+		val = 2;
+	else if (max_diff > 1000)
+		val = 5;
+	else
+		val = SLEEP_ADAPT_MAX;
+
+	if (val < min_sleep_interval)
+		val = min_sleep_interval;
+	if (val > SLEEP_ADAPT_MAX)
+		val = SLEEP_ADAPT_MAX;
+	return val;
+}
+
 gboolean scan(gpointer data __attribute__((unused)))
 {
 	log(TO_CONSOLE, LOG_INFO, "\n\n\n-----------------------------------------------------------------------------\n");
@@ -312,6 +364,13 @@ gboolean scan(gpointer data __attribute__((unused)))
 	calculate_placement();
 	activate_mappings();
 
+	if (adaptive_interval_enabled) {
+		uint64_t max_diff = 0;
+
+		for_each_irq(NULL, collect_max_diff, &max_diff);
+		sleep_interval = adaptive_sleep_interval(max_diff);
+	}
+
