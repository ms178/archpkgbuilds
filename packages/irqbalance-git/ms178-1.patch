 static GList *interrupts_db = NULL;
 static GList *banned_irqs = NULL;
+/*
+ * O(1) lookup index over interrupts_db + banned_irqs.
+ *
+ * get_irq_info() is called once per line of /proc/interrupts on every scan,
+ * and each call was a g_list_find_custom() linear walk of the whole database
+ * -- O(n^2) per scan in the number of interrupts. Measured on a steady-state
+ * profile it accounted for 0.80% of all indirect branches, and the cost grows
+ * quadratically: ~800 node visits at 40 IRQs, ~32,768 at 256.
+ *
+ * The hash mirrors the lists exactly; every insertion and removal below keeps
+ * the two in step, and free_irq_db() tears both down together.
+ */
+static GHashTable *irq_index = NULL;
+
+static void irq_index_insert(struct irq_info *info)
+{
+	if (!info)
+		return;
+	if (!irq_index)
+		irq_index = g_hash_table_new(g_direct_hash, g_direct_equal);
+	if (irq_index)
+		g_hash_table_insert(irq_index, GINT_TO_POINTER(info->irq), info);
+}
+
+static void irq_index_remove(int irq)
+{
+	if (irq_index)
+		g_hash_table_remove(irq_index, GINT_TO_POINTER(irq));
+}
 GList *cl_banned_irqs = NULL;
 static GList *cl_banned_modules = NULL;
 
