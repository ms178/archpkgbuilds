+/*
+ * Adaptive scan interval.
+ *
+ * Shorten the interval when interrupts are churning, lengthen it when the
+ * machine is quiet. Single allocation-free pass; deliberately NOT cached --
+ * the whole purpose is to react to CHANGING load, and a cache of the previous
+ * cycle's deltas makes the daemon act on stale data.
+ *
+ * Always clamped to [min_sleep_interval, SLEEP_ADAPT_MAX] so an explicit -t
+ * or a "settings sleep" from the UI socket is respected as a floor.
+ */
+#define SLEEP_ADAPT_MAX 60
+
+static void collect_max_diff(struct irq_info *info, void *data)
+{
+	uint64_t *max_diff = (uint64_t *)data;
+	uint64_t diff;
+
+	/* Counters are monotonic, but a rebuild resets them; ignore wraps. */
+	if (info->irq_count < info->last_irq_count)
+		return;
+
+	diff = info->irq_count - info->last_irq_count;
+	if (diff > *max_diff)
+		*max_diff = diff;
+}
+
+static int adaptive_sleep_interval(uint64_t max_diff)
+{
+	int val;
+
+	if (max_diff > 10000)
+		val = 1;
+	else if (max_diff > 5000)
+		val = 2;
+	else if (max_diff > 1000)
+		val = 5;
+	else
+		val = SLEEP_ADAPT_MAX;
+
+	if (val < min_sleep_interval)
+		val = min_sleep_interval;
+	if (val > SLEEP_ADAPT_MAX)
+		val = SLEEP_ADAPT_MAX;
+	return val;
