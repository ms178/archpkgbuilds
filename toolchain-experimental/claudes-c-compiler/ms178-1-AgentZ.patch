+                IrType::U16,
+                false,
+            ),
+            (
+                "I8 outside the fusion width domain",
+                vec![
+                    typed_not(3, v(0), IrType::I8),
+                    typed_and(4, v(3), v(1), IrType::I8),
+                ],
+                3,
+                4,
+                1,
+                IrType::I8,
+                false,
+            ),
+            (
+                "And does not read the Not's dest",
+                vec![
+                    typed_not(3, v(0), IrType::U32),
+                    typed_and(4, v(1), v(2), IrType::U32),
+                ],
+                3,
+                4,
+                1,
+                IrType::U32,
+                false,
+            ),
+            (
+                "And reads the Not twice (use_count 2)",
+                vec![
+                    typed_not(3, v(0), IrType::U32),
+                    typed_and(4, v(3), v(3), IrType::U32),
+                ],
+                3,
+                4,
+                1,
+                IrType::U32,
+                false,
+            ),
+            (
+                "operand is not a Not",
+                vec![and3(3, v(0), v(2)), typed_and(4, v(3), v(1), IrType::U32)],
+                3,
+                4,
+                1,
+                IrType::U32,
+                false,
+            ),
+            (
+                "Not defined in another block",
+                // The block handed to the backend detector contains only the
+                // And: the Not lives in a foreign block, so no in-block
+                // windows(2) pair can contain both.
+                vec![typed_and(4, v(3), v(1), IrType::U32)],
+                3,
+                4,
+                0,
+                IrType::U32,
+                false,
+            ),
+        ];
+
+        for (label, insts, not_v, and_v, and_idx, c_ty, expected) in scenarios {
+            let mut fx = fixture(insts.clone());
+            if label == "Not defined in another block" {
+                // Give the Not a def + a FOREIGN block location (block 1).
+                fx.defs[not_v as usize] = Some(typed_not(not_v, v(0), IrType::U32));
+                fx.def_loc[not_v as usize] = Some((1, 0));
+                fx.use_counts[not_v as usize] = 1;
+            }
+            // The REAL middle-end predicate (the extracted closure body).
+            let predicted = andn_fusion_predicted_at(
+                &fx.defs,
+                &fx.use_counts,
+                &fx.def_loc,
+                c_ty,
+                Operand::Value(Value(not_v)),
+                Operand::Value(Value(and_v)),
+            );
+            // The REAL backend detector over the same instructions.
+            let block = BasicBlock {
+                label: BlockId(0),
+                instructions: insts,
+                terminator: Terminator::Return(None),
+                source_spans: Vec::new(),
+            };
+            let fused = detect_and_not_fusions(&block, &fx.use_counts);
+            let backend = fused.contains(&and_idx);
+            assert_eq!(
+                predicted, expected,
+                "{label}: middle-end prediction wrong (got {predicted})"
+            );
+            assert_eq!(
+                backend, expected,
+                "{label}: backend detector wrong (got {backend})"
+            );
+            assert_eq!(
+                predicted, backend,
+                "{label}: CONTRACT VIOLATION — the fold prediction and the \
+                 backend detector disagree"
+            );
+        }
+    }
+
+    // ── audit P0-3: multi-block majority coverage ────────────────────────────
+    //
+    // The rank comparison in Pattern C prefers an entry-available KEPT term
+    // (rank (0,0), defined in another block) over a same-block one, and the
+    // repurposed-must-be-in-block rule means a foreign And can only ever be
+    // KEPT (read-only — sound anywhere).  These tests pin both sides of
+    // that law: one foreign And is soundly keepable; TWO foreign Ands leave
+    // no role assignment whose repurposed pair is fully in-block, so the
+    // fold must decline.
+
+    #[test]
+    fn majority_keeps_entry_available_and_defined_in_another_block() {
+        // maj(x,y,z): And(x,y) is FOREIGN (defined in block 1); the two
+        // repurposed arms And(x,z)/And(y,z) are in the consumer's block.
+        // The fold must FIRE and the new consumer must read the foreign
+        // kept term directly — kept producers are read-only, so living in
+        // another block is sound (the SSA argument in the pattern docs).
+        let mut fx = fixture(vec![
+            and3(4, v(0), v(1)), // And(x, y) — will be made foreign
+            and3(5, v(0), v(2)), // And(x, z) — repurposed (in block)
+            and3(6, v(1), v(2)), // And(y, z) — repurposed (in block)
+            xor3(7, v(5), v(6)), // inner
+            xor3(8, v(7), v(4)), // consumer at idx 4
+        ]);
+        fx.def_loc[4] = Some((1, 0)); // the kept And lives in block 1
+        let (new_consumer, pending) = match_bool_mux_algebra(
+            v(7),
+            v(4),
+            IrBinOp::Xor,
+            Value(8),
+            IrType::U32,
+            0,
+            4,
+            &fx.defs,
+            &fx.use_counts,
+            &fx.def_loc,
+            false,
+        )
+        .expect("one foreign KEPT arm is sound — the fold must fire");
+        // Exactly the two in-block repurposed producers are rewritten.
+        assert_eq!(pending.len(), 2, "only the two in-block arms repurpose");
+        let Instruction::BinOp { lhs, .. } = &new_consumer else {
+            panic!("consumer stays a BinOp");
+        };
+        assert_eq!(
+            *lhs,
+            v(4),
+            "the foreign entry-available And is the KEPT term, read directly"
+        );
+    }
+
+    #[test]
+    fn majority_declines_when_two_arms_live_in_another_block() {
+        // Two of the three pairwise Ands are foreign.  Every role
+        // assignment must repurpose the two non-kept arms, and each kept
+        // choice leaves at least one foreign arm in the repurposed pair
+        // (kept=4 repurposes 5,6 — both foreign; kept=5 repurposes 4,6 —
+        // 6 is foreign; kept=6 repurposes 4,5 — 5 is foreign), so the
+        // fold must decline: rewriting a foreign producer in place is
+        // exactly what the v1 soundness rule forbids.
+        let mut fx = fixture(vec![
+            and3(4, v(0), v(1)), // And(x, y) — in block
+            and3(5, v(0), v(2)), // And(x, z) — will be made foreign
+            and3(6, v(1), v(2)), // And(y, z) — will be made foreign
+            xor3(7, v(5), v(6)), // inner
+            xor3(8, v(7), v(4)), // consumer at idx 4
+        ]);
+        fx.def_loc[5] = Some((1, 1));
+        fx.def_loc[6] = Some((1, 2));
+        assert!(
+            match_bool_mux_algebra(
+                v(7),
+                v(4),
+                IrBinOp::Xor,
+                Value(8),
+                IrType::U32,
+                0,
+                4,
+                &fx.defs,
+                &fx.use_counts,
+                &fx.def_loc,
+                false,
+            )
+            .is_none(),
+            "two foreign arms leave no in-block repurposable pair — decline"
+        );
+    }
+
+    #[test]
+    fn majority_inblock_earliest_still_wins_when_all_arms_local() {
+        // All three arms in the consumer's block: three valid role
+        // assignments compete and the KEPT term with the EARLIEST def
+        // index must win (the composite computes last — the tightest
+        // live-range schedule).  And(x,y) at idx 0 is the earliest.
+        let fx = fixture(vec![
+            and3(4, v(0), v(1)), // idx 0 — earliest, must be KEPT
+            and3(5, v(0), v(2)), // idx 1
+            and3(6, v(1), v(2)), // idx 2
+            xor3(7, v(5), v(6)), // idx 3
+            xor3(8, v(7), v(4)), // idx 4
+        ]);
+        let (new_consumer, _) = match_bool_mux_algebra(
+            v(7),
+            v(4),
+            IrBinOp::Xor,
+            Value(8),
+            IrType::U32,
+            0,
+            4,
+            &fx.defs,
+            &fx.use_counts,
+            &fx.def_loc,
+            false,
+        )
+        .expect("the all-local majority folds");
+        let Instruction::BinOp { lhs, .. } = &new_consumer else {
+            panic!("consumer stays a BinOp");
+        };
+        assert_eq!(*lhs, v(4), "the earliest-defined arm is the KEPT term");
+    }
 }
