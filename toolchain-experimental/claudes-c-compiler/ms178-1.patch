+                                  // expected-warning {{a function definition without a prototype is deprecated in all versions of C and is not supported in C23}}
+void knrNoSemi(i) int i { } // expected-error {{expected ';' at end of declaration}} \
+                            // expected-warning {{a function definition without a prototype is deprecated in all versions of C and is not supported in C23}}
