+        let nonconst = select(
+            cmp(IrCmpOp::Slt, load(), konst(10)),
+            MapExpr::BinOp(
+                IrBinOp::Add,
+                Box::new(load()),
+                Box::new(MapExpr::Load(1)),
+            ),
+            load(),
