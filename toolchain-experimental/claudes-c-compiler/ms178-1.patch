+    sources = {
+        "mf.c": '#include <stdio.h>\nint foo(void);\nextern int fooval;\n'
+                'int main(void) { printf("%d %d\\n", foo(), fooval); return 0; }\n',
+        "m0.c": '#include <stdio.h>\nint main(void) { puts("0"); return 0; }\n',
