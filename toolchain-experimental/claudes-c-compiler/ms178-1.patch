+                | "vpshab"
+                | "vpshaw"
+                | "vpshad"
+                | "vpshaq"
+                | "vpshlb"
+                | "vpshlw"
+                | "vpshld"
+                | "vpshlq"
+                // XOP FMA4-integer (map 8, 4-op with imm8-nibble).
+                | "vpmacssww"
+                | "vpmacsww"
+                | "vpmacsswd"
+                | "vpmacswd"
+                | "vpmacssdd"
+                | "vpmacsdd"
+                | "vpmacssdql"
+                | "vpmacsdql"
+                | "vpmacssdqh"
+                | "vpmacsdqh"
