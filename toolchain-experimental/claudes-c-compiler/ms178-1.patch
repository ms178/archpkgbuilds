+def load_allowed(path: Path) -> dict[str, str]:
+    """`name -> reason` for every compatibility entry (comments stripped)."""
+    allowed: dict[str, str] = {}
+    if not path.is_file():
+        return allowed
+    for raw in path.read_text(encoding="utf-8").splitlines():
+        line = raw.split("#", 1)[0].strip()
