+++ b/tests/regression/builtin_trap_unreachable.c
@@ -0,0 +1,6 @@
+/* trap/unreachable must not depend on libc abort(); compile+run smoke. */
+int main(void) {
+    if (0) { __builtin_trap(); }
+    if (0) { __builtin_unreachable(); }
+    return 0;
+}
