diff --git a/tests/regression/seg_gs_runtime/gen_seg_copy_sweep.py b/tests/regression/seg_gs_runtime/gen_seg_copy_sweep.py
new file mode 100644
index 00000000..f08f91e1
--- /dev/null
+++ b/tests/regression/seg_gs_runtime/gen_seg_copy_sweep.py
@@ -0,0 +1,162 @@
+#!/usr/bin/env python3
+"""Emit a self-checking C program that sweeps __seg_gs aggregate copies.
+
+Every size in SIZES gets its own struct type and its own __seg_gs object, so
+the straight-line copy (<= SEG_COPY_UNROLL_MAX), the counted loop above it, and
+the tail after the loop are all exercised at every boundary that matters:
+
+  * sizes 1..=600 (every straight-line length, each tail width 1..7),
+  * 511, 512, 513 (the unroll limit), 1000, 1023, 1024, 1025 (loop tails),
+    2048, 4095, 4096, 4097, 5000 (multi-page loops).
+
+Each object sits in a guarded __seg_gs wrapper: the bytes after the copied
+object are a guard pattern that a copy of the wrong length would overwrite.
+
+Per size and per round (three rounds, each with a new byte pattern):
+
+  1. generic -> segment copy, then the mirror (&object + GS_DISP) is compared
+     with the source bytes;
+  2. segment -> generic copy, compared with the source;
+  3. segment -> segment copy into a second object, compared through its mirror;
+  4. the guard bytes after each object are unchanged.
+
+The program prints one `ok`/`FAIL` line per size and a final PASSED line. The
+gate runs it under lccc and under GCC -O0 and requires identical output, GCC
+being the oracle for accepted behaviour.
+
+usage: gen_seg_copy_sweep.py OUT.c [--full]
+
+Without --full the program covers FAST_SIZES (192 sizes, bounded compile time
+for the fast gate). --full covers FULL_SIZES (609 sizes: every length 1..=600
+plus the loop edges).
+"""
+import sys
+
+# The loop copies 32-byte blocks, so 513..=544 holds every residue modulo 32
+# (the loop-count and tail combinations of the first trip) above the limit.
+LOOP_EDGES = ([511, 512] + list(range(513, 545)) +
+              [1000, 1023, 1024, 1025, 2047, 2048, 2049, 4095, 4096, 4097, 5000])
+# Fast set (default, used by the gate): every length 1..=64, residues 1, 8 and
+# 15 modulo 16 up to 512 (the straight-line limit), and the loop edges above.
+FAST_SIZES = sorted(set(range(1, 65))
+                    | {n for n in range(65, 513) if n % 16 in (1, 8, 15)}
+                    | set(LOOP_EDGES))
+# Full set (--full): every length 1..=600 and the same loop edges.
+FULL_SIZES = sorted(set(range(1, 601)) | set(LOOP_EDGES))
+SIZES = FAST_SIZES
+ROUNDS = 3
+GUARD = 16
+
+
+def emit(sizes) -> str:
+    global SIZES
+    SIZES = sizes
+    out = []
+    w = out.append
+    w("/* Generated by gen_seg_copy_sweep.py. Do not edit. */")
+    w("#include <errno.h>")
+    w("#include <stdint.h>")
+    w("#include <stdio.h>")
+    w("#include <stdlib.h>")
+    w("#include <string.h>")
+    w("#include <sys/mman.h>")
+    w("#include <sys/syscall.h>")
+    w("#include <unistd.h>")
+    w("")
+    w("#define ARCH_SET_GS 0x1001")
+    w("#define GS_DISP ((uintptr_t)1 << 32)")
+    w("#define MIR(g) ((unsigned char *)(g) + GS_DISP)")
+    w("")
+    for n in SIZES:
+        w(f"struct s{n} {{ unsigned char b[{n}]; }};")
+        w(f"struct w{n} {{ struct s{n} o; unsigned char g[{GUARD}]; }};")
+        w(f"struct w{n} __seg_gs seg{n};")
+        w(f"struct w{n} __seg_gs seg2_{n};")
+    w("")
+    w("static void fill(unsigned char *p, size_t n, unsigned seed) {")
+    w("    for (size_t i = 0; i < n; i++)")
+    w("        p[i] = (unsigned char)(i * 131u + seed * 7u + 3u);")
+    w("}")
+    w("")
+    w("static int bad_bytes(const unsigned char *a, const unsigned char *b, size_t n) {")
+    w("    for (size_t i = 0; i < n; i++)")
+    w("        if (a[i] != b[i]) return 1;")
+    w("    return 0;")
+    w("}")
+    w("")
+    w("static int guard_ok(const unsigned char *g) {")
+    w(f"    for (int i = 0; i < {GUARD}; i++)")
+    w("        if (g[i] != 0xA5) return 0;")
+    w("    return 1;")
+    w("}")
+    w("")
+    w("/* Maps the mirror (object + GS_DISP) of one segment object. Runs before any")
+    w("   write, so MAP_FIXED over a page shared with a neighbour loses no data. */")
+    w("static void map_obj(const void *g, size_t n) {")
+    w("    uintptr_t lo = (uintptr_t)g + GS_DISP;")
+    w("    uintptr_t page = lo & ~(uintptr_t)4095;")
+    w("    size_t len = ((lo + n - page) + 4095) & ~(size_t)4095;")
+    w("    void *m = mmap((void *)page, len, PROT_READ | PROT_WRITE,")
+    w("                   MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0);")
+    w("    if (m == MAP_FAILED) { perror(\"mmap mirror\"); exit(2); }")
+    w("}")
+    w("")
+    w("static void reset_guards(void) {")
+    for n in SIZES:
+        w(f"    memset(MIR(&seg{n}.g), 0xA5, {GUARD});")
+        w(f"    memset(MIR(&seg2_{n}.g), 0xA5, {GUARD});")
+    w("}")
+    w("")
+    # One checking function per size. The copies are written out in full so
+    # each one is a distinct, inlined-or-not aggregate copy in the code.
+    for n in SIZES:
+        w(f"static int check{n}(void) {{")
+        w(f"    struct s{n} src, back;")
+        w("    int bad = 0;")
+        w(f"    for (unsigned r = 0; r < {ROUNDS}; r++) {{")
+        w(f"        fill(src.b, {n}, r * 17u + {n}u);")
+        w(f"        seg{n}.o = src;")
+        w(f"        if (bad_bytes(MIR(&seg{n}.o), src.b, {n})) bad |= 1;")
+        w(f"        back = seg{n}.o;")
+        w(f"        if (bad_bytes(back.b, src.b, {n})) bad |= 2;")
+        w(f"        seg2_{n}.o = seg{n}.o;")
+        w(f"        if (bad_bytes(MIR(&seg2_{n}.o), src.b, {n})) bad |= 4;")
+        w(f"        if (!guard_ok(MIR(&seg{n}.g)) || !guard_ok(MIR(&seg2_{n}.g))) bad |= 8;")
+        w("    }")
+        w("    return bad;")
+        w("}")
+        w("")
+    w("int main(void) {")
+    w("    /* Map every object's mirror, then fill the guards. */")
+    for n in SIZES:
+        w(f"    map_obj((const char *)&seg{n}, sizeof seg{n});")
+        w(f"    map_obj((const char *)&seg2_{n}, sizeof seg2_{n});")
+    w("    if (syscall(SYS_arch_prctl, ARCH_SET_GS, (unsigned long)GS_DISP) != 0) {")
+    w("        perror(\"arch_prctl\");")
+    w("        return 2;")
+    w("    }")
+    w("    reset_guards();")
+    w("    int failures = 0;")
+    for n in SIZES:
+        w(f"    if (check{n}() == 0) printf(\"ok %d\\n\", {n}); else {{ printf(\"FAIL %d\\n\", {n}); failures++; }}")
+    w(f"    if (failures == 0) printf(\"seg_copy_sweep PASSED ({len(SIZES)} sizes)\\n\");")
+    w("    else printf(\"seg_copy_sweep FAILED (%d sizes)\\n\", failures);")
+    w("    return failures == 0 ? 0 : 1;")
+    w("}")
+    return "\n".join(out) + "\n"
+
+
+def main() -> int:
+    args = sys.argv[1:]
+    full = "--full" in args
+    args = [a for a in args if a != "--full"]
+    if len(args) != 1:
+        print(__doc__, file=sys.stderr)
+        return 2
+    with open(args[0], "w", encoding="utf-8") as f:
+        f.write(emit(FULL_SIZES if full else FAST_SIZES))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tests/regression/seg_gs_runtime/seg_gs_audit.c b/tests/regression/seg_gs_runtime/seg_gs_audit.c
new file mode 100644
index 00000000..257640f0
--- /dev/null
+++ b/tests/regression/seg_gs_runtime/seg_gs_audit.c
@@ -0,0 +1,253 @@
+/* Runtime, self-checking contract for x86-64 __seg_gs objects reached through
+ * forms the offset-pointer test (seg_gs_runtime.c) does not cover.
+ *
+ * Object-level access needs real storage behind %gs:<object>. The GS base is
+ * set to GS_DISP, and the bytes at (&object + GS_DISP) are mapped as a mirror.
+ * A correct %gs access reads and writes the mirror; a generic access reads the
+ * object's own (different) bytes, so a missed segment fails the check instead
+ * of silently passing. Expected values are computed through the mirror with
+ * ordinary pointers, and the program does not depend on any other compiler.
+ *
+ * Covered (each one was a silent miscompile before the audit fixes):
+ *   block-scope extern object, reversed subscript i[p], conditional/comma/
+ *   assignment aggregates over a segment, &object typed __seg_gs, pointer to
+ *   array with a segment element, vector compound assignment, complex parts,
+ *   volatile aggregate read, braced pointer initializer.
+ */
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/mman.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#define ARCH_SET_GS 0x1001
+#define GS_DISP ((uintptr_t)1 << 32)
+#define MIR(g) ((void *)((char *)(g) + GS_DISP))
+
+struct c { long v[4]; };
+typedef long v2_t __attribute__((vector_size(16)));
+
+/* Segment objects (file scope). Each generic alias below uses an asm label to
+ * name the same symbol, so the test can reach the mirror of the object. */
+long __seg_gs ga_obj;
+struct c __seg_gs ca_obj;
+struct c __seg_gs cb_obj;
+long __seg_gs arr_obj[4];
+v2_t __seg_gs vg_obj;
+_Complex double __seg_gs cg_obj;
+volatile struct c __seg_gs vs_obj;
+/* The qualifier after '*' places the pointer object itself in %gs. */
+long *__seg_gs gq_obj;
+
+extern long ga_g[] __asm__("ga_obj");
+extern struct c ca_g[] __asm__("ca_obj");
+extern struct c cb_g[] __asm__("cb_obj");
+extern long arr_g[] __asm__("arr_obj");
+extern v2_t vg_g[] __asm__("vg_obj");
+extern _Complex double cg_g[] __asm__("cg_obj");
+extern struct c vs_g[] __asm__("vs_obj");
+extern long *gq_g[] __asm__("gq_obj");
+
+static long garr[2] = { 55, 66 };
+
+/* Generic (ordinary) aggregate used as the other arm of a conditional. */
+static struct c gen_c = { { 70, 71, 72, 73 } };
+
+/* Pointers into the segment, stored in generic memory. */
+static long __seg_gs *gp;
+static long __seg_gs (*pa)[4];
+static struct c __seg_gs *pglob = &ca_obj;       /* &object typed __seg_gs */
+static struct c __seg_gs *parr[1] = { &cb_obj }; /* braced initializer */
+static struct c __seg_gs *pbrace = { &ca_obj };
+
+static int failures;
+
+#define CHECK(cond, name)                                  \
+    do {                                                   \
+        if (cond) printf("ok   %s\n", name);               \
+        else { printf("FAIL %s\n", name); failures++; }    \
+    } while (0)
+
+/* Objects that share a page share one mirror page: the only mapping that can
+ * already exist at GS_DISP + object is an earlier mirror, so EEXIST is fine. */
+static void map_mirror(void *g, size_t n) {
+    uintptr_t lo = (uintptr_t)g + GS_DISP;
+    uintptr_t page = lo & ~(uintptr_t)4095;
+    size_t len = ((lo + n - page) + 4095) & ~(size_t)4095;
+    void *m = mmap((void *)page, len, PROT_READ | PROT_WRITE,
+                   MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+    if (m != (void *)page && errno != EEXIST) {
+        perror("mmap");
+        _Exit(2);
+    }
+}
+
+/* ---- block-scope extern names the file-scope segment object ---- */
+__attribute__((noinline)) static long blk_read(void) {
+    extern long __seg_gs ga_obj;
+    return ga_obj;
+}
+__attribute__((noinline)) static void blk_write(long v) {
+    extern long __seg_gs ga_obj;
+    ga_obj = v;
+}
+
+/* ---- reversed subscript: i[p] is *(i + p) ---- */
+__attribute__((noinline)) static long rev_ptr(long i) { return i[gp]; }
+__attribute__((noinline)) static long rev_arr(void) { return 2[arr_obj]; }
+
+/* ---- aggregate conditional / comma / assignment over a segment ---- */
+__attribute__((noinline)) static struct c sel_seg_seg(int k) { return k ? ca_obj : cb_obj; }
+__attribute__((noinline)) static struct c sel_mixed(int k) { return k ? ca_obj : gen_c; }
+__attribute__((noinline)) static long sel_member(int k) { return (k ? ca_obj : cb_obj).v[1]; }
+__attribute__((noinline)) static struct c comma_ret(void) { return ((void)0, ca_obj); }
+__attribute__((noinline)) static struct c assign_ret(void) {
+    struct c x;
+    x = (cb_obj = ca_obj);
+    return x;
+}
+
+/* ---- &segment-object keeps its space; the pointer is usable ---- */
+__attribute__((noinline)) static long glob_ptr_read(void) { return pglob->v[2]; }
+
+/* ---- pointer to array of segment elements ---- */
+__attribute__((noinline)) static long pa_read(int i) { return (*pa)[i]; }
+__attribute__((noinline)) static void pa_write(int i, long v) { (*pa)[i] = v; }
+
+/* ---- vector compound assignment and whole-vector assignment ---- */
+__attribute__((noinline)) static void vec_add(v2_t x) { vg_obj += x; }
+__attribute__((noinline)) static void vec_mul(v2_t x) { vg_obj = vg_obj * x; }
+
+/* ---- complex parts of a segment object ---- */
+__attribute__((noinline)) static double cx_re(void) { return __real__ cg_obj; }
+__attribute__((noinline)) static double cx_im(void) { return __imag__ cg_obj; }
+__attribute__((noinline)) static void cx_set(void) { cg_obj = 1.5 + 2.5i; }
+__attribute__((noinline)) static void cx_setim(double d) { __imag__ cg_obj = d; }
+
+/* ---- volatile aggregate read from a segment ---- */
+__attribute__((noinline)) static struct c vol_read(void) {
+    struct c t;
+    t = vs_obj;
+    return t;
+}
+
+/* ---- pointer object in %gs, pointee generic ---- */
+__attribute__((noinline)) static long d1_read(void) { return *gq_obj; }
+__attribute__((noinline)) static void d1_write(long v) { *gq_obj = v; }
+
+/* ---- braced pointer initializers ---- */
+__attribute__((noinline)) static long brace_read(void) { return parr[0]->v[3] + pbrace->v[0]; }
+
+/* Pointer arithmetic on a decayed named-space array stays in %gs, both as
+ * array + n and as n + array, and pointer difference between them is exact. */
+__attribute__((noinline)) static long arr_arith_read(void) {
+    long __seg_gs *p = arr_obj + 2;
+    long __seg_gs *q = 1 + arr_obj;
+    return *p * 1000 + *q + (long)((arr_obj + 3) - arr_obj);
+}
+__attribute__((noinline)) static void arr_arith_write(void) {
+    long __seg_gs *w = 3 + arr_obj;
+    *w = 555;
+}
+
+int main(void) {
+    setvbuf(stdout, NULL, _IONBF, 0);
+    map_mirror(ga_g, sizeof(long));
+    map_mirror(ca_g, sizeof(struct c));
+    map_mirror(cb_g, sizeof(struct c));
+    map_mirror(arr_g, sizeof(long) * 4);
+    map_mirror(vg_g, sizeof(v2_t));
+    map_mirror(cg_g, sizeof(_Complex double));
+    map_mirror(vs_g, sizeof(struct c));
+    map_mirror(gq_g, sizeof(long *));
+    if (syscall(SYS_arch_prctl, ARCH_SET_GS, (void *)GS_DISP) != 0) {
+        perror("arch_prctl");
+        return 2;
+    }
+
+    /* Seed the mirror through ordinary pointers. */
+    *(volatile long *)MIR(ga_g) = 42;
+    volatile struct c *ca_m = MIR(ca_g), *cb_m = MIR(cb_g);
+    *ca_m = (struct c){ { 10, 11, 12, 13 } };
+    *cb_m = (struct c){ { 20, 21, 22, 23 } };
+    volatile long *arr_m = MIR(arr_g);
+    for (int i = 0; i < 4; i++) arr_m[i] = 100 + i;
+    *(volatile v2_t *)MIR(vg_g) = (v2_t){ 3, 4 };
+    *(volatile struct c *)MIR(vs_g) = (struct c){ { 90, 91, 92, 93 } };
+
+    /* Generic-to-segment conversion, deliberately through an integer: a
+     * direct pointer cast draws the disjoint-address-space warning, which is
+     * the intended diagnostic for that cast and is covered by
+     * check_seg_cast_warning.sh, not by this runtime fixture. */
+    gp = (long __seg_gs *)(uintptr_t)arr_g;
+    pa = (long __seg_gs (*)[4])(uintptr_t)arr_g;
+
+    /* Block-scope extern */
+    CHECK(blk_read() == 42, "blk_extern_read");
+    blk_write(77);
+    CHECK(*(volatile long *)MIR(ga_g) == 77, "blk_extern_write");
+
+    /* Reversed subscript */
+    CHECK(rev_ptr(2) == 102 && rev_ptr(0) == 100, "rev_subscript_ptr");
+    CHECK(rev_arr() == 102, "rev_subscript_array");
+
+    /* Conditional, comma and assignment aggregates */
+    struct c r1 = sel_seg_seg(1), r0 = sel_seg_seg(0);
+    CHECK(r1.v[0] == 10 && r0.v[0] == 20, "cond_seg_both_arms");
+    struct c m1 = sel_mixed(1), m0 = sel_mixed(0);
+    CHECK(m1.v[1] == 11 && m0.v[1] == 71, "cond_mixed_arms");
+    CHECK(sel_member(1) == 11 && sel_member(0) == 21, "cond_member_of_result");
+    struct c cm = comma_ret();
+    CHECK(cm.v[3] == 13, "comma_aggregate_seg");
+    struct c as = assign_ret();
+    CHECK(as.v[2] == 12 && cb_m->v[2] == 12, "assign_aggregate_seg");
+
+    /* &segment object */
+    CHECK(glob_ptr_read() == 12, "addrof_seg_object");
+
+    /* Pointer to array of segment elements */
+    CHECK(pa_read(3) == 103 && pa_read(0) == 100, "ptr_to_array_read");
+    pa_write(1, 555);
+    CHECK(arr_m[1] == 555, "ptr_to_array_write");
+
+    /* Vector compound and whole assignment */
+    vec_add((v2_t){ 1, 1 });
+    v2_t vv = *(volatile v2_t *)MIR(vg_g);
+    CHECK(vv[0] == 4 && vv[1] == 5, "vector_compound_add");
+    vec_mul((v2_t){ 2, 3 });
+    vv = *(volatile v2_t *)MIR(vg_g);
+    CHECK(vv[0] == 8 && vv[1] == 15, "vector_whole_mul");
+
+    /* Complex parts */
+    volatile _Complex double *cg_m = MIR(cg_g);
+    CHECK(*cg_m == 0.0, "complex_zero_init");
+    cx_set();
+    CHECK(__real__ *cg_m == 1.5 && __imag__ *cg_m == 2.5, "complex_store");
+    CHECK(cx_re() == 1.5 && cx_im() == 2.5, "complex_load");
+    cx_setim(9.25);
+    CHECK(__imag__ *cg_m == 9.25 && __real__ *cg_m == 1.5, "complex_imag_store");
+
+    /* Volatile aggregate read */
+    struct c vr = vol_read();
+    CHECK(vr.v[0] == 90 && vr.v[3] == 93, "volatile_aggregate_read");
+
+    /* the pointer object lives in the segment; its pointee is generic */
+    *(long **)MIR(gq_g) = garr;
+    CHECK(d1_read() == 55, "ptr_object_seg_read");
+    d1_write(77);
+    CHECK(garr[0] == 77, "ptr_object_seg_deref_write");
+
+    /* Braced pointer initializers */
+    CHECK(brace_read() == 13 + 10, "braced_pointer_init");
+
+    /* Decayed-array pointer arithmetic. arr[2] is 102 and arr[1] was set to 555
+     * by ptr_to_array_write above; the difference is 3. */
+    CHECK(arr_arith_read() == 102000 + 555 + 3, "decay_arith_read");
+    arr_arith_write();
+    CHECK(arr_m[3] == 555, "decay_arith_write");
+
+    printf("%s (%d failure%s)\n", failures ? "FAILED" : "PASSED", failures, failures == 1 ? "" : "s");
+    return failures ? 1 : 0;
+}
diff --git a/tests/regression/seg_gs_runtime/seg_gs_big_copy.c b/tests/regression/seg_gs_runtime/seg_gs_big_copy.c
new file mode 100644
index 00000000..bc076f7d
--- /dev/null
+++ b/tests/regression/seg_gs_runtime/seg_gs_big_copy.c
@@ -0,0 +1,180 @@
+/* Runtime, self-checking contract for aggregate copies to and from __seg_gs
+ * objects of every size class: a straight-line copy (<= SEG_COPY_UNROLL_MAX,
+ * 512 bytes), the counted-loop copy above it, and copies that happen inside a
+ * function whose many live arguments put locals on the %rsp-relative path.
+ *
+ * Each object's bytes are checked through its mirror (&object + GS_DISP), which
+ * a correct %gs copy writes, against a byte pattern. A copy that reads the
+ * wrong offset, or a generic copy in place of a segment copy, fails.
+ *
+ * Covers:
+ *   - generic -> segment, segment -> generic and segment -> segment copies of
+ *     24, 320, 600, 1500 and 4096 bytes;
+ *   - an aggregate returned by value from a segment object;
+ *   - a copy inside a function with eight integer arguments (rsp addressing).
+ */
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#define ARCH_SET_GS 0x1001
+#define GS_DISP ((uintptr_t)1 << 32)
+#define MIR(g) ((void *)((char *)(g) + GS_DISP))
+
+struct b24 { unsigned char b[24]; };
+struct b320 { unsigned char b[320]; };
+struct b600 { unsigned char b[600]; };
+struct b1500 { unsigned char b[1500]; };
+struct b4k { unsigned char b[4096]; };
+
+struct b24 __seg_gs g24;
+struct b320 __seg_gs g320;
+struct b600 __seg_gs g600;
+struct b1500 __seg_gs g1500;
+struct b4k __seg_gs g4k;
+struct b600 __seg_gs g600_b;
+extern struct b24 a24[] __asm__("g24");
+extern struct b320 a320[] __asm__("g320");
+extern struct b600 a600[] __asm__("g600");
+extern struct b1500 a1500[] __asm__("g1500");
+extern struct b4k a4k[] __asm__("g4k");
+extern struct b600 a600b[] __asm__("g600_b");
+
+static int failures;
+
+#define CHECK(cond, name)                                  \
+    do {                                                   \
+        if (cond) printf("ok   %s\n", name);               \
+        else { printf("FAIL %s\n", name); failures++; }    \
+    } while (0)
+
+static void map_mirror(void *g, size_t n) {
+    uintptr_t lo = (uintptr_t)g + GS_DISP;
+    uintptr_t page = lo & ~(uintptr_t)4095;
+    size_t len = ((lo + n - page) + 4095) & ~(size_t)4095;
+    void *m = mmap((void *)page, len, PROT_READ | PROT_WRITE,
+                   MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+    if (m != (void *)page && errno != EEXIST) {
+        perror("mmap");
+        _Exit(2);
+    }
+}
+
+static unsigned char pat(size_t i, unsigned seed) {
+    return (unsigned char)((i * 131u + seed) ^ (i >> 3));
+}
+
+static void fill(unsigned char *p, size_t n, unsigned seed) {
+    for (size_t i = 0; i < n; i++) p[i] = pat(i, seed);
+}
+
+static int matches(const unsigned char *p, size_t n, unsigned seed) {
+    for (size_t i = 0; i < n; i++)
+        if (p[i] != pat(i, seed)) return 0;
+    return 1;
+}
+
+/* Generic -> segment, segment -> generic, segment -> segment. */
+__attribute__((noinline)) static void to_seg24(const struct b24 *s) { g24 = *s; }
+__attribute__((noinline)) static void from_seg24(struct b24 *d) { *d = g24; }
+__attribute__((noinline)) static void to_seg320(const struct b320 *s) { g320 = *s; }
+__attribute__((noinline)) static void from_seg320(struct b320 *d) { *d = g320; }
+__attribute__((noinline)) static void to_seg600(const struct b600 *s) { g600 = *s; }
+__attribute__((noinline)) static void from_seg600(struct b600 *d) { *d = g600; }
+__attribute__((noinline)) static void to_seg1500(const struct b1500 *s) { g1500 = *s; }
+__attribute__((noinline)) static void from_seg1500(struct b1500 *d) { *d = g1500; }
+__attribute__((noinline)) static void to_seg4k(const struct b4k *s) { g4k = *s; }
+__attribute__((noinline)) static void from_seg4k(struct b4k *d) { *d = g4k; }
+__attribute__((noinline)) static void seg_to_seg600(void) { g600 = g600_b; }
+__attribute__((noinline)) static struct b320 ret320(void) { return g320; }
+
+/* Eight integer arguments fill the argument registers and spill to the frame,
+ * so the locals below are addressed from %rsp in some frame layouts. */
+__attribute__((noinline)) static long many_args(long a, long b, long c, long d,
+                                                long e, long f, long g, long h,
+                                                const struct b600 *src,
+                                                const struct b1500 *src2) {
+    struct b600 t = *src;
+    g600 = t;
+    long sum = a + b + c + d + e + f + g + h;
+    g1500 = *src2;
+    return sum + t.b[0];
+}
+
+int main(void) {
+    setvbuf(stdout, NULL, _IONBF, 0);
+    map_mirror(a24, sizeof(struct b24));
+    map_mirror(a320, sizeof(struct b320));
+    map_mirror(a600, sizeof(struct b600));
+    map_mirror(a1500, sizeof(struct b1500));
+    map_mirror(a4k, sizeof(struct b4k));
+    map_mirror(a600b, sizeof(struct b600));
+    if (syscall(SYS_arch_prctl, ARCH_SET_GS, (void *)GS_DISP) != 0) {
+        perror("arch_prctl");
+        return 2;
+    }
+
+    struct b24 s24;
+    struct b320 s320;
+    struct b600 s600;
+    struct b1500 s1500;
+    struct b4k s4k;
+    fill(s24.b, sizeof s24.b, 1);
+    fill(s320.b, sizeof s320.b, 2);
+    fill(s600.b, sizeof s600.b, 3);
+    fill(s1500.b, sizeof s1500.b, 4);
+    fill(s4k.b, sizeof s4k.b, 5);
+
+    to_seg24(&s24);
+    CHECK(matches(((struct b24 *)MIR(a24))->b, 24, 1), "gen_to_seg_24");
+    struct b24 r24;
+    memset(&r24, 0, sizeof r24);
+    from_seg24(&r24);
+    CHECK(matches(r24.b, 24, 1), "seg_to_gen_24");
+
+    to_seg320(&s320);
+    CHECK(matches(((struct b320 *)MIR(a320))->b, 320, 2), "gen_to_seg_320");
+    struct b320 r320 = ret320();
+    CHECK(matches(r320.b, 320, 2), "return_seg_320_by_value");
+    struct b320 f320;
+    from_seg320(&f320);
+    CHECK(matches(f320.b, 320, 2), "seg_to_gen_320");
+
+    to_seg600(&s600);
+    CHECK(matches(((struct b600 *)MIR(a600))->b, 600, 3), "gen_to_seg_600");
+    struct b600 f600;
+    from_seg600(&f600);
+    CHECK(matches(f600.b, 600, 3), "seg_to_gen_600");
+
+    to_seg1500(&s1500);
+    CHECK(matches(((struct b1500 *)MIR(a1500))->b, 1500, 4), "gen_to_seg_1500");
+    struct b1500 f1500;
+    from_seg1500(&f1500);
+    CHECK(matches(f1500.b, 1500, 4), "seg_to_gen_1500");
+
+    to_seg4k(&s4k);
+    CHECK(matches(((struct b4k *)MIR(a4k))->b, 4096, 5), "gen_to_seg_4096");
+    struct b4k f4k;
+    from_seg4k(&f4k);
+    CHECK(matches(f4k.b, 4096, 5), "seg_to_gen_4096");
+
+    /* Segment -> segment: g600_b is filled through its mirror, then copied. */
+    fill(((struct b600 *)MIR(a600b))->b, 600, 6);
+    seg_to_seg600();
+    CHECK(matches(((struct b600 *)MIR(a600))->b, 600, 6), "seg_to_seg_600");
+
+    /* Copy inside a function with eight integer arguments. */
+    long sum = many_args(1, 2, 3, 4, 5, 6, 7, 8, &s600, &s1500);
+    CHECK(sum == 36 + s600.b[0], "many_args_sum");
+    CHECK(matches(((struct b600 *)MIR(a600))->b, 600, 3), "many_args_copy_600");
+    CHECK(matches(((struct b1500 *)MIR(a1500))->b, 1500, 4), "many_args_copy_1500");
+
+    printf("%s (%d failure%s)\n", failures ? "FAILED" : "PASSED", failures,
+           failures == 1 ? "" : "s");
+    return failures ? 1 : 0;
+}
diff --git a/tests/regression/seg_gs_runtime/seg_gs_complex_rvalue.c b/tests/regression/seg_gs_runtime/seg_gs_complex_rvalue.c
new file mode 100644
index 00000000..dbfc05ab
--- /dev/null
+++ b/tests/regression/seg_gs_runtime/seg_gs_complex_rvalue.c
@@ -0,0 +1,150 @@
+/* Runtime, self-checking contract for complex __seg_gs objects used as rvalues.
+ *
+ * A complex rvalue read from %gs must be copied exactly once into a generic
+ * temporary. A second copy reads %gs at the temporary's stack address and
+ * returns garbage. `__real__`/`__imag__` of a segment complex must also have
+ * the component type at -O0, where a pointer type would read the component as
+ * an address.
+ *
+ * GS_DISP and the mirror work as in seg_gs_audit.c: the GS base is set to
+ * GS_DISP, and (&object + GS_DISP) is mapped as a mirror. A correct %gs access
+ * reads the mirror. A generic access reads the object's own bytes, which hold
+ * different values, so a missed segment fails the check.
+ */
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/mman.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#define ARCH_SET_GS 0x1001
+#define GS_DISP ((uintptr_t)1 << 32)
+#define MIR(g) ((void *)((char *)(g) + GS_DISP))
+
+_Complex double __seg_gs cd_obj;
+_Complex double __seg_gs cd2_obj;
+_Complex float __seg_gs cf_obj;
+extern _Complex double cd_g[] __asm__("cd_obj");
+extern _Complex double cd2_g[] __asm__("cd2_obj");
+extern _Complex float cf_g[] __asm__("cf_obj");
+
+/* Generic objects with values that differ from the mirror, so a generic read
+ * of a segment object cannot pass. */
+static _Complex double cd_generic = 100.0 + 200.0 * 1.0i;
+
+static int failures;
+
+#define CHECK(cond, name)                                  \
+    do {                                                   \
+        if (cond) printf("ok   %s\n", name);               \
+        else { printf("FAIL %s\n", name); failures++; }    \
+    } while (0)
+
+static void map_mirror(void *g, size_t n) {
+    uintptr_t lo = (uintptr_t)g + GS_DISP;
+    uintptr_t page = lo & ~(uintptr_t)4095;
+    size_t len = ((lo + n - page) + 4095) & ~(size_t)4095;
+    void *m = mmap((void *)page, len, PROT_READ | PROT_WRITE,
+                   MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+    if (m != (void *)page && errno != EEXIST) {
+        perror("mmap");
+        _Exit(2);
+    }
+}
+
+/* Complex value passed and returned by value: the argument of pass_d is the
+ * comma's result, so it is a complex rvalue from a segment object. */
+__attribute__((noinline)) static _Complex double pass_d(_Complex double z) { return z; }
+
+__attribute__((noinline)) static double real_of_comma(void) {
+    return __real__(0, cd_obj);
+}
+
+__attribute__((noinline)) static double arg_comma(void) {
+    return __real__ pass_d((0, cd_obj));
+}
+
+__attribute__((noinline)) static double imag_of_arg(void) {
+    return __imag__ pass_d(cd_obj);
+}
+
+__attribute__((noinline)) static double parts_sum(void) {
+    return __real__ cd_obj + __imag__ cd_obj;
+}
+
+__attribute__((noinline)) static _Complex double assign_val(_Complex double z) {
+    return (cd_obj = z);
+}
+
+__attribute__((noinline)) static _Complex double cond_pick(int k) {
+    return k ? cd_obj : cd2_obj;
+}
+
+__attribute__((noinline)) static _Complex double comma_ret(void) {
+    return (0, cd2_obj);
+}
+
+__attribute__((noinline)) static float cf_real_of_comma(void) {
+    return __real__(cf_obj, cf_obj);
+}
+
+__attribute__((noinline)) static _Complex double sum_objects(void) {
+    return cd_obj + cd2_obj;
+}
+
+__attribute__((noinline)) static _Complex double generic_pick(int k) {
+    return k ? cd_generic : cd2_obj;
+}
+
+static int same(_Complex double z, double re, double im) {
+    return __real__ z == re && __imag__ z == im;
+}
+
+int main(void) {
+    setvbuf(stdout, NULL, _IONBF, 0);
+    map_mirror(cd_g, sizeof(_Complex double));
+    map_mirror(cd2_g, sizeof(_Complex double));
+    map_mirror(cf_g, sizeof(_Complex float));
+    if (syscall(SYS_arch_prctl, ARCH_SET_GS, (void *)GS_DISP) != 0) {
+        perror("arch_prctl");
+        return 2;
+    }
+
+    /* Seed the mirrors through ordinary pointers. */
+    volatile double *m1 = (volatile double *)MIR(cd_g);
+    m1[0] = 3.0;
+    m1[1] = 4.0;
+    volatile double *m2 = (volatile double *)MIR(cd2_g);
+    m2[0] = 7.0;
+    m2[1] = 8.0;
+    volatile float *mf = (volatile float *)MIR(cf_g);
+    mf[0] = 1.5f;
+    mf[1] = 2.5f;
+
+    CHECK(real_of_comma() == 3.0, "comma_real_of_rvalue");
+    CHECK(arg_comma() == 3.0, "comma_argument_real");
+    CHECK(imag_of_arg() == 4.0, "argument_imag");
+    CHECK(parts_sum() == 7.0, "direct_parts_sum");
+    CHECK(same(sum_objects(), 10.0, 12.0), "sum_of_two_segment_objects");
+    CHECK(same(comma_ret(), 7.0, 8.0), "comma_return_complex");
+    CHECK(same(cond_pick(1), 3.0, 4.0), "conditional_arm_segment");
+    CHECK(same(cond_pick(0), 7.0, 8.0), "conditional_other_arm_segment");
+    CHECK(same(generic_pick(1), 100.0, 200.0), "conditional_generic_arm");
+    CHECK(cf_real_of_comma() == 1.5f, "float_complex_comma_real");
+
+    /* Assignment: the stored value is written through %gs, and the value of
+     * the assignment expression is the same complex. */
+    CHECK(same(assign_val(5.0 + 6.0 * 1.0i), 5.0, 6.0), "assignment_value");
+    CHECK(m1[0] == 5.0 && m1[1] == 6.0, "assignment_stored_through_gs");
+
+    if (failures == 0) {
+        /* The generic copy must not have been touched. */
+        CHECK(__real__ cd_generic == 100.0, "generic_object_untouched");
+    }
+
+    printf("%s (%d failure%s)\n", failures ? "FAILED" : "PASSED", failures,
+           failures == 1 ? "" : "s");
+    return failures ? 1 : 0;
+}
diff --git a/tests/regression/seg_gs_runtime/seg_gs_decay.c b/tests/regression/seg_gs_runtime/seg_gs_decay.c
new file mode 100644
index 00000000..f9a4ec2c
--- /dev/null
+++ b/tests/regression/seg_gs_runtime/seg_gs_decay.c
@@ -0,0 +1,145 @@
+/* Runtime, self-checking contract for pointer arithmetic on decayed __seg_gs
+ * arrays and member arrays. Same mirror technique as seg_gs_audit.c: the GS
+ * base is set to GS_DISP, the bytes at (&object + GS_DISP) are mapped, and a
+ * correct %gs access writes the mirror. Each check reads the mirror with an
+ * ordinary pointer, so a generic (missed-segment) access fails the check.
+ *
+ * Covered forms: array + n, n + array, array - n, pointer += n, pointer to a
+ * named-space array row (row[0] + n), a conditional of two array offsets,
+ * a member-array decay with and without an offset, and pointer difference.
+ */
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/mman.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#define ARCH_SET_GS 0x1001
+#define GS_DISP ((uintptr_t)1 << 32)
+#define MIR(g) ((void *)((char *)(g) + GS_DISP))
+
+struct box { long inner[4]; long pad; };
+
+long __seg_gs dec_arr[8];
+struct box __seg_gs boxes[2];
+long __seg_gs grid[3][4];
+
+extern long dec_g[] __asm__("dec_arr");
+extern struct box bx_g[] __asm__("boxes");
+extern long grid_g[3][4] __asm__("grid");
+
+static int failures;
+
+#define CHECK(cond, name)                                  \
+    do {                                                   \
+        if (cond) printf("ok   %s\n", name);               \
+        else { printf("FAIL %s\n", name); failures++; }    \
+    } while (0)
+
+static void map_mirror(void *g, size_t n) {
+    uintptr_t lo = (uintptr_t)g + GS_DISP;
+    uintptr_t page = lo & ~(uintptr_t)4095;
+    size_t len = ((lo + n - page) + 4095) & ~(size_t)4095;
+    void *m = mmap((void *)page, len, PROT_READ | PROT_WRITE,
+                   MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+    if (m != (void *)page && errno != EEXIST) {
+        perror("mmap");
+        _Exit(2);
+    }
+}
+
+__attribute__((noinline)) static long f_init_member(void) {
+    long __seg_gs *p = boxes[0].inner + 1;      /* member decay + n */
+    *p = 11;
+    return boxes[0].inner[1];
+}
+__attribute__((noinline)) static long f_init_member_plain(void) {
+    long __seg_gs *p = boxes[1].inner;          /* member decay */
+    p[2] = 12;
+    return boxes[1].inner[2];
+}
+__attribute__((noinline)) static long f_assign_plus(void) {
+    long __seg_gs *p;
+    p = dec_arr;
+    p += 7;                                     /* compound pointer add */
+    *p = 21;
+    return dec_arr[7];
+}
+__attribute__((noinline)) static long f_loop_var(long n) {
+    long s = 0;
+    for (long i = 0; i < n; i++) {
+        long __seg_gs *q = dec_arr + i;         /* variable offset */
+        *q = i * 3;
+    }
+    for (long i = 0; i < n; i++) s += *(dec_arr + i);
+    return s;
+}
+__attribute__((noinline)) static long f_sub(void) {
+    long __seg_gs *end = dec_arr + 8;
+    long __seg_gs *beg = end - 8;               /* array - n */
+    return (long)(end - beg);
+}
+__attribute__((noinline)) static long f_rowptr(void) {
+    long __seg_gs (*row)[4] = grid + 1;         /* pointer to named row */
+    long __seg_gs *cell = row[0] + 2;           /* row decay + n */
+    *cell = 33;
+    return grid[1][2] + (long)(row - grid);
+}
+__attribute__((noinline)) static long f_cond(int c) {
+    long __seg_gs *p = c ? dec_arr + 5 : dec_arr + 6;
+    *p = 44;
+    return dec_arr[5] + dec_arr[6];
+}
+/* Dereference of an arithmetic result on a named-space array: the read itself
+ * must use %gs, not only the pointer type. Seeds: boxes[1].inner[1] = 211 and
+ * dec_arr[1] = 3 (written by f_loop_var). */
+__attribute__((noinline)) static long f_deref_forms(void) {
+    return *(boxes[1].inner + 1) * 1000 + *((7 + dec_arr) - 6);
+}
+__attribute__((noinline)) static long f_deref_sum(void) {
+    long __seg_gs *p = &dec_arr[0] + 4;
+    return *p;
+}
+
+int main(void) {
+    map_mirror(dec_g, sizeof(long) * 8);
+    map_mirror(bx_g, sizeof(struct box) * 2);
+    map_mirror(grid_g, sizeof(long) * 12);
+    if (syscall(SYS_arch_prctl, ARCH_SET_GS, (void *)GS_DISP) != 0) {
+        perror("arch_prctl");
+        return 2;
+    }
+
+    /* Seed the mirrors through ordinary pointers. */
+    volatile long *dm = MIR(dec_g);
+    for (int i = 0; i < 8; i++) dm[i] = 100 + i;
+    volatile struct box *bm = MIR(bx_g);
+    for (int k = 0; k < 2; k++) {
+        for (int j = 0; j < 4; j++) bm[k].inner[j] = 200 + 10 * k + j;
+        bm[k].pad = 0;
+    }
+    volatile long *gm = MIR(grid_g);
+    for (int r = 0; r < 3; r++)
+        for (int c = 0; c < 4; c++) gm[r * 4 + c] = 300 + 10 * r + c;
+
+    CHECK(f_init_member() == 11, "member_decay_offset_value");
+    CHECK(bm[0].inner[1] == 11, "member_decay_offset_mirror");
+    CHECK(f_init_member_plain() == 12, "member_decay_value");
+    CHECK(bm[1].inner[2] == 12, "member_decay_mirror");
+    CHECK(f_assign_plus() == 21, "pointer_plus_assign_value");
+    CHECK(dm[7] == 21, "pointer_plus_assign_mirror");
+    CHECK(f_loop_var(5) == 30, "variable_offset_sum");
+    CHECK(dm[4] == 12, "variable_offset_mirror");
+    CHECK(f_deref_forms() == 211003, "deref_of_arithmetic_read");
+    CHECK(f_sub() == 8, "array_minus_n_difference");
+    CHECK(f_rowptr() == 34, "row_pointer_decay");
+    CHECK(gm[1 * 4 + 2] == 33, "row_pointer_mirror");
+    CHECK(f_cond(1) == 44 + 106, "conditional_offset_value");
+    CHECK(dm[5] == 44, "conditional_offset_mirror");
+    CHECK(f_deref_sum() == 12, "address_plus_n_read");
+
+    printf("%s (%d failure%s)\n", failures ? "FAILED" : "PASSED", failures, failures == 1 ? "" : "s");
+    return failures ? 1 : 0;
+}
diff --git a/tests/regression/seg_gs_runtime/seg_gs_fold.c b/tests/regression/seg_gs_runtime/seg_gs_fold.c
new file mode 100644
index 00000000..a8b0d56c
--- /dev/null
+++ b/tests/regression/seg_gs_runtime/seg_gs_fold.c
@@ -0,0 +1,241 @@
+/* Runtime, self-checking contract for constant-displacement folding of
+ * __seg_gs loads and stores.
+ *
+ * A __seg_gs access whose address is a GEP with a constant offset (a struct
+ * member, an array element at a constant index, a `p + k` pointer) is emitted
+ * as one `%gs:disp(%base)` operand. This program forces every integer width
+ * through that form, with constant and register sources, with sign- and
+ * zero-extending loads, with read-modify-write, and with the base in a
+ * register reached through a global segment pointer. Each value is checked
+ * against the same bytes read through an ordinary pointer to the same area,
+ * so the verdict does not depend on any other compiler.
+ *
+ * The GS base is set to `area`; a segment pointer with value `off` addresses
+ * area[off]. Every check prints "ok <name>" or "FAIL <name>". The program
+ * prints "PASSED (0 failures)" and exits 0 only when all checks pass.
+ */
+#include <stdio.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#define ARCH_SET_GS 0x1001
+#define AREA 4096
+#define MIX_OFF 256
+
+struct mix {
+    char c;
+    unsigned char uc;
+    short s;
+    unsigned short us;
+    int i;
+    unsigned int ui;
+    long l;
+    unsigned long ul;
+    char *p;
+};
+
+static unsigned char area[AREA] __attribute__((aligned(64)));
+static int failures;
+
+#define CHECK(cond, name)                 \
+    do {                                  \
+        if (cond) {                       \
+            printf("ok %s\n", name);      \
+        } else {                          \
+            printf("FAIL %s\n", name);    \
+            failures++;                   \
+        }                                 \
+    } while (0)
+
+/* Global segment pointers: the base comes from memory, not from a parameter. */
+static struct mix __seg_gs *GM = (struct mix __seg_gs *)MIX_OFF;
+static long __seg_gs *GA = (long __seg_gs *)0;
+static unsigned short __seg_gs *GS = (unsigned short __seg_gs *)512;
+
+/* Constant stores at constant member offsets. */
+__attribute__((noinline)) static void store_consts(struct mix __seg_gs *m) {
+    m->c = -3;
+    m->uc = 250;
+    m->s = -1000;
+    m->us = 60000;
+    m->i = -70000;
+    m->ui = 4000000000u;
+    m->l = -5;
+    m->ul = 1ul << 40;
+    m->p = (char *)0x1234;
+}
+
+/* Register-valued stores at the same offsets. */
+__attribute__((noinline)) static void store_vars(struct mix __seg_gs *m, long v) {
+    m->c = (char)v;
+    m->uc = (unsigned char)(v + 1);
+    m->s = (short)(v * 3);
+    m->us = (unsigned short)(v * 5);
+    m->i = (int)(v * 7);
+    m->ui = (unsigned int)(v * 11);
+    m->l = v * 13;
+    m->ul = (unsigned long)v * 17;
+}
+
+/* Sign- and zero-extending loads at constant offsets, combined so every
+ * extension matters: the result differs if any width or extension is wrong. */
+__attribute__((noinline)) static long load_mix(struct mix __seg_gs *m) {
+    long r = 0;
+    r += m->c;
+    r = r * 3 + m->uc;
+    r = r * 3 + m->s;
+    r = r * 3 + m->us;
+    r = r * 3 + m->i;
+    r = r * 3 + (long)m->ui;
+    r = r * 3 + m->l;
+    r = r * 3 + (long)m->ul;
+    return r;
+}
+
+/* Read-modify-write at constant offsets. */
+__attribute__((noinline)) static void rmw_mix(struct mix __seg_gs *m) {
+    m->c += 9;
+    m->uc -= 3;
+    m->s ^= 0x55;
+    m->us |= 0x8001;
+    m->i *= 2;
+    m->ui >>= 1;
+    m->l -= 100;
+    m->ul &= ~0xffUL;
+}
+
+/* Array elements at constant indices, through a pointer parameter. */
+__attribute__((noinline)) static long arr_sum(long __seg_gs *a) {
+    long s = 0;
+    for (int k = 0; k < 4; k++) s += a[k];
+    a[5] = s;
+    a[6] = a[0] ^ a[3];
+    return s + a[5] + a[6];
+}
+
+/* Store of a value that is itself a loaded segment value (value in a
+ * register, base in another register). */
+__attribute__((noinline)) static void copy_field(struct mix __seg_gs *m) {
+    m->ui = m->i;
+    m->us = m->s;
+    m->l = m->ui;
+}
+
+/* Base kept live across a call so it sits in a callee-saved register, plus
+ * enough live values to force register pressure. */
+__attribute__((noinline)) static long pressure(struct mix __seg_gs *m, long a, long b, long c,
+                                                long d, long e, long f) {
+    long keep = a * b + c;
+    m->i = (int)(keep + d);
+    long got = m->i;
+    m->us = (unsigned short)(e + f);
+    long back = m->us;
+    return keep + got + back + a + b + c + d + e + f;
+}
+
+int main(void) {
+    if (syscall(SYS_arch_prctl, ARCH_SET_GS, area) != 0) {
+        perror("arch_prctl");
+        return 2;
+    }
+    setvbuf(stdout, NULL, _IONBF, 0);
+
+    struct mix *g = (struct mix *)(area + MIX_OFF);
+    struct mix __seg_gs *m = (struct mix __seg_gs *)MIX_OFF;
+
+    /* Constant stores, read back through generic memory. */
+    store_consts(m);
+    CHECK(g->c == -3, "const_store_i8");
+    CHECK(g->uc == 250, "const_store_u8");
+    CHECK(g->s == -1000, "const_store_i16");
+    CHECK(g->us == 60000, "const_store_u16");
+    CHECK(g->i == -70000, "const_store_i32");
+    CHECK(g->ui == 4000000000u, "const_store_u32");
+    CHECK(g->l == -5, "const_store_i64");
+    CHECK(g->ul == (1ul << 40), "const_store_u64");
+    CHECK(g->p == (char *)0x1234, "const_store_ptr");
+
+    /* Constant loads with sign and zero extension, against generic loads. */
+    {
+        long want = 0;
+        want += g->c;
+        want = want * 3 + g->uc;
+        want = want * 3 + g->s;
+        want = want * 3 + g->us;
+        want = want * 3 + g->i;
+        want = want * 3 + (long)g->ui;
+        want = want * 3 + g->l;
+        want = want * 3 + (long)g->ul;
+        CHECK(load_mix(m) == want, "const_load_extend");
+    }
+
+    /* Register-valued stores, each width. */
+    store_vars(m, -7);
+    CHECK(g->c == (char)-7, "var_store_i8");
+    CHECK(g->uc == (unsigned char)-6, "var_store_u8");
+    CHECK(g->s == (short)-21, "var_store_i16");
+    CHECK(g->us == (unsigned short)-35, "var_store_u16");
+    CHECK(g->i == -49, "var_store_i32");
+    CHECK(g->ui == (unsigned int)-77, "var_store_u32");
+    CHECK(g->l == -91, "var_store_i64");
+    CHECK(g->ul == (unsigned long)-7 * 17, "var_store_u64");
+
+    /* Read-modify-write, against the same operations on generic memory. */
+    store_consts(m);
+    rmw_mix(m);
+    CHECK(g->c == (char)(-3 + 9), "rmw_i8");
+    CHECK(g->uc == (unsigned char)(250 - 3), "rmw_u8");
+    CHECK(g->s == (short)(-1000 ^ 0x55), "rmw_i16");
+    CHECK(g->us == (unsigned short)(60000 | 0x8001), "rmw_u16");
+    CHECK(g->i == -140000, "rmw_i32");
+    CHECK(g->ui == 2000000000u, "rmw_u32");
+    CHECK(g->l == -105, "rmw_i64");
+    CHECK(g->ul == ((1ul << 40) & ~0xffUL), "rmw_u64");
+
+    /* Field-to-field copies: loaded value stored at another offset. */
+    store_vars(m, 4);
+    copy_field(m);
+    CHECK(g->ui == (unsigned int)g->i, "copy_i32_to_u32");
+    CHECK(g->us == (unsigned short)g->s, "copy_i16_to_u16");
+    CHECK(g->l == (long)g->ui, "copy_u32_to_i64");
+
+    /* Array elements at constant indices through a pointer parameter. */
+    {
+        long __seg_gs *a = (long __seg_gs *)1024;
+        long *ga = (long *)(area + 1024);
+        for (int k = 0; k < 7; k++) ga[k] = 100 + k * 10;
+        long got = arr_sum(a);
+        /* s = 100+110+120+130 = 460; a[5] = s; a[6] = a[0]^a[3]; result s + a[5] + a[6]. */
+        CHECK(got == 460 + 460 + (100 ^ 130), "arr_sum_value");
+        CHECK(ga[5] == 460, "arr_sum_store_const_index");
+        CHECK(ga[6] == (100 ^ 130), "arr_xor_store");
+    }
+
+    /* Base from a global segment pointer, offset zero and non-zero. */
+    GA[2] = 0x1122334455667788L;
+    CHECK(*(long *)(area + 16) == 0x1122334455667788L, "global_base_long");
+    GA[3] = GA[2] + 1;
+    CHECK(*(long *)(area + 24) == 0x1122334455667789L, "global_base_rmw_source");
+    GS[1] = 0xbeef;
+    CHECK(*(unsigned short *)(area + 514) == 0xbeef, "global_base_u16");
+    CHECK(GM->l == 28, "global_pointer_member_load");
+    GM->us = 7;
+    CHECK(g->us == 7, "global_pointer_member_store");
+
+    /* Register pressure with the base reused across calls. */
+    store_consts(m);
+    {
+        long r = pressure(m, 3, 4, 5, 6, 7, 8);
+        /* keep = 3*4+5 = 17; i = 17+6 = 23; us = 7+8 = 15; r = 17+23+15+3+4+5+6+7+8. */
+        CHECK(g->i == 23, "pressure_store_i32");
+        CHECK(g->us == 15, "pressure_store_u16");
+        CHECK(r == 88, "pressure_value");
+    }
+
+    if (failures == 0) {
+        printf("PASSED (0 failures)\n");
+        return 0;
+    }
+    printf("FAILED (%d failure%s)\n", failures, failures == 1 ? "" : "s");
+    return 1;
+}
diff --git a/tests/regression/seg_gs_runtime/seg_gs_indexed.c b/tests/regression/seg_gs_runtime/seg_gs_indexed.c
new file mode 100644
index 00000000..3505e75a
--- /dev/null
+++ b/tests/regression/seg_gs_runtime/seg_gs_indexed.c
@@ -0,0 +1,254 @@
+/* Runtime, self-checking contract for indexed __seg_gs accesses: the array
+ * element forms `obj[i]`, `obj[i + k]`, and `p[i]` through a parameter base,
+ * for every integer width and pointer element, in loads, stores, immediate
+ * stores (with truncation), and read-modify-write. The GS base is set to
+ * GS_DISP and each object is mirrored at (&object + GS_DISP); a correct %gs
+ * access reads and writes the mirror, and every expected value comes from an
+ * explicit formula, not from the code under test.
+ */
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/mman.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#define ARCH_SET_GS 0x1001
+#define GS_DISP ((uintptr_t)1 << 32)
+#define MIR(g) ((void *)((char *)(g) + GS_DISP))
+#define N 16
+
+long __seg_gs ix_l[N];
+int __seg_gs ix_i[N];
+unsigned char __seg_gs ix_b[N];
+short __seg_gs ix_s[N];
+unsigned int __seg_gs ix_u[N];
+void *__seg_gs ix_p[N];
+
+/* Generic-address aliases of the same objects, for the mirror and mmap calls. */
+extern long g_l[N] __asm__("ix_l");
+extern int g_i[N] __asm__("ix_i");
+extern unsigned char g_b[N] __asm__("ix_b");
+extern short g_s[N] __asm__("ix_s");
+extern unsigned int g_u[N] __asm__("ix_u");
+extern void *g_p[N] __asm__("ix_p");
+
+static int failures;
+
+#define CHECK(cond, name)                                  \
+    do {                                                   \
+        if (cond) printf("ok   %s\n", name);               \
+        else { printf("FAIL %s\n", name); failures++; }    \
+    } while (0)
+
+static void map_mirror(void *g, size_t n) {
+    uintptr_t lo = (uintptr_t)g + GS_DISP;
+    uintptr_t page = lo & ~(uintptr_t)4095;
+    size_t len = ((lo + n - page) + 4095) & ~(size_t)4095;
+    void *m = mmap((void *)page, len, PROT_READ | PROT_WRITE,
+                   MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+    if (m != (void *)page && errno != EEXIST) {
+        perror("mmap");
+        _Exit(2);
+    }
+}
+
+/* Loads and stores at scale 8, 4, 2 and 1, with a variable index. */
+__attribute__((noinline)) static void fill_l(long n) {
+    for (long i = 0; i < n; i++) ix_l[i] = 7 * i + 1;
+}
+__attribute__((noinline)) static long sum_l(long n) {
+    long s = 0;
+    for (long i = 0; i < n; i++) s += ix_l[i];
+    return s;
+}
+__attribute__((noinline)) static void fill_i(long n) {
+    for (long i = 0; i < n; i++) ix_i[i] = (int)(i * 1000003) - 9000000;
+}
+__attribute__((noinline)) static long sum_i(long n) {  /* sign extension */
+    long s = 0;
+    for (long i = 0; i < n; i++) s += ix_i[i];
+    return s;
+}
+__attribute__((noinline)) static void fill_s(long n) {
+    for (long i = 0; i < n; i++) ix_s[i] = (short)(i * 4001 - 30000);
+}
+__attribute__((noinline)) static long sum_s(long n) {
+    long s = 0;
+    for (long i = 0; i < n; i++) s += ix_s[i];
+    return s;
+}
+__attribute__((noinline)) static void fill_b(long n) {  /* truncating store */
+    for (long i = 0; i < n; i++) ix_b[i] = (unsigned char)(i * 37 + 200);
+}
+__attribute__((noinline)) static long sum_b(long n) {  /* zero extension */
+    long s = 0;
+    for (long i = 0; i < n; i++) s += ix_b[i];
+    return s;
+}
+__attribute__((noinline)) static void fill_u(long n) {
+    for (long i = 0; i < n; i++) ix_u[i] = 0xfffffff0u + (unsigned)i;
+}
+__attribute__((noinline)) static long sum_u(long n) {  /* 32-bit zero extension */
+    long s = 0;
+    for (long i = 0; i < n; i++) s += (long)ix_u[i];
+    return s;
+}
+
+/* Immediate stores, including values wider than the element. */
+__attribute__((noinline)) static void const_store(long n) {
+    for (long i = 0; i < n; i++) {
+        ix_l[i] = -5;
+        ix_b[i] = (unsigned char)0x1ff;
+        ix_s[i] = -2;
+    }
+}
+
+/* Read-modify-write through one index, and a displaced neighbour read. */
+__attribute__((noinline)) static void rmw_l(long n) {
+    for (long i = 0; i < n; i++) ix_l[i] += i + 1;
+}
+__attribute__((noinline)) static void shift_neighbour(long n) {
+    for (long i = 0; i + 1 < n; i++) ix_l[i] = ix_l[i + 1] - 1;
+}
+
+/* Register base: the object reaches the callee as a parameter. */
+__attribute__((noinline)) static void p_fill(long __seg_gs *p, long n) {
+    for (long i = 0; i < n; i++) p[i] = 3 * i + 2;
+}
+__attribute__((noinline)) static long p_sum(long __seg_gs *p, long n) {
+    long s = 0;
+    for (long i = 0; i < n; i++) s += p[i];
+    return s;
+}
+
+/* Pointer elements (Ptr width), symbol base. */
+__attribute__((noinline)) static void fill_p(long n) {
+    for (long i = 0; i < n; i++) ix_p[i] = (void *)(uintptr_t)(i + 1);
+}
+__attribute__((noinline)) static long sum_p(long n) {
+    long s = 0;
+    for (long i = 0; i < n; i++) s += (long)(uintptr_t)ix_p[i];
+    return s;
+}
+
+int main(void) {
+    map_mirror(g_l, sizeof g_l);
+    map_mirror(g_i, sizeof g_i);
+    map_mirror(g_b, sizeof g_b);
+    map_mirror(g_s, sizeof g_s);
+    map_mirror(g_u, sizeof g_u);
+    map_mirror(g_p, sizeof g_p);
+    if (syscall(SYS_arch_prctl, ARCH_SET_GS, (void *)GS_DISP) != 0) {
+        perror("arch_prctl");
+        return 2;
+    }
+
+    volatile long *ml = MIR(g_l);
+    volatile int *mi = MIR(g_i);
+    volatile unsigned char *mb = MIR(g_b);
+    volatile short *ms = MIR(g_s);
+    volatile unsigned int *mu = MIR(g_u);
+    void *volatile *mp = MIR(g_p);
+
+    /* Seed the mirrors through ordinary pointers, then read through %gs. */
+    long e;
+    for (int i = 0; i < N; i++) ml[i] = 1000 + i * i;
+    e = 0;
+    for (int i = 0; i < N; i++) e += 1000 + i * i;
+    CHECK(sum_l(N) == e, "load_long_sum");
+
+    for (int i = 0; i < N; i++) mi[i] = -i * 3;
+    e = 0;
+    for (int i = 0; i < N; i++) e += -i * 3;
+    CHECK(sum_i(N) == e, "load_int_sign_extend_sum");
+
+    for (int i = 0; i < N; i++) ms[i] = (short)(-300 * i - 1);
+    e = 0;
+    for (int i = 0; i < N; i++) e += -300 * i - 1;
+    CHECK(sum_s(N) == e, "load_short_sign_extend_sum");
+
+    for (int i = 0; i < N; i++) mb[i] = (unsigned char)(250 + i);
+    e = 0;
+    for (int i = 0; i < N; i++) e += (unsigned char)(250 + i);
+    CHECK(sum_b(N) == e, "load_byte_zero_extend_sum");
+
+    for (int i = 0; i < N; i++) mu[i] = 0xf0000000u + (unsigned)i;
+    e = 0;
+    for (int i = 0; i < N; i++) e += (long)(0xf0000000u + (unsigned)i);
+    CHECK(sum_u(N) == e, "load_uint_zero_extend_sum");
+
+    for (int i = 0; i < N; i++) mp[i] = (void *)(uintptr_t)(100 + i);
+    e = 0;
+    for (int i = 0; i < N; i++) e += 100 + i;
+    CHECK(sum_p(N) == e, "load_pointer_sum");
+
+    /* Stores through the segment index, checked on the mirror. */
+    fill_l(N);
+    int ok = 1;
+    for (int i = 0; i < N; i++) ok &= ml[i] == 7 * i + 1;
+    CHECK(ok, "store_long_mirror");
+
+    fill_i(N);
+    ok = 1;
+    for (int i = 0; i < N; i++) ok &= mi[i] == (int)(i * 1000003) - 9000000;
+    CHECK(ok, "store_int_mirror");
+
+    fill_s(N);
+    ok = 1;
+    for (int i = 0; i < N; i++) ok &= ms[i] == (short)(i * 4001 - 30000);
+    CHECK(ok, "store_short_mirror");
+
+    fill_b(N);
+    ok = 1;
+    for (int i = 0; i < N; i++) ok &= mb[i] == (unsigned char)(i * 37 + 200);
+    CHECK(ok, "store_byte_truncates_mirror");
+
+    fill_u(N);
+    ok = 1;
+    for (int i = 0; i < N; i++) ok &= mu[i] == 0xfffffff0u + (unsigned)i;
+    CHECK(ok, "store_uint_mirror");
+
+    fill_p(N);
+    ok = 1;
+    for (int i = 0; i < N; i++) ok &= (uintptr_t)mp[i] == (uintptr_t)(i + 1);
+    CHECK(ok, "store_pointer_mirror");
+
+    const_store(N);
+    ok = 1;
+    for (int i = 0; i < N; i++)
+        ok &= ml[i] == -5 && mb[i] == 0xff && ms[i] == -2;
+    CHECK(ok, "immediate_store_truncates_mirror");
+
+    /* Fill then read back through the same segment index. */
+    fill_l(N);
+    e = 0;
+    for (int i = 0; i < N; i++) e += 7 * i + 1;
+    CHECK(sum_l(N) == e, "store_then_load_long_sum");
+
+    /* Read-modify-write: ix[i] = (7i+1) + (i+1), then a displaced neighbour
+     * shift with ix[i] = ix[i+1] - 1, which reads one element ahead. */
+    fill_l(N);
+    rmw_l(N);
+    ok = 1;
+    for (int i = 0; i < N; i++) ok &= ml[i] == 7 * i + 1 + i + 1;
+    CHECK(ok, "read_modify_write_mirror");
+    shift_neighbour(N);
+    ok = 1;
+    for (int i = 0; i + 1 < N; i++) ok &= ml[i] == 7 * (i + 1) + 1 + (i + 1) + 1 - 1;
+    CHECK(ok, "displaced_neighbour_mirror");
+
+    /* Register base through a parameter. */
+    p_fill(ix_l, N);
+    ok = 1;
+    for (int i = 0; i < N; i++) ok &= ml[i] == 3 * i + 2;
+    CHECK(ok, "register_base_store_mirror");
+    e = 0;
+    for (int i = 0; i < N; i++) e += 3 * i + 2;
+    CHECK(p_sum(ix_l, N) == e, "register_base_load_sum");
+
+    printf("%s (%d failure%s)\n", failures ? "FAILED" : "PASSED", failures,
+           failures == 1 ? "" : "s");
+    return failures ? 1 : 0;
+}
diff --git a/tests/regression/seg_gs_runtime/seg_gs_overread.c b/tests/regression/seg_gs_runtime/seg_gs_overread.c
new file mode 100644
index 00000000..88396828
--- /dev/null
+++ b/tests/regression/seg_gs_runtime/seg_gs_overread.c
@@ -0,0 +1,139 @@
+/* Guard-page test: aggregate transfers of 1..15 bytes must touch exactly the
+ * bytes of the object.
+ *
+ * Each object ends at the end of a readable page, and the following page is
+ * PROT_NONE. A load or store one byte too wide faults. The same objects are
+ * exercised through a __seg_gs view (GS base = the page) and through an
+ * ordinary generic pointer, for:
+ *   - returns (sizes 1..7: single-register class; 9..15: two-register class),
+ *   - by-value arguments,
+ *   - whole-object stores from a register-class value.
+ * A fault is reported as a FAIL line by the SIGSEGV handler and exits 1.
+ *
+ * Output: one "ok" line per check and a final "PASSED (0 failures)" line. */
+#define _GNU_SOURCE
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#define ARCH_SET_GS 0x1001
+#define PAGE 4096UL
+
+static int failures;
+
+static void on_fault(int sig) {
+    (void)sig;
+    static const char msg[] = "FAIL: access past the object (guard page hit)\n";
+    ssize_t r = write(2, msg, sizeof msg - 1);
+    (void)r;
+    _exit(1);
+}
+
+static void check(int ok, const char *name) {
+    if (ok) {
+        printf("ok %s\n", name);
+    } else {
+        printf("not ok %s\n", name);
+        failures++;
+    }
+}
+
+#define DEFINE_SIZE(N)                                                              \
+    typedef struct { unsigned char b[N]; } __attribute__((packed)) s##N;           \
+    static s##N __seg_gs *g##N;                                                    \
+    static s##N *n##N;                                                             \
+    __attribute__((noinline)) static s##N ret_seg##N(void) { return *g##N; }       \
+    __attribute__((noinline)) static s##N ret_gen##N(void) { return *n##N; }       \
+    __attribute__((noinline)) static long take##N(s##N v) {                        \
+        long t = 0;                                                                \
+        for (int i = 0; i < N; i++) t += (long)v.b[i] * (i + 1);                   \
+        return t;                                                                  \
+    }                                                                              \
+    __attribute__((noinline)) static void put_seg##N(s##N v) { *g##N = v; }        \
+    __attribute__((noinline)) static void put_gen##N(s##N v) { *n##N = v; }        \
+    static void run##N(void) {                                                     \
+        unsigned char want[N];                                                     \
+        long expect = 0;                                                           \
+        for (int i = 0; i < N; i++) {                                              \
+            want[i] = (unsigned char)(0x10 + i * 7);                               \
+            expect += (long)want[i] * (i + 1);                                     \
+        }                                                                          \
+        s##N v;                                                                    \
+        memcpy(&v, want, N);                                                       \
+        /* Seed both views through the write paths under test. */                  \
+        put_seg##N(v);                                                             \
+        s##N r = ret_seg##N();                                                     \
+        char name[64];                                                             \
+        snprintf(name, sizeof name, "size%d seg return", N);                       \
+        check(memcmp(&r, want, N) == 0, name);                                     \
+        snprintf(name, sizeof name, "size%d seg argument", N);                     \
+        check(take##N(*g##N) == expect, name);                                     \
+        put_gen##N(v);                                                             \
+        r = ret_gen##N();                                                          \
+        snprintf(name, sizeof name, "size%d generic return", N);                   \
+        check(memcmp(&r, want, N) == 0, name);                                     \
+        snprintf(name, sizeof name, "size%d generic argument", N);                 \
+        check(take##N(*n##N) == expect, name);                                     \
+    }
+
+DEFINE_SIZE(1)
+DEFINE_SIZE(2)
+DEFINE_SIZE(3)
+DEFINE_SIZE(4)
+DEFINE_SIZE(5)
+DEFINE_SIZE(6)
+DEFINE_SIZE(7)
+DEFINE_SIZE(9)
+DEFINE_SIZE(10)
+DEFINE_SIZE(11)
+DEFINE_SIZE(12)
+DEFINE_SIZE(13)
+DEFINE_SIZE(14)
+DEFINE_SIZE(15)
+
+#define RUN(N) run##N()
+
+int main(void) {
+    /* Segment view: two pages, the second one inaccessible. */
+    unsigned char *seg = mmap(NULL, 2 * PAGE, PROT_READ | PROT_WRITE,
+                              MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    /* Generic view: a separate pair of pages with the same layout. */
+    unsigned char *gen = mmap(NULL, 2 * PAGE, PROT_READ | PROT_WRITE,
+                              MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (seg == MAP_FAILED || gen == MAP_FAILED) {
+        perror("mmap");
+        return 2;
+    }
+    if (mprotect(seg + PAGE, PAGE, PROT_NONE) != 0 ||
+        mprotect(gen + PAGE, PAGE, PROT_NONE) != 0) {
+        perror("mprotect");
+        return 2;
+    }
+    if (syscall(SYS_arch_prctl, ARCH_SET_GS, seg) != 0) {
+        perror("arch_prctl");
+        return 2;
+    }
+    setvbuf(stdout, NULL, _IONBF, 0); /* the fault handler _exits: no lost lines */
+    signal(SIGSEGV, on_fault);
+    signal(SIGBUS, on_fault);
+
+#define BIND(N)                                                                     \
+    g##N = (s##N __seg_gs *)(unsigned long)(PAGE - N);                              \
+    n##N = (s##N *)(void *)(gen + PAGE - N);
+    BIND(1) BIND(2) BIND(3) BIND(4) BIND(5) BIND(6) BIND(7)
+    BIND(9) BIND(10) BIND(11) BIND(12) BIND(13) BIND(14) BIND(15)
+
+    RUN(1); RUN(2); RUN(3); RUN(4); RUN(5); RUN(6); RUN(7);
+    RUN(9); RUN(10); RUN(11); RUN(12); RUN(13); RUN(14); RUN(15);
+
+    if (failures) {
+        printf("FAILED (%d failures)\n", failures);
+        return 1;
+    }
+    printf("PASSED (0 failures)\n");
+    return 0;
+}
diff --git a/tests/regression/seg_gs_runtime/seg_gs_pointee_chain.c b/tests/regression/seg_gs_runtime/seg_gs_pointee_chain.c
new file mode 100644
index 00000000..fd7fb174
--- /dev/null
+++ b/tests/regression/seg_gs_runtime/seg_gs_pointee_chain.c
@@ -0,0 +1,83 @@
+/* Runtime, self-checking contract for a segment qualifier written after an
+ * earlier `*` of a declarator (the pointee of the outer pointer is in %gs).
+ *
+ *   long *__seg_gs *pp;   pp is ordinary memory. *pp is a `long *` object that
+ *                         lives in %gs. **pp is the long it points at.
+ *
+ * The GS base is set to `area`, so the value of `pp` is an offset into `area`
+ * where the segment pointer object sits. Each check compares the observed
+ * value with the same value read through ordinary memory. GCC 14.2 -O2 is the
+ * oracle (the output must match it line for line).
+ */
+#include <stdio.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#define ARCH_SET_GS 0x1001
+#define AREA 4096
+
+static unsigned char area[AREA] __attribute__((aligned(64)));
+static long target[8];
+static int failures;
+
+#define CHECK(cond, name)                 \
+    do {                                  \
+        if (cond) {                       \
+            printf("ok %s\n", name);      \
+        } else {                          \
+            printf("FAIL %s\n", name);    \
+            failures++;                   \
+        }                                 \
+    } while (0)
+
+/* Two levels: the first star's qualifier puts the pointer it builds in %gs. */
+static long *__seg_gs *pp;
+
+/* Three levels: the qualifier after star 1 puts the star-1 pointer in %gs, and
+ * the qualifier after star 2 puts the star-2 pointer in %gs. The object itself
+ * (star 3, adjacent to the name) is ordinary memory. */
+static long *__seg_gs *__seg_gs *ppp;
+
+__attribute__((noinline)) static long read_two(long *__seg_gs *q) { return **q; }
+__attribute__((noinline)) static void write_two(long *__seg_gs *q, long v) { **q = v; }
+__attribute__((noinline)) static long read_plus_one(void) { return **pp + 1; }
+
+int main(void) {
+    if (syscall(SYS_arch_prctl, ARCH_SET_GS, area) != 0) {
+        perror("arch_prctl");
+        return 2;
+    }
+    setvbuf(stdout, NULL, _IONBF, 0);
+
+    /* The segment object at GS:0x100 holds a generic pointer to target[2]. */
+    long **slot = (long **)(area + 0x100);
+    target[2] = 41;
+    *slot = &target[2];
+
+    pp = (long *__seg_gs *)0x100;
+    CHECK(**pp == 41, "two_level_read");
+    **pp = 42;
+    CHECK(target[2] == 42, "two_level_write");
+    CHECK(read_two(pp) == 42, "two_level_arg_read");
+    write_two(pp, 43);
+    CHECK(target[2] == 43, "two_level_arg_write");
+    CHECK(read_plus_one() == 44, "two_level_global_read");
+
+    /* Three levels. GS:0x140 is a star-2 object: it holds the GS offset of the
+     * star-1 object. GS:0x148 is that star-1 object: a generic pointer. */
+    *(unsigned long *)(area + 0x140) = 0x148;
+    *(long **)(area + 0x148) = &target[5];
+    target[5] = 77;
+    ppp = (long *__seg_gs *__seg_gs *)0x140;
+    CHECK(**ppp == &target[5], "three_level_pointer_value");
+    CHECK(***ppp == 77, "three_level_read");
+    ***ppp = 78;
+    CHECK(target[5] == 78, "three_level_write");
+
+    if (failures == 0) {
+        printf("PASSED (0 failures)\n");
+        return 0;
+    }
+    printf("FAILED (%d failure%s)\n", failures, failures == 1 ? "" : "s");
+    return 1;
+}
diff --git a/tests/regression/seg_gs_runtime/seg_gs_runtime.c b/tests/regression/seg_gs_runtime/seg_gs_runtime.c
new file mode 100644
index 00000000..0a4c5504
--- /dev/null
+++ b/tests/regression/seg_gs_runtime/seg_gs_runtime.c
@@ -0,0 +1,136 @@
+/* Runtime, self-checking contract for x86-64 named address space __seg_gs.
+ *
+ * The GS base register is pointed at `area`, so every access through a
+ * __seg_gs object or pointer is a real %gs-relative access. Each check
+ * compares the observed value with an expected value computed through
+ * ordinary (generic) memory, so the program does not depend on any other
+ * compiler to decide pass or fail.
+ *
+ * Covered:
+ *   indexed / pointer-arithmetic member access keeps %gs
+ *   whole-struct and vector copies to and from a segment object
+ *       (initializer, assignment, argument, return), including a 320-byte
+ *       object that takes the counted-loop copy path
+ *   typedef base with a pointer declarator keeps the pointer itself
+ *       in ordinary memory (only the pointee is %gs)
+ *   bitfield loads, stores, compound assignment and ++/-- through a
+ *       segment pointer, including a field that straddles a 64-bit unit
+ */
+#include <stdio.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#define ARCH_SET_GS 0x1001
+#define AREA 8192
+
+struct pair { long a, b; };          /* 16 B: packed-register/SSE class */
+struct tiny { int x, y; };           /* 8 B: single-register class */
+struct trio { long v[3]; };          /* 24 B: memory class */
+struct big  { long v[40]; };         /* 320 B: counted-loop copy path */
+struct ent  { long v[2]; long f; };  /* 24 B: indexed member access */
+struct bf   { unsigned a:3; unsigned b:13; int c:7; unsigned long d:40;
+              unsigned long e:30; };  /* e spans bits 63..92: crosses a unit */
+typedef struct pair PT;
+typedef long L;
+typedef long v2_t __attribute__((vector_size(16)));
+
+static unsigned char area[AREA] __attribute__((aligned(64)));
+static int failures;
+
+#define CHECK(cond, name) do { \
+    if (cond) printf("ok   %s\n", name); \
+    else { printf("FAIL %s\n", name); failures++; } \
+} while (0)
+
+/* Segment-relative pointers: the value is an offset from the GS base. */
+static struct pair __seg_gs *SP = (struct pair __seg_gs *)0;
+static struct pair __seg_gs *SP1 = (struct pair __seg_gs *)16;
+static struct tiny __seg_gs *ST = (struct tiny __seg_gs *)64;
+static struct trio __seg_gs *STR = (struct trio __seg_gs *)128;
+static struct big __seg_gs *SB = (struct big __seg_gs *)512;
+static v2_t __seg_gs *SV = (v2_t __seg_gs *)1024;
+static struct ent __seg_gs *GP = (struct ent __seg_gs *)2048;
+static PT __seg_gs *TB = (PT __seg_gs *)2400;   /* typedef pointer */
+static L __seg_gs *TA = (L __seg_gs *)2432;     /* typedef pointer */
+static struct bf __seg_gs *SBF = (struct bf __seg_gs *)3072;  /* bitfield */
+
+__attribute__((noinline)) static long take_pair(struct pair p) { return p.a * 1000 + p.b; }
+__attribute__((noinline)) static struct pair mk_pair(long a, long b) { struct pair p = { a, b }; return p; }
+__attribute__((noinline)) static struct pair ret_seg_pair(void) { return *SP; }
+__attribute__((noinline)) static struct tiny ret_seg_tiny(void) { return *ST; }
+__attribute__((noinline)) static struct big mk_big(long s) { struct big b; for (int i = 0; i < 40; i++) b.v[i] = s + i; return b; }
+
+int main(void) {
+    setvbuf(stdout, NULL, _IONBF, 0);
+    if (syscall(SYS_arch_prctl, ARCH_SET_GS, area) != 0) { perror("arch_prctl"); return 2; }
+    struct pair *gen_pair = (struct pair *)area;
+    struct tiny *gen_tiny = (struct tiny *)(area + 64);
+    struct trio *gen_trio = (struct trio *)(area + 128);
+    struct big *gen_big = (struct big *)(area + 512);
+    v2_t *gen_v = (v2_t *)(area + 1024);
+    struct ent *gen_ent = (struct ent *)(area + 2048);
+    struct pair *gen_td = (struct pair *)(area + 2400);
+    long *gen_ta = (long *)(area + 2432);
+    struct bf *gen_bf = (struct bf *)(area + 3072);
+
+    /* destination write, 16 B struct */
+    { struct pair t = mk_pair(11, 22); *SP = t; CHECK(gen_pair->a == 11 && gen_pair->b == 22, "struct_copy_to_seg_16"); }
+    /* source read by initializer, 16 B */
+    { gen_pair->a = 5; gen_pair->b = 6; struct pair t = *SP; CHECK(t.a == 5 && t.b == 6, "struct_init_from_seg_16"); }
+    /* struct assignment seg -> seg+16 */
+    { *SP1 = *SP; CHECK(gen_pair[1].a == 5 && gen_pair[1].b == 6, "struct_assign_seg_to_seg"); }
+    /* by-value argument from segment */
+    { long r = take_pair(*SP); CHECK(r == 5006, "struct_arg_from_seg"); }
+    /* return of a segment struct, and return into a segment object */
+    { struct pair r = ret_seg_pair(); CHECK(r.a == 5 && r.b == 6, "struct_ret_from_seg"); }
+    { *SP = mk_pair(7, 8); CHECK(gen_pair->a == 7 && gen_pair->b == 8, "struct_ret_to_seg"); }
+    /* 8 B struct, single-register path */
+    { gen_tiny->x = 3; gen_tiny->y = 4; struct tiny t = *ST; CHECK(t.x == 3 && t.y == 4, "tiny_init_from_seg");
+      struct tiny u = ret_seg_tiny(); CHECK(u.x == 3 && u.y == 4, "tiny_ret_from_seg");
+      t.x = 9; t.y = 10; *ST = t; CHECK(gen_tiny->x == 9 && gen_tiny->y == 10, "tiny_copy_to_seg"); }
+    /* 24 B memory-class struct */
+    { struct trio t = { { 1, 2, 3 } }; *STR = t; CHECK(gen_trio->v[0] == 1 && gen_trio->v[2] == 3, "trio_copy_to_seg");
+      struct trio u = *STR; CHECK(u.v[1] == 2, "trio_init_from_seg"); }
+    /* 320 B struct, counted-loop copy path (> 256 bytes) */
+    { struct big b = mk_big(100); *SB = b; int ok = 1;
+      for (int i = 0; i < 40; i++) ok &= gen_big->v[i] == 100 + i;
+      CHECK(ok, "big_copy_to_seg_loop");
+      struct big c = *SB; ok = 1;
+      for (int i = 0; i < 40; i++) ok &= c.v[i] == 100 + i;
+      CHECK(ok, "big_init_from_seg_loop"); }
+    /* vector object in a segment */
+    { v2_t t = { 7, 9 }; *SV = t; CHECK(gen_v[0][0] == 7 && gen_v[0][1] == 9, "vec_copy_to_seg");
+      v2_t u = *SV; CHECK(u[0] == 7 && u[1] == 9, "vec_init_from_seg"); }
+    /* indexed and pointer-arithmetic member access keeps %gs */
+    { GP[1].v[0] = 5; CHECK(gen_ent[1].v[0] == 5, "indexed_store_member_array");
+      (GP + 1)[0].f = 13; CHECK(gen_ent[1].f == 13, "ptr_arith_store_member");
+      gen_ent[1].f = 21; CHECK(GP[1].f == 21, "indexed_load_member");
+      CHECK((GP + 1)[0].f == 21, "ptr_arith_load_member");
+      GP[1].v[1] += 3; CHECK(gen_ent[1].v[1] == 3, "compound_indexed_member"); }
+    /* typedef base with a pointer declarator */
+    { gen_td->b = 42; CHECK(TB->b == 42, "typedef_struct_ptr_load");
+      gen_ta[0] = 77; CHECK(*TA == 77, "typedef_scalar_ptr_load"); }
+
+    /* bitfields through a segment pointer. Every expected value is read
+       back through the generic view of the same bytes (gen_bf). */
+    { SBF->a = 5; SBF->b = 0x1abc; SBF->c = -9; SBF->d = 0xabcdef1234UL; SBF->e = 0x2badcafeUL;
+      CHECK(gen_bf->a == 5 && gen_bf->b == 0x1abc && gen_bf->c == -9
+            && gen_bf->d == 0xabcdef1234UL && gen_bf->e == 0x2badcafeUL, "bitfield_store_seg");
+      CHECK(SBF->a == 5 && SBF->b == 0x1abc && SBF->c == -9
+            && SBF->d == 0xabcdef1234UL && SBF->e == 0x2badcafeUL, "bitfield_load_seg");
+      gen_bf->e = 0x0badf00dUL; CHECK(SBF->e == 0x0badf00dUL && SBF->d == 0xabcdef1234UL, "straddle_unit_load");
+      SBF->e = 0x2badcafeUL; CHECK(gen_bf->d == 0xabcdef1234UL && gen_bf->c == -9, "straddle_unit_store_neighbours");
+      SBF->b += 7; CHECK(gen_bf->b == 0x1ac3 && gen_bf->a == 5, "compound_add_seg");
+      SBF->c--; CHECK(gen_bf->c == -10 && gen_bf->b == 0x1ac3, "postdec_seg");
+      unsigned long old = SBF->e++; CHECK(old == 0x2badcafeUL && gen_bf->e == 0x2badcaffUL, "postinc_straddle_seg");
+      unsigned long nw = ++SBF->d; CHECK(nw == 0xabcdef1235UL && gen_bf->d == 0xabcdef1235UL, "preinc_seg");
+      SBF->a = 2; SBF->a |= 1; CHECK(gen_bf->a == 3, "bitor_seg");
+      CHECK((SBF)->b == 0x1ac3 && (*SBF).c == -10, "paren_and_deref_load");
+      /* Generic object: the initializer path must still store at the right bits. */
+      struct bf g = { 1, 2, -3, 4, 5 };
+      CHECK(g.a == 1 && g.b == 2 && g.c == -3 && g.d == 4 && g.e == 5, "generic_init_control");
+    }
+
+    printf("%s (%d failure%s)\n", failures ? "FAILED" : "PASSED", failures, failures == 1 ? "" : "s");
+    return failures ? 1 : 0;
+}
diff --git a/tests/regression/seg_gs_runtime/seg_gs_vector_loop.c b/tests/regression/seg_gs_runtime/seg_gs_vector_loop.c
new file mode 100644
index 00000000..e65a8f35
--- /dev/null
+++ b/tests/regression/seg_gs_runtime/seg_gs_vector_loop.c
@@ -0,0 +1,115 @@
+/* Runtime contract for __seg_gs array loops that an optimizer may vectorize.
+ *
+ * A loop over a segment array must keep every access %gs-relative at every
+ * optimization level. The vectorizer once rebuilt the reduction over a
+ * __seg_gs array with generic vector loads, so -O3 read the wrong memory and
+ * returned a wrong sum. Each loop here is checked against the same arithmetic
+ * over a generic array, and the segment results are read back through the
+ * mirror (&object + GS_DISP), which a correct %gs store writes.
+ */
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/mman.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#define ARCH_SET_GS 0x1001
+#define GS_DISP ((uintptr_t)1 << 32)
+#define MIR(g) ((void *)((uintptr_t)(g) + GS_DISP))
+
+#define N 256
+
+long __seg_gs vec_a[N];
+long __seg_gs vec_b[N];
+extern long vec_a_g[N] __asm__("vec_a");
+extern long vec_b_g[N] __asm__("vec_b");
+
+static int failures;
+
+#define CHECK(cond, name)                                  \
+    do {                                                   \
+        if (cond) printf("ok   %s\n", name);               \
+        else { printf("FAIL %s\n", name); failures++; }    \
+    } while (0)
+
+static void map_mirror(const void *g, size_t n) {
+    uintptr_t lo = (uintptr_t)g + GS_DISP;
+    uintptr_t end = lo + n;
+    for (uintptr_t page = lo & ~(uintptr_t)4095; page < end; page += 4096) {
+        void *m = mmap((void *)page, 4096, PROT_READ | PROT_WRITE,
+                       MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+        if (m == MAP_FAILED && errno != EEXIST) {
+            perror("mmap");
+            _Exit(2);
+        }
+    }
+}
+
+/* Reductions, maps and dot products over segment arrays. Kept out of line so
+ * the loops are optimized as loops, not folded into the caller. */
+__attribute__((noinline)) static long sum_seg(void) {
+    long s = 0;
+    for (int i = 0; i < N; i++) s += vec_a[i];
+    return s;
+}
+
+__attribute__((noinline)) static long dot_seg(void) {
+    long s = 0;
+    for (int i = 0; i < N; i++) s += vec_a[i] * vec_b[i];
+    return s;
+}
+
+__attribute__((noinline)) static void map_seg(void) {
+    for (int i = 0; i < N; i++) vec_b[i] = vec_a[i] * 2 + 1;
+}
+
+__attribute__((noinline)) static void fill_seg(long k) {
+    for (int i = 0; i < N; i++) vec_a[i] = (long)i * 3 + k;
+}
+
+static long gen_a[N], gen_b[N];
+
+int main(void) {
+    map_mirror(vec_a_g, sizeof(long) * N);
+    map_mirror(vec_b_g, sizeof(long) * N);
+    if (syscall(SYS_arch_prctl, ARCH_SET_GS, (void *)GS_DISP) != 0) {
+        perror("arch_prctl(ARCH_SET_GS)");
+        return 2;
+    }
+
+    /* Seed through ordinary pointers at the mirror. */
+    long *ma = (long *)MIR(vec_a_g);
+    long *mb = (long *)MIR(vec_b_g);
+    for (int i = 0; i < N; i++) {
+        ma[i] = (long)i * 7 + 1;
+        mb[i] = 0;
+        gen_a[i] = (long)i * 7 + 1;
+        gen_b[i] = 0;
+    }
+
+    long want_sum = 0;
+    for (int i = 0; i < N; i++) want_sum += gen_a[i];
+    CHECK(sum_seg() == want_sum, "sum_reduction");
+
+    long want_dot = 0;
+    for (int i = 0; i < N; i++) {
+        gen_b[i] = gen_a[i] * 2 + 1;
+        want_dot += gen_a[i] * gen_b[i];
+    }
+    map_seg();
+    int map_ok = 1;
+    for (int i = 0; i < N; i++) map_ok &= mb[i] == gen_b[i];
+    CHECK(map_ok, "map_store");
+    CHECK(dot_seg() == want_dot, "dot_product");
+
+    fill_seg(5);
+    int fill_ok = 1;
+    for (int i = 0; i < N; i++) fill_ok &= ma[i] == (long)i * 3 + 5;
+    CHECK(fill_ok, "fill_store");
+
+    printf("%s (%d failure%s)\n", failures ? "FAILED" : "PASSED", failures,
+           failures == 1 ? "" : "s");
+    return failures ? 1 : 0;
+}
