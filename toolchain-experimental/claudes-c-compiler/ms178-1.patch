+        assert_eq!(place_edge_copy_blocks(&mut func), 1);
+        let labels: Vec<u32> = func.blocks.iter().map(|b| b.label.0).collect();
+        assert_eq!(labels, vec![0, 1, 4, 2, 3]);
+        assert!(matches!(
