-            }
-            Instruction::ParamRef { param_idx, .. } => {
-                let noalias = func.params.get(*param_idx).is_some_and(|p| p.noalias);
-                return Some(ProvenObjectRoot::Param {
-                    index: *param_idx,
-                    noalias,
-                });
-            }
-            Instruction::GetElementPtr { base, .. } => cur = *base,
-            Instruction::Copy {
-                src: Operand::Value(src),
-                ..
-            }
-            | Instruction::Cast {
