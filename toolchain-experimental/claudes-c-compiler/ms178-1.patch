+/// these sweeps alike).
+fn retire_dead_pure_writes(store: &LineStore, infos: &mut [LineInfo]) -> bool {
+    let mut any = false;
+    while dead_writes::eliminate_dead_pure_writes(store, infos) {
+        any = true;
+    }
+    any
