+    let scan_limit = (start + 64).min(len);
+    let mask = 1u16 << reg;
+    let mut scan = start;
+    while scan < scan_limit {
+        if infos[scan].is_nop() {
+            scan += 1;
+            continue;
+        }
+        match infos[scan].kind {
+            LineKind::Push { reg: r } => {
+                if r == reg {
+                    return false;
+                }
+                scan += 1;
+                continue;
+            }
+            LineKind::Pop { reg: r } => {
+                if r == reg {
+                    return true;
+                }
+                scan += 1;
+                continue;
+            }
+            _ => {}
