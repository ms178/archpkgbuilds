+                self.state.emit("    andl $0x8000, %ecx");
+                self.state.emit("    orl %ecx, %eax");
+            }
+        }
+        emit!(self.state, "    movw %ax, {}", dsr8);
+        self.state.f128_direct_slots.insert(d.0);
+        self.state.reg_cache.invalidate_all();
+    }
 }
