+        }) else {
+            continue;
+        };
+        if infos[d].pinned || mentions(d) != Some(1) || d <= a {
+            continue;
+        }
+        let Some(p) = (lo..d).rev().find(|&k| !byteless(store, infos, k)) else {
+            continue;
+        };
+        let prev_mn = infos[p]
+            .trimmed(store.get(p))
+            .split_whitespace()
+            .next()
+            .unwrap_or("");
+        if infos[p].pinned
