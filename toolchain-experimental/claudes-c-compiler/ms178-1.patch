+        b"insb" | b"insw" | b"insl" => (RDX | RDI, RDI),
+        b"outsb" | b"outsw" | b"outsl" => (RDX | RSI, RSI),
+        b"in" | b"inb" | b"inw" | b"inl" => (RAX | RDX, RAX),
