+  printf("u %zu %d %d %d %d\n", sizeof am, am[0], am[1], am[2], am[3]);
+  v8s s = {-1, 5, 7}, t = {0, 5, -7};
+  __auto_type sm = s >= t;
+  printf("s %zu %d %d %d\n", sizeof sm, sm[0], sm[1], sm[2]);
+  v4i i = {1, -2, 3, 4};
+  pf("ilt", i < 2); pf("not", ~(i == i)); pf("neg", -(f < g));
+  v4f sel = (v4f)((v4i)f & (f > 0));
