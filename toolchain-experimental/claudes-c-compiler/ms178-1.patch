+            header: 1,
+            body: [1, 2].into_iter().collect(),
+        };
+        let iv = BasicIV {
+            phi_dest: Value(0),
+            ty: IrType::U32,
+            init: Operand::Const(IrConst::I32(0)),
+            step: 1,
