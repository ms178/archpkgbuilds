+    // Both registers are consumed at the access with no IR operand.
+    if cg.get_phys_reg_for_value(ro.off.0).is_none() {
+        return false;
+    }
+    if cg.get_phys_reg_for_value(info.index.0).is_none() {
+        return false;
+    }
