+/// callers that need a MAY model must add their own conservative fallback
+/// (that is what `load_op_fuse::may_write_families` layers on top).
+fn classify_implicit_operands(b: &[u8]) -> (u16, u16) {
+    const RAX: u16 = 1 << 0;
+    const RCX: u16 = 1 << 1;
+    const RDX: u16 = 1 << 2;
+    const RBX: u16 = 1 << 3;
+    const RSP: u16 = 1 << 4;
+    const RBP: u16 = 1 << 5;
+    const RSI: u16 = 1 << 6;
+    const RDI: u16 = 1 << 7;
+    const R8: u16 = 1 << 8;
+    const R9: u16 = 1 << 9;
+    const R10: u16 = 1 << 10;
+    const R11: u16 = 1 << 11;
