+#!/usr/bin/env bash
+case ${1-} in
+  -dumpmachine) echo x86_64-test-linux-gnu ;;
+  --version) printf '%s\n' "${FAKE_VERSION-output}" ;;
+  *) exit 0 ;;
+esac
+EOF
+    chmod +x "$1"
