+            body
+        );
+        let marked: FxHashSet<String> = std::iter::once("f".to_string()).collect();
+        let none = FxHashMap::default();
+        let none_ind = FxHashMap::default();
+        synthesize(
+            &asm,
+            CfiArch::X86_64,
