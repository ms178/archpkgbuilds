+    // it to accept costs one line and removes a whole class of quiet
+    // degradation.
+    let t = t.trim();
     let base = t.strip_prefix('v').unwrap_or(t);
     let mnem = base
         .split(|c: char| c == ' ' || c == '\t')
@@ -2435,7 +2454,10 @@ fn strip_width_suffix<'a>(t: &'a str, base: &str) -> Option<&'a str> {
