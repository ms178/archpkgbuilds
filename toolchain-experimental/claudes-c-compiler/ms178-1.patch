+/// fault.
+pub(super) fn prefetch_prfop(payload: u8) -> &'static str {
+    const PFTYPE: [[&str; 4]; 2] = [
+        ["pldl1strm", "pldl3keep", "pldl2keep", "pldl1keep"],
