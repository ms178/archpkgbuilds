+        .toplevel_asm
+        .iter()
+        .flat_map(|a| a.split(|c: char| !is_ident(c)))
+        .filter(|t| !t.is_empty())
+        .collect();
+    out.extend(tokens.iter().map(|t| (*t).to_string()));
+    out.extend(
+        module
+            .asm_labels
+            .iter()
+            .filter(|(_, label)| tokens.contains(label.as_str()))
+            .map(|(name, _)| name.clone()),
+    );
+    out
 }
 
