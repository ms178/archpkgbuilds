diff --git a/tests/regression/ext_vector_abi/i386_probe/caller.c b/tests/regression/ext_vector_abi/i386_probe/caller.c
new file mode 100644
index 000000000..02a758cd5
--- /dev/null
+++ b/tests/regression/ext_vector_abi/i386_probe/caller.c
@@ -0,0 +1,5 @@
+typedef ELEM T __attribute__((ext_vector_type(LANES)));
+T getx(void);
+T sinkr_v __asm__("sinkr");
