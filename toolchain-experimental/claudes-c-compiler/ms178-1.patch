+void andor_i32x4(const uint32_t *restrict a, const uint32_t *restrict b,
+                 const uint32_t *restrict c, uint32_t *restrict d) {
+  d[0] = (a[0] & b[0]) | c[0]; d[1] = (a[1] & b[1]) | c[1];
+  d[2] = (a[2] & b[2]) | c[2]; d[3] = (a[3] & b[3]) | c[3];
+}
