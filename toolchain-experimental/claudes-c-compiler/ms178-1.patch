+# RA-23/Tier-2: production coloring is safe and never enlarges huft's frame.
+# Newer register allocation can remove every colorable multi-block value, in
+# which case the enabled and kill-switch frames are legitimately equal.
 set -euo pipefail
-CCC=${CCC:-./target/release/lccc}; root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd); t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
+CCC=${CCC:-./target/release/lccc}
+root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
+t=$(mktemp -d)
