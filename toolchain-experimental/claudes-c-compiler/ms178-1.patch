diff --git a/scripts/measure_verify_ir_cost.py b/scripts/measure_verify_ir_cost.py
new file mode 100755
index 00000000..85b827d9
--- /dev/null
+++ b/scripts/measure_verify_ir_cost.py
@@ -0,0 +1,113 @@
+#!/usr/bin/env python3
+"""Measure what the IR verifier costs and whether the corpus passes it (T6).
+
+For every C file under the given roots, compile at each requested -O level
+twice with the same compiler -- once plainly, once with
+``CCC_VERIFY_IR=abort`` (every pass boundary verified, first violation fatal)
+-- and record:
+
+* the compile-time ratio (verified wall time / plain wall time), summed over
+  the corpus and as a per-file median, measured sequentially so the two
+  timings of one file run back to back;
+* every file where the verified compile fails, with the first violation line.
+
+A non-zero exit from the verified leg is a verifier finding (a pass produced
+malformed IR), not a harness issue, so the script reports it as a violation
+rather than hiding it.  ``--json`` writes the full table for the follow-up
+document.
+
+Sequential by design: on the two-core CI host, parallel timing measures
+contention, not the verifier.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import statistics
+import subprocess
+import sys
+import tempfile
+import time
+from pathlib import Path
+
+
+def timed(cmd: list[str], env: dict[str, str], timeout: float) -> tuple[float, int, str]:
+    start = time.perf_counter()
+    try:
+        proc = subprocess.run(
+            cmd, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
+            timeout=timeout, check=False, text=True, errors="replace",
+        )
+        rc, err = proc.returncode, proc.stderr
+    except subprocess.TimeoutExpired as exc:
+        rc = 124
+        err = (exc.stderr or b"").decode(errors="replace") if isinstance(exc.stderr, bytes) else (exc.stderr or "")
+    return time.perf_counter() - start, rc, err
+
+
+def first_violation(stderr: str) -> str:
+    for line in stderr.splitlines():
+        if "IR verification failed" in line or "violation" in line.lower() or "dominat" in line:
+            return line.strip()[:300]
+    return stderr.strip().splitlines()[-1][:300] if stderr.strip() else "(no stderr)"
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
+    ap.add_argument("roots", nargs="+", type=Path)
+    ap.add_argument("--ccc", default="target/fastbuild/lccc")
+    ap.add_argument("--levels", default="-O2", help="comma list, e.g. -O1,-O2")
+    ap.add_argument("--timeout", type=float, default=60.0)
+    ap.add_argument("--limit", type=int, default=0, help="0 = all files")
+    ap.add_argument("--json", type=Path)
+    args = ap.parse_args()
+
+    files: list[Path] = []
+    for root in args.roots:
+        files += sorted(p for p in root.rglob("*.c") if p.is_file())
+    if args.limit:
+        files = files[: args.limit]
+    levels = [lvl.strip() for lvl in args.levels.split(",") if lvl.strip()]
+
+    plain_env = dict(os.environ)
+    plain_env.pop("CCC_VERIFY_IR", None)
+    verify_env = dict(plain_env, CCC_VERIFY_IR="abort")
+
+    rows: list[dict] = []
+    with tempfile.TemporaryDirectory(prefix="verify-cost-") as tmp:
+        out = Path(tmp) / "o.o"
+        for src in files:
+            for lvl in levels:
+                base = [args.ccc, lvl, "-c", str(src), "-o", str(out)]
+                t_plain, rc_plain, _ = timed(base, plain_env, args.timeout)
+                t_ver, rc_ver, err_ver = timed(base, verify_env, args.timeout)
+                rows.append({
+                    "file": str(src), "level": lvl,
+                    "plain_s": round(t_plain, 4), "plain_rc": rc_plain,
+                    "verify_s": round(t_ver, 4), "verify_rc": rc_ver,
+                    "violation": None if rc_ver == 0 else first_violation(err_ver),
+                })
+
+    ok = [r for r in rows if r["plain_rc"] == 0 and r["verify_rc"] == 0]
+    plain_total = sum(r["plain_s"] for r in ok)
+    verify_total = sum(r["verify_s"] for r in ok)
+    ratios = [r["verify_s"] / r["plain_s"] for r in ok if r["plain_s"] > 0]
+    violations = [r for r in rows if r["verify_rc"] != 0 and r["plain_rc"] == 0]
+    print(f"files={len(files)} levels={levels} compared={len(ok)}")
+    if ok:
+        print(f"total plain={plain_total:.2f}s verified={verify_total:.2f}s "
+              f"ratio={verify_total / plain_total:.3f}")
+        print(f"per-file ratio median={statistics.median(ratios):.3f} "
+              f"p90={sorted(ratios)[int(0.9 * (len(ratios) - 1))]:.3f} "
+              f"max={max(ratios):.3f}")
+    print(f"verifier violations (plain ok, verified fails): {len(violations)}")
+    for r in violations[:20]:
+        print(f"  {r['file']} {r['level']}: {r['violation']}")
+    if args.json:
+        args.json.write_text(json.dumps({"rows": rows}, indent=1) + "\n")
+    return 1 if violations else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/src/ir/analysis.rs b/src/ir/analysis.rs
index 088c8f4d..840e5ccf 100644
--- a/src/ir/analysis.rs
+++ b/src/ir/analysis.rs
@@ -622,6 +622,125 @@ mod dominator_tests {
             assert_eq!(snca, chk, "succs = {succs:?}");
         }
     }
+
+    /// Ground truth that shares no code with either production algorithm: the
+    /// textbook set equations `Dom(entry) = {entry}` and
+    /// `Dom(n) = {n} ∪ ⋂ Dom(p)` over reachable predecessors, iterated to a
+    /// fixed point. The immediate dominator of `n` is its strict dominator with
+    /// the largest dominator set, because strict dominators form a chain.
+    /// Unreachable blocks map to `usize::MAX`, the convention of `compute_dominators`.
+    fn naive_idom(succs: &[Vec<usize>]) -> Vec<usize> {
+        const UNREACHABLE: usize = usize::MAX;
+        let n = succs.len();
+        let preds = preds_of(succs);
+        let mut reach = vec![false; n];
+        let mut stack = vec![0usize];
+        reach[0] = true;
+        while let Some(b) = stack.pop() {
+            for &s in &succs[b] {
+                if !reach[s] {
+                    reach[s] = true;
+                    stack.push(s);
+                }
+            }
+        }
+        // dom[b][d] == true iff d dominates b.
+        let mut dom = vec![vec![true; n]; n];
+        for (row, &r) in dom.iter_mut().zip(&reach) {
+            if !r {
+                row.fill(false);
+            }
+        }
+        dom[0].fill(false);
+        dom[0][0] = true;
+        let mut changed = true;
+        while changed {
+            changed = false;
+            for b in (1..n).filter(|&b| reach[b]) {
+                let mut next = vec![true; n];
+                for &p in preds[b].iter().filter(|&&p| reach[p]) {
+                    for (x, &y) in next.iter_mut().zip(&dom[p]) {
+                        *x &= y;
+                    }
+                }
+                next[b] = true;
+                if next != dom[b] {
+                    dom[b] = next;
+                    changed = true;
+                }
+            }
+        }
+        let mut idom = vec![UNREACHABLE; n];
+        for (b, &r) in reach.iter().enumerate() {
+            if !r {
+                continue;
+            }
+            idom[b] = if b == 0 {
+                0
+            } else {
+                (0..n)
+                    .filter(|&d| d != b && dom[b][d])
+                    .max_by_key(|&d| dom[d].iter().filter(|&&x| x).count())
+                    .expect("a reachable non-entry block has the entry as a strict dominator")
+            };
+        }
+        idom
+    }
+
+    /// Validates the oracle itself on the textbook shapes before it is trusted.
+    #[test]
+    fn set_equation_oracle_matches_textbook_shapes() {
+        const U: usize = usize::MAX;
+        assert_eq!(
+            naive_idom(&[vec![1, 2], vec![3], vec![3], vec![], vec![3]]),
+            vec![0, 0, 0, 0, U]
+        );
+        // Irreducible loop entered at both 1 and 2: neither entry dominates the other.
+        assert_eq!(
+            naive_idom(&[vec![1, 2], vec![2], vec![1, 3], vec![]]),
+            vec![0, 0, 0, 2]
+        );
+        assert_eq!(naive_idom(&[vec![0]]), vec![0]);
+    }
+
+    /// Third, independent oracle on random CFGs with back edges, self loops,
+    /// unreachable islands and parallel edges. SNCA and CHK can agree with each
+    /// other while sharing a convention bug (both consume the same
+    /// predecessor/reachability view), so both must also match the set equations.
+    #[test]
+    fn matches_set_equation_ground_truth_on_random_cfgs() {
+        let mut state = 0xD1B5_4A32_D192_ED03u64;
+        let mut rnd = |m: usize| -> usize {
+            state ^= state << 13;
+            state ^= state >> 7;
+            state ^= state << 17;
+            (state % m as u64) as usize
+        };
+        for _ in 0..1500 {
+            let n = 1 + rnd(48);
+            let mut succs = vec![Vec::new(); n];
+            for (b, row) in succs.iter_mut().enumerate() {
+                for _ in 0..rnd(4) {
+                    let t = match rnd(4) {
+                        0 => rnd(n),
+                        1 => b.saturating_sub(rnd(3)),
+                        _ => (b + 1 + rnd(4)).min(n - 1),
+                    };
+                    row.push(t);
+                }
+            }
+            let expected = naive_idom(&succs);
+            let (snca, chk) = both(&succs);
+            assert_eq!(
+                snca, expected,
+                "SNCA disagrees with set equations: succs = {succs:?}"
+            );
+            assert_eq!(
+                chk, expected,
+                "CHK disagrees with set equations: succs = {succs:?}"
+            );
+        }
+    }
 }
 
