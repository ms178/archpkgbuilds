+  d[0] = a[i] + 1; d[1] = a[j] + 1; d[2] = a[k] + 1; d[3] = a[l] + 1;
+}
+void bc_mul(const float *restrict a, float s, float *restrict d) {
+  for (int i = 0; i < 4; i++) d[i] = a[i] * s;
+}
