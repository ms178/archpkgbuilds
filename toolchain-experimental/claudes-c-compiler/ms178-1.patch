+impl<'a> ExecExports<'a> {
+    /// `None` when the executable exports nothing.
+    pub(super) fn new(
+        export_dynamic: bool,
+        dso_names: &'a crate::common::fx_hash::FxHashSet<String>,
+        version_script_path: Option<&str>,
+    ) -> Option<Self> {
