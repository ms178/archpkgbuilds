diff --git a/tests/benchmark/programs/adler32_do8_hot.c b/tests/benchmark/programs/adler32_do8_hot.c
new file mode 100644
index 00000000..c9a7debe
--- /dev/null
+++ b/tests/benchmark/programs/adler32_do8_hot.c
@@ -0,0 +1,35 @@
+/* Distilled zlib-ng Adler-32 DO8 shape — Godbolt inner-loop kernel.
+ *
+ * Exit 0 on the known answer; a non-zero checksum used as the process
+ * status is what turned these files into a red regression-corpus gate.
+ */
+#include <stdio.h>
+
+unsigned adler32_len(unsigned sum1, const unsigned char *buf, unsigned long len, unsigned sum2) {
+  while (len >= 8) {
+    sum1 += buf[0]; sum2 += sum1;
+    sum1 += buf[1]; sum2 += sum1;
+    sum1 += buf[2]; sum2 += sum1;
+    sum1 += buf[3]; sum2 += sum1;
+    sum1 += buf[4]; sum2 += sum1;
+    sum1 += buf[5]; sum2 += sum1;
+    sum1 += buf[6]; sum2 += sum1;
+    sum1 += buf[7]; sum2 += sum1;
+    buf += 8; len -= 8;
+  }
+  while (len) { --len; sum1 += *buf++; sum2 += sum1; }
+  sum1 %= 65521u; sum2 %= 65521u;
+  return sum1 | (sum2 << 16);
+}
+
+int main(void) {
+  unsigned char buf[64];
+  unsigned i, c;
+  for (i = 0; i < 64; i++)
+    buf[i] = (unsigned char)(i + 1);
+  c = adler32_len(1, buf, 64, 0);
+  if (c != 0xb3000821U)
+    return 2;
+  printf("%08x\n", c);
+  return 0;
+}
diff --git a/tests/benchmark/programs/crc32_nibble_hot.c b/tests/benchmark/programs/crc32_nibble_hot.c
new file mode 100644
index 00000000..d74f1b4b
--- /dev/null
+++ b/tests/benchmark/programs/crc32_nibble_hot.c
@@ -0,0 +1,32 @@
+/* Distilled GNU gzip crc32 scalar table update — Godbolt inner-loop kernel.
+ *
+ * The regression corpus glob includes tests/benchmark/programs and fails
+ * any main that returns a non-zero checksum. Print the digest and abort
+ * only on a known-answer mismatch, matching gzip_crc32.c.
+ */
+#include <stdio.h>
+
+unsigned gzip_crc32_update(unsigned crc, const unsigned char *buf, unsigned long len) {
+  static const unsigned table[16] = {
+    0x00000000, 0x1db71064, 0x3b6e20c8, 0x26d930ac,
+    0x76dc4190, 0x6b6b51f4, 0x4db26158, 0x5005713c,
+    0xedb88320, 0xf00f9344, 0xd6d6a3e8, 0xcb61b38c,
+    0x9b64c2b0, 0x86d3d2d4, 0xa00ae278, 0xbdbdf21c
+  };
+  unsigned long n;
+  for (n = 0; n < len; n++)
+    crc = table[(crc ^ buf[n]) & 15u] ^ (crc >> 4);
+  return crc;
+}
+
+int main(void) {
+  unsigned char buf[64];
+  unsigned i, c;
+  for (i = 0; i < 64; i++)
+    buf[i] = (unsigned char)i;
+  c = gzip_crc32_update(0, buf, 64);
+  if (c != 0x903e9128U)
+    return 2;
+  printf("%08x\n", c);
+  return 0;
+}
