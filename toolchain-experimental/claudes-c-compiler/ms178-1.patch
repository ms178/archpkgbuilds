+    match ops.first() {
+        Some(Operand::Register(r)) => {
+            let n = r.name.to_ascii_lowercase();
+            matches!(
+                n.as_str(),
+                "eax" | "ebx" | "ecx" | "edx" | "esi" | "edi" | "ebp" | "esp"
+            )
+        }
+        _ => false,
+    }
