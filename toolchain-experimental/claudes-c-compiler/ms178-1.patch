diff --git a/tests/regression/elf_probe.py b/tests/regression/elf_probe.py
new file mode 100644
index 000000000..411924d6e
--- /dev/null
+++ b/tests/regression/elf_probe.py
@@ -0,0 +1,95 @@
+"""Minimal little-endian ELF32/ELF64 relocatable reader for the regression gates.
+
+Only what the assembler-parity gates compare: section headers (type, size,
+alignment, contents), the symbol table and relocations.  `struct` only, so the gates need
+no binutils.
+"""
+
+import struct
+
+SHT_SYMTAB, SHT_RELA, SHT_NOBITS, SHT_REL = 2, 4, 8, 9
+SHN_UNDEF, SHN_ABS, SHN_COMMON = 0, 0xFFF1, 0xFFF2
+BIND = {0: "LOCAL", 1: "GLOBAL", 2: "WEAK"}
+VIS = {0: "DEFAULT", 1: "INTERNAL", 2: "HIDDEN", 3: "PROTECTED"}
+TYPE = {0: "NOTYPE", 1: "OBJECT", 2: "FUNC", 3: "SECTION", 4: "FILE", 6: "TLS", 10: "IFUNC"}
+
+
+class Elf:
+    """`sections`: name -> (sh_type, bytes or None for NOBITS, sh_size,
+    sh_addralign), in header order.  `symbols`: list of
+    (name, bind, type, section name | "UND" | "ABS" | "COM", value, size,
+    visibility).  `relocs`: list of (target section name, offset, type,
+    symbol index into `symbols` or None, addend or None for SHT_REL, where
+    the addend is implicit in the target bytes).  `machine`: e_machine."""
+
+    def __init__(self, path):
+        with open(path, "rb") as f:
+            d = f.read()
+        is64 = d[4] == 2
+        self.machine, = struct.unpack_from("<H", d, 0x12)
+        if is64:
+            shoff, = struct.unpack_from("<Q", d, 0x28)
+            shentsize, shnum, shstrndx = struct.unpack_from("<HHH", d, 0x3A)
+        else:
+            shoff, = struct.unpack_from("<I", d, 0x20)
+            shentsize, shnum, shstrndx = struct.unpack_from("<HHH", d, 0x2E)
+
+        def hdr(i):
+            o = shoff + i * shentsize
+            if is64:
+                name, typ, _flags, _addr, off, size, link, _info, align, entsize = \
+                    struct.unpack_from("<IIQQQQIIQQ", d, o)
+            else:
+                name, typ, _flags, _addr, off, size, link, _info, align, entsize = \
+                    struct.unpack_from("<IIIIIIIIII", d, o)
+            return name, typ, off, size, link, align, entsize
+
+        def cstr(base, off):
+            return d[base + off:d.index(b"\0", base + off)].decode()
+
+        headers = [hdr(i) for i in range(shnum)]
+        shstr = headers[shstrndx][2]
+        names = [cstr(shstr, h[0]) for h in headers]
+        self.sections = {}
+        for i in range(1, shnum):
+            _, t, off, size, _, align, _ = headers[i]
+            self.sections[names[i]] = (t, None if t == SHT_NOBITS else d[off:off + size],
+                                       size, align)
+        self.symbols = []
+        for _, t, off, size, link, _, entsize in headers:
+            if t != SHT_SYMTAB:
+                continue
+            strbase = headers[link][2]
+            for k in range(1, size // entsize):
+                o = off + k * entsize
+                if is64:
+                    nm, info, other, shndx, value, sz = struct.unpack_from("<IBBHQQ", d, o)
+                else:
+                    nm, value, sz, info, other, shndx = struct.unpack_from("<IIIBBH", d, o)
+                if shndx == SHN_UNDEF:
+                    sec = "UND"
+                elif shndx == SHN_ABS:
+                    sec = "ABS"
+                elif shndx == SHN_COMMON:
+                    sec = "COM"
+                else:
+                    sec = names[shndx]
+                self.symbols.append((cstr(strbase, nm), BIND.get(info >> 4, str(info >> 4)),
+                                     TYPE.get(info & 15, str(info & 15)), sec, value, sz,
+                                     VIS[other & 3]))
+        self.relocs = []
+        for i, (_, t, off, size, _link, _, entsize) in enumerate(headers):
+            if t not in (SHT_RELA, SHT_REL):
+                continue
+            target = names[i][len(".rela" if t == SHT_RELA else ".rel"):]
+            for k in range(size // entsize):
+                o = off + k * entsize
+                if is64:
+                    r_off, info = struct.unpack_from("<QQ", d, o)
+                    sym, typ = info >> 32, info & 0xFFFFFFFF
+                    add = struct.unpack_from("<q", d, o + 16)[0] if t == SHT_RELA else None
+                else:
+                    r_off, info = struct.unpack_from("<II", d, o)
+                    sym, typ = info >> 8, info & 0xFF
+                    add = struct.unpack_from("<i", d, o + 8)[0] if t == SHT_RELA else None
+                self.relocs.append((target, r_off, typ, sym - 1 if sym else None, add))
diff --git a/tests/regression/enum_type_semantics.c b/tests/regression/enum_type_semantics.c
new file mode 100644
index 000000000..81453d42c
--- /dev/null
+++ b/tests/regression/enum_type_semantics.c
@@ -0,0 +1,109 @@
+/*
+ * Enum and enumerator types, as GCC 16.2 and Clang 23.1.3 both define them
+ * (measured identically under -std=gnu17, gnu23 and c11 on x86-64, i686 and
+ * AArch64):
+ *  - an enum's compatible type is `unsigned int` without negative
+ *    enumerators and `int` with one; 4 bytes only when ONE 32-bit type holds
+ *    every value, else `long`/`unsigned long` (LP64) or `long long`/
+ *    `unsigned long long` (ILP32);
+ *  - after completion, every enumerator is `int` when all of them fit in
+ *    `int`, otherwise every enumerator has the enum's compatible type;
+ *  - an enum bit-field keeps the enum's signedness;
+ *  - an enum type behaves as its compatible type in `_Generic`, promotions,
+ *    `sizeof`, `_Alignof`/`__alignof__` (i386: 4/8 for an 8-byte enum) and
+ *    VLA sizing. Each fact is asserted statically AND checked at run time,
+ *    because sema and lowering once answered these with different rules.
+ */
+#include <stdio.h>
+
+#define TY(x) _Generic((x), int: 1, unsigned: 2, long: 3, unsigned long: 4, \
+                       long long: 5, unsigned long long: 6, signed char: 7, \
+                       unsigned char: 8, default: 0)
+#if __SIZEOF_LONG__ == 8
+#define S64 3
+#define U64 4
+#else
+#define S64 5
+#define U64 6
+#endif
+
+enum Small { SA, SB };
+enum Neg { NA = -1, NB };
+enum Big { BG = 0x80000000u };
+enum Huge { HG = 0x100000000LL, HG2 };
+enum Mix { MA = 0, MB = 0x100000000LL };
+enum MixU { UA = 1, UB = 0x80000000u };
+enum MixN { XA = -1, XB = 0x80000000u };
+
+_Static_assert(TY(SA) == 1 && TY(NA) == 1, "int enumerators");
+_Static_assert(TY(BG) == 2 && TY(UA) == 2 && TY(UB) == 2, "unsigned int enum constants");
+_Static_assert(TY(HG) == U64 && TY(MA) == U64 && TY(MB) == U64, "unsigned 64-bit enum constants");
+_Static_assert(TY(XA) == S64 && TY(XB) == S64, "signed 64-bit enum constants");
+_Static_assert(sizeof(MA) == 8 && sizeof(XA) == 8 && sizeof(SA) == 4, "enumerator sizes");
+_Static_assert(sizeof(enum MixN) == 8 && sizeof(enum MixU) == 4, "enum sizes");
+
+enum __attribute__((packed)) PU { PA, PB = 200 };
+enum __attribute__((packed)) PS { PN = -3 };
+static enum Small vs;
+static enum Mix vm;
+static enum PU vpu;
+static enum PS vps;
+_Static_assert(TY(vs) == 2 && TY(vm) == U64 && TY(vpu) == 8 && TY(vps) == 7, "enum objects");
+_Static_assert(TY((enum Neg)0) == 1 && TY((enum MixN)0) == S64, "enum casts");
+_Static_assert(TY(vs + 0) == 2 && TY(vm + 0) == U64 && TY(vpu + 0) == 1 && TY(+vps) == 1,
+               "enum promotions");
+_Static_assert(sizeof(enum Mix) == 8 && sizeof((enum Mix)0) == 8 && sizeof vm == 8 &&
+                   sizeof(enum PU) == 1,
+               "enum type sizes");
+_Static_assert(_Alignof(enum Mix) == _Alignof(unsigned long long) &&
+                   __alignof__(enum Mix) == __alignof__(unsigned long long) &&
+                   _Alignof(enum PU) == 1,
+               "enum type alignment");
+
+struct BF {
+    enum Neg n : 2;
+    enum Small s : 2;
+    enum { AN = -2, AP } anon : 2;
+};
+typedef enum Neg TNeg;
+struct TBF { TNeg t : 3; };
+
+static int enum_type_runtime(int n)
+{
+    enum PU pv[n];
+    enum Mix mv[n];
+    int fails = 0;
+    fails += TY(vs) != 2 || TY(vm) != U64 || TY(vpu) != 8 || TY(vps) != 7;
+    fails += TY(vs + 0) != 2 || TY(vpu + 0) != 1 || TY((enum MixN)0) != S64;
+    fails += sizeof pv != (size_t)n || sizeof mv != 8 * (size_t)n;
+    fails += sizeof(enum Mix) != 8 || _Alignof(enum Mix) != _Alignof(unsigned long long);
+    fails += __alignof__(enum Mix) != __alignof__(unsigned long long) || _Alignof(enum PU) != 1;
+    return fails;
+}
+
+int main(int argc, char **argv)
+{
+    (void)argv;
+    enum Small s = SA;
+    enum Neg n = NB;
+    enum Huge h = HG;
+    enum MixN x = XA;
+    int fails = 0;
+    fails += TY(s) != 2 || TY(n) != 1 || TY(h) != U64 || TY(x) != S64;
+    fails += (s - 1) < 0;                       /* unsigned int arithmetic */
+    fails += !((n - 1) < 0);                    /* int arithmetic */
+    fails += (unsigned long long)HG2 != 0x100000001ULL;
+    struct BF bf = { NA, SB, AN };
+    struct TBF tbf = { -3 };
+    fails += bf.n != -1 || !(bf.n < 0) || bf.s != 1 || bf.anon != -2 || tbf.t != -3;
+    {
+        enum Small { SV = -5 };                 /* shadows the outer tag */
+        enum Small inner = SV;
+        fails += !((inner - 1) < 0);
+    }
+    enum Small after = SA;                      /* outer tag restored */
+    fails += (after - 1) < 0;
+    fails += enum_type_runtime(argc + 2);
+    puts(fails ? "enum type semantics: FAIL" : "enum type semantics: ok");
+    return fails != 0;
+}
diff --git a/tests/regression/ext_vector_abi/abi_grid.c b/tests/regression/ext_vector_abi/abi_grid.c
new file mode 100644
index 000000000..a7dc2799f
--- /dev/null
+++ b/tests/regression/ext_vector_abi/abi_grid.c
@@ -0,0 +1,105 @@
+/* By-value ext_vector_type calling-convention probe, built once as the
+ * provider (-DPROVIDER) and once as the caller, each by lccc or by the
+ * Clang oracle; see check_ext_vector_abi_grid.sh.
+ *
+ * -DELEM=<lane type> -DLANES=<n>; -DNO_RET drops the vector-returning
+ * functions (shapes whose return lccc rejects).
+ *
+ * Every lane value is a small integer, so floating lanes compare exactly. */
+typedef ELEM T __attribute__((ext_vector_type(LANES)));
+
+long long hash2(int k, T a, T b, int j);
+long long hashva(int n, ...);
+#ifndef NO_RET
+T ident(T a);
+T kfour(int k, T a, T b, T c, T d, int j);
+#endif
+
+#ifdef PROVIDER
+#include <stdarg.h>
+
+static long long hash1(long long h, T v) {
+    for (int i = 0; i < LANES; i++)
+        h = h * 31 + (long long)v[i];
+    return h;
+}
+
+long long hash2(int k, T a, T b, int j) { return hash1(hash1(k, a), b) * 7 + j; }
+
+long long hashva(int n, ...) {
+    va_list ap;
+    long long h = n;
+    va_start(ap, n);
+    for (int i = 0; i < n; i++) {
+        T v = va_arg(ap, T);
+        h = hash1(h, v) * 3 + va_arg(ap, int);
+    }
+    va_end(ap);
+    return h;
+}
+
+#ifndef NO_RET
+T ident(T a) { return a; }
+
+/* The fourth vector lands past every register piece (i386: %xmm0-2). */
+T kfour(int k, T a, T b, T c, T d, int j) {
+    if (k != 11 || j != 13)
+        return a;
+    T r = d;
+    r[0] = (ELEM)(a[0] + b[0] + c[0] != 0);
+    return r;
+}
+#endif
+
+#else /* caller */
+#include <stdio.h>
+
+static T make(int seed) {
+    T v;
+    for (int i = 0; i < LANES; i++)
+        v[i] = (ELEM)(((i * 7 + seed) % 5) + seed % 3);
+    return v;
+}
+
+static long long hash1(long long h, T v) {
+    for (int i = 0; i < LANES; i++)
+        h = h * 31 + (long long)v[i];
+    return h;
+}
+
+static int same(T x, T y) {
+    for (int i = 0; i < LANES; i++)
+        if (x[i] != y[i])
+            return 0;
+    return 1;
+}
+
+int main(void) {
+    T a = make(1), b = make(2), c = make(3), d = make(4);
+    int fails = 0;
+    if (hash2(5, a, b, 9) != hash1(hash1(5, a), b) * 7 + 9) {
+        puts("FAIL hash2");
+        fails++;
+    }
+    long long want = 2;
+    want = hash1(want, c) * 3 + 17;
+    want = hash1(want, d) * 3 + 19;
+    if (hashva(2, c, 17, d, 19) != want) {
+        puts("FAIL hashva");
+        fails++;
+    }
+#ifndef NO_RET
+    if (!same(ident(a), a)) {
+        puts("FAIL ident");
+        fails++;
+    }
+    T r = d;
+    r[0] = (ELEM)(a[0] + b[0] + c[0] != 0);
+    if (!same(kfour(11, a, b, c, d, 13), r)) {
+        puts("FAIL kfour");
+        fails++;
+    }
+#endif
+    return fails != 0;
+}
+#endif
