+                    ty: IrType::I32,
+                    size: 4,
+                    align: 4,
+                    volatile: false,
+                    semantic_volatile: false,
+                },
+                store_const(0, 1, 1),
+                Instruction::Load {
+                    volatile: false,
+                    dest: Value(7),
+                    ptr: Value(0),
+                    ty: IrType::I32,
+                    seg_override: AddressSpace::Default,
+                },
+                store_const(0, 2, 2),
