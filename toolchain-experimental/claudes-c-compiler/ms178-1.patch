diff --git a/tests/regression/fixtures/strict-packed/kernels.c b/tests/regression/fixtures/strict-packed/kernels.c
new file mode 100644
index 0000000..40ec841
--- /dev/null
+++ b/tests/regression/fixtures/strict-packed/kernels.c
@@ -0,0 +1,32 @@
+/* Integer lane algebra only; the four FP additions retain source order.
+ * poly's signed wrap is intentional: this fixture requires -fwrapv. */
+__attribute__((noinline))
+double packed_poly(const double *values, int n, int bias) {
+    double sum = 0.0;
+    for (int j = 0; j < n; ++j) {
+        int denominator = ((j + bias) * (j + bias + 1)) / 2 + j + 1;
+        sum += (1.0 / (double)denominator) * values[j];
+    }
+    return sum;
+}
+__attribute__((noinline))
+double packed_bits(const double *values, int n, int bias) {
+    double sum = 0.0;
+    int b = bias & 32767;
+    for (int j = 0; j < n; ++j) {
+        int t = j + b;
+        int denominator = (((t * 4) ^ (t >> 3)) & 0x3fffffff) + 1;
+        sum += (1.0 / (double)denominator) * values[j];
+    }
+    return sum;
+}
+/* A variable shift deliberately retains scalar-DAG packing. */
+__attribute__((noinline))
+double scalar_shift(const double *values, int n, int bias) {
+    double sum = 0.0;
+    for (int j = 0; j < n; ++j) {
+        int denominator = 1 << ((j + (bias & 7)) & 7);
+        sum += (1.0 / (double)denominator) * values[j];
+    }
+    return sum;
+}
diff --git a/tests/regression/ivsr_affine_add_wrap.c b/tests/regression/ivsr_affine_add_wrap.c
new file mode 100644
index 0000000..06bfbd2
--- /dev/null
+++ b/tests/regression/ivsr_affine_add_wrap.c
@@ -0,0 +1,47 @@
+/*
+ * IVSR-AFFINE-ADD-WRAP-1: an affine offset must respect the type of the Add
+ * that forms it, not only the type of the later multiply or pointer offset.
+ *
+ * `safe_affine` is a positive control: (i + 2) is formed in U32 before the
+ * address calculation, but its constant trip range proves that it cannot wrap.
+ * `wrapping_affine` executes exactly once with i == UINT32_MAX - 1, so the
+ * source U32 addition wraps to zero and reads data[0].  Widening the recurrence
+ * before that Add would instead form an address near 2^32 elements away.
+ */
+#include <stdint.h>
+#include <stdio.h>
+
+static uint32_t data[66];
+
+__attribute__((noinline)) static uint32_t safe_affine(const uint32_t *p) {
+    uint32_t sum = 0;
+    for (uint32_t i = 0; i < 64; ++i)
+        sum += p[i + 2U];
+    return sum;
+}
+
+__attribute__((noinline)) static uint32_t wrapping_affine(const uint32_t *p) {
+    uint32_t sum = 0;
+    for (uint32_t i = UINT32_MAX - 1U; i < UINT32_MAX; ++i)
+        sum += p[i + 2U];
+    return sum;
+}
+
+int main(void) {
+    for (uint32_t i = 0; i < 66; ++i)
+        data[i] = i * 17U + 9U;
+
+    /* Fixed answers are deliberately independent of a second loop compiled
+     * by the candidate compiler: sum(data[2..66)) is 37024; the wrapping
+     * one-trip access is data[0] == 9. */
+    if (safe_affine(data) != 37024U) {
+        fputs("safe U32 affine address mismatch\n", stderr);
+        return 1;
+    }
+    if (wrapping_affine(data) != 9U) {
+        fputs("wrapping U32 affine address mismatch\n", stderr);
+        return 2;
+    }
+    puts("ivsr_affine_add_wrap: OK");
+    return 0;
+}
