+        { T a = (c ? ret(v0, v1) : ret(v1, v2)) == v0; OUTV(a); } /* cmp/cond2 */
+        { T a = (c ? (c > 1 ? v1 : ret(v2, v0)) : ret(v1, v2)) == v0; OUTV(a); } /* cmp/nested */
