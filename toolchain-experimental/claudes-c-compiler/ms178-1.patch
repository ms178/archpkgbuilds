+    fn reg64(name: &str) -> &'static str {
+        match name {
+            "rax" | "eax" => "rax",
+            "rdx" | "edx" => "rdx",
+            "rcx" | "ecx" => "rcx",
+            "rsi" | "esi" => "rsi",
+            "rdi" | "edi" => "rdi",
