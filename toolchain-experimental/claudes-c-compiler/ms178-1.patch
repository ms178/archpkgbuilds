+                LineKind::LoadEbp { reg, .. } => reg == dst_reg,
+                LineKind::Pop { reg } => reg == dst_reg,
+                LineKind::SetCC { reg } => reg == dst_reg,
+                LineKind::Other { dest_reg } => dest_reg == dst_reg,
+                _ => false,
+            };
+            if writes_dst {
+                break;
+            }
