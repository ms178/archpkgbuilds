diff --git a/scripts/zstd_eval/roundtrip.sh b/scripts/zstd_eval/roundtrip.sh
new file mode 100755
index 000000000..c5313479e
--- /dev/null
+++ b/scripts/zstd_eval/roundtrip.sh
@@ -0,0 +1,12 @@
+#!/bin/sh
+# zstd round trip with cross-decoding: A compresses at levels 1/3/9/19, then
+# both A and B decompress and the bytes must match the original.
+# usage: roundtrip.sh <zstd-under-test> <reference-zstd> <file>...
+A=$1; B=$2; shift 2; T=${TMPDIR:-/tmp}/zrt.$$; mkdir -p "$T"; pass=0; fail=0
+for f in "$@"; do for l in 1 3 9 19; do
+  "$A" -q -f -$l "$f" -o "$T/c.zst" || { echo "FAIL compress $f -$l"; fail=$((fail+1)); continue; }
+  for d in "$A" "$B"; do
+    if "$d" -q -f -d "$T/c.zst" -o "$T/o" && cmp -s "$f" "$T/o"; then pass=$((pass+1)); else echo "FAIL $f -$l dec=$d"; fail=$((fail+1)); fi
+  done
+done; done
+rm -rf "$T"; echo "roundtrip pass=$pass fail=$fail"; [ $fail -eq 0 ]
diff --git a/scripts/zstd_eval/setup.sh b/scripts/zstd_eval/setup.sh
new file mode 100755
index 000000000..81b20bd1e
--- /dev/null
+++ b/scripts/zstd_eval/setup.sh
@@ -0,0 +1,33 @@
+#!/bin/sh
+# Prepare every zstd evaluation input in $ZSTD_EVAL_DIR (default
+# ${XDG_CACHE_HOME:-$HOME/.cache}/lccc-zstd-eval). Idempotent.
+#   zstd-1.5.7/   pristine source (sha256-checked release tarball)
+#   input.bin     1.5 MiB benchmark input: the first 1572864 bytes of the
+#                 tree's sorted lib/programs/tests C sources (sha256 pinned)
+#   src.tar       round-trip input: the lib/ tree as a tar
+#   rand.bin      round-trip input: 1 MiB from Python's Random(7)
+#   zstd-ref      GCC -O2 reference CLI (same flags validate.sh gives lccc)
+# usage: setup.sh   (env: ZSTD_EVAL_DIR, ZSTD_REF_CC=gcc-16)
+set -eu
+D=${ZSTD_EVAL_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/lccc-zstd-eval}
+HERE=$(cd "$(dirname "$0")" && pwd)
+mkdir -p "$D"
+T=$D/zstd-1.5.7.tar.gz
+SUM=eb33e51f49a15e023950cd7825ca74a4a2b43db8354825ac24fc1b7ee09e6fa3
+[ -f "$T" ] || curl -fsSL -o "$T" https://github.com/facebook/zstd/releases/download/v1.5.7/zstd-1.5.7.tar.gz
+echo "$SUM  $T" | sha256sum -c - >/dev/null
+[ -d "$D/zstd-1.5.7" ] || tar -xzf "$T" -C "$D"
+# No pipeline consumer that stops early: concatenate, then truncate the file.
+(cd "$D/zstd-1.5.7" && find lib programs tests -name '*.[ch]' | LC_ALL=C sort | xargs cat) > "$D/input.full"
+head -c 1572864 "$D/input.full" > "$D/input.bin"; rm -f "$D/input.full"
+echo "ee05dd84a3b957ce879b9795773c3d3090c774e951fc56b0454d9c4c3740a327  $D/input.bin" | sha256sum -c - >/dev/null
+tar -cf "$D/src.tar" -C "$D" zstd-1.5.7/lib
+python3 -c "import random,sys; r=random.Random(7); sys.stdout.buffer.write(bytes(r.getrandbits(8) for _ in range(1<<20)))" > "$D/rand.bin"
+if [ ! -x "$D/zstd-ref" ]; then
+  W=$D/ref.$$; rm -rf "$W"; cp -r "$D/zstd-1.5.7" "$W"
+  make -s -j2 -C "$W/programs" zstd CC="${ZSTD_REF_CC:-gcc-16}" ZSTD_NO_ASM=1 HAVE_ZLIB=0 \
+      HAVE_LZMA=0 HAVE_LZ4=0 MOREFLAGS=-O2 >/dev/null
+  cp "$W/programs/zstd" "$D/zstd-ref"; rm -rf "$W"
+fi
+cp "$HERE/force_inline_template_names.txt" "$D/fit.txt"
+echo "zstd evaluation inputs ready in $D"
diff --git a/scripts/zstd_eval/validate.sh b/scripts/zstd_eval/validate.sh
new file mode 100755
index 000000000..36a0998da
--- /dev/null
+++ b/scripts/zstd_eval/validate.sh
@@ -0,0 +1,37 @@
+#!/bin/sh
+# Full zstd validation of one compiler (inputs from setup.sh):
+#   1. fresh copy of the zstd 1.5.7 tree, CLI built with -O2 (no asm/libs)
+#   2. census: FORCE_INLINE template names that survived as text symbols
+#      (want 0; GCC and Clang outline none of them at -O2)
+#   3. round trip vs the reference CLI (cross-decoding, 4 levels, 3 inputs)
+#   4. zstd's own fuzzer (-s7) for the given seconds (default 150; 0 = skip)
+# usage: validate.sh <compiler> <out-binary> [fuzz-seconds]
+set -u
+L=$1; OUT=$2; FUZZ=${3:-150}
+D=${ZSTD_EVAL_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/lccc-zstd-eval}
+HERE=$(cd "$(dirname "$0")" && pwd)
+[ -d "$D/zstd-1.5.7" ] && [ -x "$D/zstd-ref" ] || { echo "run setup.sh first"; exit 2; }
+W=$D/work.$$
+rc=0
+rm -rf "$W"; cp -r "$D/zstd-1.5.7" "$W" || exit 2
+make -s -j1 -C "$W/programs" zstd CC="$L" ZSTD_NO_ASM=1 HAVE_ZLIB=0 HAVE_LZMA=0 \
+    HAVE_LZ4=0 MOREFLAGS="-O2" > "$W/build.log" 2>&1 || { echo "BUILD FAIL"; tail -20 "$W/build.log"; exit 1; }
+cp "$W/programs/zstd" "$OUT"
+echo "size $(stat -c %s "$OUT")"
+# Text symbols only: a function-local static such as
+# `BIT_reloadDStream.zeroFilled.0` (rodata) is not an outlined copy.
+nm "$OUT" | awk '$2 ~ /^[tT]$/ {print $3}' | sed 's/\..*//' | sort -u > "$W/syms.txt"
+n=$(grep -cxFf "$HERE/force_inline_template_names.txt" "$W/syms.txt")
+echo "census outlined_force_inline=$n"; [ "$n" -eq 0 ] || rc=1
+sh "$HERE/roundtrip.sh" "$OUT" "$D/zstd-ref" "$D/src.tar" "$D/rand.bin" "$D/input.bin" || rc=1
+if [ "$FUZZ" -gt 0 ]; then
+    make -s -j1 -C "$W/tests" fuzzer CC="$L" ZSTD_NO_ASM=1 MOREFLAGS="-O2" > "$W/fb.log" 2>&1 \
+        || { echo "FUZZER BUILD FAIL"; tail -20 "$W/fb.log"; rc=1; }
+    if [ -x "$W/tests/fuzzer" ]; then
+        (cd "$W/tests" && ./fuzzer -T"${FUZZ}"s -s7 > "$W/fz.log" 2>&1); f=$?
+        tr '\r' '\n' < "$W/fz.log" | grep -v '^$' | tail -n 2
+        echo "fuzzer exit=$f"; [ $f -eq 0 ] || rc=1
+    fi
+fi
+rm -rf "$W"
+echo "VALIDATE rc=$rc"; exit $rc
