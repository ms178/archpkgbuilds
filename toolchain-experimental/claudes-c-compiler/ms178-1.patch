+        assert!(!out.contains("movbe"), "{out}");
+    }
+
+    #[test]
+    fn keeps_a_non_adjacent_pair() {
+        let asm = "f:\n    movq (%rdi), %rax\n    movq %rax, %rcx\n    bswapq %rax\n    ret\n";
+        let out = run(asm);
+        assert!(!out.contains("movbe"), "{out}");
+    }
