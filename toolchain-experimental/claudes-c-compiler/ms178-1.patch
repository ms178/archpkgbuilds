+    let open = address.find('(')?;
+    if !address.ends_with(')') {
+        return None;
+    }
+    let displacement = address[..open].trim();
+    let inside = &address[open + 1..address.len() - 1];
+    let fields: Vec<&str> = inside.split(',').map(str::trim).collect();
+    if fields.len() != 2 && fields.len() != 3 {
+        return None;
+    }
+    let base = fields[0];
+    let index = fields[1];
+    if !base.starts_with('%') || !index.starts_with('%') {
+        return None;
+    }
+    let base_family = register_family_fast(base);
+    let index_family = register_family_fast(index);
+    if base_family == REG_NONE || base_family > REG_GP_MAX
+        || index_family == REG_NONE || index_family > REG_GP_MAX || index_family == 4
+    {
+        return None;
+    }
