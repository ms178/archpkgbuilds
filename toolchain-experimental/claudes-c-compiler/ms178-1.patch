+                                capture_output=True, text=True, timeout=60,
+                            )
+                            self.assertNotEqual(
+                                proc.returncode, 0,
+                                f"{compiler} accepted {name}: {proc.stdout}{proc.stderr}",
+                            )
+                            diagnostic = proc.stdout + proc.stderr
