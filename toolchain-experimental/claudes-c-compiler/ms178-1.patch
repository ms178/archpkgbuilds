+            (IrCmpOp::Ult, false, 100, 0, 99),           // x < 100
+            (IrCmpOp::Ule, true, 100, 100, 255),         // 100 <= x
+            (IrCmpOp::Ult, true, 100, 101, 255),         // 100 < x
