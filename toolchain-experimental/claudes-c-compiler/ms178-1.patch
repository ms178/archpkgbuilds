+        let asm = "f:\n    movw (%rdi), %eax\n    bswapl %eax\n    ret\n";
+        let out = run(asm);
+        assert!(!out.contains("movbe"), "{out}");
+    }
+
+    #[test]
+    fn keeps_a_pinned_load() {
+        let asm = "f:\n#APP\n    movq (%rdi), %rax\n#NO_APP\n    bswapq %rax\n    ret\n";
+        let out = run(asm);
+        assert!(!out.contains("movbe"), "{out}");
+    }
