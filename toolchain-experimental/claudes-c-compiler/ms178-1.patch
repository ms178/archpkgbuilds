+            packed
+                .iter()
+                .any(|l| l == "vfmadd231pd %ymm1, %ymm0, %ymm5"),
+            "packed forms are out of scope: {packed:?}"
+        );
+        let masked = fma_only(
+            "    movsd %xmm2, %xmm5\n    vfmadd231sd %xmm1, %xmm0, %xmm5{%k1}\n    movsd %xmm5, %xmm0\n    ret\n",
+        );
