+fn is_tls_absolute_operand(op: &str) -> bool {
+    if std::env::var_os("CCC_NO_SEG_OPERAND_FUSE").is_some() {
+        return false;
+    }
+    let (prefix, body) = super::relay_and_lea::strip_segment_prefix(op);
+    if !(prefix.eq_ignore_ascii_case("%fs:") || prefix.eq_ignore_ascii_case("%gs:")) {
+        return false;
+    }
+    let Some((sym, modifier)) = body.split_once('@') else {
+        return false;
+    };
+    let symbol_ok = sym
+        .bytes()
+        .next()
+        .is_some_and(|b| b.is_ascii_alphabetic() || b == b'_' || b == b'.')
+        && sym
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b == b'_' || b == b'.' || b == b'$');
+    let (name, addend) = match modifier.find(['+', '-']) {
+        Some(i) => modifier.split_at(i),
+        None => (modifier, ""),
+    };
+    let addend_ok =
+        addend.is_empty() || (addend.len() > 1 && addend[1..].bytes().all(|b| b.is_ascii_digit()));
+    symbol_ok
+        && (name.eq_ignore_ascii_case("tpoff") || name.eq_ignore_ascii_case("ntpoff"))
+        && addend_ok
+}
