diff --git a/tests/regression/segfs_pointer_declarator_matrix.c b/tests/regression/segfs_pointer_declarator_matrix.c
index f913578..651ebbd 100644
--- a/tests/regression/segfs_pointer_declarator_matrix.c
+++ b/tests/regression/segfs_pointer_declarator_matrix.c
@@ -74,8 +74,27 @@ int main(void) {
     ok &= phi_const_ptr(sel) == canary;
