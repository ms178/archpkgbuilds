+            "    movq %rdi, %r8\n.section .rodata\n.LJT:\n    .long .L1-.LJT\n.text\n    ret\n";
+        assert_eq!(text_clobbers(jt, &none), Some(R8 | RDI));
+        assert_eq!(
+            text_clobbers(".section .text.hot,\"ax\",@progbits\n    .byte 1\n", &none),
