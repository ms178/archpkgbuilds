+    store: &mut LineStore,
+    infos: &mut [LineInfo],
+    lv: &mut FileLiveness,
+    i: usize,
+    j: usize,
+    len: usize,
+    cons: &str,
+    mem: &str,
+    load_q: bool,
+    t_fam: RegId,
+    addr: u16,
+) -> Option<usize> {
+    let (copy_q, csrc, b_fam) = parse_reg_copy(cons)?;
+    // A movl copy of a movq load would truncate; a movq copy of a movl
+    // load is the zero-extension the load already performed.
+    if csrc != t_fam || b_fam == t_fam || (load_q && !copy_q) {
+        return None;
+    }
