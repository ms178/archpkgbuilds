+    fn rename_is_exact_on_digit_boundaries() {
+        assert_eq!(
+            replace_vec_reg("vaddsd %xmm2, %xmm12, %xmm2", 2, 0),
+            "vaddsd %xmm0, %xmm12, %xmm0"
+        );
