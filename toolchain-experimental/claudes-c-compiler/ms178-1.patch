+        // form needs a SIB anyway:
+        assert_eq!(hex("mov 128(,%rbx,1), %rcx"), "48 8b 8b 80 00 00 00");
+        assert_eq!(hex("mov 1000(,%rbx,1), %rcx"), "48 8b 8b e8 03 00 00");
+        assert_eq!(hex("mov 65536(,%rcx,1), %rdx"), "48 8b 91 00 00 01 00");
