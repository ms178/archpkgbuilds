+        let mask = (1i64 << bits) - 1;
+        let sign = 1i64 << (bits - 1);
+        let edges = [
+            0,
+            1,
+            2,
+            3,
+            4,
+            5,
+            6,
+            7,
+            9,
+            10,
+            mask,
+            sign,
+            sign - 1,
+            sign + 1,
+        ];
+        let mut out = Vec::with_capacity(edges.len() * edges.len());
+        for &a in &edges {
+            for &b in &edges {
+                out.push([lane_wrap(a, bits), lane_wrap(b, bits)]);
+            }
+        }
+        out
