index 000000000..9a8b571c9
--- /dev/null
+++ b/tests/regression/check_store_forwarding_dword_reload.sh
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+# Runtime contract for x86 L->L self-reload store forwarding.  Assembly unit
+# tests pin the rewrite itself; this executes the C shape whose unsigned return
+# value needs the reload's upper-half zeroing at every -O level on both targets.
+set -euo pipefail
+root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
+CCC=${CCC:-$root/target/fastbuild/lccc}
+CCC_I686=${CCC_I686:-$root/target/fastbuild/lccc-i686}
+[[ $CCC = /* ]] || CCC=$root/$CCC
+[[ $CCC_I686 = /* ]] || CCC_I686=$root/$CCC_I686
+[[ -x $CCC ]] || { echo "FAIL: compiler not built: $CCC" >&2; exit 1; }
+[[ -x $CCC_I686 ]] || { echo "FAIL: i686 compiler not built: $CCC_I686" >&2; exit 1; }
+src=$root/tests/regression/store_forwarding_dword_self_reload.c
+work=$(mktemp -d)
+trap 'rm -rf "$work"' EXIT
+
+for arch in x86-64 i686; do
+    cc=$CCC
+    [[ $arch == i686 ]] && cc=$CCC_I686
+    for opt in -O0 -O1 -O2 -O3 -Os; do
+        exe=$work/run-$arch$opt
+        env -u CCC_NO_PEEPHOLE -u CCC_PEEPHOLE_SKIP -u CCC_NO_REDUNDANT_EXT \
+            -u CCC_NO_ZEXT_NOP "$cc" "$opt" "$src" -o "$exe"
+        timeout 10 "$exe"
+    done
+done
+
+echo "store-forwarding dword self-reload: PASS (x86-64 + i686 runtime at -O0/-O1/-O2/-O3/-Os)"
diff --git a/tests/regression/check_x86_torture_execute_fixes.sh b/tests/regression/check_x86_torture_execute_fixes.sh
new file mode 100755
index 000000000..a73649c46
--- /dev/null
+++ b/tests/regression/check_x86_torture_execute_fixes.sh
@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+# Focused runtime pins for five independent x86 execute failures: aggregate
+# snapshot overwrites and global-alias windows, the target-dependent small
+# __builtin_shuffle result convention, exact generic 32-bit multiplication
+# overflow, and noinline inherited from a prototype.
+set -euo pipefail
+root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
+CCC=$(realpath "${CCC:-$root/target/fastbuild/lccc}")
+CCC_I686=$(realpath "${CCC_I686:-$root/target/fastbuild/lccc-i686}")
+[[ -x $CCC ]] || { echo "missing x86-64 LCCC: $CCC" >&2; exit 1; }
+[[ -x $CCC_I686 ]] || { echo "missing i686 LCCC: $CCC_I686" >&2; exit 1; }
+work=$(mktemp -d)
+trap 'rm -rf "$work"' EXIT
+
+tests=(
+    aggregate_copy_snapshot_overwrite
+    aggregate_global_alias_window
+    builtin_shuffle_convention
+    overflow_mul_narrow_result
+    noinline_prototype_attribute
+)
+for arch in x86-64 i686; do
+    cc=$CCC
+    [[ $arch == i686 ]] && cc=$CCC_I686
+    for test in "${tests[@]}"; do
+        for opt in -O0 -O1 -O2 -O3 -Os; do
+            exe=$work/$arch-$test$opt
+            "$cc" "$opt" "$root/tests/regression/$test.c" -o "$exe"
+            timeout 10 "$exe"
+        done
+        echo "PASS $arch $test (-O0/-O1/-O2/-O3/-Os)"
+    done
+done
diff --git a/tests/regression/fp_liveness_spill_relay_preload_clobber.c b/tests/regression/fp_liveness_spill_relay_preload_clobber.c
new file mode 100644
index 000000000..dc1ed3d8c
--- /dev/null
+++ b/tests/regression/fp_liveness_spill_relay_preload_clobber.c
@@ -0,0 +1,29 @@
+#include <stdarg.h>
+
+/* eliminate_fp_spill_around_load must not keep the pending va_arg double in
+ * %xmm0 across the pxor/cvtsi2sd pair before the later reload.  That pair is
+ * before K, not in the old (K,L)-only scan; the value must be relayed through
+ * %xmm1 (or spilled), otherwise the final addition doubles 144 and main
+ * returns 1.  Reduced from gcc.c-torture/execute/stdarg-4.c at -O0. */
+long x;
+
+inline void __attribute__((always_inline)) consume(va_list ap)
+{
+    x = va_arg(ap, double);
+    x += va_arg(ap, long);
+    x += va_arg(ap, double);
+}
+
+void f(int i, ...)
+{
+    va_list ap;
+    va_start(ap, i);
+    consume(ap);
+    va_end(ap);
+}
+
+int main(void)
+{
+    f(3, 16.0, 128L, 32.0);
+    return x != 176L;
+}
