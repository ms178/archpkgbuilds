+        // obviously-intended target are pinned so a regression in the
+        // tie-break is caught rather than merely reproducing itself.
+        for (bad, want) in [("-std=c17x", "c17"), ("-std=c1l", "c11")] {
+            let err = try_flag(bad).expect_err(bad);
+            assert!(
