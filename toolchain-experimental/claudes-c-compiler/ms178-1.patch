index e77f1b43..00000000
--- a/tests/regression/builtin_cpu_supports_raptor.env
+++ /dev/null
@@ -1,8 +0,0 @@
-# lccc-only: __builtin_cpu_supports folds at COMPILE TIME against the fixed
-# Raptor Lake allowlist (expr_builtins.rs PRESENT) because lccc targets that
-# CPU. GCC implements runtime CPUID, so on any host that is not a Raptor Lake
-# — this regression VM is an AVX-512-capable Xeon — GCC correctly returns
