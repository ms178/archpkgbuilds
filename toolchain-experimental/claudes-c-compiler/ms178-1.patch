+                    let mut t = affine_term(block, def_pos, lhs, depth - 1)?;
+                    let Operand::Const(c) = rhs else {
+                        // var - var or var - const-var: not a plain shift.
+                        return Some(opaque_var(*v));
+                    };
+                    t.off = t.off.checked_sub(c.to_i64()?)?;
+                    Some(t)
