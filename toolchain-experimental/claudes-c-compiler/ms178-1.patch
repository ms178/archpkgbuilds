+                    rebuilt
+                }
+            }
+            MapExpr::MaskConj { is_and, l, r } => {
+                let rebuilt = MapExpr::MaskConj {
+                    is_and,
+                    l: Box::new(go(*l, false)),
+                    r: Box::new(go(*r, false)),
+                };
