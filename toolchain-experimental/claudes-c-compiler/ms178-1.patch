+            // the packed ps/pd rows and 97/A7/B7 stay packed) plus the
+            // scalar vscalef (2D) and vgetexp (43).
+            (2, 1) => match opcode {
+                0x99 | 0x9B | 0x9D | 0x9F | 0xA9 | 0xAB | 0xAD | 0xAF | 0xB9 | 0xBB | 0xBD
+                | 0xBF | 0x2D | 0x43 => Some(if w == 1 { 8 } else { 4 }),
+                _ => None,
