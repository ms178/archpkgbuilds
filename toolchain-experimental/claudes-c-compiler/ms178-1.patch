+                    Operand::Const(IrConst::I64(0)),
+                    "load index zeroed"
+                );
+                assert_eq!(args[2], Operand::Const(IrConst::I64(24)), "disp untouched");
+            }
+            other => panic!("load triple must stay an Intrinsic, got {other:?}"),
+        }
+        match &func.blocks[2].instructions[3] {
