+        let mut g = f.clone();
+        assert_eq!(accumulator_calls_to_loops(&mut g), 2);
+        assert_eq!(self_calls(&g), 0);
+        let m = FxHashMap::default();
+        for n in [-3, 0, 1, 2, 5, 10, 11, 13, 20, 25] {
+            let want = run_ref(&f, n, &m, 0);
+            assert!(want.is_some());
+            assert_eq!(want, run_ref(&g, n, &m, 0), "fact({n})");
