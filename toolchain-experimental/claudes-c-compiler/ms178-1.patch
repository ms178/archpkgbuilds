+/// Evaluate a comparison on two constant operands. The result is the IR's
+/// canonical boolean encoding, `IrConst::I32(0 | 1)`.
+pub(crate) fn eval_cmp_const(
+    op: IrCmpOp,
+    lhs: IrConst,
+    rhs: IrConst,
+    ty: IrType,
