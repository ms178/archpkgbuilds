+                // setCC writes the low byte only; the value is a bool (0/1).
+                if reg <= REG_GP_MAX {
+                    sign_ext[reg as usize] = false;
+                    is_bool[reg as usize] = true;
+                }
+            }
+            _ => {
+                let d = parse_dest_reg(&t);
+                if d <= REG_GP_MAX {
+                    sign_ext[d as usize] = false;
+                    is_bool[d as usize] = false;
+                }
