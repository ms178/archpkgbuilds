+// CHECK-64-LABEL: define dso_local void @test4(
+// CHECK-64-SAME: i32 noundef{{( signext)?}} [[N:%.*]]) #[[ATTR0]] {
+// CHECK-64-NEXT:  [[ENTRY:.*:]]
+// CHECK-64-NEXT:    [[N_ADDR:%.*]] = alloca i32, align
