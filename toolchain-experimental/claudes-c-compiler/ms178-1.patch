+            | O::LoadF64x2
+            | O::LoadF64x4
+            | O::LoadI32x4
+            | O::LoadI32x8
+            | O::HorizontalAddF64x2
+            | O::HorizontalAddF64x4
+            | O::HorizontalAddI32x4
+            | O::HorizontalAddI32x8
+            | O::VecLoadF64x2
+            | O::VecLoadF64x4
+            | O::VecLoadI32x4
