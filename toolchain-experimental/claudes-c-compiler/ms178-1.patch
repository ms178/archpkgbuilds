+# AVX512-FP16 (EVEX maps 5/6) + compare-to-EFLAGS + conversion decorator
+# matrix + {1toN} count law. Generated from the audit-response oracle
+# battery (every accept AND reject re-validated against GAS 2.47.20260726
+# at generation time; asmdiff re-checks both assemblers per run).
+;;; fp16_arith_ph
+.text
+vaddpd (%rdx){1to8}, %zmm1, %zmm2
+vaddph (%rdx){1to16}, %ymm1, %ymm2
+vaddph (%rdx){1to32}, %zmm1, %zmm2
+vaddph (%rdx){1to8}, %xmm1, %xmm2
+vaddps (%rdx){1to16}, %zmm1, %zmm2
+vaddss %xmm1, %xmm2, %xmm3
+vaddss %xmm1, %xmm2, %xmm3{%k7}{z}
+vaddss -256(%rdx), %xmm5, %xmm6
+vminmaxbf16 $1, %zmm1, %zmm2, %zmm3
+vminmaxpd $2, %zmm1, %zmm2, %zmm3
+vminmaxph $3, %zmm1, %zmm2, %zmm3
+vminmaxps $1, %zmm1, %zmm2, %zmm3
+vminmaxps $1, %zmm1, %zmm2, %zmm3{%k7}{z}
+vminmaxps $1, (%rax){1to16}, %zmm1, %zmm2
+vminmaxps $1, (%rdx){1to16}, %zmm1, %zmm2
+;;; fp16_bcst_counts
+.text
+valignd $1, (%rdx){1to16}, %zmm1, %zmm2
