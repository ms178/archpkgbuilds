+        );
+        // The value is recomputed and re-parked (e.g. by store_rax_to's tail):
+        state.park_acc(3, false);
+        assert!(
+            state.acc_has_verified(3, false),
+            "a re-park re-establishes residency with a fresh epoch"
+        );
+    }
