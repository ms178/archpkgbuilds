diff -urN '--exclude=target' '--exclude=.git' a/snapshots/checkpoint.sh b/snapshots/checkpoint.sh
--- a/snapshots/checkpoint.sh	1970-01-01 00:00:00.000000000 +0000
+++ b/snapshots/checkpoint.sh	2026-08-14 11:33:17.408653987 +0000
@@ -0,0 +1,68 @@
+#!/usr/bin/env bash
+# Capture the current validated state of the LCCC tree as ms178-1.patch.
+#
+# Run this IMMEDIATELY after every validated fix. See README.md — the sandbox
+# reverts the working tree without warning, so an uncheckpointed fix is a lost
+# fix.
+#
+# The diff is taken with RELATIVE paths rooted at the parent of both trees, so
+# the result applies cleanly with `patch -p1` from inside the target checkout.
+set -euo pipefail
+
+PRISTINE=${PRISTINE:-/home/user/.lccc-pristine}
+WORK=${WORK:-/home/user/lccc}
+SNAPDIR=${SNAPDIR:-/home/user/snapshots}
+PATCH="$SNAPDIR/ms178-1.patch"
+
+mkdir -p "$SNAPDIR/history"
+
+if [[ ! -d $PRISTINE ]]; then
+  echo "error: pristine baseline $PRISTINE missing; re-clone it first" >&2
+  exit 1
+fi
+
+# Work in a scratch dir with the conventional a/ and b/ names so the emitted
+# headers are `--- a/src/...` / `+++ b/src/...` and `patch -p1` just works.
+# diff exits 1 when differences exist, which is the normal case here.
+# -N treats absent files as empty so newly added files appear in full.
+# The label options force conventional a// b/ headers regardless of where the
+# two trees physically live.
+(
+  cd "$(dirname "$PRISTINE")"
+  diff -urN --exclude=target --exclude=.git \
+    --label "a" --label "b" \
+    "$PRISTINE" "$WORK" > /dev/null 2>&1 || true
+)
+
+python3 - "$PRISTINE" "$WORK" "$PATCH" <<'PYEOF'
+import subprocess, sys, os
+pristine, work, out = sys.argv[1], sys.argv[2], sys.argv[3]
+r = subprocess.run(
+    ["diff", "-urN", "--exclude=target", "--exclude=.git", pristine, work],
+    capture_output=True, text=True)
+lines = []
+for line in r.stdout.splitlines(keepends=True):
+    if line.startswith("diff -urN "):
+        line = (line.replace(pristine + "/", "a/")
+                    .replace(work + "/", "b/"))
+    elif line.startswith("--- "):
+        line = "--- " + "a/" + os.path.relpath(
+            line[4:].split("\t")[0], pristine) + "\t" + \
+            (line.split("\t", 1)[1] if "\t" in line else "\n")
+    elif line.startswith("+++ "):
+        line = "+++ " + "b/" + os.path.relpath(
+            line[4:].split("\t")[0], work) + "\t" + \
+            (line.split("\t", 1)[1] if "\t" in line else "\n")
+    lines.append(line)
+open(out, "w").write("".join(lines))
+PYEOF
+
+# Ship the snapshot tooling itself inside the patch as well, but from the
+# repo copy so it round-trips.
+stamp=$(date -u +%Y%m%dT%H%M%SZ)
+cp "$PATCH" "$SNAPDIR/history/ms178-1.$stamp.patch"
+
+files=$(grep -c '^diff -urN' "$PATCH" || true)
+bytes=$(stat -c%s "$PATCH")
+printf 'checkpoint %s: %s bytes, %s files -> %s\n' \
+  "$stamp" "$bytes" "$files" "$PATCH"
