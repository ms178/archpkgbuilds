+            is_always_inline: false,
+            is_noinline: true,
+            next_value_id: next_val,
+            next_label,
+            section: None,
+            visibility: None,
+            is_weak: false,
+            is_used: true,
+            has_inlined_calls: false,
+            is_fastcall: false,
+            is_naked: false,
+            param_alloca_values: param_alloca_vals,
+            uses_sret,
+            global_init_label_blocks: Vec::new(),
+            ret_eightbyte_classes,
+            ret_is_f128_sse,
