diff --git a/src/passes/fp_double.rs b/src/passes/fp_double.rs
new file mode 100644
index 00000000..922154de
--- /dev/null
+++ b/src/passes/fp_double.rs
@@ -0,0 +1,192 @@
+//! Scalar binary32/binary64 doubling without a constant register.
+//!
+//! Multiplication by positive two and adding a value to itself have the same
+//! exact real result, hence the same rounding, signed zero and FP exceptions.
+//! This is not reassociation. Restrict the pipeline to x86-64 SSE semantics;
+//! x87 excess precision and other backends are deliberately outside its scope.
+//! Keep multiply/add contraction opportunities, including through copy chains.
+use crate::common::fx_hash::{FxHashMap, FxHashSet};
+use crate::common::types::IrType;
+use crate::ir::reexports::{Instruction, IrBinOp, IrConst, IrFunction, Operand};
+
+/// x*2 and x+x have identical IEEE binary32/binary64 results, signed zero,
+/// rounding and exceptions. Leave potential multiply-add contractions alone.
+pub(crate) fn run(func: &mut IrFunction) -> usize {
+    let mut contraction_inputs = FxHashSet::default();
+    for b in &func.blocks {
+        for i in &b.instructions {
+            if let Instruction::BinOp {
+                op: IrBinOp::Add | IrBinOp::Sub,
+                lhs,
+                rhs,
+                ty,
+                ..
+            } = i
+                && matches!(ty, IrType::F32 | IrType::F64)
+            {
+                for op in [lhs, rhs] {
+                    if let Operand::Value(v) = op {
+                        contraction_inputs.insert(v.0);
+                    }
+                }
+            }
+        }
+    }
+    let copies: FxHashMap<_, _> = func
+        .blocks
+        .iter()
+        .flat_map(|b| &b.instructions)
+        .filter_map(|i| match i {
+            Instruction::Copy {
+                dest,
+                src: Operand::Value(v),
+            } => Some((dest.0, v.0)),
+            _ => None,
+        })
+        .collect();
+    let mut work: Vec<_> = contraction_inputs.iter().copied().collect();
+    while let Some(v) = work.pop() {
+        if let Some(&src) = copies.get(&v)
+            && contraction_inputs.insert(src)
+        {
+            work.push(src);
+        }
+    }
+    let mut changes = 0;
+    for b in &mut func.blocks {
+        for i in &mut b.instructions {
+            let Instruction::BinOp {
+                dest,
+                op: IrBinOp::Mul,
+                lhs,
+                rhs,
+                ty,
+            } = i
+            else {
+                continue;
+            };
+            if contraction_inputs.contains(&dest.0) {
+                continue;
+            }
+            let two = |op: Operand| {
+                matches!(
+                    (op, *ty),
+                    (Operand::Const(IrConst::F32(2.0)), IrType::F32)
+                        | (Operand::Const(IrConst::F64(2.0)), IrType::F64)
+                )
+            };
+            let value = if two(*lhs) {
+                *rhs
+            } else if two(*rhs) {
+                *lhs
+            } else {
+                continue;
+            };
+            *i = Instruction::BinOp {
+                dest: *dest,
+                op: IrBinOp::Add,
+                lhs: value,
+                rhs: value,
+                ty: *ty,
+            };
+            changes += 1;
+        }
+    }
+    changes
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::ir::reexports::{BasicBlock, BlockId, Terminator, Value};
+    fn v(n: u32) -> Operand {
+        Operand::Value(Value(n))
+    }
+    fn fixture(ty: IrType, constant: IrConst, left: bool) -> IrFunction {
+        let mut f = IrFunction::new("double".into(), ty, vec![], false);
+        let (lhs, rhs) = if left {
+            (Operand::Const(constant), v(1))
+        } else {
+            (v(1), Operand::Const(constant))
+        };
+        f.blocks.push(BasicBlock {
+            label: BlockId(0),
+            source_spans: vec![],
+            instructions: vec![
+                Instruction::ParamRef {
+                    dest: Value(1),
+                    param_idx: 0,
+                    ty,
+                },
+                Instruction::BinOp {
+                    dest: Value(2),
+                    op: IrBinOp::Mul,
+                    lhs,
+                    rhs,
+                    ty,
+                },
+            ],
+            terminator: Terminator::Return(Some(v(2))),
+        });
+        f
+    }
+    #[test]
+    fn doubles_both_operand_orders_and_precisions_without_new_values() {
+        for (ty, c) in [
+            (IrType::F32, IrConst::F32(2.0)),
+            (IrType::F64, IrConst::F64(2.0)),
+        ] {
+            for left in [false, true] {
+                let mut f = fixture(ty, c, left);
+                assert_eq!(run(&mut f), 1);
+                assert!(matches!(f.blocks[0].instructions[1], Instruction::BinOp {
+                    dest: Value(2), op: IrBinOp::Add, lhs, rhs, ty: t
+                } if lhs == v(1) && rhs == v(1) && t == ty));
+                assert_eq!(f.next_value_id, 0);
+                assert_eq!(run(&mut f), 0);
+            }
+        }
+    }
+    #[test]
+    fn preserves_contractions_through_arbitrarily_ordered_copy_chains() {
+        for op in [IrBinOp::Add, IrBinOp::Sub] {
+            for left in [false, true] {
+                let mut f = fixture(IrType::F64, IrConst::F64(2.0), left);
+                for n in 3..=35 {
+                    f.blocks[0].instructions.push(Instruction::Copy {
+                        dest: Value(n),
+                        src: v(n - 1),
+                    });
+                }
+                f.blocks[0].instructions.push(Instruction::BinOp {
+                    dest: Value(36),
+                    op,
+                    lhs: v(35),
+                    rhs: v(1),
+                    ty: IrType::F64,
+                });
+                f.blocks[0].terminator = Terminator::Return(Some(v(36)));
+                let before = format!("{f:?}");
+                assert_eq!(run(&mut f), 0);
+                assert_eq!(format!("{f:?}"), before);
+            }
+        }
+    }
+    #[test]
+    fn refuses_non_two_wrong_carrier_width_integer_and_extended_precision() {
+        for (ty, c) in [
+            (IrType::F32, IrConst::F64(2.0)),
+            (IrType::F64, IrConst::F32(2.0)),
+            (IrType::F64, IrConst::F64(-2.0)),
+            (IrType::F64, IrConst::F64(f64::NAN)),
+            (IrType::F64, IrConst::F64(2.0000000000000004)),
+            (IrType::I32, IrConst::I32(2)),
+            (IrType::F128, IrConst::F64(2.0)),
+        ] {
+            let mut f = fixture(ty, c, false);
+            let before = format!("{f:?}");
+            assert_eq!(run(&mut f), 0);
+            assert_eq!(format!("{f:?}"), before);
+        }
+    }
+}
diff --git a/src/passes/loop_square.rs b/src/passes/loop_square.rs
new file mode 100644
index 00000000..7172108e
--- /dev/null
+++ b/src/passes/loop_square.rs
@@ -0,0 +1,229 @@
+//! Reuse an already-computed square across a loop backedge.
+//!
+//! A header p = phi(0, next) and body p*p need not recompute next*next
+//! when that exact product already dominates the latch. The initial square
+//! is +0 (including an initial -0); no arithmetic or memory access is
+//! speculated into a zero-trip preheader. One extra recurrence per innermost
+//! loop bounds register pressure and avoids defeating both sides of an FMA.
+//!
+//! Floating-environment-changing and unmodelled instructions reject a loop.
+//! This is value reuse, not reassociation or a reconstruction of builtin FMA.
+use super::loop_analysis::{self, DominanceChecker};
+use crate::common::types::IrType;
+use crate::ir::analysis::CfgAnalysis;
+use crate::ir::reexports::{Instruction, IrBinOp, IrConst, IrFunction, Operand, Value};
+
+fn square_zero(operand: Operand, ty: IrType) -> Option<Operand> {
+    match (operand, ty) {
+        (Operand::Const(IrConst::F32(x)), IrType::F32) if x == 0.0 => {
+            Some(Operand::Const(IrConst::F32(0.0)))
+        }
+        (Operand::Const(IrConst::F64(x)), IrType::F64) if x == 0.0 => {
+            Some(Operand::Const(IrConst::F64(0.0)))
+        }
+        _ => None,
+    }
+}
+
+fn stable_fp_environment(inst: &Instruction) -> bool {
+    // Default-closed: in particular calls (even pure calls), asm, intrinsics
+    // such as LDMXCSR, atomics and nonlocal transfers cannot cross the proof.
+    matches!(
+        inst,
+        Instruction::Phi { .. }
+            | Instruction::BinOp { .. }
+            | Instruction::UnaryOp { .. }
+            | Instruction::Cmp { .. }
+            | Instruction::Cast { .. }
+            | Instruction::Copy { .. }
+            | Instruction::GetElementPtr { .. }
+            | Instruction::GlobalAddr { .. }
+            | Instruction::Load {
+                volatile: false,
+                ..
+            }
+            | Instruction::Store {
+                volatile: false,
+                ..
+            }
+    )
+}
+
+pub(crate) fn run(func: &mut IrFunction) -> usize {
+    // Cheap triage: most functions have no floating-point squares.
+    if !func.blocks.iter().flat_map(|b| &b.instructions).any(|i| matches!(i,
+        Instruction::BinOp { op: IrBinOp::Mul, lhs, rhs, ty: IrType::F32 | IrType::F64, .. } if lhs == rhs)) { return 0; }
+    if func.blocks.is_empty() || !super::gvn::find_multi_def_values(func).is_empty() {
+        return 0;
+    }
+    let cfg = CfgAnalysis::build(func);
+    let dom = DominanceChecker::new(func.blocks.len(), &cfg.idom);
+    let loops = loop_analysis::find_merged_natural_loops(
+        func.blocks.len(),
+        &cfg.preds,
+        &cfg.succs,
+        &cfg.idom,
+    );
+    // All plans are from one immutable SSA snapshot; distinct innermost
+    // loops have disjoint bodies. Applying them changes no CFG edge.
+    let mut plans = Vec::new();
+    for lp in &loops {
+        if loops
+            .iter()
+            .any(|other| other.header != lp.header && lp.contains(other.header))
+        {
+            continue;
+        }
+        let Some(pre) = lp.find_dedicated_preheader(&cfg.preds, &cfg.succs) else {
+            continue;
+        };
+        let Some(latch) = lp.single_latch(&cfg.preds) else {
+            continue;
+        };
+        // Reserve space for temporaries/invariants in the 16-register x86-64
+        // SIMD file. This is a conservative profitability heuristic, not a
+        // proof that the allocator cannot spill. Add at most one recurrence.
+        if func.blocks[lp.header]
+            .instructions
+            .iter()
+            .filter(|i| {
+                matches!(
+                    i,
+                    Instruction::Phi {
+                        ty: IrType::F32 | IrType::F64,
+                        ..
+                    }
+                )
+            })
+            .count()
+            >= 6
+        {
+            continue;
+        }
+        if lp.body.iter().any(|&b| {
+            !dom.dominates(lp.header, b)
+                || func.blocks[b]
+                    .instructions
+                    .iter()
+                    .any(|i| !stable_fp_environment(i))
+        }) {
+            continue;
+        }
+        let pre_label = func.blocks[pre].label;
+        let latch_label = func.blocks[latch].label;
+        let mut body: Vec<usize> = lp.body.iter().copied().collect();
+        body.sort_unstable();
+        'one_per_loop: for &b in &body {
+            // Save work on every backedge, not just a conditional side path.
+            if !dom.dominates(b, latch) {
+                continue;
+            }
+            for (ii, inst) in func.blocks[b].instructions.iter().enumerate() {
+                let Instruction::BinOp {
+                    dest,
+                    op: IrBinOp::Mul,
+                    lhs: Operand::Value(p),
+                    rhs: Operand::Value(q),
+                    ty,
+                } = inst
+                else {
+                    continue;
+                };
+                if p != q || !matches!(ty, IrType::F32 | IrType::F64) {
+                    continue;
+                }
+                let Some(Instruction::Phi {
+                    incoming,
+                    ty: phi_ty,
+                    ..
+                }) = func.blocks[lp.header]
+                    .instructions
+                    .iter()
+                    .find(|i| matches!(i, Instruction::Phi { dest, .. } if dest == p))
+                else {
+                    continue;
+                };
+                if phi_ty != ty || incoming.len() != 2 {
+                    continue;
+                }
+                let Some((initial, _)) = incoming.iter().find(|(_, from)| *from == pre_label)
+                else {
+                    continue;
+                };
+                let Some((next, _)) = incoming.iter().find(|(_, from)| *from == latch_label) else {
+                    continue;
+                };
+                let Some(zero) = square_zero(*initial, *ty) else {
+                    continue;
+                };
+                let Operand::Value(next) = next else { continue };
+                for &nb in &body {
+                    if !dom.dominates(nb, latch) {
+                        continue;
+                    }
+                    let replacement = func.blocks[nb].instructions.iter().find_map(|i| match i {
+                        Instruction::BinOp {
+                            dest: d,
+                            op: IrBinOp::Mul,
+                            lhs: Operand::Value(a),
+                            rhs: Operand::Value(c),
+                            ty: t,
+                        } if a == next && c == next && t == ty && d != dest => Some(*d),
+                        _ => None,
+                    });
+                    if let Some(replacement) = replacement {
+                        plans.push((
+                            lp.header,
+                            pre_label,
+                            latch_label,
+                            b,
+                            ii,
+                            *dest,
+                            replacement,
+                            zero,
+                            *ty,
+                        ));
+                        break 'one_per_loop;
+                    }
+                }
+            }
+        }
+    }
+    if plans.is_empty() {
+        return 0;
+    }
+    func.next_value_id = func.sound_next_value_id();
+    // Rewrite the old instruction in place to a Copy before inserting any
+    // phis, so header indices never become stale. Preserve original spans.
+    let mut additions = Vec::new();
+    for (header, pre, latch, b, ii, dest, replacement, zero, ty) in &plans {
+        let carried = Value(func.next_value_id);
+        func.next_value_id += 1;
+        func.blocks[*b].instructions[*ii] = Instruction::Copy {
+            dest: *dest,
+            src: Operand::Value(carried),
+        };
+        additions.push((
+            *header,
+            Instruction::Phi {
+                dest: carried,
+                ty: *ty,
+                incoming: vec![(*zero, *pre), (Operand::Value(*replacement), *latch)],
+            },
+        ));
+    }
+    for (header, phi) in additions {
+        let b = &mut func.blocks[header];
+        let tracked = !b.source_spans.is_empty();
+        b.instructions.insert(0, phi);
+        if tracked {
+            b.source_spans
+                .insert(0, crate::common::source::Span::dummy());
+        }
+    }
+    plans.len()
+}
