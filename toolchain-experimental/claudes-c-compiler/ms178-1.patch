-        assert!(!may_assume_builtin("memcpy"));
-    }
-
-    #[test]
-    fn self_labelled_declaration_is_not_a_definition() {
-        // glibc-style `extern ... __asm__("memcpy")`: an identity spelling.
-        // Treating it as a definition used to disable the expansion in TUs
