+        b"div" | b"divb" | b"divw" | b"divl" | b"divq" | b"idiv" | b"idivb" | b"idivw"
+        | b"idivl" | b"idivq" | b"mul" | b"mulb" | b"mulw" | b"mull" | b"mulq" => {
