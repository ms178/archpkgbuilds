+ *     struct T d = s;      // memcpy %d <- %s (both non-escaping allocas)
+ *     s.a += 7000;         // Store into the SOURCE after the copy
+ *     ... d.a ...          // must still see the pre-store value
+ *
+ * sret_copy_elision phase 2 (as merged in #890) logs a store into the source
+ * as Event::Write, which never marks the root opaque, and its program-order
+ * check only looks at whole-object copies, so `load d.a` was re-rooted at
+ * `s.a` and observed the new value.  Same-block, cross-block and
+ * loop-carried shapes are covered.
+ *
+ * GCC 16.2: "300 7300 / 100 7100 / 5 7005 / 11".
+ */
+#include <stdio.h>
+
+struct T { long a, b, c; };
+
+__attribute__((noinline)) static struct T seed(long k) {
+    struct T t = {k, k + 1, k + 2};
+    return t;
+}
+
+__attribute__((noinline)) static void same_block(long k) {
+    struct T s = seed(k);
+    struct T d = s;
+    s.a += 7000;
+    printf("%ld %ld\n", d.a, s.a);
+}
+
+__attribute__((noinline)) static void cross_block(long k, int c) {
+    struct T s = seed(k);
+    struct T d = s;
+    if (c)
+        s.a += 7000;
+    long r = 0;
+    if (k > 0)
+        r = d.a;
+    printf("%ld %ld\n", r, s.a);
+}
+
+__attribute__((noinline)) static long loop_carried(int n) {
+    struct T s = seed(1);
+    long acc = 0;
+    for (int i = 0; i < n; i++) {
+        struct T d = s;
+        s.a = s.a * 2 + i;       /* source rewritten after each copy */
+        acc += d.a + d.c - d.b;  /* must read the copy's snapshot */
+    }
+    return acc;
+}
+
+int main(void) {
+    same_block(300);
+    cross_block(100, 1);
+    cross_block(5, 1);
+    printf("%ld\n", loop_carried(3));
+    return 0;
+}
diff --git a/tests/regression/agg_sroa_runtime_index_identity.c b/tests/regression/agg_sroa_runtime_index_identity.c
new file mode 100644
index 000000000..eb49113bd
--- /dev/null
+++ b/tests/regression/agg_sroa_runtime_index_identity.c
@@ -0,0 +1,76 @@
+/* aggregate_sroa must treat a runtime-offset pointer into an object as a
+ * pointer into THAT object.
+ *
+ * The pass's derivation map recorded only constant-offset GEPs, so `&s.v[k]`
+ * resolved to itself, an apparently unrelated object.  Every identity question
+ * Transform 1 (load forwarding through a single-copy alloca) asks then had the
+ * wrong answer:
+ *
+ *   src_store   memcpy d <- s; s.v[k] = X; load d.v[i]
+ *               the store did not dirty the source; the load read X.
+ *   dst_store   memcpy d <- s; d.v[k] = X; load d.v[i]
+ *               d did not look stored-to; the load was forwarded to s.
+ *   dst_read    memcpy d <- s; load d.v[k]; load d.v[0]
+ *               the runtime read was not counted, every *counted* read was
+ *               forwarded, and the now "dead" copy was deleted under it.
+ *   escape      memcpy d <- s; clobber(&s.v[k]); load d.v[i]
+ *               s did not escape through the call, so as a "private" alloca
+ *               it was assumed untouchable by it.
+ *   loop        the src_store shape carried around a loop.
+ *
+ * GCC 16.2 -O2: "11321 4323 / 4721 4327 / 3 4 / 321 4321 / 212415".
+ */
+#include <stdio.h>
+
+struct T { long v[4]; };
+
+__attribute__((noinline)) long src_store(const struct T *in, int k) {
+    struct T s = *in;
+    struct T d = s;
+    s.v[k] = 7000;
+    return d.v[0] + d.v[1] * 10 + d.v[2] * 100 + d.v[3] * 1000 + s.v[1];
+}
+
+__attribute__((noinline)) long dst_store(const struct T *in, int k) {
+    struct T s = *in;
+    struct T d = s;
+    d.v[k] = 7;
+    return d.v[0] + d.v[1] * 10 + d.v[2] * 100 + d.v[3] * 1000 + s.v[0] - 1;
+}
+
+__attribute__((noinline)) long dst_read(const struct T *in, int k) {
+    struct T s = *in;
+    struct T d = s;
+    long t = d.v[k];
+    return t + d.v[0] - 1;
+}
+
+__attribute__((noinline)) void clobber(long *p) { *p = 9000; }
+
+__attribute__((noinline)) long escape(const struct T *in, int k) {
+    struct T s = *in;
+    struct T d = s;
+    clobber(&s.v[k]);
+    return d.v[0] + d.v[1] * 10 + d.v[2] * 100 + (s.v[3] != 9000) * 4000;
+}
+
+__attribute__((noinline)) long loop(const struct T *in, int n) {
+    struct T s = *in;
+    long acc = 0;
+    for (int i = 0; i < n; i++) {
+        struct T d = s;
+        s.v[i & 3] += 5;
+        acc = acc * 7 + d.v[0] + d.v[1] + d.v[2] + d.v[3];
+    }
+    return acc;
+}
+
+int main(void) {
+    struct T a = {{1, 2, 3, 4}};
+    printf("%ld %ld\n", src_store(&a, 1), src_store(&a, 3));
+    printf("%ld %ld\n", dst_store(&a, 2), dst_store(&a, 0));
+    printf("%ld %ld\n", dst_read(&a, 2), dst_read(&a, 3));
+    printf("%ld %ld\n", escape(&a, 3), escape(&a, 0));
+    printf("%ld\n", loop(&a, 6));
+    return 0;
+}
diff --git a/tests/regression/sret_slot_aliases_argument.c b/tests/regression/sret_slot_aliases_argument.c
new file mode 100644
index 000000000..730122c5e
--- /dev/null
+++ b/tests/regression/sret_slot_aliases_argument.c
@@ -0,0 +1,60 @@
+/* A structure-returning call must not be pointed at an object the callee can
+ * reach through another pointer.
+ *
+ *     x = make(&x);
+ *
+ * lowers to `call make(%tmp, %x); memcpy %x <- %tmp`.  Retargeting the hidden
+ * slot at %x and deleting the copy (sret_copy_elision phase 1, as merged in
+ * #890) makes the callee's result writes land in the object it is still
+ * reading.  The SysV ABI lets a callee write its return slot at any time,
+ * because callers guarantee the slot aliases nothing else; GCC enforces that
+ * with dest_safe_for_nrv_p (an address-taken destination is never used).
+ *
+ * The callee is assembly so the test pins the caller's contract only: it
+ * writes slot.v[0] FIRST and then re-reads p->v[0], as an NRV-optimised
+ * callee may.  GCC 16.2: "2 100 3 4 / 2 100 3 4 / 12 1100 31 41".
+ */
+#include <stdio.h>
+
+struct S { long v[4]; };
+struct S sa_make(const struct S *p);
+
+__asm__(".text\n"
+        ".globl sa_make\n"
+        ".type sa_make,@function\n"
+        "sa_make:\n"
+        "  movq (%rsi), %rax\n"
+        "  addq $1, %rax\n"
+        "  movq %rax, (%rdi)\n"      /* slot.v[0] = p->v[0] + 1 (written first) */
+        "  movq (%rsi), %rax\n"      /* re-read p->v[0]: legal, slot != *p     */
+        "  imulq $100, %rax\n"
+        "  movq %rax, 8(%rdi)\n"     /* slot.v[1] = p->v[0] * 100              */
+        "  movq 16(%rsi), %rax\n"
+        "  movq %rax, 16(%rdi)\n"
+        "  movq 24(%rsi), %rax\n"
+        "  movq %rax, 24(%rdi)\n"
+        "  movq %rdi, %rax\n"
+        "  ret\n"
+        ".size sa_make, .-sa_make\n");
+
+__attribute__((noinline)) static void show(const struct S *s) {
+    printf("%ld %ld %ld %ld\n", s->v[0], s->v[1], s->v[2], s->v[3]);
+}
+
+int main(void) {
+    struct S x = {{1, 2, 3, 4}};
+    x = sa_make(&x);                 /* address-taken destination */
+    show(&x);
+
+    struct S y = {{1, 2, 3, 4}};
+    struct S *alias = &y;            /* escaped through a pointer */
+    y = sa_make(alias);
+    show(&y);
+
+    struct S z[2] = {{{10, 20, 30, 40}}, {{11, 21, 31, 41}}};
+    z[0] = sa_make(&z[1]);           /* destination unrelated to the argument */
+    z[0].v[2] = z[1].v[2];
+    z[0].v[3] = z[1].v[3];
+    show(&z[0]);
+    return 0;
+}
