+             ret\n\
+             tramp_start:\n\
+             ret\n\
+             .set .Lalias1, -10526720 + tramp_sym - tramp_start\n\
+             movz x0, :abs_g2_s:.Lalias1\n\
+             movk x0, :abs_g1_nc:.Lalias1\n\
+             movk x0, :abs_g0_nc:.Lalias1\n",
