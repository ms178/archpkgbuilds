+                && matches!(op, IrBinOp::SDiv | IrBinOp::UDiv | IrBinOp::SRem | IrBinOp::URem) => true,
+        Instruction::Cast { from_ty, to_ty, .. }
+            if (matches!(from_ty, IrType::I128 | IrType::U128) && to_ty.is_float())
+                || (from_ty.is_float() && matches!(to_ty, IrType::I128 | IrType::U128)) => true,
+        _ => false,
+    }
