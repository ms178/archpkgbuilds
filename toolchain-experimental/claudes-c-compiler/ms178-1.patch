+
+    // ── W3. NEW: encode_sbc accepts SP/WSP in any operand position ────────
+    #[test]
+    fn sbc_rejects_sp_wsp_in_any_position(
+        rd in 0u32..=30, rn in 0u32..=30, rm in 0u32..=30,
+        pos in 0u32..3u32, set_flags in any::<bool>(), vi in 0u32..=1u32,
+    ) {
