 src/backend/riscv/codegen/intrinsics.rs | 46 +++++++++++++++++++
 src/backend/riscv/codegen/memory.rs     | 61 ++++++++++++++++++++++++-
 6 files changed, 200 insertions(+), 4 deletions(-)

