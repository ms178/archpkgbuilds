+for opt in -O0 -O1 -O2 -O3 -Os -Oz; do
+    for mode in pragma flag both; do
+        flags=()
+        case $mode in
+            flag) flags=(-DNO_FENV_PRAGMA -ftrapping-math);;
+            both) flags=(-ftrapping-math);;
+        esac
+        "$ccc" "$opt" -march=x86-64-v3 -ffp-contract=off "${flags[@]}" "$src" -lm -o "$td/trap"
