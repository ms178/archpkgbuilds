+    for inst in insts {
+        match inst {
+            MachInst::Label(name) => {
+                defined_labels.insert(name.clone());
+            }
+            MachInst::Jmp { target } | MachInst::Jcc { target, .. } => {
+                if defined_labels.contains(target) {
+                    loop_headers.insert(target.clone());
+                }
+            }
+            _ => {}
+        }
+    }
+
