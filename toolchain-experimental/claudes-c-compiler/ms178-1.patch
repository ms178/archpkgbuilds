+/// The explicit AT&T destination: the operand after the last comma, or the
+/// only operand of a one-operand instruction.
+fn explicit_dest_token(t: &str) -> &str {
+    match t.rsplit_once(',') {
+        Some((_, last)) => last.trim(),
+        None => t
+            .split_once(char::is_whitespace)
+            .map_or("", |(_, op)| op.trim()),
