+            | "csrs"
+            | "csrc"
+            | "csrrw"
+            | "csrrs"
+            | "csrrc"
+            | "csrrwi"
+            | "csrrsi"
+            | "csrrci"
+    ) || m.starts_with("lr.")
+        || m.starts_with("sc.")
+        || m.starts_with("amo")
+}
