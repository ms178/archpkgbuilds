From 444286595852d9f52a6895a271bbf4ea8f4eb0f4 Mon Sep 17 00:00:00 2001
From: ms178 <19559105+ms178@users.noreply.github.com>
Date: Sun, 30 Aug 2026 01:18:08 +0000
Subject: [PATCH] codegen: reject float-involving casts in no-home
 materialization fallbacks
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

PR #306 (x86-64) and PR #308 (RISC-V) added consumer-side fallbacks that
materialize a home-less value through its defining instruction when that
is a Copy or a 'same-size' Cast, keyed only on from_ty.size() ==
to_ty.size(). Same-size float<->int casts are VALUE conversions, not
bitcasts: (long long)3.0 must cvttsd2si to 3, not re-publish the raw bits
0x4008000000000000; (double)ptr is cvtsi2sdq, not a movq bitcast (the
in-repo check_ptr_to_float_cast precedent). The unguarded fallback would
have silently miscompiled those shapes instead of failing the HARD GATE.

Every other same-size-cast fold in this repo (global_addr_cse.rs x2,
simplify.rs, generation.rs x2) already refuses float-involving pairs.
Centralize that rule as IrType::cast_is_bitidentical_nop (same size,
neither side floating) and use it at all three fallback sites:
x86-64 operand_to_rax, x86-64 value_to_reg_inner, and the RISC-V
operand-to-t0 port. Anything the predicate rejects still reaches the
loud HARD GATE — the session-26 soundness guarantee is preserved.

Unit tests pin both directions for every same-size type pair the IR's
lower_cast can emit (int no-ops accepted; F64<->I64, F32<->I32,
Ptr->F64, U128<->F128 rejected; size-changing casts always rejected).

Validation: cargo unit tests 3/3 new (+1314 total green); regression
suite 497/0/13 with zero fallback hits; boot gate PASS (_end 31184,
headroom 1584, ld.bfd oracle byte-identical) — the fix is
behavior-preserving hardening on all corpora.

Co-authored-by: arena-agent <297053741+arena-agent@users.noreply.github.com>
---
 src/backend/riscv/codegen/emit.rs |  8 +++-
 src/backend/x86/codegen/emit.rs   | 18 ++++++--
 src/common/types.rs               | 68 +++++++++++++++++++++++++++++++
 3 files changed, 90 insertions(+), 4 deletions(-)

diff --git a/src/backend/riscv/codegen/emit.rs b/src/backend/riscv/codegen/emit.rs
index 25657b62..9853b22b 100644
--- a/src/backend/riscv/codegen/emit.rs
+++ b/src/backend/riscv/codegen/emit.rs
@@ -440,6 +440,12 @@ impl RiscvCodegen {
                     // (U64<->I64 etc) or a Copy whose SOURCE has a home —
                     // materialize the source instead (x86-64
                     // print_cfs_group_stats precedent).
+                    //
+                    // Float-involving casts are value conversions
+                    // (fcvt.d.l / fcvt.l.d), never bit-identical re-labels —
+                    // cast_is_bitidentical_nop is the shared predicate the
+                    // repo's other same-size-cast folds honor; anything it
+                    // rejects still reaches the loud gate below.
                     let fallback_src: Option<Operand> = self
                         .get_defining_instruction(v.0)
                         .and_then(|def_inst| match def_inst {
@@ -449,7 +455,7 @@ impl RiscvCodegen {
                                 to_ty,
                                 ..
                             } => {
-                                if from_ty.size() == to_ty.size() {
+                                if IrType::cast_is_bitidentical_nop(*from_ty, *to_ty) {
                                     Some(src.clone())
                                 } else {
                                     None
diff --git a/src/backend/x86/codegen/emit.rs b/src/backend/x86/codegen/emit.rs
index 50e0f36a..c71c382b 100644
--- a/src/backend/x86/codegen/emit.rs
+++ b/src/backend/x86/codegen/emit.rs
@@ -1555,11 +1555,20 @@ impl X86Codegen {
                     // Load is cast to I64 for a Cmp Slt — the cast had no home
                     // due to RA coalesce miss, but its source does.
                     // Clone def info to avoid borrow conflicts.
+                    //
+                    // Float-involving casts are NOT bit-identical: (long
+                    // long)3.0 must cvttsd2si to 3, not re-publish the raw
+                    // bits 0x4008000000000000; (double)ptr is cvtsi2sdq, not
+                    // a movq bitcast (check_ptr_to_float_cast precedent).
+                    // cast_is_bitidentical_nop is the shared predicate every
+                    // other same-size-cast fold in this repo already honors;
+                    // anything it rejects still reaches the loud HARD GATE
+                    // below rather than silently fabricating wrong values.
                     let fallback_src = {
                         if let Some(def_inst) = self.get_defining_instruction(v.0) {
                             match def_inst {
                                 crate::ir::reexports::Instruction::Cast { src, from_ty, to_ty, .. } => {
-                                    if from_ty.size() == to_ty.size() {
+                                    if IrType::cast_is_bitidentical_nop(*from_ty, *to_ty) {
                                         Some(src.clone())
                                     } else {
                                         None
@@ -2432,12 +2441,15 @@ impl X86Codegen {
                 self.state.out.emit_instr_rbp_reg("    movq", slot.0, reg);
             }
         } else {
-            // Try to resolve through Copy or same-size Cast (U64<->I64 no-op)
+            // Try to resolve through Copy or same-size Cast (U64<->I64 no-op).
+            // Float-involving same-size casts are value conversions, never
+            // bitcasts — cast_is_bitidentical_nop is the shared predicate
+            // (see operand_to_rax's fallback for the full rationale).
             let source = self.get_defining_instruction(val.0).and_then(|inst| {
                 match inst {
                     crate::ir::reexports::Instruction::Copy { src, .. } => Some(src.clone()),
                     crate::ir::reexports::Instruction::Cast { src, from_ty, to_ty, .. }
-                        if from_ty.size() == to_ty.size() =>
+                        if IrType::cast_is_bitidentical_nop(*from_ty, *to_ty) =>
                     {
                         Some(src.clone())
                     }
diff --git a/src/common/types.rs b/src/common/types.rs
index 7994b231..6531dbb2 100644
--- a/src/common/types.rs
+++ b/src/common/types.rs
@@ -2092,6 +2092,23 @@ impl IrType {
         matches!(self, IrType::F128)
     }
 
+    /// Whether a `Cast` from `from` to `to` is a machine-level no-op whose
+    /// result is bit-identical to its source (same size, neither side
+    /// floating). This is the ONLY class of cast that consumer-side
+    /// materialization fallbacks may resolve through the source value.
+    ///
+    /// Same-size float<->int casts are VALUE conversions, not bitcasts:
+    /// `(long long)3.0` is cvttsd2si (result 3), while the bit pattern of
+    /// 3.0 is 0x4008000000000000; `(double)ptr` is cvtsi2sdq, while
+    /// `movq %rax,%xmm0` would re-interpret the address bits (the
+    /// check_ptr_to_float_cast precedent). The float guard mirrors the
+    /// in-repo convention: global_addr_cse.rs, simplify.rs and
+    /// generation.rs already refuse to fold float-involving same-size
+    /// casts for exactly this reason.
+    pub fn cast_is_bitidentical_nop(from: IrType, to: IrType) -> bool {
+        from.size() == to.size() && !from.is_float() && !to.is_float()
+    }
+
     /// Whether this is a 128-bit integer type (I128 or U128).
     pub fn is_128bit(&self) -> bool {
         matches!(self, IrType::I128 | IrType::U128)
@@ -2196,3 +2213,54 @@ impl IrType {
         }
     }
 }
+
+#[cfg(test)]
+mod cast_nop_tests {
+    use super::IrType;
+
+    /// The cast_is_bitidentical_nop predicate is the shared contract for every
+    /// consumer-side "materialize through the cast's source" fallback. A wrong
+    /// true here is a silent miscompile (bitcast instead of value conversion);
+    /// a wrong false is merely a missed optimization that falls back to the
+    /// loud HARD GATE. Pin both directions for every same-size type pair that
+    /// the IR's lower_cast can emit.
+    #[test]
+    fn same_size_int_casts_are_noops() {
+        // The print_cfs_group_stats shape (PR #306's intended case).
+        assert!(IrType::cast_is_bitidentical_nop(IrType::U64, IrType::I64));
+        assert!(IrType::cast_is_bitidentical_nop(IrType::I64, IrType::U64));
+        assert!(IrType::cast_is_bitidentical_nop(IrType::U32, IrType::I32));
+        assert!(IrType::cast_is_bitidentical_nop(IrType::U16, IrType::I16));
+        assert!(IrType::cast_is_bitidentical_nop(IrType::U8, IrType::I8));
+        // 128-bit integer sign flavors share a 16-byte representation.
+        assert!(IrType::cast_is_bitidentical_nop(IrType::U128, IrType::I128));
+    }
+
+    #[test]
+    fn same_size_float_int_casts_are_value_conversions() {
+        // (long long)d / (int)f — cvttsd2si/cvttss2si, NOT bitcasts.
+        assert!(!IrType::cast_is_bitidentical_nop(IrType::F64, IrType::I64));
+        assert!(!IrType::cast_is_bitidentical_nop(IrType::F32, IrType::I32));
+        // (double)ll / (float)i — cvtsi2sdq/cvtsi2ss.
+        assert!(!IrType::cast_is_bitidentical_nop(IrType::I64, IrType::F64));
+        assert!(!IrType::cast_is_bitidentical_nop(IrType::I32, IrType::F32));
+        // (double)ptr — the check_ptr_to_float_cast precedent (8 == 8 bytes).
+        assert!(!IrType::cast_is_bitidentical_nop(IrType::Ptr, IrType::F64));
+        // U128 carrier -> F128 (both 16 bytes on LP64): soft-float conversion.
+        assert!(!IrType::cast_is_bitidentical_nop(IrType::U128, IrType::F128));
+        assert!(!IrType::cast_is_bitidentical_nop(IrType::F128, IrType::U128));
+    }
+
+    #[test]
+    fn size_changing_casts_are_never_noops() {
+        // fpext/fptrunc and widening/narrowing all change the representation.
+        assert!(!IrType::cast_is_bitidentical_nop(IrType::F32, IrType::F64));
+        assert!(!IrType::cast_is_bitidentical_nop(IrType::F64, IrType::F32));
+        assert!(!IrType::cast_is_bitidentical_nop(IrType::I32, IrType::I64));
+        assert!(!IrType::cast_is_bitidentical_nop(IrType::I64, IrType::I32));
+        assert!(!IrType::cast_is_bitidentical_nop(IrType::I8, IrType::I32));
+        // i686: F128 is 12 bytes there but still a float — excluded by class.
+        assert!(!IrType::cast_is_bitidentical_nop(IrType::F128, IrType::F64));
+        assert!(!IrType::cast_is_bitidentical_nop(IrType::F64, IrType::F128));
+    }
+}
