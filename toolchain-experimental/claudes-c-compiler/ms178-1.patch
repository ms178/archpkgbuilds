+    int x;
+    int y = this->x+1;
+  };
+  struct D: B {
+    int d = B{this->x+2}.y;
+  };
+  constexpr int r = D{{1}}.d;
+  static_assert(r == 4);
+
+The front end produces IL for the cast "B{this->x+2}" that looks somewhat
+like the IL for "B{this->x+2, this->x+1}" (where the default initializer for
