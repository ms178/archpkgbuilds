+                IrType::F64 => IntrinsicOp::SqrtF64,
+                IrType::F32 => IntrinsicOp::SqrtF32,
+                _ => return None,
+            };
+            remainder_insts.push(Instruction::Intrinsic {
+                dest: Some(dest),
+                op: sqrt_op,
+                dest_ptr: None,
+                args: vec![inner],
+            });
+            Some(Operand::Value(dest))
+        }
+        MapExpr::BinOp(op, l, r) => {
+            let lhs = emit_map_scalar_tree(
+                l,
+                src_bases,
+                pattern,
+                byte_offset.clone(),
+                remainder_insts,
+                next_val_id,
