+            // Count same-class producers strictly between def and use.
+            let between = producer_positions[class as usize]
+                .iter()
+                .filter(|&&p| p > def_idx && p < use_idx)
+                .count();
+            if between > 0 {
+                out.insert(vid);
+            }
+        }
+    }
+    out
