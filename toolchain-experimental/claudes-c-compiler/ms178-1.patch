+        | O::Pshufb128
+        | O::Pmaxub128 | O::Pminub128
+        | O::Pmovzxbw128 | O::Pmovzxwd128
+        | O::Packssdw128 | O::Packsswb128 | O::Packuswb128
+        | O::Punpcklbw128 | O::Punpckhbw128
