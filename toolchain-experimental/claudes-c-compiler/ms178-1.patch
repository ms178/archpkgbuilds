From 4d5a1a5222233f903f8187ef91325ca5170f2ac6 Mon Sep 17 00:00:00 2001
From: LCCC agent <agent@lccc>
Date: Mon, 9 Nov 2026 23:35:45 +0000
Subject: [PATCH 1/3] sandbox: reconcile multiarch include members instead of
 replacing the directory

prepare_local_env.sh publishes the offloaded Debian 32-bit headers by making
/usr/include/i386-linux-gnu a symlink to the 64-bit multiarch tree.  On hosts
whose distribution owns that path as a REAL directory (linux-libc-dev ships
<asm/*.h> there) the script aborted with 'refusing to replace', which left
every -m32 gate without gnu/stubs.h, bits/, sys/ and the 32-bit crt/libc that
the same run is meant to publish.  Replacing the directory would be worse: it
would silently drop linux-libc-dev's 32-bit <asm/*.h>.

Reconcile the MEMBERS instead: when both sides are directories, publish each
missing top-level entry as a symlink INSIDE the existing directory and never
delete a pre-existing member.  Container-level symlinks keep the original
behaviour, so hosts that already pass are unaffected.
---
 engineering/verification/prepare_local_env.sh | 21 +++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/engineering/verification/prepare_local_env.sh b/engineering/verification/prepare_local_env.sh
index 791e089..5624ea8 100644
--- a/engineering/verification/prepare_local_env.sh
+++ b/engineering/verification/prepare_local_env.sh
@@ -18,6 +18,27 @@ link() { # link TARGET LINK_NAME
     [[ $(readlink -f "$name") == $(readlink -f "$target") ]] && return 0
     sudo rm -f -- "$name"
   elif [[ -e $name ]]; then
+    # A multiarch directory the distribution itself owns is a REAL directory,
+    # not something this script may replace: replacing /usr/include/
+    # i386-linux-gnu with a symlink to the 64-bit multiarch tree would silently
+    # drop linux-libc-dev's 32-bit <asm/*.h> (a -m32 include collapse), and on
+    # hosts where the same path is a symlink swapoff/ln -s would be a no-op
+    # churn.  Reconcile the MEMBERS instead of the container: every entry the
+    # offline extraction provides is published as a symlink INSIDE the existing
+    # directory, and pre-existing members are never deleted.  This keeps the
+    # 32-bit glibc headers reachable without touching distribution state.
+    if [[ -d $name && -d $target ]]; then
+      local member base
+      base=$(readlink -f -- "$name")
+      while IFS= read -r -d '' member; do
+        local src="$member"
+        local dst="$name/${member#"$target"/}"
+        [[ -e $dst || -L $dst ]] && continue
+        sudo mkdir -p -- "$(dirname "$dst")"
+        sudo ln -s -- "$src" "$dst"
+      done < <(find "$(readlink -f -- "$target")" -mindepth 1 -maxdepth 1 -print0)
+      return 0
+    fi
     echo "prepare_local_env.sh: $name exists and is not a symlink; refusing to replace" >&2
     return 1
   fi
-- 
2.47.3


