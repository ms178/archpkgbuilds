From 3d254e2f041d60fd9516b46724b3c18359f49f0c Mon Sep 17 00:00:00 2001
From: Arena Agent <agent@arena.ai>
Date: Sat, 15 Aug 2026 19:01:01 +0000
Subject: [PATCH 10/10] loop_memory_promote: aliasing LOADS block promotion,
 not just stores
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The alias check only scanned OTHER STORES for overlap with the promoted
location. A load through a DIFFERENT pointer value with the same
base+offset (the C frontend materializes duplicate GEPs routinely) kept
reading the memory location whose in-loop store the promotion removed —
stale data every iteration. sqlite 3.50.4 sqlite3FpDecode: the
trailing-zero trimmer  loaded p->n via
GEP#1 while the decrement was promoted via GEP#2; the loop never
terminated and every REAL literal hung the shell (SELECT 1.5 -> timeout).

Promotion now requires ALL other loads to be provably disjoint too
(same fail-closed disjoint() as stores). Regression test locks in the
duplicate-GEP trim-loop shape.

PROOF: sqlite3 shell passes a 10k-row workload (CTEs, indexes, GROUP
BY, LIKE, JOIN, UPDATE/DELETE, VACUUM, integrity_check, recursive
fib(40)) with output byte-identical to the system sqlite3.
---
 src/passes/loop_memory_promote.rs           | 12 ++++++++++++
 tests/regression/loop_mem_promote_dup_gep.c | 21 +++++++++++++++++++++
 2 files changed, 33 insertions(+)
 create mode 100644 tests/regression/loop_mem_promote_dup_gep.c

diff --git a/src/passes/loop_memory_promote.rs b/src/passes/loop_memory_promote.rs
index 9fb34509..42a40e60 100644
--- a/src/passes/loop_memory_promote.rs
+++ b/src/passes/loop_memory_promote.rs
@@ -135,6 +135,18 @@ pub(crate) fn run(func: &mut IrFunction) -> usize {
                     if !disjoint(&paths, ptr, load_ty, Value(other_ptr), *other_ty) { alias = true; }
                 }
             }
+            // OTHER LOADS through a different pointer value that aliases the
+            // promoted location must also block promotion: the in-loop store
+            // is removed, so such a load reads STALE memory. The C frontend
+            // routinely materializes the same field address twice (two GEPs
+            // with identical base+offset but different value ids) — sqlite
+            // sqlite3FpDecode's trailing-zero trimmer read p->n through one
+            // GEP while the decrement was promoted through the other,
+            // making `while(z[n-1]=='0') n--` an infinite loop.
+            for (&other_ptr, _other_loads) in &loads {
+                if other_ptr == ptr_id { continue; }
+                if !disjoint(&paths, ptr, load_ty, Value(other_ptr), load_ty) { alias = true; }
+            }
             if alias { continue; }
 
             let init = Value(func.next_value_id); func.next_value_id += 1;
diff --git a/tests/regression/loop_mem_promote_dup_gep.c b/tests/regression/loop_mem_promote_dup_gep.c
new file mode 100644
index 00000000..a496b244
--- /dev/null
+++ b/tests/regression/loop_mem_promote_dup_gep.c
@@ -0,0 +1,21 @@
+/* Regression: loop_memory_promote must treat a LOAD through a duplicate
+ * GEP (same base+offset, different value id) as an alias of the promoted
+ * location. The in-loop store is removed by promotion, so such a load
+ * read stale memory: sqlite3FpDecode's `while(z[n-1]=='0') n--;` spun
+ * forever (SELECT 1.5 hung). */
+#include <stdio.h>
+struct FpD { char sign; int n; int iDP; char *z; char zBuf[24]; };
+static void __attribute__((noinline)) trim(struct FpD *p) {
+    while (p->z[p->n - 1] == '0') {
+        p->n--;
+    }
+}
+int main(void){
+    struct FpD d;
+    d.n = 8;
+    d.z = d.zBuf;
+    __builtin_strcpy(d.zBuf, "15000000");
+    trim(&d);
+    printf("n=%d\n", d.n);
+    return d.n == 2 ? 0 : 1;
+}
