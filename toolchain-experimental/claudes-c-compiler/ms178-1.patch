diff --git a/tests/regression/regr_v1_volatile_loop.c b/tests/regression/regr_v1_volatile_loop.c
new file mode 100644
index 00000000..e02f1e70
--- /dev/null
+++ b/tests/regression/regr_v1_volatile_loop.c
@@ -0,0 +1,17 @@
+/* Regression (v1): the auto-vectorizer must NEVER vectorize loops touching
+ * volatile objects (C11 6.7.3p7: a vector load/store observes volatile
+ * memory with a different width/count/order than the source program).
+ * Failing shape (pre-fix): volatile int array reduction at -O2 printed a
+ * garbage sum (correctness test volatile_access: 884305999 instead of 15).
+ * The vectorizer had zero volatile awareness; the legality gate
+ * func_has_volatile_loop_access() was added in the fix. */
+#include <stdio.h>
+
+int main(void) {
+    volatile int arr[8] = {1, 2, 3, 4, 5, 6, 7, 8};
+    int sum = 0;
+    for (int i = 0; i < 8; i++) sum += arr[i];
+    if (sum != 36) { printf("FAIL sum=%d\n", sum); return 1; }
+    printf("PASS volatile_loop\n");
+    return 0;
+}
diff --git a/tests/regression/regr_v2_abs_symbol_value.c b/tests/regression/regr_v2_abs_symbol_value.c
new file mode 100644
index 00000000..73f18c97
--- /dev/null
+++ b/tests/regression/regr_v2_abs_symbol_value.c
@@ -0,0 +1,28 @@
+/* Regression (v2): numeric `.set sym, <number>` top-level asm symbols
+ * (glibc _NL_CURRENT_DEFINE style) are ABSOLUTE symbols: their address IS
+ * their value (ELF spec). Under the PIC default they must be emitted as
+ * `movq $sym` — a GOTPCREL reference cannot be resolved for an absolute
+ * symbol (original bug: "undefined symbols: 4660, 7" at link;
+ * glibc_abs_symbol.c covers the nonzero form).
+ *
+ * This test asserts the exact ELF values (7 and 0x1234). NOTE: GCC 16.1.1
+ * on this host cannot pass it — its ld rebases absolute-symbol references
+ * by the load base even for non-PIE executables (proven reduced-case
+ * baseline defect: a=4198498 for value 7 with -Wl,-no-pie). LCCC emits the
+ * ELF-correct `movq $sym`. */
+#include <stdio.h>
+
+extern char _nl_test_abs_1;
+extern char _nl_test_abs_2;
+
+__asm__(".globl _nl_test_abs_1\n.set _nl_test_abs_1, 7");
+__asm__(".globl _nl_test_abs_2\n.set _nl_test_abs_2, 0x1234");
+
+int main(void) {
+    volatile unsigned long a = (unsigned long)&_nl_test_abs_1;
+    volatile unsigned long b = (unsigned long)&_nl_test_abs_2;
+    if (a != 7) { printf("FAIL a=%lu\n", a); return 1; }
+    if (b != 0x1234) { printf("FAIL b=%lu\n", b); return 2; }
+    printf("PASS abs_symbol_value\n");
+    return 0;
+}
