+++ b/scripts/realmode_corpus.sh
@@ -17,6 +17,14 @@ K=${KERNEL_DIR:-/home/user/kernel-work/linux-6.18.44}
 
 cd "$K"
 
+# Fail loudly instead of silently measuring nothing: a snapshot-truncated
+# tree (the ~10k-file workspace cap truncates this 55k-file tree between
