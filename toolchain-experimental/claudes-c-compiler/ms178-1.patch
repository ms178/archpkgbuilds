+                eprintln!(
+                    "[VEC] exit comparison {op:?} (iv_on_left={iv_on_left}) has no exclusive-trip form; refusing"
+                );
+            }
+            return false;
+        }
+    };
+    // Materialise the exclusive bound.
+    let exclusive = if !inclusive {
+        bound
+    } else {
+        match &bound {
+            Operand::Const(c) => {
+                let Some(v) = c.to_i64() else { return false };
+                let Some(plus) = v.checked_add(1) else {
+                    if debug {
+                        eprintln!("[VEC] inclusive bound overflows the IV type; refusing");
+                    }
+                    return false;
+                };
+                let konst = match cmp_ty {
+                    IrType::I32 => {
+                        // `checked_add` above ran in i64, so `INT32_MAX + 1`
+                        // survived it -- and then `as i32` wrapped it to
+                        // INT32_MIN, making the loop bound a number the source
+                        // never wrote.  The range check has to be made in the
+                        // comparison's own type for the failure mode to be the
+                        // refusal this code claims it is.  (The PR #716 review
+                        // caught this; the bound is otherwise only reached by a
+                        // signed loop at INT32_MAX, which is UB in C, but a
+                        // contract that is not implemented is not a contract.)
+                        let Ok(narrow) = i32::try_from(plus) else {
+                            if debug {
+                                eprintln!("[VEC] inclusive bound does not fit i32; refusing");
+                            }
+                            return false;
+                        };
+                        IrConst::I32(narrow)
+                    }
+                    _ => IrConst::I64(plus),
+                };
+                Operand::Const(konst)
+            }
+            Operand::Value(v) => {
+                // Runtime bound: hoist `limit + 1` into the header, BEFORE the
+                // comparison that consumes it.  The operand is loop-invariant
+                // (the matcher requires it), so header placement dominates both
+                // the rewritten comparison and the scalar remainder.
+                let dest = Value(*next_val_id);
+                *next_val_id += 1;
+                let add = Instruction::BinOp {
+                    dest,
+                    op: IrBinOp::Add,
+                    lhs: Operand::Value(*v),
+                    rhs: Operand::Const(match cmp_ty {
+                        IrType::I32 => IrConst::I32(1),
+                        _ => IrConst::I64(1),
+                    }),
+                    ty: cmp_ty,
+                };
+                let Some(block) = func.blocks.get_mut(pattern.header_idx) else {
+                    return false;
+                };
+                block.instructions.insert(pattern.exit_cmp_inst_idx, add);
+                pattern.exit_cmp_inst_idx += 1; // the comparison moved one slot down
+                Operand::Value(dest)
+            }
+        }
+    };
+    let Some(block) = func.blocks.get_mut(pattern.header_idx) else {
+        return false;
+    };
+    let Some(Instruction::Cmp { op, .. }) = block.instructions.get_mut(pattern.exit_cmp_inst_idx)
+    else {
+        return false;
+    };
+    *op = new_op;
+    pattern.limit = exclusive;
+    true
+}
+
+/// Fail-closed operator guard for the REDUCTION transforms.
+///
+/// They consume the same `pattern.limit` under the same exclusive-trip
+/// convention, but their shapes and their byte/element arithmetic are their
+/// own; rather than rewrite their bound (which would need the same proof per
+/// transform), they accept only the comparisons that already ARE the canonical
+/// ascending exclusive test.  An inclusive or unsigned reduction bound simply
+/// stays scalar -- the reduction is not lost from the program, only its
+/// vectorization.  (The FMA path needs no equivalent: it normalizes.)
+///
+/// This is the guard the PR #716 review found DEAD: it was typed on
+/// `VectorizablePattern`, a type the reduction dispatch never has, and nothing
+/// called it -- so the claim in this comment was not being enforced anywhere.
+/// The reduction analyzer chooses its bound from the comparison's non-IV
+/// operand WITHOUT looking at the operator (`op: _`) while the transform
+/// divides that bound and preserves the operator, so an inclusive `<=` bound
+/// would be tested as if it were exclusive.  It is now called before any
+/// reduction mutation with the pattern the dispatch actually holds.
+fn reduction_exit_is_canonical(func: &IrFunction, pattern: &ReductionPattern) -> bool {
+    let Some(block) = func.blocks.get(pattern.header_idx) else {
+        return false;
+    };
+    let Some(Instruction::Cmp {
+        lhs, op, rhs, ty, ..
+    }) = block.instructions.get(pattern.exit_cmp_inst_idx)
+    else {
+        return false;
+    };
+    if !matches!(ty, IrType::I32 | IrType::I64) {
+        return false;
+    }
+    let iv = pattern.iv;
+    match (lhs, rhs) {
+        (Operand::Value(l), _) if *l == iv => matches!(op, IrCmpOp::Slt),
+        (_, Operand::Value(r)) if *r == iv => matches!(op, IrCmpOp::Sgt),
+        _ => false,
+    }
+}
+
+/// The instructions the matmul/FMA arm is allowed to vectorize inside a loop
+/// body.  This is an ALLOWLIST, and the direction is the entire point.
+///
+/// The check it replaces was a blacklist that named calls, atomics and
+/// volatile accesses and admitted everything else -- which is how `asm
+/// volatile` inside the loop body survived it.  Measured on the tree before
+/// this fix: the asm ran 16,384 times in a 64^3 kernel where the scalar loop
+/// runs it 262,144 times, because the vector body executes once per GROUP of
+/// elements while the side effect rode along on only one of them.  A blacklist
+/// has to anticipate every present and future effect; an allowlist only has to
+/// name what it has proven, and fails closed on everything else -- including
+/// IR variants that do not exist yet.
+///
+/// `Load`/`Store` match their own `volatile: false` here, so a volatile access
+/// is refused without a separate enumeration, and everything else with an
+/// effect (calls, `InlineAsm`, `Memcpy`, the atomic family, `Fence`, `Va*`,
+/// stack save/restore, non-local jumps, computed gotos, allocas) falls to the
+/// wildcard and is refused by construction.
+/// Is `limit` provably unchanged for the whole run of the loop?
+///
+/// The transform replaces the bound with a byte limit computed once -- and,
+/// when the trip count divides the vector width, deletes the remainder
+/// entirely -- so a bound that changes while the loop runs would be tested as
+/// a number the loop never respected.  The PR #716 review is right that the
+/// old code merely ASSERTED this: `analyze_loop_pattern` never checked it.
+///
+/// The proof is the ordinary one, stated in terms of the loop's own blocks:
+///
+///   * a constant, or a value defined OUTSIDE the loop, cannot change -- and
+///     SSA makes that check exact rather than a guess;
+///   * inside the loop, a `Phi` is loop-carried by construction (refused), and
+///     arithmetic is invariant exactly when its operands are (recursed);
+///   * a `Load` inside the loop is invariant exactly when no store in the loop
+///     can write its address -- proved with the same object-root machinery the
+///     matmul matcher already uses for the C/A/B alias question, and refused
+///     when either root cannot be established.
+///
+/// This is what keeps a `for (j = 0; j <= lim; j++)` loop with a global or
+/// parameter bound vectorizable (`lim` is re-loaded inside the header, which
+/// is invariant because the loop only writes C) while refusing the shape the
+/// review warned about, where the bound is carried and updated each iteration.
+fn limit_is_loop_invariant(
+    func: &IrFunction,
+    loop_blocks: &FxHashSet<usize>,
+    limit: &Operand,
+    depth: usize,
+) -> bool {
+    // Bounded recursion: a value graph deeper than this is not a bound we can
+    // describe, and "cannot describe" must mean "not vectorized".
+    if depth > 8 {
+        return false;
+    }
+    let Operand::Value(root) = limit else {
+        return true; // constant
+    };
+    let Some((defining, inst)) = loop_blocks.iter().find_map(|&bi| {
+        let block = func.blocks.get(bi)?;
+        block
+            .instructions
+            .iter()
+            .find(|inst| inst.dest() == Some(*root))
+            .map(|inst| (bi, inst))
+    }) else {
+        return true; // defined outside the loop: SSA guarantees stability
+    };
+    let _ = defining;
+    match inst {
+        // Loop-carried by construction.
+        Instruction::Phi { .. } => false,
+        // A pure computation of invariant inputs is invariant.
+        Instruction::Cast { src, .. } | Instruction::Copy { src, .. } => {
+            limit_is_loop_invariant(func, loop_blocks, src, depth + 1)
+        }
+        Instruction::UnaryOp { src, .. } => {
+            limit_is_loop_invariant(func, loop_blocks, src, depth + 1)
+        }
+        Instruction::BinOp { lhs, rhs, .. } | Instruction::Cmp { lhs, rhs, .. } => {
+            limit_is_loop_invariant(func, loop_blocks, lhs, depth + 1)
+                && limit_is_loop_invariant(func, loop_blocks, rhs, depth + 1)
+        }
+        Instruction::GetElementPtr { base, offset, .. } => {
+            // Address arithmetic moves no memory, so invariance is about the
+            // pointee: recurse into the base (a Phi base is loop-carried and
+            // refused above) and require the offset to be invariant too.
+            limit_is_loop_invariant(func, loop_blocks, &Operand::Value(*base), depth + 1)
+                && limit_is_loop_invariant(func, loop_blocks, offset, depth + 1)
+        }
+        // A load is invariant iff nothing in the loop stores to it.
+        Instruction::Load {
+            ptr,
+            volatile: false,
+            ..
+        } => {
+            let Some(load_root) = proven_object_root(func, *ptr) else {
+                return false;
+            };
+            for &bi in loop_blocks {
+                let Some(block) = func.blocks.get(bi) else {
+                    return false;
+                };
+                for other in &block.instructions {
+                    if let Instruction::Store { ptr: store_ptr, .. } = other {
+                        let Some(store_root) = proven_object_root(func, *store_ptr) else {
+                            return false;
+                        };
+                        if !roots_proven_distinct(&load_root, &store_root) {
+                            return false;
+                        }
+                    }
+                }
+            }
+            true
+        }
+        // Calls, intrinsics, volatile loads, allocas: nothing proven.
+        _ => false,
+    }
+}
+
+fn fma_body_instruction_is_legal(inst: &Instruction) -> bool {
+    match inst {
+        Instruction::Load {
+            volatile: false, ..
+        }
+        | Instruction::Store {
+            volatile: false, ..
+        }
+        | Instruction::BinOp { .. }
+        | Instruction::UnaryOp { .. }
+        | Instruction::Cmp { .. }
+        | Instruction::Cast { .. }
+        | Instruction::Copy { .. }
+        | Instruction::Select { .. }
+        | Instruction::GetElementPtr { .. }
+        | Instruction::Phi { .. }
+        | Instruction::GlobalAddr { .. }
+        | Instruction::ParamRef { .. } => true,
+        // A new IR instruction that IS per-element safe has to be added here
+        // deliberately, with the argument for why.
+        _ => false,
+    }
+}
+
