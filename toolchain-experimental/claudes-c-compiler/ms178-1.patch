From 9bc3bea3826e7afdefd8277e50e5195f557740ca Mon Sep 17 00:00:00 2001
From: lccc-agent <agent@arena.invalid>
Date: Sun, 18 Oct 2026 23:14:49 +0000
Subject: [PATCH 33/46] i686 peephole: EFLAGS liveness for the zero idiom and
 inc/dec rewrites

movl $0 -> xorl redefines EFLAGS and addl $1 -> incl keeps a stale CF;
both rewrites now ask flags_live_after (forward scan over the fallthrough,
direct jmp targets and conditional-branch forks, fail-closed on unmodeled
instructions). The old CF check saw only the next line and missed ja/jbe/
seta/cmova and non-adjacent adc/sbb. The hazard is latent in today's output
(0 flags-live movl $0 in 2024 -m32 asm files, 721 inc candidates all with
adjacent CF readers) and is proven real by a harness (xorl between cmpl and
sbbl: 352532/5297152 mismatches). Codegen cost: 0 -- all 1016 -m32 -O2
outputs byte-identical. Unit tests: classifier table, zero idiom live/dead,
jmp target, distant CF reader, branch-target CF reader.
---
 src/backend/i686/codegen/peephole.rs | 449 +++++++++++++++++++++++++--
 1 file changed, 422 insertions(+), 27 deletions(-)

diff --git a/src/backend/i686/codegen/peephole.rs b/src/backend/i686/codegen/peephole.rs
index 527785c2f..f52fa70a6 100644
--- a/src/backend/i686/codegen/peephole.rs
+++ b/src/backend/i686/codegen/peephole.rs
@@ -1105,39 +1105,265 @@ fn is_debug_location(store: &LineStore, infos: &[LineInfo], idx: usize) -> bool
         && syntax_of(store, infos, idx).split_whitespace().next() == Some(".loc")
 }
 
-/// Check if the next instruction reads the carry flag (CF).
-/// Instructions like `adcl`, `sbbl`, `rcl`, `rcr` depend on CF.
-/// `incl`/`decl` do NOT set CF (unlike `addl`/`subl`), so converting
-/// `addl $1` → `incl` or `subl $1` → `decl` is invalid when the next
-/// instruction reads CF.
-fn next_reads_carry_flag(store: &LineStore, infos: &[LineInfo], start: usize) -> bool {
-    let len = infos.len();
-    for j in (start + 1)..len {
+/// How one instruction touches EFLAGS, for the forward liveness scan.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum FlagUse {
+    /// Reads CF, possibly with other flags (jb/ja/setbe/cmovae, adc/sbb, ...).
+    Reads,
+    /// Reads arithmetic flags but never CF (je/jl/setne/cmovg/fcmove, ...).
+    ReadsNoCf,
+    /// Leaves no arithmetic flag of the previous state observable: each is
+    /// redefined or architecturally undefined (imul, bsf, div), and no
+    /// correct code depends on an undefined flag surviving.
+    WritesAll,
+    /// Defines every flag except CF (inc/dec).
+    WritesAllButCf,
+    /// Defines CF while some other flag survives (bt/bts/btr/btc keep ZF,
+    /// sahf keeps OF, clc/stc touch CF only).
+    WritesCf,
+    /// Leaves EFLAGS alone, or may leave it unchanged: moves, lea, push/pop,
+    /// x87 ops (FPU status word only), SSE data ops, `rep stos`, and shifts
+    /// by `%cl` (a zero count keeps the flags).
+    Neutral,
+    /// Flags are dead afterwards: call (clobbered by the callee under the
+    /// psABI) and ret.
+    Kills,
+    /// Unmodeled, or control leaves the fallthrough path (jmp, jecxz):
+    /// the scan must assume the flags are live.
+    Unknown,
+}
+
+/// The condition codes whose predicate involves CF.
+const CF_CONDS: [&str; 10] = ["b", "c", "nae", "ae", "nb", "nc", "be", "na", "a", "nbe"];
+
+const FLAG_CONDS: [&str; 30] = [
