+                                  f"rc={r.returncode} stderr={r.stderr.decode()[:200]!r}, "
+                                  f"want an error containing {msg!r}"))
+        else:
+            results.append(Result(name, "PASS"))
+    finally:
+        shutil.rmtree(td, ignore_errors=True)
+    return results
