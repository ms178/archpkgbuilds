+    /// exactness argument of `refresh_span` is checked this way over whole
+    /// corpora (torture suites, regression tests); it costs a full analysis
+    /// per edit, so it is off by default.
+    fn assert_matches_full_analysis(
+        &self,
+        store: &LineStore,
+        infos: &[LineInfo],
+        lo: usize,
+        hi: usize,
+    ) {
