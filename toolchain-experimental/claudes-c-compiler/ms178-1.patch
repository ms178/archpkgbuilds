+
+    #[test]
+    fn refuses_across_store_or_address_write() {
+        let asm = format!("{PRO}    movl (%rdi), %ecx\n    movl $1, (%rsi)\n    addl %ecx, %eax\n{EPI}");
+        let out = body(&run(&asm, fuse_load_into_alu));
+        assert!(has(&out, "movl (%rdi), %ecx"), "{out:?}");
