diff --git a/tests/regression/lib/gcc_oracle.sh b/tests/regression/lib/gcc_oracle.sh
new file mode 100644
index 00000000..24b02a6d
--- /dev/null
+++ b/tests/regression/lib/gcc_oracle.sh
@@ -0,0 +1,100 @@
+#!/usr/bin/env bash
+# Shared GCC-oracle policy for the named-address-space gates.
+#
+# The fixtures' verdicts were recorded against GCC 14.2, and that is the oracle
+# every seg gate compares against. The MAJOR VERSION is part of that contract:
+#   * GCC 13.3 (Ubuntu 24.04's default `gcc`, i.e. what `ubuntu-latest` runs)
+#     rejects `long __seg_gs *p = gobj.a;` as a non-constant initializer that
+#     GCC 14 accepts, and only warns on `qq = pp` for a pointee-chain space
+#     change that GCC 14 errors on. PR #803's Test Suite failed exactly this
+#     way: `gcc` on the runner was 13, the gate expected 14's verdict.
+#   * So a gate never runs against "whatever `gcc` is on PATH", and never
+#     against a newer GCC either: a later release may change a verdict, and the
+#     pin keeps the comparison reproducible.
+#
+# Resolution, in order:
+#   1. $GCC, if set. It must name an executable that reports major version 14,
+#      otherwise the gate fails (an explicit choice is never replaced).
+#   2. gcc-14 on PATH (the hosted workflow installs it explicitly).
+#   3. gcc on PATH, only if it reports major version 14.
+#
+# Policy when no GCC 14 oracle is found: FAIL, locally and under CI. A gate that
+# silently skipped its cross-check would print PASSED for a comparison that
+# never ran, so the absence is reported as the configuration error it is.
+#
+# Usage (from a gate script, run from the repository root):
+#   . tests/regression/lib/gcc_oracle.sh
+#   require_gcc_oracle "$gate_name" || exit 1
+#   gcc_oracle_positive_control "$CCC" "$tmp" || exit 1
+#   gcc_oracle_positive_control "$GCC_ORACLE_BIN" "$tmp" || exit 1
+#   "$GCC_ORACLE_BIN" -w -c -o "$tmp/g.o" fixture.c   # the oracle invocation
+#
+# Variables set by require_gcc_oracle (read by the sourcing gate):
+#   GCC_ORACLE_BIN  absolute path of the GCC 14 oracle binary
+#   GCC_ORACLE      always 1 after a successful require (kept for gates that
+#                   branch on it; a missing oracle now fails instead of 0)
+# shellcheck disable=SC2034  # both are consumed by the gates that source this file
+
+GCC_ORACLE_MAJOR=14
+
+# gcc_oracle_major <gcc-binary> -> the major version, or nothing.
+gcc_oracle_major() {
+    "$1" -dumpfullversion 2>/dev/null | cut -d. -f1
+}
+
+require_gcc_oracle() {
+    local gate=$1 cand bin major found=""
+    GCC_ORACLE=0
+    GCC_ORACLE_BIN=""
+    if [ -n "${GCC:-}" ]; then
+        # An explicit oracle that cannot be used is a configuration error,
+        # never a silent fallback to another compiler.
+        bin=$(command -v "$GCC" 2>/dev/null || true)
+        if [ -z "$bin" ]; then
+            echo "FAIL: $gate: GCC=$GCC is not an executable; the oracle is GCC $GCC_ORACLE_MAJOR (this gate requires GCC $GCC_ORACLE_MAJOR exactly)" >&2
+            return 1
+        fi
+        major=$(gcc_oracle_major "$bin")
+        if [ "$major" != "$GCC_ORACLE_MAJOR" ]; then
+            echo "FAIL: $gate: GCC=$GCC is GCC ${major:-?}; the oracle is GCC $GCC_ORACLE_MAJOR (this gate requires GCC $GCC_ORACLE_MAJOR exactly)" >&2
+            return 1
+        fi
+        GCC_ORACLE=1
+        GCC_ORACLE_BIN=$bin
+        return 0
+    fi
+    for cand in gcc-14 gcc; do
+        bin=$(command -v "$cand" 2>/dev/null || true)
+        [ -n "$bin" ] || continue
+        major=$(gcc_oracle_major "$bin")
+        if [ "$major" = "$GCC_ORACLE_MAJOR" ]; then
+            GCC_ORACLE=1
+            GCC_ORACLE_BIN=$bin
+            return 0
+        fi
+        found="${found:+$found, }$cand=GCC ${major:-?}"
+    done
+    echo "FAIL: $gate needs GCC $GCC_ORACLE_MAJOR as the verdict oracle; found: ${found:-none}." >&2
+    echo "      Install gcc-14 (apt install gcc-14), or set GCC=<path to gcc-14>." >&2
+    return 1
+}
+
+# gcc_oracle_positive_control <compiler> <tmpdir>
+# A named-space semantic positive control: the compiler must ACCEPT a valid
+# program that uses a __seg_gs object through a constant-address pointer. A
+# broken compiler or toolchain must not make the negative fixtures look like
+# valid rejections, so every compiler in a gate is checked this way first.
+gcc_oracle_positive_control() {
+    local compiler=$1 tmp=$2
+    cat > "$tmp/control.c" <<'C'
+struct S { long a[3]; };
+extern struct S __seg_gs object;
+long __seg_gs *p = object.a + 1;
+C
+    if ! "$compiler" -std=gnu11 -c "$tmp/control.c" -o "$tmp/control.o" >"$tmp/control.err" 2>&1; then
+        echo "FAIL: $compiler failed the named-space positive control" >&2
+        cat "$tmp/control.err" >&2
+        return 1
+    fi
+    return 0
+}
diff --git a/tests/regression/seg_conv/README.md b/tests/regression/seg_conv/README.md
new file mode 100644
index 00000000..b936ed53
--- /dev/null
+++ b/tests/regression/seg_conv/README.md
@@ -0,0 +1,62 @@
+# Named address-space conversion fixtures and oracle policy
+
+This directory holds the conversion fixtures for `__seg_gs` / `__seg_fs`
+pointers. Each file is compiled by lccc and by GCC 14.2 with `gcc -w`, and the
+file name is the expected verdict: `neg_*` must be rejected, `pos_*` accepted.
+
+**The oracle is GCC 14, by major version.** The verdicts were recorded against
+GCC 14.2. GCC 13.3, the default `gcc` on `ubuntu-latest`, disagrees on three
+fixtures (`pos_member_of_seg_obj.c`, `pos_member_plus_seg.c`,
+`neg_pointee_chain.c`), so every seg gate resolves the oracle through
+`tests/regression/lib/gcc_oracle.sh` and never runs a bare `gcc`.
+
+## What is oracle-compared
+
+- **Accept / reject** for every fixture and every row of `parity_table.tsv`.
+  lccc, the table, and GCC 14.2 must agree. A table that drifts from GCC fails
+  the gate (`check_seg_conversion_parity.sh`).
+- **Error versus warning class.** A shape GCC 14.2 errors on is an lccc error,
+  and a shape GCC only warns on is an lccc warning that still accepts. Example:
+  `q = (int *)gp` with `gp` in `__seg_gs`, a cast to a generic pointer from a
+  disjoint space. GCC 14.2 warns with `cast to generic address space pointer
+  from disjoint '__seg_gs' address space pointer`, and lccc emits the same
+  warning. `check_seg_cast_warning.sh` checks the class without `-w`. The
+  fixture gates compile with `-w`, so they check accept/reject only.
+
+## What is NOT oracle-compared
+
+- **Diagnostic wording.** lccc's messages name the types and the pointer level
+  (for example `at pointer level 2`), which GCC's do not. A reject must carry
+  an address-space, disjoint-space, or incompatible-pointer diagnostic, so a
+  reject for an unrelated reason cannot pass, but the text itself is lccc's
+  own and is not matched against GCC's.
+
+## Null pointer constants
+
+Only `(void *)0` (and `((void *)0)`, which is the same expression after parse)
+is exempt from the named-space check. This matches GCC 14.2: `(void *)0`,
+`0`, and `NULL` are accepted for a `__seg_gs` pointer; `(int *)0` and
+`(char *)0` are rejected.
+
+## Casts on the right-hand side
+
+A cast is judged by the type it produces, not exempted wholesale. `gp = (int
+*)q` is rejected because the cast result is generic, and
+`gp = (int __seg_gs *)q` is accepted because the cast names the segment.
+
+## Comparisons
+
+`==`, `!=`, `<`, `<=`, `>`, `>=` between pointers in different top-level
+pointee spaces are errors, with a null pointer constant exempt on either side.
+Only the top-level pointee space is compared, which matches GCC 14.2:
+`int __seg_gs **` against `int **` is accepted.
+
+## Running the gates
+
+The oracle resolves in this order: `$GCC` if set, then `gcc-14`, then `gcc` if
+it reports major version 14. An explicit `$GCC` of another major version is a
+failure. A missing GCC 14 is a failure everywhere, locally and under CI: a gate
+never prints PASSED for a cross-check that did not run. The conversion gates
+(`check_seg_conv_diagnostics.sh`, `check_seg_conversion_parity.sh`) run the
+named-space positive control on both compilers before any fixture, and invoke
+the resolved `$GCC_ORACLE_BIN`. See `tests/regression/lib/gcc_oracle.sh`.
