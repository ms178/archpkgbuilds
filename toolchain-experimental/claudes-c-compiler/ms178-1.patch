+check_present "narrowed full-domain: the folded constant" "$tmp/span_u8-body.s" 'mov[a-z]*\s+\$4,'
 "$ccc" -O2 "$tmp/span.c" -o "$tmp/span.bin" && "$tmp/span.bin"
