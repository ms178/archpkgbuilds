+        R3(k_min_swapped, DF, AF, BF);
+        R3(k_le_nofold, DF, AF, BF);
+        R3(k_ge_nofold, DF, AF, BF);
     }
+    R2A(k_clamp_head, DF, AF);
+    R2A(k_clamp01_seq, DF, AF);
     return 0;
 }
