+            Class::Memory => return None,
+            Class::SseUp if !matches!(prev, Class::Sse | Class::SseUp) => classes[i] = Class::Sse,
+            Class::X87Up if prev != Class::X87 => return None,
+            _ => {}
+        }
+    }
