+        want = "lib 12\n41 7 4\n"
+        for exe in ("main", "main_ref"):
+            for env in ({}, {"LD_BIND_NOW": "1"}):
+                env = dict(env, LD_LIBRARY_PATH=td)
+                r = sh([os.path.join(td, exe)], cwd=td, env=env)
+                out = r.stdout.decode()
