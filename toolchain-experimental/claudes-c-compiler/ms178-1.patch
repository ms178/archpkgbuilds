+                re_check = sh(["readelf", "-aW", out], cwd=td)
+                if re_check.returncode != 0 or re_check.stderr.strip():
+                    return Result(name, "FAIL", f"{arch} {flags}: readelf: {re_check.stderr.decode()[:200]}")
+                links[tuple(flags)] = out
