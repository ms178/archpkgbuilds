+popq %rbx
+.cfi_def_cfa_offset 8
+ret
+.cfi_endproc
+
+;;; section_bare_reentry
+# `.section NAME` (or empty flags) re-enters an existing section with its
+# attributes unchanged, as GCC does for .gcc_except_table.
+.section .foo,"a",@progbits
+.byte 1
+.text
+nop
+.section .foo
+.byte 2
+.section .foo,""
+.byte 3
+.section .bar,"aw",@nobits
+.zero 4
+.text
+.section .bar
+.zero 4
+
+;;; section_changed_attributes reject
+# Explicit contradicting flags are still an error.
+.section .foo,"a",@progbits
+.byte 1
+.section .foo,"aw",@progbits
+.byte 2
+
+;;; gcc_cleanup_personality_lsda
+# GCC 14 -O2 -fexceptions output for a function with a cleanup variable:
+# zPLR CIE with an indirect pcrel personality, a pcrel LSDA pointer,
+# `.gcc_except_table` with `.uleb128` label differences, bare section
+# re-entries and a COMDAT DW.ref personality slot.
+	.text
+	.section	.text.unlikely,"ax",@progbits
+.LCOLDB0:
+	.text
+.LHOTB0:
+	.p2align 4
+	.globl	f
+	.type	f, @function
+f:
+.LFB0:
+	.cfi_startproc
+	.cfi_personality 0x9b,DW.ref.__gcc_personality_v0
+	.cfi_lsda 0x1b,.LLSDA0
+	pushq	%rbp
+	.cfi_def_cfa_offset 16
+	.cfi_offset 6, -16
+	pushq	%rbx
+	.cfi_def_cfa_offset 24
+	.cfi_offset 3, -24
+	subq	$24, %rsp
+	.cfi_def_cfa_offset 48
+	leaq	12(%rsp), %rbx
+	movl	$0, 12(%rsp)
+	movq	%rbx, %rdi
+.LEHB0:
+	call	work@PLT
+.LEHE0:
+	movl	12(%rsp), %ebp
+	movq	%rbx, %rdi
+.LEHB1:
+	call	release@PLT
+.LEHE1:
+	addq	$24, %rsp
+	.cfi_remember_state
+	.cfi_def_cfa_offset 24
+	movl	%ebp, %eax
+	popq	%rbx
+	.cfi_def_cfa_offset 16
+	popq	%rbp
+	.cfi_def_cfa_offset 8
+	ret
+.L3:
