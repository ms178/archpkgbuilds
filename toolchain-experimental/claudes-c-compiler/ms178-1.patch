+            let b = &incoming[1];
+            let (const_arm, val_arm) = match (&a.0, &b.0) {
+                (Operand::Const(_), Operand::Value(_)) => (a, b),
+                (Operand::Value(_), Operand::Const(_)) => (b, a),
+                _ => continue,
+            };
