@@ -0,0 +1,487 @@
+//! DWARF sections and the section-header table in AArch64 links.
+//!
+//! Debug sections are never loaded. They follow the last segment in the file
+//! with address 0, and their relocations are resolved statically -- never
+//! through the GOT or PLT and never as dynamic relocations, even in a PIE or
+//! a shared object, because nothing reads them at run time. This is bfd's
+//! `elfNN_aarch64_relocate_section` treatment of sections without
+//! `SEC_ALLOC`, and the same design as `i686/linker/debug.rs`.
+
+use super::elf::*;
+use super::reloc::resolve_sym;
+use super::types::GlobalSymbol;
+use crate::backend::elf::{
+    SHT_DYNAMIC, SHT_DYNSYM, SHT_GNU_HASH, SHT_PROGBITS, SHT_RELA, SHT_STRTAB,
+};
+use crate::backend::linker_common::OutputSection;
+use crate::backend::linker_common::shdr::{ShdrSpec, SymSection, SymtabEntry};
+use crate::common::fx_hash::FxHashMap;
+
+type SectionMap = FxHashMap<(usize, usize), (usize, u64)>;
+
+/// Give each non-empty non-allocated output section a file offset starting
+/// at `file_end`, in output order; returns the new end of the file data.
+pub(super) fn place_debug_sections(
+    output_sections: &mut [OutputSection],
+    mut file_end: u64,
+) -> u64 {
+    for sec in output_sections
+        .iter_mut()
+        .filter(|s| s.flags & SHF_ALLOC == 0 && s.mem_size > 0)
+    {
+        file_end = file_end.next_multiple_of(sec.alignment.max(1));
+        sec.addr = 0;
+        sec.file_offset = file_end;
+        file_end += sec.mem_size;
+    }
+    file_end
+}
+
+/// Whether `(obj, shndx)` names a real input section that the link dropped
+/// (a COMDAT loser or a section collected by `--gc-sections`).
+fn dropped(section_map: &SectionMap, obj: usize, shndx: u16) -> bool {
+    shndx != SHN_UNDEF
+        && shndx != SHN_ABS
+        && shndx != SHN_COMMON
+        && shndx < 0xff00
+        && !section_map.contains_key(&(obj, usize::from(shndx)))
+}
+
+/// The address a debug relocation resolves `sym` to, or `None` when its
+/// definition was dropped, which takes the tombstone instead (bfd's
+/// `RELOC_AGAINST_DISCARDED_SECTION`).
+fn symbol_address(
+    obj_idx: usize,
+    sym: &Symbol,
+    globals: &FxHashMap<String, GlobalSymbol>,
+    section_map: &SectionMap,
+    output_sections: &[OutputSection],
+) -> Option<u64> {
+    let named_global = !sym.name.is_empty() && !sym.is_local() && sym.sym_type() != STT_SECTION;
+    if named_global {
+        if let Some(g) = globals.get(sym.name.as_str()) {
+            if let Some(d) = g.defined_in {
+                if d != usize::MAX && !g.is_dynamic && dropped(section_map, d, g.section_idx) {
+                    return None;
+                }
+            }
+        }
+    } else if dropped(section_map, obj_idx, sym.shndx) {
+        return None;
+    }
+    Some(resolve_sym(
+        obj_idx,
+        sym,
+        globals,
+        section_map,
+        output_sections,
+    ))
+}
+
+/// The field a debug relocation writes: its width, and the value for a
+/// symbol at `s` with addend `a` and place `p` (the offset in the output
+/// debug section, whose address is 0). Overflow follows bfd's howtos:
+/// `ABS32` is `complain_overflow_bitfield`, `PREL32` is signed.
+fn debug_field(rel_type: u32, s: u64, a: i64, p: u64) -> Result<(usize, u64), String> {
+    let sa = i128::from(s) + i128::from(a);
+    let fits = |v: i128, lo: i128, hi: i128, what: &str| {
+        if (lo..=hi).contains(&v) {
+            Ok(v as u64)
+        } else {
+            Err(format!(
+                "{what} value 0x{v:x} does not fit in a debug section field"
+            ))
+        }
+    };
+    match rel_type {
+        R_AARCH64_ABS64 => Ok((8, sa as u64)),
+        R_AARCH64_ABS32 => Ok((4, fits(sa, -(1 << 31), (1 << 32) - 1, "R_AARCH64_ABS32")?)),
+        R_AARCH64_PREL64 => Ok((8, (sa - i128::from(p)) as u64)),
+        R_AARCH64_PREL32 => Ok((
+            4,
+            fits(
+                sa - i128::from(p),
+                -(1 << 31),
+                (1 << 31) - 1,
+                "R_AARCH64_PREL32",
+            )?,
+        )),
+        other => Err(format!(
+            "relocation type {other} is not supported in a debug section"
+        )),
+    }
+}
+
+fn field_width(rel_type: u32) -> Option<usize> {
+    match rel_type {
+        R_AARCH64_ABS64 | R_AARCH64_PREL64 => Some(8),
+        R_AARCH64_ABS32 | R_AARCH64_PREL32 => Some(4),
+        _ => None,
+    }
+}
+
+/// Resolve the relocations of every debug input section in `out`, which
+/// already holds the sections' data at their file offsets. References into
+/// dropped sections get bfd's tombstone: 0, or 1 in `.debug_ranges` and
+/// `.debug_loc`, where a 0 pair would end the list.
+pub(super) fn apply_debug_relocations(
+    objects: &[ElfObject],
+    globals: &FxHashMap<String, GlobalSymbol>,
+    section_map: &SectionMap,
+    output_sections: &[OutputSection],
+    out: &mut [u8],
+) -> Result<(), String> {
+    for (obj_idx, obj) in objects.iter().enumerate() {
+        for (sec_idx, relas) in obj.relocations.iter().enumerate() {
+            if relas.is_empty() {
+                continue;
+            }
+            let Some(&(out_idx, base)) = section_map.get(&(obj_idx, sec_idx)) else {
+                continue;
+            };
+            let osec = &output_sections[out_idx];
+            if osec.flags & SHF_ALLOC != 0 {
+                continue;
+            }
+            let tombstone = match osec.name.as_str() {
+                ".debug_ranges" | ".debug_loc" => 1,
+                _ => 0,
+            };
+            let sec_name = &obj.sections[sec_idx].name;
+            for rela in relas {
+                if rela.rela_type == R_AARCH64_NONE {
+                    continue;
+                }
+                let sym = obj.symbols.get(rela.sym_idx as usize).ok_or_else(|| {
+                    format!(
+                        "{}: invalid symbol index {} in a relocation of {sec_name}",
+                        obj.source_name, rela.sym_idx
+                    )
+                })?;
+                let place = base + rela.offset;
+                let (width, value) =
+                    match symbol_address(obj_idx, sym, globals, section_map, output_sections) {
+                        None => (
+                            field_width(rela.rela_type).ok_or_else(|| {
+                                format!(
+                                    "{}: relocation type {} in {sec_name} is not supported \
+                                     in a debug section",
+                                    obj.source_name, rela.rela_type
+                                )
+                            })?,
+                            tombstone,
+                        ),
+                        Some(s) => debug_field(rela.rela_type, s, rela.addend, place)
+                            .map_err(|e| format!("{}: {sec_name}: {e}", obj.source_name))?,
+                    };
+                let end = place + width as u64;
+                if end > osec.mem_size {
+                    return Err(format!(
+                        "{}: relocation at 0x{:x} is outside {sec_name}",
+                        obj.source_name, rela.offset
+                    ));
+                }
+                let at = (osec.file_offset + place) as usize;
+                out[at..at + width].copy_from_slice(&value.to_le_bytes()[..width]);
+            }
+        }
+    }
+    Ok(())
+}
+
+/// Section headers for the output sections, in address order, followed by
+/// the synthesized sections in `extra` (sorted in with them when allocated)
+/// and the debug sections in output order.
+pub(super) fn section_headers(
+    output_sections: &[OutputSection],
+    extra: Vec<ShdrSpec>,
+) -> Vec<ShdrSpec> {
+    let mut alloc: Vec<ShdrSpec> = output_sections
+        .iter()
+        .filter(|s| s.flags & SHF_ALLOC != 0 && s.mem_size > 0)
+        .map(|s| ShdrSpec {
+            align: s.alignment.max(1),
+            ..ShdrSpec::new(
+                &s.name,
+                s.sh_type,
+                s.flags,
+                s.addr,
+                s.file_offset,
+                s.mem_size,
+            )
+        })
+        .chain(
+            extra
+                .iter()
+                .filter(|s| s.flags & SHF_ALLOC != 0 && s.size > 0)
+                .cloned(),
+        )
+        .collect();
+    alloc.sort_by_key(|s| (s.addr, s.sh_type == SHT_NOBITS));
+    alloc.extend(
+        output_sections
+            .iter()
+            .filter(|s| s.flags & SHF_ALLOC == 0 && s.mem_size > 0)
+            .map(|s| ShdrSpec {
+                align: s.alignment.max(1),
+                ..ShdrSpec::new(&s.name, s.sh_type, s.flags, 0, s.file_offset, s.mem_size)
+            }),
+    );
+    alloc.extend(extra.into_iter().filter(|s| s.flags & SHF_ALLOC == 0));
+    alloc
+}
+
+/// A synthesized allocated section: `.got`, `.got.plt`, `.iplt`,
+/// `.rela.plt`, `.eh_frame_hdr`.
+pub(super) fn synthetic(
+    name: &str,
+    flags: u64,
+    addr: u64,
+    offset: u64,
+    size: u64,
+    align: u64,
+) -> ShdrSpec {
+    let (sh_type, entsize) = if name.starts_with(".rela") {
+        (SHT_RELA, 24)
+    } else if name.starts_with(".got") {
+        (SHT_PROGBITS, 8)
+    } else {
+        (SHT_PROGBITS, 0)
+    };
+    ShdrSpec {
+        align,
+        entsize,
+        ..ShdrSpec::new(name, sh_type, flags | SHF_ALLOC, addr, offset, size)
+    }
+}
+
+/// A synthesized section's address, file offset and size.
+pub(super) type Span = (u64, u64, u64);
+
+/// The dynamic-linking sections a dynamic executable or shared object
+/// synthesizes. Empty spans are dropped by `section_headers`.
+pub(super) struct DynamicSections {
+    pub interp: Span,
+    pub gnu_hash: Span,
+    pub dynsym: Span,
+    pub dynstr: Span,
+    pub rela_dyn: Span,
+    pub rela_plt: Span,
+    pub plt: Span,
+    pub dynamic: Span,
+    pub got: Span,
+    pub got_plt: Span,
+    pub eh_frame_hdr: Span,
+}
+
+/// Headers for `d`, linked the way the gABI requires: `.dynsym` to
+/// `.dynstr` (`sh_info` 1: only the null symbol is local), the hash table
+/// and the relocation tables to `.dynsym`, `.dynamic` to `.dynstr`.
+pub(super) fn dynamic_headers(d: &DynamicSections) -> Vec<ShdrSpec> {
+    let mk =
+        |name: &str, sh_type, flags, (addr, offset, size): Span, link, info, align, entsize| {
+            ShdrSpec {
+                link,
+                info,
+                align,
+                entsize,
+                ..ShdrSpec::new(name, sh_type, flags | SHF_ALLOC, addr, offset, size)
+            }
+        };
+    vec![
+        mk(".interp", SHT_PROGBITS, 0, d.interp, None, 0, 1, 0),
+        mk(
+            ".gnu.hash",
+            SHT_GNU_HASH,
+            0,
+            d.gnu_hash,
+            Some(".dynsym"),
+            0,
+            8,
+            0,
+        ),
+        mk(
+            ".dynsym",
+            SHT_DYNSYM,
+            0,
+            d.dynsym,
+            Some(".dynstr"),
+            1,
+            8,
+            24,
+        ),
+        mk(".dynstr", SHT_STRTAB, 0, d.dynstr, None, 0, 1, 0),
+        mk(
+            ".rela.dyn",
+            SHT_RELA,
+            0,
+            d.rela_dyn,
+            Some(".dynsym"),
+            0,
+            8,
+            24,
+        ),
+        mk(
+            ".rela.plt",
+            SHT_RELA,
+            0,
+            d.rela_plt,
+            Some(".dynsym"),
+            0,
+            8,
+            24,
+        ),
+        mk(".plt", SHT_PROGBITS, SHF_EXECINSTR, d.plt, None, 0, 16, 16),
+        mk(
+            ".dynamic",
+            SHT_DYNAMIC,
+            SHF_WRITE,
+            d.dynamic,
+            Some(".dynstr"),
+            0,
+            8,
+            16,
+        ),
+        mk(".got", SHT_PROGBITS, SHF_WRITE, d.got, None, 0, 8, 8),
+        mk(
+            ".got.plt",
+            SHT_PROGBITS,
+            SHF_WRITE,
+            d.got_plt,
+            None,
+            0,
+            8,
+            8,
+        ),
+        mk(
+            ".eh_frame_hdr",
+            SHT_PROGBITS,
+            0,
+            d.eh_frame_hdr,
+            None,
+            0,
+            4,
+            0,
+        ),
+    ]
+}
+
+/// The section header whose address range holds `value`, by name.
+fn section_of(headers: &[ShdrSpec], value: u64) -> SymSection {
+    headers
+        .iter()
+        .filter(|h| h.flags & SHF_ALLOC != 0)
+        .find(|h| h.addr <= value && value < h.addr + h.size)
+        .or_else(|| {
+            // An end symbol (`_end`, `__bss_end__`) names the end of the
+            // last section it follows.
+            headers
+                .iter()
+                .filter(|h| h.flags & SHF_ALLOC != 0)
+                .find(|h| value == h.addr + h.size)
+        })
+        .map_or(SymSection::Abs, |h| SymSection::Named(h.name.clone()))
+}
+
+/// The static symbol table: local functions and objects of every input,
+/// then every defined, non-imported global -- the x86-64 linker's policy.
+/// AArch64 mapping symbols (`$x`, `$d`) and assembler locals stay out.
+pub(super) fn symtab(
+    objects: &[ElfObject],
+    globals: &FxHashMap<String, GlobalSymbol>,
+    section_map: &SectionMap,
+    output_sections: &[OutputSection],
+    headers: &[ShdrSpec],
+) -> Vec<SymtabEntry> {
+    let mut entries = Vec::new();
+    for (obj_idx, obj) in objects.iter().enumerate() {
+        for sym in &obj.symbols {
+            let ty = sym.sym_type();
+            if !sym.is_local()
+                || !(ty == STT_FUNC || ty == STT_OBJECT)
+                || sym.name.is_empty()
+                || sym.name.starts_with(".L")
+                || sym.name.starts_with('$')
+            {
+                continue;
+            }
+            let Some(&(oi, so)) = section_map.get(&(obj_idx, usize::from(sym.shndx))) else {
+                continue;
+            };
+            let value = output_sections[oi].addr + so + sym.value;
+            entries.push(SymtabEntry {
+                name: sym.name.to_string(),
+                info: sym.info,
+                other: sym.other,
+                section: section_of(headers, value),
+                value,
+                size: sym.size,
+            });
+        }
+    }
+    let mut names: Vec<&String> = globals
+        .iter()
+        .filter(|(_, g)| g.defined_in.is_some() && !g.is_dynamic)
+        .map(|(n, _)| n)
+        .collect();
+    names.sort();
+    for name in names {
+        let g = &globals[name];
+        let section = if g.section_idx == SHN_ABS && g.defined_in != Some(usize::MAX) {
+            SymSection::Abs
+        } else {
+            section_of(headers, g.value)
+        };
+        entries.push(SymtabEntry {
+            name: name.clone(),
+            info: g.info,
+            other: 0,
+            section,
+            value: g.value,
+            size: g.size,
+        });
+    }
+    entries
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn debug_field_arithmetic() {
+        assert_eq!(
+            debug_field(R_AARCH64_ABS64, 0x400100, 8, 0).unwrap(),
+            (8, 0x400108)
+        );
+        assert_eq!(debug_field(R_AARCH64_ABS32, 0x40, 4, 0).unwrap(), (4, 0x44));
+        // bitfield overflow: a negative 32-bit value fits, 2^32 does not.
+        assert!(debug_field(R_AARCH64_ABS32, 0, -1, 0).is_ok());
+        assert!(debug_field(R_AARCH64_ABS32, 1 << 32, 0, 0).is_err());
+        // PREL32 inside one debug section: S and P are both offsets.
+        assert_eq!(
+            debug_field(R_AARCH64_PREL32, 0x30, 0, 0x10).unwrap(),
+            (4, 0x20)
+        );
+        assert!(debug_field(R_AARCH64_PREL32, 0x1_0000_0000, 0, 0).is_err());
+        assert!(debug_field(R_AARCH64_NONE + 1, 0, 0, 0).is_err());
+    }
+
+    #[test]
+    fn end_symbols_name_the_section_they_close() {
+        let h = vec![
+            ShdrSpec::new(".text", 1, SHF_ALLOC | SHF_EXECINSTR, 0x1000, 0x1000, 0x100),
+            ShdrSpec::new(
+                ".bss",
+                SHT_NOBITS,
+                SHF_ALLOC | SHF_WRITE,
+                0x3000,
+                0x2000,
+                0x40,
+            ),
+        ];
+        assert_eq!(section_of(&h, 0x1010), SymSection::Named(".text".into()));
+        assert_eq!(section_of(&h, 0x3040), SymSection::Named(".bss".into()));
+        assert_eq!(section_of(&h, 0x9000), SymSection::Abs);
+    }
+}
