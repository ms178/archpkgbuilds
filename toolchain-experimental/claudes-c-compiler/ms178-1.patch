+                let dest = self.fresh();
+                self.vec_insts.push(Instruction::Intrinsic {
+                    dest: Some(dest),
+                    op: vec_op,
+                    dest_ptr: None,
+                    args: vec![Operand::Value(lv), Operand::Value(rv)],
+                });
+                Some(dest)
+            }
+        }
