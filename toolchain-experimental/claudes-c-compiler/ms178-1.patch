index 3bc47874..d29b0740 100644
--- a/src/backend/elf_writer_common.rs
+++ b/src/backend/elf_writer_common.rs
@@ -2460,16 +2460,40 @@ impl<A: X86Arch> ElfWriterCore<A> {
                 // Handle SymbolDiff relocations
