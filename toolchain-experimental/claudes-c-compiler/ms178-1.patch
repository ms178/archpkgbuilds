+    if kind == "init":
+        return gen_init_braces(depth), b""
+    if kind == "record":
+        source = gen_record_nesting(depth, True)
+        old_main = "int main(void) { return 0; }"
+        new_main = (
+            "top value;\n"
+            "int main(void) { return (int)sizeof(value) - 4; }"
+        )
+        if old_main not in source:
+            raise AssertionError("named-record generator shape changed")
+        # Force sema/layout to descend through every nested record. Merely
+        # declaring the typedef chain would let lazy layout evade the test.
+        return source.replace(old_main, new_main), b""
+    if kind == "binary":
+        return gen_flat_add_chain(depth), b""
+    if kind == "postfix":
+        return gen_postfix_member_chain(depth), b""
+    if kind == "declarator":
+        return gen_parenthesized_declarator(depth), b""
+    if kind == "abstract":
+        return gen_abstract_declarator(depth), b""
+    if kind == "fnptr_params":
+        return gen_function_pointer_param_chain(depth), b""
+    if kind == "typeof":
+        return gen_typeof_type_chain(depth), b""
+    raise ValueError(f"unknown boundary kind: {kind}")
+
+
+def check_case(
+    name: str,
+    kind: str,
+    depth: int,
+    max_depth: int,
+    lccc: str,
+    cc: str,
+    tmp: Path,
+    timeout: int,
+) -> bool:
+    source, expected_stdout = make_source(kind, depth)
+    c_path = tmp / f"{name}.c"
+    asm_path = tmp / f"{name}.s"
+    binary = tmp / name
+    c_path.write_text(source)
+
+    try:
+        compile_result = subprocess.run(
+            [lccc, "-O0", "-S", "-o", str(asm_path), str(c_path)],
+            capture_output=True,
+            timeout=timeout,
+        )
+    except subprocess.TimeoutExpired:
+        print(f"  FAIL {name}: compiler timed out at source depth {depth}")
+        return False
+    if compile_result.returncode != 0:
+        detail = compile_result.stderr.decode(errors="replace").splitlines()[:3]
+        print(
+            f"  FAIL {name}: compiler rc={compile_result.returncode} at "
+            f"{depth}/{max_depth} source levels: {detail}"
+        )
+        return False
+    compiler_warnings = [
+        line for line in compile_result.stderr.decode(errors="replace").splitlines()
+        if "warning:" in line.lower()
+    ]
+    if compiler_warnings:
+        print(f"  FAIL {name}: compiler warning(s): {compiler_warnings[:3]}")
+        return False
+
+    try:
+        link_result = subprocess.run(
+            [cc, str(asm_path), "-o", str(binary)],
+            capture_output=True,
+            timeout=timeout,
+        )
+    except subprocess.TimeoutExpired:
+        print(f"  FAIL {name}: linker timed out")
+        return False
+    if link_result.returncode != 0:
+        detail = link_result.stderr.decode(errors="replace").splitlines()[:3]
+        print(f"  FAIL {name}: link rc={link_result.returncode}: {detail}")
+        return False
+    linker_warnings = [
+        line for line in link_result.stderr.decode(errors="replace").splitlines()
+        if "warning:" in line.lower()
+    ]
+    if linker_warnings:
+        print(f"  FAIL {name}: linker warning(s): {linker_warnings[:3]}")
+        return False
+
+    try:
+        run_result = subprocess.run(
+            [str(binary)], capture_output=True, timeout=timeout
+        )
+    except subprocess.TimeoutExpired:
+        print(f"  FAIL {name}: executable timed out")
+        return False
+    if run_result.returncode != 0 or run_result.stdout != expected_stdout:
+        print(
+            f"  FAIL {name}: runtime rc={run_result.returncode}, "
+            f"stdout={run_result.stdout[:120]!r}, expected={expected_stdout!r}"
+        )
+        return False
+
+    pct = depth / max_depth * 100.0
+    print(
+        f"  ok   {name}: depth {depth}/{max_depth} ({pct:.2f}% of admitted "
+        "source depth), compile + link + run"
+    )
+    return True
+
+
+def selftest() -> int:
+    for name, kind, depth, max_depth in CASES:
+        assert 94.9 <= depth / max_depth * 100.0 <= 95.0, (name, depth, max_depth)
+        source, _ = make_source(kind, depth)
+        assert source and "main" in source
+    record_source, _ = make_source("record", 2)
+    assert "sizeof(value) - 4" in record_source
+    assert "struct t1" in record_source
+    assert make_source("binary", 3)[0].count("+") == 2
+    assert make_source("postfix", 3)[0].count("->") == 3
+    assert "sizeof(int ((*)))" in make_source("abstract", 2)[0]
+    assert make_source("fnptr_params", 2)[0].startswith(
+        "int f(int (*p0)(int (*p1)(int)));"
+    )
+    print("nesting pipeline-boundary selftest: PASS (10 valid cases at ~95%)")
+    return 0
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("--lccc", default="target/fastbuild/lccc")
+    ap.add_argument("--cc", default=os.environ.get("CC", "gcc"))
+    ap.add_argument("--timeout", type=int, default=120)
+    ap.add_argument("--selftest", action="store_true")
+    args = ap.parse_args()
+    if args.selftest:
+        return selftest()
+    if not Path(args.lccc).exists():
+        print(f"FATAL: compiler not found: {args.lccc}", file=sys.stderr)
+        return 1
+
+    ok = True
+    with tempfile.TemporaryDirectory(prefix="lccc_nesting_pipeline_") as td:
+        tmp = Path(td)
+        for name, kind, depth, max_depth in CASES:
+            ok &= check_case(
+                name, kind, depth, max_depth, args.lccc, args.cc, tmp, args.timeout
+            )
+    print("nesting pipeline-boundaries: " + ("PASS" if ok else "FAIL"))
+    return 0 if ok else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
