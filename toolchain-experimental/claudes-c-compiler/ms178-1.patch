+                    (Operand::Immediate(_), Operand::Register(_)) if mnemonic == "urdmsr" => {
+                        Some("urdmsr_imm")
+                    }
+                    (Operand::Register(_), Operand::Immediate(_)) if mnemonic == "uwrmsr" => {
