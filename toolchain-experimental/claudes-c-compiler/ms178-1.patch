+
+        let guard = u32::try_from(ALWAYS_INLINE_GUARD_INSTRUCTIONS).unwrap();
+        let mut huge = body("generated", &[], guard + 1);
+        huge.is_static = true;
+        huge.is_inline = true;
+        huge.is_always_inline = true;
+        assert!(callee_data_for(&huge, &module, &quiet_context()).is_none());
