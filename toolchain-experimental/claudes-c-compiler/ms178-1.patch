diff --git a/tests/regression/fma_chain_accum.c b/tests/regression/fma_chain_accum.c
new file mode 100644
index 0000000..d96e61e
--- /dev/null
+++ b/tests/regression/fma_chain_accum.c
@@ -0,0 +1,11 @@
+double dot4(const double *a, const double *b) {
+    double s = 0.0;
+    for (int i = 0; i < 4; i++) s = s + a[i] * b[i];
+    return s;
+}
+int main(void) {
+    double a[4] = {1,2,3,4}, b[4] = {5,6,7,8};
+    double s = dot4(a, b);
+    if (s < 69.9 || s > 70.1) return 1;
+    return 0;
+}
diff --git a/tests/regression/fma_scalar_muladd.c b/tests/regression/fma_scalar_muladd.c
new file mode 100644
index 0000000..24198cf
--- /dev/null
+++ b/tests/regression/fma_scalar_muladd.c
@@ -0,0 +1,12 @@
+double madd(double a, double b, double c) { return a * b + c; }
+float maddf(float a, float b, float c) { return a * b + c; }
+int main(void) {
+    double d = madd(1.5, 2.5, 3.5);
+    if (d < 7.24 || d > 7.26) return 1;
+    float f = maddf(1.5f, 2.5f, 3.5f);
+    if (f < 7.24f || f > 7.26f) return 2;
+    double dx = 3.0, dy = 4.0;
+    double r2 = dx * dx + dy * dy;
+    if (r2 < 24.9 || r2 > 25.1) return 3;
+    return 0;
+}
