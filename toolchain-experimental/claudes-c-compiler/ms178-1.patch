 tests/fuzz/aarch64_fuzz.py | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/tests/fuzz/aarch64_fuzz.py b/tests/fuzz/aarch64_fuzz.py
