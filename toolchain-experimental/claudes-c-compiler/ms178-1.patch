+    /// `xmm0..2` / `ymm0..2`.  Returns `None` for anything unrecognised so a
+    /// new scratch register fails loudly instead of being waved through.
+    fn which_operand(reg: &str) -> Option<u32> {
+        let bare = reg.trim_start_matches('%');
+        for id in 0..3u32 {
+            if bare == home(id) {
+                return Some(id);
+            }
+            for prefix in ["xmm", "ymm", "zmm"] {
+                if bare == format!("{prefix}{id}") {
+                    return Some(id);
+                }
+            }
+        }
+        None
+    }
+
+    /// Every spelling must compute `a*b + c`, i.e. place `c` in the
+    /// destination for 231, `a` and `b` as multiplicands for 213, and `a` in
+    /// the destination for 132.
+    #[test]
+    fn every_fma_spelling_places_the_addend_where_its_digits_require() {
+        for (width, is_256) in [("128", false), ("256", true)] {
+            for (name, op) in spellings(width) {
+                let mut cg = X86Codegen::new();
+                for id in 0..3u32 {
+                    distinct_slot_vector(&mut cg, id);
+                }
+                distinct_slot_vector(&mut cg, 9);
+                let args = [
+                    Operand::Value(Value(0)),
+                    Operand::Value(Value(1)),
+                    Operand::Value(Value(2)),
+                ];
+                if is_256 {
+                    cg.emit_avx_fp_256_op(&Value(9), &op, &args);
+                } else {
+                    cg.emit_sse_fp_128_op(&Value(9), &op, &args);
+                }
+                let out = cg.state.out.buf.clone();
+                let (got, rm, vvvv, dst) =
+                    parse_fma(&out).unwrap_or_else(|| panic!("{name}: no vfmadd* in {out:?}"));
+                assert_eq!(
+                    fma_role_order(&got),
+                    fma_role_order(&name),
+                    "{name}: emitted a different permutation ({got}): {out}"
+                );
+                // The three roles must be three DISTINCT operands, or the
+                // expression is not `a*b + c` at all.
+                let roles = [
+                    which_operand(&rm).unwrap_or_else(|| panic!("{name}: rm {rm} in {out}")),
+                    which_operand(&vvvv).unwrap_or_else(|| panic!("{name}: vvvv {vvvv} in {out}")),
+                    which_operand(&dst).unwrap_or_else(|| panic!("{name}: dst {dst} in {out}")),
+                ];
+                let mut sorted = roles;
+                sorted.sort_unstable();
+                assert_eq!(
+                    sorted,
+                    [0, 1, 2],
+                    "{name}: roles must be a permutation of a/b/c, got {roles:?}: {out}"
+                );
+                // The digit order fixes exactly which role `c` (the addend for
+                // 231) and `a` take.
+                match fma_role_order(&name) {
+                    // 132: dst = dst*rm + vvvv, destination must be `a`.
+                    FmaRoleOrder::RmBVvvvCDstA => assert_eq!(
+                        (roles[2], roles[0], roles[1]),
+                        (0, 1, 2),
+                        "{name}: 132 needs dst=a, rm=b, vvvv=c: {out}"
+                    ),
+                    // 213: dst = vvvv*dst + rm, so the ADDEND (`c`) is the rm
+                    // slot and the destination is a multiplicand.
+                    FmaRoleOrder::RmCVvvvADstB => assert_eq!(
+                        (roles[0], roles[1], roles[2]),
+                        (2, 0, 1),
+                        "{name}: 213 needs rm=c (the addend), vvvv=a, dst=b: {out}"
+                    ),
+                    // 231: dst = vvvv*rm + dst, so the ADDEND (`c`) is the dst.
+                    FmaRoleOrder::RmBVvvvADstC => assert_eq!(
+                        (roles[0], roles[1], roles[2]),
+                        (1, 0, 2),
+                        "{name}: 231 needs rm=b, vvvv=a, dst=c (the addend): {out}"
+                    ),
+                }
+            }
+        }
+    }
+
+    /// The 132 placement — the only one any public macro emits — must not move.
+    #[test]
+    fn fma132_placement_is_unchanged() {
+        for (width, is_256) in [("128", false), ("256", true)] {
+            for float in ["ps", "pd"] {
+                let (_, _, op, _) = resolve_fma(width, float, "132");
+                let mut cg = X86Codegen::new();
+                for id in 0..3u32 {
+                    distinct_slot_vector(&mut cg, id);
+                }
+                distinct_slot_vector(&mut cg, 9);
+                let args = [
+                    Operand::Value(Value(0)),
+                    Operand::Value(Value(1)),
+                    Operand::Value(Value(2)),
+                ];
+                if is_256 {
+                    cg.emit_avx_fp_256_op(&Value(9), &op, &args);
+                } else {
+                    cg.emit_sse_fp_128_op(&Value(9), &op, &args);
+                }
+                let out = cg.state.out.buf.clone();
+                let (_, _, _, dst) = parse_fma(&out).expect("a vfmadd* instruction");
+                assert_eq!(
+                    which_operand(&dst),
+                    Some(0),
+                    "width {width} {float}: the 132 destination must stay a's \
+                     home: {out}"
+                );
+            }
+        }
+    }
+
+    /// The decoded role order for every mnemonic the emitter can be handed,
+    /// including every table spelling and the unrecognised-name fallback.
+    ///
+    /// The width-suffixed rows are the regression: the parser used to take
+    /// EVERY digit in the string, so `vfmadd213ps128` became `"213128"`, missed
+    /// and fell through to the 132 placement -- 213 silently mis-computing as
+    /// 132, which is the SA-11 defect over again.  Both suffix conventions are
+    /// covered because the table uses them both: 128-bit keys carry no `v` and
+    /// no width marker beyond `...128`, while 256/512 keep the `v`.
+    #[test]
+    fn fma_role_order_decodes_every_spelling_and_defaults_to_132() {
+        for (inst, want) in [
+            // Bare operation field (what the three emit sites pass).
+            ("vfmadd132ps", FmaRoleOrder::RmBVvvvCDstA),
+            ("vfmadd213pd", FmaRoleOrder::RmCVvvvADstB),
+            ("vfmadd231ps", FmaRoleOrder::RmBVvvvADstC),
+            // 128-bit table keys: no `v`, width marker after the lane type.
+            ("fmadd132ps128", FmaRoleOrder::RmBVvvvCDstA),
+            ("fmadd213ps128", FmaRoleOrder::RmCVvvvADstB),
+            ("fmadd231pd128", FmaRoleOrder::RmBVvvvADstC),
+            // 256/512-bit table keys: `v` prefix, width marker after the lane.
+            ("vfmadd132ps256", FmaRoleOrder::RmBVvvvCDstA),
+            ("vfmadd213ps256", FmaRoleOrder::RmCVvvvADstB),
+            ("vfmadd231pd256", FmaRoleOrder::RmBVvvvADstC),
+            ("vfmadd132ps512", FmaRoleOrder::RmBVvvvCDstA),
+            ("vfmadd213pd512", FmaRoleOrder::RmCVvvvADstB),
+            ("vfmadd231ps512", FmaRoleOrder::RmBVvvvADstC),
+            // The two shapes the emitter used to see in the 256-bit path.
+            ("vfmadd132psv256", FmaRoleOrder::RmBVvvvCDstA),
+            ("vfmadd213pdv256", FmaRoleOrder::RmCVvvvADstB),
+            ("vfmadd231psv512", FmaRoleOrder::RmBVvvvADstC),
+            // Unknown digits must not silently become 231 or 213, and a
+            // digit-less name must not either.
+            ("vfmadd999ps", FmaRoleOrder::RmBVvvvCDstA),
+            ("vfmaddps", FmaRoleOrder::RmBVvvvCDstA),
+            ("vfmaddsoftps", FmaRoleOrder::RmBVvvvCDstA),
+        ] {
+            assert_eq!(fma_role_order(inst), want, "{inst}");
+        }
+    }
+}
+
+/// The VEX lane-mask select (`vblendvps`/`vblendvpd`) is plain **AVX**, so a
+/// `-mavx -mno-avx2` target must emit it.
+///
+/// The dispatch gated it on `sse41 && avx2_enabled` — one ISA level too
+/// strict.  `vblendvps` is VEX.128.66.0F3A.W0 4A and `vblendvpd` is
+/// `...W0 4B`; both round-trip through `as`/`objdump` at `-mavx` with no AVX2
+/// feature involved.  Gating on `isa.avx` makes that target two or three
+/// instructions lighter per blend (`vblendvps` instead of
+/// `psrad`/`pshufd` + `andps`/`andnps`/`orps`), which is the whole point of
+/// this arm existing.
+///
+/// The test is on the EMITTED MNEMONIC, not on the branch, so any future
+/// refactor that keeps the fast path keeps the test green.
+#[cfg(test)]
+mod blendv_vex_gate_tests {
+    use super::test_fixtures::slot_vector;
+    use super::*;
+    use crate::backend::x86::isa::X86Isa;
+
+    fn codegen_with(avx: bool) -> X86Codegen {
+        let mut cg = X86Codegen::new();
+        // SSE2 baseline + exactly the feature under test; no SSE4.1 and no
+        // AVX2, so anything the arm emits is attributable to `avx` alone.
+        cg.isa = X86Isa {
+            simd: true,
+            sse41: false,
+            avx,
+            ymm: false,
+            fma: false,
+            movbe: false,
+            cx16: false,
+        };
+        cg.avx2_enabled = false;
+        cg
+    }
+
+    #[test]
+    fn avx_without_avx2_emits_the_one_instruction_lane_select() {
+        let mut cg = codegen_with(true);
+        slot_vector(&mut cg, 0);
+        slot_vector(&mut cg, 1);
+        slot_vector(&mut cg, 2);
+        slot_vector(&mut cg, 9);
+        cg.emit_sse_blendv_128(
+            &Value(9),
+            &[
+                Operand::Value(Value(0)),
+                Operand::Value(Value(1)),
+                Operand::Value(Value(2)),
+            ],
+            super::super::intrinsics::BlendvDomain::Ps,
+        );
+        let out = cg.state.out.buf.clone();
+        assert!(
+            out.contains("vblendvps"),
+            "-mavx must emit the one-instruction VEX select: {out}"
+        );
+        // ... and neither the bitwise triple nor the SA-10 canonicalization.
+        for slow in ["andps", "andnps", "orps", "psrad", "pshufd"] {
+            assert!(
+                !out.contains(slow),
+                "-mavx must not pay the SSEx path's `{slow}`: {out}"
+            );
+        }
+    }
+
+    #[test]
+    fn sse41_without_avx_keeps_the_canonicalised_bitwise_select() {
+        let mut cg = codegen_with(false);
+        cg.isa.sse41 = true; // SSE4.1 but -mno-avx: no VEX encoding is legal
+        slot_vector(&mut cg, 0);
+        slot_vector(&mut cg, 1);
+        slot_vector(&mut cg, 2);
+        slot_vector(&mut cg, 9);
+        cg.emit_sse_blendv_128(
+            &Value(9),
+            &[
+                Operand::Value(Value(0)),
+                Operand::Value(Value(1)),
+                Operand::Value(Value(2)),
+            ],
+            super::super::intrinsics::BlendvDomain::Ps,
+        );
+        let out = cg.state.out.buf.clone();
+        assert!(
+            !out.contains("vblendvps"),
+            "a VEX encoding without -mavx is a SIGILL: {out}"
+        );
+        // SA-10 canonicalization must still be present, or every
+        // non-compare-produced mask silently changes meaning.
+        assert!(
+            out.contains("psrad $31"),
+            "the SSE path must broadcast the dword sign (SA-10): {out}"
+        );
+        assert!(out.contains("andps") && out.contains("orps"), "{out}");
+    }
+}
diff --git a/src/backend/x86/codegen/memory.rs b/src/backend/x86/codegen/memory.rs
index af73446..e9cee95 100644
--- a/src/backend/x86/codegen/memory.rs
+++ b/src/backend/x86/codegen/memory.rs
@@ -4280,6 +4280,273 @@ impl X86Codegen {
     }
 
     // ---- Segment-prefixed memory ops ----
+    //
+    // A 128-bit value (`__int128`/`__uint128_t`, and `_Float128` over its
+    // `U128` carrier) has no single GPR memory operand.  Every scalar
+    // `movq`/`movl` emitter below moves exactly one 8-byte half, so routing a
+    // wide object through them left the other half of the object stale: a
+    // store silently kept the old high word, a load read whatever the
+    // destination slot already held.  There is no diagnostic for "half an
+    // object", so the defect was invisible until a `__seg_gs __int128 *`
+    // round trip compared unequal.
+    //
+    // The generic address space solved this with `Mov128`: one `movdqu` pair
+    // through the pre-coloured `%xmm0` scratch.  These are the segment twins.
+    // Every path below either transfers both halves exactly or refuses and
+    // lets the caller's generic machinery handle the object -- never a
+    // partial transfer.
+
+    /// `mem` with `delta` added to its displacement, keeping the segment
+    /// prefix and base: `%gs:16` -> `%gs:24`, `%gs:g` -> `%gs:g+8`,
+    /// `%gs:0(%rax)` -> `%gs:8(%rax)`, `%gs:g(%rip)` -> `%gs:g+8(%rip)`.
+    ///
+    /// `None` means the displacement is not a plain integer or a plain
+    /// symbol (a `sym@TPOFF` relocation, an index register, ...): an addend
+    /// there would have to be folded by the assembler into a relocation whose
+    /// wrong encoding is silent corruption, so callers fall back instead.
+    fn seg_mem_plus(mem: &str, delta: i64) -> Option<String> {
+        let (prefix, rest) = mem.split_once(':')?;
+        if !prefix.eq_ignore_ascii_case("%gs") && !prefix.eq_ignore_ascii_case("%fs") {
+            return None;
+        }
+        if rest.contains('@') || rest.contains(',') {
+            return None;
+        }
+        let (disp, base) = match rest.find('(') {
+            Some(open) => (&rest[..open], &rest[open..]),
+            None => (rest, ""),
+        };
+        let new_disp = if disp.is_empty() {
+            if delta == 0 {
+                String::new()
+            } else {
+                delta.to_string()
+            }
+        } else if let Some(value) = disp.strip_prefix('-').and_then(|d| d.parse::<i64>().ok()) {
+            let sum = (-value).checked_add(delta)?;
+            if sum == 0 {
+                String::new()
+            } else {
+                sum.to_string()
+            }
+        } else if let Ok(value) = disp.parse::<i64>() {
+            let sum = value.checked_add(delta)?;
+            if sum == 0 {
+                String::new()
+            } else {
+                sum.to_string()
+            }
+        } else {
+            // A symbol displacement, possibly already carrying an addend
+            // (`arr+16`, the constant-offset fold): split the addend off, add
+            // `delta` to it, and put it back. Only a plain identifier plus an
+            // optional decimal addend qualifies; anything else (an `@`-reloc,
+            // an expression) is refused so the caller can fall back.
+            let (sym, addend) = match disp.find(['+', '-']) {
+                Some(cut) => {
+                    let (sym, rest) = disp.split_at(cut);
+                    let sign = if rest.starts_with('-') { -1 } else { 1 };
+                    match rest[1..].parse::<i64>() {
+                        Ok(value) => (sym, Some(sign * value)),
+                        Err(_) => return None,
+                    }
+                }
+                None => (disp, None),
+            };
+            if sym.is_empty()
+                || !sym
+                    .chars()
+                    .all(|c| c.is_ascii_alphanumeric() || matches!(c, '_' | '.' | '$'))
+            {
+                return None;
+            }
+            let total = addend.unwrap_or(0).checked_add(delta)?;
+            if total == 0 {
+                sym.to_string()
+            } else if total > 0 {
+                format!("{}+{}", sym, total)
+            } else {
+                format!("{}-{}", sym, -total)
+            }
+        };
+        Some(format!("{}:{}{}", prefix, new_disp, base))
+    }
+
+    /// Whether the pre-coloured SSE scratch registers may be clobbered here.
+    ///
+    /// `%xmm0`/`%xmm1` are `XMM0_SCRATCH`/`XMM1_SCRATCH`, outside the
+    /// allocatable pool, so the only hazard is a value the allocator
+    /// deliberately homed in one of them -- the same two-register `any_home`
+    /// test `isel::xmm_scratch_unsafe` applies before it will emit a
+    /// `Mov128`. Both registers must be checked, not just `%xmm0`: the
+    /// constant form below materialises the high half through `%xmm1`, and
+    /// checking only `%xmm0` would silently destroy a live `%xmm1` value.
+    ///
+    /// `own` is the value being defined: a LOAD rewrites its home, so it never
+    /// keeps the scratch live across itself; a STORE passes `u32::MAX`.
+    /// `-mno-sse` (`-mgeneral-regs-only`, kernel code with no XSAVE area)
+    /// forbids the SSE moves outright, exactly as `Mov128`'s lowering does.
+    fn seg_wide_scratch_free(&self, own: u32) -> bool {
+        use crate::backend::x86::codegen::machinst::{XMM0_SCRATCH, XMM1_SCRATCH};
+        crate::backend::x86::codegen::isel::sse_integer_moves()
+            && !self
+                .reg_assignments
+                .iter()
+                .any(|(&v, &r)| v != own && (r.0 == XMM0_SCRATCH.0 || r.0 == XMM1_SCRATCH.0))
+    }
+
+    /// Whether `ty` is a 16-byte object moved as two 8-byte halves.
+    ///
+    /// `_Float128` arrives in the IR as its `U128` bit carrier
+    /// (`types.rs`: "Float128 -> U128, bit-exact 16-byte moves"), so `I128`,
+    /// `U128` and `F128` all need the same treatment; the scalar emitters
+    /// below would move exactly one half of any of them.
+    fn seg_wide_type(ty: IrType) -> bool {
+        ty.is_128bit() || ty == IrType::F128
+    }
+
+    /// The low/high halves of a 16-byte segment access.
+    fn seg_wide_pair(mem: &str) -> Option<(String, String)> {
+        Some((mem.to_string(), Self::seg_mem_plus(mem, 8)?))
+    }
+
+    /// Store the 16-byte value `val` to the segment operand `mem`.
+    pub(super) fn emit_seg_wide_store(&mut self, val: &Operand, mem: &str) {
+        let Some((lo_mem, hi_mem)) = Self::seg_wide_pair(mem) else {
+            // Relocation-bearing displacement: no addressable high half.
+            self.emit_seg_wide_store_pair(val, mem);
+            return;
+        };
+        let image = match val {
+            Operand::Const(IrConst::I128(c)) => Some(*c as u128),
+            Operand::Const(IrConst::Zero) => Some(0),
+            _ => None,
+        };
+        if let Some(image) = image {
+            // Whole image materialised in registers by construction: exact
+            // for any bit pattern, and no source register to preserve.
+            let lo = image as u64;
+            let hi = (image >> 64) as u64;
+            let lo_imm = lo as i64;
+            if self.seg_wide_scratch_free(u32::MAX) {
+                self.state
+                    .emit_fmt(format_args!("    movabsq ${}, %rax", lo_imm));
+                self.state.emit("    movq %rax, %xmm0");
+                self.state
+                    .emit_fmt(format_args!("    movabsq ${}, %rax", hi as i64));
+                self.state.emit("    movq %rax, %xmm1");
+                self.state.emit("    punpcklqdq %xmm1, %xmm0");
+                self.state
+                    .emit_fmt(format_args!("    movdqu %xmm0, {lo_mem}"));
+                self.state.reg_cache.invalidate_all();
+                return;
+            }
+            // No SSE: a constant needs no source register, so the pair form
+            // is two half stores and no staging.
+            if lo_imm >= i32::MIN as i64 && lo_imm <= i32::MAX as i64 {
+                self.state
+                    .emit_fmt(format_args!("    movq ${}, {lo_mem}", lo_imm));
+            } else {
+                self.state
+                    .emit_fmt(format_args!("    movabsq ${}, %rax", lo_imm));
+                self.state.emit_fmt(format_args!("    movq %rax, {lo_mem}"));
+            }
+            let hi_imm = hi as i64;
+            if hi_imm >= i32::MIN as i64 && hi_imm <= i32::MAX as i64 {
+                self.state
+                    .emit_fmt(format_args!("    movq ${}, {hi_mem}", hi_imm));
+            } else {
+                self.state
+                    .emit_fmt(format_args!("    movabsq ${}, %rax", hi_imm));
+                self.state.emit_fmt(format_args!("    movq %rax, {hi_mem}"));
+            }
+            self.state.reg_cache.invalidate_acc();
+            return;
+        }
+        if let Operand::Value(v) = val {
+            // Source already in an XMM home: one store covers both halves.
+            if let Some(&reg) = self.reg_assignments.get(&v.0) {
+                if is_xmm_reg(reg) {
+                    let name = phys_reg_name(reg);
+                    self.state
+                        .emit_fmt(format_args!("    movdqu %{}, {lo_mem}", name));
+                    self.state.reg_cache.invalidate_all();
+                    return;
+                }
+            }
+            // Slot-homed source: reload both halves through the scratch.
+            if let Some(slot) = self.state.get_slot(v.0) {
+                if self.seg_wide_scratch_free(v.0) {
+                    self.state
+                        .out
+                        .emit_instr_rbp_reg("    movdqu", slot.0, "xmm0");
+                    self.state
+                        .emit_fmt(format_args!("    movdqu %xmm0, {lo_mem}"));
+                    self.state.reg_cache.invalidate_acc();
+                    return;
+                }
+            }
+        }
+        self.emit_seg_wide_store_pair(val, mem);
+    }
+
+    /// Exact fallback store for a 16-byte value that the SSE route cannot
+    /// take: `%rdx:%rax` holds the halves after `operand_to_rax_rdx`, and a
+    /// single `xchgq` swaps them so both can be stored without a scratch
+    /// register, a stack round trip, or any assumption about which segments
+    /// the destination addresses.
+    fn emit_seg_wide_store_pair(&mut self, val: &Operand, mem: &str) {
+        let Some((lo_mem, hi_mem)) = Self::seg_wide_pair(mem) else {
+            unreachable!("16-byte segment store through a relocation-bearing operand: {mem}");
+        };
+        self.operand_to_rax_rdx(val);
+        // operands: low in %rax, high in %rdx. Store in that order, and let
+        // the destination be addressed by `mem`/`mem+8` only -- the registers
+        // holding the value are exactly the ones being stored.
+        self.state.emit_fmt(format_args!("    movq %rax, {lo_mem}"));
+        self.state.emit_fmt(format_args!("    movq %rdx, {hi_mem}"));
+        self.state.reg_cache.invalidate_all();
+    }
+
+    /// Load the 16-byte value at the segment operand `mem` into `dest`.
+    pub(super) fn emit_seg_wide_load(&mut self, dest: &Value, mem: &str) {
+        let Some((lo_mem, hi_mem)) = Self::seg_wide_pair(mem) else {
+            unreachable!("16-byte segment load through a relocation-bearing operand: {mem}");
+        };
+        // Destination already in an XMM home: one load covers both halves.
+        if let Some(&reg) = self.reg_assignments.get(&dest.0) {
+            if is_xmm_reg(reg) {
+                let name = phys_reg_name(reg);
+                self.state
+                    .emit_fmt(format_args!("    movdqu {lo_mem}, %{}", name));
+                self.state.reg_cache.invalidate_all();
+                return;
+            }
+        }
+        if let Some(slot) = self.state.get_slot(dest.0) {
+            if self.seg_wide_scratch_free(dest.0) {
+                self.state
+                    .emit_fmt(format_args!("    movdqu {lo_mem}, %xmm0"));
+                self.state
+                    .out
+                    .emit_instr_reg_rbp("    movdqu", "xmm0", slot.0);
+            } else {
+                self.state.emit_fmt(format_args!("    movq {lo_mem}, %rax"));
+                self.state.emit_fmt(format_args!("    movq {hi_mem}, %rdx"));
+                self.state.out.emit_instr_reg_rbp("    movq", "rax", slot.0);
