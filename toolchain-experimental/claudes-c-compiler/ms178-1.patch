diff --git a/tests/regression/ipcp_eval_depth.c b/tests/regression/ipcp_eval_depth.c
index 6bb23cfeb..f4ab16988 100644
--- a/tests/regression/ipcp_eval_depth.c
+++ b/tests/regression/ipcp_eval_depth.c
@@ -1,22 +1,41 @@
-/* A non-tail recursion deep enough that the compile-time constant evaluator
- * cannot finish it: `deep(100000)` nests 100,000 levels in the interpreter,
- * `ackermann(3, 11)` (the deepest fold the pass is meant to serve) nests
- * ~16,400. `MAX_EVAL_CALL_DEPTH` therefore refuses this call and leaves it as
- * a call instead of recursing until the pipeline's 64 MiB stack is gone —
- * which aborted the compiler outright before the depth bound existed.
+/* The compile-time constant evaluator in `ipcp` against a recursion it cannot
+ * finish. Both calls below have constant arguments, so the evaluator descends
+ * into both:
  *
- * The seed is `volatile` so nothing but the pass under test can fold it.
+ *   chain(1000)    folds to a constant (16996): the positive control, proving
+ *                  the evaluator engages on this shape at all;
+ *   chain(400000)  nests 400,000 levels: past `MAX_EVAL_CALL_DEPTH` even at
+ *                  the ~4 source levels per evaluated call the inliner leaves
+ *                  in this body, past `EVAL_STACK_BUDGET`, and at the measured
+ *                  ~264 bytes of compiler stack per source level (fastbuild,
+ *                  Massif `--stacks=yes`) about 105 MB -- past the pipeline's
+ *                  64 MiB stack, so an unbounded evaluator aborts the compile.
+ *                  It must stay a call.
+ *
+ * `(x * 3 + n) & 0xffff` is not an accumulator shape: the recursion-to-
+ * iteration passes leave it a real recursion, so the surviving call is the
+ * evaluator's refusal and nothing else. (`1 + deep(n - 1)`, the first version
+ * of this fixture, is linearised into a counting loop -- and with a `volatile`
+ * argument the evaluator never ran on it at all: Massif measured a 127 KB peak
+ * stack, against ~25 MB for the descent here.)
+ *
+ * The deep call only runs when argc > 64, so the test binary itself never
+ * recurses 400,000 deep.
  */
 #include <stdio.h>
 
-static int deep(int n) {
+static int chain(int n) {
     if (n == 0) return 0;
-    return 1 + deep(n - 1);
+    return (chain(n - 1) * 3 + n) & 0xffff;
 }
 
-int main(void) {
-    volatile int n = 100000;
-    volatile int result = deep(n);
-    printf("%d\n", result);
+int main(int argc, char **argv) {
+    (void)argv;
+    volatile int shallow = chain(1000);
+    printf("%d\n", shallow);
+    if (argc > 64) {
+        volatile int deep = chain(400000);
+        printf("%d\n", deep);
+    }
     return 0;
 }
