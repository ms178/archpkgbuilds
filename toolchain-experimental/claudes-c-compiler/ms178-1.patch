+        assert_eq!(h, "d5 08 8b 05 00 00 00 00");
+        assert_eq!(rels, vec![R_X86_64_CODE_4_GOTPCRELX]);
+        let (h, rels) = hex_relocs("addq foo@GOTPCREL(%rip), %r16");
+        assert_eq!(h, "d5 48 03 05 00 00 00 00");
+        assert_eq!(rels, vec![R_X86_64_CODE_4_GOTPCRELX]);
