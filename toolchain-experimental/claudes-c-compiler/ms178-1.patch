+                LineKind::Move { dst, .. } => dst == src_reg,
+                LineKind::LoadEbp { reg, .. } => reg == src_reg,
+                LineKind::Pop { reg } => reg == src_reg,
+                LineKind::SetCC { reg } => reg == src_reg,
+                LineKind::Other { dest_reg } => dest_reg == src_reg,
