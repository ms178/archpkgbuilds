+                ty: IrType::I32,
+            }],
+            cond_br(val(0), 1, 2),
+        ),
+        blk(1, vec![], br(3)),
+        blk(2, vec![], br(3)),
+        blk(
+            3,
+            vec![phi(
+                1,
+                vec![
+                    (Operand::Const(IrConst::I32(7)), 1),
+                    (Operand::Const(IrConst::I32(7)), 2),
+                ],
+                IrType::I32,
