+        let asm = ".type f, @function\nf:\n    movq %rdi, %rax\n    ret\n\
+                   .type g, @function\ng:\n    # LCCC_RET_XMM 1\n    movsd (%rdi), %xmm0\n    ret\n";
+        let (f, l) = first_sse_reference(asm).unwrap();
+        assert_eq!(f, "g");
+        assert_eq!(l.trim(), "movsd (%rdi), %xmm0");
+    }
