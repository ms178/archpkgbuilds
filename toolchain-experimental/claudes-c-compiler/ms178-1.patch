+  local missing=() tool sym
+  # Compression tool implied by the config (Kbuild's compressed/Makefile).
+  for sym in GZIP BZIP2 LZMA XZ LZO LZ4 ZSTD; do
+    if grep -q "^CONFIG_KERNEL_${sym}=y$" .config; then
+      case $sym in
+        GZIP) tool=gzip ;;
+        BZIP2) tool=bzip2 ;;
+        LZMA) tool=lzma ;;
+        XZ) tool=xz ;;
+        LZO) tool=lzop ;;
+        LZ4) tool=lz4 ;;
