+/// Element size in bytes for a vectorizable reduction element type.
+fn reduction_element_size(ty: IrType) -> Option<u32> {
+    match ty {
+        IrType::F64 => Some(8),
+        IrType::F32 => Some(4),
+        IrType::I32 => Some(4),
