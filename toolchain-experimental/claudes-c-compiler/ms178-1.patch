+        assert_eq!(w(IrType::F32, &[], false, false, false), 32, "float");
+        assert_eq!(w(IrType::F64, &[], false, false, false), 64, "double");
+        assert_eq!(w(IrType::I64, &[Sse], false, false, false), 64, "two-float aggregate");
+        assert_eq!(w(IrType::F64, &[], false, true, false), 64, "_Complex double halves");
+        assert_eq!(w(IrType::I128, &[Sse, Integer], false, false, false), 64, "mixed pair");
+        assert_eq!(w(IrType::F128, &[], true, false, false), 128, "__float128");
+        assert_eq!(w(IrType::I128, &[Sse, SseUp], false, false, true), 128, "__m128d");
+        assert_eq!(w(IrType::Ptr, &[Sse, SseUp, SseUp, SseUp], false, false, true), 256, "__m256d");
+        let zmm = [Sse, SseUp, SseUp, SseUp, SseUp, SseUp, SseUp, SseUp];
