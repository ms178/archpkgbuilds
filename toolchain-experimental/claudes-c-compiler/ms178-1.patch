+        run("defsym_forward_reference_i386",
+            {"lccc": [CC, "-m32", f"-B{shim}", "-no-pie", "m32.o", "d32.o"],
+             "GNU": [CC, "-m32", "-no-pie", "m32.o", "d32.o"]},
