+    movslq 40(%rsp), %rax\n\
+    movq %rax, %rbp\n\
+    cltq\n\
+    movq %rax, 16(%rsp)\n\
+    leaq heap(%rip), %r9\n\
+";
+        let (changed, _) = run(asm);
+        assert!(!changed, "fuse must be refused: cltq reads %eax implicitly");
+    }
