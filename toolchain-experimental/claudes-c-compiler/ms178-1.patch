+        // right-hand side is ICX's single instruction.
+        let got = fma_only(
+            "    vmovsd %xmm2, %xmm2, %xmm5\n    vfmadd231sd %xmm1, %xmm0, %xmm5\n    movsd %xmm5, %xmm0\n    ret\n",
