+
 # ~97 compiles per arm plus the runs: seconds, not minutes -- and it is the
 # only gate that exercises the historical crash/miscompile corpus end to end.
 gate "cpu-supports-runtime" fast \
@@ -343,6 +391,18 @@ gate "benchmark-harness-contracts" fast \
 gate "gcc-provisioning-mocks" fast \
     python3 tests/regression/check_ci_gcc16_provisioning.py
 
+# The `__builtin_<fn>f` class is derived from GCC 16 (which names the class)
+# and checked on the RESULT: lccc's builtin spelling must agree with the libc
+# function it names. It caught a silent miscompile -- the float twins of
+# fmax/fmin/log2 fell through the result-type table to I64, so a float return
+# in %xmm0 was converted with cvtsi2ssq -- which no other gate could see,
+# because the symptom is a wrong NUMBER rather than a missing symbol.
+gate "builtin-float-aliases" fast \
+    env GCC="${GCC:-gcc-16}" python3 tests/regression/check_builtin_float_aliases.py
+
+gate "link-oracle-provisioning-mocks" fast \
+    python3 tests/regression/check_ci_link_oracle_provisioning.py
+
 gate "swap-provisioning-mocks" fast \
     python3 tests/regression/check_ci_swap_provisioning.py
 
