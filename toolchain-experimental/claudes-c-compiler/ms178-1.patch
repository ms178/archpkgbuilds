+    match mnem {
+        "stc" | "clc" | "cmc" => F_CF,
+        // SDM: "LAHF/SAHF ... The OF flag is not affected."
+        "sahf" => F_SF | F_ZF | F_PF | F_AF | F_CF,
+        // Direction flag only; none of the six arithmetic flags change.
+        "cld" | "std" => 0,
+        _ => F_ALL,
+    }
+}
