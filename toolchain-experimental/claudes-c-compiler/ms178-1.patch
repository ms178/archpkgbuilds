+/// Preprocess `src` in assembly mode (`.S` / `-x assembler-with-cpp`).
+fn preprocess_asm(src: &str) -> (Preprocessor, String) {
+    let mut pp = Preprocessor::new();
+    pp.set_filename("unit.S");
+    pp.set_asm_mode(true);
+    let out = pp.preprocess(src);
+    (pp, out)
