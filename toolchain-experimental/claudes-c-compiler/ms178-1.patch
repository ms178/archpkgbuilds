@@ -0,0 +1,286 @@
+/*
+ * Workload-derived kernel: GNU gzip 1.14, deflate.c, longest_match().
+ *
+ * The match-finder loop below is extracted from GNU gzip's deflate.c
+ * (LGPL-3.0-or-later). Configuration macros, the sliding-window/output
+ * machinery, zlib's gz* interfaces and the hash-table *insertion* policy were
+ * removed; the hash chain is built once by this harness and then searched
+ * exactly as longest_match() does. Names are prefixed. Full source provenance
+ * is in tests/benchmark/WORKLOAD_PROVENANCE.md.
+ *
+ * Why this shape: longest_match is the single hottest function of gzip's
+ * compression path, and it is a stress test for precisely the things a code
+ * generator controls --
+ *
+ *   * an unaligned multi-byte load pair compared as one word
+ *     (gzip's `#if defined UNALIGNED_OK` arm: two `ush`-style loads widened to
+ *     an unsigned word), then a trailing-zero count to find the first
+ *     differing byte;
+ *   * a pointer-chasing chain walk whose trip count is data dependent
+ *     (the `--chain_length` bound), so the loop is branch-heavy and
+ *     unpredictable;
+ *   * a loop-carried best-length/best-match pair that must stay in registers
+ *     across the inner compare to avoid a spill in the loop body.
+ *
+ * The `quick_bytes` pre-check is also kept: gzip skips a candidate whose byte
+ * at the current best length already differs, which is the branch that makes
+ * the whole loop cheap on real data.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifndef WINDOW_SIZE
+#define WINDOW_SIZE (1UL << 16)
+#endif
+#ifndef CHAIN_LENGTH
+#define CHAIN_LENGTH 128
+#endif
+#ifndef MIN_MATCH
+#define MIN_MATCH 3
+#endif
+#ifndef MAX_MATCH
+#define MAX_MATCH 258
+#endif
+#ifndef PASSES
+/* Keep default timing runs above the process-startup noise floor.
+ * Bounded Callgrind screens explicitly override PASSES=1. */
+#define PASSES 8192U
+#endif
+#ifndef HASH_BITS
+#define HASH_BITS 15
+#endif
+
+#define HASH_SIZE (1U << HASH_BITS)
+#define NIL 0xFFFFU
+
+static unsigned char window[WINDOW_SIZE + MAX_MATCH];
+static unsigned int head[HASH_SIZE];
+static unsigned int prev[WINDOW_SIZE];
+/* Search positions used by every pass: a deterministic, repeatable schedule so
+ * the measured work does not depend on the random-number implementation of the
+ * host's libc. */
+static unsigned int positions[256];
+static unsigned int position_count;
+
+static unsigned int hash3(const unsigned char *p)
+{
+    unsigned int h = (unsigned int)p[0] << 10;
+    h ^= (unsigned int)p[1] << 5;
+    h ^= (unsigned int)p[2];
+    return h & (HASH_SIZE - 1);
+}
+
+/* Build gzip's hash chain over the window, exactly as INSERT_STRING does. */
+static void build_chain(void)
+{
+    unsigned int i;
+    for (i = 0; i < HASH_SIZE; i++)
+        head[i] = NIL;
+    for (i = 0; i < WINDOW_SIZE; i++)
+        prev[i] = NIL;
+    for (i = 0; i + MIN_MATCH <= WINDOW_SIZE; i++) {
+        unsigned int h = hash3(window + i);
+        prev[i] = head[h];
+        head[h] = i;
+    }
+}
+
+/* Read MIN_MATCH bytes as one integer, the portable spelling of gzip's
+ * UNALIGNED_OK arm. memcpy keeps the load valid at any alignment; every
+ * compiler with an unaligned 32-bit load folds it. */
+static unsigned int load32(const unsigned char *p)
+{
+    unsigned int v;
+    memcpy(&v, p, sizeof v);
+    return v;
+}
+
+/* MIN_MATCH bytes, zero-extended. The pre-check must compare exactly MIN_MATCH
+ * bytes: comparing four rejects a candidate whose first three bytes agree and
+ * whose fourth differs, which is still a match of length 3 -- the reference
+ * below finds it, and gzip's own `scan_start` holds exactly two bytes. */
+static unsigned int load24(const unsigned char *p)
+{
+    return load32(p) & 0x00FFFFFFU;
+}
+
+static unsigned int trailing_zero_bytes(unsigned int diff)
+{
+    /* gzip compares the widened load little-endian, so the first differing
+     * byte is the lowest non-zero byte: a count of trailing zeros. */
+    return (unsigned int)__builtin_ctz(diff) >> 3;
+}
+
+/* gzip longest_match(), with the window offset that gzip's cur_match/strstart
+ * arithmetic performs already resolved into absolute indices. */
+static unsigned int longest_match(unsigned int cur_match, unsigned int strstart,
+                                  unsigned int prev_length)
+{
+    unsigned int chain_length = CHAIN_LENGTH;
+    unsigned int best_len = prev_length;
+    unsigned int best_match = NIL;
+    unsigned int limit;
+    const unsigned char *scan = window + strstart;
+    const unsigned char *scan_end = window + strstart + best_len;
+    unsigned int max_len = MAX_MATCH;
+    unsigned int window_room = WINDOW_SIZE - strstart;
+
+    if (max_len > window_room)
+        max_len = window_room;
+    if (best_len >= max_len)
+        return best_len;
+
+    /* gzip: "Do not waste too much time if we already have a good match." */
+    if (best_len >= 32)
+        chain_length >>= 2;
+    limit = (strstart > MAX_MATCH ? strstart - MAX_MATCH : 0);
+
+    for (;;) {
+        const unsigned char *match = window + cur_match;
+        /* quick check: the byte at the current best length must match */
+        if (match[best_len] != *scan_end || match[best_len - 1] != scan[best_len - 1]
+            || load24(match) != load24(scan)) {
+            unsigned int pc = prev[cur_match];
+            if (pc == NIL || pc < limit || --chain_length == 0)
+                break;
+            cur_match = pc;
+            continue;
+        }
+
+        /* The candidate survives the pre-checks: extend it. gzip compares the
+         * first MIN_MATCH bytes via the load above and then walks bytes. This
+         * kernel keeps gzip's byte loop for the tail and uses the word compare
+         * for the body, which is what the UNALIGNED_OK configuration does. */
+        {
+            unsigned int len = MIN_MATCH;
+            while (len + 4 <= max_len) {
+                unsigned int diff = load32(match + len) ^ load32(scan + len);
+                if (diff != 0) {
+                    len += trailing_zero_bytes(diff);
+                    break;
+                }
+                len += 4;
+            }
+            while (len < max_len && match[len] == scan[len])
+                len++;
+            if (len > best_len) {
+                best_len = len;
+                best_match = cur_match;
+                scan_end = window + strstart + best_len;
+                if (len >= max_len)
+                    break;
+                if (len >= 32)
+                    chain_length >>= 2;
+            }
+        }
+
+        {
+            unsigned int pc = prev[cur_match];
+            if (pc == NIL || pc < limit || --chain_length == 0)
+                break;
+            cur_match = pc;
+        }
+    }
+    (void)best_match;
+    return best_len;
+}
+
+/* A plainly written reference: the naive byte-by-byte longest match over the
+ * same chain. Used only to prove the fast path is not inventing matches, so
+ * the harness has an algorithmic self-check that does not depend on a golden
+ * number produced by any one compiler. */
+static unsigned int longest_match_reference(unsigned int cur_match, unsigned int strstart,
+                                            unsigned int prev_length)
+{
+    unsigned int chain_length = CHAIN_LENGTH;
+    unsigned int best_len = prev_length;
+    unsigned int limit = (strstart > MAX_MATCH ? strstart - MAX_MATCH : 0);
+    unsigned int max_len = MAX_MATCH;
+    const unsigned char *scan = window + strstart;
+    unsigned int window_room = WINDOW_SIZE - strstart;
+
+    if (max_len > window_room)
+        max_len = window_room;
+    if (best_len >= max_len)
+        return best_len;
+    if (best_len >= 32)
+        chain_length >>= 2;
+
+    for (;;) {
+        const unsigned char *match = window + cur_match;
+        unsigned int len = 0;
+        while (len < max_len && match[len] == scan[len])
+            len++;
+        if (len > best_len) {
+            best_len = len;
+            if (len >= max_len)
+                break;
+            if (len >= 32)
+                chain_length >>= 2;
+        }
+        {
+            unsigned int pc = prev[cur_match];
+            if (pc == NIL || pc < limit || --chain_length == 0)
+                break;
+            cur_match = pc;
+        }
+    }
+    return best_len;
+}
+
+static unsigned long long mix(unsigned long long h, unsigned long long v)
+{
+    h ^= v + 0x9E3779B97F4A7C15ULL + (h << 6) + (h >> 2);
+    return h;
+}
+
+int main(void)
+{
+    unsigned long long checksum = 0;
+    unsigned long long reference = 0;
+    unsigned int pass, i;
+
+    /* Deterministic, compressible-but-not-trivial window: a small alphabet with
+     * repeated runs, so matches actually occur. */
+    {
+        unsigned int state = 0x12345678U;
+        for (i = 0; i < WINDOW_SIZE + MAX_MATCH; i++) {
+            state = state * 1103515245U + 12345U;
+            window[i] = (unsigned char)('a' + ((state >> 16) % 5));
+            if (i > 40 && (state & 7) == 0)
+                window[i] = window[i - 1 - ((state >> 8) & 15)];
+            if (i > 300 && (state & 15) == 0)
+                window[i] = window[i - 257];
+        }
+    }
+    build_chain();
+
+    position_count = 0;
+    for (i = 512; i < WINDOW_SIZE - MAX_MATCH && position_count < 256; i += 61)
+        positions[position_count++] = i;
+
+    for (pass = 0; pass < PASSES; pass++)
+        for (i = 0; i < position_count; i++) {
+            unsigned int strstart = positions[i];
+            /* gzip inserts the current position and then searches the chain
+             * from the previous occurrence of the same hash, which is exactly
+             * prev[strstart] once the chain is built. Starting at head[h]
+             * instead would begin at a position AFTER the search point. */
+            unsigned int cur_match = prev[strstart];
+            unsigned int fast, slow;
+            if (cur_match == NIL || cur_match >= strstart
+                || strstart - cur_match > MAX_MATCH)
+                continue;
+            fast = longest_match(cur_match, strstart, MIN_MATCH - 1);
+            slow = longest_match_reference(cur_match, strstart, MIN_MATCH - 1);
+            checksum = mix(checksum, fast);
+            reference = mix(reference, slow);
+        }
+
+    /* The fast path and the reference must agree; a mismatch is a compiler or
+     * kernel defect, and the exit status carries it. */
+    printf("gzip_longest_match checksum=%llu reference=%llu %s\n",
+           checksum, reference, checksum == reference ? "OK" : "MISMATCH");
+    return checksum == reference ? 0 : 1;
+}
diff --git a/tests/benchmark/programs/linux_list_sort.c b/tests/benchmark/programs/linux_list_sort.c
new file mode 100644
index 0000000..9eea561
--- /dev/null
+++ b/tests/benchmark/programs/linux_list_sort.c
@@ -0,0 +1,181 @@
+/*
+ * Workload-derived kernel: Linux 6.18, lib/list_sort.c.
+ *
+ * The bottom-up merge sort below is extracted from the Linux kernel's
+ * lib/list_sort.c (GPL-2.0-or-later). The kernel's `list_head`, locking,
+ * EXPORT_SYMBOL machinery and <linux/...> headers were replaced with a local
+ * node type and a plain comparison callback; the merge and count-run structure
+ * is the kernel's. Names are prefixed. Full source provenance is in
+ * tests/benchmark/WORKLOAD_PROVENANCE.md.
+ *
+ * Why this shape: list_sort is a pure pointer-chasing merge sort -- two merges
+ * per pass over an intrusive singly-linked list, with the comparison behind an
+ * opaque function pointer. That combination is what a code generator cannot
+ * vectorize and must instead handle well in scalar code:
+ *
+ *   * indirect calls that are not devirtualizable, so the callee-saved
+ *     register set and the caller-saved clobber model decide whether the
+ *     loop's state stays in registers;
+ *   * a merge loop with two data-dependent next-pointer loads per iteration
+ *     (a pointer-chasing latency chain, not a throughput problem);
+ *   * a bottom-up 64-slot bin array (`count[]`) indexed by the trailing-zero
+ *     count of the element index, which is a counted-loop + ctz pattern.
+ *
+ * The kernel's `merge()` compares with `cmp(priv, a, b) <= 0` so equal keys
+ * keep their original order; the harness checks that stability property, not
+ * only sortedness, because an unstable rewrite is an easy way to be fast and
+ * wrong.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+
+#ifndef ELEMENTS
+#define ELEMENTS 20000
+#endif
+#ifndef PASSES
+/* Keep default timing runs above the process-startup noise floor.
+ * Bounded Callgrind screens explicitly override PASSES=1. */
+#define PASSES 128U
+#endif
+#define MAX_LIST_LENGTH_BITS 20
+
+struct lnode {
+    struct lnode *next;
+    unsigned long key;
+    unsigned int seq;
+};
+
+/* Opaque comparison through a function pointer, as the kernel's cmp(priv,...)
+ * is: this is the part a compiler must not assume anything about. */
+typedef int (*list_cmp_fn)(void *priv, const struct lnode *a, const struct lnode *b);
+
+static int key_cmp(void *priv, const struct lnode *a, const struct lnode *b)
+{
+    (void)priv;
+    if (a->key < b->key)
+        return -1;
+    if (a->key > b->key)
+        return 1;
+    return 0;
+}
+
+static struct lnode *merge(void *priv, list_cmp_fn cmp,
+                           struct lnode *a, struct lnode *b)
+{
+    struct lnode head, *tail = &head;
+
+    while (a && b) {
+        /* if a is less than b, take a; ties take a, which is what makes the
+         * sort stable. */
+        if (cmp(priv, a, b) <= 0) {
+            tail->next = a;
+            a = a->next;
+        } else {
+            tail->next = b;
+            b = b->next;
+        }
+        tail = tail->next;
+    }
+    tail->next = a ? a : b;
+    return head.next;
+}
+
+static struct lnode *merge_and_count(void *priv, list_cmp_fn cmp,
+                                     struct lnode *a, unsigned int a_count,
+                                     struct lnode *b, unsigned int b_count)
+{
+    (void)a_count;
+    (void)b_count;
+    return merge(priv, cmp, a, b);
+}
+
+/* The kernel's list_sort: 64 pending runs, each merged when the current index's
+ * trailing zero count says the run of that size is complete. */
+static struct lnode *list_sort(void *priv, struct lnode *list, list_cmp_fn cmp)
+{
+    struct lnode *pending[MAX_LIST_LENGTH_BITS] = { 0 };
+    unsigned int count[MAX_LIST_LENGTH_BITS] = { 0 };
+    unsigned int bits = 0;
+    unsigned int i;
+
+    while (list) {
+        struct lnode *run = list;
+        unsigned int run_count = 1;
+        list = list->next;
+        run->next = NULL;
+
+        for (i = 0; (bits >> i) & 1; i++) {
+            run = merge_and_count(priv, cmp, pending[i], count[i], run, run_count);
+            run_count += count[i];
+            pending[i] = NULL;
+            count[i] = 0;
+        }
+        pending[i] = run;
+        count[i] = run_count;
+        bits++;
+    }
+
+    list = NULL;
+    for (i = 0; i < MAX_LIST_LENGTH_BITS; i++) {
+        if (pending[i])
+            list = list ? merge_and_count(priv, cmp, pending[i], count[i], list, 0)
+                        : pending[i];
+    }
+    return list;
+}
+
+/* Reference: the same merge sort, but only the sortedness/stability properties
+ * are re-derived with a plain insertion-style pass over the result, so the
+ * check does not depend on a golden number from any compiler. */
+static int verify_sorted_stable(const struct lnode *list, unsigned int expected)
+{
+    unsigned int seen = 0;
+    const struct lnode *prev = NULL;
+    for (; list; list = list->next) {
+        if (prev) {
+            if (list->key < prev->key)
+                return 0; /* not sorted */
+            if (list->key == prev->key && list->seq < prev->seq)
+                return 0; /* not stable */
+        }
+        prev = list;
+        seen++;
+    }
+    return seen == expected;
+}
+
+int main(void)
+{
+    static struct lnode nodes[ELEMENTS];
+    unsigned long long checksum = 0;
+    unsigned int pass, i;
+    int ok = 1;
+
+    for (pass = 0; pass < PASSES; pass++) {
+        struct lnode *list = NULL;
+
+        /* Deterministic key distribution with many ties, which is what makes
+         * the stability check meaningful. */
+        for (i = 0; i < ELEMENTS; i++) {
+            unsigned int state = (i + 1) * 2654435761U + pass * 97U;
+            nodes[i].key = (state >> 11) % 512U;
+            /* The nodes are pushed onto the FRONT of the list, so the list's
+             * original order is descending in `i`; assigning seq that way
+             * keeps "stable" meaning "original list order preserved". */
+            nodes[i].seq = ELEMENTS - 1 - i;
+            nodes[i].next = list;
+            list = &nodes[i];
+        }
+
+        list = list_sort(NULL, list, key_cmp);
+
+        if (!verify_sorted_stable(list, ELEMENTS))
+            ok = 0;
+        for (i = 0; list && i < ELEMENTS; i++, list = list->next)
+            checksum = checksum * 31U + list->key;
+    }
+
+    printf("linux_list_sort checksum=%llu sorted_and_stable=%s\n",
+           checksum, ok ? "OK" : "BROKEN");
+    return ok ? 0 : 1;
+}
diff --git a/tests/benchmark/programs/zstd_double_fast.c b/tests/benchmark/programs/zstd_double_fast.c
new file mode 100644
index 0000000..d41b653
--- /dev/null
+++ b/tests/benchmark/programs/zstd_double_fast.c
@@ -0,0 +1,188 @@
+/*
+ * Workload-derived kernel: Zstandard 1.5.7, lib/compress/zstd_double_fast.c.
+ *
+ * The double-hash match search below is extracted from Zstandard's
+ * zstd_double_fast.c (BSD-3-Clause OR GPL-2.0). ZSTD's context, block
+ * iteration, sequence encoding and entropy stages were removed; the harness
+ * builds a deterministic input, runs the same two-table hash search the
+ * compression loop performs, and checks the matches it produces against a naive
+ * scan. Names are prefixed. Full source provenance is in
+ * tests/benchmark/WORKLOAD_PROVENANCE.md.
+ *
+ * Why this shape: ZSTD_compressBlock_doubleFast is Zstandard's *fast* level
+ * matcher and it is the shape a code generator most often gets wrong, because
+ * the whole inner loop is built out of unaligned 32/64-bit loads whose results
+ * feed address arithmetic:
+ *
+ *   * `MEM_read32` / `MEM_read64` at arbitrary offsets -- the kernel keeps both
+ *     as plain loads and relies on the target allowing unaligned access, so a
+ *     backend that conservatively splits them into byte loads loses most of
+ *     the throughput;
+ *   * two independent hash tables (`hashLong` 8-byte and `hashSmall` 4-byte)
+ *     probed in the same iteration -- two dependent load chains that a
+ *     scheduler should overlap;
+ *   * `ZSTD_count` extension of a candidate match using a 64-bit XOR plus
+ *     `__builtin_ctzll`, then an unaligned 64-bit compare loop.
+ *
+ * The self-check compares every reported match length against a byte-by-byte
+ * scan of the same candidate, so the kernel cannot silently "win" by finding
+ * shorter matches.
+ */
+#include <stdio.h>
+#include <string.h>
+
+#ifndef INPUT_SIZE
+#define INPUT_SIZE (1UL << 16)
+#endif
+#ifndef PASSES
+/* Keep default timing runs above the process-startup noise floor.
+ * Bounded Callgrind screens explicitly override PASSES=1. */
+#define PASSES 512U
+#endif
+#ifndef MIN_MATCH
+#define MIN_MATCH 4
+#endif
+
+typedef unsigned int u32;
+typedef unsigned long long u64;
+
+#define HASHLOG_SMALL 10
+#define HASHLOG_LONG 12
+#define HASH_SMALL_SIZE (1U << HASHLOG_SMALL)
+#define HASH_LONG_SIZE (1U << HASHLOG_LONG)
+#define MAX_DISTANCE (1U << 16)
+
+static unsigned char input[INPUT_SIZE + 64];
+static u32 hash_small[HASH_SMALL_SIZE];
+static u32 hash_long[HASH_LONG_SIZE];
+
+/* ZSTD's MEM_read32 / MEM_read64: deliberately unaligned. */
+static u32 read32(const void *p)
+{
+    u32 v;
+    memcpy(&v, p, sizeof v);
+    return v;
+}
+
+static u64 read64(const void *p)
+{
+    u64 v;
+    memcpy(&v, p, sizeof v);
+    return v;
+}
+
+/* ZSTD_XXH64-style multiplicative hash truncation, as used by
+ * ZSTD_hashPtr for the 4- and 8-byte tables. Only the top bits are kept. */
+static u32 hash4(u32 sequence)
+{
+    return (u32)((sequence * 2654435761U) >> (32 - HASHLOG_SMALL));
+}
+
+static u32 hash8(u64 sequence)
+{
+    return (u32)((sequence * 11400714819323198485ULL) >> (64 - HASHLOG_LONG));
+}
+
+/* ZSTD_count: extend a match with 64-bit XOR + ctz, then bytes. */
+static u32 count_match(const unsigned char *p_in, const unsigned char *p_match,
+                       const unsigned char *p_in_limit)
+{
+    const unsigned char *start = p_in;
+    while (p_in + 8 <= p_in_limit) {
+        u64 diff = read64(p_in) ^ read64(p_match);
+        if (diff != 0)
+            return (u32)(p_in - start) + ((u32)__builtin_ctzll(diff) >> 3);
+        p_in += 8;
+        p_match += 8;
+    }
+    while (p_in < p_in_limit && *p_in == *p_match) {
+        p_in++;
+        p_match++;
+    }
+    return (u32)(p_in - start);
+}
+
+/* One pass of the double-fast search: exactly the two-table probe of
+ * ZSTD_compressBlock_doubleFast, with the block walk reduced to a step loop. */
+static u64 search_pass(u32 start, u32 end, int *mismatch)
+{
+    const unsigned char *base = input;
+    const unsigned char *ip = base + start;
+    const unsigned char *iend = base + end;
+    const unsigned char *ilimit = iend - 8;
+    u64 total = 0;
+
+    while (ip < ilimit) {
+        u32 small = read32(ip);
+        u32 h_small = hash4(small);
+        u32 h_long = hash8(read64(ip));
+        u32 match_index_small = hash_small[h_small];
+        u32 match_index_long = hash_long[h_long];
+
+        hash_small[h_small] = (u32)(ip - base);
+        hash_long[h_long] = (u32)(ip - base);
+
+        /* Long-table candidate first, exactly as double-fast does. */
+        if (match_index_long < (u32)(ip - base)
+            && (u32)(ip - base) - match_index_long <= MAX_DISTANCE
+            && read64(base + match_index_long) == read64(ip)) {
+            const unsigned char *match = base + match_index_long;
+            u32 len = MIN_MATCH + count_match(ip + MIN_MATCH, match + MIN_MATCH, iend);
+            /* Self-check: the same length from a byte-wise scan. */
+            u32 reference = 0;
+            while (ip + reference < iend && match[reference] == ip[reference])
+                reference++;
+            if (reference != len)
+                *mismatch = 1;
+            total += len;
+            ip += len > 0 ? len : 1;
+            continue;
+        }
+        if (match_index_small < (u32)(ip - base)
+            && (u32)(ip - base) - match_index_small <= MAX_DISTANCE
+            && read32(base + match_index_small) == small) {
+            const unsigned char *match = base + match_index_small;
+            u32 len = MIN_MATCH + count_match(ip + MIN_MATCH, match + MIN_MATCH, iend);
+            u32 reference = 0;
+            while (ip + reference < iend && match[reference] == ip[reference])
+                reference++;
+            if (reference != len)
+                *mismatch = 1;
+            total += len;
+            ip += len > 0 ? len : 1;
+            continue;
+        }
+        ip += 1;
+    }
+    return total;
+}
+
+int main(void)
+{
+    u64 checksum = 0;
+    unsigned int pass, i;
+    int mismatch = 0;
+
+    for (i = 0; i < INPUT_SIZE + 64; i++) {
+        u32 state = i * 2654435761U + 12345U;
+        input[i] = (unsigned char)('A' + ((state >> 13) % 7));
+        if (i > 64 && (state & 3) == 0)
+            input[i] = input[i - 1 - ((state >> 7) & 31)];
+        if (i > 1024 && (state & 7) == 0)
+            input[i] = input[i - 1024 + ((state >> 9) & 7)];
+    }
+
+    for (pass = 0; pass < PASSES; pass++) {
+        u64 total;
+        /* The tables are rebuilt per pass: a pass must not depend on the
+         * previous pass's table state for its own result to be meaningful. */
+        memset(hash_small, 0, sizeof hash_small);
+        memset(hash_long, 0, sizeof hash_long);
+        total = search_pass(16, (u32)(INPUT_SIZE - 16), &mismatch);
+        checksum = checksum * 1000003ULL + total;
+    }
+
+    printf("zstd_double_fast checksum=%llu matches_verified=%s\n",
+           checksum, mismatch ? "MISMATCH" : "OK");
+    return mismatch ? 1 : 0;
+}
