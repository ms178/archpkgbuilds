+/// ranges miscompiled.
+fn domain_of(ty: IrType) -> Option<(u32, bool)> {
+    Some(match ty {
+        IrType::I8 => (8, true),
+        IrType::U8 => (8, false),
+        IrType::I16 => (16, true),
+        IrType::U16 => (16, false),
+        IrType::I32 => (32, true),
+        IrType::U32 => (32, false),
+        IrType::I64 => (64, true),
+        IrType::U64 => (64, false),
+        _ => return None, // I128/U128/FP/aggregate: out of scope, fail closed
