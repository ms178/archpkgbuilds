+        // Sign/zero-extension of the accumulator.
+        //   cbtw/cwtl/cltq/cbw/cwde/cdqe: read the narrow form, write RAX.
+        //   cwtd/cltd/cqto/cwd/cdq/cqo:   read RAX, write RDX (the dividend
+        //                                  half must never be treated as
+        //                                  intact across it).
+        b"cbtw" | b"cwtl" | b"cltq" | b"cbw" | b"cwde" | b"cdqe" => (RAX, RAX),
+        b"cwtd" | b"cltd" | b"cqto" | b"cwd" | b"cdq" | b"cqo" => (RAX | RDX, RDX),
