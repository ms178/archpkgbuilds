+        let mut insts = roundtrip(2, 3);
+        insts.insert(10, load(40, 3));
+        let mut f = func_with(insts);
+        assert_eq!(run(&mut f), 0, "the observer must see the first store");
+    }
+
+    #[test]
+    fn a_memory_backed_simd_observer_blocks_store_relocation() {
+        let mut insts = roundtrip(2, 3);
+        insts.insert(
