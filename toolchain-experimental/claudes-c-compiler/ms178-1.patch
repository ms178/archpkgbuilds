diff --git a/tests/regression/vectorize_sum_i64.c b/tests/regression/vectorize_sum_i64.c
new file mode 100644
index 0000000..0b3c083
--- /dev/null
+++ b/tests/regression/vectorize_sum_i64.c
@@ -0,0 +1,17 @@
+/* I64 reduction must vectorize (2-wide paddq) and remain correct.
+ * Godbolt oracle: GCC/Clang/ICX all vectorize this pattern. */
+long long sum_i64(const long long *restrict a, int n) {
+    long long s = 0;
+    for (int i = 0; i < n; i++) s += a[i];
+    return s;
+}
+int main(void) {
+    long long a[16];
+    long long expect = 0;
+    for (int i = 0; i < 16; i++) { a[i] = i + 1; expect += a[i]; }
+    if (sum_i64(a, 16) != expect) return 1;
+    if (sum_i64(a, 1) != 1) return 2;
+    if (sum_i64(a, 0) != 0) return 3;
+    if (sum_i64(a, 3) != 6) return 4;
+    return 0;
+}
