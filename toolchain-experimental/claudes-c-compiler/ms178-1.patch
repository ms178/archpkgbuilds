diff --git a/tests/regression/noinline_prototype_attribute.c b/tests/regression/noinline_prototype_attribute.c
new file mode 100644
index 000000000..4a0b1c394
--- /dev/null
+++ b/tests/regression/noinline_prototype_attribute.c
@@ -0,0 +1,40 @@
+/* gcc.c-torture/execute/frame-address.c: a noinline attribute on a prior
+ * prototype belongs to the function and must constrain its later definition.
+ * Losing it lets O2/O3 inline the frame walk and makes the runtime ordering
+ * checks fail.  noipa is retained from the original source; noinline is the
+ * attribute whose declaration merge is under test. */
+void abort(void);
+
+int check_fa_work(const char *, const char *) __attribute__((noinline, noipa));
+int check_fa_mid(const char *) __attribute__((noinline, noipa));
+int check_fa(char *) __attribute__((noinline, noipa));
+int how_much(void) __attribute__((noinline, noipa));
+
+int check_fa_work(const char *c, const char *f) {
+    const char d = 0;
+    if (c >= &d)
+        return c >= f && f >= &d;
+    return c <= f && f <= &d;
+}
+
+int check_fa_mid(const char *c) {
+    const char *f = __builtin_frame_address(0);
+    /* Prevent a tail call from eliding this stack frame. */
+    return check_fa_work(c, f) != 0;
+}
+
+int check_fa(char *unused) {
+    const char c = 0;
+    return check_fa_mid(&c) != 0;
+}
+
+int how_much(void) {
+    return 8;
+}
+
+int main(void) {
+    char *unused = __builtin_alloca(how_much());
+    if (!check_fa(unused))
+        abort();
+    return 0;
+}
diff --git a/tests/regression/overflow_mul_narrow_result.c b/tests/regression/overflow_mul_narrow_result.c
new file mode 100644
index 000000000..30ade7120
--- /dev/null
+++ b/tests/regression/overflow_mul_narrow_result.c
@@ -0,0 +1,46 @@
+/* gcc.c-torture pr71554 and pr108789: exact 32-bit products must not need
+ * an I128 overflow computation on i686.  The no-overflow cases also pin the
+ * mathematical signedness of mixed operands; the large unsigned case wraps
+ * in the signed I64 compute type and must still be caught by the narrow
+ * result round-trip. */
+#define NOINLINE __attribute__((noinline, noclone))
+
+NOINLINE int mixed_mul(unsigned a, int b, int *r) {
+    return __builtin_mul_overflow(a, b, r);
+}
+
+NOINLINE int unsigned_mul(unsigned a, unsigned b, unsigned *r) {
+    return __builtin_mul_overflow(a, b, r);
+}
+
+NOINLINE int signed_mul(int a, int b, int *r) {
+    return __builtin_mul_overflow(a, b, r);
+}
+
+#define CHECK(call, expected_overflow, expected_result)                      \
+    do {                                                                     \
+        if ((call) != (expected_overflow) || r != (expected_result))          \
+            return __LINE__;                                                 \
+    } while (0)
+
+int main(void) {
+    const int min = -__INT_MAX__ - 1;
+    const unsigned umax = ~0U;
+    {
+        int r;
+        CHECK(mixed_mul(2, min / 2, &r), 0, min);
+        CHECK(mixed_mul(3, min / 2, &r), 1, __INT_MAX__ / 2 + 1);
+        CHECK(mixed_mul(1, -1, &r), 0, -1);
+        CHECK(mixed_mul(umax, -1, &r), 1, 1);
+        CHECK(signed_mul(min, min, &r), 1, 0);
+        CHECK(signed_mul(min, -1, &r), 1, min);
+    }
+    {
+        unsigned r;
+        CHECK(unsigned_mul(256, 256, &r), 0, 65536U);
+        CHECK(unsigned_mul(65536, 65536, &r), 1, 0U);
+        CHECK(unsigned_mul(0x80000000U, 2, &r), 1, 0U);
+        CHECK(unsigned_mul(umax, umax, &r), 1, 1U);
+    }
+    return 0;
+}
diff --git a/tests/regression/store_forwarding_dword_self_reload.c b/tests/regression/store_forwarding_dword_self_reload.c
new file mode 100644
index 000000000..8ca769f7a
--- /dev/null
+++ b/tests/regression/store_forwarding_dword_self_reload.c
@@ -0,0 +1,16 @@
+/* gcc.c-torture pr39240.c, reduced to the x86-64 store-forwarding defect.
+ * identity deliberately leaves unspecified upper bits in its integer return
+ * register.  Converting produce's unsigned-int result to unsigned long must
+ * retain the dword zero-extension even when phase 1 removes an explicit zext
+ * and phase 2 forwards the subsequent same-register dword spill reload. */
+extern void abort(void);
+
+__attribute__((noinline)) static int identity(int x) { return x; }
+__attribute__((noinline)) unsigned int produce(int x) { return identity(x + 6); }
+volatile unsigned long expected = (unsigned int)-4;
+
+int main(void) {
+    if (produce(-10) != expected)
+        abort();
+    return 0;
+}
