+        let is_iv = dest.0 == iv_phi.0;
+        for (op, lbl) in incoming.iter_mut() {
+            if *lbl == latch_label {
+                *lbl = body_label;
+                if is_iv {
+                    *op = Operand::Value(iv_back);
