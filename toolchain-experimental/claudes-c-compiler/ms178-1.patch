From dcda5d5f3138585e59dd93ea8ec4a1337061aa9f Mon Sep 17 00:00:00 2001
From: lccc-agent <agent@arena.invalid>
Date: Wed, 21 Oct 2026 20:30:49 +0000
Subject: [PATCH 08/38] peephole: narrow_copy_fold folds %rbp copies only on
 GPR evidence

because frameless functions use %rbp as an ordinary allocatable register.
For same-value rewrites that is right. narrow_copy_fold deletes and
redirects copies, so instead of dropping the guard it takes the same
whole-function evidence as relay_and_lea (`rbp_is_gpr_in_function`):

* %rsp: never a copy source or destination (push/pop/call move it).
* %rbp: folded only when the function never establishes a frame.
* A self-move of %rbp is dead in either role (same bits rewritten).

The file-wide copy scan memoises the evidence per function, so a
frameless function with many %rbp copies pays one linear scan.

Tests (direct pass calls, so relay_and_lea cannot mask the gate): copy
out of / into a GPR rbp folds; a frame-pointer rbp copy is kept; an rsp
copy is never folded; an rbp self-move is dead, an rsp one is kept.
Mutation check: gate always-allow, always-deny, rsp allowed and
self-move rbp exclusion are all caught (4/4).
---
 .../peephole/passes/narrow_copy_fold_tests.rs | 92 +++++++++++++++++++
 1 file changed, 92 insertions(+)

diff --git a/src/backend/x86/codegen/peephole/passes/narrow_copy_fold_tests.rs b/src/backend/x86/codegen/peephole/passes/narrow_copy_fold_tests.rs
index 30092c65c..1742ebc04 100644
--- a/src/backend/x86/codegen/peephole/passes/narrow_copy_fold_tests.rs
+++ b/src/backend/x86/codegen/peephole/passes/narrow_copy_fold_tests.rs
@@ -912,3 +912,95 @@ mod copyback_producer_tests {
         );
     }
 }
+
+// ── frame-register evidence gate (direct pass calls) ────────────────────────
+//
+// These call `fold_register_copies` alone: the full pipeline also runs
+// `relay_and_lea`, whose own rbp retarget would fold the same copies and
+// mask a broken gate here.
+
+mod frame_register_gate {
+    use super::super::*;
+    use crate::backend::peephole_common::LineStore;
+
+    fn fold(body: &str) -> String {
+        let asm = super::f(body);
+        let mut store = LineStore::new(asm);
+        let mut infos: Vec<LineInfo> = (0..store.len())
+            .map(|i| classify_line(store.get(i)))
+            .collect();
+        fold_register_copies(&mut store, &mut infos);
+        (0..store.len())
+            .filter(|&i| !infos[i].is_nop())
+            .map(|i| store.get(i).trim().to_string())
+            .collect::<Vec<_>>()
+            .join("\n")
+    }
+
+    /// In a frameless function `%rbp` is an allocator GPR (callee-save
+    /// push/pop only), so a copy out of it folds like any other.
+    #[test]
+    fn a_copy_out_of_a_gpr_rbp_folds() {
+        let out = fold(concat!(
+            "    pushq %rbp\n",
+            "    leaq 8(%rdi), %rbp\n",
+            "    movq %rbp, %r11\n",
+            "    addq %r11, %rax\n",
+            "    popq %rbp\n",
+            "    ret"
+        ));
+        assert_eq!(super::count(&out, "movq %rbp, %r11"), 0, "copy must go:\n{out}");
+        assert!(out.contains("addq %rbp, %rax"), "use must read rbp:\n{out}");
+    }
+
+    /// And a copy INTO a GPR `%rbp` whose only reader follows folds onto
+    /// the source (`popq %rbp` ends rbp's value).
+    #[test]
+    fn a_copy_into_a_gpr_rbp_folds() {
+        let out = fold(concat!(
+            "    pushq %rbp\n",
+            "    movq %rdi, %rbp\n",
+            "    addq %rbp, %rax\n",
+            "    popq %rbp\n",
+            "    ret"
+        ));
+        assert_eq!(super::count(&out, "movq %rdi, %rbp"), 0, "copy must go:\n{out}");
+        assert!(out.contains("addq %rdi, %rax"), "use must read rdi:\n{out}");
+    }
+
+    /// The same copy in a frame-pointer function stays: there `%rbp` anchors
+    /// the CFA and `leave`/`popq` redefine it implicitly.
+    #[test]
+    fn a_copy_out_of_a_frame_pointer_rbp_is_kept() {
+        let out = fold(concat!(
