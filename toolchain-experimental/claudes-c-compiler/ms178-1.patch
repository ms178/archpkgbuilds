+++ b/tests/regression/check_dash_o_stdout.sh
@@ -0,0 +1,57 @@
+#!/usr/bin/env bash
+# AUD-DRV-1 gate: `-o -` is the standard output for every TEXT mode.
+#
+# `gcc -S -o - x.c` writes assembly to stdout; before this fix lccc created a
+# FILE literally named `-` in the working directory and wrote nothing to
+# stdout, so `lccc -S -o - x.c | ...` pipelines (and anything that streams
+# preprocessed text) silently got an empty stream plus a stray file.
+#
+# Pinned here:
+#   * -S / -E / -M / -MM / -dM with `-o -` write to stdout (through a PIPE,
+#     which is how consumers use it);
+#   * `-MF -` writes the make rule to stdout (GCC);
+#   * object/executable modes reject `-o -` with a diagnostic instead of
+#     producing a binary in a file named `-` (GCC refuses too).
+set -euo pipefail
+
+CCC=$(realpath "${CCC:-./target/fastbuild/lccc}")
+td=$(mktemp -d)
+trap 'rm -rf "$td"' EXIT
+cd "$td"
+printf 'int f(void){return 42;}\n' > t.c
+
+fail=0
+note() { printf 'FAIL: %s\n' "$1" >&2; fail=1; }
+
+# 1. -S to stdout, consumed through a pipe.
+got=$("$CCC" -S -o - t.c | grep -c 'f:')
+[ "$got" = 1 ] || note "-S -o - did not stream assembly to stdout (matches: ${got:-0})"
+[ -e ./- ] && note "-S -o - created a file named '-'"
+
+# 2. -E to stdout.
+"$CCC" -E -o - t.c | grep -c 'return 42' >/dev/null || note "-E -o - did not stream preprocessed text"
+[ -e ./- ] && note "-E -o - created a file named '-'"
+
+# 3. -M to stdout (dependency mode).
+"$CCC" -M -o - t.c | grep -c '^[^:]*: ' >/dev/null || note "-M -o - did not stream a make rule"
+[ -e ./- ] && note "-M -o - created a file named '-'"
+
+# 4. -dM to stdout.
+"$CCC" -dM -E -o - t.c | grep -c '^#define __STDC__' >/dev/null || note "-dM -E -o - did not stream macro definitions"
+
+# 5. -MF - sends the dependency rule to stdout.
+"$CCC" -c t.c -o /dev/null -MMD -MF - | grep -c 't.c' >/dev/null || note "-MF - did not stream the dependency rule"
+
+# 6. Object/executable modes must refuse, not create a file named '-'.
+out=$("$CCC" -c -o - t.c 2>&1) && note "-c -o - was accepted"
+grep -c 'cannot write an object file or executable to stdout' <<<"$out" >/dev/null ||
+    note "-c -o - rejection lacks the explanatory diagnostic: $out"
+[ -e ./- ] && note "-c -o - created a file named '-'"
+
+# 7. Negative control: a real file path still works (the change must not have
+#    turned every -o into stdout).
+"$CCC" -S -o real.s t.c
+[ -s real.s ] || note "-S -o real.s did not write the assembly file"
+
+[ "$fail" = 0 ] || { echo 'dash-o-stdout: FAIL'; exit 1; }
+echo 'dash-o-stdout: PASS'
diff --git a/tests/regression/check_fp_contract_parity.sh b/tests/regression/check_fp_contract_parity.sh
new file mode 100755
index 00000000..781d3beb
--- /dev/null
+++ b/tests/regression/check_fp_contract_parity.sh
@@ -0,0 +1,79 @@
+#!/usr/bin/env bash
+# FP-contraction parity gate (GCC: -O0/-O1 never fuse, -O2 does).
+#
+# THE DEFECT THIS PINS
+# --------------------
+# LCCC's C default is `-ffp-contract=fast` (matching GCC's *flag* default), and
+# it applied at every optimization level.  Measured on gcc 14.2, GCC never
+# contracts `a*b + c` into an FMA at -O0 or -O1 -- not even with
+# `-march=x86-64-v3` and not even under `-ffast-math`; the fusion appears at
+# -O2.  So `lccc -O0` and `gcc -O0` printed different numbers for the same FP
+# program, which is how 26 `miscompile_gen_fp_stress_*` reproducers were filed
+# against this compiler while both results were conforming (the real defect was
+# the level mismatch, not the arithmetic).
+#
+# WHAT IS CHECKED
+# ---------------
+#   1. -O0 and -O1 emit NO fma mnemonic for `a*b + c` (GCC parity), while
+#      -O2 does (positive control: a gate that never sees an FMA cannot
+#      prove the rule is specific to the low levels).
+#   2. An explicit `-ffp-contract=fast` at -O0 DOES contract, and an explicit
+#      `-ffp-contract=off` at -O2 does NOT: the flag still wins.
+#   3. Numeric agreement with GCC at -O0/-O1 (identical stdout, 17 digits)
+#      on a cancellation-sensitive chain, and at -O2 with the ISA-matched GCC
+#      arm (`-march=x86-64-v3` = LCCC's documented default target).
+set -euo pipefail
+
+CCC=$(realpath "${CCC:-./target/fastbuild/lccc}")
+GCC=${GCC_BIN:-gcc}
+td=$(mktemp -d)
+trap 'rm -rf "$td"' EXIT
+cd "$td"
+
+cat > fma.c <<'EOF'
+double fuse(double a, double b, double c) { return a * b + c; }
+EOF
+cat > chain.c <<'EOF'
+#include <stdio.h>
+int main(void) {
+    volatile double v0 = 384.9218040120, c4 = 94.333300881796674;
+    double s = v0;
+    s = s * c4 + v0; s = s * c4 + v0; s = s * c4 + v0;
+    s = s * c4 + v0; s = s * c4 + v0; s = s * c4 + v0;
+    printf("%.17g\n", s);
+    return 0;
+}
+EOF
+
+FMA_RE='(^|[[:space:]])(vfmadd|vfmsub|vfnmadd|vfnmsub|fmadd|fmsub)[a-z0-9]*[[:space:]]'
+fail=0
+note() { printf 'FAIL: %s\n' "$1" >&2; fail=1; }
+
+# 1. level matrix on the emitted assembly.
+"$CCC" -O0 -S fma.c -o o0.s
+"$CCC" -O1 -S fma.c -o o1.s
+"$CCC" -O2 -S fma.c -o o2.s
+grep -cE "$FMA_RE" o0.s >/dev/null && note "-O0 fused a*b+c into an FMA (GCC does not)"
+grep -cE "$FMA_RE" o1.s >/dev/null && note "-O1 fused a*b+c into an FMA (GCC does not)"
+grep -cE "$FMA_RE" o2.s >/dev/null || note "-O2 did NOT emit an FMA (positive control lost)"
+
+# 2. explicit flags win at any level.
+"$CCC" -O0 -ffp-contract=fast -S fma.c -o o0fast.s
+"$CCC" -O2 -ffp-contract=off -S fma.c -o o2off.s
+grep -cE "$FMA_RE" o0fast.s >/dev/null || note "-O0 -ffp-contract=fast did not contract (flag ignored)"
+grep -cE "$FMA_RE" o2off.s >/dev/null && note "-O2 -ffp-contract=off still contracted (flag ignored)"
+
+# 3. numeric agreement, level by level (the ISA-matched GCC arm at -O2).
+for lvl in -O0 -O1 -O2; do
+    "$CCC" "$lvl" chain.c -o lccc.bin
+    if [ "$lvl" = "-O2" ]; then
+        "$GCC" "$lvl" -march=x86-64-v3 chain.c -o gcc.bin
+    else
+        "$GCC" "$lvl" chain.c -o gcc.bin
+    fi
+    ours=$(./lccc.bin); theirs=$(./gcc.bin)
+    [ "$ours" = "$theirs" ] || note "$lvl numeric mismatch: lccc=$ours gcc=$theirs"
+done
+
+[ "$fail" = 0 ] || { echo 'fp-contract parity: FAIL'; exit 1; }
+echo 'fp-contract parity: PASS (-O0/-O1 unfused like GCC, -O2 fused, flags honored, numbers agree)'
diff --git a/tests/regression/check_got_slot_local_addend.sh b/tests/regression/check_got_slot_local_addend.sh
new file mode 100644
index 00000000..3b46d2dc
--- /dev/null
+++ b/tests/regression/check_got_slot_local_addend.sh
@@ -0,0 +1,217 @@
+#!/usr/bin/env bash
+# AUD-CPU-1 follow-up gate: GOT-slot references to file-local symbols.
+#
+# The defect this pins was found while making the i686 runtime probe helper
+# position independent: the assembler folded a local symbol out of GOT-slot
+# relocations (`@GOT`/`@GOTPCREL`), so the linker computed the slot address
+# from the *section* and added the symbol's offset a second time.  Measured on
+# the files below: exit status 145 instead of 25 with GNU ld, and a fault under
+# the LCCC linker.  `tests/data/got_slot_local_addend_{x86_64,i686}.s` read two
+# locals of nonzero offset through their GOT slots and return 3*5 + 5*2 = 25;
+# every pipeline must give exit status 25.
+#
+# The spelling half (x86-64): GAS 2.47 emits the relaxable
+# `R_X86_64_{REX_,}GOTPCRELX` only for instruction forms a linker may rewrite
+# (`mov` load, `test`, the eight binops in both directions, indirect
+# `call/jmp/push`) and the plain `R_X86_64_GOTPCREL` for stores, `lea` and
+# immediate forms.  LCCC matches that exactly, form by form; when the pinned
+# GAS 2.47 oracle is present the gate compares the full (type, symbol) lists
+# instead of trusting the table in this comment.  i686 still emits
+# `R_386_GOT32` where GAS emits the relaxable `R_386_GOT32X`: that is a
+# relaxation/size opportunity, not a correctness difference, and the gate
+# reports it explicitly rather than hiding it (follow-up ledger item).
+set -uo pipefail
+
+CCC=$(realpath "${CCC:-./target/fastbuild/lccc}")
+REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
+cd "$REPO"
+GAS=${GAS_ORACLE:-$HOME/.cache/gas-2.47-x86_64-linux-gnu/bin/as}
+GCC=${GCC_BIN:-gcc}
+td=$(mktemp -d)
+trap 'rm -rf "$td"' EXIT
+fail=0
+ok()   { printf 'ok   %s\n' "$*"; }
+bad()  { printf 'FAIL %s\n' "$*"; fail=1; }
+skip() { printf 'SKIP %s\n' "$*"; }
+
+[ -x "$CCC" ] || { echo "FAIL: no compiler at $CCC"; exit 1; }
+
+x64_src=tests/data/got_slot_local_addend_x86_64.s
+i686_src=tests/data/got_slot_local_addend_i686.s
+[ -f "$x64_src" ] && [ -f "$i686_src" ] || { echo "FAIL: missing test data"; exit 1; }
+
+# ------------------------------------------------- 1. the values must be right
+run_25() { # description
+    local desc=$1
+    if [ ! -x "$td/prog" ]; then bad "$desc: no binary produced"; return; fi
+    "$td/prog"
+    local rc=$?
+    if [ "$rc" = 25 ]; then ok "$desc -> exit 25"; else bad "$desc -> exit $rc (want 25)"; fi
+}
+
+try_build() { # description, command...
+    local desc=$1; shift
+    : >"$td/build.log"
+    if "$@" >"$td/build.log" 2>&1; then return 0; fi
+    bad "$desc: build failed"; sed -n '1,4p' "$td/build.log" | sed 's/^/      /'; return 1
+}
+
+rm -f "$td/prog"
+if try_build "x86-64 default" "$CCC" "$x64_src" -o "$td/prog"; then run_25 "x86-64 default (LCCC driver)"; fi
+rm -f "$td/prog"
+if try_build "x86-64 -no-pie" "$CCC" -no-pie "$x64_src" -o "$td/prog"; then run_25 "x86-64 -no-pie (LCCC driver)"; fi
+rm -f "$td/prog"
+if try_build "i686 default" "$CCC" -m32 "$i686_src" -o "$td/prog"; then run_25 "i686 default (LCCC driver)"; fi
+rm -f "$td/prog"
+if try_build "i686 -no-pie" "$CCC" -m32 -no-pie "$i686_src" -o "$td/prog"; then run_25 "i686 -no-pie (LCCC driver)"; fi
+
+# Cross pipeline: the LCCC object, linked by GNU ld.  A fold defect shows up
+# here as 145 (GNU ld doubles the offset) rather than as a fault, so it is the
+# pipeline that isolates the assembler from the LCCC linker.
+rm -f "$td/prog"
+if try_build "x86-64 cross link" "$CCC" -c "$x64_src" -o "$td/x64.o" &&
+   try_build "x86-64 cross link" "$GCC" -no-pie "$td/x64.o" -o "$td/prog"; then
+    run_25 "x86-64 LCCC object + GNU ld"
+fi
+printf 'int main(void) { return 0; }\n' >"$td/m32.c"
+if "$GCC" -m32 -no-pie "$td/m32.c" -o "$td/m32probe" >/dev/null 2>&1; then
+    rm -f "$td/prog"
+    if try_build "i686 cross link" "$CCC" -m32 -c "$i686_src" -o "$td/i686.o" &&
+       try_build "i686 cross link" "$GCC" -m32 -no-pie "$td/i686.o" -o "$td/prog"; then
+        run_25 "i686 LCCC object + GNU ld"
+    fi
+else
+    skip "i686 cross link (no gcc multilib)"
+fi
+
+# ------------------------------------------------------ 2. relocation spelling
+reloc_pairs() { # object, names... -> "TYPE SYMBOL" lines, sorted
+    # `readelf -r --wide` prints the symbol name followed by "+ Addend", or as
+    # the last field when the relocation has no addend.
+    local obj=$1; shift
+    local names
+    names=$(printf '%s\n' "$@")
+    readelf -r --wide "$obj" 2>/dev/null |
+        awk -v want="$names" '
+            BEGIN { n = split(want, a, "\n"); for (i = 1; i <= n; i++) wanted[a[i]] = 1 }
+            $1 !~ /^[0-9a-f]+$/ { next }
+            {
+                name = ($(NF - 1) == "+" || $(NF - 1) == "-") ? $(NF - 2) : $NF
+                if (name in wanted) print $3, name
+            }
+        ' | sort
+}
+
+if try_build "x86-64 object" "$CCC" -c "$x64_src" -o "$td/x64.o"; then
+    want_x64=$(printf 'R_X86_64_REX_GOTPCRELX q1\nR_X86_64_REX_GOTPCRELX q2\n')
+    got_x64=$(reloc_pairs "$td/x64.o" q1 q2)
+    if [ "$got_x64" = "$want_x64" ]; then
+        ok "x86-64: mov-load keeps the symbol with the relaxable spelling"
+    else
+        bad "x86-64 GOT reloc spelling"; printf '      want: %s\n      got:  %s\n' \
+            "$(echo "$want_x64" | tr '\n' ';')" "$(echo "$got_x64" | tr '\n' ';')"
+    fi
+fi
+
+# The instruction-form contract, form by form, against the pinned oracle.
+cat >"$td/forms.s" <<'EOF'
+	.text
+	.globl f1
+f1:	movq q1@GOTPCREL(%rip), %rax
+	ret
+	.globl f2
+f2:	movl q2@GOTPCREL(%rip), %eax
+	ret
+	.globl f3
+f3:	addq q3@GOTPCREL(%rip), %rax
+	ret
+	.globl f4
+f4:	movl %eax, q4@GOTPCREL(%rip)
+	ret
+	.globl f5
+f5:	pushq q5@GOTPCREL(%rip)
+	ret
+	.globl f6
+f6:	cmpl $1, q6@GOTPCREL(%rip)
+	ret
+	.globl f7
+f7:	leaq q7@GOTPCREL(%rip), %rax
+	ret
+	.data
+	.globl q1
+q1:	.quad 1
+	.globl q2
+q2:	.long 1
+	.globl q3
+q3:	.quad 1
+	.globl q4
+q4:	.long 1
+	.globl q5
+q5:	.quad 1
+	.globl q6
+q6:	.long 1
+	.globl q7
+q7:	.quad 1
+EOF
+if try_build "x86-64 form probe" "$CCC" -c "$td/forms.s" -o "$td/forms_l.o"; then
+    want_forms='R_X86_64_REX_GOTPCRELX q1
+R_X86_64_GOTPCRELX q2
+R_X86_64_REX_GOTPCRELX q3
+R_X86_64_GOTPCREL q4
+R_X86_64_GOTPCRELX q5
+R_X86_64_GOTPCREL q6
+R_X86_64_GOTPCREL q7'
+    got_forms=$(reloc_pairs "$td/forms_l.o" q1 q2 q3 q4 q5 q6 q7)
+    # reloc_pairs sorts by "TYPE SYMBOL", so the expectation is sorted the same
+    # way before comparing.
+    want_forms=$(printf '%s\n' "$want_forms" | sort)
+    if [ -n "$got_forms" ] && [ "$got_forms" = "$want_forms" ]; then
+        ok "x86-64: all seven instruction forms match the GAS 2.47 spelling"
+    else
+        bad "x86-64 instruction-form spelling"
+        diff <(printf '%s\n' "$want_forms") <(printf '%s\n' "$got_forms") |
+            sed 's/^/      /' | sed -n '1,10p'
+    fi
+    if [ -x "$GAS" ]; then
+        if "$GAS" --64 "$td/forms.s" -o "$td/forms_g.o" 2>/dev/null; then
+            oracle=$(reloc_pairs "$td/forms_g.o" q1 q2 q3 q4 q5 q6 q7)
+            if [ -z "$oracle" ]; then
+                bad "the pinned oracle's own relocations could not be read"
+            elif [ "$oracle" = "$got_forms" ]; then
+                ok "x86-64: exact agreement with the pinned GAS 2.47 oracle (7 rows)"
+            else
+                bad "x86-64: oracle disagreement (GAS 2.47 vs LCCC)"
+                diff <(printf '%s\n' "$oracle") <(printf '%s\n' "$got_forms") |
+                    sed 's/^/      /' | sed -n '1,10p'
+            fi
+        else
+            bad "oracle present but could not assemble the form probe"
+        fi
+    else
+        skip "GAS 2.47 oracle not installed (pinned table checked instead)"
+    fi
+fi
+
+# i686: values are checked above; the spelling difference is reported, not
+# hidden.  The known, analysed gap is exactly "relaxable instruction form ->
+# GAS writes GOT32X, LCCC writes GOT32".
+if try_build "i686 object" "$CCC" -m32 -c "$i686_src" -o "$td/i686.o"; then
+    if [ "$(reloc_pairs "$td/i686.o" q1 q2)" = "$(printf 'R_386_GOT32 q1\nR_386_GOT32 q2\n')" ]; then
+        ok "i686: GOT32 keeps the symbol (values verified above)"
+    else
+        bad "i686 GOT reloc spelling"; reloc_pairs "$td/i686.o" q1 q2 | sed 's/^/      /'
+    fi
+    if [ -x "$GAS" ]; then
+        if "$GAS" --32 "$i686_src" -o "$td/i686_g.o" 2>/dev/null; then
+            gap=$(diff <(reloc_pairs "$td/i686_g.o" q1 q2) <(reloc_pairs "$td/i686.o" q1 q2) |
+                grep -c '^[<>]' || true)
+            ok "i686: documented spelling gap vs GAS 2.47 (${gap} reloc lines: GOT32X vs GOT32, follow-up ledger)"
+        fi
+    fi
+fi
+
+if [ "$fail" != 0 ]; then
+    echo "GOT-slot local-symbol gate: FAIL"
+    exit 1
+fi
+echo "GOT-slot local-symbol gate: PASS"
diff --git a/tests/regression/check_rec2iter.sh b/tests/regression/check_rec2iter.sh
