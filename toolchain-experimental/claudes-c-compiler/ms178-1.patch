+    if start < 0:
+        raise SystemExit("check_clippy_policy: crate-root clippy policy block not found")
+    end = text.find(")]", start)
+    if end < 0:
+        raise SystemExit("check_clippy_policy: unterminated crate-root clippy policy block")
+    block = text[start:end]
