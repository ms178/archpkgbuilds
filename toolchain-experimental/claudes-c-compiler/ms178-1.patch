+// This tests the non-VLA codegen behavior for _Countof.
+
+typedef typeof(sizeof(0)) size_t;
+
+// CHECK-LABEL: define{{( dso_local)?}} i{{64|32}} @test1(
+// CHECK-SAME: ) #[[ATTR0:[0-9]+]] {
