+    let instructions = f.blocks[0].instructions.split_off(split);
+    let source_spans = f.blocks[0].source_spans.split_off(split);
+    let terminator = std::mem::replace(&mut f.blocks[0].terminator, Terminator::Branch(BlockId(1)));
