+        let asm = "\
+    movslq %eax, %r11\n\
+    movq %r11, %rdi\n\
+    call malloc@PLT\n\
+    # LCCC_CALL_ARGS 1\n\
+    movq %r11, %rdx\n\
+";
+        let (changed, out) = run(asm);
+        assert!(changed, "r11 is clobbered by the call: {out:?}");
+        assert_eq!(out[0], "movslq %eax, %rdi");
+    }
