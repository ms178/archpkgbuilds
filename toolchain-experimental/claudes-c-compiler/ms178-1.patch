+def _reg(root, name, mode=0o644, uid=0, gid=0, uname='root', gname='root'):
+    m = tarfile.TarInfo(f'{root}/{name}')
+    m.type = tarfile.REGTYPE
+    m.size = 0
+    m.mode = mode
+    m.uid, m.gid, m.uname, m.gname = uid, gid, uname, gname
