diff --git a/tests/regression/aggregate_copy_snapshot_overwrite.c b/tests/regression/aggregate_copy_snapshot_overwrite.c
new file mode 100644
index 000000000..65d112d40
--- /dev/null
+++ b/tests/regression/aggregate_copy_snapshot_overwrite.c
@@ -0,0 +1,36 @@
+/* gcc.c-torture pr126405-3, reduced to the aggregate-copy snapshot contract.
+ * old must retain the incoming value after p is overwritten from g0.  A
+ * later copy with an untracked global source is still a definition of p;
+ * aggregate forwarding must not redirect old's reads to the original input.
+ * long long keeps the oversized vector 128 bytes on both x86 ABIs. */
+typedef long long v16di __attribute__((vector_size(16 * sizeof(long long))));
+
+v16di g0, g1;
+
+__attribute__((noinline)) static void dirty_stack(void) {
+    volatile char buf[1024];
+    for (unsigned i = 0; i < sizeof(buf); i++)
+        buf[i] = 0xa5;
+}
+
+/* Deliberately inlinable: the original failure appeared after inlining. */
+static v16di snapshot_sum(v16di p) {
+    v16di old = p;
+    p = g0;
+    g1 = p;
+    return old + p;
+}
+
+int main(void) {
+    v16di a, r;
+    for (int i = 0; i < 16; i++) {
+        a[i] = i + 1;
+        g0[i] = 100;
+    }
+    dirty_stack();
+    r = snapshot_sum(a);
+    for (int i = 0; i < 16; i++)
+        if (r[i] != i + 101 || g1[i] != 100)
+            __builtin_abort();
+    return 0;
+}
diff --git a/tests/regression/aggregate_global_alias_window.c b/tests/regression/aggregate_global_alias_window.c
new file mode 100644
index 000000000..e71255b73
--- /dev/null
+++ b/tests/regression/aggregate_global_alias_window.c
@@ -0,0 +1,59 @@
+/* LCCC i686 wrong code at -O2 (GCC pr126405 source).
+   The aggregate store-forwarder must recognize duplicate GlobalAddr values
+   for g18/g3 as aliases while checking the destination-liveness window.
+   Original GCC note: AArch64 wrong code at -O2.  Store motion creates several SSA versions of an
+   oversized vector temporary (V16DI, 128 bytes, no register mode).  The
+   partition holding the loop-carried versions has an anonymous representative,
+   so out-of-SSA left it and the partition of the copy taken for the use after
+   the loop sharing one MEM_EXPR.  The load/store pair-fusion pass then treated
+   two stores 144 bytes apart as adjacent, fused them, and left the tail of one
+   slot uninitialised.  Self-checking: aborts if the result is wrong.  */
+
+typedef long __attribute__((vector_size (16 * sizeof (long)))) v16di;
+typedef int __attribute__((vector_size (16 * sizeof (int)))) v16si;
+
+long g2, g12;
+v16di g18;
+v16si g3;
+void *g27;
+
+/* The wrong value is read from an uninitialised stack slot, so make sure the
+   stack the callee reuses does not happen to be zero.  */
+__attribute__((noipa)) static void
+dirty_stack (void)
+{
+  volatile char buf[1024];
+  for (unsigned i = 0; i < sizeof (buf); i++)
+    buf[i] = 0xa5;
+}
+
+void
+f31 (void)
+{
+lbl_br1:
+  g18 = ~g18;
+  g3 = ~g3;
+  if (g2)
+    goto lbl_br1;
+lbl_b5:
+  switch (g12)
+    case 4:
+    case 0:
+      goto lbl_sw8;
+  __builtin_abort ();
+lbl_sw8:
+  if (g27)
+    goto lbl_b5;
+  g18 = ~g18;
+}
+
+int
+main (void)
+{
+  dirty_stack ();
+  f31 ();
+  for (int i = 0; i < 16; i++)
+    if (g18[i] != 0)
+      __builtin_abort ();
+  return 0;
+}
diff --git a/tests/regression/builtin_floor_float_narrowing.c b/tests/regression/builtin_floor_float_narrowing.c
new file mode 100644
index 000000000..b290cf9d2
--- /dev/null
+++ b/tests/regression/builtin_floor_float_narrowing.c
@@ -0,0 +1,39 @@
+/* gcc.c-torture/execute/20030125-1.c regression.
+ *
+ * floor((double)x) is exactly floorf(x) when x is a float.  Both the plain
+ * library spelling and __builtin_floor must use that contraction even when
+ * this TU supplies weak test implementations of the two library names.
+ * Before the fix LCCC retained the double call and reached floor(), which
+ * aborts here, at every optimizing level on x86-64 and i686.
+ */
+void abort(void);
+double floor(double);
+float floorf(float);
+
+volatile float zero;
+
+__attribute__((noinline)) float plain_float(float x) { return floor(x); }
+__attribute__((noinline)) double plain_double(float x) { return floor(x); }
+__attribute__((noinline)) float builtin_float(float x) {
+    return __builtin_floor(x);
+}
+__attribute__((noinline)) double builtin_double(float x) {
+    return __builtin_floor(x);
+}
+
+int main(void) {
+    float x = zero;
+    if (plain_float(x) != 0.0f || plain_double(x) != 0.0)
+        abort();
+    if (builtin_float(x) != 0.0f || builtin_double(x) != 0.0)
+        abort();
+    return 0;
+}
+
+__attribute__((weak)) double floor(double x) {
+    (void)x;
+    abort();
+    return 0.0;
+}
+
+__attribute__((weak)) float floorf(float x) { return x; }
