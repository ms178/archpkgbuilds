+    ("meteorlake", CpuModelField::Subtype, 25),
+    ("graniterapids", CpuModelField::Subtype, 30),
+    ("graniterapids-d", CpuModelField::Subtype, 31),
+    ("arrowlake", CpuModelField::Subtype, 32),
+    ("arrowlake-s", CpuModelField::Subtype, 33),
+    ("lunarlake", CpuModelField::Subtype, 33),
+    ("pantherlake", CpuModelField::Subtype, 34),
+    ("diamondrapids", CpuModelField::Subtype, 38),
+    ("wildcatlake", CpuModelField::Subtype, 34),
+    ("novalake", CpuModelField::Subtype, 39),
+    ("bonnell", CpuModelField::Type, 1),
+    ("atom", CpuModelField::Type, 1),
+    ("silvermont", CpuModelField::Type, 6),
+    ("slm", CpuModelField::Type, 6),
+    ("goldmont", CpuModelField::Type, 12),
+    ("goldmont-plus", CpuModelField::Type, 13),
+    ("tremont", CpuModelField::Type, 14),
+    ("gracemont", CpuModelField::Subtype, 25),
+    ("sierraforest", CpuModelField::Type, 17),
