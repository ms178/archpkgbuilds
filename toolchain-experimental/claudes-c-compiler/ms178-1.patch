+    body=$(fn "$f" "$tmp/k0.s")
+    printf '%s\n' "$body" | grep -Eq 'tzcnt|lzcnt|rep[; ]*bsf' && bad "$f: BMI/LZCNT instruction on the baseline"
+    printf '%s\n' "$body" | grep -q '\bcall' && bad "$f: call on the baseline"
