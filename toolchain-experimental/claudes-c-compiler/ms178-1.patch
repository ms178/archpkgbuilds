diff --git a/tests/regression/aggregate_pair_roundtrip_safety.c b/tests/regression/aggregate_pair_roundtrip_safety.c
new file mode 100644
index 0000000..3d00096
--- /dev/null
+++ b/tests/regression/aggregate_pair_roundtrip_safety.c
@@ -0,0 +1,61 @@
+/* Scalar carriers may share users, sign-extend, or copy overlapping objects.
+ * None of those contracts may be replaced with an unproven 128-bit copy.
+ * No libc dependency: the same fixture can run freestanding on every target. */
+typedef unsigned long long u64;
+typedef unsigned __int128 u128;
+
+__attribute__((noinline)) static u64 copy_shared(u64 *dst, const u64 *src)
+{
+    u64 low = src[0];
+    u128 bits = ((u128)src[1] << 64) | (u128)low;
+    dst[0] = (u64)bits;
+    dst[1] = (u64)(bits >> 64);
+    return low ^ (u64)(bits >> 64);
+}
+
+__attribute__((noinline)) static void copy_signed_low(u64 *dst, const u64 *src)
+{
+    u128 bits = ((u128)src[1] << 64) | (u128)(long long)src[0];
+    dst[0] = (u64)bits;
+    dst[1] = (u64)(bits >> 64);
+}
+
+__attribute__((noinline)) static u64 observe_first_store(u64 *dst, const u64 *src,
+                                                       const volatile u64 *observer)
+{
+    u128 bits = ((u128)src[1] << 64) | (u128)src[0];
+    dst[0] = (u64)bits;
+    u64 seen = *observer;
+    dst[1] = (u64)(bits >> 64);
+    return seen;
+}
+
+static volatile u64 inputs[] = {
+    0, 1, 0x7fffffffffffffffULL, 0x8000000000000000ULL,
+    0xffffffffffffffffULL, 0x0123456789abcdefULL
+};
+
+int main(void)
+{
+    for (unsigned i = 0; i < sizeof(inputs) / sizeof(inputs[0]); ++i) {
+        u64 low = inputs[i], high = inputs[(i + 1) % 6];
+        u64 src[2] = {low, high}, dst[2] = {7, 9};
+        if (copy_shared(dst, src) != (low ^ high)
+            || dst[0] != low || dst[1] != high)
+            return 1;
+        copy_signed_low(dst, src);
+        if (dst[0] != low || dst[1] != (low >> 63 ? ~0ULL : high))
+            return 2;
+        if (observe_first_store(dst, src, dst) != low
+            || dst[0] != low || dst[1] != high)
+            return 3;
+        u64 overlap[4] = {low, high, 17, 19};
+        if (copy_shared(overlap + 1, overlap) != (low ^ high)
+            || overlap[1] != low || overlap[2] != high)
+            return 4;
+        if (copy_shared(overlap, overlap + 1) != (low ^ high)
+            || overlap[0] != low || overlap[1] != high)
+            return 5;
+    }
+    return 0;
+}
diff --git a/tests/regression/alignof_expression_extension.c b/tests/regression/alignof_expression_extension.c
new file mode 100644
index 0000000..a9a149c
--- /dev/null
+++ b/tests/regression/alignof_expression_extension.c
@@ -0,0 +1,15 @@
+/* GCC accepts the expression form of _Alignof and __alignof__ without
+ * parentheses as an extension. Both forms must report the operand's type
+ * alignment, not parse as a malformed type-name. */
+#include <assert.h>
+
+int word;
+double real;
+
+int main(void) {
+    assert(_Alignof(word) == _Alignof(int));
+    assert(_Alignof (word) == _Alignof(int));
+    assert(__alignof__ real == __alignof__(double));
+    assert(__alignof__(real) == __alignof__(double));
+    return 0;
+}
diff --git a/tests/regression/builtin_math_surface.c b/tests/regression/builtin_math_surface.c
new file mode 100644
index 0000000..0ca859b
--- /dev/null
+++ b/tests/regression/builtin_math_surface.c
@@ -0,0 +1,25 @@
+/* GCC 16 advertises these libm and libgcc functions as builtins. Their calls
+ * must retain the floating result type: treating the return value as int reads
+ * the wrong register class and silently miscompiles valid code. */
+#include <assert.h>
+#include <math.h>
+
+int main(void) {
+    assert(fabs(__builtin_acos(0.5) - acos(0.5)) < 1e-12);
+    assert(fabs(__builtin_cbrt(27.0) - 3.0) < 1e-12);
+    assert(fabs(__builtin_pow(2.0, 10.0) - 1024.0) < 1e-12);
+    assert(fabs(__builtin_powi(2.0, 10) - 1024.0) < 1e-12);
+    assert(fabsf(__builtin_fmaxf(1.5f, 2.5f) - 2.5f) < 1e-6f);
+    assert(__builtin_isinf(__builtin_inff32x()));
+    assert(__builtin_isinf(__builtin_huge_valf64x()));
+    /* GCC's _Float32x/_Float64x result formats are binary64/extended; lccc
+     * maps those types to double/long double, preserving ABI size (not their
+     * distinct _Generic identity). */
+    assert(sizeof(__builtin_inff32x()) == sizeof(double));
+    assert(sizeof(__builtin_inff64x()) == sizeof(long double));
+    assert(__builtin_isnan(__builtin_nanf32x("")));
+    assert(__builtin_isnan(__builtin_nanf64x("")));
+    assert(__builtin_toupper('a') == 'A');
+    assert(__builtin_imaxabs(-7) == 7);
+    return 0;
+}
diff --git a/tests/regression/c23_attribute_positions.c b/tests/regression/c23_attribute_positions.c
new file mode 100644
index 0000000..9260d99
--- /dev/null
+++ b/tests/regression/c23_attribute_positions.c
@@ -0,0 +1,84 @@
+/* C23 6.7.1 attribute-specifier-sequence placement, every position that the
+ * grammar allows and that real C23 code uses.
+ *
+ * Before this test the parser accepted `[[...]]` only *before* a declaration;
+ * an attribute after the declarator-id (`int x [[maybe_unused]] = 0;`), on a
+ * parameter (`int g(int a [[maybe_unused]])`) or on a struct member
+ * (`int b [[maybe_unused]];`) was a hard parse error ("expected expression
+ * before '['"), because the declarator suffix loop consumed the first `[` of
+ * `[[` as the start of an array subscript and then demanded an expression.
+ *
+ * The runtime asserts below are what turns "it parses" into "it parses and the
+ * program still means what it says": the block-scope attribute must not swallow
+ * the initializer, the parameter attribute must not become part of the type,
+ * and an array suffix after the attribute must still bind to the declarator.
+ */
+#include <assert.h>
+#include <stddef.h>
+
+/* 1. attribute on a file-scope object, after the declarator-id */
+int file_scope [[maybe_unused]] = 7;
+
+/* 2. attribute before the specifiers (already supported; must keep working) */
+[[maybe_unused]] static int leading = 11;
+
+/* 3. attribute between the `*` and the object; the type must stay `int *` */
+int *ptr_target [[gnu::unused]] = &file_scope;
+
+/* 4. attribute on a function declaration, after the parameter list */
+int declared(int) [[gnu::warn_unused_result]];
+
+/* 5. attributes on parameters, before and after the identifier */
+static int with_params(int a [[maybe_unused]], int b [[maybe_unused]]) {
+    return b;
+}
+
+/* 6. attribute followed by an array suffix: `a` is `int[3]`, not a subscript */
+static int arr [[maybe_unused]][3] = {1, 2, 3};
+
+/* 7. attribute on a struct member */
+struct member_attrs {
+    [[maybe_unused]] int first;
+    int second [[maybe_unused]];
+};
+
+/* 8. C23 standard attributes in statement position */
+static int switch_with_fallthrough(int v) {
+    int acc = 0;
+    switch (v) {
+    case 1:
+        acc += 1;
+        [[fallthrough]];
+    case 2:
+        acc += 2;
+        break;
+    default:
+        acc = -1;
+        break;
+    }
+    return acc;
+}
+
+int declared(int x) { return x * 2; }
+
+int main(void) {
+    /* block-scope object with a trailing attribute and an initializer */
+    int local [[maybe_unused]] = 5;
+    assert(file_scope == 7);
+    assert(leading == 11);
+    assert(*ptr_target == 7);
+    assert(declared(4) == 8);
+    assert(with_params(1, 9) == 9);
+    assert(arr[0] == 1 && arr[2] == 3);
+    assert(sizeof arr == 3 * sizeof(int));
+
+    struct member_attrs m = {.first = 1, .second = 2};
+    assert(m.first == 1 && m.second == 2);
+    assert(offsetof(struct member_attrs, second) == sizeof(int));
+
+    assert(switch_with_fallthrough(1) == 3);
+    assert(switch_with_fallthrough(2) == 2);
+    assert(switch_with_fallthrough(3) == -1);
+    assert(local == 5);
+    return 0;
+}
