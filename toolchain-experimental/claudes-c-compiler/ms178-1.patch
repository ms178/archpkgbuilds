+            (I128, I64, true, false),
+            // Into or across wide types, or out to a float: not a GPR result.
+            (I64, I128, false, false),
+            (I128, U128, false, false),
+            (I128, F64, false, false),
+            (I32, I64, false, true),
+        ] {
+            assert_eq!(
+                cast_result_is_gpr(from, to, is_32bit),
+                gpr,
+                "{from:?} -> {to:?} 32bit={is_32bit}"
+            );
+        }
+    }
