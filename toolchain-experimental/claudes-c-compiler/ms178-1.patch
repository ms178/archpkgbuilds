+        };
+        let mut index = None;
+        if let Some(idx) = fields.next() {
+            let idx = idx.trim();
+            if !idx.starts_with('%') {
+                return None;
+            }
+            let scale = match fields.next() {
+                Some(s) => match s.trim() {
+                    "1" => 1,
+                    "2" => 2,
+                    "4" => 4,
+                    "8" => 8,
+                    _ => return None,
+                },
+                // A register in the second slot with no explicit scale is
+                // scale 1 (`(%rax,%rbx)`).
+                None => 1,
+            };
