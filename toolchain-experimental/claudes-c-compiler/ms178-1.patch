+    let sign = if imm8 & 0x80 != 0 { -1.0 } else { 1.0 };
+    let eraw = ((imm8 >> 4) & 0x7) as i32;
+    let frac = (imm8 & 0xF) as f64 / 16.0;
+    let e = if eraw <= 3 { eraw + 1 } else { eraw - 7 };
+    sign * 2f64.powi(e) * (1.0 + frac)
