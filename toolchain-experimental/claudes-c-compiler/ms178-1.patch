+                // `x * c` (either operand order): scale the whole term.
+                // A negative or zero scale cannot keep `mult` positive —
+                // the product becomes the opaque leaf.
+                Instruction::BinOp {
+                    op: IrBinOp::Mul,
+                    lhs,
+                    rhs,
+                    ..
