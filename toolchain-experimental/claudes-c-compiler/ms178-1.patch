+                    insn = re.sub(r"^\s+[0-9a-f]+:\s*", "", ln)
+                    insn = re.sub(r"0x[0-9a-f]+|\b[0-9a-f]{4,}\b|<[^>]*>|#.*", "X", insn)
+                    lines.append(f"{fn}: {' '.join(insn.split())}")
