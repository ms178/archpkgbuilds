+            // below exercises exactly that.
+            Instruction::Cast {
+                dest: Value(1),
+                src: Operand::Const(IrConst::I32(3)),
+                from_ty: IrType::I32,
+                to_ty: IrType::I64,
+            },
+            Instruction::BinOp {
