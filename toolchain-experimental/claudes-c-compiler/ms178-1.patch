index 00000000..826f8a3d
--- /dev/null
+++ b/tests/regression/fnptr_result_shadows_void_function.c
@@ -0,0 +1,22 @@
+/* Linux timer_migration.c: bool callback `up` shadows void semaphore up(). */
+struct lock;
+extern void up(struct lock *semaphore);
+typedef _Bool (*up_f)(int *, int *, int *);
+static int calls;
+static _Bool less(int *a, int *b, int *data) {
+    ++calls; *data += *a < *b; return *a < *b;
+}
+static int visit(up_f up, int *a, int *b, int *data) {
+    int result = 0;
+    if (up(a, b, data)) result |= 1;
+    { up_f down = less; if (down(b, a, data)) result |= 2; }
+    if (up(b, a, data)) result |= 4;
+    return result;
+}
+static int result;
+void up(struct lock *semaphore) { (void)semaphore; result = 42; }
+int main(void) {
+    int a = 1, b = 2, data = 0;
+    if (visit(less, &a, &b, &data) != 1 || data != 1 || calls != 3) return 1;
+    up((struct lock *)0); return result != 42;
+}
