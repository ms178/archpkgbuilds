+/// Inspect final ELF program headers for a writable, executable PT_LOAD.
+/// Both ELF classes produced by LCCC are little-endian. Diagnostic only:
+/// segment flags and output bytes are never changed. Truncation fails closed.
+pub fn elf_has_rwx_load(elf: &[u8]) -> Result<bool, String> {
+    let invalid = || "invalid ELF output while checking RWX segments".to_string();
+    if elf.len() < 64 || elf.get(..4) != Some(b"\x7fELF") || elf[4] == 0 || elf[5] != 1 {
+        return Err(invalid());
+    }
+    let wide = match elf[4] {
+        1 => false,
+        2 => true,
+        _ => return Err(invalid()),
+    };
+    let u16_at = |off: usize| -> Result<usize, String> {
+        Ok(u16::from_le_bytes(elf[off..off + 2].try_into().map_err(|_| invalid())?) as usize)
+    };
+    let u32_at = |off: usize| -> Result<u32, String> {
+        Ok(u32::from_le_bytes(
+            elf[off..off + 4].try_into().map_err(|_| invalid())?,
+        ))
+    };
+    let offset = |off: usize| -> Result<usize, String> {
+        if wide {
+            u64::from_le_bytes(elf[off..off + 8].try_into().map_err(|_| invalid())?)
+                .try_into()
+                .map_err(|_| invalid())
+        } else {
+            Ok(u32_at(off)? as usize)
+        }
+    };
+    let phoff = offset(if wide { 32 } else { 28 })?;
+    let phentsize = u16_at(if wide { 54 } else { 42 })?;
+    let mut phnum = u16_at(if wide { 56 } else { 44 })?;
+    if phentsize != 0 && phnum == 0xffff {
+        let shoff = offset(if wide { 40 } else { 32 })?;
+        let shentsize = u16_at(if wide { 58 } else { 46 })?;
+        if shoff == 0 || shentsize < if wide { 64 } else { 44 } {
+            return Err(invalid());
+        }
+        let info = shoff
+            .checked_add(if wide { 44 } else { 28 })
+            .ok_or_else(invalid)?;
+        phnum = u32_at(info)? as usize;
+    }
+    if phnum == 0 {
+        return Ok(false);
+    }
+    if phentsize < if wide { 56 } else { 32 } {
+        return Err(invalid());
+    }
+    let size = phnum.checked_mul(phentsize).ok_or_else(invalid)?;
+    let end = phoff.checked_add(size).ok_or_else(invalid)?;
+    if end > elf.len() {
+        return Err(invalid());
+    }
+    for index in 0..phnum {
+        let header = phoff + index * phentsize;
+        if u32_at(header)? == 1 && u32_at(header + if wide { 4 } else { 24 })? & 3 == 3 {
+            return Ok(true);
+        }
+    }
+    Ok(false)
+}
+
+/// GNU ld's default RWX warning, checked BEFORE flat-binary conversion.
+/// Like bfd, a fatal diagnostic retains the completed output; callers must
+/// not use that file after a failed link.
+pub fn check_rwx_segments(path: &str, warn: bool, fatal: bool) -> Result<(), String> {
+    if !warn {
+        return Ok(());
+    }
+    let elf = std::fs::read(path).map_err(|e| format!("failed to read '{path}': {e}"))?;
+    if elf_has_rwx_load(&elf)? {
+        eprintln!("lccc-ld: warning: {path} has a LOAD segment with RWX permissions");
+        if fatal {
+            return Err("warning treated as error: LOAD segment with RWX permissions".into());
+        }
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod rwx_tests {
+    use super::elf_has_rwx_load;
+    fn image(wide: bool, flags: u32) -> Vec<u8> {
+        let mut elf = vec![0u8; if wide { 120 } else { 84 }];
+        elf[..4].copy_from_slice(b"\x7fELF");
+        elf[4] = if wide { 2 } else { 1 };
+        elf[5] = 1;
+        let phoff = if wide { 64 } else { 52 };
+        if wide {
+            elf[32..40].copy_from_slice(&64u64.to_le_bytes());
+            elf[54..56].copy_from_slice(&56u16.to_le_bytes());
+        } else {
+            elf[28..32].copy_from_slice(&52u32.to_le_bytes());
+            elf[42..44].copy_from_slice(&32u16.to_le_bytes());
+        }
+        let phnum = if wide { 56 } else { 44 };
+        elf[phnum..phnum + 2].copy_from_slice(&1u16.to_le_bytes());
+        elf[phoff..phoff + 4].copy_from_slice(&1u32.to_le_bytes());
+        let pflags = phoff + if wide { 4 } else { 24 };
+        elf[pflags..pflags + 4].copy_from_slice(&flags.to_le_bytes());
+        elf
+    }
+    #[test]
+    fn classes_and_permissions() {
+        for wide in [false, true] {
+            for flags in 0..8 {
+                assert_eq!(
+                    elf_has_rwx_load(&image(wide, flags)).unwrap(),
+                    flags & 3 == 3
+                );
+            }
+        }
+    }
+    #[test]
+    fn truncation_fails_closed() {
+        for wide in [false, true] {
+            let elf = image(wide, 7);
+            for len in [0, 4, 51, elf.len() - 1] {
+                assert!(elf_has_rwx_load(&elf[..len]).is_err());
+            }
+        }
+    }
+    #[test]
+    fn extended_phnum() {
+        let mut elf = image(true, 7);
+        elf[40..48].copy_from_slice(&120u64.to_le_bytes());
+        elf[56..58].copy_from_slice(&0xffffu16.to_le_bytes());
+        elf[58..60].copy_from_slice(&64u16.to_le_bytes());
+        elf.resize(184, 0);
+        elf[164..168].copy_from_slice(&1u32.to_le_bytes());
+        assert!(elf_has_rwx_load(&elf).unwrap());
+        elf[164..168].fill(0);
+        assert!(!elf_has_rwx_load(&elf).unwrap());
+    }
+}
