diff --git a/tests/regression/large_stack_frame_codegen.c b/tests/regression/large_stack_frame_codegen.c
new file mode 100644
index 0000000..48ce629
--- /dev/null
+++ b/tests/regression/large_stack_frame_codegen.c
@@ -0,0 +1,18 @@
+/* A large legal automatic object makes the x86-64 frame adjustment exceed
+   the sign-extended imm32 range. Keep the function externally visible so
+   -O2 must emit its prologue, but never call it at runtime. */
+#define LARGE_FRAME_SIZE 0x10000000000UL
+
+__attribute__((noinline)) int
+large_frame_codegen(void)
+{
+    volatile unsigned char frame[LARGE_FRAME_SIZE];
+    frame[0] = 0x2a;
+    return frame[0];
+}
+
+int
+main(void)
+{
+    return 0;
+}
diff --git a/tests/regression/vector_sdiv_srem_short_signext.c b/tests/regression/vector_sdiv_srem_short_signext.c
new file mode 100644
index 0000000..30a13a8
--- /dev/null
+++ b/tests/regression/vector_sdiv_srem_short_signext.c
@@ -0,0 +1,29 @@
+/* Keep narrow signed-vector lanes canonical when x86 scalarizes div/rem.
+   A signed i16 home produced with movswl has the right low 32 bits but a zero
+   upper half; feeding it straight to idivq turns -1 / -8 into 1 remainder 7. */
+typedef short v8hi __attribute__((vector_size(16)));
+
+__attribute__((noinline)) static v8hi
+sdiv_neg8(v8hi x)
+{
+    return x / (v8hi){-8, -8, -8, -8, -8, -8, -8, -8};
+}
+
+__attribute__((noinline)) static v8hi
+srem_neg8(v8hi x)
+{
+    return x % (v8hi){-8, -8, -8, -8, -8, -8, -8, -8};
+}
+
+int
+main(void)
+{
+    v8hi x = {-1, -7, -8, -9, 1, 7, 8, 9};
+    v8hi q = sdiv_neg8(x);
+    v8hi r = srem_neg8(x);
+    for (int i = 0; i < 8; ++i) {
+        if (q[i] != x[i] / -8 || r[i] != x[i] % -8)
+            return 1;
+    }
+    return 0;
+}
