From 67e4d50d2b21a5aba0519e8b8891d0c13c6e7419 Mon Sep 17 00:00:00 2001
From: lccc-agent <agent@arena.invalid>
Date: Wed, 21 Oct 2026 20:30:49 +0000
Subject: [PATCH 09/38] tests: lccc-ld legs must prove gcc selects the lccc-ld
 shim

check_tls_dynamic_witness and check_cfi_unwind link their lccc-ld legs
with `gcc -B$shim`, where `$shim/ld` links to `$bin/lccc-ld`. When
lccc-ld is not built, the symlink dangles and gcc falls back to the
system ld without a word. Every lccc-ld leg then became a second GNU ld
leg and PASSED; the only visible symptom was the LE-vs-DSO leg failing
on bfd's wording.

The legs now run only when `gcc -B$shim -print-prog-name=ld` resolves
to the shim. Otherwise they SKIP and say why. Verified both ways: all
legs pass with lccc-ld built (x86-64, i686, and AArch64/RISC-V under
qemu); with it hidden, the six witness legs and the two CFI legs report
SKIP instead of a false PASS.
---
 tests/regression/check_cfi_unwind.sh          | 7 +++++++
 tests/regression/check_tls_dynamic_witness.sh | 8 ++++++++
 2 files changed, 15 insertions(+)

diff --git a/tests/regression/check_cfi_unwind.sh b/tests/regression/check_cfi_unwind.sh
index c78f910cd..431e45dd1 100755
--- a/tests/regression/check_cfi_unwind.sh
+++ b/tests/regression/check_cfi_unwind.sh
@@ -27,6 +27,9 @@ n=0
 # leg LABEL CC "LINK-DRIVER" "LINK-FLAGS" [RUNNER...]
 leg() {
     local label=$1 cc=$2 drv=$3 lflags=$4; shift 4
+    case " $lflags " in
+    *" -B$shim "*) shim_live || { echo "SKIP [$label: lccc-ld not built]"; return; } ;;
+    esac
     local o
     for o in 0 2; do
         local d=$work/$((n += 1))
@@ -69,6 +72,10 @@ run() {
 shim=$work/shim
 mkdir -p "$shim"
 ln -s "$bin/lccc-ld" "$shim/ld"
+# gcc falls back to the system ld without a word when `-B` finds no usable
+# `ld`, so a missing lccc-ld would turn every lccc-ld leg into a second,
+# passing GNU ld leg. Those legs run only when gcc provably resolves the shim.
+shim_live() { [ "$(gcc -B"$shim" -print-prog-name=ld 2>/dev/null)" = "$shim/ld" ]; }
 leg "x86-64 bfd" "$CCC" gcc ""
 leg "x86-64 lccc-ld" "$CCC" gcc "-B$shim"
 for l in mold lld; do
