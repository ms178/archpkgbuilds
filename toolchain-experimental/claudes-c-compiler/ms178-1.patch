+# x86-64 GAS prefix words: addr32/data16/rex/rex.x as standalone spellings.
+# GAS 2.47.20260726-probed (`as --64`). addr32 COALESCES with the body's
+# address-size override (67 89 00 for `addr32 mov %eax,(%eax)`), redirects
+# accumulator-absolute movs to the 32-bit moffs rows, and rejects 64-bit-only
+# bases; rex/rex.x OR-merge with the body's REX byte. addr16/data32 and the
+# .y/.xy/.z rex spellings do not exist in 64-bit mode.
+;;; addr32_forms
+.text
+addr32 nop
+addr32 mov %eax, %ebx
+addr32 mov $0x89abcdef, %eax
+addr32 mov %eax, (%eax)
+addr32 mov (%eax), %eax
+addr32 mov %rax, (%ebx)
