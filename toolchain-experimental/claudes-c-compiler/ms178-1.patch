From 131fad26345d00ede12a9defc804e4498c36f38a Mon Sep 17 00:00:00 2001
From: Arena Agent <agent@arena.ai>
Date: Tue, 18 Aug 2026 11:46:43 +0000
Subject: [PATCH 02/11] i686 windowed DSE: register fate must not protect a
 shadowed store
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

eliminate_dead_stores broke its look-ahead as soon as the STORED
register was redefined — a forwarding-style break wrongly applied to a
deadness proof. Whether %eax changes after 'movl %eax, 8(%esp)' cannot
make the slot's old bytes observable; only a read of the slot can. The
spill/ALU/respill shape (movl %eax,S; andl $31,%eax; movl %eax,S)
accounts for ~104 shadowed stores in the kernel setup corpus that the
break hid from the pass. The x86-64 twin already had no such break.

Realmode boot corpus: 34389 -> 33875 bytes. x86-64 -O2 corpus: 25027
vs gcc 25796 (improved from 25364; the shared IR path feeds both).
838/838 unit, 50/50 correctness, regparm conformance all levels,
9/9 check scripts, nbody -O0 exact.
---
 src/backend/i686/codegen/peephole.rs | 45 +++++++++++++++++++++++-----
 1 file changed, 37 insertions(+), 8 deletions(-)

diff --git a/src/backend/i686/codegen/peephole.rs b/src/backend/i686/codegen/peephole.rs
index b1fce63..f25a0c6 100644
--- a/src/backend/i686/codegen/peephole.rs
+++ b/src/backend/i686/codegen/peephole.rs
@@ -1674,7 +1674,7 @@ fn eliminate_dead_stores(store: &LineStore, infos: &mut [LineInfo]) -> bool {
 
     for i in 0..len {
         if infos[i].is_nop() { continue; }
-        if let LineKind::StoreEbp { offset: store_off, size: store_size, reg: store_reg } = infos[i].kind {
+        if let LineKind::StoreEbp { offset: store_off, size: store_size, .. } = infos[i].kind {
             // Look ahead for another store to the same slot (meaning this one is dead)
             // or a load from the same slot (meaning this one is alive)
             let mut j = i + 1;
@@ -1709,13 +1709,14 @@ fn eliminate_dead_stores(store: &LineStore, infos: &mut [LineInfo]) -> bool {
 
                 // Stop at barriers
                 if infos[j].is_barrier() { break; }
-                // Stop if the stored register is modified (value may have changed)
-                match infos[j].kind {
-                    LineKind::Other { dest_reg } if dest_reg == store_reg => break,
-                    LineKind::Move { dst, .. } if dst == store_reg => break,
-                    LineKind::SetCC { reg } if reg == store_reg => break,
-                    _ => {}
-                }
+                // NOTE: the stored REGISTER being modified is irrelevant
+                // here. This pass proves the MEMORY slot is overwritten
+                // before any read — deadness of the store — and the fate of
+                // the source register cannot change that. (A register-fate
+                // break belongs to store-FORWARDING, which reuses the value;
+                // forward_slot_loads has one.) The old break here hid ~40%
+                // of the same-block dead stores in the kernel setup corpus
+                // (spill, ALU on the register, respill to the same slot).
                 // Stop at indirect memory access (could read the slot)
                 let s = trimmed(store, &infos[j], j);
                 if infos[j].has_indirect_mem { break; }
@@ -3562,6 +3563,34 @@ fn optimize_tail_calls_i686(store: &mut LineStore, infos: &mut [LineInfo]) -> bo
 mod tests {
     use super::*;
 
+    #[test]
+    fn windowed_dse_kills_shadowed_store_across_source_reg_update() {
+        // `movl %eax, 8(%esp)` is dead: the slot is overwritten before any
+        // read. The intervening ALU on %eax must NOT protect the store
+        // (register fate is irrelevant to memory deadness).
+        // The call keeps the second store un-forwardable and the trailing
