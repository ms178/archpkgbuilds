+def symtab_problems(path):
+    """Inspect .symtab: presence, entry count, sh_info correctness, zero-size ghosts."""
+    out = {"present": False, "nsyms": 0, "zero_size": 0, "sh_info_bad": None}
+    try:
+        with open(path, "rb") as fh:
+            d = fh.read()
