+pub(crate) fn const_as_f64(c: IrConst) -> Option<f64> {
+    match c {
+        IrConst::F32(v) => Some(v as f64),
+        IrConst::F64(v) => Some(v),
+        IrConst::LongDouble(v, _) => Some(v),
+        _ => None,
