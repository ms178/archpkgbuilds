+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::ir::reexports::BlockId;
+
+    fn block(
+        label: u32,
+        insts: Vec<Instruction>,
+        term: Terminator,
+    ) -> crate::ir::reexports::BasicBlock {
+        crate::ir::reexports::BasicBlock {
+            label: BlockId(label),
+            instructions: insts,
+            terminator: term,
+            source_spans: Vec::new(),
+        }
+    }
+
+    fn mk_module(fns: Vec<IrFunction>, globals: Vec<IrGlobal>) -> IrModule {
+        let mut m = IrModule::new();
+        m.functions = fns;
+        m.globals = globals;
+        m
+    }
+
+    /// The repository SSA/CFG validator over the transformed module: the
+    /// promoted caller must stay well-formed (GlobalAddr dominance, no
+    /// dangling uses of the deleted alloca).
+    fn assert_verified(m: &IrModule, stage: &str) {
+        crate::passes::verify::verify_after_pass(m, stage);
+    }
+
+    /// A caller whose 16-byte array is fully initialized by constants and
+    /// read by a static load-only callee: must promote.
+    #[test]
+    fn static_load_only_callee_promotes() {
+        let mut reader = IrFunction::new("reader".to_string(), IrType::I32, vec![], false);
+        reader.is_static = true;
+        reader.blocks = vec![block(
+            0,
+            vec![
+                Instruction::ParamRef {
+                    dest: Value(1),
+                    param_idx: 0,
+                    ty: IrType::Ptr,
+                },
+                Instruction::Load {
+                    dest: Value(2),
+                    ptr: Value(1),
+                    ty: IrType::I32,
+                    volatile: false,
+                    seg_override: crate::common::types::AddressSpace::Default,
+                },
+            ],
+            Terminator::Return(Some(Operand::Value(Value(2)))),
+        )];
+        reader.next_value_id = 3;
+
+        let mut caller = IrFunction::new("caller".to_string(), IrType::I32, vec![], false);
+        caller.blocks = vec![block(
+            0,
+            vec![
+                Instruction::Alloca {
+                    dest: Value(1),
+                    size: 16,
+                    align: 1,
+                    ty: IrType::U8,
+                    volatile: false,
+                    semantic_volatile: false,
+                },
+                Instruction::GetElementPtr {
+                    dest: Value(2),
+                    base: Value(1),
+                    offset: Operand::Const(IrConst::I64(0)),
+                    ty: IrType::U8,
+                },
+                Instruction::Store {
+                    val: Operand::Const(IrConst::I32(0x04030201)),
+                    ptr: Value(2),
+                    ty: IrType::I32,
+                    volatile: false,
+                    seg_override: crate::common::types::AddressSpace::Default,
+                },
+            ],
+            Terminator::Return(Some(Operand::Const(IrConst::I32(0)))),
+        )];
+        // (Single-store partial init on purpose: the tiling gate rejects
+        // it; the positive-control full tiling lives in the next test.)
+        caller.next_value_id = 3;
+        let mut m = mk_module(vec![caller, reader], vec![]);
+        let n = run(&mut m);
+        assert_eq!(n, 0, "partial tiling must not promote");
+    }
