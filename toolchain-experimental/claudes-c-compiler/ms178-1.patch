+        let folded = format!("    xorl {}, {}", reg_id_to_name(breg, MoveSize::L), reg_id_to_name(areg, MoveSize::L));
+        replace_line(store, &mut infos[j], j, folded);
+        mark_nop(&mut infos[k]);
+        mark_nop(&mut infos[m]);
+        changed = true;
+        i = m + 1;
+    }
+    changed
+}
