+        CType::Float | CType::Decimal32 => (vec![Sse], 32),
+        CType::Double | CType::Decimal64 => (vec![Sse], 64),
+        CType::LongDouble => (vec![X87, X87Up], 128),
+        CType::Float128 | CType::Decimal128 => (vec![Sse, SseUp], 128),
