+int main(void) {
+    static const uint64_t edge[] = {
+        0, 1, 2, 3, 7, 10, 255, 256, 65535, 65536,
+        0x7FFFFFFFull, 0x80000000ull, 0xFFFFFFFFull, 0x100000000ull,
+        0x100000001ull, 0x1FFFFFFFFull, 0x7FFFFFFFFFFFFFFFull,
