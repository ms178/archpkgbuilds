+    let high = value.wrapping_add(0x800) & !0xFFF;
+    if high == 0 {
+        return Some(((insn & !MATCH_C_LUI) | MATCH_C_LI) & !CI_IMM_MASK);
+    }
+    let imm = high >> 12;
+    if !(-32..32).contains(&imm) {
