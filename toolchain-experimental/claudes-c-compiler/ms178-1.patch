+    fn test_twin_with_other_uses_is_not_canonicalised() {
+        let mut func = IrFunction::new("twin_live".to_string(), IrType::I32, vec![], false);
+        func.blocks.push(BasicBlock {
+            label: BlockId(0),
+            instructions: vec![
