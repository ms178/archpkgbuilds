+//! CFG-aware scalar liveness and interference construction.
+//!
+//! The backend's textual interval approximations lose CFG detail at joins and
+//! loop edges. This module supplies one conservative, reusable copy-aware
+//! interference proof for stack-location coalescing after phi lowering.
+//!
+//! The analysis is deliberately value-ID based because phi elimination has
+//! already happened at backend time. Multiple definitions of one value ID are
+//! treated as one storage identity, matching stack-slot assignment semantics.
+
+use crate::backend::liveness::{
+    for_each_operand_in_instruction,
+    for_each_operand_in_terminator,
+    for_each_value_use_in_instruction,
+};
+use crate::common::fx_hash::{FxHashMap, FxHashSet};
+use crate::ir::reexports::{Instruction, IrFunction, Operand, Terminator};
+
+/// Enumerate all uses of an instruction as stable, de-duplicated value IDs.
+///
+/// The canonical operand visitors cover both `Operand::Value` inputs and direct
+/// pointer/base uses.  De-duplication matters for instructions such as `x + x`:
+/// liveness is a set, not a multiplicity count.
+fn instruction_value_uses(inst: &Instruction) -> Vec<u32> {
+    let mut uses = Vec::new();
+    for_each_operand_in_instruction(inst, |op| {
+        if let Operand::Value(v) = op {
+            uses.push(v.0);
+        }
+    });
+    for_each_value_use_in_instruction(inst, |v| uses.push(v.0));
+    uses.sort_unstable();
+    uses.dedup();
+    uses
+}
+
+/// Enumerate all terminator uses as stable, de-duplicated value IDs.
+fn terminator_value_uses(term: &Terminator) -> Vec<u32> {
+    let mut uses = Vec::new();
+    for_each_operand_in_terminator(term, |op| {
+        if let Operand::Value(v) = op {
+            uses.push(v.0);
+        }
+    });
+    uses.sort_unstable();
+    uses.dedup();
+    uses
+}
+
+#[inline]
+fn insert_interference(graph: &mut FxHashMap<u32, FxHashSet<u32>>, lhs: u32, rhs: u32) {
+    if lhs == rhs {
+        return;
+    }
+    graph.entry(lhs).or_default().insert(rhs);
+    graph.entry(rhs).or_default().insert(lhs);
+}
+
+/// Add constraints for a phi-lowered *parallel copy bundle*.
+///
+/// Phi elimination emits the copies belonging to one incoming edge as adjacent
+/// `Copy` instructions.  They execute sequentially in the current backend,
+/// even though their SSA meaning is simultaneous.  Standard move coalescing
+/// may omit each individual `(dest, source)` edge, but it must never create a
+/// new physical-register cycle across different copies, for example:
+///
+/// ```text
+/// a = copy x;  b = copy y;
+/// ```
+///
+/// If `a` shares `y`'s register and `b` shares `x`'s register, the first move
+/// overwrites the source of the second.  The phi eliminator only sees value-ID
+/// cycles, not cycles introduced later by register colours.  We therefore add
+/// cross-copy edges inside every adjacent run whose destinations have multiple
+/// definitions (the post-phi-lowering signature).  Each copy's own source is
+/// intentionally left unconnected, preserving safe single-move coalescing.
+fn add_parallel_copy_bundle_interference(
+    func: &IrFunction,
+    tracked: &FxHashSet<u32>,
+    graph: &mut FxHashMap<u32, FxHashSet<u32>>,
+) {
+    let mut def_count: FxHashMap<u32, u32> = FxHashMap::default();
+    for block in &func.blocks {
+        for inst in &block.instructions {
+            if let Some(dest) = inst.dest() {
+                *def_count.entry(dest.0).or_insert(0) += 1;
+            }
+        }
+    }
+
+    for block in &func.blocks {
+        let mut index = 0usize;
+        while index < block.instructions.len() {
+            let start = index;
+            let mut bundle: Vec<(u32, Option<u32>)> = Vec::new();
+            while let Some(Instruction::Copy { dest, src }) = block.instructions.get(index) {
+                // A multi-definition Copy destination identifies a lowered phi
+                // value.  Stop at unrelated copies so an ordinary assignment
+                // cannot accidentally become part of an edge bundle.
+                if def_count.get(&dest.0).copied().unwrap_or(0) < 2 {
+                    break;
+                }
+                let source = match src {
+                    Operand::Value(value) => Some(value.0),
+                    Operand::Const(_) => None,
+                };
+                bundle.push((dest.0, source));
+                index += 1;
+            }
+
+            if bundle.len() >= 2 {
+                for left in 0..bundle.len() {
+                    let (left_dest, left_source) = bundle[left];
+                    for &(right_dest, right_source) in &bundle[(left + 1)..] {
+                        // Two independently merged phi results must remain
+                        // distinct on this edge; their values may diverge on a
+                        // different predecessor even when their current sources
+                        // happen to match.
+                        if tracked.contains(&left_dest) && tracked.contains(&right_dest) {
+                            insert_interference(graph, left_dest, right_dest);
+                        }
+                        // Sources of the bundle are simultaneously needed until
+                        // their respective moves have completed.  Usually normal
+                        // liveness already adds this edge; repeating it here
+                        // makes the parallel-copy contract explicit and robust
+                        // in the presence of multi-definition value IDs.
+                        if let (Some(lhs), Some(rhs)) = (left_source, right_source) {
+                            if tracked.contains(&lhs) && tracked.contains(&rhs) {
+                                insert_interference(graph, lhs, rhs);
+                            }
+                        }
+                        // Most importantly, prevent either destination from
+                        // overwriting another copy's source before it is read.
+                        if let Some(source) = right_source {
+                            if tracked.contains(&left_dest) && tracked.contains(&source) {
+                                insert_interference(graph, left_dest, source);
+                            }
+                        }
+                        if let Some(source) = left_source {
+                            if tracked.contains(&right_dest) && tracked.contains(&source) {
+                                insert_interference(graph, right_dest, source);
+                            }
+                        }
+                    }
+                }
+            }
+
+            // At least one instruction must be consumed on every outer-loop
+            // iteration.  `index == start` means this was not a phi-copy run.
+            if index == start {
+                index += 1;
+            }
+        }
+    }
+}
+
+/// Build copy-aware interference for `tracked`.
+///
+/// Dataflow is the standard backwards formulation:
+///
+/// ```text
+/// live_out[B] = union(live_in[S] for S in succ(B))
+/// live_in[B]  = use[B] union (live_out[B] - def[B])
+/// ```
+///
+/// At a normal definition `d`, `d` interferes with every value live after the
+/// definition.  For `d = Copy(s)`, the `s` edge is intentionally omitted:
+/// sharing a physical register makes that copy a no-op, while every other live
+/// value still blocks the colour.  This is the classic move-coalescing rule.
+///
+/// Returning `None` on a non-convergent CFG is a legality bailout: callers must
+/// keep their prior conservative allocator rather than use a partial proof.
+pub(crate) fn build_copy_aware_interference(
+    func: &IrFunction,
+    tracked: &FxHashSet<u32>,
+) -> Option<FxHashMap<u32, FxHashSet<u32>>> {
+    if func.blocks.is_empty() {
+        return Some(FxHashMap::default());
+    }
+
+    use crate::ir::analysis;
+    let label_map = analysis::build_label_map(func);
+    let (_preds, successors) = analysis::build_cfg(func, &label_map);
+    let successors: Vec<Vec<usize>> = (0..func.blocks.len())
+        .map(|idx| successors.row(idx).iter().map(|&v| v as usize).collect())
+        .collect();
+
+    // Build block-local upward-exposed uses and definitions.
+    let mut block_use: Vec<FxHashSet<u32>> = vec![FxHashSet::default(); func.blocks.len()];
+    let mut block_def: Vec<FxHashSet<u32>> = vec![FxHashSet::default(); func.blocks.len()];
+    for (block_idx, block) in func.blocks.iter().enumerate() {
+        for inst in &block.instructions {
+            for value in instruction_value_uses(inst) {
+                if tracked.contains(&value) && !block_def[block_idx].contains(&value) {
+                    block_use[block_idx].insert(value);
+                }
+            }
+            if let Some(dest) = inst.dest() {
+                if tracked.contains(&dest.0) {
+                    block_def[block_idx].insert(dest.0);
+                }
+            }
+        }
+        for value in terminator_value_uses(&block.terminator) {
+            if tracked.contains(&value) && !block_def[block_idx].contains(&value) {
+                block_use[block_idx].insert(value);
+            }
+        }
+    }
+
+    let mut live_in: Vec<FxHashSet<u32>> = vec![FxHashSet::default(); func.blocks.len()];
+    let mut live_out: Vec<FxHashSet<u32>> = vec![FxHashSet::default(); func.blocks.len()];
+    let mut changed = true;
+    let mut iterations = 0usize;
+    const MAX_CFG_LIVENESS_ITERATIONS: usize = 256;
+    while changed && iterations < MAX_CFG_LIVENESS_ITERATIONS {
+        changed = false;
+        iterations += 1;
+        for block_idx in (0..func.blocks.len()).rev() {
+            let mut out = FxHashSet::default();
+            for &succ in &successors[block_idx] {
+                out.extend(live_in[succ].iter().copied());
+            }
+            let mut input = block_use[block_idx].clone();
+            for value in &out {
+                if !block_def[block_idx].contains(value) {
+                    input.insert(*value);
+                }
+            }
+            if out != live_out[block_idx] {
+                live_out[block_idx] = out;
+                changed = true;
+            }
+            if input != live_in[block_idx] {
+                live_in[block_idx] = input;
+                changed = true;
+            }
+        }
+    }
+    if changed {
+        return None;
+    }
+
+    let mut graph: FxHashMap<u32, FxHashSet<u32>> = FxHashMap::default();
+    for &value in tracked {
+        graph.entry(value).or_default();
+    }
+    for (block_idx, block) in func.blocks.iter().enumerate() {
+        // The terminator executes after all ordinary instructions, so its uses
+        // are live while walking the block backwards.
+        let mut live = live_out[block_idx].clone();
+        for value in terminator_value_uses(&block.terminator) {
+            if tracked.contains(&value) {
+                live.insert(value);
+            }
+        }
+
+        for inst in block.instructions.iter().rev() {
+            let copy_source = match inst {
+                Instruction::Copy { src: Operand::Value(source), .. } => Some(source.0),
+                _ => None,
+            };
+            if let Some(dest) = inst.dest() {
+                if tracked.contains(&dest.0) {
+                    for &other in &live {
+                        if copy_source != Some(other) {
+                            insert_interference(&mut graph, dest.0, other);
+                        }
+                    }
+                    live.remove(&dest.0);
+                }
+            }
+            for value in instruction_value_uses(inst) {
+                if tracked.contains(&value) {
+                    live.insert(value);
+                }
+            }
+        }
+    }
+
+    // The ordinary instruction sweep handles SSA-style dataflow; this final
+    // pass adds the extra simultaneous-move contract of lowered phi bundles.
+    add_parallel_copy_bundle_interference(func, tracked, &mut graph);
+
+    Some(graph)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::common::types::IrType;
+    use crate::ir::reexports::{BasicBlock, BlockId, IrBinOp, IrConst, Value};
+
+    fn block(label: u32, instructions: Vec<Instruction>, terminator: Terminator) -> BasicBlock {
+        BasicBlock {
+            label: BlockId(label),
+            instructions,
+            source_spans: Vec::new(),
+            terminator,
+        }
+    }
+
+    fn scalar_def(dest: u32, n: i32) -> Instruction {
+        Instruction::BinOp {
+            dest: Value(dest),
+            op: IrBinOp::Add,
+            lhs: Operand::Const(IrConst::I32(n)),
+            rhs: Operand::Const(IrConst::I32(0)),
+            ty: IrType::I32,
+        }
+    }
+
+    #[test]
+    fn graph_adds_edges_for_simultaneously_live_values() {
+        let mut func = IrFunction::new("overlap".to_string(), IrType::I32, vec![], false);
+        func.blocks.push(block(
+            0,
+            vec![
+                scalar_def(0, 1),
+                scalar_def(1, 2),
+                Instruction::BinOp {
+                    dest: Value(2),
+                    op: IrBinOp::Add,
+                    lhs: Operand::Value(Value(0)),
+                    rhs: Operand::Value(Value(1)),
+                    ty: IrType::I32,
+                },
+            ],
+            Terminator::Return(Some(Operand::Value(Value(2)))),
+        ));
+        let tracked = [0, 1, 2].into_iter().collect();
+        let result = build_copy_aware_interference(&func, &tracked).expect("converges");
+        assert!(result[&0].contains(&1));
+    }
+
+    #[test]
+    fn graph_keeps_mutually_exclusive_values_non_interfering() {
+        let mut func = IrFunction::new("diamond".to_string(), IrType::I32, vec![], false);
+        func.blocks = vec![
+            block(
+                0,
+                vec![],
+                Terminator::CondBranch {
+                    cond: Operand::Const(IrConst::I32(1)),
+                    true_label: BlockId(1),
+                    false_label: BlockId(2),
+                },
+            ),
+            block(1, vec![scalar_def(0, 11)], Terminator::Return(Some(Operand::Value(Value(0))))),
+            block(2, vec![scalar_def(1, 22)], Terminator::Return(Some(Operand::Value(Value(1))))),
+        ];
+        let tracked = [0, 1].into_iter().collect();
+        let result = build_copy_aware_interference(&func, &tracked).expect("converges");
+        assert!(!result[&0].contains(&1));
+        assert!(!result[&1].contains(&0));
+    }
+
+    #[test]
+    fn phi_parallel_copy_bundle_blocks_cross_copy_colour_cycles() {
+        // Values 2 and 3 are multi-definition phi destinations.  On the first
+        // edge the simultaneous copies are `2 = 0, 3 = 1`; colouring 2 with 1
+        // or 3 with 0 would make the sequential emission overwrite a later
+        // source.  The bundle proof must add precisely those cross edges while
+        // still allowing each own (dest, source) pair to coalesce.
+        let mut func = IrFunction::new("parallel_phi".to_string(), IrType::I32, vec![], false);
+        func.blocks = vec![
+            block(
+                0,
+                vec![
+                    scalar_def(0, 10),
+                    scalar_def(1, 20),
+                    Instruction::Copy { dest: Value(2), src: Operand::Value(Value(0)) },
+                    Instruction::Copy { dest: Value(3), src: Operand::Value(Value(1)) },
+                ],
+                Terminator::Branch(BlockId(1)),
+            ),
+            block(
+                1,
+                vec![
+                    Instruction::Copy { dest: Value(2), src: Operand::Value(Value(1)) },
+                    Instruction::Copy { dest: Value(3), src: Operand::Value(Value(0)) },
+                ],
+                Terminator::Return(Some(Operand::Value(Value(2)))),
+            ),
+        ];
+        let tracked = [0, 1, 2, 3].into_iter().collect();
+        let result = build_copy_aware_interference(&func, &tracked).expect("converges");
+        assert!(result[&2].contains(&1));
+        assert!(result[&3].contains(&0));
+    }
+
+
+}
