+                ".section .foo\n.byte 2\n.section .foo,\"\"\n.byte 3\n",
+                ".section .foo,\"\",@progbits\n.byte 4\n",
+            ),
+            ".foo",
+        );
+        assert_eq!(text, [1, 2, 3, 4]);
