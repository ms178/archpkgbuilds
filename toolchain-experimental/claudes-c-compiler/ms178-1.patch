diff --git a/tests/regression/int_ptr_provenance_alias.c b/tests/regression/int_ptr_provenance_alias.c
new file mode 100644
index 000000000..60ba14fdf
--- /dev/null
+++ b/tests/regression/int_ptr_provenance_alias.c
@@ -0,0 +1,47 @@
+/* An address formed by INTEGER arithmetic carries no provenance from the
+ * pointer it was computed from (C23 6.3.2.3, PNVI-ae-udi): with
+ * d == (uintptr_t)b - (uintptr_t)a, (char *)((uintptr_t)a + d) designates b.
+ * LCCC used to lower the pointer -> integer cast to nothing, so GVN saw
+ * `a + d` and rooted the pointer in `a`: f/g kept the cached b[] value
+ * across the store through p (printed "1 4"). h pins the store-elimination
+ * side: the first store to b[1] is read through p and must survive.
+ * Genuine pointer arithmetic (`a + i`) may still be assumed to stay in a. */
+#include <stdint.h>
+#include <stdio.h>
+
+char a[16], b[16];
+
+__attribute__((noinline)) int f(long d) {
+    char *p = (char *)((uintptr_t)a + d);
+    b[0] = 1;
+    *p = 2;
+    return b[0];
+}
+
+__attribute__((noinline)) int g(long d, int n) {
+    int s = 0;
+    for (int i = 0; i < n; i++) {
+        char *p = (char *)((uintptr_t)a + d + i);
+        b[i] = 1;
+        *p = 3;
+        s += b[i];
+    }
+    return s;
+}
+
+__attribute__((noinline)) int h(long d) {
+    char *p = (char *)((uintptr_t)a + d);
+    b[1] = 5; /* read through p below */
+    int x = *p;
+    b[1] = 9;
+    return x;
+}
+
+int main(void) {
+    long d = (long)((uintptr_t)b - (uintptr_t)a);
+    int hr = h(d + 1);
+    int fr = f(d);
+    int gr = g(d, 4);
+    printf("%d %d %d %d\n", fr, gr, hr, b[1]);
+    return !(fr == 2 && gr == 12 && hr == 5 && b[1] == 3);
+}
diff --git a/tests/regression/tls_cross_models/gd_acc.c b/tests/regression/tls_cross_models/gd_acc.c
new file mode 100644
index 000000000..dc8e40263
--- /dev/null
+++ b/tests/regression/tls_cross_models/gd_acc.c
@@ -0,0 +1,34 @@
+/* Values cached in a scratch register across a dynamic-TLS address.
+ *
+ * RISC-V GD materialises `&ext_tls` as `call __tls_get_addr`, which may
+ * clobber every caller-saved register -- t0 included, the backend's
+ * accumulator. `w2` computes `v` into t0, takes the TLS address into an
+ * allocated register, then stores `v`: the codegen register cache still
+ * claimed t0 held `v`, so the store wrote whatever the resolver left in t0.
+ * glibc's bound fast path happens to preserve t0; the lazy-binding PLT0
+ * stub does not (it loads the resolver arguments through t0), so the gate
+ * runs the host with LD_BIND_NOT=1 to route every call through it.
+ *
+ * On AArch64 the same shapes exercise the TLSDESC `blr`: no caller-saved
+ * home may span it (the text peephole models the `blr` as a full call). */
+extern __thread long ext_tls;
+
+__attribute__((noinline)) long w1(long *q, long n) {
+    long v = q[0] * n;
+    long *p = &ext_tls;
+    return v + *p + v * 3;
+}
+
+__attribute__((noinline)) long w2(long a, long b) {
+    long v = a ^ b;
+    long *p = &ext_tls;
+    *p = v;
+    return v + 1;
+}
+
+__attribute__((noinline)) long w3(long a, long b, long c) {
+    long v = a + b;
+    long *p = &ext_tls;
+    long r = *p;
+    return v * c + r + v;
+}
diff --git a/tests/regression/tls_cross_models/gd_acc_main.c b/tests/regression/tls_cross_models/gd_acc_main.c
new file mode 100644
index 000000000..281516f51
--- /dev/null
+++ b/tests/regression/tls_cross_models/gd_acc_main.c
@@ -0,0 +1,20 @@
+/* Host for gd_acc.c: defines ext_tls and checks every result. */
+#include <stdio.h>
+__thread long ext_tls = 5;
+long w1(long *, long);
+long w2(long, long);
+long w3(long, long, long);
+int main(void) {
+    long q = 7;
+    int bad = 0;
+    long r1 = w1(&q, 3); /* v = 21: 21 + 5 + 63 */
+    if (r1 != 89) { printf("w1 = %ld, want 89\n", r1); bad = 1; }
+    long r2 = w2(0x1234, 0x0ff0); /* v = 0x1dc4, stored to ext_tls */
+    if (r2 != 0x1dc5 || ext_tls != 0x1dc4) {
+        printf("w2 = %ld, ext_tls = %#lx; want 7621, 0x1dc4\n", r2, ext_tls);
+        bad = 1;
+    }
+    long r3 = w3(2, 3, 4); /* v = 5: 20 + 0x1dc4 + 5 */
+    if (r3 != 25 + 0x1dc4) { printf("w3 = %ld, want %d\n", r3, 25 + 0x1dc4); bad = 1; }
+    return bad;
+}
