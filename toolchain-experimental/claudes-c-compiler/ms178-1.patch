+/// `PtrQuals` qualifier bits as GCC spells them (`const volatile restrict`).
+pub fn cvr_spelling(cvr: u8) -> &'static str {
+    const NAMES: [&str; 8] = [
+        "",
+        "const",
+        "volatile",
+        "const volatile",
+        "restrict",
+        "const restrict",
+        "volatile restrict",
+        "const volatile restrict",
+    ];
+    NAMES[usize::from(cvr & 0b111)]
