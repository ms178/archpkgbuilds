+/// The spelling of operand `idx`, for diagnostics.
+pub(crate) fn operand_spelling(operands: &[Operand], idx: usize) -> String {
+    match operands.get(idx) {
+        Some(Operand::Reg(n)) => n.clone(),
+        Some(_) | None => String::from("?"),
+    }
+}
