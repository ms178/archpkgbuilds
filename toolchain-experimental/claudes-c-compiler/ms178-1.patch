+    #[test]
+    fn unclassified_text_has_no_summary() {
+        for text in [
+            "    call printf\n",
+            "    call *%rax\n",
+            "    jmp *%rcx\n",
+            "    jmp other\n",
+            "    rdmsr\n",
+            "    vmcall\n",
+            "    int $128\n",
