+    fn long_double_truth_uses_payload_not_approximation() {
+        // binary128 smallest subnormal, smallest normal, infinity and NaN.
+        for bits in [
+            1u128,
+            1u128 << 112,
+            0x7fffu128 << 112,
+            (0x7fffu128 << 112) | 1,
+        ] {
