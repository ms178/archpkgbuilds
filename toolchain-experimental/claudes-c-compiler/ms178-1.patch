+            "jmp *%rsi\n",
+        ] {
+            assert!(!run(&wrap(&(body('q', false) + tail)), None).0);
+        }
+        assert!(
+            !run(
+                &wrap(&(body('q', true) + "movq %rax, %rdx\nmovq %r11, %rax\n")),
+                None
+            )
+            .0
+        );
+        assert!(!run(&body('q', false), None).0, "unknown function exit");
+    }
+
+    #[test]
+    fn refuses_width_alias_condition_and_saturation_near_misses() {
+        let s = body('q', false);
+        for (from, to) in [
+            ("$255", "$511"),
+            ("$255", "$254"),
+            ("$64", "$63"),
+            ("cmovaeq", "cmovbq"),
+            ("cmovaeq", "cmovgeq"),
+            ("shlxq", "shrxq"),
+            ("subq $1", "subq $2"),
+            ("movl $1", "movl $2"),
+            ("andq %r11", "andl %r11d"),
+            ("%rdi", "%r8"),
