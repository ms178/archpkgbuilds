+    &[0x90],                                                 // nop
+    &[0x66, 0x90],                                           // xchg %ax,%ax
+    &[0x48, 0x89, 0xF6],                                     // mov %rsi,%rsi
+    &[0x48, 0x8D, 0x76, 0x00],                               // lea 0(%rsi),%rsi
+    &[0x48, 0x8D, 0x74, 0x26, 0x00],                         // lea 0(%rsi,%riz),%rsi
+    &[0x2E, 0x48, 0x8D, 0x74, 0x26, 0x00],                   // lea %cs:0(%rsi,%riz),%rsi
