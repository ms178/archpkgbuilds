+        _write(td, "s.s", "\t.text\n\t.globl get_str\nget_str:\tmovl $.LC0, %eax\n\tret\n"
+                          "\t.section .rodata.str1.1,\"aMS\",@progbits,1\n.LC0:\t.string \"x\"\n")
