+            // path regardless of `size`: the `size <= 2` branch below only
+            // covers byte/word diffs, but the kernel's la57 trampoline uses
+            // exactly this shape at 4-byte width --
+            //     .pushsection .data ; .long 770b + 1 - 760b ; .popsection
