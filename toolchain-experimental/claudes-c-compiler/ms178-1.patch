diff --git a/tests/oracle/programs/seg_gs_pointee_chain.c b/tests/oracle/programs/seg_gs_pointee_chain.c
new file mode 100644
index 00000000..fd7fb174
--- /dev/null
+++ b/tests/oracle/programs/seg_gs_pointee_chain.c
@@ -0,0 +1,83 @@
+/* Runtime, self-checking contract for a segment qualifier written after an
+ * earlier `*` of a declarator (the pointee of the outer pointer is in %gs).
+ *
+ *   long *__seg_gs *pp;   pp is ordinary memory. *pp is a `long *` object that
+ *                         lives in %gs. **pp is the long it points at.
+ *
+ * The GS base is set to `area`, so the value of `pp` is an offset into `area`
+ * where the segment pointer object sits. Each check compares the observed
+ * value with the same value read through ordinary memory. GCC 14.2 -O2 is the
+ * oracle (the output must match it line for line).
+ */
+#include <stdio.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#define ARCH_SET_GS 0x1001
+#define AREA 4096
+
+static unsigned char area[AREA] __attribute__((aligned(64)));
+static long target[8];
+static int failures;
+
+#define CHECK(cond, name)                 \
+    do {                                  \
+        if (cond) {                       \
+            printf("ok %s\n", name);      \
+        } else {                          \
+            printf("FAIL %s\n", name);    \
+            failures++;                   \
+        }                                 \
+    } while (0)
+
+/* Two levels: the first star's qualifier puts the pointer it builds in %gs. */
+static long *__seg_gs *pp;
+
+/* Three levels: the qualifier after star 1 puts the star-1 pointer in %gs, and
+ * the qualifier after star 2 puts the star-2 pointer in %gs. The object itself
+ * (star 3, adjacent to the name) is ordinary memory. */
+static long *__seg_gs *__seg_gs *ppp;
+
+__attribute__((noinline)) static long read_two(long *__seg_gs *q) { return **q; }
+__attribute__((noinline)) static void write_two(long *__seg_gs *q, long v) { **q = v; }
+__attribute__((noinline)) static long read_plus_one(void) { return **pp + 1; }
+
+int main(void) {
+    if (syscall(SYS_arch_prctl, ARCH_SET_GS, area) != 0) {
+        perror("arch_prctl");
+        return 2;
+    }
+    setvbuf(stdout, NULL, _IONBF, 0);
+
+    /* The segment object at GS:0x100 holds a generic pointer to target[2]. */
+    long **slot = (long **)(area + 0x100);
+    target[2] = 41;
+    *slot = &target[2];
+
+    pp = (long *__seg_gs *)0x100;
+    CHECK(**pp == 41, "two_level_read");
+    **pp = 42;
+    CHECK(target[2] == 42, "two_level_write");
+    CHECK(read_two(pp) == 42, "two_level_arg_read");
+    write_two(pp, 43);
+    CHECK(target[2] == 43, "two_level_arg_write");
+    CHECK(read_plus_one() == 44, "two_level_global_read");
+
+    /* Three levels. GS:0x140 is a star-2 object: it holds the GS offset of the
+     * star-1 object. GS:0x148 is that star-1 object: a generic pointer. */
+    *(unsigned long *)(area + 0x140) = 0x148;
+    *(long **)(area + 0x148) = &target[5];
+    target[5] = 77;
+    ppp = (long *__seg_gs *__seg_gs *)0x140;
+    CHECK(**ppp == &target[5], "three_level_pointer_value");
+    CHECK(***ppp == 77, "three_level_read");
+    ***ppp = 78;
+    CHECK(target[5] == 78, "three_level_write");
+
+    if (failures == 0) {
+        printf("PASSED (0 failures)\n");
+        return 0;
+    }
+    printf("FAILED (%d failure%s)\n", failures, failures == 1 ? "" : "s");
+    return 1;
+}
diff --git a/tests/regression/check_seg_cast_warning.sh b/tests/regression/check_seg_cast_warning.sh
new file mode 100755
index 00000000..9af39365
--- /dev/null
+++ b/tests/regression/check_seg_cast_warning.sh
@@ -0,0 +1,74 @@
+#!/usr/bin/env bash
+# Explicit-cast diagnostics between named address spaces, and the abstract
+# declarator paths (sizeof, unnamed parameters, casts) that carry them.
+#
+# GCC 14.2 accepts every cast below and warns with "cast to ... address space
+# pointer from disjoint ...". The rule is applied to the outermost pointer
+# only, so `long *__seg_gs *` -> `long *__seg_gs *` is silent.
+#
+#   line 1  generic -> __seg_gs          warns
+#   line 2  __seg_gs -> generic          warns
+#   line 3  __seg_fs -> __seg_gs         warns
+#   line 4  __seg_gs -> __seg_gs         silent
+#   line 5  generic -> `long *__seg_gs *` warns
+#   line 6  void * -> void *             silent
+#
+# The runtime half checks sizeof and the unnamed-parameter and cast reads
+# against the values GCC produces.
+set -euo pipefail
+CCC=${CCC:-./target/fastbuild/lccc}
+tmp=$(mktemp -d "${TMPDIR:-/tmp}/lccc-seg-cast.XXXXXX")
+trap 'rm -rf "$tmp"' EXIT
+
+src="$tmp/casts.c"
+cat > "$src" <<'C'
+void a(void *p) { long __seg_gs *x = (long __seg_gs *)p; (void)x; }
+void b(long __seg_gs *p) { long *y = (long *)p; (void)y; }
+void c(long __seg_fs *p) { long __seg_gs *z = (long __seg_gs *)p; (void)z; }
+void d(long *__seg_gs *p) { long *__seg_gs *w = (long *__seg_gs *)p; (void)w; }
+void e(long *p) { long *__seg_gs *w = (long *__seg_gs *)p; (void)w; }
+void f(void *p) { void *q = (void *)p; (void)q; }
+C
+
+fail=0
+"$CCC" -O0 -c -o "$tmp/casts.o" "$src" 2> "$tmp/casts.err" || { echo "FAIL: casts.c rejected"; cat "$tmp/casts.err"; exit 1; }
+warned=$(grep -c "warning: cast to" "$tmp/casts.err" || true)
+lines=$( (grep "warning: cast to" "$tmp/casts.err" || true) | sed -E 's/^[^:]*:([0-9]+):.*/\1/' | tr '\n' ' ')
+if [ "$warned" -ne 4 ] || [ "$lines" != "1 2 3 5 " ]; then
+    echo "FAIL: expected 4 cast warnings on lines 1 2 3 5, got $warned on: $lines"
+    cat "$tmp/casts.err"
+    fail=1
+fi
+grep -q "cast to '__seg_gs' address space pointer from disjoint generic address space pointer" "$tmp/casts.err" \
+    || { echo "FAIL: wording for generic -> __seg_gs"; fail=1; }
+grep -q "cast to generic address space pointer from disjoint '__seg_gs' address space pointer" "$tmp/casts.err" \
+    || { echo "FAIL: wording for __seg_gs -> generic"; fail=1; }
+grep -q "cast to '__seg_gs' address space pointer from disjoint '__seg_fs' address space pointer" "$tmp/casts.err" \
+    || { echo "FAIL: wording for __seg_fs -> __seg_gs"; fail=1; }
+
+run="$tmp/run.c"
+cat > "$run" <<'C'
+#include <stdio.h>
+long __seg_gs *gs_obj;
+long *__seg_gs *gs_pp;
+long sz1(void) { return sizeof(long *__seg_gs *); }
+long sz2(void) { return sizeof(long __seg_gs *); }
+long rd_unnamed(long *__seg_gs *);
+long rd_unnamed(long *__seg_gs *q) { return **q; }
+long cast_read(void *p) { return **(long *__seg_gs *)p; }
+int main(void) {
+    printf("%ld %ld\n", sz1(), sz2());
+    return 0;
+}
+C
+"$CCC" -O0 -o "$tmp/run" "$run" 2> "$tmp/run.err" || { echo "FAIL: run.c rejected"; cat "$tmp/run.err"; exit 1; }
+got=$("$tmp/run")
+if [ "$got" != "8 8" ]; then
+    echo "FAIL: sizeof of pointer-to-segment-pointer printed '$got', expected '8 8'"
+    fail=1
+fi
+
+if [ "$fail" -ne 0 ]; then
+    exit 1
+fi
+echo "check_seg_cast_warning: PASSED (4 cast warnings on lines 1 2 3 5; 0 on 4 6; sizeof 8 8)"
diff --git a/tests/regression/check_seg_gs_runtime.sh b/tests/regression/check_seg_gs_runtime.sh
new file mode 100755
index 00000000..4f881689
--- /dev/null
+++ b/tests/regression/check_seg_gs_runtime.sh
@@ -0,0 +1,122 @@
+#!/usr/bin/env bash
+# Executed regression for x86-64 named address space __seg_gs (D2, D4, D7).
+#
+# seg_gs_runtime/seg_gs_runtime.c points the GS base at a buffer and checks
+# every __seg_gs load, store, aggregate copy and typedef pointer against values
+# computed through ordinary memory. This script:
+#
+#   1. compiles the program with $CCC at -O0, -O1 and -O2, and assembles and
+#      links it through the normal driver (not only -S), so a bad encoding or
+#      a bad relocation fails here;
+#   2. runs each binary and requires the final PASSED line and exit status 0;
+#   3. when gcc is available, requires each lccc run to print exactly the same
+#      lines as the gcc-built binary (GCC is the oracle for the accepted
+#      behaviour; the self-checks are the pass/fail source of truth).
+#
+# Skips (exit 0, with a message) on non-x86-64 hosts: the test uses the
+# x86-64 GS base and arch_prctl(ARCH_SET_GS).
+set -euo pipefail
+CCC=${CCC:-./target/fastbuild/lccc}
+# Self-checking programs, each paired with the gcc optimisation level used as its
+# oracle. Every program is built with $CCC at -O0, -O1 and -O2 and must print
+# the PASSED line; when gcc is available its output must match the gcc build
+# line for line.
+#   seg_gs_runtime.c  offset-pointer forms; oracle gcc -O2.
+#   seg_gs_audit.c    object-level forms (block extern, &object, conditional /
+#                     comma / assignment aggregates, pointer to array, vector and
+#                     complex objects, volatile reads, post-* object qualifier).
+#                     Oracle gcc -O0: GCC 14.2 at -O2 stores a whole __seg_gs
+#                     complex constant with a generic movaps (verified:
+#                     `movaps %xmm0, cg_obj(%rip)`), so -O2 is not a valid oracle.
+#   seg_gs_overread.c guard-page test: 1-7 and 9-15 byte struct returns and
+#                     arguments must not read past the object (both oracles).
+#   seg_gs_pointee_chain.c  a segment qualifier after an earlier `*` (the
+#                     pointee of the outer pointer is in %gs); oracle gcc -O2.
+#   seg_gs_fold.c     constant-displacement folding of every integer width,
+#                     constant and register sources, read-modify-write, bases in
+#                     many registers (both oracles).
+programs=(
+    "tests/regression/seg_gs_runtime/seg_gs_runtime.c -O2"
+    "tests/regression/seg_gs_runtime/seg_gs_audit.c -O0"
+    "tests/regression/seg_gs_runtime/seg_gs_overread.c -O0"
+    "tests/regression/seg_gs_runtime/seg_gs_overread.c -O2"
+    "tests/regression/seg_gs_runtime/seg_gs_fold.c -O0"
+    "tests/regression/seg_gs_runtime/seg_gs_fold.c -O2"
+    "tests/regression/seg_gs_runtime/seg_gs_pointee_chain.c -O2"
+)
+tmp=$(mktemp -d "${TMPDIR:-/tmp}/lccc-seg-gs-runtime.XXXXXX")
+trap 'rm -rf "$tmp"' EXIT
+
+if [ "$(uname -m)" != "x86_64" ] || [ "$(uname -s)" != "Linux" ]; then
+    echo "SKIP: seg_gs runtime test needs x86-64 Linux (arch_prctl ARCH_SET_GS)"
+    exit 0
+fi
+
+fail=0
+
+# Every seg_gs_*.c program in the directory must be registered, so a new test
+# cannot be added and then silently never run.
+for f in tests/regression/seg_gs_runtime/seg_gs_*.c; do
+    base=$(basename "$f")
+    registered=0
+    for entry in "${programs[@]}"; do
+        case "$entry" in
+            *"/$base "*) registered=1 ;;
+        esac
+    done
+    if [ "$registered" -ne 1 ]; then
+        echo "FAIL: $base is not registered in programs[]" >&2
+        fail=1
+    fi
+done
+
+run_program() {
+src=$1
+oracle_opt=$2
+ref=""
+if command -v gcc >/dev/null 2>&1; then
+    if ! gcc "$oracle_opt" -w -o "$tmp/ref" "$src"; then
+        echo "FAIL: gcc $oracle_opt oracle failed to build $src" >&2
+        fail=1
+        return
+    fi
+    ref=$("$tmp/ref")
+fi
+for opt in -O0 -O1 -O2; do
+    bin="$tmp/lccc$opt"
+    if ! "$CCC" "$opt" -o "$bin" "$src"; then
+        echo "FAIL: lccc $opt failed to compile or link $src" >&2
+        fail=1
+        continue
+    fi
+    set +e
+    out=$("$bin")
+    rc=$?
+    set -e
+    if [ "$rc" -ne 0 ] || ! grep -qx 'PASSED (0 failures)' <<<"$out"; then
+        echo "FAIL: lccc $opt runtime $src (rc=$rc)" >&2
+        grep -v '^ok ' <<<"$out" >&2 || true
+        fail=1
+        continue
+    fi
+    if [ -n "$ref" ] && [ "$out" != "$ref" ]; then
+        echo "FAIL: lccc $opt output of $src differs from gcc $oracle_opt oracle" >&2
+        diff <(printf '%s\n' "$ref") <(printf '%s\n' "$out") >&2 || true
+        fail=1
+        continue
+    fi
+    echo "PASS: $(basename "$src") lccc $opt$( [ -n "$ref" ] && echo " (identical to gcc $oracle_opt)")"
+done
+}
+
+for entry in "${programs[@]}"; do
+    # shellcheck disable=SC2086
+    run_program $entry
+done
+
+if [ "$fail" -ne 0 ]; then
+    echo "check_seg_gs_runtime: FAILED" >&2
+    exit 1
+fi
+echo "check_seg_gs_runtime: PASSED"
+exit 0
