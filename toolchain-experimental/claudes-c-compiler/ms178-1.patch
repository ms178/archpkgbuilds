diff --git a/tests/regression/check_seg_copy_sweep.sh b/tests/regression/check_seg_copy_sweep.sh
new file mode 100755
index 00000000..6deb0f03
--- /dev/null
+++ b/tests/regression/check_seg_copy_sweep.sh
@@ -0,0 +1,78 @@
+#!/usr/bin/env bash
+# Size sweep for aggregate copies to and from __seg_gs objects.
+#
+# gen_seg_copy_sweep.py emits one self-checking program with a __seg_gs object
+# per size (192 sizes by default: every length 1..=64, the lengths 65..=512
+# with residue 1, 8 or 15 modulo 16, and the loop edges 511, 512, 513..=544,
+# 1000, 1023..=1025, 2047..=2049, 4095..=4097 and 5000). This script:
+#
+#   1. builds the program with $CCC at -O0 and -O2, links it through the normal
+#      driver, and runs each binary;
+#   2. requires the final PASSED line and exit status 0 from every lccc build;
+#   3. requires each lccc run to print exactly the same lines as a gcc -O0 build
+#      (GCC is the oracle for the accepted behaviour).
+#
+# The copy path is the straight-line code up to SEG_COPY_UNROLL_MAX (512 bytes)
+# and the counted loop with its tail above it. The sweep covers both, plus the
+# tails of every width, so an off-by-one in either path fails here.
+#
+# Skips (exit 0, with a message) on non-x86-64 hosts: the program uses the
+# x86-64 GS base and arch_prctl(ARCH_SET_GS).
+set -euo pipefail
+CCC=${CCC:-./target/fastbuild/lccc}
+gen=tests/regression/seg_gs_runtime/gen_seg_copy_sweep.py
+
+if [ "$(uname -m)" != "x86_64" ] || [ "$(uname -s)" != "Linux" ]; then
+    echo "SKIP: seg copy sweep needs x86-64 Linux (arch_prctl ARCH_SET_GS)"
+    exit 0
+fi
+
+tmp=$(mktemp -d "${TMPDIR:-/tmp}/lccc-seg-copy-sweep.XXXXXX")
+trap 'rm -rf "$tmp"' EXIT
+
+python3 "$gen" "$tmp/sweep.c"
+
+fail=0
+if ! command -v gcc >/dev/null 2>&1; then
+    echo "FAIL: gcc is required as the oracle for the sweep"
+    exit 1
+fi
+gcc -O0 -w -o "$tmp/oracle" "$tmp/sweep.c"
+"$tmp/oracle" > "$tmp/oracle.out" 2>&1 || true
+if [ "$(tail -n 1 "$tmp/oracle.out")" != "seg_copy_sweep PASSED (192 sizes)" ]; then
+    echo "FAIL: gcc -O0 oracle did not pass the sweep"
+    tail -n 5 "$tmp/oracle.out"
+    exit 1
+fi
+
+for opt in -O0 -O2; do
+    bin="$tmp/sweep$opt"
+    if ! "$CCC" "$opt" -w "$tmp/sweep.c" -o "$bin" > "$tmp/build$opt.log" 2>&1; then
+        echo "FAIL: lccc $opt build"
+        tail -5 "$tmp/build$opt.log"
+        fail=1
+        continue
+    fi
+    rc=0
+    "$bin" > "$tmp/run$opt.out" 2>&1 || rc=$?
+    if [ "$rc" -ne 0 ] || [ "$(tail -n 1 "$tmp/run$opt.out")" != "seg_copy_sweep PASSED (192 sizes)" ]; then
+        echo "FAIL: lccc $opt run rc=$rc"
+        sed -n '/FAIL/p' "$tmp/run$opt.out" | sed -n '1,10p'
+        tail -n 3 "$tmp/run$opt.out"
+        fail=1
+        continue
+    fi
+    if ! diff -u "$tmp/oracle.out" "$tmp/run$opt.out" > "$tmp/diff$opt"; then
+        echo "FAIL: lccc $opt output differs from gcc -O0"
+        sed -n '1,20p' "$tmp/diff$opt"
+        fail=1
+        continue
+    fi
+    echo "ok   lccc $opt: $(wc -l < "$tmp/run$opt.out") lines identical to gcc -O0"
+done
+
+if [ "$fail" -ne 0 ]; then
+    echo "seg copy sweep: FAILED"
+    exit 1
+fi
+echo "seg copy sweep: PASSED"
diff --git a/tests/regression/check_seg_declarator_space.sh b/tests/regression/check_seg_declarator_space.sh
new file mode 100644
index 00000000..ec012ad5
--- /dev/null
+++ b/tests/regression/check_seg_declarator_space.sh
@@ -0,0 +1,70 @@
+#!/usr/bin/env bash
+# Declarator-placement contract for named address spaces.
+#
+# Every fixture in tests/regression/seg_decl/ is compiled with $CCC and with
+# gcc when gcc is available:
+#   neg_*.c  must be REJECTED (non-zero exit with an error diagnostic);
+#   pos_*.c  must be ACCEPTED (zero exit).
+# The file name is the expected verdict. When gcc is present, gcc must give
+# the same verdict, so a fixture cannot pass with a wrong expectation.
+#
+# Covered: a named space on a parameter's own object (`long *__seg_gs p`,
+# `long (*__seg_gs p)[4]`, scalar `__seg_gs long x`), named-space array decay
+# to a generic pointer in an initializer, argument, or local initializer, and
+# a pointer assignment across spaces. Accepted: a space on the pointee, a
+# typedef pointer, a grouped array pointer, and an explicit cast.
+set -euo pipefail
+CCC=${CCC:-./target/fastbuild/lccc}
+dir=tests/regression/seg_decl
+tmp=$(mktemp -d "${TMPDIR:-/tmp}/lccc-seg-decl.XXXXXX")
+trap 'rm -rf "$tmp"' EXIT
+have_gcc=0
+command -v gcc >/dev/null 2>&1 && have_gcc=1
+fail=0
+shopt -s nullglob
+files=("$dir"/neg_*.c "$dir"/pos_*.c)
+if [ "${#files[@]}" -eq 0 ]; then
+    echo "FAIL: no fixtures in $dir" >&2
+    exit 1
+fi
+for f in "${files[@]}"; do
+    base=$(basename "$f")
+    case "$base" in
+        neg_*) want=reject ;;
+        pos_*) want=accept ;;
+    esac
+    set +e
+    lerr=$("$CCC" -c -o "$tmp/x.o" "$f" 2>&1)
+    lrc=$?
+    set -e
+    if [ "$lrc" -ne 0 ]; then got=reject; else got=accept; fi
+    if [ "$want" = reject ] && [ "$got" = reject ] && ! grep -q 'error' <<<"$lerr"; then
+        echo "FAIL: lccc rejects $base without an error diagnostic" >&2
+        fail=1
+        continue
+    fi
+    if [ "$got" != "$want" ]; then
+        echo "FAIL: lccc $got $base (expected $want)" >&2
+        grep -m2 . <<<"$lerr" >&2 || true
+        fail=1
+        continue
+    fi
+    if [ "$have_gcc" -eq 1 ]; then
+        set +e
+        gcc -std=gnu11 -c -o "$tmp/g.o" "$f" >/dev/null 2>&1
+        grc=$?
+        set -e
+        if [ "$grc" -ne 0 ]; then gg=reject; else gg=accept; fi
+        if [ "$gg" != "$want" ]; then
+            echo "FAIL: fixture $base expects $want but gcc $gg; fix the fixture" >&2
+            fail=1
+            continue
+        fi
+    fi
+    echo "PASS: $base lccc $got$( [ "$have_gcc" -eq 1 ] && echo " (gcc $gg)")"
+done
+if [ "$fail" -ne 0 ]; then
+    echo "check_seg_declarator_space: FAILED" >&2
+    exit 1
+fi
+echo "check_seg_declarator_space: PASSED (${#files[@]} fixtures)"
diff --git a/tests/regression/check_seg_gs_runtime.sh b/tests/regression/check_seg_gs_runtime.sh
new file mode 100755
index 00000000..4f7f0274
--- /dev/null
+++ b/tests/regression/check_seg_gs_runtime.sh
@@ -0,0 +1,164 @@
+#!/usr/bin/env bash
+# Executed regression for x86-64 named address space __seg_gs.
+#
+# seg_gs_runtime/seg_gs_runtime.c points the GS base at a buffer and checks
+# every __seg_gs load, store, aggregate copy and typedef pointer against values
+# computed through ordinary memory. This script:
+#
+#   1. compiles the program with $CCC at -O0, -O1, -O2 and -O3, and assembles and
+#      links it through the normal driver (not only -S), so a bad encoding or
+#      a bad relocation fails here;
+#   2. runs each binary and requires the final PASSED line and exit status 0;
+#   3. when gcc is available, requires each lccc run to print exactly the same
+#      lines as the gcc-built binary (GCC is the oracle for the accepted
+#      behaviour; the self-checks are the pass/fail source of truth).
+#
+# Skips (exit 0, with a message) on non-x86-64 hosts: the test uses the
+# x86-64 GS base and arch_prctl(ARCH_SET_GS).
+set -euo pipefail
+CCC=${CCC:-./target/fastbuild/lccc}
+# Self-checking programs, each paired with the gcc optimisation level used as its
+# oracle. Every program is built with $CCC at -O0, -O1 and -O2 and must print
+# the PASSED line; when gcc is available its output must match the gcc build
+# line for line.
+#   seg_gs_runtime.c  offset-pointer forms; oracle gcc -O2.
+#   seg_gs_audit.c    object-level forms (block extern, &object, conditional /
+#                     comma / assignment aggregates, pointer to array, vector and
+#                     complex objects, volatile reads, post-* object qualifier).
+#                     Oracle gcc -O0: GCC 14.2 at -O2 stores a whole __seg_gs
+#                     complex constant with a generic movaps (verified:
+#                     `movaps %xmm0, cg_obj(%rip)`), so -O2 is not a valid oracle.
+#   seg_gs_overread.c guard-page test: 1-7 and 9-15 byte struct returns and
+#                     arguments must not read past the object (both oracles).
+#   seg_gs_pointee_chain.c  a segment qualifier after an earlier `*` (the
+#                     pointee of the outer pointer is in %gs); oracle gcc -O2.
+#   seg_gs_fold.c     constant-displacement folding of every integer width,
+#                     constant and register sources, read-modify-write, bases in
+#                     many registers (both oracles).
+#   seg_gs_complex_rvalue.c  complex segment rvalues (comma, argument, assignment,
+#                     conditional) copied once; __real__/__imag__ at -O0.
+#                     Oracle gcc -O0 (GCC 14.2 at -O2 stores a whole __seg_gs
+#                     complex with a generic movaps).
+#   seg_gs_vector_loop.c reductions, maps and dot products over __seg_gs arrays
+#                     (the loops the vectorizer targets at -O3). Oracle gcc -O2.
+#   seg_gs_decay.c    pointer arithmetic on decayed __seg_gs arrays and member
+#                     arrays (array + n, n + array, array - n, pointer +=, row
+#                     decay, conditional offsets), checked through a GS mirror;
+#                     oracle gcc -O2.
+#   seg_gs_big_copy.c aggregate copies of 24 to 4096 bytes in every direction,
+#                     both sides of the 512-byte unroll limit, and a copy in a
+#                     function with rsp-addressed locals. Oracle gcc -O2.
+#   seg_gs_indexed.c  indexed element accesses `obj[i]`, `obj[i + k]` and
+#                     `p[i]` through a parameter base, for every integer width
+#                     and pointer elements, loads, stores, immediate stores and
+#                     read-modify-write, checked on a GS mirror. Oracle gcc -O2.
+programs=(
+    "tests/regression/seg_gs_runtime/seg_gs_runtime.c -O2"
+    "tests/regression/seg_gs_runtime/seg_gs_audit.c -O0"
+    "tests/regression/seg_gs_runtime/seg_gs_overread.c -O0"
+    "tests/regression/seg_gs_runtime/seg_gs_overread.c -O2"
+    "tests/regression/seg_gs_runtime/seg_gs_fold.c -O0"
+    "tests/regression/seg_gs_runtime/seg_gs_fold.c -O2"
+    "tests/regression/seg_gs_runtime/seg_gs_pointee_chain.c -O2"
+    "tests/regression/seg_gs_runtime/seg_gs_complex_rvalue.c -O0"
+    "tests/regression/seg_gs_runtime/seg_gs_big_copy.c -O2"
+    "tests/regression/seg_gs_runtime/seg_gs_decay.c -O2"
+    "tests/regression/seg_gs_runtime/seg_gs_vector_loop.c -O2"
+    "tests/regression/seg_gs_runtime/seg_gs_indexed.c -O0"
+    "tests/regression/seg_gs_runtime/seg_gs_indexed.c -O2"
+    "tests/regression/seg_gs_runtime/seg_gs_indexed.c -O3"
+)
+tmp=$(mktemp -d "${TMPDIR:-/tmp}/lccc-seg-gs-runtime.XXXXXX")
+trap 'rm -rf "$tmp"' EXIT
+
+if [ "$(uname -m)" != "x86_64" ] || [ "$(uname -s)" != "Linux" ]; then
+    echo "SKIP: seg_gs runtime test needs x86-64 Linux (arch_prctl ARCH_SET_GS)"
+    exit 0
+fi
+
+fail=0
+
+# Every seg_gs_*.c program in the directory must be registered, so a new test
+# cannot be added and then silently never run.
+for f in tests/regression/seg_gs_runtime/seg_gs_*.c; do
+    base=$(basename "$f")
+    registered=0
+    for entry in "${programs[@]}"; do
+        case "$entry" in
+            *"/$base "*) registered=1 ;;
+        esac
+    done
+    if [ "$registered" -ne 1 ]; then
+        echo "FAIL: $base is not registered in programs[]" >&2
+        fail=1
+    fi
+done
+
+run_program() {
+src=$1
+oracle_opt=$2
+ref=""
+if command -v gcc >/dev/null 2>&1; then
+    if ! gcc "$oracle_opt" -w -o "$tmp/ref" "$src"; then
+        echo "FAIL: gcc $oracle_opt oracle failed to build $src" >&2
+        fail=1
+        return
+    fi
+    ref=$("$tmp/ref")
+fi
+for opt in -O0 -O1 -O2 -O3; do
+    bin="$tmp/lccc$opt"
+    if ! "$CCC" "$opt" -o "$bin" "$src"; then
+        echo "FAIL: lccc $opt failed to compile or link $src" >&2
+        fail=1
+        continue
+    fi
+    set +e
+    out=$("$bin")
+    rc=$?
+    set -e
+    if [ "$rc" -ne 0 ] || ! grep -qx 'PASSED (0 failures)' <<<"$out"; then
+        echo "FAIL: lccc $opt runtime $src (rc=$rc)" >&2
+        grep -v '^ok ' <<<"$out" >&2 || true
+        fail=1
+        continue
+    fi
+    if [ -n "$ref" ] && [ "$out" != "$ref" ]; then
+        echo "FAIL: lccc $opt output of $src differs from gcc $oracle_opt oracle" >&2
+        diff <(printf '%s\n' "$ref") <(printf '%s\n' "$out") >&2 || true
+        fail=1
+        continue
+    fi
+    echo "PASS: $(basename "$src") lccc $opt$( [ -n "$ref" ] && echo " (identical to gcc $oracle_opt)")"
+done
+}
+
+for entry in "${programs[@]}"; do
+    # shellcheck disable=SC2086
+    run_program $entry
+done
+
+# Shape check: a runtime pass cannot show that the indexed fold was used, since
+# the remat path computes the same values. Count the SIB segment operands
+# (`%gs:(%base, %idx, scale)`) in the -O2 build; the kill switch must remove them.
+sib_count() {
+    grep -cE '%gs:\(.*, *%[a-z0-9]+, *[1248]\)' "$1" || true
+}
+idx_src=tests/regression/seg_gs_runtime/seg_gs_indexed.c
+"$CCC" -O2 -S -o "$tmp/idx_on.s" "$idx_src"
+CCC_NO_SEG_SIB=1 "$CCC" -O2 -S -o "$tmp/idx_off.s" "$idx_src"
+on=$(sib_count "$tmp/idx_on.s")
+off=$(sib_count "$tmp/idx_off.s")
+if [ "$on" -lt 18 ] || [ "$off" -ne 0 ]; then
+    echo "FAIL: seg_gs_indexed.c -O2 has $on segment SIB operands (need >= 18) and $off with CCC_NO_SEG_SIB=1 (need 0)" >&2
+    fail=1
+else
+    echo "PASS: seg_gs_indexed.c -O2 indexed segment operands: $on (CCC_NO_SEG_SIB=1: $off)"
+fi
+
+if [ "$fail" -ne 0 ]; then
+    echo "check_seg_gs_runtime: FAILED" >&2
+    exit 1
+fi
+echo "check_seg_gs_runtime: PASSED"
+exit 0
diff --git a/tests/regression/check_seg_named_decl_qualifier.sh b/tests/regression/check_seg_named_decl_qualifier.sh
index fbfbd0cb..7475348a 100755
--- a/tests/regression/check_seg_named_decl_qualifier.sh
+++ b/tests/regression/check_seg_named_decl_qualifier.sh
@@ -16,6 +16,24 @@
 #      `struct c __seg_gs *lk2(struct s *ssp)` keeps `ssp` generic, so a
 #      plain `struct s *` argument is accepted (GCC accepts it).
 #   8. negative control — a plain `struct c *` load carries no %gs override.
+#   9. function pointer  `struct c __seg_gs *(*fp)(void)`: the return-type
+#                       pointer is %gs, the function pointer load is not.
+#  10. pointer to ptr   `struct c __seg_gs **pp`: `pp[0]` is generic; only the
+#                       final `->` dereference is %gs (exactly one override).
+#  11. global pointer   `struct c __seg_gs *gp`: the variable `gp` itself is
+#                       generic memory (never `%gs:gp`); `gp->v[0]` is %gs.
+#  12. global pointer array `struct c __seg_gs *garr[4]`: elements are generic
+#                       loads, one %gs override for the dereference.
+#  13. positive control `struct c __seg_gs gobj`: a plain object declared in
+#                       the space is loaded as `%gs:gobj`.
+#  14. constraint: a generic `struct c *` stored into a `__seg_gs` member is
+#                       rejected (GCC 14.2: "assignment from pointer to
+#                       non-enclosed address space"), as are the reverse, an
+#                       initializer, and `void *` in either direction. An
+#                       explicit cast and a same-space store stay accepted.
+#  15. whole-type qualifier `__seg_gs __typeof__(struct c *) gpv;`: the pointer
+#                       object itself is %gs (kernel per-CPU pointer shape).
+#                       The pointee is NOT qualified by this form.
 #
 # GCC is the oracle for the accepted/rejected set and for the %gs prefix on
 # each load; the check is on the emitted assembly, not only the exit status.
@@ -44,10 +62,28 @@ void pass_ret(void) { take(lk()); take(mk()); }
 long rd_typedef(gp_t g) { return g->v[0]; }
 void pass_generic(struct s *s) { lk2(s); }
 long rd_plain(struct c *q) { return q->v[0]; }
+
+struct c __seg_gs *(*fp)(void);
+long rd_fnptr(void) { return fp()->v[0]; }
+struct c __seg_gs **pp;
+long rd_pp(void) { return pp[0]->v[0]; }
+struct c __seg_gs *gp;
+long rd_gp(void) { return gp->v[0]; }
+struct c __seg_gs *garr[4];
+long rd_garr(int i) { return garr[i]->v[0]; }
+struct c __seg_gs gobj;
+long rd_gobj(void) { return gobj.v[0]; }
+extern __seg_gs __typeof__(struct c *) gpv;
+long rd_whole(void) { return (long)gpv; }
 C
 
-"$CCC" -O2 -S -o "$tmp/t.s" "$tmp/t.c"
+cat >"$tmp/divergence.c" <<'C'
+struct c { long v[2]; };
+struct g { struct c __seg_gs *scp; };
+void store_generic(struct g *t, struct c *q) { t->scp = q; }
+C
 
