+    // Stores and comparisons have no register destination.
+    if mnem.starts_with("st")
+        || mnem.starts_with("cmp")
+        || mnem.starts_with("cmn")
+        || mnem.starts_with("tst")
+        || mnem.starts_with("fcmp")
