+        // The same bracket with a full-width copy-in is legal.
+        let out = insns(&run(&body(
+            "    movapd %xmm0, %xmm2\n    vaddpd %xmm2, %xmm3, %xmm4\n    movapd %xmm2, %xmm0\n    ret\n",
+        )));
