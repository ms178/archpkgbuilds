diff --git a/scripts/ci_enable_swap.sh b/scripts/ci_enable_swap.sh
new file mode 100644
index 0000000..c0634cc
--- /dev/null
+++ b/scripts/ci_enable_swap.sh
@@ -0,0 +1,57 @@
+#!/usr/bin/env bash
+# Provision a temporary swap file on a Linux CI runner before memory-heavy jobs.
+# The runner VM is ephemeral, so the active swap file is discarded with the job.
+set -euo pipefail
+
+if [[ $(uname -s) != Linux ]]; then
+    echo "ci_enable_swap: Linux is required" >&2
+    exit 2
+fi
+
+SWAP_SIZE=${LCCC_CI_SWAP_SIZE:-4G}
+SWAP_DIR=${RUNNER_TEMP:-${TMPDIR:-/tmp}}
+SWAP_FILE="$SWAP_DIR/lccc-ci.swap"
+
+if [[ ! -d $SWAP_DIR || ! -w $SWAP_DIR ]]; then
+    echo "ci_enable_swap: swap directory is not writable: $SWAP_DIR" >&2
+    exit 1
+fi
+
+if (( EUID == 0 )); then
+    as_root() { "$@"; }
+else
+    command -v sudo >/dev/null 2>&1 || {
+        echo "ci_enable_swap: sudo is required to activate swap" >&2
+        exit 1
+    }
+    as_root() { sudo -- "$@"; }
+fi
+
+command -v fallocate >/dev/null 2>&1 || {
+    echo "ci_enable_swap: fallocate is required" >&2
+    exit 1
+}
+
+# Be idempotent if a caller explicitly invokes the setup twice in one job.
+if ! awk -v path="$SWAP_FILE" '$1 == path { found = 1 } END { exit !found }' /proc/swaps; then
+    if [[ -e $SWAP_FILE ]]; then
+        # Only remove this script's fixed file in the runner temp directory.
+        as_root rm -f -- "$SWAP_FILE"
+    fi
+    as_root fallocate -l "$SWAP_SIZE" "$SWAP_FILE"
+    as_root chown root:root "$SWAP_FILE"
+    as_root chmod 600 "$SWAP_FILE"
+    as_root mkswap "$SWAP_FILE"
+    as_root swapon "$SWAP_FILE"
+fi
+
+if ! awk -v path="$SWAP_FILE" '$1 == path { found = 1 } END { exit !found }' /proc/swaps; then
+    echo "ci_enable_swap: swap file is not active: $SWAP_FILE" >&2
+    exit 1
+fi
+
+printf '%s\n' "Active CI swap file: $SWAP_FILE ($SWAP_SIZE)"
+as_root swapon --show
+if command -v free >/dev/null 2>&1; then
+    free -h
+fi
diff --git a/scripts/ci_install_gcc16.sh b/scripts/ci_install_gcc16.sh
new file mode 100644
index 0000000..c4eeddf
--- /dev/null
+++ b/scripts/ci_install_gcc16.sh
@@ -0,0 +1,62 @@
+#!/usr/bin/env bash
+# Install the GCC 16 toolchain used by CI's native oracle gates and benchmarks.
+# Prefer the runner distribution; use the Ubuntu Toolchain PPA only when the
+# distribution does not publish gcc-16 (the ubuntu-latest migration is rolling).
+set -euo pipefail
+
+MODE=${1:---base}
+case "$MODE" in
+    --base|--multilib) ;;
+    *) echo "usage: $0 [--base|--multilib]" >&2; exit 2 ;;
+esac
+
+if [[ $(uname -s) != Linux ]]; then
+    echo "ci_install_gcc16: Linux is required" >&2
+    exit 2
+fi
+
+if (( EUID == 0 )); then
+    as_root() { "$@"; }
+else
+    command -v sudo >/dev/null 2>&1 || {
+        echo "ci_install_gcc16: sudo is required to install packages" >&2
+        exit 1
+    }
+    as_root() { sudo -- "$@"; }
+fi
+
+if [[ $MODE == --multilib ]]; then
+    as_root dpkg --add-architecture i386
+fi
+as_root apt-get update
+
+candidate=$(apt-cache policy gcc-16 2>/dev/null | awk '/Candidate:/ { print $2; exit }' || true)
+if [[ -z $candidate || $candidate == '(none)' ]]; then
+    if ! command -v add-apt-repository >/dev/null 2>&1; then
+        as_root apt-get install -y --no-install-recommends software-properties-common
+    fi
+    as_root add-apt-repository -y ppa:ubuntu-toolchain-r/test
+    as_root apt-get update
+fi
+
+packages=(gcc-16 g++-16)
+if [[ $MODE == --multilib ]]; then
+    # Keep the runner's system-compiler multilib as well: older regression
+    # helpers still invoke unversioned `gcc`, while the corpus oracle itself is
+    # explicitly GCC 16.
+    packages+=(gcc-16-multilib g++-16-multilib gcc-multilib g++-multilib libc6-dev-i386)
+fi
+as_root apt-get install -y --no-install-recommends "${packages[@]}"
+
+version=$(gcc-16 -dumpfullversion)
+major=${version%%.*}
+if [[ $major != 16 ]]; then
+    echo "ci_install_gcc16: expected GCC 16, got $version" >&2
+    exit 1
+fi
+command -v g++-16 >/dev/null 2>&1 || {
+    echo "ci_install_gcc16: g++-16 was not installed" >&2
+    exit 1
+}
+printf 'Installed GCC toolchain: %s\n' "$(gcc-16 --version | head -n 1)"
+printf 'Installed G++ toolchain: %s\n' "$(g++-16 --version | head -n 1)"
