diff --git a/tests/regression/check_ext_vector_size.sh b/tests/regression/check_ext_vector_size.sh
new file mode 100644
index 00000000..606a8632
--- /dev/null
+++ b/tests/regression/check_ext_vector_size.sh
@@ -0,0 +1,51 @@
+#!/usr/bin/env bash
+# A14-13: no LP64 width guesses for ext_vector_type in casts/compound literals.
+set -euo pipefail
+root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
+ccc=${CCC:-$root/target/fastbuild/lccc}
+gcc_bin=${GCC:-gcc}
+source "$root/tests/regression/i386_exec.sh"
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+src=$root/tests/regression/ext_vector_size.c
+
+# A broken compiler must not turn a missing build into a successful gate.
+[ -x "$ccc" ] || { echo "FAIL: compiler not built: $ccc" >&2; exit 1; }
+for bits in 64 32; do
+    if [[ $bits == 32 ]] && ! i386_run_or_skip "$gcc_bin"; then
+        if [[ ${LCCC_REQUIRE_I686:-0} == 1 ]]; then exit 1; fi
+        continue
+    fi
+    for opt in 0 2; do
+        exe=$tmp/vector-$bits-$opt
+        "$ccc" -m"$bits" -O"$opt" "$src" -o "$exe"
+        if ! "$exe"; then
+            echo "FAIL: ext_vector_type width -m$bits -O$opt" >&2
+            exit 1
+        fi
+        echo "PASS: ext_vector_type width -m$bits -O$opt"
+    done
+done
+
+# Invalid lane types and invalid counts must be diagnosed, not transformed
+# into an apparently valid 4-byte vector (or a wrapped negative byte count).
+for kind in void pointer zero negative runtime; do
+    case "$kind" in
+        void) source='int main(void) { return sizeof((void __attribute__((ext_vector_type(4)))){0}); }' ;;
+        pointer) source='typedef int *ptr_t; int main(void) { return sizeof((ptr_t __attribute__((ext_vector_type(4)))){0}); }' ;;
+        zero) source='int main(void) { return sizeof((long __attribute__((ext_vector_type(0)))){0}); }' ;;
+        negative) source='int main(void) { return sizeof((long __attribute__((ext_vector_type(-1)))){0}); }' ;;
+        runtime) source='int n; int main(void) { return sizeof((long __attribute__((ext_vector_type(n)))){0}); }' ;;
+    esac
+    printf '%s\n' "$source" > "$tmp/$kind.c"
+    if "$ccc" -m64 -c "$tmp/$kind.c" -o "$tmp/$kind.o" >"$tmp/$kind.log" 2>&1; then
+        echo "FAIL: ext_vector_type $kind accepted" >&2
+        exit 1
+    fi
+    if ! grep -q 'ext_vector_type' "$tmp/$kind.log"; then
+        echo "FAIL: ext_vector_type $kind rejected without attribute diagnostic" >&2
+        cat "$tmp/$kind.log" >&2
+        exit 1
+    fi
+    echo "PASS: ext_vector_type $kind diagnosed"
+done
diff --git a/tests/regression/ext_vector_size.c b/tests/regression/ext_vector_size.c
new file mode 100644
index 00000000..168e59e4
--- /dev/null
+++ b/tests/regression/ext_vector_size.c
@@ -0,0 +1,31 @@
+/* ext_vector_type element widths in BOTH declaration and type-name paths.
+ * On ILP32 long is 4 bytes; on LP64 long is 8. A chained typedef must
+ * retain its underlying width when an attribute is applied to a type name.
+ * Use runtime values: parser-time _Static_assert and lowering historically
+ * followed different paths, and the former alone missed the wrong vector. */
+typedef long v4l __attribute__((ext_vector_type(4)));
+typedef unsigned long v4ul __attribute__((ext_vector_type(4)));
+typedef long long v4ll __attribute__((ext_vector_type(4)));
+typedef long base_long;
+typedef base_long alias_long;
+typedef alias_long v4alias __attribute__((ext_vector_type(4)));
+typedef alias_long v_typedef_count __attribute__((ext_vector_type(sizeof(alias_long))));
+
+int main(void) {
+    if (sizeof(v4l) != 4 * sizeof(long)) return 1;
+    if (sizeof((long __attribute__((ext_vector_type(4)))){0}) != 4 * sizeof(long)) return 2;
+    if (sizeof((alias_long __attribute__((ext_vector_type(4)))){0}) != 4 * sizeof(long)) return 3;
+    if (sizeof((long long __attribute__((ext_vector_type(4)))){0}) != 4 * sizeof(long long)) return 4;
+    if (sizeof((unsigned long __attribute__((ext_vector_type(4)))){0}) != 4 * sizeof(unsigned long)) return 5;
+    if (sizeof((float __attribute__((ext_vector_type(4)))){0}) != 4 * sizeof(float)) return 6;
+    if (sizeof(v4ul) != 4 * sizeof(unsigned long)) return 7;
+    if (sizeof(v4ll) != 4 * sizeof(long long)) return 8;
+    if (sizeof(v4alias) != 4 * sizeof(long)) return 9;
+    /* i686 scalar long double sizeof is 12, but vector storage lanes
+       are 16 bytes; a generic scalar sizeof substitution is wrong here. */
+    if (sizeof((long double __attribute__((ext_vector_type(4)))){0}) != 64) return 10;
+    if (sizeof(v_typedef_count) != sizeof(alias_long) * sizeof(long)) return 11;
+    if (sizeof((alias_long __attribute__((ext_vector_type(sizeof(alias_long))))){0})
+        != sizeof(alias_long) * sizeof(long)) return 12;
+    return 0;
+}
