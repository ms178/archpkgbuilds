+            "        }",
+            "    }",
+            f"    acc = acc > b ? acc - b : b - acc + {rng.randint(1, 50)};",
+        ]
+        if function:
+            lines.append(f"    if (acc & 1) acc += mixed_{rng.randrange(function)}(acc, a, p, n / 2);")
+        lines += ["    return acc;", "}", ""]
+        text += "\n".join(lines) + "\n"
