+        }
+        let block = &mut func.blocks[bi];
+        block.instructions = replacement;
+        if !block.source_spans.is_empty() {
+            block.source_spans = replacement_spans;
+        }
+        func.next_value_id = next_id;
+        return 1;
+    }
+    0
+}
