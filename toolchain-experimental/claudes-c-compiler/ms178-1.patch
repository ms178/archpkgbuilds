+    -c "$src/kernels.c" -o "$work/got32.o"
+"$GCC" "${flags[@]}" -m32 -msse2 -mfpmath=sse "$src/driver.c" "$work/ref32.o" "$work/got32.o" -lm -o "$work/run32"
+"$work/run32"
