+/// Force `id` from `⊤` to `⊥`. Returns whether it moved.
+#[inline]
+fn force_bottom(id: u32, state: &mut SccpState) -> bool {
+    match state.lattice.get(id as usize) {
+        Some(v) if v.is_top() => {
+            update_lattice(id, LatticeVal::Bottom, state);
+            true
+        }
+        _ => false,
+    }
