+fn written_gp_register(line: &str, kind: LineKind) -> Option<u8> {
+    match kind {
+        LineKind::Move { dst, .. } | LineKind::MoveImm { dst }
+        | LineKind::MoveWide { dst } | LineKind::Sxtw { dst, .. }
+        | LineKind::LoadSp { reg: dst, .. } | LineKind::LoadswSp { reg: dst, .. } => Some(dst),
