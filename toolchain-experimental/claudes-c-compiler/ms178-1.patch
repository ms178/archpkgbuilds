+                offset: 8,
+            },
+            src1: MachReg::Phys(PhysReg(20)),
+            dst: MachReg::Phys(PhysReg(21)),
+            size: OpSize::S64,
+        }),
+        "vmulsd 8(%rdi), %xmm2, %xmm3"
+    );
+}
