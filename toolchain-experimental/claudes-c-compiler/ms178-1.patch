+    let feeds = |inst: Option<&Instruction>| {
+        matches!(
+            inst,
+            Some(Instruction::Phi { incoming, .. })
+                if incoming.iter().any(|(op, _)| matches!(op, Operand::Value(v) if v.0 == vid))
