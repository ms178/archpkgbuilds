+        f"#![deny(unknown_lints)]\n#![allow({allows})]\npub fn probe() {{}}\n",
+        encoding="utf-8",
+    )
+    proc = subprocess.run(
+        [
+            driver,
+            "--edition",
+            "2021",
+            "--crate-type",
+            "lib",
+            "--emit=metadata",
+            "-o",
+            str(probe.with_suffix(".rmeta")),
+            str(probe),
+        ],
+        cwd=REPO,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        text=True,
+    )
+    if proc.returncode == 0:
+        return []
+    unknown = sorted(set(UNKNOWN_LINT.findall(proc.stdout)))
