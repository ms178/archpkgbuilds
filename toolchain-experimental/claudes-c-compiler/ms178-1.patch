+    }
+
+    #[test]
+    fn keeps_copy_a_partial_write_separates_from_its_read() {
+        // A partial copy of the destination before the read leaves the rest of
+        // the object undefined, so neither copy site can be forwarded.
+        let mut func = multi_block(vec![vec![
+            alloca(0, 32),
+            alloca(1, 32),
+            alloca(2, 32),
+            Instruction::Memcpy {
+                dest: Value(1),
+                src: Value(2),
+                size: 32,
+            },
+            Instruction::Memcpy {
+                dest: Value(0),
+                src: Value(2),
+                size: 32,
+            },
+            Instruction::Memcpy {
+                dest: Value(1),
+                src: Value(0),
+                size: 8,
+            },
+            Instruction::Load {
+                volatile: false,
+                dest: Value(3),
+                ptr: Value(1),
+                ty: IrType::U64,
+                seg_override: AddressSpace::Default,
