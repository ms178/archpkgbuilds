+__attribute__((noinline)) static unsigned f5(const unsigned *p) { unsigned sum=0; int trips=0; for(int i=(2147483644);i<=(2147483647);i+=(2)) { sum+=p[(unsigned)(i*(1))&63U]; if(++trips==32) break; } return sum; }
