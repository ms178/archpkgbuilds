+/// immediate-load / ALU pair that used to panic.
+fn panic_shapes(mnemonic: &str, spelling: &str) -> [String; 7] {
+    [
+        format!("    {mnemonic} $1, {spelling}"),
+        format!("    {mnemonic} {spelling}, {spelling}"),
+        format!("    {mnemonic} %rax, {spelling}"),
