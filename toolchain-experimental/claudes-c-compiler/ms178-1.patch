+            Some(Ok(_)) => FlagUse::Neutral, // a zero count keeps EFLAGS
+            Some(Err(_)) => FlagUse::Unknown,
+            None if count == "%cl" => FlagUse::Neutral, // the count may be zero
+            None => FlagUse::Unknown,
