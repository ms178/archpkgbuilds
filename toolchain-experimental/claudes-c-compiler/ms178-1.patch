+            ("%rdi", register_family_fast("%rdi")),
+            ("%rsi", register_family_fast("%rsi")),
+            ("%rcx", register_family_fast("%rcx")),
+        ];
+        if needs_rax_dead {
+            live_effect_regs.push(("%rax", register_family_fast("%rax")));
+        }
+        let mut scan = indexes[3] + 1;
+        while scan < store.len() {
+            if infos[scan].is_nop() {
+                scan += 1;
+                continue;
+            }
+            if infos[scan].is_barrier() {
+                break;
+            }
+            let text = infos[scan].trimmed(store.get(scan));
+            if text.contains(&scratch) {
+                safe = false;
+                break;
