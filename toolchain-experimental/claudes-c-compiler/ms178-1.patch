+    func: &mut IrFunction,
+    widen_map: &[Option<CastInfo>],
+    narrowed_map: &mut [Option<IrType>],
+) -> usize {
+    if crate::common::types::target_is_32bit() {
+        return 0;
+    }
+    let max_id = narrowed_map.len() - 1;
