+// CHECK-32-SAME: i32 noundef [[N:%.*]]) #[[ATTR0]] {
+// CHECK-32-NEXT:  [[ENTRY:.*:]]
+// CHECK-32-NEXT:    [[N_ADDR:%.*]] = alloca i32, align
+// CHECK-32-NEXT:    [[X:%.*]] = alloca i32, align
