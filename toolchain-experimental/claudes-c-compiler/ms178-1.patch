+        // A store between the load and the mask would change what the
+        // memory operand reads: adjacency is required.
+        let (c, out) = run(&func(
+            "    movl G(%rip), %eax\n    movl $0, G(%rip)\n    andl $1, %eax\n    je .LBB2\n",
+        ));
+        assert!(!c, "{out}");
+    }
+}
