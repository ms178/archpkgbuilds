+vpdpwssd %ymm3, %ymm1, %ymm2{%k1}
+vpmadd52luq %ymm3, %ymm1, %ymm2
+vpmadd52huq %ymm3, %ymm1, %ymm2
+vpmadd52luq %xmm3, %xmm1, %xmm2
+vpmadd52huq (%rax), %ymm1, %ymm2
+;;; vex_hint_forces_vex — {vex}/{vex2}/{vex3} force the VEX row
