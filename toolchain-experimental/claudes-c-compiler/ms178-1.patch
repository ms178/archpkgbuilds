+    /// function. Without them liveness answers `None` and every gated
+    /// fusion is skipped, so a test that forgets this passes vacuously.
+    fn f(body: &str) -> String {
+        format!(".text\nf:\n.cfi_startproc\n{}\n.cfi_endproc\n", body)
