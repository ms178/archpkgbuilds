+#!/usr/bin/env python3
+"""Exercise ci_resources.sh limits with synthetic host sizes."""
+from __future__ import annotations
+
+import os
+import subprocess
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+HELPER = ROOT / "scripts" / "ci_resources.sh"
+
+
+class ResourcePolicyTest(unittest.TestCase):
+    def policy(self, ram: int, swap: int, cpus: int, requested: int = 8) -> dict[str, str]:
+        command = (
+            f"source {str(HELPER)!r}; "
+            f"CI_LOCAL_JOBS={requested} CARGO_BUILD_JOBS={requested}; "
+            f"lccc_configure_resources {ram} {swap} {cpus}; "
+            "printf 'jobs=%s ci_jobs=%s debug=%s opt=%s incremental=%s\\n' "
+            '"$CARGO_BUILD_JOBS" "$CI_LOCAL_JOBS" '
+            '"${CARGO_PROFILE_FASTBUILD_DEBUG-unset}" '
+            '"${CARGO_PROFILE_FASTBUILD_OPT_LEVEL-unset}" '
+            '"${CARGO_INCREMENTAL-unset}"'
+        )
+        env = dict(os.environ)
+        # ci_local.sh configures this process before running the self-test;
+        # remove its outer profile so every simulated host starts independently.
+        for key in (
+            "CARGO_PROFILE_FASTBUILD_DEBUG",
+            "CARGO_PROFILE_FASTBUILD_OPT_LEVEL",
+            "CARGO_INCREMENTAL",
+            "CI_LOCAL_JOBS",
+            "CARGO_BUILD_JOBS",
+        ):
+            env.pop(key, None)
+        env.update(CI_LOCAL_JOBS=str(requested), CARGO_BUILD_JOBS=str(requested))
+        proc = subprocess.run(
+            ["bash", "-c", command],
+            cwd=ROOT,
+            env=env,
+            text=True,
+            capture_output=True,
+            check=True,
+        )
+        values = proc.stdout.strip().splitlines()[-1].split()
+        return dict(field.split("=", 1) for field in values)
+
+    def test_tiny_no_swap_selects_memory_safe_profile_and_one_job(self) -> None:
+        self.assertEqual(
+            self.policy(1984, 0, 2),
+            {"jobs": "1", "ci_jobs": "1", "debug": "0", "opt": "0", "incremental": "0"},
+        )
+
+    def test_active_three_gib_swap_keeps_fastbuild_profile_but_caps_jobs(self) -> None:
+        self.assertEqual(
+            self.policy(1984, 3072, 2),
+            {"jobs": "2", "ci_jobs": "2", "debug": "unset", "opt": "unset", "incremental": "unset"},
+        )
+
+    def test_large_host_caps_oversubscription_to_two_jobs(self) -> None:
+        self.assertEqual(
+            self.policy(8192, 0, 8),
+            {"jobs": "2", "ci_jobs": "2", "debug": "unset", "opt": "unset", "incremental": "unset"},
+        )
+
+    def test_one_cpu_is_respected(self) -> None:
+        self.assertEqual(self.policy(8192, 0, 1)["jobs"], "1")
+
+    def test_swap_threshold_boundary_is_inclusive(self) -> None:
+        self.assertEqual(self.policy(1984, 2047, 2)["opt"], "0")
+        self.assertEqual(self.policy(1984, 2048, 2)["opt"], "unset")
+
+
+if __name__ == "__main__":
+    unittest.main()
