+        assert!(
+            calls.contains(&"__vprintf_chk".to_string()),
+            "vprintf_chk %s shape must stay: {calls:?}"
+        );
+        // The stripped literal's fresh value id MUST be recorded in
+        // next_value_id: DCE sizes its def_loc table from max_value_id()
