+    }
+
+    #[test]
+    fn per_name_withdrawal_reaches_any_call() {
+        let mut m = module(vec![func("main", true, &["strlen", "sqrt", "memset"])]);
+        let mut cli = BuiltinFlags::default();
+        cli.withdraw_name("strlen");
