+    switch(which) {
+      case 0: printf("%d\n",address(p,1073741824,4));break;
+      case 1: printf("%d\n",triangular(46340,3));break;
+      case 2: printf("%d\n",affine_guard());break;
+      case 3: printf("%u\n",latch_wrap(p));break;
