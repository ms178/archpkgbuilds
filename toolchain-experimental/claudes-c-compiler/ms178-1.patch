@@ -0,0 +1,229 @@
+#!/usr/bin/env python3
+"""A compound literal used as a designated aggregate element (C11 6.5.2.5p5).
+
+WHY THIS GATE EXISTS
+====================
+`(T){ ... }` is an lvalue of type `T`, and in a static initializer it names
+exactly the bytes the braced list `{ ... }` names.  Linux 6.18 initializes
+`nodemask_t node_states[]` that way:
+
+    #define NODE_MASK_ALL ((nodemask_t) { { [BITS_TO_LONGS(MAX_NUMNODES)-1] = ... } })
+    nodemask_t node_states[NR_NODE_STATES] = { [N_POSSIBLE] = NODE_MASK_ALL, ... }
+
+(mm/page_alloc.c).  Until this gate existed, every aggregate path in the
+lowering handed that expression to the *scalar* evaluator, which can only
+answer "initializer element is not constant" — so lccc could not build
+mm/page_alloc.c with the user's config.  The failure was not uniform: the
+relocation-aware image (`T * __percpu *` members) already unwrapped the
+literal, the byte image did not, so the same source compiled or failed
+depending on whether the element type happened to contain a pointer.
+
+WHAT IS CHECKED, PER ROW
+========================
+1. Verdict parity with the oracle.  `gcc-16` is the reference: a row the
+   oracle accepts must be accepted by lccc, and a row it rejects must be
+   rejected.  (A cast around a compound literal, `(T)(T){...}`, is NOT a
+   constant expression — C11 6.6p6 — and both compilers must reject it.)
+2. Run-time values.  Every accepting row carries `# probe: <value>`; the probe
+   function is compiled and run by BOTH compilers and the printed values must
+   be identical.  This is what catches the second failure mode: an element that
+   silently keeps a zero because the literal reached the scalar path.
+3. Object image.  For every accepting row the relocation table
+   (symbol, type, addend) of `.data`/`.data.rel.ro` must match the oracle's,
+   so "accepted with the right value in the wrong slot" cannot pass.
+
+USAGE
+    GCC=gcc-16 CCC=target/fastbuild/lccc \
+        tests/regression/check_compound_literal_element.py [--verbose]
+
+EXIT STATUS
+    0  every row's verdict, values and relocations match the oracle
+    1  a mismatch (the failing row is named on stderr)
+    2  the oracle or the compiler is missing, or is not the pinned version
+"""
+
+import argparse
+import os
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+CASES = Path(__file__).with_name("compound_literal_element") / "cases.tsv"
+
+PRELUDE = """#include <stdio.h>
+"""
+
+
+def run(cmd, **kw):
+    return subprocess.run(cmd, capture_output=True, text=True, **kw)
+
+
+def version_of(cc, pinned):
+    out = run([cc, "--version"])
+    if out.returncode != 0:
+        raise SystemExit(f"gate: {cc}: not usable ({out.stderr.strip()[:80]})")
+    line = out.stdout.splitlines()[0]
+    if pinned not in line:
+        raise SystemExit(f"gate: {cc}: expected {pinned}, got {line}")
+    return line
+
+
+def parse_cases(path):
+    rows = []
+    for lineno, raw in enumerate(path.read_text().splitlines(), 1):
+        if not raw.strip() or raw.lstrip().startswith("#"):
+            continue
+        fields = raw.split("\t")
+        if lineno == 1 and fields[0] == "id":
+            continue
+        if len(fields) != 3:
+            raise SystemExit(f"{path}:{lineno}: expected 3 tab fields, got {len(fields)}")
+        rows.append((fields[0], fields[1], fields[2]))
+    return rows
+
+
+def split_payload(payload):
+    """`<declarations> # probe: <value>` -> (declarations, expected value)."""
+    marker = "# probe:"
+    if marker not in payload:
+        return payload, None
+    decls, _, tail = payload.rpartition(marker)
+    return decls.strip(), tail.strip()
+
+
+#: Relocation sections that make up the OBJECT IMAGE of a static initializer.
+#: `.text` relocations are code (a compiler's own addressing choices: PC-relative
+#: vs absolute, one reference vs two), so comparing them would compare codegen,
+#: not the initializer.  These six are the whole answer for "did the literal
+#: land in the right slot, with the right symbol".
+IMAGE_RELOC_SECTIONS = (".data", ".data.rel", ".data.rel.ro", ".data.rel.local",
+                        ".bss", ".rodata")
+
+
+def relocation_triples(obj):
+    """(section, type, symbol+addend) for every IMAGE relocation, sorted.
+
+    The addend inside the section is not compared: two compilers may pad the
+    object differently (`.data.rel.ro.local` split, static GC), and the slot a
+    relocation occupies is already pinned by the run-time probe.
+    """
+    out = run(["readelf", "-rW", str(obj)])
+    if out.returncode != 0:
+        raise SystemExit(f"gate: readelf failed on {obj}: {out.stderr.strip()[:120]}")
+    triples = []
+    section = None
+    for line in out.stdout.splitlines():
+        if line.startswith("Relocation section"):
+            # Relocation section '.rela.data.rel.ro' at offset 0x... contains 2 entries:
+            section = line.split("'")[1]
+            section = section[len(".rela") if section.startswith(".rela") else len(".rel"):]
+            continue
+        if section is None:
+            continue
+        parts = line.split()
+        # "0000000000000008  0000000000000001 R_X86_64_64  0000000000000000 g + 0"
+        if len(parts) < 3 or not parts[2].startswith("R_"):
+            continue
+        if not any(section == s or section.startswith(s + ".") for s in IMAGE_RELOC_SECTIONS):
+            continue
+        target = " ".join(parts[3:]) or "-"
+        # The section-relative slot offset is dropped, the symbol and addend stay.
+        triples.append((section, parts[2], target))
+    return sorted(triples)
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--compiler", default=os.environ.get("CCC", str(ROOT / "target/fastbuild/lccc")))
+    ap.add_argument("--gcc", default=os.environ.get("GCC", "gcc-16"))
+    ap.add_argument("--verbose", action="store_true")
+    args = ap.parse_args()
+
+    if not Path(args.compiler).exists():
+        raise SystemExit(f"gate: compiler not found: {args.compiler}")
+    version_of(args.gcc, "16.2")
+
+    rows = parse_cases(CASES)
+    failures = []
+    accepted = 0
+    with tempfile.TemporaryDirectory() as tmp:
+        tmp = Path(tmp)
+        for rid, expect, payload in rows:
+            decls, want = split_payload(payload)
+            src = tmp / f"{rid}.c"
+            body = PRELUDE + decls
+            if want is not None:
+                body += f"\nint main(void) {{ printf(\"%ld\\n\", (long)({want if want.startswith('probe') else 'probe()'})); return 0; }}\n"
+            src.write_text(body + "\n")
+
+            verdicts = {}
+            for name, cc in (("oracle", args.gcc), ("lccc", args.compiler)):
+                res = run([cc, "-std=gnu11", "-fsyntax-only", "-w", str(src)])
+                # `-fsyntax-only` skips the lowering, which is where a
+                # non-constant initializer is diagnosed, so the compile is the
+                # verdict that matters for static initializers.
+                res = run([cc, "-std=gnu11", "-c", "-w", "-o", str(tmp / f"{rid}.{name}.o"), str(src)])
+                verdicts[name] = res.returncode == 0
+                if not verdicts[name] and args.verbose:
+                    print(f"  {rid}: {name} rejected: {res.stderr.splitlines()[:2]}")
+
+            if verdicts["oracle"] != (expect == "accept"):
+                raise SystemExit(
+                    f"gate: row {rid}: the oracle disagrees with cases.tsv "
+                    f"(declared {expect}, oracle {'accepts' if verdicts['oracle'] else 'rejects'})"
+                )
+            if verdicts["lccc"] != verdicts["oracle"]:
+                failures.append(
+                    f"{rid}: lccc {'accepts' if verdicts['lccc'] else 'rejects'}, "
+                    f"oracle {'accepts' if verdicts['oracle'] else 'rejects'}"
+                )
+                continue
+            if not verdicts["oracle"]:
+                continue
+            accepted += 1
+
+            if want is not None:
+                values = {}
+                for name in ("oracle", "lccc"):
+                    exe = tmp / f"{rid}.{name}.bin"
+                    link = run(
+                        [args.gcc if name == "oracle" else args.compiler,
+                         "-w", str(src), "-o", str(exe)]
+                    )
+                    if link.returncode != 0:
+                        failures.append(f"{rid}: {name} link failed: {link.stderr.strip()[:120]}")
+                        break
+                    got = run([str(exe)])
+                    if got.returncode != 0:
+                        failures.append(f"{rid}: {name} probe exited {got.returncode}")
+                        break
+                    values[name] = got.stdout.strip()
+                if len(values) == 2 and values["oracle"] != values["lccc"]:
+                    failures.append(
+                        f"{rid}: run-time value {values['lccc']} (lccc) != "
+                        f"{values['oracle']} (oracle)"
+                    )
+
+            want_relocs = relocation_triples(tmp / f"{rid}.oracle.o")
+            got_relocs = relocation_triples(tmp / f"{rid}.lccc.o")
+            if want_relocs != got_relocs:
+                failures.append(
+                    f"{rid}: relocation table differs\n    oracle: {want_relocs}\n    lccc:   {got_relocs}"
+                )
+
+    if failures:
+        print("check_compound_literal_element: FAILED", file=sys.stderr)
+        for f in failures:
+            print(f"  {f}", file=sys.stderr)
+        return 1
+    print(
+        f"check_compound_literal_element: PASSED ({len(rows)} rows, {accepted} accepted; "
+        "verdicts, run-time values and relocation tables against GCC 16)"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tests/regression/check_debug_knobs_neutral.py b/tests/regression/check_debug_knobs_neutral.py
new file mode 100755
index 000000000..46592a1a3
--- /dev/null
+++ b/tests/regression/check_debug_knobs_neutral.py
@@ -0,0 +1,146 @@
+#!/usr/bin/env python3
+"""Debug knobs are neutral: they may explain, never change code.
+
+WHY THIS GATE EXISTS
+====================
+`docs/optimization-passes.md` lists the diagnostic knobs added with the S07-S08
+work (`CCC_DEBUG_VOLRED`, `CCC_DEBUG_STATIC_INIT`, `CCC_DEBUG_TYPES_COMPATIBLE`)
+and asserts two things about each of them:
+
+  1. setting it cannot change emitted code -- a benchmark or kernel build run
+     with a trace knob exported by accident must produce the same object; and
+  2. it is still compiled in -- a knob whose `std::env::var_os` call was
+     optimised away, renamed, or deleted is documentation of nothing.
+
+Assertion (1) is a codegen differential on a fixture that reaches all three
+decision sites (a `volatile_reduce` candidate loop, a static initializer whose
+member holds an address constant, and a `__builtin_types_compatible_p` query),
+at every optimization level the compiler exposes.  Assertion (2) is a `strings`
+probe of the compiler binary, which fails loudly if a knob stops being read.
+
+A knob that trips (1) is a miscompile-class hazard, not a logging nit: the
+compiler would then have two behaviours for one input that differ only in an
+environment variable nothing in the build records.
+"""
+
+import os
+import subprocess
+import sys
+import tempfile
+
+KNOBS = [
+    "CCC_DEBUG_VOLRED",
+    "CCC_DEBUG_STATIC_INIT",
+    "CCC_DEBUG_TYPES_COMPATIBLE",
+]
+
+LEVELS = ["-O0", "-O1", "-O2", "-O3"]
+
+FIXTURE = r"""
+/* --- static initializer: a pointer-sized member holding an address constant
+   (C11 6.6p9; Linux 6.18 keeps `(unsigned long)&model` in `driver_data`). */
+extern int model;
+struct cpu_id { unsigned short vendor; unsigned short family; unsigned long data; };
+struct cpu_id ids[] = {
+    { 0x0000, 0x0000, (unsigned long)&model },
+    { 0x0001, 0x0002, (unsigned long)&model },
+};
+
+/* --- types_compatible_p: the predicate has to answer about the type, and the
+   answer changes the layout of this object, so a knob that perturbed it would
+   be visible in the emitted section sizes. */
+struct probe {
+    char a[__builtin_types_compatible_p(int, const int) ? 8 : 3];
+    char b[__builtin_types_compatible_p(int *, long *) ? 8 : 5];
+};
+struct probe probe_obj;
+
+/* --- volatile_reduce: a volatile read feeding several independent stores is
+   the interleave candidate the pass budgets lanes for. */
+void lanes(int *restrict out, volatile int *src, int n)
+{
+    int i;
+    for (i = 0; i + 3 < n; i += 4) {
+        int v0 = src[0], v1 = src[1], v2 = src[2], v3 = src[3];
+        out[i + 0] = v0 + 1;
+        out[i + 1] = v1 + 2;
+        out[i + 2] = v2 + 3;
+        out[i + 3] = v3 + 4;
+    }
+}
+
+/* --- a compound literal as a designated element (the third evaluator path). */
+struct node { int *p; long n; };
+extern int target;
+struct node nodes[2] = { [1] = (struct node){ &target, 3 } };
+"""
+
+
+def run(cmd, env=None, **kw):
+    return subprocess.run(cmd, capture_output=True, text=True, env=env, **kw)
+
+
+def main():
+    ccc = os.environ.get("CCC", "target/fastbuild/lccc")
+    if not os.path.exists(ccc):
+        print(f"SKIP: {ccc} not built", file=sys.stderr)
+        return 0
+
+    failures = []
+
+    # (2) every knob is still read by the binary.
+    blob = subprocess.run(["strings", "-a", ccc], capture_output=True).stdout
+    for knob in KNOBS:
+        if knob.encode() not in blob:
+            failures.append(f"{knob}: not present in {ccc} (knob is dead)")
+
+    tmp = tempfile.mkdtemp(prefix="debugknobs.")
+    src = os.path.join(tmp, "fixture.c")
+    with open(src, "w") as f:
+        f.write(FIXTURE)
+
+    base_env = dict(os.environ)
+    for knob in KNOBS:
+        base_env.pop(knob, None)
+
+    for level in LEVELS:
+        default = None
+        for knob in [None] + KNOBS:
+            env = dict(base_env)
+            out = os.path.join(tmp, f"{level.strip('-')}.{knob or 'default'}.s")
+            if knob:
+                env[knob] = "1"
+            proc = run([ccc, "-S", level, "-fno-pic", "-o", out, src], env=env)
+            if proc.returncode != 0:
+                failures.append(
+                    f"{level} {knob or 'default'}: compile failed\n{proc.stderr.strip()}"
+                )
+                break
+            text = open(out, "rb").read()
+            if knob is None:
+                default = text
+            elif default is not None and text != default:
+                failures.append(
+                    f"{level} {knob}=1 changed emitted code (debug knobs must be neutral)"
+                )
+        # the fixture must not be a no-op: the default build has to define the
+        # three decision sites, otherwise the differential above proves nothing.
+        if default is not None:
+            for sym in (b"lanes:", b"ids:", b"nodes:", b"probe_obj:"):
+                if sym not in default:
+                    failures.append(f"{level}: fixture lost {sym.decode()} (differential is vacuous)")
+
+    if failures:
+        print("debug-knob neutrality: FAILED")
+        for f in failures:
+            print("  " + f)
+        return 1
+    print(
+        f"debug-knob neutrality: PASSED ({len(KNOBS)} knobs x {len(LEVELS)} levels, "
+        "identical objects, fixture reaches every decision site)"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tests/regression/check_rmwcc_mem_operand.py b/tests/regression/check_rmwcc_mem_operand.py
new file mode 100755
index 000000000..f7f9a915e
--- /dev/null
+++ b/tests/regression/check_rmwcc_mem_operand.py
@@ -0,0 +1,190 @@
+#!/usr/bin/env python3
+"""Inline-asm memory operands must always carry an address.
+
+WHY THIS GATE EXISTS
+====================
+`AsmOperand::mem_addr` is printed verbatim into the template (`emit_operand_common`
+for the x86 family).  When the resolution step could not compute an address it
+left the string EMPTY and nothing complained, so the assembler received a
+truncated instruction: the operand placeholder vanished together with its comma
+separator, and the only diagnostic was a downstream syntax error that named the
+assembly file -- from which the source construct is not recoverable.
+
+That is exactly how Linux 6.18 stopped building:
+
+    mm/zsmalloc.c: folio_trylock -> folio_test_set_bit_locked
+                -> arch_test_and_set_bit -> GEN_BINARY_RMWcc(...)
+    emitted:      lock  btsq  $0,              <- address operand missing
+    assembler:    "expecting lockable instruction after `lock'"
+
+The address in that call (`folio_flags(folio, 0)`) arrived without a stack slot
+-- a register home or a Copy chain -- and `resolve_memory_operand` only knew how
+to load a slot.  The fix materialises the address through `value_to_reg`, the
+same resolver the register-operand preload path uses, and both x86 backends now
+call `x86_common::assert_memory_operands_resolved` before substitution so the
+failure can never again be silent.
+
+WHAT IS CHECKED
+===============
+For every optimisation level (and a second pass with the kernel's flag set,
+which is where the defect actually appeared):
+
+  1. lccc compiles the TU (no silent truncation can reach the assembler),
+  2. no inline-asm line in the emitted `.s` ends with a comma -- the exact
+     signature of a dropped final operand,
+  3. every `btsq`/`lock add` site that takes a memory operand has an address
+     after the comma, and the expected number of RMWcc sites exists (a shape
+     that silently stopped being emitted would otherwise pass),
+  4. the program's output is byte-identical to GCC 16.2's -- a *wrong* address
+     is as bad as a missing one, and only a run detects it.
+
+USAGE
+    GCC=gcc-16 CCC=target/fastbuild/lccc tests/regression/check_rmwcc_mem_operand.py
+
+EXIT
+    0  every level compiles, every operand has an address, both compilers agree
+    1  a mismatch (the failing level and line are named on stderr)
+    2  the oracle or the compiler is missing
+"""
+
+import argparse
+import os
+import re
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+CASES = Path(__file__).with_name("rmwcc_mem_operand") / "cases.c"
+
+#: The kernel's x86-64 flag set, minus the ones Kbuild probes for.  This is the
+#: configuration in which the defect reproduced; `-O3` plus `-pg -mfentry
+#: -mcmodel=kernel` is where the address value stops being stack-homed.
+KERNEL_FLAGS = [
+    "-O3", "-pg", "-mfentry", "-mno-red-zone", "-mcmodel=kernel", "-fno-PIE",
+    "-fno-stack-protector", "-fno-omit-frame-pointer", "-mno-sse", "-mno-mmx",
+    "-mno-80387", "-falign-jumps=1", "-falign-loops=1",
+]
+
+#: Optimisation levels of the plain pass.  -O0 is included because the operand
+#: resolution path differs (everything is stack-homed there), which is a cheap
+#: way to prove the fix did not special-case one level.
+LEVELS = ["-O0", "-O1", "-O2", "-O3"]
+
+#: A memory operand position after the comma of a two-operand RMW: either a
+#: register-indirect address with optional index/scale, a RIP-relative symbol,
+#: or a bare symbol/absolute address.
+ADDRESS = r"(\(%[a-z0-9]+(?:,%[a-z0-9]+,\d)?\)|[\w.$@]+\(%rip\)|[-\w.$@+]+)"
+
+
+def run(cmd, **kw):
+    return subprocess.run(cmd, capture_output=True, text=True, **kw)
+
+
+def asm_lines(text):
+    """Lines that belong to an inline-asm region, with their 1-based numbers."""
+    inside = False
+    out = []
+    for lineno, line in enumerate(text.splitlines(), 1):
+        stripped = line.strip()
+        if stripped.startswith("#APP"):
+            inside = True
+            continue
+        if stripped.startswith("#NO_APP"):
+            inside = False
+            continue
+        if inside and stripped and not stripped.startswith("#"):
+            out.append((lineno, stripped))
+    return out
+
+
+def check_operands(asm_path, label, failures):
+    text = asm_path.read_text(errors="replace")
+    lines = asm_lines(text)
+    if not lines:
+        failures.append(f"{label}: no inline-asm region in {asm_path.name}")
+        return
+    for lineno, line in lines:
+        # (2) A template line never legitimately ends with a comma or a
+        # separator: that is a placeholder that printed as the empty string.
+        if line.endswith(",") or line.endswith(", "):
+            failures.append(
+                f"{label}:{lineno}: inline-asm operand dropped (line ends with ','): "
+                f"{line!r}")
+        # (3) Every flag-setting RMW that takes two operands must show an
+        # address in the second one.
+        m = re.match(r"(?:lock\s+)?btsq\s+(\S+?),\s*(.*)$", line)
+        if m and not re.match(ADDRESS + r"$", m.group(2).strip()):
+            failures.append(
+                f"{label}:{lineno}: btsq has no usable memory address: {line!r}")
+    rmwcc_sites = sum(1 for _, line in lines if re.search(r"\bbtsq\b", line))
+    if rmwcc_sites < 5:
+        failures.append(
+            f"{label}: only {rmwcc_sites} btsq inline-asm sites were emitted; "
+            "the shapes were optimised away, so the check proves nothing")
+
+
+def compile_and_run(cc, flags, workdir, tag, failures):
+    exe = workdir / f"{tag}.out"
+    out = run([cc, *flags, "-o", str(exe), str(CASES)])
+    if out.returncode != 0:
+        failures.append(f"{tag}: {cc} failed to compile:\n{out.stderr.strip()[:2000]}")
+        return None
+    res = run([str(exe)])
+    if res.returncode != 0:
+        failures.append(f"{tag}: program exited {res.returncode}: {res.stderr.strip()[:400]}")
+        return None
+    return res.stdout
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--verbose", action="store_true")
+    args = ap.parse_args()
+
+    ccc = os.environ.get("CCC", "target/fastbuild/lccc")
+    oracle = os.environ.get("GCC", "gcc-16")
+    for cc in (ccc, oracle):
+        if run([cc, "--version"]).returncode != 0:
+            print(f"check_rmwcc_mem_operand: {cc} is not usable", file=sys.stderr)
+            return 2
+
+    failures = []
+    with tempfile.TemporaryDirectory() as tmp:
+        workdir = Path(tmp)
+        # Oracle output at one level is enough: the program's result depends on
+        # the asm, not on the optimisation level, and requiring three extra GCC
+        # builds would slow the fast gate for no extra signal.
+        expected = compile_and_run(oracle, ["-O2"], workdir, "gcc-O2", failures)
+
+        configs = [(lvl, [lvl]) for lvl in LEVELS] + [("kernel", KERNEL_FLAGS)]
+        for level, flags in configs:
+            asm = workdir / f"lccc-{level.lstrip('-')}.s"
+            tag = f"lccc-{level}"
+            out = run([ccc, *flags, "-S", "-o", str(asm), str(CASES)])
+            if out.returncode != 0:
+                failures.append(
+                    f"{tag}: lccc failed to emit assembly:\n{out.stderr.strip()[:2000]}")
+                continue
+            check_operands(asm, tag, failures)
+            if args.verbose:
+                print(f"{tag}: {len(asm_lines(asm.read_text()))} inline-asm lines checked")
+                # ... and the object must assemble and run to the oracle's answer.
+            got = compile_and_run(ccc, flags, workdir, tag, failures)
+            if expected is not None and got is not None and got != expected:
+                failures.append(
+                    f"{tag}: run-time output differs\n  gcc-16: {expected!r}\n  lccc  : {got!r}")
+
+    if failures:
+        print("check_rmwcc_mem_operand: FAILED", file=sys.stderr)
+        for f in failures:
+            print(f"  {f}", file=sys.stderr)
+        return 1
+    print("check_rmwcc_mem_operand: PASSED "
+          f"({len(LEVELS) + 1} configurations, {oracle} parity, no dropped operand)")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tests/regression/check_seg_pointer_declarators.py b/tests/regression/check_seg_pointer_declarators.py
new file mode 100755
index 000000000..1ff1d8002
--- /dev/null
+++ b/tests/regression/check_seg_pointer_declarators.py
@@ -0,0 +1,191 @@
+#!/usr/bin/env python3
+"""Named address spaces across EVERY declarator path (GCC `__seg_gs`/`__seg_fs`).
+
+WHY THIS GATE EXISTS
+====================
+A named address space is part of a pointer's type, and a nested pointer carries
+it on the level it is written at: `T * __seg_gs *p` is a pointer to a
+%gs-resident `T *`, so `p` and `*p` are ordinary while `**p` reads %gs.  Linux
+6.18 spells its per-CPU machinery exactly that way
+(arch/x86/include/asm/percpu.h: `__percpu_qual` = `__seg_gs`;
+`struct perf_event * __percpu *cpu_events` in kernel/events/hw_breakpoint.c),
+and `CONFIG_USE_X86_SEG_SUPPORT` makes the segment a property of the TYPE, so a
+wrong type is not a cosmetic diagnostic: it selects the segment register a load
+or store uses.
+
+That qualifier was kept by the variable, parameter, member and typedef paths
+and DROPPED by the function return-type path, because the return-type builder
+applied every star with a hardcoded `AddressSpace::Default`.  The visible
+failure was kernel/events/hw_breakpoint.c: `return ERR_PTR_PCPU(err);` — a
+%gs-space `void *` returned as `struct perf_event * __percpu *` — rejected as
+"incompatible address space in pointer conversion ... at pointer level 1"
+while the same conversion compiled inside a parameter.  The fix is one
+`pointee_space_before` lookup shared with `build_full_ctype_with_base`, so no
+path can invent its own rule again.
+
+The type-NAME parser (`__builtin_types_compatible_p(pe * __seg_gs *, ...)`) had
+the second half of the same defect: its qualifier loop did not know the
+`__seg_gs`/`__seg_fs` keywords at all, so the type-name could not be parsed.
+
+WHAT IS CHECKED
+===============
+Every row is a small translation unit; the ORACLE's verdict (GCC 16.2) is the
+expected value, so a row that drifts in either direction fails the gate.  The
+rows are paired: for every "this must be rejected" (a conversion that really
+changes the space) there is a "this must be accepted" (the kernel's shapes).
+A verdict alone cannot show that the space *survives* on an accepted row, so
+each accepting row also compiles with the space-checking probes enabled and
+runs its function; a lost space would surface as a rejected cast, an accepted
+cross-space conversion, or a wrong value.
+
+Also compared: `__builtin_types_compatible_p` answers for segmented type-names,
+against the oracle's numbers (a space-insensitive comparison answers 1 where
+GCC answers 0 -- this is the `T * __seg_gs *` vs `T **` row).
+
+USAGE
+    GCC=gcc-16 CCC=target/fastbuild/lccc \
+        tests/regression/check_seg_pointer_declarators.py [--verbose]
+
+EXIT STATUS
+    0  every verdict, and every `__builtin_types_compatible_p` answer, matches
+    1  a mismatch (the failing row is named)
+    2  the oracle or the compiler is missing or is not the pinned version
+"""
+
+import argparse
+import os
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+CASES = Path(__file__).with_name("seg_pointer_declarators") / "cases.tsv"
+
+#: Type-name compatibility probes: `(kind, left, right)`, where `kind` is the
+#: spelling inside `__builtin_types_compatible_p`.  The oracle's answers are the
+#: expected values, so a row cannot go stale silently.
+COMPAT_NAMES = [
+    ("pe * __seg_gs *", "pe * __seg_gs *"),
+    ("pe * __seg_gs *", "pe **"),
+    ("pe * __seg_gs *", "pe * __seg_fs *"),
+    ("void __seg_gs *", "void __seg_gs *"),
+    ("void __seg_gs *", "void *"),
+    ("pe * __seg_gs *", "pe * __seg_gs **"),
+    ("pe __seg_gs *", "pe __seg_gs const *"),
+]
+
+PRELUDE = """#include <stdio.h>
+"""
+
+
+def run(cmd):
+    return subprocess.run(cmd, capture_output=True, text=True)
+
+
+def require_version(cc, pinned):
+    out = run([cc, "--version"])
+    if out.returncode != 0:
+        raise SystemExit(f"gate: {cc}: not usable ({out.stderr.strip()[:80]})")
+    line = out.stdout.splitlines()[0]
+    if pinned not in line:
+        raise SystemExit(f"gate: {cc}: expected {pinned}, got {line}")
+
+
+def parse_cases(path):
+    rows = []
+    for lineno, raw in enumerate(path.read_text().splitlines(), 1):
+        if not raw.strip() or raw.lstrip().startswith("#"):
+            continue
+        fields = raw.split("\t")
+        if lineno == 1 and fields[0] == "id":
+            continue
+        if len(fields) != 3:
+            raise SystemExit(f"{path}:{lineno}: expected 3 tab fields, got {len(fields)}")
+        rows.append((fields[0], fields[1], fields[2]))
+    return rows
+
+
+def compat_program():
+    body = PRELUDE + "typedef struct { int x; } pe;\nint main(void)\n{\n    printf("
+    body += '"' + " ".join(["%d"] * len(COMPAT_NAMES)) + '\\n"'
+    body += ",\n"
+    body += ",\n".join(
+        f"        __builtin_types_compatible_p({left}, {right})"
+        for left, right in COMPAT_NAMES
+    )
+    body += ");\n    return 0;\n}\n"
+    return body
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--compiler", default=os.environ.get("CCC", str(ROOT / "target/fastbuild/lccc")))
+    ap.add_argument("--gcc", default=os.environ.get("GCC", "gcc-16"))
+    ap.add_argument("--verbose", action="store_true")
+    args = ap.parse_args()
+
+    if not Path(args.compiler).exists():
+        raise SystemExit(f"gate: compiler not found: {args.compiler}")
+    require_version(args.gcc, "16.2")
+
+    rows = parse_cases(CASES)
+    failures = []
+    with tempfile.TemporaryDirectory() as tmp:
+        tmp = Path(tmp)
+
+        for rid, expect, payload in rows:
+            src = tmp / f"{rid}.c"
+            src.write_text(PRELUDE + payload + "\n")
+            verdict = {}
+            for name, cc in (("oracle", args.gcc), ("lccc", args.compiler)):
+                res = run([cc, "-std=gnu11", "-c", "-w", "-o", str(tmp / f"{rid}.{name}.o"), str(src)])
+                verdict[name] = res.returncode == 0
+                if not verdict[name] and args.verbose:
+                    print(f"  {rid}: {name} rejected: {res.stderr.splitlines()[:1]}")
+            if verdict["oracle"] != (expect == "accept"):
+                raise SystemExit(
+                    f"gate: row {rid}: cases.tsv says {expect}, GCC says "
+                    f"{'accept' if verdict['oracle'] else 'reject'} — fix the row"
+                )
+            if verdict["lccc"] != verdict["oracle"]:
+                failures.append(
+                    f"{rid}: lccc {'accepts' if verdict['lccc'] else 'rejects'}, "
+                    f"oracle {'accepts' if verdict['oracle'] else 'rejects'}"
+                )
+
+        # `__builtin_types_compatible_p` over segmented type-names: the answers
+        # must equal the oracle's, and the type-name must parse at all.
+        src = tmp / "compat.c"
+        src.write_text(compat_program())
+        answers = {}
+        for name, cc in (("oracle", args.gcc), ("lccc", args.compiler)):
+            exe = tmp / f"compat.{name}"
+            build = run([cc, "-w", "-std=gnu11", str(src), "-o", str(exe)])
+            if build.returncode != 0:
+                failures.append(f"compat: {name} failed to build: {build.stderr.strip()[:160]}")
+                continue
+            got = run([str(exe)])
+            answers[name] = got.stdout.strip()
+        if len(answers) == 2 and answers["oracle"] != answers["lccc"]:
+            failures.append(
+                "compat: __builtin_types_compatible_p answers differ\n"
+                f"    oracle: {answers['oracle']}\n"
+                f"    lccc:   {answers['lccc']}\n"
+                f"    rows:   {COMPAT_NAMES}"
+            )
+
+    if failures:
+        print("check_seg_pointer_declarators: FAILED", file=sys.stderr)
+        for f in failures:
+            print(f"  {f}", file=sys.stderr)
+        return 1
+    print(
+        f"check_seg_pointer_declarators: PASSED ({len(rows)} verdict rows + "
+        f"{len(COMPAT_NAMES)} type-name rows vs GCC 16)"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tests/regression/check_types_compatible_p.py b/tests/regression/check_types_compatible_p.py
new file mode 100755
index 000000000..de893e553
--- /dev/null
+++ b/tests/regression/check_types_compatible_p.py
@@ -0,0 +1,193 @@
+#!/usr/bin/env python3
+"""`__builtin_types_compatible_p` — type identity, not type spelling.
+
+WHY THIS GATE EXISTS
+====================
+Two types are compatible when C says they are the same type after removing
+top-level qualification (C11 6.2.7).  The predicate therefore has to answer
+about the *type*, and a compiler whose type builder keeps a spelling detail
+(parameter names, a typedef's name, a `typeof`'s origin) in the type answers
+"incompatible" for identical types.  That is not a cosmetic bug: Linux 6.18
+asserts its own invariants with it —
+
+    arch/x86/kernel/irq.c:  static_assert(__builtin_types_compatible_p(
+                                __typeof__(&func), void *(void *)));
+
+— so a wrong answer is a kernel build failure, and a *right* answer for the
+wrong reason hides a type-model defect.  This gate pins the answers against
+GCC 16.2 for the shapes the kernel and the C standard actually use: function
+type identity (parameter NAMES are not part of the type), bare function types,
+function-pointer identity through typedef/member/`typeof`/cast, address spaces
+per pointer level, arrays vs pointers, and record tags.
+
+HOW A ROW IS CHECKED
+====================
+Each row is `<prefix declarations> + int main` printing
+`__builtin_types_compatible_p(<left>, <right>)`, compiled and RUN by both
+compilers; the printed answers must be equal to each other and to the row's
+`expect`.  Compiling and running (rather than reading a diagnostic) is what
+makes an answer that is right-by-accident visible: the answer has to survive
+lowering, not just sema.
+
+`known_divergences.tsv` documents every place where the answer is knowingly
+NOT the oracle's.  It is checked in BOTH directions: the row must still
+diverge exactly as recorded (lccc's answer and the oracle's), because a
+divergence that quietly starts passing means the row is stale and the
+documentation lies — that fails the gate too.
+
+USAGE
+    GCC=gcc-16 CCC=target/fastbuild/lccc \
+        tests/regression/check_types_compatible_p.py [--verbose]
+
+EXIT STATUS
+    0  every case row matches the oracle, every divergence still diverges
+    1  a mismatch, or a divergence went stale
+    2  the oracle or the compiler is missing or is not the pinned version
+"""
+
+import argparse
+import os
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+HERE = Path(__file__).with_name("types_compatible_p")
+
+#: Spellings a row may reference instead of repeating a long declarator.
+#: `CC_*` names are substituted into the row's text before it is compiled.
+MACROS = {
+    # `void (*)(int)` reached through a struct member, a typeof and a cast.
+    "CC_TYPEOF_MEMBER": "typeof(((struct s *)0)->f)",
+    # A typedef'd struct type reached through a member access.
+    "CC_TYPEOF_F": "typeof(f)",
+    "CC_TYPEOF_P": "typeof(p)",
+}
+
+PRELUDE = """#include <stdio.h>
+"""
+
+
+def run(cmd):
+    return subprocess.run(cmd, capture_output=True, text=True)
+
+
+def require_version(cc, pinned):
+    out = run([cc, "--version"])
+    if out.returncode != 0:
+        raise SystemExit(f"gate: {cc}: not usable ({out.stderr.strip()[:80]})")
+    line = out.stdout.splitlines()[0]
+    if pinned not in line:
+        raise SystemExit(f"gate: {cc}: expected {pinned}, got {line}")
+
+
+def parse_rows(path, width):
+    rows = []
+    for lineno, raw in enumerate(path.read_text().splitlines(), 1):
+        if not raw.strip() or raw.lstrip().startswith("#"):
+            continue
+        fields = raw.split("\t")
+        if lineno == 1 and fields[0] == "id":
+            continue
+        if len(fields) != width:
+            raise SystemExit(f"{path}:{lineno}: expected {width} tab fields, got {len(fields)}")
+        rows.append(fields)
+    return rows
+
+
+def expand(text):
+    for name, spelling in MACROS.items():
+        text = text.replace(name, spelling)
+    return text
+
+
+def answer(cc, tmp, rid, prefix, left, right, extra_decls=""):
+    """Compile and run one row; return the printed answer or raise."""
+    src = tmp / f"{rid}.c"
+    decls = "" if prefix.strip() == "-" else expand(prefix) + "\n"
+    body = PRELUDE + expand(extra_decls) + decls
+    if decls:
+        body += "\n"
+    body += (
+        "int main(void)\n{\n    printf(\"%d\\n\",\n        "
+        f"__builtin_types_compatible_p({expand(left)}, {expand(right)}));\n"
+        "    return 0;\n}\n"
+    )
+    src.write_text(body)
+    exe = tmp / f"{rid}.bin"
+    build = run([cc, "-std=gnu11", "-w", str(src), "-o", str(exe)])
+    if build.returncode != 0:
+        return ("BUILD-FAILED", build.stderr.strip().splitlines()[:2])
+    out = run([str(exe)])
+    if out.returncode != 0:
+        return ("RUN-FAILED", out.stderr.strip().splitlines()[:2])
+    return (out.stdout.strip(), None)
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--compiler", default=os.environ.get("CCC", str(ROOT / "target/fastbuild/lccc")))
+    ap.add_argument("--gcc", default=os.environ.get("GCC", "gcc-16"))
+    ap.add_argument("--verbose", action="store_true")
+    args = ap.parse_args()
+
+    if not Path(args.compiler).exists():
+        raise SystemExit(f"gate: compiler not found: {args.compiler}")
+    require_version(args.gcc, "16.2")
+
+    cases = parse_rows(HERE / "cases.tsv", 5)
+    divergences = parse_rows(HERE / "known_divergences.tsv", 9)
+    failures = []
+    with tempfile.TemporaryDirectory() as tmp:
+        tmp = Path(tmp)
+
+        for rid, expect, prefix, left, right in cases:
+            got = {}
+            for name, cc in (("oracle", args.gcc), ("lccc", args.compiler)):
+                value, err = answer(cc, tmp, f"{rid}.{name}", prefix, left, right)
+                if err is not None:
+                    failures.append(f"{rid}: {name} {value}: {err}")
+                    got[name] = None
+                else:
+                    got[name] = value
+            if got.get("oracle") is None or got.get("lccc") is None:
+                continue
+            if got["oracle"] != expect:
+                raise SystemExit(
+                    f"gate: row {rid}: cases.tsv says {expect}, GCC 16 says {got['oracle']} — fix the row"
+                )
+            if got["lccc"] != got["oracle"]:
+                failures.append(
+                    f"{rid}: lccc says {got['lccc']}, GCC says {got['oracle']} "
+                    f"for `{left}` vs `{right}`"
+                )
+            elif args.verbose:
+                print(f"  {rid}: {got['lccc']} (both)")
+
+        for rid, prefix, left, right, want_lccc, want_oracle, _cause, _impact, _fix in divergences:
+            for name, cc, want in (("oracle", args.gcc, want_oracle), ("lccc", args.compiler, want_lccc)):
+                value, err = answer(cc, tmp, f"{rid}.{name}", prefix, left, right)
+                if err is not None:
+                    failures.append(f"{rid}: {name} {value}: {err}")
+                    continue
+                if value != want:
+                    failures.append(
+                        f"{rid}: {name} now answers {value}, known_divergences.tsv records {want} "
+                        "— the row is stale: fix it or delete it"
+                    )
+
+    if failures:
+        print("check_types_compatible_p: FAILED", file=sys.stderr)
+        for f in failures:
+            print(f"  {f}", file=sys.stderr)
+        return 1
+    print(
+        f"check_types_compatible_p: PASSED ({len(cases)} rows vs GCC 16; "
+        f"{len(divergences)} tracked divergences still open)"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
