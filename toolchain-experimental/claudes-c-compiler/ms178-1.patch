+            if let Some(&to) = label_to_idx.get(&label) {
+                if !seen[to] {
+                    seen[to] = true;
+                    stack.push(to);
+                }
+            }
+        };
+        for_each_target(&block.terminator, |l| go(l, &mut stack));
+        for inst in &block.instructions {
+            if let Instruction::InlineAsm { goto_labels, .. } = inst {
+                for (_, label) in goto_labels {
+                    go(*label, &mut stack);
+                }
+            }
+        }
+    }
+    seen
+}
