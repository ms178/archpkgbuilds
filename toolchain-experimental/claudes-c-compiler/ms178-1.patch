+        ("mwait", [(0, w0), (1, w1)]) if w0 == w1 => Ok(false),
+        ("mwaitx", [(0, w0), (1, w1), (3, w2)]) if w0 == w1 && w1 == w2 => Ok(false),
+        _ => Err(type_err()),
     }
 }
 
