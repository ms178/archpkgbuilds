+            cond: Operand::Const(IrConst::I64(1)),
+            true_label: BlockId(7),
+            false_label: BlockId(8),
+        };
+        retarget_edge(&mut term, BlockId(7), BlockId(99));
+        match term {
+            Terminator::CondBranch {
+                true_label,
+                false_label,
+                ..
+            } => {
+                assert_eq!(true_label, BlockId(99));
