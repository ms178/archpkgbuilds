+
+    // ── W5. NEW: encode_negs accepts SP/WSP in any operand position ───────
+    #[test]
+    fn negs_rejects_sp_wsp_in_any_position(
+        rd in 0u32..=30, rm in 0u32..=30, pos in 0u32..2u32, vi in 0u32..=1u32,
+    ) {
