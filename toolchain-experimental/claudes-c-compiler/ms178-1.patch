index 00000000..d59c1192
--- /dev/null
+++ b/tests/bench/k_crc32_slice8.c
@@ -0,0 +1,65 @@
+/* zlib-ng / gzip CRC32 slicing-by-8 (generic path, crc32_braid algorithm
+ * shape): 8 table lookups + XORs per 8 bytes, tables built at setup from the
+ * reflected IEEE polynomial so no 8 KiB literal table rides in the source.
+ * Exercises load-port pressure, XOR chains, unaligned 64-bit loads (done as
+ * memcpy so the compiler may fold them) and table-cache locality -- the
+ * non-SIMD baseline every PCLMULQDQ version is measured against. */
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#include "bench.h"
+
+#define N 8192
+static unsigned char buf[N];
+static uint32_t tab[8][256];
+
+void bench_setup(void) {
+    for (int i = 0; i < N; i++) buf[i] = (unsigned char)(i * 167 + (i >> 3) + 11);
+    for (uint32_t n = 0; n < 256; n++) {
+        uint32_t c = n;
+        for (int k = 0; k < 8; k++) c = (c & 1u) ? (0xEDB88320u ^ (c >> 1)) : (c >> 1);
+        tab[0][n] = c;
+    }
+    for (int t = 1; t < 8; t++)
+        for (int n = 0; n < 256; n++) {
+            uint32_t c = tab[t - 1][n];
+            tab[t][n] = tab[0][c & 0xffu] ^ (c >> 8);
+        }
+}
+
+static uint32_t crc32_slice8(uint32_t crc, const unsigned char *b, size_t len) {
+    crc = ~crc;
+    size_t i = 0;
+    for (; i + 8 <= len; i += 8) {
+        uint64_t w;
+        memcpy(&w, b + i, 8);
+        uint32_t lo = (uint32_t)w ^ crc;
+        uint32_t hi = (uint32_t)(w >> 32);
+        crc = tab[7][lo & 0xffu] ^ tab[6][(lo >> 8) & 0xffu]
+            ^ tab[5][(lo >> 16) & 0xffu] ^ tab[4][lo >> 24]
+            ^ tab[3][hi & 0xffu] ^ tab[2][(hi >> 8) & 0xffu]
+            ^ tab[1][(hi >> 16) & 0xffu] ^ tab[0][hi >> 24];
+    }
+    for (; i < len; i++) crc = tab[0][(crc ^ b[i]) & 0xffu] ^ (crc >> 8);
+    return ~crc;
+}
+
+int bench_verify(void) {
+    /* CRC-32/ISO-HDLC canonical vectors: empty input, the universal check
+     * string, a 32-byte zero run, and the pangram.  "123456789" (9 bytes)
+     * exercises one slicing step plus the scalar tail.  A broken table
+     * build or a mis-transcribed polynomial is deterministic, so every
+     * compiler arm would agree on the wrong bench checksum -- only an
+     * absolute oracle like this catches it. */
+    static const unsigned char zeros[32] = {0};
+    if (crc32_slice8(0, zeros, 0) != 0x00000000u) return 1;
+    if (crc32_slice8(0, (const unsigned char *)"123456789", 9) != 0xCBF43926u)
+        return 2;
+    if (crc32_slice8(0, zeros, sizeof(zeros)) != 0x190A55ADu) return 3;
+    if (crc32_slice8(0, (const unsigned char *)"The quick brown fox jumps over the lazy dog", 43)
+            != 0x414FA339u)
+        return 4;
+    return 0;
+}
+
+unsigned long long bench_run(void) { return crc32_slice8(0, buf, N); }
diff --git a/tests/bench/k_jhash.c b/tests/bench/k_jhash.c
new file mode 100644
index 00000000..1916f920
--- /dev/null
+++ b/tests/bench/k_jhash.c
@@ -0,0 +1,63 @@
+/* Linux kernel jhash (Jenkins hash, include/linux/jhash.h algorithm shape):
+ * the __jhash_mix triple of subtract/xor/shift rounds over 12-byte blocks.
+ * Pure dependent ALU chains with no memory traffic in the hot loop after the
+ * loads: the purest possible latency-chain / dual-issue probe, and a hash
+ * that really runs in networking and dcache paths.  Modelled on the public
+ * Jenkins lookup3 mixing function; finalisation truncated to the mix so the
+ * timed region is the loop, not the tail switch. */
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#include "bench.h"
+
+#define N 4096
+static unsigned char buf[N];
+
+void bench_setup(void) {
+    uint32_t s = 0xDEADBEEFu;
+    for (int i = 0; i < N; i++) { s = s * 1103515245u + 12345u; buf[i] = (unsigned char)(s >> 16); }
+}
+
+#define MIX(a, b, c) do { \
+    a -= b; a -= c; a ^= (c >> 13); \
+    b -= c; b -= a; b ^= (a << 8);  \
+    c -= a; c -= b; c ^= (b >> 13); \
+    a -= b; a -= c; a ^= (c >> 12); \
+    b -= c; b -= a; b ^= (a << 16); \
+    c -= a; c -= b; c ^= (b >> 5);  \
+    a -= b; a -= c; a ^= (c >> 3);  \
+    b -= c; b -= a; b ^= (a << 10); \
+    c -= a; c -= b; c ^= (b >> 15); \
+} while (0)
+
+static uint32_t jhash_blocks(const unsigned char *b, size_t len, uint32_t seed) {
+    uint32_t a = 0x9E3779B9u, bb = 0x9E3779B9u, c = seed;
+    size_t i = 0;
+    for (; i + 12 <= len; i += 12) {
+        uint32_t x, y, z;
+        memcpy(&x, b + i, 4); memcpy(&y, b + i + 4, 4); memcpy(&z, b + i + 8, 4);
+        a += x; bb += y; c += z;
+        MIX(a, bb, c);
+    }
+    c += (uint32_t)len;
+    for (; i < len; i++) { a += b[i]; MIX(a, bb, c); }
+    return c;
+}
+
+int bench_verify(void) {
+    /* Expected values computed from an independent transliteration of the
+     * MIX macro (Python model, distinct implementation): a swapped shift
+     * count in either this macro or a future edit diverges immediately.
+     * Note this kernel's per-byte tail handling is its own shape, not the
+     * kernel's packed-tail jhash, so published lookup3 vectors do not
+     * apply -- the dual implementation is the oracle. */
+    static const unsigned char zeros[12] = {0};
+    unsigned char range24[24];
+    for (int i = 0; i < 24; i++) range24[i] = (unsigned char)i;
+    if (jhash_blocks(zeros, 12, 0) != 0xBD49D119u) return 1;
+    if (jhash_blocks(range24, 24, 0x1234u) != 0x07C98B7Fu) return 2;
+    if (jhash_blocks(zeros, 0, 0x1234u) != 0x1234u) return 3;
+    return 0;
+}
+
+unsigned long long bench_run(void) { return jhash_blocks(buf, N, 0x1234u); }
diff --git a/tests/bench/k_memmem_horspool.c b/tests/bench/k_memmem_horspool.c
new file mode 100644
index 00000000..2c472c32
--- /dev/null
+++ b/tests/bench/k_memmem_horspool.c
@@ -0,0 +1,57 @@
+/* glibc memmem/strstr family shape: Boyer-Moore-Horspool substring search.
+ * Skip-table driven scan with a short verification loop on candidate hits --
+ * the algorithmic core glibc's two-way implementation also reduces to on
+ * typical inputs.  Exercises skip-table loads, data-dependent loop exits,
+ * and the inner byte-compare loop; needles are placed so both the skip path
+ * and the verify path stay hot.  Returns match offsets folded into a
+ * checksum so a search that finds less cannot look faster. */
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#include "bench.h"
+
+#define N 32768
+static unsigned char hay[N];
+static const unsigned char needle[] = "the quick brown fox";
+#define NLEN (sizeof(needle) - 1)
+
+void bench_setup(void) {
+    static const char text[] =
+        "pack my box with five dozen liquor jugs. how vexingly quick daft "
+        "zebras jump! the five boxing wizards jump quickly. ";
+    size_t tl = sizeof(text) - 1;
+    for (size_t i = 0; i < N; i++) hay[i] = (unsigned char)text[i % tl];
+    /* Plant true matches at irregular intervals. */
+    for (size_t at = 1000; at + NLEN < N; at += 2999) memcpy(hay + at, needle, NLEN);
+}
+
+static uint64_t horspool_all(const unsigned char *h, size_t hn,
+                             const unsigned char *nd, size_t nn) {
+    size_t skip[256];
+    for (int i = 0; i < 256; i++) skip[i] = nn;
+    for (size_t i = 0; i + 1 < nn; i++) skip[nd[i]] = nn - 1 - i;
+    uint64_t acc = 0, hits = 0;
+    size_t i = 0;
+    while (i + nn <= hn) {
+        size_t j = nn;
+        while (j > 0 && h[i + j - 1] == nd[j - 1]) j--;
+        if (j == 0) { acc += i; hits++; i += 1; }
+        else i += skip[h[i + nn - 1]];
+    }
+    return acc * 131u + hits;
+}
+
+int bench_verify(void) {
+    /* Independent naive O(n*m) search over the same haystack: Horspool's
+     * skip table must find exactly the same offsets.  Two different
+     * algorithms agreeing is the oracle; a skip table with an off-by-one
+     * still produces a self-consistent bench checksum. */
+    uint64_t acc = 0, hits = 0;
+    for (size_t i = 0; i + NLEN <= N; i++) {
+        if (memcmp(hay + i, needle, NLEN) == 0) { acc += i; hits++; }
+    }
+    if (hits == 0) return 1;  /* setup plants matches: zero means stale */
+    return horspool_all(hay, N, needle, NLEN) != acc * 131u + hits;
+}
+
+unsigned long long bench_run(void) { return horspool_all(hay, N, needle, NLEN); }
diff --git a/tests/bench/k_sqlite_varint_scan.c b/tests/bench/k_sqlite_varint_scan.c
new file mode 100644
index 00000000..72a5a30c
--- /dev/null
+++ b/tests/bench/k_sqlite_varint_scan.c
@@ -0,0 +1,117 @@
+/* SQLite record scan: sqlite3GetVarint32-style header walking.
+ * A synthetic page of records, each header a chain of 7-bit varints (length
+ * prefix + serial types); the kernel walks every record, decoding varints
+ * and accumulating payload lengths.  The varint loop is SQLite's hottest
+ * small loop shape: unpredictable continuation bit, short trip counts,
+ * byte loads feeding a shift-or accumulation chain.  Exercises loop peeling
+ * (the 1-byte fast path dominates), branch layout and byte-load folding. */
+#include <stddef.h>
+#include <stdint.h>
+#include "bench.h"
+
+#define N 16384
+static unsigned char page[N];
+
+static size_t put_varint(unsigned char *p, uint32_t v) {
+    unsigned char tmp[5];
+    int n = 0;
+    do { tmp[n++] = (unsigned char)(v & 0x7fu); v >>= 7; } while (v);
+    size_t out = 0;
+    for (int i = n - 1; i >= 0; i--)
+        p[out++] = (unsigned char)(tmp[i] | (i ? 0x80u : 0u));
+    return out;
+}
+
+void bench_setup(void) {
+    size_t i = 0;
+    uint32_t s = 0xABCD1234u;
+    while (i + 64 < N) {
+        s = s * 22695477u + 1u;
+        uint32_t ncols = 1u + ((s >> 8) % 6u);
+        size_t hdr_at = i;
+        i += 1; /* placeholder for header length */
+        uint32_t payload = 0;
+        for (uint32_t cix = 0; cix < ncols; cix++) {
+            s = s * 22695477u + 1u;
+            uint32_t serial = (s >> 11) % 128u;         /* 1-2 byte varints, payload <= 57 B */
+            if ((s & 0x3ffu) == 0) serial += 200u;      /* rare 2-byte varint, longer blob */
+            i += put_varint(page + i, serial);
+            payload += (serial >= 13u && (serial & 1u)) ? (serial - 13u) / 2u
+                       : (serial >= 12u) ? (serial - 12u) / 2u : serial % 9u;
+        }
+        page[hdr_at] = (unsigned char)(i - hdr_at);
+        for (uint32_t k = 0; k < payload && i < N; k++) page[i++] = (unsigned char)k;
+    }
+    while (i < N) page[i++] = 0;
+}
+
+/* Bounded decode: bytes at index >= avail read as 0 (terminator), so a
+ * varint starting within the final 4 bytes of the page can never read out
+ * of bounds.  The 1-byte fast path (the overwhelmingly common case, and
+ * the shape this kernel exists to measure) is untouched; the bound checks
+ * live only on the already-slow continuation paths.  The unbounded
+ * original was safe for this setup's data by a construction margin
+ * (records start >= 64 bytes before the end and the tail is zero-filled),
+ * but "safe by margin" rots the first time somebody edits setup. */
+static uint32_t get_varint32(const unsigned char *p, size_t avail, uint32_t *out) {
+    uint32_t v = p[0];
+    if (!(v & 0x80u)) { *out = v; return 1; }
+    uint32_t b1 = avail > 1 ? p[1] : 0u;
+    v = (v & 0x7fu) << 7; v |= b1 & 0x7fu;
+    if (!(b1 & 0x80u)) { *out = v; return 2; }
+    uint32_t n = 2;
+    for (;;) {
+        uint32_t bn = (size_t)n < avail ? p[n] : 0u;
+        v = (v << 7) | (bn & 0x7fu);
+        n++;
+        if (!(bn & 0x80u) || n >= 5) break;
+    }
+    *out = v;
+    return n;
+}
+
+static uint64_t scan_records(const unsigned char *p, size_t len) {
+    uint64_t acc = 0;
+    size_t i = 0;
+    while (i < len && p[i]) {
+        uint32_t hdr_len = p[i];
+        if (hdr_len < 2 || i + hdr_len > len) break;
+        size_t j = i + 1, hdr_end = i + hdr_len;
+        uint32_t payload = 0;
+        while (j < hdr_end) {
+            uint32_t serial;
+            j += get_varint32(p + j, len - j, &serial);
+            acc += serial;
+            payload += (serial >= 13u && (serial & 1u)) ? (serial - 13u) / 2u
+                       : (serial >= 12u) ? (serial - 12u) / 2u : serial % 9u;
+        }
+        i = hdr_end + payload;
+    }
+    return acc;
+}
+
+int bench_verify(void) {
+    /* Encode/decode round-trip over the varint width boundaries (the
+     * 7-bit group edges 127/128, 16383/16384, 2^21, 2^28, UINT32_MAX):
+     * setup and scan share put/get, so a symmetric transcription bug in
+     * both would cancel out in the bench checksum but not here if the
+     * byte count is also asserted. */
+    static const uint32_t vals[] = {0u, 1u, 127u, 128u, 300u, 16383u, 16384u,
+                                    2097151u, 2097152u, 268435455u, 268435456u,
+                                    4294967295u};
+    unsigned char tmp[8];
+    for (size_t i = 0; i < sizeof(vals) / sizeof(vals[0]); i++) {
+        size_t wrote = put_varint(tmp, vals[i]);
+        uint32_t back = 0;
+        uint32_t read = get_varint32(tmp, sizeof(tmp), &back);
+        if (back != vals[i] || (size_t)read != wrote) return 1;
+    }
+    /* Truncated tail: a continuation byte with nothing after it must
+     * terminate (bounded read), not walk off the buffer. */
+    tmp[0] = 0x80u;
+    uint32_t back = 0;
+    if (get_varint32(tmp, 1, &back) != 2u || back != 0u) return 2;
+    return 0;
+}
+
+unsigned long long bench_run(void) { return scan_records(page, N); }
diff --git a/tests/bench/k_utf8_validate.c b/tests/bench/k_utf8_validate.c
new file mode 100644
index 00000000..dd0300c3
--- /dev/null
+++ b/tests/bench/k_utf8_validate.c
@@ -0,0 +1,81 @@
+/* expat/glibc-style UTF-8 well-formedness scan: the byte-classification
+ * core of XmlUtf8Convert / mbrtowc fast paths.  Mostly-ASCII input with
+ * periodic 2/3/4-byte sequences: a data-dependent branch ladder over
+ * lead-byte ranges plus continuation-shape checks.  Exercises branch
+ * prediction friendliness, range-test lowering ((c-0xC2) <= 0x1D style),
+ * and short-vector scan opportunities on the ASCII runs. Returns a
+ * checksum over code points so a miscompiled arm cannot win by scanning
+ * less.
+ *
+ * Precision about what this is NOT: a strict RFC 3629 validator.  It
+ * checks lead-byte ranges and continuation shapes, but not the second-
+ * byte subranges that reject overlong forms (E0: A0-BF, F0: 90-BF),
+ * UTF-16 surrogates (ED: 80-9F) or values above U+10FFFF (F4: 80-8F).
+ * That is the same coarse shape as the first-pass scanners in real XML
+ * pipelines (fine classification happens later, on demand), and the
+ * generated input contains none of those cases -- but do not cite this
+ * kernel as "UTF-8 validation" without the qualifier. */
+#include <stddef.h>
+#include <stdint.h>
+#include "bench.h"
+
+#define N 8192
+static unsigned char buf[N];
+
+void bench_setup(void) {
+    size_t i = 0;
+    uint32_t s = 0x12345678u;
+    while (i + 4 < N) {
+        s = s * 1664525u + 1013904223u;
+        uint32_t r = s >> 24;
+        if (r < 200) { buf[i++] = (unsigned char)('a' + (r % 26u)); }
+        else if (r < 225) { buf[i++] = 0xC3; buf[i++] = 0xA9; }                    /* é */
+        else if (r < 243) { buf[i++] = 0xE2; buf[i++] = 0x82; buf[i++] = 0xAC; }   /* € */
+        else { buf[i++] = 0xF0; buf[i++] = 0x9F; buf[i++] = 0x98; buf[i++] = 0x80; } /* 😀 */
+    }
+    while (i < N) buf[i++] = 'x';
+}
+
+static uint64_t utf8_scan(const unsigned char *b, size_t len) {
+    uint64_t acc = 0, bad = 0;
+    size_t i = 0;
+    while (i < len) {
+        uint32_t c = b[i];
+        if (c < 0x80u) { acc += c; i += 1; continue; }
+        if (c >= 0xC2u && c <= 0xDFu && i + 1 < len && (b[i + 1] & 0xC0u) == 0x80u) {
+            acc += ((c & 0x1Fu) << 6) | (b[i + 1] & 0x3Fu); i += 2; continue;
+        }
+        if (c >= 0xE0u && c <= 0xEFu && i + 2 < len
+                && (b[i + 1] & 0xC0u) == 0x80u && (b[i + 2] & 0xC0u) == 0x80u) {
+            acc += ((c & 0x0Fu) << 12) | ((b[i + 1] & 0x3Fu) << 6) | (b[i + 2] & 0x3Fu);
+            i += 3; continue;
+        }
+        if (c >= 0xF0u && c <= 0xF4u && i + 3 < len
+                && (b[i + 1] & 0xC0u) == 0x80u && (b[i + 2] & 0xC0u) == 0x80u
+                && (b[i + 3] & 0xC0u) == 0x80u) {
+            acc += ((c & 0x07u) << 18) | ((b[i + 1] & 0x3Fu) << 12)
+                 | ((b[i + 2] & 0x3Fu) << 6) | (b[i + 3] & 0x3Fu);
+            i += 4; continue;
+        }
+        bad++; i += 1;
+    }
+    return acc * 131u + bad;
+}
+
+int bench_verify(void) {
+    /* Code-point accumulation over one sequence of each length, plus the
+     * bad-byte accounting: "a" + U+00E9 + U+20AC + U+1F600 sums to
+     * 97 + 233 + 8364 + 128512 = 137206, folded as acc*131 + bad. */
+    static const unsigned char seq[] = {
+        'a', 0xC3, 0xA9, 0xE2, 0x82, 0xAC, 0xF0, 0x9F, 0x98, 0x80 };
+    if (utf8_scan(seq, sizeof(seq)) != 137206u * 131u) return 1;
+    /* Lone continuation byte and a truncated 3-byte lead are bad bytes,
+     * never silently accepted sequences. */
+    static const unsigned char bad1[] = { 0x80 };
+    static const unsigned char bad2[] = { 'x', 0xE2, 0x82 };
+    if (utf8_scan(bad1, sizeof(bad1)) != 1u) return 2;
+    if (utf8_scan(bad2, sizeof(bad2)) != (uint64_t)'x' * 131u + 2u) return 3;
+    return 0;
+}
+
+unsigned long long bench_run(void) { return utf8_scan(buf, N); }
