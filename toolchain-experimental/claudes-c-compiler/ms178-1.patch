-        let mut module = crate::ir::module::IrModule::new();
-        let mut f = IrFunction::new("memcpy".to_string(), IrType::Ptr, Vec::new(), false);
-        f.is_declaration = true;
-        module.functions.push(f);
-        module
-            .asm_labels
-            .insert("memcpy".to_string(), "memcpy".to_string());
