diff --git a/tests/regression/loop_idiom_extern_alias/defs.c b/tests/regression/loop_idiom_extern_alias/defs.c
new file mode 100644
index 0000000000000000000000000000000000000000..9155305e72f4e568d0d25ea0d496e94273168750
--- /dev/null
+++ b/tests/regression/loop_idiom_extern_alias/defs.c
@@ -0,0 +1,12 @@
+/* Link X and Y as the same global, without exposing that fact to use.c.
+ * The forward loop must propagate the first byte all the way to X[32]. */
+unsigned char X[64];
+extern unsigned char Y[64] __attribute__((alias("X")));
+void copy_extern_alias(unsigned n);
+int main(void) {
+    for (unsigned i = 0; i < 64; ++i) X[i] = (unsigned char)(i + 1);
+    copy_extern_alias(32);
+    for (unsigned i = 0; i <= 32; ++i)
+        if (X[i] != 1) return 1;
+    return X[33] != 34;
+}
diff --git a/tests/regression/loop_idiom_extern_alias/use.c b/tests/regression/loop_idiom_extern_alias/use.c
