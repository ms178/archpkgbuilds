diff --git a/tests/regression/push_rsp_leaq_dedup.c b/tests/regression/push_rsp_leaq_dedup.c
new file mode 100644
index 00000000..a1c3f9d2
--- /dev/null
+++ b/tests/regression/push_rsp_leaq_dedup.c
@@ -0,0 +1,28 @@
+/* Push-adjusted rsp-relative addressing must not be deduplicated:
+ * eliminate_redundant_leaq used to treat `leaq X(%rsp), %rax` as identical
+ * across pushes that DECREMENT %rsp — the second leaq computes a different
+ * address. The sret call passing a by-value struct hits exactly this
+ * (gcc.c-torture 20040709 shape): the sret-temp load was eliminated and
+ * %rdi received the struct argument's address instead.
+ *
+ * This function has: an sret return (>16-byte struct) whose argument is
+ * ALSO passed by value (pushed), so the sret-temp leaq and the struct-arg
+ * leaq both appear around the pushes. */
+
+struct W { double a, b, c; unsigned k : 12, j : 13, i : 7; };
+
+struct W retme(struct W x) { return x; }
+
+__attribute__((noinline)) unsigned roundtrip(struct W y) {
+    y.k += 5;
+    y = retme(y);
+    return y.k + y.j + y.i;
+}
+
+int main(void) {
+    struct W w;
+    __builtin_memset(&w, 0, sizeof w);
+    w.k = 100; w.j = 200; w.i = 3;
+    /* 100+5 (mod 4096) + 200 + 3 = 308 */
+    return roundtrip(w) == 308 ? 0 : 1;
+}
diff --git a/tests/regression/vla_struct_varargs.c b/tests/regression/vla_struct_varargs.c
new file mode 100644
index 00000000..f7e0a1c8
--- /dev/null
+++ b/tests/regression/vla_struct_varargs.c
@@ -0,0 +1,28 @@
+/* VLA-containing structs in variadic calls are passed BY REFERENCE
+ * (GCC ABI), and va_arg of such a type fetches the pointer then
+ * memcpy's the runtime size (gcc.c-torture 20020412-1 shape). */
+
+#include <stdarg.h>
+
+extern void abort(void);
+
+void foo(int size, ...) {
+    struct { char x[size]; } d;
+    va_list ap;
+    va_start(ap, size);
+    d = va_arg(ap, typeof(d));
+    /* Second fetch: the va_list state must have advanced correctly. */
+    d = va_arg(ap, typeof(d));
+    for (int i = 0; i < size; i++) {
+        if (d.x[i] != '5' + i) abort();
+    }
+    va_end(ap);
+}
+
+int main(void) {
+    int z = 5;
+    struct { char a[z]; } x, y;
+    for (int i = 0; i < z; i++) { x.a[i] = '0' + i; y.a[i] = '5' + i; }
+    foo(z, x, y);
+    return 0;
+}
