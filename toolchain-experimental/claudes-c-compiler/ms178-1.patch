+    let mut k = i;
+    for _ in 0..=COPY_MASK_WINDOW {
+        k = next_real(infos, k, len)?;
+        let t = infos[k].trimmed(store.get(k));
+        if infos[k].pinned || infos[k].is_barrier() || infos[k].kind == LineKind::InlineAsm {
