+            f.write(_GOTX_ASM)
+        with open(os.path.join(td, "m.c"), "w") as f:
+            f.write(_GOTX_MAIN)
+        lccc_ld = os.path.join(os.path.dirname(os.path.abspath(args.lccc)), "lccc-ld")
+        shim = _shim_for(td, lccc_ld)
+        want = "7 7 1 42 42 1 1 1 1 1\n"
