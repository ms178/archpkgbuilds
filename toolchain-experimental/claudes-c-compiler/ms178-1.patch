+    // semantic cast the fold must not see through.
+    if !matches!(
+        (from_ty, to_ty),
+        (IrType::I8 | IrType::U8, IrType::I16 | IrType::I32 | IrType::U32)
+    ) {
+        return None;
+    }
+    let s = sv.0;
+    if cmp_defs.get(s as usize).is_some_and(|d| d.is_some()) {
+        Some(s)
+    } else {
+        None
+    }
