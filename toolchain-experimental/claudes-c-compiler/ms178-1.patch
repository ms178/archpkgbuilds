+main:
+    adrp x0, :got:g
+    ldr x0, [x0, :got_lo12:g]
+    mov x20, x0
+    mov x9, x0
+    ldr x0, [x9]
+    ldr x1, [x9, #8]
+    str x0, [sp, #32]
+    str x1, [sp, #40]
+    ret
+g:
+    ret
