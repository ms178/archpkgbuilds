+    /// Space stored on the outermost pointer, if `ty` is a pointer.
+    fn outer_space(ty: &CType) -> Option<AddressSpace> {
+        match ty {
+            CType::Pointer(_, sp) => Some(*sp),
+            _ => None,
+        }
+    }
