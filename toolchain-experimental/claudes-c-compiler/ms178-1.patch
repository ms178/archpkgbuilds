diff --git a/tests/regression/vector_abi/check_vector_return_abi.c b/tests/regression/vector_abi/check_vector_return_abi.c
new file mode 100644
index 000000000..9c9b59bbb
--- /dev/null
+++ b/tests/regression/vector_abi/check_vector_return_abi.c
@@ -0,0 +1,29 @@
+#include <stdio.h>
+typedef float v4 __attribute__((vector_size(16)));
+typedef float v8 __attribute__((vector_size(32)));
+extern v4 ret4(v4);
+extern v8 ret8(v8);
+extern v4 fwd4(v4);
+extern v8 fwd8(v8);
+
+int main(void) {
+    int bad = 0;
+    v4 i4 = {1, 2, 3, 4};
+    v8 i8 = {1, 2, 3, 4, 5, 6, 7, 8};
+    const float w4[4] = {2, 4, 6, 8};
+    const float w8[8] = {2, 4, 6, 8, 10, 12, 14, 16};
+
+    v4 r4 = ret4(i4), f4 = fwd4(i4);
+    v8 r8 = ret8(i8), f8 = fwd8(i8);
+    for (int i = 0; i < 4; i++) {
+        if (r4[i] != w4[i]) { printf("ret4 lane%d %g want %g\n", i, r4[i], w4[i]); bad++; }
+        if (f4[i] != w4[i]) { printf("fwd4 lane%d %g want %g\n", i, f4[i], w4[i]); bad++; }
+    }
+    for (int i = 0; i < 8; i++) {
+        if (r8[i] != w8[i]) { printf("ret8 lane%d %g want %g\n", i, r8[i], w8[i]); bad++; }
+        if (f8[i] != w8[i]) { printf("fwd8 lane%d %g want %g\n", i, f8[i], w8[i]); bad++; }
+    }
+    if (bad) { printf("FAIL: %d lane(s) corrupted across a vector return\n", bad); return 1; }
+    printf("PASS: every lane survives a vector return at 128 and 256 bits\n");
+    return 0;
+}
diff --git a/tests/regression/vector_abi/check_vector_return_abi.sh b/tests/regression/vector_abi/check_vector_return_abi.sh
new file mode 100755
index 000000000..53d0a96b0
--- /dev/null
+++ b/tests/regression/vector_abi/check_vector_return_abi.sh
@@ -0,0 +1,85 @@
+#!/usr/bin/env bash
+# Gate: a vector return must not cost a stack round trip, and every lane must
+# survive it.
+#
+# Two independent claims, because they fail independently:
+#
+#   1. VALUES.  Run a program that returns __m128/__m256 values from functions
+#      and forwards them through a second call.  Any lane lost in the
+#      `%xmm0`-to-GP-half decomposition shows up here.
+#   2. COST.  Count the emitted instructions of
+#           v8 f(v8 a){ return ext8(a); }
+#      GCC 16.2 emits `jmp ext8` (1 instruction).  LCCC currently emits 25 --
+#      four aligned stack slots and a GP-half rebuild -- because the IR carries
+#      a vector return as packed I64 (src/ir/lowering/lower.rs, "A small vector
+#      travels as packed I64 data").  The budget below is the boundary: it fails
+#      on the current tree and starts passing when the register home is kept, so
+#      it cannot be satisfied accidentally by an unrelated change.
+#
+# Usage: check_vector_return_abi.sh [--lccc PATH] [--reference CC] [--budget N]
+set -euo pipefail
+
+LCCC=""; REFERENCE=""; BUDGET=6
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --lccc) LCCC="$2"; shift 2 ;;
+        --reference) REFERENCE="$2"; shift 2 ;;
+        --budget) BUDGET="$2"; shift 2 ;;
+        -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
+        *) echo "check_vector_return_abi: unknown argument '$1'" >&2; exit 2 ;;
+    esac
+done
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
+CC="${LCCC:-$ROOT/target/fastbuild/lccc}"
+DIR="$ROOT/tests/regression/vector_abi"
+[ -x "$CC" ] || { echo "FAIL: lccc binary '$CC' is not executable" >&2; exit 1; }
+
+WORK="$(mktemp -d)"; trap 'rm -rf "$WORK"' EXIT
+echo "check_vector_return_abi: vector returns"
+
+# --- 1. values -------------------------------------------------------------
+for flags in "-msse2" "-mavx2"; do
+    $CC -O2 -w $flags "$DIR/vector_return_abi.c" "$DIR/check_vector_return_abi.c" \
+        -o "$WORK/t" 2>"$WORK/cc.log" \
+        || { echo "FAIL: cannot build the value probe ($flags)" >&2; cat "$WORK/cc.log" >&2; exit 1; }
+    if "$WORK/t" > "$WORK/out.txt" 2>&1; then
+        echo "  ok  $flags: $(cat "$WORK/out.txt")"
+    else
+        echo "FAIL: $flags vector return corrupted lanes:" >&2
+        cat "$WORK/out.txt" >&2
+        exit 1
+    fi
+done
+
+# --- 2. cost ---------------------------------------------------------------
+cat > "$WORK/cost.c" <<'EOF'
+typedef float v8 __attribute__((vector_size(32)));
+extern v8 ext8(v8);
+v8 f(v8 a){ return ext8(a); }
+EOF
+$CC -O2 -w -mavx2 -S "$WORK/cost.c" -o "$WORK/cost.s" 2>/dev/null \
+    || { echo "FAIL: cannot emit assembly for the cost probe" >&2; exit 1; }
+# Count the body of `f:` only, between its label and `ret`.
+body=$(awk '/^f:/{on=1;next} on&&/^[[:space:]]*ret/{exit} on' "$WORK/cost.s")
+n=$(printf '%s\n' "$body" | grep -cE '^[[:space:]]+[a-z]' || true)
+if [ "$n" -gt "$BUDGET" ]; then
+    echo "FAIL: v8 f(v8) costs $n instructions (budget $BUDGET; GCC 16.2 emits 1)." >&2
+    echo "      The vector return is being rebuilt through GP halves or a stack" >&2
+    echo "      slot instead of staying in %ymm0.  Emitted body:" >&2
+    printf '%s\n' "$body" | sed 's/^/        /' >&2
+    exit 1
+fi
+echo "  ok  v8 f(v8) costs $n instruction(s) (budget $BUDGET)"
+
+if [ -n "$REFERENCE" ] && command -v "$REFERENCE" >/dev/null 2>&1; then
+    $REFERENCE -O2 -w -mavx2 -S "$WORK/cost.c" -o "$WORK/ref.s" 2>/dev/null || true
+    if [ -s "$WORK/ref.s" ]; then
+        rb=$(awk '/^f:/{on=1;next} on&&/^[[:space:]]*ret/{exit} on' "$WORK/ref.s")
+        rn=$(printf '%s\n' "$rb" | grep -cE '^[[:space:]]+[a-z]' || true)
+        rn=$((rn + 1))   # `jmp ext8` is the whole body and ends the function
+        echo "  ref $REFERENCE: $rn instruction(s)"
+    fi
+fi
+
+echo "PASS: vector returns preserve every lane within the instruction budget"
diff --git a/tests/regression/vector_abi/vector_return_abi.c b/tests/regression/vector_abi/vector_return_abi.c
new file mode 100644
index 000000000..4af5faf6e
--- /dev/null
+++ b/tests/regression/vector_abi/vector_return_abi.c
@@ -0,0 +1,22 @@
+/* Vector returns must reach the caller without a stack round trip.
+ *
+ * `v8 f(v8 a){ return ext8(a); }` is one instruction in GCC 16.2
+ * (`jmp ext8`) and 25 in LCCC, because the IR carries a vector return as
+ * packed `I64` data (`src/ir/lowering/lower.rs`: "A small vector travels as
+ * packed I64 data") and `lower_function_call` then decomposes the `%xmm0` /
+ * `%ymm0` result into GP halves.  This fixture is the execution half of the
+ * gate: whatever the codegen does, the VALUES must arrive intact at every
+ * width, so a future register-home fix cannot silently corrupt an upper lane.
+ *
+ * Compiled per width: see check_vector_return_abi.sh.
+ */
+typedef float v4 __attribute__((vector_size(16)));
+typedef float v8 __attribute__((vector_size(32)));
+
+v4  ret4(v4  a) { return a * 2.0f; }
+v8  ret8(v8  a) { return a * 2.0f; }
+
+/* A value that came back from a call, then forwarded -- the shape that produced
+ * the `movq`-pair decomposition. */
+v4  fwd4(v4  a) { return ret4(a); }
+v8  fwd8(v8  a) { return ret8(a); }
diff --git a/tests/regression/vector_home_relay_clobber.c b/tests/regression/vector_home_relay_clobber.c
new file mode 100644
index 000000000..d1129f7d2
--- /dev/null
+++ b/tests/regression/vector_home_relay_clobber.c
@@ -0,0 +1,17 @@
+typedef float vf8 __attribute__((vector_size(32)));
+static __attribute__((noinline)) void clobber(vf8 *p) {
+    *p = (vf8){7,7,7,7,7,7,7,7};
+}
+static __attribute__((noinline)) void relay(vf8 *out, const vf8 *in, vf8 hi) {
+    vf8 t = __builtin_ia32_minps256(*in, hi);
+    clobber(out);
+    *out = t;
+}
+int main(void) {
+    vf8 in = {5,5,5,5,5,5,5,5};
+    vf8 hi = {3,3,3,3,3,3,3,3};
+    vf8 out = {0,0,0,0,0,0,0,0};
+    relay(&out, &in, hi);
+    for (int i = 0; i < 8; ++i) if (out[i] != 3.0f) return 1;
+    return 0;
+}
