+            "    negq %rax",
+            "    imulq %rcx, %rax",
+            "    imulq $3, %rcx, %rax",
+            "    popq %rax",
+            "    sete %al",
+            "    movd %xmm0, %eax",
+            "    pextrb $0, %xmm2, %eax",
+            "    vcvttsd2siq %xmm0, %rax",
+            "    vpmovmskb %xmm1, %eax",
+            "    movabsq $8826686330870431363, %rax",
+            "    movl %fs:0, %eax",
+            "    btsq %rcx, %rax",
+            "    movq %rbx, %rax",
+        ] {
+            assert!(asm_line_writes_rax(line), "must WRITE rax: {line:?}");
+        }
+    }
+
