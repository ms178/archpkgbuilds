+            X86ExtraFeature::AmxTile => "__AMX_TILE__",
+            X86ExtraFeature::AmxInt8 => "__AMX_INT8__",
+            X86ExtraFeature::AmxBf16 => "__AMX_BF16__",
+            X86ExtraFeature::Avx10_1 => "__AVX10_1__",
+            X86ExtraFeature::Avx10_2 => "__AVX10_2__",
