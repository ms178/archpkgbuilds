+        assert_eq!(crate::passes::dce::eliminate_dead_code(&mut f), 1);
+        assert_eq!(
+            f.blocks[0]
+                .instructions
+                .iter()
+                .filter_map(Instruction::dest)
+                .collect::<Vec<_>>(),
+            (1..=5).map(Value).collect::<Vec<_>>()
