 src/backend/riscv/codegen/intrinsics.rs | 89 +++++++++++++++++++++++++
 tests/regression/scalar_fp_builtins.c   | 39 +++++++++++
 3 files changed, 202 insertions(+)
 create mode 100644 tests/regression/scalar_fp_builtins.c

