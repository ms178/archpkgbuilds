+            &[Operand::Value(Value(1)), c32(4)]
+        ));
+    }
+
+    #[test]
+    fn site_rejects_struct_by_value_bound_parameter() {
+        // A struct-by-value parameter is never passed as a scalar constant.
+        let sizes = [None, Some(8)];
+        assert!(!const_trip_site_arg(
+            0b10,
+            &sizes,
+            &[Operand::Value(Value(1)), c32(4)]
+        ));
+    }
+
+    #[test]
+    fn site_accepts_wide_integer_constants_in_range() {
+        let sizes = [None, None];
+        let arg = Operand::Const(IrConst::I64(4));
+        assert!(const_trip_site_arg(
+            0b10,
+            &sizes,
+            &[Operand::Value(Value(1)), arg]
+        ));
+    }
+}
diff --git a/tests/regression/check_const_trip_loop_inline.sh b/tests/regression/check_const_trip_loop_inline.sh
new file mode 100755
index 00000000..41700779
--- /dev/null
+++ b/tests/regression/check_const_trip_loop_inline.sh
@@ -0,0 +1,126 @@
+#!/usr/bin/env bash
+# ============================================================================
+# check_const_trip_loop_inline.sh — pin the constant-trip loop-helper decision.
+#
+# `const_trip_loop_inline.c` pins run-time RESULTS. This script pins the
+# compile-time DECISION, which a run-and-compare test cannot see:
+#
+#   A loop helper whose exit is bounded by a parameter (expat's sip_round
+#   shape, 137 IR instructions) is cloned at a call site that passes a
+#   constant 2..8 for that parameter. Its state then stays in registers
+#   across rounds. Measured on the SipHash benchmark: 198.9M -> 159.3M
+#   Callgrind instructions, against 140.6M for GCC 14.2 (which also inlines
+#   every site).
+#
+# Assertions (x86-64 -O2 -march=x86-64-v3 -fwrapv):
+#   1. constant trips 2, 4 (inside a loop) and 8: the helper call is gone
+#   2. trips 0, 1, 9, and a non-constant trip: the call remains
+#   3. at -Os the tier is disabled, so a constant-trip call remains
+#   4. an always_inline twin is NOT restricted to constants: at a
+#      non-constant site its call is still inlined
+# ============================================================================
+set -euo pipefail
+
+here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+CCC=${CCC:-$here/../../target/fastbuild/lccc}
+[[ -x $CCC ]] || { echo "check_const_trip_loop_inline: lccc not found at $CCC" >&2; exit 1; }
+
+work=$(mktemp -d)
+trap 'rm -rf "$work"' EXIT
+
+# One TU for the admitted shapes and one for the refused shapes, so a change
+# to one cannot mask the other. Both helpers are the sip_round body.
+body='
+static void round_ct(struct st *s, const int rounds)
+{
+    for (int i = 0; i < rounds; i++) {
+        s->a += s->b; s->b = (s->b << 13) | (s->b >> 51); s->b ^= s->a;
+        s->a = (s->a << 32) | (s->a >> 32);
+        s->c += s->d; s->d = (s->d << 16) | (s->d >> 48); s->d ^= s->c;
+        s->a += s->d; s->d = (s->d << 21) | (s->d >> 43); s->d ^= s->a;
+        s->c += s->b; s->b = (s->b << 17) | (s->b >> 47); s->b ^= s->c;
+        s->c = (s->c << 32) | (s->c >> 32);
+    }
+}
+'
+admitted="$work/admitted.c"
+refused="$work/refused.c"
+{
+  echo '#include <stdint.h>'
+  echo 'struct st { uint64_t a, b, c, d; };'
+  echo "$body"
+  cat <<'EOF'
+__attribute__((noinline)) void site_two(struct st *s) { round_ct(s, 2); }
+__attribute__((noinline)) void site_four_in_loop(struct st *s)
+{
+    for (int k = 0; k < 3; k++)
+        round_ct(s, 4);
+}
+__attribute__((noinline)) void site_eight(struct st *s) { round_ct(s, 8); }
+EOF
+} > "$admitted"
+{
+  echo '#include <stdint.h>'
+  echo 'struct st { uint64_t a, b, c, d; };'
+  echo "$body"
+  cat <<'EOF'
+__attribute__((noinline)) void site_zero(struct st *s) { round_ct(s, 0); }
+__attribute__((noinline)) void site_one(struct st *s) { round_ct(s, 1); }
+__attribute__((noinline)) void site_nine(struct st *s) { round_ct(s, 9); }
+__attribute__((noinline)) void site_variable(struct st *s, int n) { round_ct(s, n); }
+EOF
+  # always_inline twin of the same body, called at a non-constant site.
+  ai_body=${body//round_ct/ai_round}
+  attr='__attribute__((always_inline)) static void'
+  echo "${ai_body/static void/$attr}"
+  echo '__attribute__((noinline)) void site_always_variable(struct st *s, int n) { ai_round(s, n); }'
+} > "$refused"
+
+# Print one function's body: from its label up to its .size directive.
+extract() { # extract <asm> <fn>
+  awk -v fn="$2" '
+    $0 == fn ":" { on = 1; next }
+    on && $1 == ".size" && $2 == fn "," { exit }
+    on { print }' "$1"
+}
+
+# Count direct calls to <callee> in one function's body.
+calls_to() { # calls_to <asm> <fn> <callee>
+  extract "$1" "$2" | grep -c "^[[:space:]]*call[[:space:]]\+$3[[:space:]]*$" || true
+}
+
+fail=0
+expect_calls() { # expect_calls <asm> <fn> <callee> <count> <label>
+  local got
+  got=$(calls_to "$1" "$2" "$3")
+  if [[ $got != "$4" ]]; then
+    echo "FAIL $5: $2 has $got call(s) to $3, expected $4" >&2
+    fail=1
+  else
+    echo "ok   $5: $2 has $got call(s) to $3"
+  fi
+}
+
+O2="$work/admitted.s"
+"$CCC" -O2 -march=x86-64-v3 -fwrapv -S -o "$O2" "$admitted"
+expect_calls "$O2" site_two round_ct 0 "constant trip 2"
+expect_calls "$O2" site_four_in_loop round_ct 0 "constant trip 4 in a loop"
+expect_calls "$O2" site_eight round_ct 0 "constant trip 8"
+
+R2="$work/refused.s"
+"$CCC" -O2 -march=x86-64-v3 -fwrapv -S -o "$R2" "$refused"
+expect_calls "$R2" site_zero round_ct 1 "trip 0 is refused"
+expect_calls "$R2" site_one round_ct 1 "trip 1 is refused"
+expect_calls "$R2" site_nine round_ct 1 "trip 9 is refused"
+expect_calls "$R2" site_variable round_ct 1 "non-constant trip is refused"
+expect_calls "$R2" site_always_variable ai_round 0 "always_inline at a non-constant site is cloned"
+
+OS="$work/admitted_os.s"
+"$CCC" -Os -march=x86-64-v3 -fwrapv -S -o "$OS" "$admitted"
+expect_calls "$OS" site_two round_ct 1 "-Os keeps the tier disabled (trip 2)"
+
+if [[ $fail -ne 0 ]]; then
+  echo "check_const_trip_loop_inline: FAILED" >&2
+  exit 1
+fi
+echo "check_const_trip_loop_inline: all assertions hold"
diff --git a/tests/regression/const_trip_loop_inline.c b/tests/regression/const_trip_loop_inline.c
new file mode 100644
index 00000000..f49a4c07
--- /dev/null
+++ b/tests/regression/const_trip_loop_inline.c
@@ -0,0 +1,231 @@
+/*
+ * Constant-trip loop-helper inlining: run-time semantics.
+ *
+ * `mix_rounds` has the SipHash `sip_round` shape: a loop whose exit compares
+ * a parameter, and four state words updated through a pointer. Its body is
+ * about 137 IR instructions, so the general static-loop cap (128 instructions,
+ * two call sites) never admits it. The constant-trip tier admits it at call
+ * sites that pass a constant 2..8 for the bounding parameter.
+ *
+ * This file pins the RESULT of every path the tier can take or must refuse:
+ *   - constant trips inside and outside loops (inlined),
+ *   - constants outside 2..8 (must stay calls: 0, 1, 9),
+ *   - a non-constant trip count (stays a call),
+ *   - an inclusive bound (`<=`, an off-by-one hazard),
+ *   - a bound that the body reassigns before the loop,
+ *   - an address-taken helper (its out-of-line body must survive).
+ *
+ * The expected values were computed with GCC 14 at -O0 (no inlining, no
+ * optimization), so the oracle shares no code with the compiler under test.
+ * The assembly-shape half of the contract is in
+ * check_const_trip_loop_inline.sh.
+ */
+#include <stdint.h>
+#include <stdio.h>
+
+struct st {
+    uint64_t a, b, c, d;
+};
+
+#define ROTL(x, r) (((x) << (r)) | ((x) >> (64 - (r))))
+
+static void mix_rounds(struct st *s, const int rounds)
+{
+    for (int i = 0; i < rounds; i++) {
+        s->a += s->b;
+        s->b = ROTL(s->b, 13);
+        s->b ^= s->a;
+        s->a = ROTL(s->a, 32);
+        s->c += s->d;
+        s->d = ROTL(s->d, 16);
+        s->d ^= s->c;
+        s->a += s->d;
+        s->d = ROTL(s->d, 21);
+        s->d ^= s->a;
+        s->c += s->b;
+        s->b = ROTL(s->b, 17);
+        s->b ^= s->c;
+        s->c = ROTL(s->c, 32);
+    }
+}
+
+/* Same body with an inclusive bound: runs rounds + 1 times. */
+static void mix_rounds_le(struct st *s, const int rounds)
+{
+    for (int i = 0; i <= rounds; i++) {
+        s->a += s->b;
+        s->b = ROTL(s->b, 13);
+        s->b ^= s->a;
+        s->a = ROTL(s->a, 32);
+        s->c += s->d;
+        s->d = ROTL(s->d, 16);
+        s->d ^= s->c;
+        s->a += s->d;
+        s->d = ROTL(s->d, 21);
+        s->d ^= s->a;
+        s->c += s->b;
+        s->b = ROTL(s->b, 17);
+        s->b ^= s->c;
+        s->c = ROTL(s->c, 32);
+    }
+}
+
+/* The bound is reassigned before the loop, so the exit compares a derived
+ * value, not the incoming parameter. */
+static void scale_rounds(struct st *s, int rounds)
+{
+    rounds = rounds * 2;
+    for (int i = 0; i < rounds; i++) {
+        s->a += s->b;
+        s->b = ROTL(s->b, 13);
+        s->b ^= s->a;
+        s->a = ROTL(s->a, 32);
+        s->c += s->d;
+        s->d = ROTL(s->d, 16);
+        s->d ^= s->c;
+        s->a += s->d;
+        s->d = ROTL(s->d, 21);
+        s->d ^= s->a;
+        s->c += s->b;
+        s->b = ROTL(s->b, 17);
+        s->b ^= s->c;
+        s->c = ROTL(s->c, 32);
+    }
+}
+
+/* The callers are noinline so each stays a small function of its own. If
+ * they were inlined into main, main would exceed the 500-instruction caller
+ * hard cap and the constant-trip clones would never be exercised here. */
+
+/* Address-taken: the out-of-line body must still exist and be correct. */
+static void (*volatile mix_rounds_ptr)(struct st *, const int) = mix_rounds;
+
+__attribute__((noinline)) static uint64_t const_sites(struct st *s)
+{
+    mix_rounds(s, 2);
+    for (int k = 0; k < 3; k++)
+        mix_rounds(s, 4); /* constant site inside a caller loop */
+    mix_rounds(s, 8);
+    return s->a ^ s->d;
+}
+
+__attribute__((noinline)) static uint64_t out_of_range_sites(struct st *s)
+{
+    mix_rounds(s, 0);
+    mix_rounds(s, 1);
+    mix_rounds(s, 9);
+    return s->a ^ s->d;
+}
+
+/* Alone in its caller, so the caller budget (350 instructions) admits the
+ * clone and the largest admitted constant, 8, is actually exercised. */
+__attribute__((noinline)) static uint64_t eight_site(struct st *s)
+{
+    mix_rounds(s, 8);
+    return s->a ^ s->d;
+}
+
+__attribute__((noinline)) static uint64_t variable_site(struct st *s, int n)
+{
+    mix_rounds(s, n);
+    return s->a ^ s->d;
+}
+
+__attribute__((noinline)) static uint64_t le_site(struct st *s)
+{
+    mix_rounds_le(s, 2);
+    return s->a ^ s->d;
+}
+
+__attribute__((noinline)) static uint64_t scaled_site(struct st *s)
+{
+    scale_rounds(s, 2);
+    return s->a ^ s->d;
+}
+
+__attribute__((noinline)) static uint64_t pointer_site(struct st *s)
+{
+    mix_rounds_ptr(s, 3);
+    return s->a ^ s->d;
+}
+
+static void seed(struct st *s, uint64_t k)
+{
+    s->a = 0x736f6d6570736575ULL ^ k;
+    s->b = 0x646f72616e646f6dULL ^ (k * 3);
+    s->c = 0x6c7967656e657261ULL ^ (k * 5);
+    s->d = 0x7465646279746573ULL ^ (k * 7);
+}
+
+static int failures;
+
+static void check(const char *name, uint64_t got, uint64_t want)
+{
+    if (got != want) {
+        printf("FAIL %s: got %016llx want %016llx\n", name,
+               (unsigned long long)got, (unsigned long long)want);
+        failures++;
+    }
+}
+
+/* always_inline is honoured at a NON-constant site. The constant-trip tier
+ * never admits always_inline bodies, so the clone must come from the normal
+ * always_inline path, not from a constant argument. */
+__attribute__((always_inline)) static void ai_mix(struct st *s, const int rounds)
+{
+    for (int i = 0; i < rounds; i++) {
+        s->a += s->b;
+        s->b = ROTL(s->b, 13);
+        s->b ^= s->a;
+        s->a = ROTL(s->a, 32);
+        s->c += s->d;
+        s->d = ROTL(s->d, 16);
+        s->d ^= s->c;
+        s->a += s->d;
+        s->d = ROTL(s->d, 21);
+        s->d ^= s->a;
+        s->c += s->b;
+        s->b = ROTL(s->b, 17);
+        s->b ^= s->c;
+        s->c = ROTL(s->c, 32);
+    }
+}
+
+__attribute__((noinline)) static uint64_t always_variable_site(struct st *s, int n)
+{
+    ai_mix(s, n);
+    return s->a ^ s->d;
+}
+
+int main(void)
+{
+    struct st s;
+
+    seed(&s, 1);
+    check("const_sites", const_sites(&s), UINT64_C(0xbc9d2f5364edb528));
+    seed(&s, 2);
+    check("out_of_range_sites", out_of_range_sites(&s), UINT64_C(0x49503734e6b59436));
+    seed(&s, 3);
+    check("variable_site(0)", variable_site(&s, 0), UINT64_C(0x070a090709070010));
+    seed(&s, 4);
+    check("variable_site(3)", variable_site(&s, 3), UINT64_C(0xc2063bfb56760121));
+    seed(&s, 5);
+    check("variable_site(-1)", variable_site(&s, -1), UINT64_C(0x070a090709070020));
+    seed(&s, 6);
+    check("le_site", le_site(&s), UINT64_C(0x7383ce76694830d2));
+    seed(&s, 7);
+    check("scaled_site", scaled_site(&s), UINT64_C(0x202f1cdb2b90c7c4));
+    seed(&s, 8);
+    check("pointer_site", pointer_site(&s), UINT64_C(0x030cfc30b617f289));
+    seed(&s, 9);
+    check("eight_site", eight_site(&s), UINT64_C(0xbf0888c527e9dd23));
+    seed(&s, 10);
+    check("always_variable_site", always_variable_site(&s, 5), UINT64_C(0xea63d0e16a578eee));
+
+    if (failures) {
+        printf("%d failure(s)\n", failures);
+        return 1;
+    }
+    puts("ok");
+    return 0;
+}
