+/// `!=`, `<=` and `>=` so an expression default is never split mid-operator.
+fn find_toplevel_eq(s: &str) -> Option<usize> {
+    let b = s.as_bytes();
+    let mut depth = 0i32;
+    let mut i = 0;
+    while i < b.len() {
+        match b[i] {
+            b'(' => depth += 1,
+            b')' => depth -= 1,
