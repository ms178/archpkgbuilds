             // Pure: a symbol's address is constant for the process lifetime.
             Instruction::GlobalAddr { dest, name } => Some((
@@ -1497,7 +1518,7 @@ mod tests {
         asm_labels: crate::common::fx_hash::FxHashMap::default(),};
 
