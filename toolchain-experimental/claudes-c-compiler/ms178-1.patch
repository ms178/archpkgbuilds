+            CvtPs2Pd_256 => unary(self, "vcvtps2pd"),
+            CvtPd2Ps_256 => unary(self, "vcvtpd2ps"),
+            CvtPd2Ep32_256 => unary(self, "vcvtpd2dq"),
+            CvtEp32_2Pd_256 => unary(self, "vcvtdq2pd"),
+            CvttPd2Ep32_256 => unary(self, "vcvttpd2dq"),
