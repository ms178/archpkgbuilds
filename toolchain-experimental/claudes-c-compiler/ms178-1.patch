diff --git a/tests/regression/machinst_widen_cast.c b/tests/regression/machinst_widen_cast.c
new file mode 100644
index 0000000000000000000000000000000000000000..c463591af8d3a70399460408715307089d3cf70a
--- /dev/null
+++ b/tests/regression/machinst_widen_cast.c
@@ -0,0 +1,19 @@
+/* MachInst regression: 32->64 casts must not truncate to the low byte. */
+#include <stdint.h>
+#include <stdio.h>
+
+static uint64_t widen_u32(uint32_t value) {
+    return (uint64_t)value + UINT64_C(0x0102030405060708);
+}
+
+static uint64_t widen_signed_to_u64(int32_t value) {
+    return (uint64_t)value;
+}
+
+int main(void) {
+    uint64_t a = widen_u32(UINT32_C(0x12345678));
+    uint64_t b = widen_signed_to_u64(-1);
+    printf("%016llx %016llx\n", (unsigned long long)a, (unsigned long long)b);
+    return a != UINT64_C(0x01020304173a5d80)
+        || b != UINT64_MAX;
+}
