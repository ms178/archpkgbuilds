+
+"$GCC_BIN" -std=gnu18 -funsigned-char -Wall -Wextra -Werror -O2 -S \
+    "$TMP_DIR/valid_kernel_idioms.c" -o "$TMP_DIR/gcc.s"
+"$CCC" -std=gnu18 -funsigned-char -Wall -Wextra -Werror -O2 -S \
