+            }
+            other => panic!("expected intrinsic, got {other:?}"),
+        }
+    }
+
+    #[test]
+    fn f32_peels_with_own_width() {
+        let mut m = module(
+            vec![neg(1, 0, IrType::F32), fma(2, v(1), v(3), v(4), false)],
+            5,
+        );
