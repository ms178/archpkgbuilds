@@ -5067,9 +5067,43 @@ fn eliminate_redundant_leaq_init(store: &LineStore, infos: &mut [LineInfo]) -> bo
     fn written_families(line: &str) -> Vec<RegId> {
+        // %rsp writes are as real as any data-register write: every cached
+        // `leaq X(%rsp), %rax` bakes the CURRENT %rsp into the address, so a
+        // push/pop (or any rsp modification) makes the cached address stale.
+        // Missing the push case let eliminate_redundant_leaq delete a second,
+        // textually identical leaq whose 80(%rsp) meant a DIFFERENT address
+        // after four pushes had moved %rsp (sret-calls passing a by-value
+        // struct: the sret-temp load was eliminated and %rdi received the
+        // struct argument's address instead — gcc.c-torture 20040709).
+        const RSP: RegId = 4;
+        if line.starts_with("push") {
+            // push writes memory and DECREMENTS %rsp. It has no destination
+            // register operand, so the generic comma fallback would return
+            // nothing — handle it before that.
+            return vec![RSP];
+        }
         if line.starts_with("pop") {
-            // popq %r12 / pop %r12 — writes the operand register.
+            // popq %r12 / pop %r12 — writes the operand register AND
+            // increments %rsp.
+            let mut fams = Vec::with_capacity(2);
             if let Some(sp) = line.find('%') {
-                return vec![register_family_fast(line[sp..].trim())];
+                let fam = register_family_fast(line[sp..].trim());
+                if fam != REG_NONE {
+                    fams.push(fam);
+                }
             }
-            return Vec::new();
+            fams.push(RSP);
+            return fams;
         }
         match line {
             "cltq" => return vec![0],
             "cqto" | "cqo" => return vec![0, 2],
             "cdq" => return vec![2],
+            "leave" => return vec![4, 5], // rsp <- rbp; pops rbp
+            "enter" => return vec![4, 5],
             _ => {}
         }
