+        b = e_shoff + i * e_shentsize
+        if b + e_shentsize > len(d):
+            return out
+        n, t, fl, a, off, sz, lk, inf, al, es = struct.unpack_from("<IIQQQQIIQQ", d, b)
+        secs.append((n, t, off, sz, lk, inf))
