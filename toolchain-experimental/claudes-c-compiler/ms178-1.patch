+
+The corpus above is imported; the two cases below were found by
+`scripts/fuzz_diff.py --engine yarpgen` itself once the engine was
+repaired (pinned intel/yarpgen `1adb290…`, `scripts/ensure_yarpgen.sh`),
+reduced by per-global dump localisation + dual-oracle delta-debugging,
+and added to the same regression directory:
+
+| Test | Seed | Root cause fixed |
+|------|------|------------------|
+| `regress_const_bool_cast_zero_lowbyte` | 20261023 | Constant `(_Bool)` conversion folded by truncating to 8 bits *before* normalising, so `(_Bool)256` / `(_Bool)67106816ULL` folded to 0 (C11 6.3.1.2 wants 1 for any nonzero scalar) — the dual of corpus case #1. Fixed at four folding sites (`src/frontend/sema/` Cast eval + `cast_i128_to_ctype`, both `eval_const_expr_as_bits` in sema and `src/ir/lowering/`). |
+| `regress_stmt_expr_conditional_composite_type` | 20261020 | `get_expr_ctype_with_scope` in `src/ir/lowering/expr_types.rs` typed a statement-expression tail conditional as its then-arm's type instead of the C11 6.5.15 composite type, truncating mixed-type `min`/`max` statement expressions (the kernel idiom) whenever the compound contained a declaration: loop inits collapsed (0 trips at `-O1`), guarded stores were skipped at `-O2`, and an inner loop silently diverged at `-O0` (5 vs 30 iterations under counters) without changing the final checksum. Fixed for both `Conditional` and `GnuConditional` arms via `CType::conditional_composite_type` (`conditional_ctype_with_scope`). Related prior art in the same function: corpus cases #14–#16. |
+| `regress_const_neg_unsigned_wrap` | 101 (mutpair) | Unary minus on an `unsigned int` constant folded modulo 2^64 instead of 2^32 in both constant folders (`-(3844603080U)` → 18446744069864948536, not 450364216), flipping a folded `min()`. The sibling `~` fold (corpus case #2) already truncated to the promoted width; `-` now gets the same treatment in `src/frontend/sema/const_eval.rs` and `src/ir/lowering/const_eval.rs`. Found by `scripts/yarpgen_mutpair.py`; the same seed also exposes a compile-time pathology (581 s at `-O2` for a 248 KB TU on a 2-CPU VM, correct output) tracked in the FOLLOWUP. |
diff --git a/tests/regression/regress_const_bool_cast_zero_lowbyte.c b/tests/regression/regress_const_bool_cast_zero_lowbyte.c
new file mode 100644
index 00000000..ff78b6fc
--- /dev/null
+++ b/tests/regression/regress_const_bool_cast_zero_lowbyte.c
@@ -0,0 +1,41 @@
+/* _Bool constant conversion must be by VALUE (C11 6.3.1.2: any nonzero
+ * scalar converts to 1), never by bit-truncation to _Bool's 8-bit width.
+ * The sema constant folder truncated the source bits to the target width
+ * BEFORE the normalization in bits_to_irconst ran, so every nonzero
+ * constant whose low byte is zero folded to _Bool 0:
+ * (_Bool)256, (_Bool)65536u, (_Bool)67106816ULL.
+ *
+ * This is the dual of regress_const_bool_cast_normalization ((_Bool)61
+ * staying 61): that fix normalized the truncated value, this one stops
+ * the truncation from discarding the bits that carry the truth.
+ *
+ * Found by the resurrected YARPGen differential engine
+ * (scripts/fuzz_diff.py --engine yarpgen, intel/yarpgen seed 20261023):
+ * a single array diverged because ((_Bool)67106816ULL) ? a : b took the
+ * b branch.  Covers the ternary-condition, value, loop-count, static
+ * initializer and __int128-source forms across all four folding sites
+ * (sema Cast eval, sema cast_i128_to_ctype, both eval_const_expr_as_bits). */
+
+int printf(const char *, ...);
+
+static _Bool static_bool = (_Bool)16777216; /* 2^24: low THREE bytes zero */
+
+int main(void) {
+    int acc = 0;
+    acc += ((_Bool)256) ? 1 : 100;
+    acc += ((_Bool)65536u) ? 2 : 200;
+    acc += ((_Bool)67106816ULL) ? 4 : 400;        /* the yarpgen value */
+    acc += ((_Bool)-256) ? 8 : 800;               /* negative, low byte 0 */
+    acc += (int)(_Bool)16777216u * 16;
+    acc += (int)static_bool * 32;
+    acc += ((_Bool)((unsigned __int128)1 << 100)) ? 64 : 6400;
+    acc += ((_Bool)0) ? 12800 : 128;              /* zero stays zero */
+    acc += ((_Bool)5347240037557788348ULL) ? 256 : 25600; /* low byte != 0 */
+    /* Loop trip count through a folded _Bool step (zero-low-byte form
+     * of the normalization corpus case): must step by 1, not by 0. */
+    unsigned i = 0;
+    for (; i < 24; i += (_Bool)512 + 0) {
+    }
+    printf("%d %u\n", acc, i);
+    return 0;
+}
diff --git a/tests/regression/regress_const_neg_unsigned_wrap.c b/tests/regression/regress_const_neg_unsigned_wrap.c
new file mode 100644
index 00000000..354e4410
--- /dev/null
+++ b/tests/regression/regress_const_neg_unsigned_wrap.c
@@ -0,0 +1,48 @@
+/* Unary minus on an unsigned int constant must reduce modulo 2^32
+ * (C11 6.5.3.3p1: the result has the promoted type of the operand;
+ * 6.3.1.3p2: unsigned arithmetic is modular).  Both constant folders
+ * (sema and lowering) carried a 32-bit unsigned operand as I64 and
+ * negated the carrier, computing -x mod 2^64: -(3844603080U) folded to
+ * 18446744069864948536 instead of 450364216, and -(42U) to
+ * 18446744073709551574 instead of 4294967254.  A folded min() then took
+ * the wrong arm.  Runtime negation was always correct; only the fold
+ * was wrong.  BitNot already had the width treatment; regression
+ * regress_logical_and_const_bitnot_short_circuit covers that sibling.
+ *
+ * Found by scripts/yarpgen_mutpair.py (intel/yarpgen seed 101,
+ * original program, -O0): the single diverging global was written by
+ *   var_419 = max(var_419, (long long) min(min(a, (ull)b),
+ *                                           (ull)(-(3844603080U))))
+ * Expected program output (GCC-verified, all -O levels):
+ * "450364216 4294967254 999983 999983" -- the last two are the folded
+ * and runtime min/max results, which must agree (both lose to the
+ * smaller first min() arm 999983; before the fix the folded form
+ * returned 5632918028137529527 because the folded negation was huge). */
+
+int printf(const char *, ...);
+
+#define MAX(a, b) ({ __typeof__(a) _a = (a); __typeof__(b) _b = (b); _a > _b ? _a : _b; })
+#define MIN(a, b) ({ __typeof__(a) _a = (a); __typeof__(b) _b = (b); _a < _b ? _a : _b; })
+
+static const unsigned long long static_neg = (unsigned long long)(-(3844603080U));
+volatile unsigned int vu = 3844603080U;
+
+int main(void) {
+    unsigned long long direct = (unsigned long long)(-(3844603080U));
+    unsigned long long small = (unsigned long long)(-(42U));
+
+    /* The seed's shape: the folded negation must win the min(), exactly
+     * like the runtime (volatile) form next to it. */
+    long long folded = MAX(-855359829999662162LL,
+        (long long) MIN(MIN(5632918028137529527LL, (unsigned long long)999983ULL),
+                        (unsigned long long)(-(3844603080U))));
+    long long runtime = MAX(-855359829999662162LL,
+        (long long) MIN(MIN(5632918028137529527LL, (unsigned long long)999983ULL),
+                        (unsigned long long)(-vu)));
+
+    /* Folded and runtime must agree; sum with the two direct folds and
+     * the static initializer pins every folding site at once. */
+    printf("%llu %llu %lld %lld\n", direct, small, folded,
+           runtime == folded && static_neg == direct ? folded : -1LL);
+    return 0;
+}
diff --git a/tests/regression/regress_stmt_expr_conditional_composite_type.c b/tests/regression/regress_stmt_expr_conditional_composite_type.c
new file mode 100644
index 00000000..1654292f
--- /dev/null
+++ b/tests/regression/regress_stmt_expr_conditional_composite_type.c
@@ -0,0 +1,72 @@
+/* A conditional expression ending a GNU statement expression that
+ * contains declarations must have the C11 6.5.15 composite type of its
+ * two arms (usual arithmetic conversions for arithmetic arms), never the
+ * then-arm's type.
+ *
+ * The lowering path that types a statement-expression tail against the
+ * compound-local scope (get_expr_ctype_with_scope) returned the
+ * then-arm's type verbatim, mistyping every min/max-style macro whose
+ * operands differ in type once a declaration was present:
+ *   ({ unsigned char _a = 225; unsigned long long _b = 4955;
+ *      _a > _b ? _a : _b; })
+ * came out `unsigned char`, so the value was truncated to 91, enclosing
+ * comparisons/arithmetic ran on the truncated value, and sizeof()/typeof
+ * of the whole statement expression reported 1.  The plain
+ * (declaration-free) and function-scope forms were typed correctly by
+ * other paths, which is why this only bit through statement expressions
+ * -- but that is exactly the kernel min/max/clamp idiom.
+ *
+ * Found by the resurrected YARPGen differential engine
+ * (scripts/fuzz_diff.py --engine yarpgen, intel/yarpgen seed 20261020):
+ * a for-loop bound built from nested min/max statement expressions
+ * collapsed so the loop executed zero times at -O1 (and a guarded block
+ * never ran at -O2).  Checksum must equal GCC's: 5966798782442662084.
+ * Expected output (GCC-verified, all -O levels and -m32): "21 6107 8 88":
+ *   21   trip count of the loop whose init is a nested stmt-expr min/max
+ *   6107 sum over mixed-type max/min values that used to truncate
+ *   8    sizeof of the mixed-type stmt-expr conditional
+ *   88   accumulator over flipped/signed arm orders (composite picks) */
+
+int printf(const char *, ...);
+
+#define MAX(a, b) ({ __typeof__(a) _a = (a); __typeof__(b) _b = (b); _a > _b ? _a : _b; })
+#define MIN(a, b) ({ __typeof__(a) _a = (a); __typeof__(b) _b = (b); _a < _b ? _a : _b; })
+
+volatile unsigned char vc = 225;
+volatile unsigned long long vll = 4955;
+
+int main(void) {
+    /* max/min over (unsigned char, unsigned long long): composite type is
+     * unsigned long long, values must not truncate to 8 bits. */
+    unsigned long long sum = 0;
+    sum += MAX((unsigned char)225, (unsigned long long)4955);   /* 4955, was 225 */
+    sum += MAX(vc, vll);                                         /* 4955 runtime */
+    sum += MIN((unsigned char)200, (unsigned long long)300);    /*  200 */
+    sum -= 4000;                                                 /* 4955+4955+200-4000 = 6110; printf uses sum-3 = 6107 */
+
+    int acc = 0;
+    /* Flipped arm orders and a signed/unsigned mix exercise both arms of
+     * the composite rule (then-arm-typing fails in opposite directions). */
+    acc += (int)MAX((unsigned long long)7, (unsigned char)3);   /* 7 */
+    acc += (int)MIN((unsigned long long)7, (unsigned char)3);   /* 3 */
+    acc += (int)MAX((short)-5, (int)260);                        /* 260 -> truncated sum guard below */
+    acc = acc - 260 + 78;                                        /* 88 */
+
+    /* Reduced loop shape from the seed: the init is a nested stmt-expr
+     * min/max over mixed types cast through (unsigned char).  Correct:
+     * inner MAX = 4955, outer MAX((u8)225, (ull)4955) = 4955, (u8)4955 = 91,
+     * init = 91-91 = 0, bound = 84, step 4 -> trips 0,4,...,80 = 21.
+     * With the bug the outer MAX was typed (and valued) as its unsigned-char
+     * arm -- 225 or 91 depending on nesting -- giving a wrong trip count
+     * (the full seed's -225 form collapsed to 0 trips at -O1). */
+    int trips = 0;
+    for (unsigned char i = (unsigned char)(((int)(unsigned char)
+             MAX((unsigned char)225, (unsigned long long)MAX(4955, (unsigned int)0))) - 91);
+         i < ((int)(unsigned char)184) - 100; i += (unsigned char)4) {
+        trips++;
+        if (trips > 40) break;
+    }
+
+    printf("%d %llu %d %d\n", trips, sum - 3, (int)sizeof(MAX(vc, vll)), acc);
+    return 0;
+}
