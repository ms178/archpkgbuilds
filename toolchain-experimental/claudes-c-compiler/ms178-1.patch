+        }
+        let Some((b, i)) = def[v] else { continue };
+        func.blocks[b].instructions[i].for_each_used_value(|id| {
+            let u = id as usize;
+            if let Some(n) = uses.get_mut(u) {
+                *n = n.saturating_sub(1);
+                if *n == 0 && !dead[u] && removable(def[u]) {
+                    work.push(u);
+                }
