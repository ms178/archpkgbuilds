+
+inv_fail=0
+inv_count=0
+while read -r row hex; do
+    [ -n "$row" ] || continue
+    sse="$(awk -v r="$row" '$1 == r {print $2}' <<<"$ROWS_SSE")"
+    # A row absent at -msse4.1 (the 256-bit family) is not a discrepancy.
+    [ -n "$sse" ] || continue
