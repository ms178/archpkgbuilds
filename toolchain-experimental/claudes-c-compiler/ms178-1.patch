+                    Instruction::BinOp {
+                        dest: Value(3),
+                        op: IrBinOp::Sub,
+                        lhs: Operand::Value(Value(1)),
+                        rhs: Operand::Const(IrConst::I64(8)),
+                        ty: IrType::I64,
+                    },
+                    Instruction::Load {
+                        dest: Value(4),
+                        ptr: Value(2),
+                        ty: IrType::U8,
+                        volatile: false,
+                        seg_override: Default::default(),
+                    },
+                    Instruction::BinOp {
+                        dest: Value(5),
+                        op: IrBinOp::Add,
+                        lhs: Operand::Value(Value(2)),
+                        rhs: Operand::Const(IrConst::I64(8)),
+                        ty: IrType::I64,
+                    },
+                    Instruction::Copy {
+                        dest: Value(1),
+                        src: Operand::Value(Value(3)),
+                    },
+                    Instruction::Copy {
+                        dest: Value(2),
+                        src: Operand::Value(Value(5)),
+                    },
+                ],
+                Terminator::CondBranch {
+                    cond: Operand::Value(Value(4)),
+                    true_label: BlockId(1),
