+        | (1 << 29)
+        | (0b01110 << 24)
+        | (size << 22)
+        | (1 << 21)
+        | (1 << 16)
+        | (0b001110 << 10)
+        | (rn << 5)
+        | rd;
+    Ok(EncodeResult::Word(word))
