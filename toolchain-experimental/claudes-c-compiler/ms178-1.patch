+C
+! "$CCC" -std=gnu17 -fsyntax-only "$t/ch_bad.c" 2>"$t/ch_e"
+[ "$(grep -c "first argument to '__builtin_choose_expr' not a constant" "$t/ch_e")" = 15 ]
