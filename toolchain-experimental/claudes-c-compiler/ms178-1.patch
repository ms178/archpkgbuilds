From 8bc216e60fa2fca4d5cc931a740b614b32728a43 Mon Sep 17 00:00:00 2001
From: lccc-v3 <v3@localhost>
Date: Thu, 13 Aug 2026 15:59:31 +0000
Subject: [PATCH 2/4] v3: fold auto-vectorizer Vec* ops through the defer-aware
 binary emitters

The auto-vectorizer's Vec Load/Add/Mul emitters previously bypassed the
register-cache / deferred-store machinery entirely, using raw slot addressing,
so every vector op in a reduction loop round-tripped through the stack
(~10 instrs per F64 sum iteration, ~17 per dot).

Changes:
- VecAdd*/VecMul* (F64/F32/I32, 128+256) now route through
  emit_avx_binary_256 / emit_sse_binary_128 (memory-operand folding +
  register cache + deferred stores).
- VecLoad* stores through avx_store_dest / sse_store_dest so a single-use
  load can be deferred and folded by the next op.
- compute_vector_defer_values registers Vec* SSA dest producers (they use
  dest, not the dest_ptr alloca the analysis keyed on).
- VecAdd*/VecMul* removed from is_raw_reader_intrinsic and added to
  is_two_operand_binary (they are cache-aware consumers now).
- resolve_slot_addr treats vector_values/vector128_values as Direct slots
  (the slot holds the vector data, not a pointer) - fixes the leaq+indirect
  load round-trip.

Result: F64 sum loop 10 -> 8 instrs/iter; F64 sum/dot now match GCC
(0.623s vs 0.621s; 0.250s vs 0.249s) while remaining correct across all
suites (regression 126/126, correctness 50/50, intrinsics 3/3).
---
 src/backend/stack_layout/copy_coalescing.rs |  49 +++-
 src/backend/state.rs                        |  17 +-
 src/backend/x86/codegen/intrinsics.rs       | 267 +++-----------------
 3 files changed, 83 insertions(+), 250 deletions(-)

diff --git a/src/backend/stack_layout/copy_coalescing.rs b/src/backend/stack_layout/copy_coalescing.rs
index 7a27d2ae..7d0c6bc4 100644
--- a/src/backend/stack_layout/copy_coalescing.rs
+++ b/src/backend/stack_layout/copy_coalescing.rs
@@ -1204,16 +1204,12 @@ pub(crate) fn is_raw_reader_intrinsic(op: &crate::ir::intrinsics::IntrinsicOp) -
             | O::VecLoadI32x8
             | O::VecLoadF32x4
             | O::VecLoadF32x8
-            | O::VecAddF64x2
-            | O::VecAddF64x4
-            | O::VecAddI32x4
-            | O::VecAddI32x8
-            | O::VecAddF32x4
-            | O::VecAddF32x8
-            | O::VecMulF64x2
-            | O::VecMulF64x4
-            | O::VecMulF32x4
-            | O::VecMulF32x8
+            // VecAdd*/VecMul* are NOT raw readers: they are cache-aware
+            // two-operand binaries whose codegen goes through
+            // emit_avx_binary_256 / emit_sse_binary_128 (v3), so they can
+            // consume a deferred single-use load from the register cache and
+            // fold the other operand as a memory operand. VecLoad*/VecZero*/
+            // VecHorizontalAdd* stay raw (pointer/scalar operands).
             | O::VecHorizontalAddF64x2
             | O::VecHorizontalAddF64x4
             | O::VecHorizontalAddI32x4
@@ -1261,6 +1257,10 @@ fn is_two_operand_binary(op: &crate::ir::intrinsics::IntrinsicOp) -> bool {
         | O::Pmaxub256 | O::Pminub256
         | O::Pxor256 | O::Por256 | O::Pand256
         | O::AddF64x4 | O::MulF64x4 | O::AddI32x8
+        | O::VecAddF64x4 | O::VecMulF64x4 | O::VecAddI32x8
+        | O::VecAddF32x8 | O::VecMulF32x8
+        | O::VecAddF64x2 | O::VecMulF64x2 | O::VecAddI32x4
+        | O::VecAddF32x4 | O::VecMulF32x4
     )
 }
 
@@ -1418,6 +1418,35 @@ pub(super) fn compute_vector_defer_values(func: &IrFunction) -> FxHashSet<u32> {
                     def_blocks.entry(d.0).or_default().insert(bi);
                 }
             }
+            // v3: the auto-vectorizer's Vec* intrinsics produce their result as
+            // an SSA `dest` (not a `dest_ptr` alloca). Register those defs too,
+            // so a single-use VecLoad result can have its slot store deferred
+            // and its consumer (VecAdd/VecMul) can fold it. VecZero*/VecLoad*/
+            // VecAdd*/VecMul* all write a home slot for `dest`.
+            if let Instruction::Intrinsic {
+                dest: Some(d), op, ..
+            } = inst
+            {
+                use crate::ir::intrinsics::IntrinsicOp as O;
+                let is_vec_producer = matches!(
+                    op,
+                    O::VecLoadF64x2 | O::VecLoadF64x4
+                        | O::VecLoadI32x4 | O::VecLoadI32x8
+                        | O::VecLoadF32x4 | O::VecLoadF32x8
+                        | O::VecAddF64x2 | O::VecAddF64x4
+                        | O::VecAddI32x4 | O::VecAddI32x8
+                        | O::VecAddF32x4 | O::VecAddF32x8
+                        | O::VecMulF64x2 | O::VecMulF64x4
+                        | O::VecMulF32x4 | O::VecMulF32x8
+                        | O::VecZeroF64x2 | O::VecZeroF64x4
+                        | O::VecZeroI32x4 | O::VecZeroI32x8
+                        | O::VecZeroF32x4 | O::VecZeroF32x8
+                );
+                if is_vec_producer {
+                    defs.entry(d.0).or_default().push((bi, ii));
+                    def_blocks.entry(d.0).or_default().insert(bi);
+                }
+            }
         }
     }
 
