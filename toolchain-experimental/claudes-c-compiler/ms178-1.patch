@@ -31,13 +36,13 @@ for src in "$dir"/*.c; do
   if $CCC $CCCFLAGS "$src" $extra_flags -o "/tmp/ccc_${name}" 2>/tmp/ccc_err.txt; then
     /tmp/ccc_${name} >/tmp/ccc_out.txt 2>&1; rc=$?
