+            name.clone(),
+            LinkerSymbol {
+                address: value as u32,
+                size: 0,
+                sym_type: STT_NOTYPE,
+                binding: STB_GLOBAL,
+                visibility: STV_DEFAULT,
+                is_defined: true,
+                needs_plt: false,
+                needs_got: false,
+                output_section: usize::MAX,
