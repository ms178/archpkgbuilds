+/// Evaluate a character constant the way GCC 16.2 does, returning its value as
+/// an `#if` operand.  `i` points at the opening quote and is left just past the
+/// closing one.
+///
+/// The previous implementation read exactly one byte and then skipped to the
+/// closing quote, which made every multi-character constant equal to its first
+/// character -- and since `#if` treats a non-zero result as true, code that
+/// compares multichar constants (the clang corpus's `expr_multichar.c`, and
+/// real code that packs fourccs) silently took the wrong branch instead of
+/// failing loudly.  Measured against gcc-16.2.0:
+///
+///   '1234'          -> 0x31323334
+///   '\x61\xff'       -> 0x000061ff     (each byte unsigned in a multichar)
+///   'abcde'         -> 0x62636465     (only the last four bytes are kept)
+///   '\xff'           -> -1             (a *single* character is sign-extended
+///                                      from `char`, which is signed on x86)
+///   '\u00e9'         -> 0xc3a9         (a UCN contributes its UTF-8 bytes)
+///   '\101', '\0', '\n' handled as octal / simple escapes
+fn parse_char_constant(bytes: &[u8], i: &mut usize) -> i64 {
+    let len = bytes.len();
+    *i += 1; // opening quote
+    let mut value: u32 = 0;
+    let mut count = 0usize;
+    while *i < len && bytes[*i] != b'\'' {
+        let byte = if bytes[*i] == b'\\' {
+            match parse_escape(bytes, i) {
+                // A UCN may encode to several bytes; feed each in turn.
+                EscapeResult::Bytes(bs) => {
+                    for b in bs {
+                        value = value.wrapping_shl(8) | b as u32;
+                        count += 1;
+                    }
+                    None
+                }
+                EscapeResult::Byte(b) => Some(b),
+            }
+        } else {
+            let b = bytes[*i];
+            *i += 1;
+            Some(b)
+        };
+        if let Some(b) = byte {
+            value = value.wrapping_shl(8) | b as u32;
+            count += 1;
+        }
+    }
+    if *i < len {
+        *i += 1; // closing quote
+    }
+    if count == 0 {
+        return 0;
+    }
+    if count == 1 {
+        // A single character has type int and is the value of the `char` it
+        // denotes; on targets where plain char is signed, '\xff' is -1.
+        let v = (value & 0xff) as u8;
+        if crate::common::types::target_char_is_signed() && v >= 0x80 {
+            return (v as i8) as i64;
+        }
+        return v as i64;
+    }
+    // Multi-character: the value is the last four bytes, big-endian, as an
+    // `int` (so 0xffffffff is -1).
+    (value & 0xffff_ffff) as i32 as i64
+}
+
+/// Result of an escape sequence: one byte, or several (a UCN's UTF-8 encoding).
+enum EscapeResult {
+    Byte(u8),
+    Bytes(Vec<u8>),
+}
+
+/// Parse one escape sequence.  `i` points at the backslash and is advanced past
+/// the sequence.
+fn parse_escape(bytes: &[u8], i: &mut usize) -> EscapeResult {
+    let len = bytes.len();
+    *i += 1; // backslash
+    if *i >= len {
+        return EscapeResult::Byte(0);
+    }
+    let c = bytes[*i];
+    *i += 1;
+    let simple = match c {
+        b'n' => Some(b'\n'),
+        b't' => Some(b'\t'),
+        b'r' => Some(b'\r'),
+        b'a' => Some(0x07),
+        b'b' => Some(0x08),
+        b'f' => Some(0x0C),
+        b'v' => Some(0x0B),
+        b'\\' => Some(b'\\'),
+        b'\'' => Some(b'\''),
+        b'"' => Some(b'"'),
+        b'?' => Some(b'?'),
+        b'e' => Some(0x1B), // GNU extension
+        _ => None,
+    };
+    if let Some(b) = simple {
+        return EscapeResult::Byte(b);
+    }
+    if c == b'x' {
+        let mut v: u32 = 0;
+        let mut any = false;
+        while *i < len {
+            let d = bytes[*i];
+            let nib = match d {
+                b'0'..=b'9' => (d - b'0') as u32,
+                b'a'..=b'f' => (d - b'a' + 10) as u32,
+                b'A'..=b'F' => (d - b'A' + 10) as u32,
+                _ => break,
+            };
+            v = v.wrapping_shl(4) | nib;
+            *i += 1;
+            any = true;
+        }
+        if !any {
+            return EscapeResult::Byte(b'x');
+        }
+        return EscapeResult::Byte((v & 0xff) as u8);
+    }
+    if c.is_ascii_digit() && c < b'8' {
+        // Octal, one to three digits; the first is already consumed.
+        let mut v: u32 = (c - b'0') as u32;
+        let mut n = 1;
+        while n < 3 && *i < len && (b'0'..=b'7').contains(&bytes[*i]) {
+            v = v.wrapping_shl(3) | (bytes[*i] - b'0') as u32;
+            *i += 1;
+            n += 1;
+        }
+        return EscapeResult::Byte((v & 0xff) as u8);
+    }
+    if c == b'u' || c == b'U' {
+        let want = if c == b'u' { 4 } else { 8 };
+        let mut v: u32 = 0;
+        let mut n = 0;
+        while n < want && *i < len {
+            let d = bytes[*i];
+            let nib = match d {
+                b'0'..=b'9' => (d - b'0') as u32,
+                b'a'..=b'f' => (d - b'a' + 10) as u32,
+                b'A'..=b'F' => (d - b'A' + 10) as u32,
+                _ => break,
+            };
+            v = v.wrapping_shl(4) | nib;
+            *i += 1;
+            n += 1;
+        }
+        // A universal character name in a narrow character constant
+        // contributes its UTF-8 encoding: '\u00e9' is 0xc3a9.
+        let mut buf = [0u8; 4];
+        let ch = char::from_u32(v).unwrap_or('\u{fffd}');
+        let encoded = ch.encode_utf8(&mut buf);
+        return EscapeResult::Bytes(encoded.as_bytes().to_vec());
+    }
+    EscapeResult::Byte(c)
+}
