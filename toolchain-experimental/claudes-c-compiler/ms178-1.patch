+            v.extend_from_slice(names);
+            SkipGuard(mark)
+        })
+    }
+
+    pub(super) fn extend(set: &mut crate::common::fx_hash::FxHashSet<String>) {
+        SKIPS.with(|s| set.extend(s.borrow().iter().map(|n| (*n).to_string())));
