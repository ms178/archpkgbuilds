+        });
+    }
+    for val_id in &non_ptr_uses {
+        map.remove(val_id);
+    }
+    for val_id in &type_incompat {
+        map.remove(val_id);
+    }
+    map.retain(|val_id, _| {
+        (*val_id as usize) < use_counts.len() && use_counts[*val_id as usize] > 0
+    });
