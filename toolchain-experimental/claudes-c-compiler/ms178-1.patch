+#!/usr/bin/env bash
+# Fast, fail-closed executable contracts distilled from the a9987d0 audit.
+# No remote oracle, hardware feature assumptions, or unbounded hung programs.
+set -euo pipefail
+cd "$(dirname "$0")/../.."
+ccc=${CCC:-target/fastbuild/lccc}
+cc=${CC:-gcc}
+td=$(mktemp -d)
+trap 'rm -rf "$td"' EXIT
+python3 scripts/test_audit_levkropp_since.py
+for name in swar_intermediate_casts count_zero_intermediate_casts cmp_select_fusion_stale_cond loop_memory_promote_alias_load; do
+    src=tests/regression/$name.c
+    timeout 60 "$cc" -O2 "$src" -o "$td/ref"
+    timeout 10 "$td/ref" > "$td/expected"
+    for opt in -O0 -O1 -O2 -O3; do
+        timeout 60 "$ccc" "$opt" "$src" -o "$td/check"
+        if ! timeout 10 "$td/check" > "$td/actual"; then
+            echo "FAIL: $name $opt (nonzero exit or timeout)" >&2
+            cat "$td/actual" >&2
+            exit 1
+        fi
+        diff -u "$td/expected" "$td/actual"
+    done
+    echo "PASS: $name (-O0/-O1/-O2/-O3; executable checks + GCC stdout)"
+done
+# Compile-only ISA contract: no host POPCNT capability is needed. The
+# positive canonical idiom must still fold; truncated stages must not.
+timeout 60 "$ccc" -O2 -march=x86-64-v3 -S tests/regression/swar_intermediate_casts.c -o "$td/code.s"
+python3 - "$td/code.s" <<'PY'
+from pathlib import Path
+import re
+import sys
+text = Path(sys.argv[1]).read_text()
+for name in ("swar_full", "swar_low16", "swar_low8", "swar_stage1", "swar_stage2"):
+    body = re.search(r"^" + name + r":\n(.*?)^\.size\s+" + name + r"\b", text, re.M | re.S)
+    if body is None:
+        raise SystemExit("FAIL: missing assembly body " + name)
+    count = len(re.findall(r"^\s*popcnt\w*\s", body[1], re.M))
+    if count != (1 if name == "swar_full" else 0):
+        raise SystemExit("FAIL: unexpected POPCNT in " + name)
+print("PASS: canonical POPCNT retained, no unsound truncated-stage folds")
+PY
diff --git a/tests/regression/cmp_select_fusion_stale_cond.c b/tests/regression/cmp_select_fusion_stale_cond.c
new file mode 100644
index 0000000..0cf5a97
--- /dev/null
+++ b/tests/regression/cmp_select_fusion_stale_cond.c
@@ -0,0 +1,46 @@
+/* Salvaged from levkropp/lccc a9987d0; strengthened with executable checks. */
+/* Regression: cmp+select fusion (backend/generation.rs detect_cmp_select_fusion)
+ * used to move the flag-setting compare from the Cmp's IR position to the
+ * Select's, with no adjacency requirement. Intervening instructions could
+ * legally recycle the compare operand's physical register, so the fused
+ * `cmp reg, #0` tested a stale value — here the (a^b)&0x80 condition is
+ * clobbered by the intervening cast/and feeding the inner select, and the
+ * outer select always picks the ±1 arm instead of preserving `res`.
+ * sqlite's vdbeSorterCompareInt mis-sorted records exactly like this.
+ * Correct output: -7 7 1 0
+ */
+extern int printf(const char *, ...);
+
+__attribute__((noinline)) int cmp_bytes(const unsigned char *p1, const unsigned char *p2, int n) {
+    int res = 0;
+    for (int i = 0; i < n; i++) {
+        if ((res = p1[i] - p2[i]) != 0) {
+            if (((p1[0] ^ p2[0]) & 0x80) != 0) {
+                res = (p1[0] & 0x80) ? -1 : +1;
+            }
+            break;
+        }
+    }
+    return res;
+}
+
+int main(void) {
+    unsigned char a[2] = {8, 15};
+    unsigned char b[2] = {15, 8};
+    unsigned char c[2] = {8, 8};
+    printf("%d %d %d %d\n",
+           cmp_bytes(a, b, 2), cmp_bytes(b, a, 2),
+           cmp_bytes(a, b, 2) != 0, cmp_bytes(c, c, 2));
+    /* Independent scalar oracle, all byte pairs and a second-byte mismatch.
+     * Runtime data and noinline prevent constant folding the interesting body. */
+    for (unsigned i = 0; i < 256; i++) {
+        for (unsigned j = 0; j < 256; j++) {
+            unsigned char x[2] = {(unsigned char)i, 15};
+            unsigned char y[2] = {(unsigned char)j, 8};
+            int want = i == j ? 7 : (i < 128) != (j < 128) ? (i < 128 ? 1 : -1) : (int)i - (int)j;
+            if (cmp_bytes(x, y, 2) != want || cmp_bytes(x, x, 2) != 0 ||
+                cmp_bytes(x, y, 0) != 0) return 1;
+        }
+    }
+    return 0;
+}
diff --git a/tests/regression/count_zero_intermediate_casts.c b/tests/regression/count_zero_intermediate_casts.c
new file mode 100644
index 0000000..646bc4e
--- /dev/null
+++ b/tests/regression/count_zero_intermediate_casts.c
@@ -0,0 +1,65 @@
+/* a9987d0 red-team: Select traversal dropped truncations between count-zero
+ * stages. clz_trunc(2) was 30 instead of 31; ctz_trunc(0x10000) must be 31.
+ * Native idiom controls and independent bit-at-a-time expectations included. */
+extern int printf(const char *, ...);
+
+#define CLZ(name, mid) \
+__attribute__((noinline)) unsigned name(unsigned x) { \
+    unsigned n=0; \
+    if (x<=0xffffu) {n+=16; x<<=16;} \
+    mid; \
+    if (x<=0xffffffu) {n+=8; x<<=8;} \
+    if (x<=0xfffffffu) {n+=4; x<<=4;} \
+    if (x<=0x3fffffffu) {n+=2; x<<=2;} \
+    if (x<=0x7fffffffu) n++; \
+    return n; \
+}
+CLZ(clz_full, )
+CLZ(clz_trunc, x=(unsigned short)x)
+
+#define CTZ(name, mid) \
+__attribute__((noinline)) unsigned name(unsigned long long x) { \
+    unsigned n=0; \
+    if (!(x&0xffffffffull)) {n+=32; x>>=32;} \
+    mid; \
+    if (!(x&0xffffull)) {n+=16; x>>=16;} \
+    if (!(x&0xffull)) {n+=8; x>>=8;} \
+    if (!(x&0xfull)) {n+=4; x>>=4;} \
+    if (!(x&3ull)) {n+=2; x>>=2;} \
+    if (!(x&1ull)) n++; \
+    return n; \
+}
+CTZ(ctz_full, )
+CTZ(ctz_trunc, x=(unsigned short)x)
+
+__attribute__((noinline)) unsigned ref_clz(unsigned x) {
+    unsigned n=0;
+    while (n<31 && !(x&0x80000000u)) {n++; x<<=1;}
+    return n;
+}
+__attribute__((noinline)) unsigned ref_ctz(unsigned long long x, unsigned limit) {
+    unsigned n=0;
+    while (n<limit && !(x&1ull)) {n++; x>>=1;}
+    return n;
+}
+int main(void) {
+    unsigned state=123456789u;
+    for (unsigned i=0; i<4096; i++) {
+        state=state*1664525u+1013904223u;
+        unsigned x=i==0 ? 2u : i<34 ? (i==1 ? 0u : 1u<<(i-2)) : state;
+        unsigned long long y=i<64 ? 1ull<<i : ((unsigned long long)x<<32)|state;
+        if (i==64) y=0;
+        unsigned base=(y&0xffffffffull) ? 0 : 32;
+        unsigned long long low=(y>>base)&0xffffull;
+        unsigned want_clz=x<=0xffffu ? 31 : 15;
+        unsigned want_ctz=base+ref_ctz(low,31);
+        if (clz_full(x)!=ref_clz(x) || clz_trunc(x)!=want_clz ||
+            ctz_full(y)!=ref_ctz(y,63) || ctz_trunc(y)!=want_ctz) {
+            printf("FAIL %08x %llx: clz=%u/%u ctz=%u/%u\n",x,y,
+                   clz_trunc(x),want_clz,ctz_trunc(y),want_ctz);
+            return 1;
+        }
+    }
+    printf("PASS: 4096 count-zero inputs, four shapes\n");
+    return 0;
+}
diff --git a/tests/regression/loop_memory_promote_alias_load.c b/tests/regression/loop_memory_promote_alias_load.c
new file mode 100644
index 0000000..f4d9303
--- /dev/null
+++ b/tests/regression/loop_memory_promote_alias_load.c
@@ -0,0 +1,44 @@
+/* Salvaged from levkropp/lccc a9987d0; strengthened with executable checks. */
+extern int printf(const char *, ...);
+extern void *memset(void *, int, unsigned long);
+extern char *strcpy(char *, const char *);
+
+/* Regression: loop_memory_promote must not promote a loop-carried store when
+ * another loop load reaches the same address through a different pointer value
+ * (e.g. duplicate GEPs hoisted by LICM). The unpromoted loads kept reading
+ * stale memory, so the decrement never became visible and the loop spun
+ * forever (sqlite3FpDecode trailing-zero trim, sqlite workload hang).
+ * Correct output: n=0 (three trailing zeros trimmed; n==0 stops it). */
+typedef struct {
+    int flags;
+    int n;
+    char *z;
+    char zBuf[24];
+} FpD;
+
+__attribute__((noinline)) void trim_zeros(FpD *p) {
+    p->z = &p->zBuf[1];
+    while (p->n > 0 && p->z[p->n - 1] == '0') {
+        p->n--;
+    }
+}
+
+int main(void) {
+    FpD p;
+    memset(&p, 0, sizeof(p));
+    p.n = 3;
+    strcpy(p.zBuf, "x000");
+    trim_zeros(&p);
+    printf("n=%d\n", p.n);
+    if (p.n != 0) return 1;
+    /* Include zero-trip, all-zero, no-zero and partially trimmed strings. */
+    for (int n = 0; n < 20; n++) {
+        for (int keep = 0; keep <= n; keep++) {
+            p.n = n;
+            for (int i = 0; i < n; i++) p.zBuf[i+1] = i < keep ? 'x' : '0';
+            trim_zeros(&p);
+            if (p.n != keep || p.z != p.zBuf + 1) return 2;
+        }
+    }
+    return 0;
+}
diff --git a/tests/regression/swar_intermediate_casts.c b/tests/regression/swar_intermediate_casts.c
new file mode 100644
index 0000000..dde874c
--- /dev/null
+++ b/tests/regression/swar_intermediate_casts.c
@@ -0,0 +1,42 @@
+/* a9987d0 red-team audit: masks do not justify peeling intermediate casts.
+ * Before the fix, low16(UINT_MAX) returned 32 instead of 16 at -O2.
+ * Keep functions externally visible and noinline to prevent test folding.
+ * Defined unsigned arithmetic only. No system headers / LP64 assumptions. */
+extern int printf(const char *, ...);
+
+#define SWAR(name, cast1, cast2, cast3) \
+__attribute__((noinline)) unsigned name(unsigned x) { \
+    x = cast1 (x - ((x >> 1) & 0x55555555u)); \
+    x = cast2 ((x & 0x33333333u) + ((x >> 2) & 0x33333333u)); \
+    x = cast3 (x + (x >> 4)) & 0x0f0f0f0fu; \
+    return (x * 0x01010101u) >> 24; \
+}
+SWAR(swar_full, , , )
+SWAR(swar_low16, , , (unsigned short))
+SWAR(swar_low8, , , (unsigned char))
+SWAR(swar_stage1, (unsigned short), , )
+SWAR(swar_stage2, , (unsigned short), )
+
+__attribute__((noinline)) unsigned count_bits(unsigned x, unsigned width) {
+    unsigned n = 0;
+    for (unsigned i = 0; i < width; i++) n += (x >> i) & 1u;
+    return n;
+}
+
+int main(void) {
+    unsigned state = 0x12345678u;
+    for (unsigned i = 0; i < 4096; i++) {
+        state = state * 1664525u + 1013904223u;
+        unsigned x = i == 0 ? ~0u : i == 1 ? 0u : i < 34 ? 1u << (i-2) : state;
+        unsigned full = count_bits(x, 32), low16 = count_bits(x, 16), low8 = count_bits(x, 8);
+        if (swar_full(x) != full || swar_low16(x) != low16 || swar_low8(x) != low8 ||
+            swar_stage1(x) != low16 || swar_stage2(x) != low16) {
+            printf("FAIL %08x: %u %u %u %u %u (expected %u %u %u)\n", x,
+                   swar_full(x), swar_low16(x), swar_low8(x), swar_stage1(x),
+                   swar_stage2(x), full, low16, low8);
+            return 1;
+        }
+    }
+    printf("PASS: 4096 SWAR inputs, five shapes\n");
+    return 0;
+}
