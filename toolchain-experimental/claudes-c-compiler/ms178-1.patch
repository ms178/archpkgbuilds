+fn eval_typed_int_cmp(
+    op: crate::ir::reexports::IrCmpOp,
+    lhs: i64,
+    rhs: i64,
+    ty: crate::common::types::IrType,
+) -> Option<bool> {
+    use crate::common::types::IrType;
+    let (ls, rs, lu, ru): (i64, i64, u64, u64) = match ty {
+        IrType::I8 | IrType::U8 => (
+            (lhs as i8) as i64,
+            (rhs as i8) as i64,
+            (lhs as u8) as u64,
+            (rhs as u8) as u64,
+        ),
+        IrType::I16 | IrType::U16 => (
+            (lhs as i16) as i64,
+            (rhs as i16) as i64,
+            (lhs as u16) as u64,
+            (rhs as u16) as u64,
+        ),
+        IrType::I32 | IrType::U32 => (
+            (lhs as i32) as i64,
+            (rhs as i32) as i64,
+            (lhs as u32) as u64,
+            (rhs as u32) as u64,
+        ),
+        IrType::I64 | IrType::U64 | IrType::Ptr => (lhs, rhs, lhs as u64, rhs as u64),
+        _ => return None,
+    };
+    use crate::ir::reexports::IrCmpOp;
+    Some(match op {
+        IrCmpOp::Eq => lu == ru,
+        IrCmpOp::Ne => lu != ru,
+        IrCmpOp::Slt => ls < rs,
+        IrCmpOp::Sle => ls <= rs,
+        IrCmpOp::Sgt => ls > rs,
+        IrCmpOp::Sge => ls >= rs,
+        IrCmpOp::Ult => lu < ru,
+        IrCmpOp::Ule => lu <= ru,
+        IrCmpOp::Ugt => lu > ru,
+        IrCmpOp::Uge => lu >= ru,
+    })
+}
