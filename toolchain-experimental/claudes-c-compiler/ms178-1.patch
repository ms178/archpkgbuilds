diff --git a/scripts/check_no_ub_exploitation.py b/scripts/check_no_ub_exploitation.py
new file mode 100644
index 00000000..007968a9
--- /dev/null
+++ b/scripts/check_no_ub_exploitation.py
@@ -0,0 +1,144 @@
+#!/usr/bin/env python3
+"""Invariant: this compiler does not exploit undefined behaviour, so the flags
+that *would* change meaning if it did may stay tolerated.
+
+`-fno-strict-aliasing`, `-fwrapv` and `-fno-strict-overflow` are accepted with a
+diagnostic rather than refused, because ignoring them cannot change the meaning
+of the program **as this compiler currently optimises**: it performs no
+type-based alias analysis, so `-fno-strict-aliasing` has nothing to switch off,
+and it emits no signed-overflow or `inbounds`-style poison, so `-fwrapv` /
+`-fno-strict-overflow` have nothing to constrain.
+
+That reasoning is a property of the *optimizer*, not of the flags, and nothing
+in the type system ties the two together: the day someone lands TBAA or
+poison-based overflow, those tolerated spellings silently become miscompiles.
+This check is the tie.  It fails the moment a UB-exploiting concept appears in
+`src/`, so that whoever lands it is told, in the failure message, which option
+policy has to move with it.
+
+Why a source scan rather than a test: the absence of a concept cannot be
+asserted from inside the program (a passing test suite says nothing about code
+that was deleted, and a linter cannot see a new IR flag), while a scan over the
+tree is deterministic, fast, and impossible to satisfy accidentally.
+
+Comment lines are ignored: the policy comments name these concepts on purpose,
+and a check that fired on its own documentation would be deleted within a week.
+`--selftest` pins that rule (a hit in code fails, the same text in a comment
+does not).
+
+Usage: scripts/check_no_ub_exploitation.py [--root DIR] [--selftest]
+Exit 0 = no UB-exploiting concept is present, 1 = one is (message printed),
+2 = setup error.
+"""
+from __future__ import annotations
+
+import argparse
+import re
+import sys
+from pathlib import Path
+
+# Canonical spellings of the two concepts the option tolerance depends on.
+# Deliberately narrow: a bare `poison` appears 70 times in this tree meaning
+# "mark this state unusable", which is not the LLVM poison value, so matching
+# it would make the check noise rather than a tripwire.
+PATTERNS: tuple[tuple[str, str], ...] = (
+    (r"\btbaa\b", "type-based alias analysis metadata (TBAA)"),
+    (r"\bTBAA\b", "type-based alias analysis metadata (TBAA)"),
+    (r"\bstrict_alias\w*\b", "strict-aliasing-based optimisations"),
+    (r"\btype_based_alias\w*\b", "type-based alias analysis"),
+    (r"\bnsw\b", "no-signed-wrap arithmetic flags (poison)"),
+    (r"\bnuw\b", "no-unsigned-wrap arithmetic flags (poison)"),
+    (r"\bNoSignedWrap\b", "no-signed-wrap arithmetic flags (poison)"),
+    (r"\bNoUnsignedWrap\b", "no-unsigned-wrap arithmetic flags (poison)"),
+    (r"\binbounds\b", "inbounds-gep reasoning (poison)"),
+)
+
+MESSAGE = """\
+UB-exploiting concept found: {what}
+  {path}:{line}: {text}
+
+This compiler tolerates `-fno-strict-aliasing`, `-fwrapv` and
+`-fno-strict-overflow` *because* it does not exploit undefined behaviour
+(see docs/builtin-libcall-policy.md, "Option contract", and the comment at
+`unknown_option_tolerated` in src/driver/cli.rs).
+
+Landing {what} breaks that precondition. Before this check can pass again,
+those three spellings must move from the tolerated tier to the contract tier in
+the driver's option policy (refused, or implemented), and the docs table must
+say so -- otherwise a build that passes one of them gets an optimisation
+behaviour it explicitly asked not to have.
+"""
+
+
+def scan(root: Path) -> list[str]:
+    """Report every hit of an UB-exploiting concept outside a comment."""
+    compiled = [(re.compile(pattern), what) for pattern, what in PATTERNS]
+    findings: list[str] = []
+    for path in sorted(root.rglob("*.rs")):
+        for number, line in enumerate(path.read_text(encoding="utf-8", errors="replace")
+                                      .splitlines(), start=1):
+            stripped = line.lstrip()
+            # A comment cannot implement anything. `///`, `//!`, `//` and a
+            # line inside a block comment are all documentation.
+            if stripped.startswith("//") or stripped.startswith("*"):
+                continue
+            for regex, what in compiled:
+                if regex.search(line):
+                    findings.append(MESSAGE.format(what=what, path=path,
+                                                   line=number, text=line.strip()[:100]))
+                    break
+    return findings
+
+
+def selftest() -> int:
+    """The scanner must fire on code and must not fire on the same text in a comment."""
+    import tempfile
+
+    cases = (
+        ("clean.rs", "fn f() -> i32 { 1 }\n", 0),
+        ("code_hit.rs", "let x = Flag::NoSignedWrap;\n", 1),
+        ("comment_hit.rs", "// we deliberately have no tbaa metadata\n", 0),
+        ("doc_hit.rs", "/// `-fwrapv` is tolerated: no nsw flags exist\n", 0),
+        ("block_hit.rs", " * inbounds reasoning is not implemented\n", 0),
+        ("tbaa_code.rs", "fn alias_class() -> u8 { 0 } // tbaa\nfn real() { let _tbaa = 1; }\n", 1),
+    )
+    failures = 0
+    with tempfile.TemporaryDirectory(prefix="ub_invariant_selftest_") as tmp:
+        for name, text, expected in cases:
+            (Path(tmp) / name).write_text(text)
+            got = len(scan(Path(tmp)))
+            ok = got == expected
+            print(f"  {'ok  ' if ok else 'FAIL'} {name}: expected {expected} finding(s), got {got}")
+            failures += 0 if ok else 1
+            (Path(tmp) / name).unlink()
+    print(f"self-test: {'PASS' if not failures else f'{failures} FAILED'}")
+    return 1 if failures else 0
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__,
+                                     formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--root", default=str(Path(__file__).resolve().parents[1] / "src"),
+                        help="source tree to scan (default: src/)")
+    parser.add_argument("--selftest", action="store_true",
+                        help="verify the scanner's own code-vs-comment rule")
+    args = parser.parse_args()
+
+    if args.selftest:
+        return selftest()
+
+    root = Path(args.root)
+    if not root.is_dir():
+        print(f"setup error: no source tree at {root}", file=sys.stderr)
+        return 2
+
+    findings = scan(root)
+    if findings:
+        print("\n".join(findings))
+        return 1
+    print(f"ub-exploitation invariant: ok ({len(PATTERNS)} patterns, no hits outside comments)")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
