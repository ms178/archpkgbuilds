+                self.bytes.push(opcode);
+                let rc = self.relocations.len();
+                self.encode_modrm_mem(dst_num, mem)?;
+                self.bytes.push(src2_num << 4);
+                self.adjust_rip_reloc_addend(rc, 0);
+                Ok(())
