+//type: fn
+//options:  --c
+// RUN: %clang_cc1 -fsyntax-only -verify %s
+
+void foo(void) {
+  int a;
+  __builtin_prefetch(&a);
+  __builtin_prefetch(&a, 1);
+  __builtin_prefetch(&a, 1, 2);
+  __builtin_prefetch(&a, 1, 9, 3); // expected-error{{too many arguments to function}}
