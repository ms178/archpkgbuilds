+
+    def test_old_todo_would_fail_the_structural_ratchet(self) -> None:
+        synthetic = "fn f() {\n    " + OLD_TODO + "\n    CType::Int\n}\n"
+        self.assertIn(OLD_TODO, synthetic)
+        self.assertNotIn("recovery-only", synthetic)
