diff --git a/tests/regression/run_ifconv_arm_budget_switch.sh b/tests/regression/run_ifconv_arm_budget_switch.sh
new file mode 100755
index 0000000..981c451
--- /dev/null
+++ b/tests/regression/run_ifconv_arm_budget_switch.sh
@@ -0,0 +1,101 @@
+#!/usr/bin/env bash
+# `LCCC_IFCONV_ARM_BUDGET` is an A/B lever, so its CONTRACT is the only thing
+# keeping measurements comparable: `=1` must really tighten the loop-aware
+# budget, `off`/`full` must both disable it, and an unparsable value must be
+# ignored rather than aborting a build.  Without a gate, a refactor can move
+# the accessor and silently change all four answer sets, and every A/B number
+# taken afterwards is a number about a different compiler.
+#
+# It also pins WHERE the switch is resolved.  A pipeline-wide switch belongs at
+# the pipeline boundary (`src/passes/mod.rs`), which the env-read ratchet in
+# `tests/regression/check_env_test_hygiene.sh` deliberately excludes; reading it
+# from the pass body (`src/passes/if_convert.rs`) put the ratchet one over its
+# budget the moment the switch landed.  Both halves are checked, because moving
+# the read back into the pass would satisfy neither.
+set -euo pipefail
+
+repo=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
+cd "$repo"
+
+ccc=${CCC:-target/fastbuild/lccc}
+[ -x "$ccc" ] || { echo "SKIP: $ccc not built" >&2; exit 0; }
+
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+# A loop-resident diamond whose arms the default budget accepts and the
+# strictest budget refuses: measured, not assumed -- the `=1` row below asserts
+# the difference, so a kernel that stopped exercising the switch fails here
+# instead of passing vacuously.
+cat >"$tmp/kernel.c" <<'EOF'
+int clamp_step(int v, int lo, int hi) {
+    int r = v;
+    if (r < lo) r = lo;
+    if (r > hi) r = hi;
+    return r;
+}
+long mix(const int *p, long n, long acc) {
+    for (long i = 0; i < n; i++) {
+        int v = p[i];
+        int a = v & 7;
+        int b = (v >> 3) & 7;
+        int s = a + b;
+        int d = a - b;
+        acc += (s > d) ? s : d;
+        acc ^= (v > 0) ? (long)v : -(long)v;
+        acc += clamp_step(v, -100, 100);
+    }
+    return acc;
+}
+EOF
+
+emit() { # emit <label> [VALUE]
+    local label=$1 value=${2-}
+    if [ -n "$value" ]; then
+        LCCC_IFCONV_ARM_BUDGET="$value" "$ccc" -O2 -S "$tmp/kernel.c" -o "$tmp/$label.s"
+    else
+        env -u LCCC_IFCONV_ARM_BUDGET "$ccc" -O2 -S "$tmp/kernel.c" -o "$tmp/$label.s"
+    fi
+}
+
+emit default
+emit off off
+emit full full
+emit one 1
+emit zero 0
+emit junk banana
+
+same() { cmp -s "$tmp/$1.s" "$tmp/$2.s"; }
+
+# `off` and `full` are two spellings of "disable the loop-aware restriction".
+same off full || fail "LCCC_IFCONV_ARM_BUDGET=off and =full disagree"
+
+# An unparsable value and the documented-as-default `0` must be inert: the
+# build succeeds (it did, or `set -e` would already have ended the run) and the
+# code is byte-identical to the default configuration.
+same junk default || fail "an unparsable LCCC_IFCONV_ARM_BUDGET changed the code"
+same zero default || fail "LCCC_IFCONV_ARM_BUDGET=0 must mean 'default', not 'never convert'"
+
+# The numeric value must actually reach the budget: `=1` is the strictest arm
+# budget, so it may only ever refuse conversions relative to the default.
+if same one default; then
+    fail "LCCC_IFCONV_ARM_BUDGET=1 produced the default code: the switch is not applied"
+fi
+if [ "$(grep -c cmov "$tmp/one.s")" -gt "$(grep -c cmov "$tmp/default.s")" ]; then
+    fail "LCCC_IFCONV_ARM_BUDGET=1 converted MORE diamonds than the default budget"
+fi
+
+# Where the switch is resolved: at the pipeline boundary, not in the pass.
+# `if_convert.rs` legitimately reads its own trace switches; the BUDGET switch
+# is pipeline configuration, and a read of it there is what pushed the ratchet
+# over budget when it landed.
+grep -q 'fn ifconv_arm_budget_override' src/passes/mod.rs ||
+    fail "the accessor must live in src/passes/mod.rs (pipeline configuration)"
+if grep -n 'LCCC_IFCONV_ARM_BUDGET' src/passes/if_convert.rs >&2; then
+    fail "if_convert.rs reads LCCC_IFCONV_ARM_BUDGET directly: the accessor" \
+         "belongs in src/passes/mod.rs, which the env-read ratchet excludes"
+fi
+
+echo "PASS: LCCC_IFCONV_ARM_BUDGET pins its four answer sets and its home"
diff --git a/tests/regression/run_matmul_sse2_fallback.sh b/tests/regression/run_matmul_sse2_fallback.sh
new file mode 100755
index 0000000..5e42d2e
--- /dev/null
+++ b/tests/regression/run_matmul_sse2_fallback.sh
@@ -0,0 +1,193 @@
+#!/usr/bin/env bash
+# Emission + semantics gate for the two-wide (SSE2) matmul arm.
+#
+# WHY THIS EXISTS
+# ---------------
+# The matmul arm's only two-wide lowering used to be the fused one
+# (`FmaF64x2Hoisted` -> `vfmadd231pd` / `fmla`), so the contraction
+# precondition `fp_contract == fast && -mfma` also decided whether the loop was
+# vectorized AT ALL.  When plain x86-64 (SSE2, no FMA3) became the default
+# codegen baseline, every matmul stencil on a default `-O2` build silently went
+# scalar: the benchmark's N=1024 kernel ran 601 ms where the same source at
+# `-march=x86-64-v3` ran 278 ms and GCC 16.2 ran 361 ms.  Nothing failed -- the
+# transform simply declined, with a diagnostic only under
+# `LCCC_DEBUG_VECTORIZE`.
+#
+# A refused contraction is not a refusal to vectorize.  This gate pins the
+# matrix of that contract, by EMISSION and by EXECUTED RESULT:
+#
+#   default (plain x86-64)        packed `mulpd`/`addpd`, no FMA, no ymm
+#   -mno-fma                      same (a denied unit is not a denied vector)
+#   -ffp-contract=off             same (a withdrawn licence keeps the packing)
+#   -march=x86-64-v3              fused `vfmadd231pd` on 256-bit vectors
+#   -march=x86-64-v3 -mno-fma     `vmulpd` + `vaddpd`, still 256-bit, no FMA
+#   -march=x86-64-v3 -ffp-contract=off
+#                                 `vmulpd` + `vaddpd`, still 256-bit, no FMA
+#   -mno-sse                      REFUSES the FP translation unit (x87 is not
+#                                 implemented) -- it must never fall back to
+#                                 emitting SSE for a kernel TU
+#
+# Every compiling configuration is also RUN and must print the same hash as the
+# scalar reference, except where the rounding genuinely differs: the two
+# fused configurations must print a DIFFERENT hash from the two-rounding ones,
+# which is what proves the rounding choice is observable in this data (and
+# therefore that the in-source `volatile` reference has teeth).
+set -u -o pipefail
+
+repo=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)
+ccc=${CCC:-$repo/target/fastbuild/lccc}
+src=$repo/tests/regression/vectorize_matmul_sse2_baseline.c
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+
+fail=0
+count() { # count <regex> <file>
+    grep -cE "$1" "$2" 2>/dev/null || true
+}
+check_eq() { # check_eq <desc> <actual> <expected>
+    if [ "$2" != "$3" ]; then
+        echo "FAIL: $1 -- got '$2', want '$3'" >&2
+        fail=1
+    fi
+}
+check_gt0() { # check_gt0 <desc> <actual>
+    if [ "$2" -eq 0 ] 2>/dev/null; then
+        echo "FAIL: $1 -- expected a non-zero count, got 0" >&2
+        fail=1
+    fi
+}
+
+# build <label> [flags...]: asm + binary, no diagnostics expected.
+build() {
+    local label=$1
+    shift
+    if ! "$ccc" -O2 "$@" -S "$src" -o "$tmp/$label.s" 2> "$tmp/$label.err"; then
+        echo "FAIL: $label -- compile (asm) failed" >&2
+        sed -n '1,5p' "$tmp/$label.err" >&2
+        fail=1
+        return 1
+    fi
+    if [ -s "$tmp/$label.err" ]; then
+        echo "FAIL: $label -- unexpected diagnostics:" >&2
+        sed -n '1,5p' "$tmp/$label.err" >&2
+        fail=1
+    fi
+    if ! "$ccc" -O2 "$@" "$src" -o "$tmp/$label.bin" 2>> "$tmp/$label.err"; then
+        echo "FAIL: $label -- link failed" >&2
+        fail=1
+        return 1
+    fi
+    if [ -s "$tmp/$label.err" ]; then
+        echo "FAIL: $label -- unexpected diagnostics (link):" >&2
+        sed -n '1,5p' "$tmp/$label.err" >&2
+        fail=1
+    fi
+    if ! "$tmp/$label.bin" > "$tmp/$label.out" 2>&1; then
+        echo "FAIL: $label -- execution failed:" >&2
+        sed -n '1,5p' "$tmp/$label.out" >&2
+        fail=1
+        return 1
+    fi
+    if ! grep -qx 'OK' "$tmp/$label.out"; then
+        echo "FAIL: $label -- self-check did not report OK:" >&2
+        sed -n '1,5p' "$tmp/$label.out" >&2
+        fail=1
+    fi
+    return 0
+}
+
+hash_of() { head -1 "$tmp/$1.out"; }
+
+# ── packed, unfused, 128-bit ─────────────────────────────────────────────────
+# The default baseline is the configuration the regression shipped in.
+if build baseline; then
+    check_gt0 "baseline: packed mul" "$(count '\bmulpd\b' "$tmp/baseline.s")"
+    check_gt0 "baseline: packed add" "$(count '\baddpd\b' "$tmp/baseline.s")"
+    check_eq "baseline: no FMA (no FMA3 on x86-64 v1)" \
+        "$(count '\bvfmadd[0-9]*p[sd]\b|\bvfmsub[0-9]*p[sd]\b|\bvmulpd\b|\bvaddpd\b' \
+           "$tmp/baseline.s")" 0
+    check_eq "baseline: no 256-bit vector register" \
+        "$(count '%ymm' "$tmp/baseline.s")" 0
+fi
+
+if build no_fma -mno-fma; then
+    check_gt0 "mno-fma: packed mul" "$(count '\bmulpd\b' "$tmp/no_fma.s")"
+    check_eq "mno-fma: no packed FMA" \
+        "$(count '\bvfmadd[0-9]*p[sd]\b' "$tmp/no_fma.s")" 0
+    check_eq "mno-fma: no 256-bit vector register" \
+        "$(count '%ymm' "$tmp/no_fma.s")" 0
+fi
+
+if build contract_off -ffp-contract=off; then
+    check_gt0 "ffp-contract=off: packed mul" "$(count '\bmulpd\b' "$tmp/contract_off.s")"
+    check_gt0 "ffp-contract=off: packed add" "$(count '\baddpd\b' "$tmp/contract_off.s")"
+    check_eq "ffp-contract=off: no packed FMA" \
+        "$(count '\bvfmadd[0-9]*p[sd]\b' "$tmp/contract_off.s")" 0
+    check_eq "ffp-contract=off: no 256-bit vector register" \
+        "$(count '%ymm' "$tmp/contract_off.s")" 0
+fi
+
+# ── 256-bit ─────────────────────────────────────────────────────────────────
+# The fused path is unchanged by the baseline fix; it must stay exactly what it
+# was (`vfmadd231pd` on ymm), and it is the only configuration whose numerical
+# result may differ from the two-rounding ones.
+if build v3 -march=x86-64-v3; then
+    check_gt0 "x86-64-v3: fused FMA" "$(count '\bvfmadd231pd\b' "$tmp/v3.s")"
+    check_gt0 "x86-64-v3: 256-bit vectors" "$(count '%ymm' "$tmp/v3.s")"
+fi
+
+if build v3_no_fma -march=x86-64-v3 -mno-fma; then
+    check_gt0 "x86-64-v3 -mno-fma: packed mul" "$(count '\bvmulpd\b' "$tmp/v3_no_fma.s")"
+    check_gt0 "x86-64-v3 -mno-fma: packed add" "$(count '\bvaddpd\b' "$tmp/v3_no_fma.s")"
+    check_eq "x86-64-v3 -mno-fma: no packed FMA" \
+        "$(count '\bvfmadd[0-9]*p[sd]\b' "$tmp/v3_no_fma.s")" 0
+fi
+
+if build v3_contract_off -march=x86-64-v3 -ffp-contract=off; then
+    check_gt0 "x86-64-v3 ffp-contract=off: packed mul" \
+        "$(count '\bvmulpd\b' "$tmp/v3_contract_off.s")"
+    check_eq "x86-64-v3 ffp-contract=off: no packed FMA" \
+        "$(count '\bvfmadd[0-9]*p[sd]\b' "$tmp/v3_contract_off.s")" 0
+fi
+
+# ── the one direction that must not vectorize ──────────────────────────────
+# `-mno-sse` (the kernel's flag set) removes the xmm file, so no packed form is
+# legal.  FP has no x87 lowering here, so the TU must be refused outright --
+# what must NEVER happen is a silent SSE-emitted object.
+if "$ccc" -O2 -mno-sse -S "$src" -o "$tmp/mno_sse.s" 2> "$tmp/mno_sse.err"; then
+    if [ -s "$tmp/mno_sse.s" ]; then
+        if [ "$(count '\b(mulpd|addpd|movupd|movsd)\b' "$tmp/mno_sse.s")" != 0 ]; then
+            echo "FAIL: -mno-sse emitted SSE instructions" >&2
+            fail=1
+        fi
+    fi
+else
+    if ! grep -qE 'requires SSE|regs-only' "$tmp/mno_sse.err"; then
+        echo "FAIL: -mno-sse refused the FP unit without the documented diagnostic:" >&2
+        sed -n '1,5p' "$tmp/mno_sse.err" >&2
+        fail=1
+    fi
+fi
+
+# ── the rounding choice is observable ──────────────────────────────────────
+if [ -s "$tmp/baseline.out" ] && [ -s "$tmp/v3.out" ]; then
+    if [ "$(hash_of baseline)" = "$(hash_of v3)" ]; then
+        echo "FAIL: fused and two-rounding builds produced the same hash;" \
+             "the reference loop no longer distinguishes them" >&2
+        fail=1
+    fi
+fi
+for cfg in no_fma contract_off v3_no_fma v3_contract_off; do
+    if [ -s "$tmp/$cfg.out" ] && [ -s "$tmp/baseline.out" ]; then
+        if [ "$(hash_of $cfg)" != "$(hash_of baseline)" ]; then
+            echo "FAIL: $cfg must round twice, like the baseline" \
+                 "($(hash_of $cfg) != $(hash_of baseline))" >&2
+            fail=1
+        fi
+    fi
+done
+
+if [ "$fail" -eq 0 ]; then
+    echo "matmul SSE2 baseline gates: PASS"
+fi
+exit "$fail"
diff --git a/tests/regression/run_sse2_slot_forwarding.sh b/tests/regression/run_sse2_slot_forwarding.sh
new file mode 100755
index 0000000..764aa42
--- /dev/null
+++ b/tests/regression/run_sse2_slot_forwarding.sh
@@ -0,0 +1,189 @@
+#!/usr/bin/env bash
+# End-to-end gate for 16-byte XMM slot forwarding.
+#
+# WHY THIS EXISTS
+# ---------------
+# `store_forwarding::global_store_forwarding` forwards an XMM slot store into a
+# later reload of the same slot.  Until `MoveSize::DQ` existed it only knew the
+# scalar widths (`movsd|movss|movq|movd`), so the 16-byte round trip that an
+# `__m128*` value makes when it briefly leaves its register was emitted
+# verbatim:
+#
+#     movdqu %xmm0, 48(%rsp)
+#     ...
+#     movdqu 48(%rsp), %xmm0
+#
+# The unit tests in `store_forwarding.rs` prove the *pass* refuses and accepts
+# the right shapes.  They cannot prove the pass fires on what the backend
+# actually emits, because that depends on the frame layout, on which
+# instructions the frontend produces, and on the peephole phase order.  This
+# gate compiles real C and asserts on the assembly: a slot reload that follows
+# its own slot store inside one basic block must be gone.
+#
+# The second half is the regression that matters more than the first: the
+# forwarding must never change an observable bit, so every configuration is also
+# executed and compared against an independently computed reference hash.
+#
+# SOUNDNESS CONTRACT PINNED HERE
+#   * a 16-byte reload of a 16-byte store forwards (no `movdqu slot, %xmmN`
+#     survives when the register still holds the value);
+#   * an 8-byte reload of a 16-byte home forwards to `movq %xmmS, %xmmD` (the
+#     register form zeroes bits 64..127 exactly like the load does);
+#   * a same-register reload at 16 bytes is deleted only when it is a no-op --
+#     at 8 bytes the upper-lane zeroing is observable and the load must stay
+#     (the unit test `fp_store_fp_load_same_register_keeps_zeroing` owns the
+#     precise rule; this gate pins the end-to-end consequence).
+set -u -o pipefail
+
+repo=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)
+ccc=${CCC:-$repo/target/fastbuild/lccc}
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+
+fail=0
+fail() { echo "FAIL: $*" >&2; fail=1; }
+
+# ---------------------------------------------------------------------------
+# 1. The round trip the aggregate ABI produces.
+# ---------------------------------------------------------------------------
+cat >"$tmp/relay.c" <<'EOF'
+#include <emmintrin.h>
+
+/* The shape every inlined `__always_inline__` SSE wrapper leaves behind: the
+   16-byte aggregate value leaves its register for a frame slot and comes back
+   before its next use.  Nothing here is volatile or address-taken, so the slot
+   is a pure relay and the compiler owns every byte of it. */
+__attribute__((noinline)) void relay16(const void *restrict a, void *restrict o, int n)
+{
+    for (int i = 0; i + 16 <= n; i += 16) {
+        __m128d x = _mm_loadu_pd((const double *)((const char *)a + i));
+        __m128d y;
+        y = x;                       /* the aggregate copy under test */
+        y = _mm_add_pd(y, x);
+        _mm_storeu_pd((double *)((char *)o + i), y);
+    }
+}
+
+/* The narrower reload: an 8-byte scalar read of a home a 16-byte store wrote. */
+__attribute__((noinline)) double narrow_reload(const void *restrict a, int n)
+{
+    double acc = 0.0;
+    for (int i = 0; i + 16 <= n; i += 16) {
+        __m128d x = _mm_loadu_pd((const double *)((const char *)a + i));
+        __m128d y = x;
+        y = _mm_mul_pd(y, x);
+        acc += _mm_cvtsd_f64(y) + _mm_cvtsd_f64(x);
+    }
+    return acc;
+}
+
+#include <stdio.h>
+static double A[256] __attribute__((aligned(16)));
+static double O[256] __attribute__((aligned(16)));
+
+static unsigned long long fnv(const unsigned char *p, unsigned long n)
+{
+    unsigned long long h = 1469598103934665603ULL;
+    for (unsigned long i = 0; i < n; i++) { h ^= p[i]; h *= 1099511628211ULL; }
+    return h;
+}
+
+int main(void)
+{
+    for (int i = 0; i < 256; i++) A[i] = (double)((i * 37) % 101) - 50.5;
+    relay16(A, O, 256);
+    printf("relay16 %llx\n", fnv((unsigned char *)O, sizeof O));
+    printf("narrow %.17g\n", narrow_reload(A, 256));
+    return 0;
+}
+EOF
+
+for opt in -O2 -O3; do
+    if ! "$ccc" "$opt" -S -o "$tmp/relay$opt.s" "$tmp/relay.c" 2>"$tmp/err"; then
+        fail "lccc $opt -S failed: $(cat "$tmp/err")"
+        continue
+    fi
+
+    # Within one basic block, a 16-byte reload of the very slot the previous
+    # 16-byte store wrote is exactly the pattern the forwarder deletes.
+    python3 - "$tmp/relay$opt.s" "$opt" <<'PY' || fail=1
+import re
+import sys
+
+path, opt = sys.argv[1], sys.argv[2]
+lines = [l.strip() for l in open(path)]
+# Function bodies only: stop at the epilogue marker of each function.
+store = re.compile(r"^(movdqu|movups|movdqa|movaps|movapd)\s+%xmm(\d+),\s*(.+)\(%rsp\)$")
+load = re.compile(r"^(movdqu|movups|movdqa|movaps|movapd)\s+(.+)\(%rsp\),\s*%xmm(\d+)$")
+bad = []
+for i, l in enumerate(lines):
+    m = store.match(l)
+    if not m:
+        continue
+    reg, slot = m.group(2), m.group(3)
+    for j in range(i + 1, min(i + 24, len(lines))):
+        t = lines[j]
+        if t.startswith(".") and "cfi" not in t:
+            break
+        if re.match(r"^j|^ret|^call", t):
+            break
+        # Any other write to the register ends the window.
+        if re.search(r"%xmm" + reg + r"\s*$", t) and not t.startswith("movdq"):
+            break
+        m2 = load.match(t)
+        if m2 and m2.group(3) == reg and m2.group(2) == slot:
+            bad.append((i + 1, l, j + 1, t))
+            break
+if bad:
+    for i, s, j, t in bad:
+        print(f"{opt}: slot round trip survived: line {i}: {s}  ->  line {j}: {t}")
+    sys.exit(1)
+PY
+
+    # The aligned half must never be invented, and the 16-byte moves that
+    # remain must be real loads/stores, not self moves.
+    if grep -qE '^\s+movdqu %xmm([0-9]+), %xmm\1$' "$tmp/relay$opt.s"; then
+        fail "$opt: a 16-byte self move was emitted"
+    fi
+done
+
+# ---------------------------------------------------------------------------
+# 2. Differential execution: the rewrite must be bit-exact.
+# ---------------------------------------------------------------------------
+if ! "$ccc" -O2 -o "$tmp/lccc.exe" "$tmp/relay.c" 2>"$tmp/err"; then
+    fail "lccc -O2 link failed: $(cat "$tmp/err")"
+else
+    got=$("$tmp/lccc.exe") || fail "lccc binary failed to run"
+    # Reference: same source through the pinned GCC 16.2 oracle when present.
+    gcc_bin=${GCC:-gcc-16}
+    if command -v "$gcc_bin" >/dev/null 2>&1; then
+        if "$gcc_bin" -O2 -fno-tree-vectorize -o "$tmp/gcc.exe" "$tmp/relay.c" 2>"$tmp/err"; then
+            want=$("$tmp/gcc.exe") || fail "oracle binary failed to run"
+            if [ "$got" != "$want" ]; then
+                fail "differential mismatch against $gcc_bin -O2 (scalar):
+  lccc: $got
+  $gcc_bin: $want"
+            fi
+        else
+            fail "oracle compile failed: $(cat "$tmp/err")"
+        fi
+    fi
+    # The forwarding-off configuration must produce the same bits too: the
+    # rewrite is an optimization, never a semantic change.
+    if CCC_NO_XMM_SF=1 "$ccc" -O2 -o "$tmp/nosf.exe" "$tmp/relay.c" 2>"$tmp/err"; then
+        nosf=$("$tmp/nosf.exe") || fail "CCC_NO_XMM_SF binary failed to run"
+        if [ "$got" != "$nosf" ]; then
+            fail "forwarding changed the result:
+  with: $got
+  CCC_NO_XMM_SF=1: $nosf"
+        fi
+    else
+        fail "forwarding-disabled compile failed: $(cat "$tmp/err")"
+    fi
+fi
+
+if [ "$fail" -ne 0 ]; then
+    echo "sse2 slot forwarding gate: FAIL" >&2
+    exit 1
+fi
+echo "sse2 slot forwarding gate: PASS"
diff --git a/tests/regression/run_sse2_truncating_convert.sh b/tests/regression/run_sse2_truncating_convert.sh
new file mode 100755
index 0000000..e8e67b3
--- /dev/null
+++ b/tests/regression/run_sse2_truncating_convert.sh
@@ -0,0 +1,186 @@
+#!/usr/bin/env bash
+# `_mm_cvttsd_si32` / `_mm_cvttss_si32` must TRUNCATE regardless of MXCSR.
+#
+# WHY THIS EXISTS
+# ---------------
+# The headers used to route both truncating conversions through the *rounding*
+# forms:
+#
+#     _mm_cvttsd_si32(a)  ->  cvtsd2si   (rounds per MXCSR.RC)
+#     _mm_cvttss_si32(a)  ->  cvtss2si   (rounds per MXCSR.RC)
+#
+# Even round-to-nearest distinguishes them for fractional inputs (2.7 -> 3
+# versus 2). Other rounding modes and negative inputs exercise both directions:
+#
+#     MXCSR.RC = 1 (round down),   2.7 -> cvtt* gives 2, cvt* gives 2
+#     MXCSR.RC = 2 (round up),     2.7 -> cvtt* gives 2, cvt* gives 3   <-- bug
+#     MXCSR.RC = 3 (round toward 0), same as default for positive values
+#
+# C says nothing about MXCSR, but the intrinsic's contract does: `cvttsd2si`
+# truncates by definition, and a program that sets the rounding mode (every
+# `fesetround` user) must not see the intrinsic change behaviour.  GCC and
+# Clang both emit `cvttsd2si`; this gate pins that LCCC does too, by running
+# the conversion under all four rounding modes and by checking the encoding.
+set -u -o pipefail
+
+repo=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)
+ccc=${CCC:-$repo/target/fastbuild/lccc}
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+
+fail=0
+fail() { echo "FAIL: $*" >&2; fail=1; }
+
+cat >"$tmp/trunc.c" <<'EOF'
+#include <emmintrin.h>
+#include <stdio.h>
+
+/* Set MXCSR.RC (bits 13:14) to `mode` and return the previous value. */
+static unsigned set_rc(unsigned mode)
+{
+    unsigned old;
+    __asm__ volatile("stmxcsr %0" : "=m"(old));
+    unsigned updated = (old & ~(3u << 13)) | ((mode & 3u) << 13);
+    __asm__ volatile("ldmxcsr %0" : : "m"(updated) : "memory");
+    return old;
+}
+
+static void restore(unsigned v)
+{
+    __asm__ volatile("ldmxcsr %0" : : "m"(v) : "memory");
+}
+
+int main(void)
+{
+    const double dv[4] = {2.7, -2.7, 0.9, -0.9};
+    const float fv[4] = {2.7f, -2.7f, 0.9f, -0.9f};
+    const int rounded_values[4][4] = {
+        {3, -3, 1, -1}, {2, -3, 0, -1},
+        {3, -2, 1, 0}, {2, -2, 0, 0}
+    };
+    int bad = 0;
+    for (unsigned mode = 0; mode < 4; mode++) {
+        unsigned old = set_rc(mode);
+        for (int i = 0; i < 4; i++) {
+            __m128d d = _mm_set_sd(dv[i]);
+            int got = _mm_cvttsd_si32(d);
+            int want = (int)dv[i];
+            if (got != want) {
+                printf("FAIL sd rc=%u %g -> %d (want %d)\n", mode, dv[i], got, want);
+                bad = 1;
+            }
+            __m128 f = _mm_set_ss(fv[i]);
+            got = _mm_cvttss_si32(f);
+            want = (int)fv[i];
+            if (got != want) {
+                printf("FAIL ss rc=%u %g -> %d (want %d)\n", mode, (double)fv[i], got, want);
+                bad = 1;
+            }
+            if (_mm_cvttsd_si64(d) != (long long)dv[i]
+                || _mm_cvttss_si64(f) != (long long)fv[i]) {
+                printf("FAIL 64-bit truncation rc=%u index=%d\n", mode, i);
+                bad = 1;
+            }
+            if (_mm_cvtsd_si32(d) != rounded_values[mode][i]
+                || _mm_cvtss_si32(f) != rounded_values[mode][i]
+                || _mm_cvtsd_si64(d) != rounded_values[mode][i]
+                || _mm_cvtss_si64(f) != rounded_values[mode][i]) {
+                printf("FAIL rounded conversion rc=%u index=%d\n", mode, i);
+                bad = 1;
+            }
+        }
+        restore(old);
+    }
+    /* And the ROUNDING forms must still round: this is what proves the two
+       families were not merged into one implementation. */
+    unsigned old = set_rc(2); /* round up */
+    __m128d d = _mm_loadu_pd((const double[]){2.7, 0.0});
+    int rounded = _mm_cvtsd_si32(d);
+    restore(old);
+    if (rounded != 3) {
+        printf("FAIL _mm_cvtsd_si32 must round per MXCSR (round-up 2.7 -> %d)\n", rounded);
+        bad = 1;
+    }
+    /* 64-bit forms: the ROUNDING conversions must round per MXCSR and must
+       keep the full range. A tie (`2.5`) rounds to even under the default
+       mode, which is what distinguishes `cvtsd2si` from the old
+       `d +/- 0.5` composition (that gave 3). */
+    {
+        __m128d t = _mm_set_sd(2.5);
+        __m128d n = _mm_set_sd(-2.5);
+        __m128d big = _mm_set_sd(4503599627370496.5); /* 2^52 + 0.5 */
+        long long a = _mm_cvtsd_si64(t);
+        long long b = _mm_cvtsd_si64(n);
+        long long c = _mm_cvtsd_si64(big);
+        if (a != 2 || b != -2 || c != 4503599627370496LL) {
+            printf("FAIL _mm_cvtsd_si64 round-per-MXCSR: %lld %lld %lld\n", a, b, c);
+            bad = 1;
+        }
+        __m128 fs = _mm_set_ss(2.7f);
+        if (_mm_cvtss_si64(fs) != 3) {
+            printf("FAIL _mm_cvtss_si64 must round (2.7f -> %lld)\n", _mm_cvtss_si64(fs));
+            bad = 1;
+        }
+        /* ...and the truncating 64-bit forms must NOT round. */
+        if (_mm_cvttsd_si64(_mm_set_sd(2.7)) != 2) {
+            printf("FAIL _mm_cvttsd_si64 must truncate\n");
+            bad = 1;
+        }
+        if (_mm_cvttss_si64(_mm_set_ss(2.7f)) != 2) {
+            printf("FAIL _mm_cvttss_si64 must truncate\n");
+            bad = 1;
+        }
+    }
+    if (!bad) {
+        puts("trunc-ok");
+    }
+    return bad;
+}
+EOF
+
+# 1. Encoding: the truncating forms must be `cvtt*2si`, not `cvt*2si`.
+if ! "$ccc" -O2 -S -o "$tmp/trunc.s" "$tmp/trunc.c" 2>"$tmp/err"; then
+    fail "lccc -S failed: $(cat "$tmp/err")"
+else
+    for mn in cvttsd2si cvttss2si cvtsd2si cvtss2si; do
+        if ! grep -qE "^\s+$mn\b" "$tmp/trunc.s"; then
+            fail "the emitted assembly has no '$mn' — the truncating form was not used"
+        fi
+    done
+    # Both families must be present: the source deliberately exercises the
+    # rounding forms too, so a count ratio is not the invariant -- the
+    # per-mode runtime checks below are.
+    if ! grep -qE '^\s+cvt(sd|ss)2si\b' "$tmp/trunc.s"; then
+        fail "the emitted assembly has no rounding conversion (cvt*2si) at all"
+    fi
+fi
+
+# 2. Behaviour under every rounding mode.
+if ! "$ccc" -O2 -o "$tmp/lccc.exe" "$tmp/trunc.c" 2>"$tmp/err"; then
+    fail "lccc link failed: $(cat "$tmp/err")"
+else
+    out=$("$tmp/lccc.exe") || fail "binary failed: $out"
+    case "$out" in
+        *trunc-ok*) ;;
+        *) fail "runtime check failed:
+$out" ;;
+    esac
+    gcc_bin=${GCC:-gcc-16}
+    if command -v "$gcc_bin" >/dev/null 2>&1; then
+        if ! "$gcc_bin" -O2 -o "$tmp/gcc.exe" "$tmp/trunc.c" 2>"$tmp/err"; then
+            fail "oracle compile failed: $(cat "$tmp/err")"
+        elif ! want=$("$tmp/gcc.exe"); then
+            fail "oracle execution failed: $want"
+        elif [ "$want" != "$out" ]; then
+            fail "differential mismatch against $gcc_bin:
+  lccc:  $out
+  $gcc_bin: $want"
+        fi
+    fi
+fi
+
+if [ "$fail" -ne 0 ]; then
+    echo "sse2 truncating-conversion gate: FAIL" >&2
+    exit 1
+fi
+echo "sse2 truncating-conversion gate: PASS"
diff --git a/tests/regression/vector_frame_slot_upper_half.c b/tests/regression/vector_frame_slot_upper_half.c
new file mode 100644
index 0000000..7c9a8e4
--- /dev/null
+++ b/tests/regression/vector_frame_slot_upper_half.c
@@ -0,0 +1,139 @@
+/* A 32-byte GNU vector built lane by lane must survive its frame slot.
+ *
+ * The defect this pins: the peephole classifier described every vector slot
+ * move as 16 bytes, because it derived the footprint from the mnemonic
+ * (`vmovdqu`) instead of from the register operand.  The never-read-store
+ * pass therefore believed the top half of a 32-byte slot was not read, deleted
+ * the stores that fill it, and the function returned a vector whose lanes
+ * 16..31 were whatever the slot held.  Every shape below builds its result in
+ * memory at some point -- lane-wise shifts, per-lane mul, lane extraction,
+ * nine-argument spills -- and the frame slot is 32 bytes wide in all of them.
+ *
+ * The functions are deliberately NON-STATIC and NOINLINE.  Inlining them
+ * removes the frame slot (the value stays in registers), and a static
+ * definition is inlined even at -O0-adjacent levels, so a corpus of statics
+ * passes with or without the fix -- measured: the defect reproduces only for
+ * out-of-line definitions at -O2 -mavx2.
+ *
+ * This file is compiler-independent: it needs no reference compiler, no
+ * ISA flags beyond x86-64, and no measurement.  It prints PASS or FAIL.
+ */
+#include <stdio.h>
+#include <string.h>
+
+typedef char v32c __attribute__((vector_size(32)));
+typedef short v32s __attribute__((vector_size(32)));
+typedef long v32l __attribute__((vector_size(32)));
+
+/* Per-lane variable shift: lanes are extracted from, and re-inserted into, a
+ * 32-byte object, which is the shape that allocates the wide slot. */
+__attribute__((noinline)) v32c vec_shl32c(v32c a, v32c b) { return a << b; }
+__attribute__((noinline)) v32s vec_shl32s(v32s a, v32s b) { return a << b; }
+__attribute__((noinline)) v32l vec_mul32l(v32l a, v32l b) { return a * b; }
+
+/* Lane read out of a 32-byte argument slot (MEMORY class below AVX here). */
+__attribute__((noinline)) long vec_lane2(v32l a) { return a[2]; }
+
+/* Lane insert: the value is staged through the same 32-byte slot. */
+__attribute__((noinline)) v32l vec_setlane2(v32l a, long x) { a[2] = x; return a; }
+
+/* Nine vector arguments: the ninth is passed on the stack, so the frame holds
+ * a 32-byte incoming argument area as well as the result slot. */
+__attribute__((noinline)) v32l vec_nine(v32l a, v32l b, v32l c, v32l d, v32l e,
+                                       v32l f, v32l g, v32l h, v32l i) {
+    return a + b + c + d + e + f + g + h + i;
+}
+
+/* A 32-byte value stored and reloaded through a named object. */
+__attribute__((noinline)) v32l vec_roundtrip(v32l a) {
+    v32l slot;
+    memcpy(&slot, &a, sizeof slot);
+    slot[1] = slot[1] + 1;
+    return slot;
+}
+
+static int fails;
+
+static void expect_bytes(const char *what, const void *got, const void *want,
+                         size_t n) {
+    if (memcmp(got, want, n) != 0) {
+        printf("FAIL: %s\n", what);
+        fails++;
+    }
+}
+
+int main(void) {
+    /* Lane values chosen so that a truncated upper half is unmistakable: the
+     * low half is all ones and the high half carries a distinct pattern. */
+    v32c ca, cb;
+    for (int i = 0; i < 32; i++) {
+        ca[i] = (char)(i * 3 + 1);
+        cb[i] = (char)(i % 5);
+    }
+    v32c cr = vec_shl32c(ca, cb);
+    for (int i = 0; i < 32; i++) {
+        char want = (char)((unsigned char)ca[i] << cb[i]);
+        if (cr[i] != want) {
+            printf("FAIL: v32c shift lane %d: %d != %d\n", i, cr[i], want);
+            fails++;
+            break;
+        }
+    }
+
+    v32s sa, sb;
+    for (int i = 0; i < 16; i++) {
+        sa[i] = (short)(i * 17 + 3);
+        sb[i] = (short)(i % 4);
+    }
+    v32s sr = vec_shl32s(sa, sb);
+    for (int i = 0; i < 16; i++) {
+        short want = (short)((unsigned short)sa[i] << sb[i]);
+        if (sr[i] != want) {
+            printf("FAIL: v32s shift lane %d: %d != %d\n", i, sr[i], want);
+            fails++;
+            break;
+        }
+    }
+
+    v32l la = {11, 22, 33, 44};
+    if (vec_lane2(la) != 33) {
+        printf("FAIL: lane2 = %ld, want 33 (upper-half lane read)\n",
+               vec_lane2(la));
+        fails++;
+    }
+
+    v32l parts[9];
+    v32l want_sum = {0, 0, 0, 0};
+    for (int i = 0; i < 9; i++) {
+        for (int k = 0; k < 4; k++) {
+            parts[i][k] = i * 4 + k;
+            want_sum[k] += parts[i][k];
+        }
+    }
+    v32l got_sum = vec_nine(parts[0], parts[1], parts[2], parts[3], parts[4],
+                            parts[5], parts[6], parts[7], parts[8]);
+    expect_bytes("nine-argument sum", &got_sum, &want_sum, sizeof got_sum);
+
+    v32l rt = vec_roundtrip(la);
+    v32l want_rt = {11, 23, 33, 44};
+    expect_bytes("memcpy round trip", &rt, &want_rt, sizeof rt);
+
+    /* Per-lane multiply over 64-bit lanes: the product of two 32-byte
+     * arguments, computed from lane extracts. */
+    v32l ma = {2, 3, 5, 7}, mb = {11, 13, 17, 19};
+    v32l want_mul = {22, 39, 85, 133};
+    v32l got_mul = vec_mul32l(ma, mb);
+    expect_bytes("v32l per-lane multiply", &got_mul, &want_mul, sizeof got_mul);
+
+    /* Lane insert into the upper half. */
+    v32l want_set = {11, 22, 99, 44};
+    v32l got_set = vec_setlane2(la, 99);
+    expect_bytes("lane insert at index 2", &got_set, &want_set, sizeof got_set);
+
+    if (fails) {
+        printf("FAIL: %d check(s)\n", fails);
+        return 1;
+    }
+    printf("PASS: 32-byte frame slots keep every lane\n");
+    return 0;
+}
