+            assert_eq!(
+                parse_reg_num(name),
+                Some(*num),
+                "`{name}` must resolve to register {num}"
+            );
+            assert_eq!(
+                gp_reg_width(name).unwrap_or_else(|e| panic!("`{name}`: {e}")),
+                *width,
+                "`{name}` must be {width}-bit"
+            );
+        }
