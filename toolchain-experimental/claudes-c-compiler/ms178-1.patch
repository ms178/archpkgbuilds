+                    && !from_ty.is_128bit() && !to_ty.is_128bit()
+                    && !from_ty.is_long_double() && !to_ty.is_long_double()
+                    && !matches!(from_ty, IrType::I8 | IrType::U8 | IrType::I16 | IrType::U16)
+                    && !matches!(to_ty, IrType::I8 | IrType::U8 | IrType::I16 | IrType::U16) =>
