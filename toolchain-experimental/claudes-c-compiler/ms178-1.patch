+    /// CCMP/CTEST EVEX: P1.vvvv is the DFV bitmap **not inverted**; P2[3:0] is SCC.
+    /// ND/NF/v4 are unused (must be 0).
+    pub(crate) fn emit_evex_ccmp(
+        &mut self,
+        r: bool,
+        x: bool,
+        b: bool,
+        r4: bool,
+        x4: bool,
+        b4: bool,
+        w: bool,
+        dfv: u8,
+        scc: u8,
+        pp: u8,
+    ) {
+        let mut p0 = 0x04u8;
+        if !r {
+            p0 |= 0x80;
+        }
+        if !x {
+            p0 |= 0x40;
+        }
+        if !b {
+            p0 |= 0x20;
+        }
+        if !r4 {
+            p0 |= 0x10;
+        }
+        if b4 {
+            p0 |= 0x08;
+        }
