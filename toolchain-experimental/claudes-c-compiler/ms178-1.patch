+/* gcc.c-torture/execute/20040411-1.c
+ *
+ * `typedef int c[i+2]; sizeof(c)` is a runtime VLA size captured at the
+ * typedef, not a compile-time pointer-sized constant. */
+void abort(void);
+
+int sub1(int i, int j) {
+    typedef int c[i + 2];
+    int x[10], y[10];
+
+    if (j == 2) {
+        __builtin_memcpy(x, y, 10 * sizeof(int));
+        return sizeof(c);
+    } else {
+        return sizeof(c) * 3;
+    }
+}
+
+int main(void) {
+    if (sub1(20, 3) != 66 * sizeof(int))
+        abort();
+    return 0;
+}
