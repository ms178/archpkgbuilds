+vpmovsqw %xmm1, %xmm2
+vpmovusqw %xmm1, %xmm2
+vpmovdw %ymm1, %xmm2
+vpmovsdw %xmm1, %xmm2
+vpmovusdw %xmm1, %xmm2
+vpmovqd %zmm1, %ymm2
+vpmovqd %ymm1, %xmm2
+vpmovsqd %zmm1, %ymm2
+vpmovusqd %zmm1, %ymm2
+vpmovwb %zmm1, %ymm2
+vpmovwb %ymm1, 256(%rax)
+vpmovswb %ymm1, %xmm2
+vpmovuswb %zmm1, (%rax)
+vpmovuswb %ymm1, %xmm2
