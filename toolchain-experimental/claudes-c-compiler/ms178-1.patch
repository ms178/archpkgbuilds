+    let prefixed = with_sysroot_prefix(path);
+    if std::path::Path::new(&prefixed).exists() {
+        return Some(prefixed);
+    }
+    if std::path::Path::new(path).exists() {
+        return Some(path.to_string());
+    }
+    None
