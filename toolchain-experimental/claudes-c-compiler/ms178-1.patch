+/// pointer, as for `struct c __seg_gs *p`.
+fn pointee_reaches_pointer_level(ty: &CType) -> bool {
+    match ty {
+        CType::Pointer(..) | CType::Function(..) => true,
+        CType::Array(elem, _) => pointee_reaches_pointer_level(elem),
+        _ => false,
