+  i = 2 << ((sizeof(int) * 8) - 1);
+  i = 1 << ((sizeof(int) * 8) - 1);
+  i = -1 << ((sizeof(int) * 8) - 1);
+  i = -1 << 0;
+  i = 0 << ((sizeof(int) * 8) - 1);
+  i = (char)1 << ((sizeof(int) * 8) - 2);
+
+  unsigned u;
+  u = 1U << ((sizeof(int) * 8) - 1);
+  u = 5U << ((sizeof(int) * 8) - 1);
+
