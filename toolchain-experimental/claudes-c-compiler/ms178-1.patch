+        chain.insert(c.0);
+        if let Some(Instruction::Cast {
+            src: Operand::Value(s),
+            ..
+        }) = block.instructions.iter().find(|i| i.dest() == Some(*c))
+        {
+            chain.insert(s.0);
+        }
