+/// Insert a block's predecessor copies (its outgoing phi copies: absorbed
+/// self-loop backedges, uniform edge copies, single-successor edges) before
+/// its terminator -- and, when the terminator is a `CondBranch` fed by a
+/// compare at the end of the block, before that compare.
+///
+/// Every backend fuses `Cmp` -> `CondBranch` (`cmp; jcc`, `cmp; b.cond`,
+/// `bcc`) only when the compare is adjacent to the branch
+/// (`detect_cmp_branch_fusion`). Copies appended after the compare break the
+/// adjacency, and the compare is then materialized as a boolean and
+/// re-tested: on i686, where phi webs are not coalesced (see
+/// `eliminate_phis`), that was `setcc; movzbl; test` in every rotated loop
+/// latch. x86-64 recovered most of these with its compare replay, which
+/// re-reads the operands at the branch.
+///
+/// See `flag_tail_start` for when the copies may move ahead of the compare.
+/// Tail reads of a copy source are rewritten to that copy's destination (same
+/// value after the copy), so the source still dies at the copy and the two
+/// remain coalescable: the move adds no interference.
+fn place_pred_copies(block: &mut BasicBlock, copies: Vec<Instruction>) {
+    let num_copies = copies.len();
+    let at = flag_tail_start(block, &copies).unwrap_or(block.instructions.len());
+    if at < block.instructions.len() {
+        // value -> the destination of the (unique) copy reading it.
+        let mut carried: FxHashMap<u32, Value> = FxHashMap::default();
+        for copy in &copies {
+            if let Instruction::Copy {
+                dest,
+                src: Operand::Value(v),
+            } = copy
+            {
+                carried.entry(v.0).or_insert(*dest);
+            }
+        }
+        for inst in &mut block.instructions[at..] {
+            inst.for_each_operand_mut(|op| {
+                if let Operand::Value(v) = op {
+                    if let Some(d) = carried.get(&v.0) {
+                        *v = *d;
+                    }
+                }
+            });
+            inst.for_each_value_use_mut(|v| {
+                if let Some(d) = carried.get(&v.0) {
+                    *v = *d;
+                }
+            });
+        }
+    }
+    block.instructions.splice(at..at, copies);
+    if !block.source_spans.is_empty() {
+        block.source_spans.splice(
+            at..at,
+            std::iter::repeat_n(crate::common::source::Span::dummy(), num_copies),
+        );
+    }
+}
+
+/// Start of the branch-feeding compare tail of `block` when `copies` may be
+/// placed ahead of it, else `None` (the copies go last, as before).
+///
+/// The tail is the `Cmp` (or `BitTest`) defining the `CondBranch` condition,
+/// followed only by the `Copy`/integer-`Cast` links from it to the condition,
+/// and nothing else: exactly the shape the backends fuse. Moving the copies
+/// ahead of it is sound when
+/// * no tail instruction reads or defines a copy destination (the tail keeps
+///   seeing the values it saw before the copies ran), and
+/// * no tail instruction defines a copy source (the copies keep reading the
+///   values they read at the end of the block).
+///
+/// Each destination is written once (checked), so after the group every
+/// destination equals its source whenever that source is not itself a
+/// destination; tail reads of such a source may use the destination instead.
+/// That holds for sequential groups with cycle temporaries too: a value that
+/// is a destination is never rewritten, because a tail reading it refuses.
+fn flag_tail_start(block: &BasicBlock, copies: &[Instruction]) -> Option<usize> {
+    let Terminator::CondBranch {
+        cond: Operand::Value(cond),
+        ..
+    } = &block.terminator
+    else {
+        return None;
+    };
+    let insts = &block.instructions;
+    let mut wanted = cond.0;
+    let mut at = insts.len();
+    loop {
+        at = at.checked_sub(1)?;
+        match &insts[at] {
+            Instruction::Cmp { dest, .. }
+            | Instruction::BinOp {
+                dest,
+                op: IrBinOp::BitTest,
+                ..
+            } if dest.0 == wanted => break,
+            Instruction::Copy {
+                dest,
+                src: Operand::Value(src),
+            } if dest.0 == wanted => wanted = src.0,
+            Instruction::Cast {
+                dest,
+                src: Operand::Value(src),
+                from_ty,
+                to_ty,
+            } if dest.0 == wanted && from_ty.is_integer() && to_ty.is_integer() => {
+                wanted = src.0;
+            }
+            _ => return None,
+        }
+    }
+    let mut dests: FxHashSet<u32> = FxHashSet::default();
+    let mut srcs: FxHashSet<u32> = FxHashSet::default();
+    for copy in copies {
+        let Instruction::Copy { dest, src } = copy else {
+            return None;
+        };
+        if !dests.insert(dest.0) {
+            return None;
+        }
+        if let Operand::Value(v) = src {
+            srcs.insert(v.0);
+        }
+    }
+    for inst in &insts[at..] {
+        if inst
+            .dest()
+            .is_some_and(|d| dests.contains(&d.0) || srcs.contains(&d.0))
+        {
+            return None;
+        }
+        if inst.used_values().iter().any(|v| dests.contains(v)) {
+            return None;
+        }
+    }
+    Some(at)
+}
