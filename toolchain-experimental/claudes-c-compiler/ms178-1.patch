+        let mut cur_s = v[0].0;
+        let mut cur_e = v[0].1;
+        for &(s, e) in &v[1..] {
+            if s <= cur_e {
+                cur_e = cur_e.max(e);
+            } else {
+                len += u64::from(cur_e.saturating_sub(cur_s));
+                cur_s = s;
+                cur_e = e;
+            }
+        }
+        len + u64::from(cur_e.saturating_sub(cur_s))
+    };
