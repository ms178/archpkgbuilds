+                op: IrBinOp::Mul,
+                lhs: Operand::Value(Value(5)),
+                rhs: Operand::Const(IrConst::I64(56)),
+                ty: IrType::I64,
+            },
+            Instruction::GetElementPtr {
+                dest: Value(7),
+                base: Value(0),
+                offset: Operand::Value(Value(6)),
