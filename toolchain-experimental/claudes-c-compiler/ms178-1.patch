+    Unsigned64,
+    /// Both operands sign-extended: one widening signed multiply.
+    Signed64,
+    /// Right high half zero: the `lhs.lo * rhs.hi` cross term is gone.
+    RightHighZero,
+    /// Left high half zero: the `lhs.hi * rhs.lo` cross term is gone.
