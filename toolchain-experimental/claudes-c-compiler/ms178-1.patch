+    w16(buf, start + 4, index);
+    w16(buf, start + 6, 1);
+    w32(buf, start + 8, elf_hash_name(name));
+    w32(buf, start + 12, 20);
+    w32(buf, start + 16, next);
+    let aux = buf.len();
+    buf.resize(aux + 8, 0);
+    // Elf64_Verdaux: vda_name, vda_next
