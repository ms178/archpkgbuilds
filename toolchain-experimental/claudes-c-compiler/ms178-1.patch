+        if args.regenerate:
+            rows = [
+                (g, i, encode(i, as_bin, objcopy, tmp)) for g, i in _expand()
+            ]
+            write_table(rows, TABLE)
+            n_rej = sum(1 for _, _, e in rows if e == "REJECT")
+            print(
+                f"operand-legality matrix: wrote {len(rows)} rows "
+                f"({len(rows) - n_rej} accepted, {n_rej} rejected) to {TABLE}"
+            )
+            return 0
+
+        if not (args.check or args.lccc):
+            ap.error("choose --check, --check-lccc, --print or --regenerate")
+
+        rows = parse_table(TABLE)
+
+        if args.check:
+            # Negative control for the llvm-mc/ARM-ARM false witness:
+            # UXTW's preferred UBFM word is 0xd3407c20, but GNU as emits
+            # MOV (0x2a0103e0).  If the table ever claimed the UBFM word,
+            # or if this GAS started emitting it, the checker must fail —
+            # a matrix that blessed the encoder's own word would be mute.
+            gas_uxtw = encode("uxtw x0, w1", as_bin, objcopy, tmp)
+            llvm_uxtw = "OK 207c40d3"
+            table_uxtw = next(
+                (e for g, i, e in rows if i.replace(" ", "") == "uxtwx0,w1"),
+                None,
+            )
+            if gas_uxtw == llvm_uxtw:
+                print(
+                    "operand-legality matrix: GNU as now emits the ARM UBFM "
+                    "word for `uxtw x0, w1`; update the MOV pin",
+                    file=sys.stderr,
+                )
+                return 1
+            if gas_uxtw != "OK e003012a":
+                print(
+                    f"operand-legality matrix: unexpected GAS uxtw x0,w1: "
+                    f"{gas_uxtw} (want OK e003012a = mov w0,w1)",
+                    file=sys.stderr,
+                )
+                return 1
+            if table_uxtw == llvm_uxtw:
+                print(
+                    "operand-legality matrix: table claims llvm-mc UBFM for "
+                    "`uxtw x0, w1`; that is not GNU as's verdict",
+                    file=sys.stderr,
+                )
+                return 1
+            if table_uxtw is not None and table_uxtw != gas_uxtw:
+                print(
+                    f"operand-legality matrix: uxtw pin {table_uxtw} != "
+                    f"GAS {gas_uxtw}",
+                    file=sys.stderr,
+                )
+                return 1
+
+            drift = []
+            for group, insn, expected in rows:
+                got = encode(insn, as_bin, objcopy, tmp)
+                if got != expected:
+                    drift.append((group, insn, expected, got))
+
+            if drift:
+                print(
+                    f"operand-legality matrix: {len(drift)} row(s) drifted from GNU as",
+                    file=sys.stderr,
+                )
+                for group, insn, expected, got in drift[:40]:
