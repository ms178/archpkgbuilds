+    if infos[idx].kind == LineKind::Empty || infos[idx].kind == LineKind::Nop {
+        return false;
+    }
+    let t = infos[idx].trimmed(store.get(idx));
+    let name = reg_id_to_name(reg, MoveSize::Q);
+    t.contains(name)
+}
