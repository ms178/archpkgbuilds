+                }
+                MapExpr::BinOp(op, Box::new(go(*l, true)), Box::new(go(*r, true)))
+            }
+            MapExpr::MinMax { is_max, l, r } => MapExpr::MinMax {
+                is_max,
+                l: Box::new(go(*l, true)),
+                r: Box::new(go(*r, true)),
+            },
+            MapExpr::Sqrt(x) => MapExpr::Sqrt(Box::new(go(*x, true))),
+            MapExpr::Fma { .. } => e,
