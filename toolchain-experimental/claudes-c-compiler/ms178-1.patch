+        | B::X86Dpbssds128
+        | B::X86Dpbsud128
+        | B::X86Dpbsuds128
+        | B::X86Dpbuud128
+        | B::X86Dpbuuds128
+        | B::X86Dpbssd256
+        | B::X86Dpbssds256
+        | B::X86Dpbsud256
+        | B::X86Dpbsuds256
+        | B::X86Dpbuud256
+        | B::X86Dpbuuds256 => IntrinsicRequirement {
+            feature: F::AvxVnniInt8,
