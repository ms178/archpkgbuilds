+                        continue;
+                    };
+                    if use_locs[lv.0 as usize].len() != 1 {
+                        continue;
+                    }
+                    let Some(Instruction::Load {
+                        dest,
+                        ptr,
+                        ty: lty,
+                        seg_override,
+                        volatile,
+                    }) = defs[lv.0 as usize].as_ref()
+                    else {
+                        continue;
+                    };
+                    if *dest != *lv
+                        || *lty != t1.1
+                        || *seg_override != AddressSpace::Default
+                        || *volatile
