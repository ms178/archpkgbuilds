+        let c = ctx(&slots, &types, &uses, &busy, &empty);
+        let insts = vec![MachInst::Alu {
+            op: super::super::machinst::AluOp::Add,
+            src: MachOperand::Imm(1),
+            dst: vreg(40),
+            size: OpSize::S64,
