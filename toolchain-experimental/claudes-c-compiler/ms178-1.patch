+    fn eval_fused(fused: &MapExpr, x: u64, bits: u32) -> bool {
+        let modulus = 1u64 << bits;
+        let sign_bit = 1u64 << (bits - 1);
+        let to_signed = |v: u64| -> i64 {
+            let v = v & (modulus - 1);
