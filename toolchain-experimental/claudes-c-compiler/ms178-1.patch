+++ b/tests/regression/check_call_arg_staging.py
@@ -0,0 +1,370 @@
+#!/usr/bin/env python3
+"""Differential stress gate for call-argument staging versus register homes.
+
+The x86-64 register allocator lets a value consumed as a call argument live
+in an ABI argument register whenever no EARLIER argument of any call that
+reads it stages into that register (`collect_call_arg_values` /
+`arg_reg_hazard` in `src/backend/regalloc.rs`).  This gate generates callers
+that forward permuted, duplicated and derived parameters of every SysV
+argument class into callees that hash their arguments in an order-sensitive
+way, then checks that an LCCC-compiled caller translation unit computes the
+same hashes as a GCC-compiled one.  Callees and the driver are always
+compiled by GCC, so a wrong home shows up as an ABI-level mismatch, not as a
+self-consistent LCCC bug.
+
+Shapes per caller (seeded, reproducible):
+  * tail forwards in 1-3 conditional arms (sibling calls),
+  * non-tail calls whose result is combined with a parameter afterwards,
+  * two calls in sequence sharing arguments,
+  * arguments drawn from parameters (any position, duplicates allowed),
+    constants and `p + 1` style expressions,
+  * argument classes: int, long, pointer, double, float, 2-GP struct,
+    INTEGER+SSE mixed struct, __int128, and calls with more than six GP
+    arguments (stack overflow).
+
+Usage: check_call_arg_staging.py --lccc PATH [--gcc gcc-16] [--seeds N]
+       [--funcs N] [--opts -O1,-O2] [--keep DIR] [--self-test]
+Exit status 0 iff every (seed, opt) build matches GCC bit for bit.
+"""
+
+import argparse
+import os
+import random
+import shutil
+import subprocess
+import sys
+import tempfile
+
+TYPES = ["int", "long", "ptr", "double", "float", "S2", "MX", "i128"]
+CDECL = {
+    "int": "int",
+    "long": "long",
+    "ptr": "const char *",
+    "double": "double",
+    "float": "float",
+    "S2": "struct S2",
+    "MX": "struct MX",
+    "i128": "__int128",
+}
+PRELUDE = """\
+struct S2 { long a, b; };
+struct MX { long i; double d; };
+typedef unsigned long u64;
+"""
+
+
+def fold(t, name):
+    """C expression reducing an argument of type t to u64."""
+    if t in ("int", "long"):
+        return f"(u64){name}"
+    if t == "ptr":
+        return f"(u64)({name} - base)"
+    if t == "double":
+        return f"(u64)(long)({name} * 8.0)"
+    if t == "float":
+        return f"(u64)(long)({name} * 4.0f)"
+    if t == "S2":
+        return f"((u64){name}.a * 3u + (u64){name}.b)"
+    if t == "MX":
+        return f"((u64){name}.i * 5u + (u64)(long)({name}.d * 2.0))"
+    if t == "i128":
+        return f"((u64){name} ^ (u64)({name} >> 64))"
+    raise ValueError(t)
+
+
+def const_of(t, rng):
+    k = rng.randint(-9, 99)
+    if t in ("int", "long"):
+        return str(k)
+    if t == "ptr":
+        return f"base + {abs(k) % 16}"
+    if t == "double":
+        return f"{k}.25"
+    if t == "float":
+        return f"{k}.5f"
+    if t == "S2":
+        return f"(struct S2){{{k}, {k * 7}}}"
+    if t == "MX":
+        return f"(struct MX){{{k}, {k}.75}}"
+    if t == "i128":
+        return f"((__int128){k} << 70 | {abs(k)})"
+    raise ValueError(t)
+
+
+def derived(t, name, rng):
+    """A cheap expression of parameter `name` of type t (same type)."""
+    if t in ("int", "long"):
+        return rng.choice([f"{name} + 1", f"{name} ^ 3", f"{name} * 2"])
+    if t == "ptr":
+        return f"{name} + 1"
+    if t in ("double", "float"):
+        return f"{name} + 1"
+    if t == "i128":
+        return f"{name} + 5"
+    return name
+
+
+class Gen:
+    def __init__(self, seed, nfuncs):
+        self.rng = random.Random(seed)
+        self.nfuncs = nfuncs
+        self.callees = []  # (name, [types])
+
+    def callee_sig(self):
+        rng = self.rng
+        # Bias towards scalar GP classes (the hazard model's main subject),
+        # with enough SSE/aggregate/i128 mix to shift GP slots.
+        n = rng.choice([1, 2, 2, 3, 3, 3, 4, 4, 5, 6, 7, 8])
+        weights = [5, 5, 3, 2, 1, 2, 1, 1]
+        return [rng.choices(TYPES, weights)[0] for _ in range(n)]
+
+    def gen_callees(self, count):
+        for i in range(count):
+            self.callees.append((f"c{i}", self.callee_sig()))
+
+    def callee_defs(self):
+        out = [PRELUDE, "extern const char base[64];"]
+        for name, sig in self.callees:
+            params = ", ".join(f"{CDECL[t]} a{i}" for i, t in enumerate(sig))
+            body = " ".join(
+                f"h = h * 1000003u + {fold(t, f'a{i}')};" for i, t in enumerate(sig)
+            )
+            out.append(
+                f"long {name}({params}) {{ u64 h = {len(sig)}u; {body} return (long)(h ^ (h >> 29)); }}"
+            )
+        return "\n".join(out) + "\n"
+
+    def callee_protos(self):
+        out = []
+        for name, sig in self.callees:
+            out.append(f"long {name}({', '.join(CDECL[t] for t in sig)});")
+        return "\n".join(out) + "\n"
+
+    def arg_for(self, t, params):
+        rng = self.rng
+        same = [p for p, pt in params if pt == t]
+        r = rng.random()
+        if same and r < 0.75:
+            return rng.choice(same)
+        if same and r < 0.88:
+            return derived(t, rng.choice(same), rng)
+        return const_of(t, rng)
+
+    def call_expr(self, params):
+        name, sig = self.rng.choice(self.callees)
+        return f"{name}({', '.join(self.arg_for(t, params) for t in sig)})"
+
+    def caller(self, idx):
+        rng = self.rng
+        n = rng.choice([1, 2, 3, 3, 4, 4, 5, 6, 7])
+        ptypes = [rng.choices(TYPES, [6, 6, 3, 2, 1, 2, 1, 1])[0] for _ in range(n)]
+        # The arm condition reads the first integral parameter, or a constant.
+        params = [(f"p{i}", t) for i, t in enumerate(ptypes)]
+        cond_src = next((p for p, t in params if t in ("int", "long")), None)
+        cond = (lambda k: f"{cond_src} > {k}") if cond_src else (lambda k: f"sel > {k}")
+        shape = rng.choice(["tail", "tail", "tail2", "tail3", "nontail", "seq"])
+        decl = ", ".join(f"{CDECL[t]} {p}" for p, t in params)
+        if not cond_src:
+            decl = (decl + ", " if decl else "") + "int sel"
+        live_after = next((p for p, t in params if t in ("int", "long")), None)
+        if shape == "tail":
+            body = f"return {self.call_expr(params)};"
+        elif shape == "tail2":
+            body = f"if ({cond(0)}) return {self.call_expr(params)}; return {self.call_expr(params)};"
+        elif shape == "tail3":
+            body = (
+                f"if ({cond(3)}) return {self.call_expr(params)}; "
+                f"if ({cond(-3)}) return {self.call_expr(params)}; return {self.call_expr(params)};"
+            )
+        elif shape == "nontail":
+            tail = f" ^ (long){live_after}" if live_after else ""
+            body = f"long r = {self.call_expr(params)}; return r * 3{tail};"
+        else:
+            body = f"long r = {self.call_expr(params)}; return r + {self.call_expr(params)};"
+        attr = "__attribute__((noinline)) "
+        return f"{attr}long f{idx}({decl}) {{ {body} }}", params, not cond_src
+
+    def build(self):
+        self.gen_callees(max(6, self.nfuncs // 4))
+        callers, calls = [], []
+        for i in range(self.nfuncs):
+            text, params, has_sel = self.caller(i)
+            callers.append(text)
+            for trial in range(3):
+                args = [const_of(t, self.rng) for _, t in params]
+                if has_sel:
+                    args.append(str(self.rng.choice([-5, 0, 2, 7])))
+                calls.append(f"    acc(\"f{i}.{trial}\", f{i}({', '.join(args)}));")
+        caller_tu = PRELUDE + "extern const char base[64];\n" + self.callee_protos() + "\n".join(callers) + "\n"
+        protos = "\n".join(
+            c.split(" {", 1)[0].replace("__attribute__((noinline)) ", "") + ";" for c in callers
+        )
+        main_tu = (
+            self.callee_defs()
+            + protos
+            + "\n#include <stdio.h>\nconst char base[64];\n"
+            + "static void acc(const char *k, long v) { printf(\"%s %ld\\n\", k, v); }\n"
+            + "int main(void) {\n"
+            + "\n".join(calls)
+            + "\n    return 0;\n}\n"
+        )
+        return caller_tu, main_tu
+
+
+# Pinned shapes, run before the seeds: `__int128` arguments that overflow to
+# the stack AFTER the register arguments are staged (SysV: a 16-byte INTEGER
+# argument that does not fit in the remaining GP registers goes to memory,
+# and later arguments may still take registers). The stack store must not
+# use a scratch register an earlier argument was staged in: a `pushq %r11`
+# / `%r8` scratch clobbered a staged argument (seeds 11, 14, 16, 26 and 30
+# of the generator, 5/40 on the pre-fix compiler). One function per
+# emission path: a value (`cqto` + slot pushes), a 64-bit constant
+# (`movabsq` into %rax, the one scratch left), small constants
+# (`pushq $imm`), and the original seed-11 reduction.
+PINNED_CALLER = r"""
+typedef __int128 i128;
+typedef unsigned __int128 u128;
+extern long base_arr[];
+long c13(int, int, const long *, float, int, int, int, i128);
+long c7(long, long, long, long, long, long, i128, i128);
+long c8(long, long, long, long, long, i128, long, u128);
+__attribute__((noinline)) long k_seed11(int p0, i128 p1)
+{ long r = c13(30, p0, base_arr + 0, 5.5f, 9, p0 ^ 3, 46, p1); return r * 3 ^ (long)p0; }
+__attribute__((noinline)) long k_value(long a, long b)
+{ return c7(b, a, b, a, b, a, (i128)a * b, (i128)b); }
+__attribute__((noinline)) long k_wide_const(long a)
+{ return c7(a, a + 1, a + 2, a + 3, a + 4, a + 5, ((i128)0x123456789abcdefLL << 64) | 7, -5); }
+__attribute__((noinline)) long k_small_const(long a, long b)
+{ return c7(b, a, b, a, b, a, -1, -5); }
+__attribute__((noinline)) long k_mixed(long a, long b, u128 u)
+{ return c8(a, b, a ^ b, b - a, a + 7, (i128)a << 70, b, u + 1); }
+"""
+
+PINNED_MAIN = r"""
+#include <stdio.h>
+typedef __int128 i128;
+typedef unsigned __int128 u128;
+typedef unsigned long long u64;
+long base_arr[4] = { 11, 22, 33, 44 };
+static u64 f128(i128 v) { return (u64)v * 31u + (u64)(v >> 64); }
+long c13(int a, int b, const long *p, float f, int c, int d, int e, i128 g)
+{ u64 h = 7u; h = h * 1000003u + (u64)a; h = h * 1000003u + (u64)b; h = h * 1000003u + (u64)*p;
+  h = h * 1000003u + (u64)(long)(f * 8); h = h * 1000003u + (u64)c; h = h * 1000003u + (u64)d;
+  h = h * 1000003u + (u64)e; h = h * 1000003u + f128(g); return (long)(h ^ (h >> 29)); }
+long c7(long a, long b, long c, long d, long e, long f, i128 g, i128 k)
+{ u64 h = 5u; h = h * 1000003u + (u64)a; h = h * 1000003u + (u64)b; h = h * 1000003u + (u64)c;
+  h = h * 1000003u + (u64)d; h = h * 1000003u + (u64)e; h = h * 1000003u + (u64)f;
+  h = h * 1000003u + f128(g); h = h * 1000003u + f128(k); return (long)(h ^ (h >> 29)); }
+long c8(long a, long b, long c, long d, long e, i128 g, long f, u128 u)
+{ u64 h = 3u; h = h * 1000003u + (u64)a; h = h * 1000003u + (u64)b; h = h * 1000003u + (u64)c;
+  h = h * 1000003u + (u64)d; h = h * 1000003u + (u64)e; h = h * 1000003u + f128(g);
+  h = h * 1000003u + (u64)f; h = h * 1000003u + f128((i128)u); return (long)(h ^ (h >> 29)); }
+long k_seed11(int, i128); long k_value(long, long); long k_wide_const(long);
+long k_small_const(long, long); long k_mixed(long, long, u128);
+int main(void) {
+    printf("k_seed11 %ld\n", k_seed11(13, ((i128)-3 << 64) | 11));
+    printf("k_value %ld\n", k_value(-9, 1234567));
+    printf("k_wide_const %ld\n", k_wide_const(17));
+    printf("k_small_const %ld\n", k_small_const(4, -6));
+    printf("k_mixed %ld\n", k_mixed(-2, 99, ((u128)5 << 64) | 3));
+    return 0;
+}
+"""
+
+
+def run(cmd, **kw):
+    return subprocess.run(cmd, capture_output=True, text=True, **kw)
+
+
+def build_and_run(cc, opt, caller, main_obj, work, tag):
+    obj = os.path.join(work, f"caller.{tag}.o")
+    exe = os.path.join(work, f"t.{tag}")
+    r = run([cc, opt, "-c", caller, "-o", obj])
+    if r.returncode:
+        return None, f"compile failed ({cc} {opt}): {r.stderr[-2000:]}"
+    r = run(["gcc-16" if shutil.which("gcc-16") else "gcc", obj, main_obj, "-o", exe])
+    if r.returncode:
+        return None, f"link failed: {r.stderr[-2000:]}"
+    r = run([exe], timeout=60)
+    if r.returncode:
+        return None, f"run failed rc={r.returncode}"
+    return r.stdout, None
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    ap.add_argument("--lccc", required=False)
+    ap.add_argument("--gcc", default="gcc-16" if shutil.which("gcc-16") else "gcc")
+    ap.add_argument("--seeds", type=int, default=6, help="run seeds 1..N")
+    ap.add_argument("--seed-list", help="comma-separated seeds (overrides --seeds), for triage")
+    ap.add_argument("--funcs", type=int, default=120)
+    ap.add_argument("--opts", default="-O1,-O2")
+    ap.add_argument("--keep")
+    ap.add_argument("--self-test", action="store_true")
+    a = ap.parse_args()
+
+    if a.self_test:
+        # The generator must be deterministic and emit every argument class.
+        c1, m1 = Gen(7, 40).build()
+        c2, m2 = Gen(7, 40).build()
+        assert (c1, m1) == (c2, m2), "generator is not deterministic"
+        for t in ("struct S2", "struct MX", "__int128", "double", "float", "const char *"):
+            assert t in c1 + m1, f"generator never emits {t}"
+        print("PASS: self-test (deterministic, all argument classes emitted)")
+        return 0
+    if not a.lccc:
+        ap.error("--lccc is required")
+
+    work = a.keep or tempfile.mkdtemp(prefix="cas.")
+    os.makedirs(work, exist_ok=True)
+    failures, cases = 0, 0
+    seeds = (
+        [int(x) for x in a.seed_list.split(",")] if a.seed_list else range(1, a.seeds + 1)
+    )
+    for seed in ["pinned", *seeds]:
+        if seed == "pinned":
+            caller_tu, main_tu = PINNED_CALLER, PINNED_MAIN
+        else:
+            caller_tu, main_tu = Gen(seed, a.funcs).build()
+        caller = os.path.join(work, f"caller{seed}.c")
+        mainc = os.path.join(work, f"main{seed}.c")
+        with open(caller, "w") as f:
+            f.write(caller_tu)
+        with open(mainc, "w") as f:
+            f.write(main_tu)
+        main_obj = os.path.join(work, f"main{seed}.o")
+        r = run([a.gcc, "-O1", "-c", mainc, "-o", main_obj])
+        if r.returncode:
+            print(f"FAIL: seed {seed}: driver compile: {r.stderr[-1500:]}")
+            failures += 1
+            continue
+        ref, err = build_and_run(a.gcc, "-O0", caller, main_obj, work, f"ref{seed}")
+        if err:
+            print(f"FAIL: seed {seed}: reference: {err}")
+            failures += 1
+            continue
+        for opt in a.opts.split(","):
+            cases += 1
+            got, err = build_and_run(a.lccc, opt, caller, main_obj, work, f"l{seed}{opt}")
+            if err:
+                print(f"FAIL: seed {seed} {opt}: {err}")
+                failures += 1
+                continue
+            if got != ref:
+                bad = [
+                    (x, y)
+                    for x, y in zip(ref.splitlines(), got.splitlines())
+                    if x != y
+                ]
+                print(f"FAIL: seed {seed} {opt}: {len(bad)} mismatching calls, first {bad[:3]}")
+                failures += 1
+            else:
+                print(f"PASS: seed {seed} {opt}: {len(ref.splitlines())} calls match gcc")
+    if not a.keep:
+        shutil.rmtree(work, ignore_errors=True)
+    print(f"{'PASS' if failures == 0 else 'FAIL'}: call-arg staging {cases - failures}/{cases}")
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tests/regression/check_licm_global_speculation.py b/tests/regression/check_licm_global_speculation.py
new file mode 100644
index 000000000..163fe5584
--- /dev/null
+++ b/tests/regression/check_licm_global_speculation.py
@@ -0,0 +1,251 @@
+#!/usr/bin/env python3
+"""LICM: speculative hoisting of loads from non-weak global objects.
+
+LICM's must-execute rule keeps a load in its loop unless its block
+dominates every loop block.  Before loop rotation even the body block of
+`for (i = 0; i < n; i++) c += G;` fails that test, so LCCC re-read `G` on
+every iteration, while GCC 16.2, Clang 23.1.4 and ICX 2026.2 load it once.
+A load of a non-weak object symbol, entirely inside the object, cannot
+fault (`passes::licm::speculation_safe_globals`), so the rule is waived for
+it; whether the loop modifies the object is still the memory analysis's
+question.
+
+This gate pins both directions:
+
+* positives -- the symbol is referenced only OUTSIDE the loop (before the
+  loop's header label) for a plain global, a conditional-block load
+  (`if (p[i]) c += G;`), a struct member at a constant offset, an array
+  element at a constant index, and an `extern` declaration;
+* refusals, asserted AS refusals -- the load stays inside the loop for an
+  incomplete array (`extern int U[];`, unknown size), a load wider than its
+  object (a 4-byte `may_alias` read of a 2-byte array; the runtime twin uses
+  a 4-byte array so every build is well defined), a constant offset past the object, a thread-local, a volatile
+  object and a global the loop stores to;
+* runtime -- weak symbols left UNDEFINED (address 0) behind `if (&W)` in
+  the loop, both `__attribute__((weak))` and `#pragma weak`: a speculated
+  load would fault; and every positive/refusal function's value against
+  gcc-16 (and with LICM disabled), at -O1 and -O2; the shapes are asserted
+  at -O2 and -O3, the tiers that run LICM.
+
+Usage: check_licm_global_speculation.py --lccc target/fastbuild/lccc [--gcc gcc-16]
+"""
+
+from __future__ import annotations
+
+import argparse
+import os
+import re
+import subprocess
+import sys
+import tempfile
+
+SHAPES = r"""
+int G, H;
+struct S { int a, b, c; } S;
+int A[8];
+extern int E;
+int A2[2];
+_Alignas(4) char small[2];
+typedef int __attribute__((may_alias)) alias_int;
+extern int U[];
+__thread int T;
+volatile int V;
+
+int plain(int n) { int c = 0; for (int i = 0; i < n; i++) c += G; return c; }
+int cond(const int *p, int n) { int c = 0; for (int i = 0; i < n; i++) if (p[i]) c += H; return c; }
+int member(const int *p, int n) { int c = 0; for (int i = 0; i < n; i++) if (p[i]) c += S.b; return c; }
+int element(const int *p, int n) { int c = 0; for (int i = 0; i < n; i++) if (p[i]) c += A[3]; return c; }
+int ext(const int *p, int n) { int c = 0; for (int i = 0; i < n; i++) if (p[i]) c += E; return c; }
+
+int r_incomplete(const int *p, int n) { int c = 0; for (int i = 0; i < n; i++) if (p[i]) c += U[0]; return c; }
+int r_wide(const int *p, int n) { int c = 0; for (int i = 0; i < n; i++) if (p[i]) c += *(alias_int *)small; return c; }
+int r_past(const int *p, int n) { int c = 0; for (int i = 0; i < n; i++) if (p[i]) c += ((int *)A2)[3]; return c; }
+int r_tls(const int *p, int n) { int c = 0; for (int i = 0; i < n; i++) if (p[i]) c += T; return c; }
+int r_volatile(int n) { int c = 0; for (int i = 0; i < n; i++) c += V; return c; }
+int r_stored(const int *p, int n) { int c = 0; for (int i = 0; i < n; i++) { c += G; if (p[i]) G = i; } return c; }
+"""
+
+POSITIVE = {
+    "plain": "G",
+    "cond": "H",
+    "member": "S",
+    "element": "A",
+    "ext": "E",
+}
+REFUSAL = {
+    "r_incomplete": "U",
+    "r_wide": "small",
+    "r_past": "A2",
+    "r_tls": "T",
+    "r_volatile": "V",
+    "r_stored": "G",
+}
+
+RUNTIME = r"""
+#include <stdio.h>
+extern int W __attribute__((weak));
+extern int PW;
+#pragma weak PW
+int G = 3, H = 5, E = 7, U[4] = {11, 0, 0, 0}, A2[4] = {1, 2, 3, 13};
+struct S { int a, b, c; } S = {1, 17, 2};
+int A[8] = {0, 0, 0, 19};
+_Alignas(4) char small[4] = {1, 0, 0, 0};
+typedef int __attribute__((may_alias)) alias_int;
+__thread int T = 23;
+volatile int V = 29;
+
+__attribute__((noinline)) int weak_attr(int n) {
+    int c = 0;
+    for (int i = 0; i < n; i++) if (&W) c += W;
+    return c;
+}
+__attribute__((noinline)) int weak_pragma(int n) {
+    int c = 0;
+    for (int i = 0; i < n; i++) { if (&PW) c += PW; c += i; }
+    return c;
+}
+#define LOOP(name, body) __attribute__((noinline)) int name(const int *p, int n) \
+    { int c = 0; for (int i = 0; i < n; i++) body; return c; }
+__attribute__((noinline)) int plain(int n) { int c = 0; for (int i = 0; i < n; i++) c += G; return c; }
+LOOP(cond, if (p[i]) c += H)
+LOOP(member, if (p[i]) c += S.b)
+LOOP(element, if (p[i]) c += A[3])
+LOOP(ext, if (p[i]) c += E)
+LOOP(r_incomplete, if (p[i]) c += U[0])
+LOOP(r_wide, if (p[i]) c += *(alias_int *)small)
+LOOP(r_past, if (p[i]) c += ((int *)A2)[3])
+LOOP(r_tls, if (p[i]) c += T)
+__attribute__((noinline)) int r_volatile(int n) { int c = 0; for (int i = 0; i < n; i++) c += V; return c; }
+LOOP(r_stored, { c += G; if (p[i]) G = i; })
+
+int main(void) {
+    static const int p[9] = {1, 0, 1, 1, 0, 0, 1, 0, 1};
+    long acc = weak_attr(5) * 1000003L + weak_pragma(6);
+    acc = acc * 31 + plain(9) + cond(p, 9) + member(p, 9) + element(p, 9) + ext(p, 9);
+    acc = acc * 31 + r_incomplete(p, 9) + r_wide(p, 9) + r_past(p, 9) + r_tls(p, 9);
+    acc = acc * 31 + r_volatile(9) + r_stored(p, 9);
+    printf("%ld\n", acc);
+    return 0;
+}
+"""
+
+
+def run(cmd: list[str], env: dict[str, str] | None = None) -> str:
+    proc = subprocess.run(cmd, capture_output=True, text=True, env=env, timeout=120)
+    if proc.returncode != 0:
+        raise SystemExit(f"FAIL: {' '.join(cmd)} (rc {proc.returncode})\n{proc.stdout}{proc.stderr}")
+    return proc.stdout
+
+
+def function_lines(asm: str, name: str) -> list[str]:
+    lines = asm.splitlines()
+    try:
+        start = lines.index(f"{name}:")
+    except ValueError as exc:
+        raise SystemExit(f"FAIL: no function {name} in the assembly") from exc
+    body = []
+    for line in lines[start + 1:]:
+        if line.startswith(".size") or line.strip() == ".cfi_endproc":
+            break
+        body.append(line)
+    return body
+
+
+LABEL = re.compile(r"^(\.L[\w.]+):")
+JUMP = re.compile(r"^\s*j\w+\s+(\.L[\w.]+)\s*$")
+
+
+def loop_region(body: list[str], name: str) -> tuple[int, int]:
+    """The (header, back-edge) line span of the function's loop: the first
+    label targeted by a LATER jump, through the last such jump."""
+    labels = {}
+    for idx, line in enumerate(body):
+        m = LABEL.match(line)
+        if m:
+            labels[m.group(1)] = idx
+    best = None
+    for idx, line in enumerate(body):
+        m = JUMP.match(line)
+        if m and m.group(1) in labels and labels[m.group(1)] < idx:
+            head = labels[m.group(1)]
+            if best is None or head < best[0]:
+                best = (head, idx)
+            elif head == best[0]:
+                best = (head, max(best[1], idx))
+    if best is None:
+        raise SystemExit(f"FAIL: {name}: no loop (back edge) found:\n" + "\n".join(body))
+    return best
+
+
+def mentions(line: str, sym: str) -> bool:
+    return re.search(rf"(?<![\w.]){re.escape(sym)}(?![\w])", line) is not None
+
+
+def check_shapes(lccc: str, tmp: str, opt: str) -> None:
+    src = os.path.join(tmp, "shapes.c")
+    with open(src, "w") as f:
+        f.write(SHAPES)
+    asm = run([lccc, opt, "-S", src, "-o", "-"])
+    for name, sym in {**POSITIVE, **REFUSAL}.items():
+        body = function_lines(asm, name)
+        head, back = loop_region(body, name)
+        inside = [l for l in body[head:back + 1] if mentions(l, sym)]
+        before = [l for l in body[:head] if mentions(l, sym)]
+        if name in POSITIVE:
+            if inside or not before:
+                raise SystemExit(
+                    f"FAIL: {opt} {name}: load of {sym} not hoisted out of the loop:\n"
+                    + "\n".join(body))
+        elif not inside:
+            raise SystemExit(
+                f"FAIL: {opt} {name}: load of {sym} left the loop (unsafe speculation):\n"
+                + "\n".join(body))
+        print(f"PASS: {opt} {name}: {sym} {'hoisted' if name in POSITIVE else 'kept in loop'}")
+
+
+def check_runtime(lccc: str, gcc: str | None, tmp: str) -> None:
+    src = os.path.join(tmp, "rt.c")
+    with open(src, "w") as f:
+        f.write(RUNTIME)
+    results = {}
+    for opt in ("-O1", "-O2"):
+        for licm in ("on", "off"):
+            exe = os.path.join(tmp, f"rt{opt}{licm}")
+            env = dict(os.environ)
+            if licm == "off":
+                env["CCC_DISABLE_PASSES"] = "licm"
+            run([lccc, opt, src, "-o", exe], env)
+            results[f"lccc {opt} licm={licm}"] = run([exe]).strip()
+    if gcc:
+        exe = os.path.join(tmp, "rt_gcc")
+        run([gcc, "-O2", src, "-o", exe])
+        results["gcc-16 -O2"] = run([exe]).strip()
+    values = set(results.values())
+    if len(values) != 1:
+        raise SystemExit("FAIL: runtime values differ:\n" + "\n".join(f"  {k}: {v}" for k, v in results.items()))
+    print(f"PASS: runtime ({len(results)} builds agree, weak symbols undefined): {values.pop()}")
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--lccc", required=True)
+    ap.add_argument("--gcc", default=None)
+    args = ap.parse_args()
+    gcc = args.gcc
+    if gcc:
+        probe = subprocess.run([gcc, "--version"], capture_output=True, text=True)
+        if probe.returncode != 0 or "16.2" not in probe.stdout:
+            raise SystemExit(f"FAIL: --gcc {gcc} is not GCC 16.2")
+    with tempfile.TemporaryDirectory(prefix="lccc-licm-spec.") as tmp:
+        # LICM runs in the -O2+ pipeline; the -O1 tier is loop-free scalar
+        # cleanup by design (src/passes/mod.rs), so shapes are asserted where
+        # the pass exists. The runtime check below still covers -O1.
+        for opt in ("-O2", "-O3"):
+            check_shapes(args.lccc, tmp, opt)
+        check_runtime(args.lccc, gcc, tmp)
+    print("licm-global-speculation gate OK")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tests/regression/check_return_local_addr.py b/tests/regression/check_return_local_addr.py
new file mode 100644
index 000000000..a3d475c0f
--- /dev/null
+++ b/tests/regression/check_return_local_addr.py
@@ -0,0 +1,220 @@
+#!/usr/bin/env python3
+"""`-Wreturn-local-addr` against GCC 16.2: diagnostics and code generation.
+
+`fixtures/return_local_addr/return_local_addr.c` marks every line GCC's
+front end diagnoses with `/* expect: warning return-local-addr */`; every
+other line must stay silent. The gate checks:
+
+  * GCC (`-fsyntax-only`) against the comments, then LCCC against GCC byte
+    for byte (file, line, column, severity, text, option) for every
+    diagnostic, under `-fsyntax-only` and when compiling at -O0 and -O2 (the
+    front-end verdicts must not depend on the optimization level);
+  * `-Wno-return-local-addr` silences exactly those lines and
+    `-Werror=return-local-addr` makes them errors, in both compilers;
+  * run time: a local-variable return yields a null pointer after its side
+    effects (GCC's code generation at every level), while a label address
+    and a nested function returning its parent's local keep their values,
+    natively and with -m32 -- same output from GCC and LCCC.
+"""
+
+from __future__ import annotations
+
+import argparse
+import os
+import re
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+# Ill-formed by design (it warns), so it stays out of run_regression.py's glob.
+SOURCE = HERE / "fixtures" / "return_local_addr" / "return_local_addr.c"
+OPTION = "return-local-addr"
+ENV = {**os.environ, "LC_ALL": "C"}
+EXPECT = re.compile(r"/\* expect: warning return-local-addr \*/")
+DIAG = re.compile(
+    r"^(?P<file>[^:\s]+):(?P<line>\d+):(?P<col>\d+): (?P<sev>warning|error): "
+    r"(?P<msg>.*?)(?: \[-W(?P<werror>error=)?(?P<opt>[a-z-]+)\])?$"
+)
+# LCCC's own closing line for a run with errors (GCC prints `cc1: ...`).
+LCCC_SUMMARY = re.compile(r"l?ccc: error: \d+ error\(s\) during semantic analysis")
+SUMMARY = {
+    "cc1: some warnings being treated as errors",
+    "cc1: all warnings being treated as errors",
+}
+
+RUNTIME = r"""
+#include <stdio.h>
+static int counter;
+__attribute__((noinline)) static int *local(void) { int x = 7; return &x; }
+__attribute__((noinline)) static int *indexed(int *k) {
+    int a[4] = {0}; return &a[(*k)++];
+}
+__attribute__((noinline)) static char *cast(void) {
+    int x = 0; return (char *)&x + 1;
+}
+__attribute__((noinline)) static int *bump(void) { counter++; return &counter; }
+__attribute__((noinline)) static int *chosen(void) {
+    int x = 0; return 1 ? &x : bump();
+}
+__attribute__((noinline)) static void *label(void) { l: return &&l; }
+__attribute__((noinline)) static int nested(void) {
+    int x = 42;
+    int *inner(void) { return &x; }
+    int *p = inner();
+    return p ? *p : -1;
+}
+int main(void) {
+    int k = 1;
+    int *p = indexed(&k);
+    printf("local=%s\n", local() ? "live" : "null");
+    printf("indexed=%s k=%d\n", p ? "live" : "null", k);
+    printf("cast=%s\n", cast() ? "live" : "null");
+    printf("chosen=%s counter=%d\n", chosen() ? "live" : "null", counter);
+    printf("label=%s\n", label() ? "live" : "null");
+    printf("nested=%d\n", nested());
+    return 0;
+}
+"""
+RUNTIME_EXPECTED = (
+    "local=null\nindexed=null k=2\ncast=null\nchosen=null counter=0\n"
+    "label=live\nnested=42\n"
+)
+
+
+def expectations() -> set[int]:
+    return {
+        number
+        for number, text in enumerate(SOURCE.read_text().splitlines(), 1)
+        if EXPECT.search(text)
+    }
+
+
+def diagnostics(cmd: list[str], *, want_failure: bool = False) -> list[tuple]:
+    proc = subprocess.run(cmd, capture_output=True, text=True, env=ENV, check=False)
+    rows, unexpected = [], []
+    for line in proc.stderr.splitlines():
+        match = DIAG.fullmatch(line)
+        if match and match.group("file") == SOURCE.name:
+            rows.append(
+                (
+                    int(match.group("line")),
+                    int(match.group("col")),
+                    match.group("sev"),
+                    match.group("msg"),
+                    bool(match.group("werror")),
+                    match.group("opt"),
+                )
+            )
+        elif match:
+            unexpected.append(line)
+        elif line in SUMMARY or LCCC_SUMMARY.fullmatch(line) or not line.strip() or line.startswith(SOURCE.name + ": In function"):
+            continue
+        elif not line[:1].isspace():
+            # Source excerpts and carets (GCC's `  12 | ...` gutter, LCCC's
+            # indented line) start with whitespace; anything else is not a
+            # diagnostic this gate understands.
+            unexpected.append(line)
+    if proc.stdout.strip():
+        unexpected.append(f"stdout: {proc.stdout.strip()!r}")
+    failed = proc.returncode != 0
+    if failed != want_failure:
+        unexpected.append(f"exit status {proc.returncode} (want {'failure' if want_failure else 'success'})")
+    if unexpected:
+        raise RuntimeError(f"{' '.join(cmd)}:\n  " + "\n  ".join(unexpected))
+    return rows
+
+
+def compare(label: str, want: list[tuple], got: list[tuple]) -> list[str]:
+    if want == got:
+        return []
+    missing = [row for row in want if row not in got]
+    extra = [row for row in got if row not in want]
+    out = [f"{label}: LCCC differs from GCC"]
+    out += [f"  GCC only:  {row}" for row in missing[:20]]
+    out += [f"  LCCC only: {row}" for row in extra[:20]]
+    if not missing and not extra:
+        out.append("  same rows, different order")
+    return out
+
+
+def run_program(compiler: list[str], source: Path, exe: Path, flags: list[str]) -> str:
+    build = subprocess.run(
+        [*compiler, *flags, "-w", str(source), "-o", str(exe)],
+        capture_output=True, text=True, env=ENV, check=False,
+    )
+    if build.returncode != 0:
+        raise RuntimeError(f"{' '.join(compiler)} {' '.join(flags)}: build failed\n{build.stderr}")
+    run = subprocess.run([str(exe)], capture_output=True, text=True, check=False, timeout=30)
+    if run.returncode != 0:
+        raise RuntimeError(f"{exe} {' '.join(flags)}: exit {run.returncode}")
+    return run.stdout
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--lccc", default="target/fastbuild/lccc")
+    parser.add_argument("--gcc", default="gcc-16")
+    parser.add_argument("--m32", action="store_true", help="also run the i686 execution rows")
+    args = parser.parse_args()
+    # Resolve a path-like compiler before changing directory.
+    lccc = [str(Path(args.lccc).resolve()) if os.sep in args.lccc else args.lccc]
+    gcc = [str(Path(args.gcc).resolve()) if os.sep in args.gcc else args.gcc]
+    expected = expectations()
+    failures: list[str] = []
+    cases = 0
+    with tempfile.TemporaryDirectory() as tmp:
+        # Diagnostics quote the file name as given: compile from its
+        # directory so both compilers print the bare name. GCC states the
+        # rule; the comments must agree with it.
+        os.chdir(SOURCE.parent)
+        oracle = diagnostics([*gcc, "-fsyntax-only", SOURCE.name])
+        flagged = {row[0] for row in oracle if row[5] == OPTION}
+        if flagged != expected:
+            failures.append(
+                f"GCC vs comments: GCC-only lines {sorted(flagged - expected)}, "
+                f"comment-only lines {sorted(expected - flagged)}"
+            )
+        cases += 1
+        for mode in (["-fsyntax-only"], ["-O0", "-S", "-o", os.devnull], ["-O2", "-S", "-o", os.devnull]):
+            got = diagnostics([*lccc, *mode, SOURCE.name])
+            failures += compare(f"lccc {' '.join(mode)}", oracle, got)
+            cases += 1
+        # Option handling, two-sided.
+        silenced = [row for row in oracle if row[5] != OPTION]
+        for cc, name in ((gcc, "gcc"), (lccc, "lccc")):
+            got = diagnostics([*cc, "-fsyntax-only", f"-Wno-{OPTION}", SOURCE.name])
+            failures += compare(f"{name} -Wno-{OPTION}", silenced, got)
+            promoted = [
+                (line, col, "error", msg, True, opt) if opt == OPTION else (line, col, sev, msg, werr, opt)
+                for (line, col, sev, msg, werr, opt) in oracle
+            ]
+            got = diagnostics([*cc, "-fsyntax-only", f"-Werror={OPTION}", SOURCE.name], want_failure=True)
+            failures += compare(f"{name} -Werror={OPTION}", promoted, got)
+            cases += 2
+        # Code generation.
+        program = Path(tmp) / "rla_run.c"
+        program.write_text(RUNTIME)
+        abis = [[]] + ([["-m32"]] if args.m32 else [])
+        for abi in abis:
+            for level in ("-O0", "-O2"):
+                flags = [*abi, level]
+                for cc, name in ((gcc, "gcc"), (lccc, "lccc")):
+                    out = run_program(cc, program, Path(tmp) / f"{name}.out", flags)
+                    if out != RUNTIME_EXPECTED:
+                        failures.append(f"{name} {' '.join(flags)} run:\n{out}")
+                    cases += 1
+    if failures:
+        print("return-local-addr gate: FAIL", file=sys.stderr)
+        print("\n".join(failures), file=sys.stderr)
+        return 1
+    print(
+        f"return-local-addr gate: PASS ({len(expected)} diagnosed lines, "
+        f"{sum(1 for _ in SOURCE.read_text().splitlines())} fixture lines, {cases} checks)"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tests/regression/check_riscv_relax_bfd.py b/tests/regression/check_riscv_relax_bfd.py
new file mode 100644
index 000000000..199baf6d1
--- /dev/null
+++ b/tests/regression/check_riscv_relax_bfd.py
@@ -0,0 +1,305 @@
+#!/usr/bin/env python3
+"""Hold lccc-ld's RISC-V linker relaxation to GNU ld 2.47, byte for byte.
+
+Every case is one object (generated assembly or the C fixture
+riscv_relax/bfd_mix.c), linked freestanding (`-static -e _start`) by lccc-ld
+and by the pinned bfd ld (scripts/ensure_riscv_ld_247.sh).  bfd is given
+`-Ttext=<lccc's .text address>`: lccc writes more program headers, and with
+`.text` at the same address both images must be identical where relaxation
+reaches:
+
+  * every allocated section: same address and size;
+  * every allocated PROGBITS section: same bytes (`.text` above all);
+  * every symbol both symbol tables define: same value;
+  * every `.debug_*` section (the `-g` cases): same bytes.
+
+The generated cases sweep the decisions bfd takes with margins -- call and
+tail reach around +-1 MiB and +-2 KiB, the gp window edges for lui/auipc
+pairs and every load/store form, c.lui, near-zero absolute and undefined weak
+symbols, TLS local-exec, R_RISCV_ALIGN after deletions -- each with RVC on
+and off, relaxed and with --no-relax.  Without the cross toolchain or the
+pinned ld the script prints a SKIP line.
+"""
+
+from __future__ import annotations
+
+import argparse
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+from dataclasses import dataclass, field
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+TRIPLE = "riscv64-linux-gnu"
+DEFAULT_LD = Path.home() / ".cache/bfd-ld-2.47-riscv64-linux-gnu/bin/ld"
+MARCH = {"rvc": "rv64gc", "norvc": "rv64g"}
+SHT_PROGBITS, SHT_SYMTAB, SHT_NOBITS = 1, 2, 8
+SHF_ALLOC = 0x2
+
+
+class GateFailure(RuntimeError):
+    pass
+
+
+def run(argv: list[str], cwd: Path) -> str:
+    done = subprocess.run(argv, cwd=cwd, text=True, capture_output=True, check=False, timeout=300)
+    if done.returncode:
+        raise GateFailure(f"{' '.join(map(str, argv))} failed ({done.returncode}):\n{done.stderr}")
+    return done.stdout
+
+
+@dataclass
+class Elf:
+    sections: dict[str, tuple[int, int, int, int, bytes]] = field(default_factory=dict)
+    symbols: dict[str, set[int]] = field(default_factory=dict)
+
+
+def read_elf(path: Path) -> Elf:
+    """Sections (type, flags, addr, size, bytes) and symbol values by name."""
+    data = path.read_bytes()
+    if data[:4] != b"\x7fELF" or data[4] != 2 or data[5] != 1:
+        raise GateFailure(f"{path}: not an ELF64 little-endian file")
+    shoff, = struct.unpack_from("<Q", data, 0x28)
+    shentsize, shnum, shstrndx = struct.unpack_from("<HHH", data, 0x3A)
+    raw = [struct.unpack_from("<IIQQQQIIQQ", data, shoff + i * shentsize) for i in range(shnum)]
+    names = raw[shstrndx]
+
+    def cstr(table_off: int, off: int) -> str:
+        end = data.index(b"\0", table_off + off)
+        return data[table_off + off:end].decode()
+
+    elf = Elf()
+    for sh in raw:
+        name = cstr(names[4], sh[0])
+        sh_type, flags, addr, off, size = sh[1], sh[2], sh[3], sh[4], sh[5]
+        body = b"" if sh_type == SHT_NOBITS else data[off:off + size]
+        elf.sections[name] = (sh_type, flags, addr, size, body)
+        if sh_type == SHT_SYMTAB:
+            strtab = raw[sh[6]]
+            for i in range(1, size // 24):
+                st_name, st_info, _, st_shndx, st_value, _ = struct.unpack_from("<IBBHQQ", data, off + i * 24)
+                if st_info & 0xF in (3, 4) or not st_name:  # STT_SECTION, STT_FILE
+                    continue
+                elf.symbols.setdefault(cstr(strtab[4], st_name), set()).add(st_value)
+    return elf
+
+
+def compare(lccc: Elf, bfd: Elf) -> list[str]:
+    problems: list[str] = []
+    alloc = {n: s for n, s in bfd.sections.items() if s[1] & SHF_ALLOC and s[3]}
+    for name, (sh_type, _, addr, size, body) in alloc.items():
+        mine = lccc.sections.get(name)
+        if mine is None:
+            problems.append(f"section {name} missing")
+            continue
+        if (mine[2], mine[3]) != (addr, size):
+            problems.append(f"section {name}: {mine[2]:#x}+{mine[3]:#x}, bfd {addr:#x}+{size:#x}")
+        elif sh_type == SHT_PROGBITS and mine[4] != body:
+            at = next(i for i, (a, b) in enumerate(zip(mine[4], body)) if a != b)
+            problems.append(f"section {name}: bytes differ first at {addr + at:#x}")
+    for name, (_, _, _, size, body) in bfd.sections.items():
+        if name.startswith(".debug_") and size:
+            mine = lccc.sections.get(name)
+            if mine is None or mine[4] != body:
+                problems.append(f"section {name}: bytes differ")
+    for name, values in sorted(bfd.symbols.items()):
+        mine = lccc.symbols.get(name)
+        if mine is not None and mine != values:
+            problems.append(f"symbol {name}: {sorted(map(hex, mine))}, bfd {sorted(map(hex, values))}")
+    return problems
+
+
+# ── Generated assembly cases ────────────────────────────────────────────────
+
+HEAD = "\t.text\n\t.globl _start\n\t.type _start, @function\n"
+
+
+def call_cases() -> dict[str, str]:
+    """call/tail to targets around jal (+-1 MiB) and c.j (+-2 KiB) reach,
+    forward and backward, so the margin bfd reserves decides."""
+    out: dict[str, str] = {}
+    for pad in (0x7F0, 0x7F6, 0x7F8, 0x7FA, 0x7FC, 0x800, 0x804, 0x810):
+        out[f"tail-fwd-{pad:#x}"] = HEAD + f"_start:\n\ttail far\n\t.skip {pad}\nfar:\n\tret\n"
+        out[f"tail-back-{pad:#x}"] = HEAD + f"far:\n\tret\n\t.skip {pad}\n_start:\n\ttail far\n"
+    for pad in (0xFFFF0, 0xFFFF8, 0xFFFFA, 0xFFFFC, 0xFFFFE, 0x100000, 0x100008):
+        out[f"call-fwd-{pad:#x}"] = (
+            HEAD + f"_start:\n\tcall far\n\tcall near\n\tj _start\nnear:\n\tret\n\t.skip {pad}\nfar:\n\tret\n"
+        )
+        out[f"call-back-{pad:#x}"] = HEAD + f"far:\n\tret\n\t.skip {pad}\n_start:\n\tcall far\n\tj _start\n"
+    # Calls whose reach depends on the deletions of other calls between.
+    body = "".join(f"\tcall f{i}\n" for i in range(64))
+    funcs = "".join(f"f{i}:\n\tret\n\t.skip {0x3FF8 + 2 * i}\n" for i in range(64))
+    out["call-chain"] = HEAD + f"_start:\n{body}\tj _start\n{funcs}"
+    # Undefined weak callee: bfd rewrites to a jump to address 0's neighbour.
+    out["call-undef-weak"] = HEAD + "\t.weak nothere\n_start:\n\tcall nothere\n\ttail nothere\n"
+    return out
+
+
+def data_cases() -> dict[str, str]:
+    """lui/auipc pairs against data across the gp window and c.lui range,
+    with every low-part form (addi, load, store)."""
+    out: dict[str, str] = {}
+    forms = (
+        ("lui", "\tlui a0, %hi({s})\n\taddi a0, a0, %lo({s})\n"
+                "\tlui a1, %hi({s})\n\tlw a2, %lo({s})(a1)\n"
+                "\tlui a3, %hi({s})\n\tsw a2, %lo({s})(a3)\n"),
+        ("pcrel", "1:\tauipc a0, %pcrel_hi({s})\n\taddi a0, a0, %pcrel_lo(1b)\n"
+                  "2:\tauipc a1, %pcrel_hi({s})\n\tld a2, %pcrel_lo(2b)(a1)\n"
+                  "3:\tauipc a3, %pcrel_hi({s})\n\tsd a2, %pcrel_lo(3b)(a3)\n"),
+    )
+    # Symbols at offsets from __SDATA_BEGIN__ straddling gp-0x800..gp+0x800
+    # (gp = __SDATA_BEGIN__ + 0x800 here), with alignment-driven reserve.
+    offs = (0, 0x7F8, 0xFF0, 0xFF8, 0xFFC, 0x1000, 0x1004, 0x1800, 0x10000)
+    for kind, form in forms:
+        for align in (3, 6):
+            refs = "".join(form.format(s=f"d{i}") for i in range(len(offs)))
+            syms = "".join(
+                f"\t.skip {off - (offs[i - 1] if i else 0) - (8 if i else 0)}\n\t.globl d{i}\nd{i}:\n\t.8byte 0\n"
+                for i, off in enumerate(offs)
+            )
+            out[f"{kind}-gp-a{align}"] = (
+                HEAD + f"_start:\n{refs}\tj _start\n\t.section .sdata,\"aw\"\n\t.p2align {align}\n{syms}"
+            )
+        # Below the small data: .data symbols reached only from below gp.
+        refs = "".join(form.format(s=f"b{i}") for i in range(4))
+        syms = "".join(f"\t.globl b{i}\nb{i}:\n\t.skip {0x7F8 + 8 * i}\n" for i in range(4))
+        out[f"{kind}-data"] = (
+            HEAD + f"_start:\n{refs}\tj _start\n\t.data\n{syms}\t.section .sdata,\"aw\"\n\t.8byte 1\n"
+        )
+    # c.lui: targets out of gp reach whose %hi fits 6 bits, any rd but x0/x2.
+    for rd in ("a0", "s1", "t6", "sp", "zero"):
+        out[f"clui-{rd}"] = (
+            HEAD + f"_start:\n\tlui {rd}, %hi(far)\n\taddi {rd}, {rd}, %lo(far)\n\tlui {rd}, %hi(edge)\n"
+            f"\tlw {rd}, %lo(edge)({rd})\n\tj _start\n\t.bss\n\t.skip 0x6000\nfar:\n\t.skip 0x8000\nedge:\n"
+            "\t.skip 8\n\t.section .sdata,\"aw\"\n\t.8byte 1\n"
+        )
+    # Absolute symbols near zero (x0 base) and undefined weak data.
+    out["abs-near-zero"] = HEAD + (
+        "\t.globl lo, hi, mid\n\t.set lo, 0x10\n\t.set mid, 0x7ff\n\t.set hi, 0x800\n\t.weak wd\n_start:\n"
+        + "".join(f"\tlui a0, %hi({s})\n\tlw a1, %lo({s})(a0)\n" for s in ("lo", "mid", "hi", "wd"))
+        + "".join(f"1:\tauipc a0, %pcrel_hi({s})\n\tlw a1, %pcrel_lo(1b)(a0)\n" for s in ("wd",))
+        + "\tj _start\n"
+    )
+    # TLS local-exec: tprel within and beyond the 12-bit window.
+    out["tls-le"] = HEAD + "_start:\n" + "".join(
+        f"\tlui a0, %tprel_hi({s})\n\tadd a0, a0, tp, %tprel_add({s})\n\tlw a1, %tprel_lo({s})(a0)\n"
+        f"\tlui a2, %tprel_hi({s})\n\tadd a2, a2, tp, %tprel_add({s})\n\tsw a1, %tprel_lo({s})(a2)\n"
+        for s in ("t0v", "t1v", "t2v", "t3v")
+    ) + (
+        "\tj _start\n\t.section .tbss,\"awT\",@nobits\nt0v:\n\t.skip 0x7f8\nt1v:\n\t.skip 8\nt2v:\n"
+        "\t.skip 0x800\nt3v:\n\t.skip 8\n"
+    )
+    return out
+
+
+def align_cases() -> dict[str, str]:
+    """R_RISCV_ALIGN after deletions, and section-relative references that
+    must follow the bytes (`.Lx-1`, the DWARF location-list idiom)."""
+    out: dict[str, str] = {}
+    for p2 in (2, 3, 4, 5, 6):
+        out[f"align-{p2}"] = HEAD + (
+            "_start:\n\tcall g\n\tlui a0, %hi(v)\n\tlw a0, %lo(v)(a0)\n"
+            f"\t.p2align {p2}\n.Lx:\n\tcall g\n\t.p2align {p2}\ng:\n\tret\n"
+            "\t.data\n\t.8byte .Lx-1\n\t.8byte .Lx\n\t.8byte g-1\n"
+            "\t.section .sdata,\"aw\"\nv:\n\t.4byte 1\n"
+        )
+    return out
+
+
+def generated_cases() -> dict[str, str]:
+    return {**call_cases(), **data_cases(), **align_cases()}
+
+
+# ── Driver ─────────────────────────────────────────────────────────────────
+
+
+def link_pair(lccc: Path, ld: Path, obj: Path, tmp: Path, tag: str, relax: bool) -> list[str]:
+    mine, theirs = tmp / f"{tag}.lccc", tmp / f"{tag}.bfd"
+    extra = [] if relax else ["-Wl,--no-relax"]
+    run([str(lccc), "-nostdlib", "-static", "-Wl,-e,_start", *extra, str(obj), "-o", str(mine)], tmp)
+    mine_elf = read_elf(mine)
+    text = mine_elf.sections.get(".text")
+    if text is None:
+        return [".text missing from lccc output"]
+    run(
+        [str(ld), "-static", "-e", "_start", f"-Ttext={text[2]:#x}", *([] if relax else ["--no-relax"]),
+         str(obj), "-o", str(theirs)],
+        tmp,
+    )
+    return compare(mine_elf, read_elf(theirs))
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("--lccc", type=Path, default=ROOT / "target/fastbuild/lccc-riscv")
+    ap.add_argument("--ld", type=Path, default=DEFAULT_LD)
+    ap.add_argument("--cc", default=f"{TRIPLE}-gcc")
+    ap.add_argument("--only", help="run only cases whose name contains this")
+    ap.add_argument("--keep", type=Path, help="keep the work directory here")
+    args = ap.parse_args()
+    for tool, what in ((args.lccc, "lccc-riscv"), (args.ld, "bfd ld 2.47")):
+        if not Path(tool).is_file():
+            print(f"SKIP: {what} not found at {tool}")
+            return 0
+    if shutil.which(args.cc) is None:
+        print(f"SKIP: {args.cc} not available")
+        return 0
+    version = run([str(args.ld), "--version"], ROOT).splitlines()[0]
+    if " 2.47" not in version:
+        print(f"FAIL: {args.ld} is not GNU ld 2.47: {version}")
+        return 1
+
+    tmp = Path(tempfile.mkdtemp(prefix="riscv-relax-bfd-"))
+    if args.keep:
+        args.keep.mkdir(parents=True, exist_ok=True)
+        tmp = args.keep
+    jobs: list[tuple[str, Path]] = []
+    for name, asm in generated_cases().items():
+        for rvc, march in MARCH.items():
+            src = tmp / f"{name}-{rvc}.s"
+            src.write_text(asm)
+            obj = src.with_suffix(".o")
+            run([args.cc, f"-march={march}", "-mabi=lp64d", "-c", str(src), "-o", str(obj)], tmp)
+            jobs.append((f"{name}-{rvc}", obj))
+    fixture = ROOT / "tests/regression/riscv_relax/bfd_mix.c"
+    for opt in ("-O0", "-O2", "-Os"):
+        for rvc, march in MARCH.items():
+            for dbg in ("", "-g"):
+                tag = f"bfd_mix{opt}{dbg}-{rvc}"
+                obj = tmp / f"{tag}.o"
+                run(
+                    [args.cc, opt, *([dbg] if dbg else []), f"-march={march}", "-mabi=lp64d",
+                     "-ffreestanding", "-fno-pic", "-fno-reorder-functions", "-fno-asynchronous-unwind-tables",
+                     "-c", str(fixture), "-o", str(obj)],
+                    tmp,
+                )
+                jobs.append((tag, obj))
+
+    failed = passed = 0
+    for tag, obj in jobs:
+        if args.only and args.only not in tag:
+            continue
+        for relax in (True, False):
+            label = f"{tag} {'relax' if relax else 'no-relax'}"
+            try:
+                problems = link_pair(args.lccc, args.ld, obj, tmp, f"{tag}-{int(relax)}", relax)
+            except GateFailure as exc:
+                problems = [str(exc).strip()]
+            if problems:
+                failed += 1
+                print(f"FAIL {label}:")
+                for p in problems[:8]:
+                    print(f"    {p}")
+            else:
+                passed += 1
+    print(f"riscv relax vs GNU ld 2.47: {passed} passed, {failed} failed")
+    if not args.keep:
+        shutil.rmtree(tmp, ignore_errors=True)
+    return 1 if failed else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tests/regression/check_sibcall_shapes.sh b/tests/regression/check_sibcall_shapes.sh
index f04105921..200d7f092 100755
--- a/tests/regression/check_sibcall_shapes.sh
+++ b/tests/regression/check_sibcall_shapes.sh
@@ -401,11 +401,201 @@ off=$("$tmp/instrumented_off")
 }
 echo "PASS: per-instruction void-call identity and runtime hook order"
 
+# --- Branch-arm sibling calls, frame-less tails, tail-call liveness ---------
+# backend::x86::ret_dup hands each call arm the shared return block's
+# `Return`, so `if (c) f(); else g();` / `return c ? f(x) : g(x);` end in two
+# `jmp`s (GCC 16.2, Clang 23.1.4 and ICX 2026.2 all emit that).  A function
+# whose every call converts owes no call-alignment pad (no `subq $8`), and
+# the `# LCCC_TAIL_CALL` marker lets the liveness oracle delete argument-
+# staging copies the tail callee never reads (`movq %rdi, %rax`).
+cat > "$tmp/arms.c" <<'C'
+extern void fast(void), slow(void);
+extern int G;
+void dispatch(void) { if (G & 32) fast(); else slow(); }
+extern int g1(int), g2(int);
+int sel(int c, int x) { return c ? g1(x) : g2(x); }
+extern int h3(int, int, int);
+int sel3(int c, int x, int y) { if (c > 0) return h3(x, y, c); if (c < 0) return g1(y); return g2(x); }
+int one(int x) { return g1(x); }
+int swap2(int x, int y) { return h3(y, x, 0); }
+void vf(void) { fast(); }
+int const_arm(int c, int x) { return c ? g1(x) : 0; }
+/* Refusals and mixed shapes: a stack-argument arm keeps its call (and the
+ * function its pad); a non-tail call keeps the pad for the tail arm too. */
+extern long sink7(long, long, long, long, long, long, long), gl(long);
+long arm7(int c, long v) { if (c) return sink7(v, v, v, v, v, v, 7); return gl(v); }
+/* The callee's int result must be sign-extended after it returns: never a
+ * tail call (gcc-16.2 / clang-23.1.4: call g1; cltq). */
+long widen(int x) { return g1(x); }
+int mixed(int c, int x) { int r = g1(x); if (c) return g2(r); return r + 1; }
+C
+"$CCC" -O2 -S "$tmp/arms.c" -o "$tmp/arms.s"
+CCC_NO_SIBCALL=1 "$CCC" -O2 -S "$tmp/arms.c" -o "$tmp/arms_ctl.s"
+# call_aligned BODY: forward dataflow over the function's frame adjustments
+# (entry %rsp is 8 mod 16 after the caller's call); require 0 mod 16 at every
+# `call`.  A conditional jump records its offset for the target label; a label
+# reached only by a jump (previous instruction ret/jmp) takes that offset, so
+# per-arm epilogues laid out before another arm's call do not skew the walk.
+# Fails if a label is reached with conflicting offsets or a target is unknown.
+call_aligned() {
+    awk 'function adj(v) { gsub(/[$,]/, "", v); return v + 0 }
+         BEGIN { off = 8; bad = 0; calls = 0; dead = 0 }
+         /^[[:space:]]*#/ || /^[[:space:]]*\./ && !/^\.[A-Za-z0-9_]+:/ { next }
+         /^\.?[A-Za-z0-9_.]+:/ {
+             l = $1; sub(/:$/, "", l)
+             if (dead) { if (!(l in at)) { bad++; next } off = at[l]; dead = 0 }
+             else if ((l in at) && at[l] != off) bad++
+             next }
+         dead { next }
+         /^[[:space:]]*push[ql]?[[:space:]]/ { off += 8 }
+         /^[[:space:]]*pop[ql]?[[:space:]]/  { off -= 8 }
+         /^[[:space:]]*subq[[:space:]]+\$[0-9]+, %rsp/ { off += adj($2) }
+         /^[[:space:]]*addq[[:space:]]+\$[0-9]+, %rsp/ { off -= adj($2) }
+         /^[[:space:]]*call[[:space:]]/ { calls++; if (off % 16 != 0) bad++ }
+         /^[[:space:]]*j[a-z]+[[:space:]]+\.L/ {
+             t = $2
+             if ((t in at) && at[t] != off) bad++
+             at[t] = off
+             if ($1 == "jmp") dead = 1
+             next }
+         /^[[:space:]]*(ret|jmp)/ { dead = 1 }
+         END { exit (calls > 0 && bad == 0) ? 0 : 1 }' <<<"$1"
+}
+insns() { grep -Ev '^[[:space:]]*($|#|\.)|^[A-Za-z_.][A-Za-z0-9_.]*:' <<<"$1"; }
+for spec in 'dispatch fast slow' 'sel g1 g2' 'sel3 h3 g1 g2' 'one g1' 'swap2 h3' 'vf fast' \
+            'const_arm g1'; do
+    set -- $spec
+    fn=$1; shift
+    b=$(body "$tmp/arms.s" "$fn")
+    for t in "$@"; do
+        # `jmp sym` or the conditional sibling call `jcc sym` (Clang's form).
+        has "$b" "^[[:space:]]*j[a-z]* $t@PLT" || { echo "$fn: arm to $t is not a sibling call:" >&2; echo "$b" >&2; exit 1; }
+    done
+    lacks "$b" '^[[:space:]]*call ' || { echo "$fn: a call survived" >&2; exit 1; }
+    lacks "$b" '%rsp' || { echo "$fn: frame (call pad) without any call:" >&2; echo "$b" >&2; exit 1; }
+done
+# The tail callee reads only its arguments: no staging copy into %rax.
+for fn in one swap2 sel; do
+    b=$(body "$tmp/arms.s" "$fn")
+    lacks "$b" '%rax\|%eax' || { echo "$fn: dead accumulator staging survived:" >&2; echo "$b" >&2; exit 1; }
+done
+[ "$(insns "$(body "$tmp/arms.s" one)")" = "    jmp g1@PLT" ] || {
