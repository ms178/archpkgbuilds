@@ -0,0 +1,123 @@
+"""Self-tests for punning_fuzz.py: the reference model is the oracle, so it is
+tested first (arithmetic/encoding), then its agreement with GCC is checked
+when a GCC is available."""
+from __future__ import annotations
+
+import random
+import shutil
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+import punning_fuzz as pf  # noqa: E402
+
+
+class ModelArithmetic(unittest.TestCase):
+    def test_trunc_is_modular_two_complement(self):
+        self.assertEqual(pf.trunc(0x80, "i8"), -128)
+        self.assertEqual(pf.trunc(0xFF, "i8"), -1)
+        self.assertEqual(pf.trunc(-1, "u16"), 0xFFFF)
+        self.assertEqual(pf.trunc(0x1_0000_0000, "u32"), 0)
+        self.assertEqual(pf.trunc(0x8000_0000, "i32"), -(2**31))
+        self.assertEqual(pf.trunc(2**63, "i64"), -(2**63))
+
+    def test_encoding_is_little_endian(self):
+        self.assertEqual(pf.encode(0x11223344, 4), b"\x44\x33\x22\x11")
+        self.assertEqual(pf.encode(-2, 2), b"\xfe\xff")
+        # Reading a wider store through a narrower type sees the low bytes.
+        self.assertEqual(pf.decode(pf.encode(0x11223344, 4)[:1], "u8"), 0x44)
+        self.assertEqual(pf.decode(pf.encode(0x11223344, 4)[2:], "u16"), 0x1122)
+
+    def test_encode_decode_round_trip_all_types(self):
+        rng = random.Random(1)
+        for ty, (size, _signed, _c) in pf.TYPES.items():
+            for _ in range(200):
+                v = pf.trunc(rng.getrandbits(64), ty)
+                self.assertEqual(pf.decode(pf.encode(v, size), ty), v, ty)
+
+
+class FloatAndWideModel(unittest.TestCase):
+    """Mutation-sensitive checks for the T7 additions to the model."""
+
+    def test_stored_floats_are_never_inf_or_nan(self):
+        rng = random.Random(7)
+        for ty in pf.FLOAT_TYPES:
+            size = pf.FLOAT_TYPES[ty]
+            exp_shift = 23 if size == 4 else 52
+            exp_mask = 0xFF if size == 4 else 0x7FF
+            for _ in range(2000):
+                b = pf.store_bits(rng.getrandbits(64), ty)
+                self.assertNotEqual((b >> exp_shift) & exp_mask, exp_mask, (ty, hex(b)))
+
+    def test_finite_bits_is_identity_on_finite_values(self):
+        self.assertEqual(pf.finite_bits(0x3F800000, "f32"), 0x3F800000)  # 1.0f
+        self.assertEqual(pf.finite_bits(0x7F800000, "f32"), 0x3F800000)  # +inf -> 1.0f (exponent top bit cleared)
+        self.assertEqual(pf.finite_bits(0x3FF0000000000000, "f64"), 0x3FF0000000000000)  # 1.0
+        self.assertEqual(pf.finite_bits(0x7FF0000000000000, "f64"), 0x3FF0000000000000)
+
+    def test_wide_loads_split_into_two_words(self):
+        data = bytes(range(16))
+        lo = int.from_bytes(data[:8], "little")
+        hi = int.from_bytes(data[8:], "little")
+        self.assertEqual(pf.load_words(data, "u128"), [lo, hi])
+        self.assertEqual(pf.load_words(data, "i128"), [lo, hi])
+
+    def test_signed_small_loads_are_sign_extended_like_c(self):
+        self.assertEqual(pf.load_words(b"\xff", "i8"), [pf.MASK64])
+        self.assertEqual(pf.load_words(b"\x01", "u8"), [1])
+
+    def test_model_covers_the_new_types(self):
+        seen = set()
+        for seed in range(400):
+            for ops in pf.gen_case(seed).bodies:
+                seen.update(op.ty for op in ops)
+        self.assertTrue({"f32", "f64", "u128", "i128"} <= seen, seen)
+
+
+class GeneratorShape(unittest.TestCase):
+    def test_generation_is_deterministic(self):
+        for seed in (0, 7, 999):
+            self.assertEqual(pf.generate(pf.gen_case(seed)), pf.generate(pf.gen_case(seed)))
+            self.assertEqual(pf.run_model(pf.gen_case(seed)), pf.run_model(pf.gen_case(seed)))
+
+    def test_every_access_stays_inside_the_object(self):
+        for seed in range(300):
+            for ops in pf.gen_case(seed).bodies:
+                for op in ops:
+                    size = pf.TYPES[op.ty][0]
+                    self.assertLessEqual(op.off + size, pf.OBJECT_SIZE, (seed, op))
+                    if op.kind in ("uset", "uget"):
+                        self.assertEqual(op.off % size, 0, "union arrays are naturally aligned")
+
+    def test_model_output_format(self):
+        out = pf.run_model(pf.gen_case(5))
+        self.assertRegex(out, r"^[0-9a-f]{16} [0-9a-f]{16}\n$")
+
+
+@unittest.skipUnless(shutil.which("gcc"), "gcc not available")
+class ModelAgreesWithGcc(unittest.TestCase):
+    """Oracle self-check: a disagreement here is a model or generator bug."""
+
+    def test_small_corpus_matches_gcc(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            out = Path(tmp)
+            for seed in range(6):
+                for level in ("O0", "O2"):
+                    result = pf.one_case(pf.Job(seed, "gcc", level, "base", out, 60))
+                    self.assertEqual(result.status, "pass",
+                                     f"seed {seed} -{level}: {result.detail}")
+
+    def test_v3_lane_matches_gcc(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            out = Path(tmp)
+            for seed in range(3):
+                result = pf.one_case(pf.Job(seed, "gcc", "O2", "v3", out, 60))
+                self.assertEqual(result.status, "pass",
+                                 f"seed {seed} v3: {result.detail}")
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/regression/aggregate_partial_init_sroa.c b/tests/regression/aggregate_partial_init_sroa.c
new file mode 100644
index 00000000..7d55ea2b
--- /dev/null
+++ b/tests/regression/aggregate_partial_init_sroa.c
@@ -0,0 +1,101 @@
+/* T9 (vellvm/vir transplant follow-up): partially initialised aggregates read
+ * after SROA-style scalarisation.  The C analogue of Vellvm's known
+ * insertvalue-into-undef failure: a struct whose unwritten members are
+ * indeterminate is scalarised, and only the written members may be observed.
+ * Every read below is of a member the program has stored to (C11 6.2.6.1,
+ * 6.7.9), so the program is free of undefined behaviour; the reference
+ * compiler's sanitizer run is the proof, and the differential run compares
+ * stdout against GCC.  Indeterminate members are never read.  Aggregates are
+ * copied whole, which is defined for a struct of unsigned-char-like storage. */
+#include <stdio.h>
+#include <string.h>
+
+struct P3 { int a; int b; int c; };
+struct Mixed { char tag; double w; short s; int n; };
+struct Pad { char c; long l; char d; };
+union U { int i; float f; unsigned char b[4]; };
+
+__attribute__((noinline)) static int sum3(struct P3 p) { return p.a * 3 + p.c; }
+__attribute__((noinline)) static struct P3 make_ac(int x) {
+    struct P3 p;
+    p.a = x;
+    p.c = x * 2;
+    return p; /* b never written: returned, never read by any caller */
+}
+__attribute__((noinline)) static double mixed_w(struct Mixed m) { return m.w * 2.0 + m.tag; }
+
+static volatile int sink;
+
+int main(void) {
+    /* 1. Only a and c are written; the copy carries an indeterminate b. */
+    struct P3 s;
+    s.a = 5;
+    s.c = 9;
+    struct P3 t = s;
+    sink = t.a + t.c;
+    printf("sroa-copy %d %d %d\n", t.a, t.c, sum3(t));
+
+    /* 2. Designated initialiser leaves b zero; partial write afterwards. */
+    struct P3 d = { .a = 11 };
+    d.c = -4;
+    printf("designated %d %d\n", d.a, d.c);
+
+    /* 3. Struct returned from a callee that wrote two of three members. */
+    for (int i = 0; i < 4; i++) {
+        struct P3 r = make_ac(i + 1);
+        printf("ret %d %d\n", r.a, r.c);
+    }
+
+    /* 4. Mixed-type aggregate, only some members stored, passed by value. */
+    struct Mixed m;
+    m.tag = 'A';
+    m.w = 1.5;
+    m.n = 42;
+    printf("mixed %.2f %d\n", mixed_w(m), m.n);
+
+    /* 5. Union written through one member and read through another that
+     *    overlaps only the written bytes (defined: C11 6.5.2.3). */
+    union U u;
+    u.i = 0x01020304;
+    printf("union bytes %u %u %u %u\n", u.b[0], u.b[1], u.b[2], u.b[3]);
+    u.f = 1.0f;
+    printf("union float bits %08x\n", (unsigned)u.i);
+
+    /* 6. Partially written array of structs; every element's written fields read back. */
+    struct P3 arr[6];
+    for (int i = 0; i < 6; i++) {
+        arr[i].a = i * i;
+        arr[i].b = -i;
+        arr[i].c = i + 100;
+    }
+    long acc = 0;
+    for (int i = 0; i < 6; i++) acc += arr[i].a * 7 + arr[i].b + arr[i].c;
+    printf("array acc %ld\n", acc);
+
+    /* 7. Padding is never read; only the members of struct Pad are. */
+    struct Pad pd;
+    pd.c = 'x';
+    pd.l = 1234567890123L;
+    pd.d = 'y';
+    struct Pad pc;
+    memcpy(&pc, &pd, sizeof pd);
+    printf("pad %c %ld %c\n", pc.c, pc.l, pc.d);
+
+    /* 8. Conditionally initialised aggregate: the branch decides which
+     *    members are stored; only the stored member is read on each path. */
+    for (int k = 0; k < 3; k++) {
+        struct P3 q;
+        if (k == 0) {
+            q.a = 7;
+            printf("cond0 %d\n", q.a);
+        } else if (k == 1) {
+            q.c = 8;
+            printf("cond1 %d\n", q.c);
+        } else {
+            q.b = 9;
+            q.a = q.b + 1;
+            printf("cond2 %d %d\n", q.a, q.b);
+        }
+    }
+    return 0;
+}
diff --git a/tests/regression/check_round_cap_observability.sh b/tests/regression/check_round_cap_observability.sh
new file mode 100755
index 00000000..1b275d88
--- /dev/null
+++ b/tests/regression/check_round_cap_observability.sh
@@ -0,0 +1,66 @@
+#!/usr/bin/env bash
+# T5 of engineering/FOLLOWUP-2026-10-18-vellvm-vir-transplant.md: a bounded
+# fixpoint loop that stops because its round budget ran out (while the last
+# round still changed the IR) must be observable, not silent.
+#
+# Two checks, both fail closed:
+#   1. Static: every `round_cap::Site` variant is wired to exactly one
+#      `note_cap_hit(round_cap::Site::<V>)` call in src/passes, and every
+#      call names a declared variant. A new site without a call, or a call
+#      whose counter was deleted, fails here.
+#   2. Behavioral witnesses: `cross_pr_redteam.c` exhausts backedge_pre's
+#      3-round budget and `fortify_open_va_pack.c` exhausts the ordinary
+#      inline budget, both at -O2 (2 654-file corpus sweep, see the
+#      follow-up). Under CCC_TIME_PASSES=1 the compiler must print the
+#      matching `round_cap <site>` line; with the variable unset it must
+#      print nothing. A cap-hit edit that drops the report, or a cap change
+#      that removes the witness, fails here and must be re-measured rather
+#      than silently relaxed.
+set -euo pipefail
+ROOT=$(cd "$(dirname "$0")/../.." && pwd)
+cd "$ROOT"
+CCC=${CCC:-target/fastbuild/lccc}
+tmp=$(mktemp -d "${TMPDIR:-/tmp}/lccc-roundcap.XXXXXX")
+trap 'rm -rf "$tmp"' EXIT
+
+fail=0
+die() { echo "FAIL: $*" >&2; fail=1; }
+
+# 1. Static wiring ---------------------------------------------------------
+decl=$(sed -n '/^pub(crate) enum Site {/,/^}/p' src/passes/round_cap.rs \
+    | sed -n 's/^    \([A-Za-z]*\),$/\1/p')
+[ -n "$decl" ] || die "could not parse the Site enum in src/passes/round_cap.rs"
+calls=$(grep -rhoE 'round_cap::note_cap_hit\(round_cap::Site::[A-Za-z]+\)' src/passes \
+    | sed -E 's/.*Site::([A-Za-z]+)\)/\1/' | sort)
+for v in $decl; do
+    n=$(grep -c "^$v\$" <<<"$calls" || true)
+    [ "$n" -eq 1 ] || die "Site::$v has $n note_cap_hit call(s), want exactly 1"
+done
+while read -r c; do
+    [ -n "$c" ] || continue
+    grep -qx "$c" <<<"$decl" || die "note_cap_hit names undeclared Site::$c"
+done <<<"$calls"
+echo "static: $(wc -w <<<"$decl" | tr -d ' ') sites wired"
+
+# 2. Behavioral witnesses ---------------------------------------------------
+# Each pair is "<source> <expected report prefix>", measured on the 2 654-file
+# corpus at -O2 (see the follow-up document). The report must appear under
+# CCC_TIME_PASSES=1 and must not appear without it.
+witness() {
+    local src=$1 want=$2
+    CCC_TIME_PASSES=1 "$CCC" -O2 -c "$src" -o "$tmp/on.o" 2>"$tmp/on.err" \
+        || { die "lccc failed on $src with CCC_TIME_PASSES=1"; return; }
+    grep -q "^\[PASS\] round_cap $want: [0-9][0-9]* hit(s)\$" "$tmp/on.err" \
+        || { die "no 'round_cap $want' report for $src under CCC_TIME_PASSES=1"; return; }
+    "$CCC" -O2 -c "$src" -o "$tmp/off.o" 2>"$tmp/off.err" \
+        || { die "lccc failed on $src without CCC_TIME_PASSES"; return; }
+    grep -q 'round_cap' "$tmp/off.err" && die "round_cap output leaked without CCC_TIME_PASSES for $src"
+    echo "witness: $want on $src"
+}
+witness tests/regression/cross_pr_redteam.c backedge_pre
+witness tests/regression/fortify_open_va_pack.c inline_ordinary_rounds
+
+if [ "$fail" -ne 0 ]; then
+    exit 1
+fi
+echo "OK check_round_cap_observability"
