+            }
+            Defsym::Constant(v) => v,
+            Defsym::Expression(e) => defsym::eval_with_symbols(&e, &|n| {
+                globals
+                    .get(n)
+                    .and_then(|g| g.defined_in.is_some().then_some(g.value))
+            })
+            .map_err(|err| format!("{shown}: {}", err.message()))?,
+        };
