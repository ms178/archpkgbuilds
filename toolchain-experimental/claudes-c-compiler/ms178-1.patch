+/* User SIMD instructions are allowed; compiler-generated operand transfers
+ * remain outside provenance markers and are forbidden in general-regs-only.
+ * Observe raw bits (including negative zero), not just floating equality. */
+typedef unsigned long u64;
+typedef u64 vec2 __attribute__((vector_size(16)));
+
+__attribute__((noinline)) static u64 double_bits(const double *p) {
+    u64 result;
+    __asm__ volatile("fmov %0, %d1" : "=r"(result) : "w"(*p));
+    return result;
+}
+__attribute__((noinline)) static unsigned float_bits(const float *p) {
+    unsigned result;
+    __asm__ volatile("fmov %w0, %s1" : "=r"(result) : "w"(*p));
+    return result;
+}
+__attribute__((noinline)) static u64 integer_bits(u64 x) {
+    u64 result;
+    __asm__ volatile("fmov %0, %d1" : "=r"(result) : "w"(x));
+    return result;
+}
+__attribute__((noinline)) static u64 high_lane(const vec2 *p) {
+    u64 result;
+    __asm__ volatile("umov %0, %1.d[1]" : "=r"(result) : "w"(*p));
+    return result;
+}
+__attribute__((noinline)) static u64 high_lane_fixed(const vec2 *p, u64 key) {
+    register u64 held __asm__("x17") = key;
+    u64 result;
+    __asm__ volatile("umov %0, %2.d[1]\n\teor %0, %0, %1"
+                     : "=&r"(result) : "r"(held), "w"(*p));
+    return result;
+}
+int test(void) {
+    const double d[] = {1.25, -2.5, -0.0};
+    const u64 db[] = {0x3ff4000000000000UL, 0xc004000000000000UL, 0x8000000000000000UL};
+    const float f[] = {1.25f, -2.5f, -0.0f};
+    const unsigned fb[] = {0x3fa00000U, 0xc0200000U, 0x80000000U};
+    for (int i = 0; i < 3; ++i) {
+        if (double_bits(d+i) != db[i]) return 1;
+        if (float_bits(f+i) != fb[i]) return 2;
+        if (integer_bits(db[i]) != db[i]) return 3;
+    }
+    const vec2 v = {0x123456789abcdef0UL, 0xfedcba9876543210UL};
+    if (high_lane(&v) != 0xfedcba9876543210UL) return 4;
+    if (high_lane_fixed(&v, 0xabcdef1234567890UL) !=
+        (0xfedcba9876543210UL ^ 0xabcdef1234567890UL)) return 5;
+    return 0;
+}
diff --git a/tests/regression/fixtures/licm-ordering/driver.c b/tests/regression/fixtures/licm-ordering/driver.c
new file mode 100644
index 00000000..741407ef
--- /dev/null
+++ b/tests/regression/fixtures/licm-ordering/driver.c
@@ -0,0 +1,25 @@
+#include <pthread.h>
+#include <stdio.h>
+int ordering_g0, ordering_g1, ordering_g2, ordering_g3;
+unsigned ordering_ready, ordering_done;
+extern int ordering_before_acquire(int);
+static void *publish(void *unused) {
+    (void)unused;
+    while (!__atomic_load_n(&ordering_ready, __ATOMIC_ACQUIRE)) {}
+    ordering_g0 = 11; ordering_g1 = 12; ordering_g2 = 13; ordering_g3 = 14;
+    __atomic_store_n(&ordering_done, 1, __ATOMIC_RELEASE);
+    return 0;
+}
+int main(void) {
+    for (int round = 0; round < 8; ++round) {
+        ordering_ready = ordering_done = 0;
+        ordering_g0 = 1; ordering_g1 = 2; ordering_g2 = 3; ordering_g3 = 4;
+        pthread_t writer;
+        if (pthread_create(&writer, 0, publish, 0)) return 2;
+        int actual = ordering_before_acquire(2);
+        if (pthread_join(writer, 0)) return 3;
+        if (actual != 60) { printf("FAIL round=%d result=%d expected=60\n", round, actual); return 1; }
+    }
+    puts("ordering handshake: 8 rounds pass");
+    return 0;
+}
diff --git a/tests/regression/fixtures/licm-ordering/probe.c b/tests/regression/fixtures/licm-ordering/probe.c
new file mode 100644
index 00000000..cfb6bd96
--- /dev/null
+++ b/tests/regression/fixtures/licm-ordering/probe.c
@@ -0,0 +1,36 @@
+/* Plain global accesses are protected by a release/acquire handshake in driver.c.
+   In the second iteration even a load textually BEFORE the acquire is after
+   the first iteration's acquire. Ordinal-only LICM across the backedge is wrong. */
+extern int ordering_g0, ordering_g1, ordering_g2, ordering_g3;
+extern unsigned ordering_ready, ordering_done;
+__attribute__((noinline)) int ordering_before_acquire(int n) {
+    int sum = 0;
+    for (int i = 0; i < n; ++i) {
+        sum += ordering_g0 + ordering_g1 + ordering_g2 + ordering_g3;
+        if (i == 0) {
+            __atomic_store_n(&ordering_ready, 1, __ATOMIC_RELEASE);
+            while (!__atomic_load_n(&ordering_done, __ATOMIC_ACQUIRE)) {}
+        }
+    }
+    return sum;
+}
+/* Shape-only cost witnesses; not concurrent performance measurements. */
+__attribute__((noinline)) unsigned ordering_acquire_shape(unsigned n) {
+    unsigned sum = 0;
+    if (!n) return 0;
+    unsigned i = 0;
+    do {
+        __atomic_load_n(&ordering_done, __ATOMIC_ACQUIRE);
+        sum += (unsigned)ordering_g0 + ordering_g1 + ordering_g2 + ordering_g3;
+    } while (++i < n);
+    return sum;
+}
+__attribute__((noinline)) unsigned ordering_plain_shape(unsigned n) {
+    unsigned sum = 0;
+    if (!n) return 0;
+    unsigned i = 0;
+    do {
+        sum += (unsigned)ordering_g0 + ordering_g1 + ordering_g2 + ordering_g3;
+    } while (++i < n);
+    return sum;
+}
