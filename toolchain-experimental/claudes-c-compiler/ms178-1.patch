+/// may observe. The returned offset is the mathematical `k` used to seed the
+/// pointer recurrence; `None` means the affine form must remain untouched.
+fn affine_add_offset_cannot_wrap(
+    func: &IrFunction,
+    lp: &NaturalLoop,
+    back_blocks: &[usize],
+    iv: &BasicIV,
+    raw_offset: i64,
+    add_ty: IrType,
