+                cast(4, 3, IrType::U32, IrType::I16),
+                Instruction::BinOp {
+                    dest: Value(5),
+                    op: IrBinOp::Add,
+                    lhs: v(0),
+                    rhs: v(0),
+                    ty: IrType::I64,
