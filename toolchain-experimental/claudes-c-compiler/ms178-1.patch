+    #[test]
+    fn forwards_each_copy_of_a_reused_temporary() {
+        // The same temporary is refilled twice in one block: each copy owns
+        // the reads up to the next whole-object copy, and both are forwarded.
+        let mut func = multi_block(vec![vec![
+            alloca(0, 24),
+            alloca(1, 24),
+            alloca(2, 24),
+            Instruction::Memcpy {
+                dest: Value(0),
+                src: Value(2),
+                size: 24,
+            },
+            Instruction::Load {
+                volatile: false,
+                dest: Value(3),
+                ptr: Value(0),
+                ty: IrType::U64,
+                seg_override: AddressSpace::Default,
+            },
+            Instruction::Memcpy {
+                dest: Value(0),
+                src: Value(1),
+                size: 24,
+            },
+            Instruction::Load {
+                volatile: false,
