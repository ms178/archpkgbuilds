+                }
+                if max_x <= u32::MAX as u64 && udivisor <= u32::MAX as u64 {
+                    expand_urem32_in_i64(dest, lhs, udivisor as u32, next_id)
+                } else {
+                    expand_urem64(dest, lhs, udivisor, IrType::I64, next_id)
+                }
+            }
+            _ => None,
+        }
+    }
