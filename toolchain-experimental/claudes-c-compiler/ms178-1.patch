+                            alloca(10, 32, 32),
+                            alloca(20, 32, 32),
+                            intrinsic(
+                                Some(1),
+                                IntrinsicOp::Loadu256,
+                                Some(0),
+                                vec![Operand::Value(Value(10))],
+                            ),
+                            intrinsic(None, op, Some(destination), vec![Operand::Value(Value(0))]),
+                        ],
+                    )],
