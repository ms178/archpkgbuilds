+        (Some("sxtx"), true) => Ok((0b111, s_bit)),
+        (None | Some("uxtw"), false) => Ok((0b010, s_bit)),
+        (Some("sxtw"), false) => Ok((0b110, s_bit)),
+        (Some("lsl"), false) => Err(format!(
