index 200d7f092..9c98f0627 100755
--- a/tests/regression/check_sibcall_shapes.sh
+++ b/tests/regression/check_sibcall_shapes.sh
@@ -584,7 +584,12 @@ for opt in -O1 -O2; do
     done
 done
 if "$gcc" --version 2>/dev/null | grep -q "16\.2"; then
-    "$gcc" -O2 "$tmp/arms_rt.c" -o "$tmp/arms_rt_gcc"
+    # The reference keeps every call 16-byte aligned, as lccc does. GCC's
+    # -fipa-stack-alignment (on at -O2) may call a local callee it proved
+    # alignment-free with %rsp = 8 mod 16, which `misaligned` counts (15 with
