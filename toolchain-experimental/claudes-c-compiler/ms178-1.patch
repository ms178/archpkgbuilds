+    # unencodable; both assemblers must refuse it.
+    for hi in ("ah", "ch", "dh", "bh"):
+        for lo in ("spl", "r8b", "dil", "sil", "bpl", "r15b"):
+            e.add(f"rexconflict_{hi}_{lo}", f".text\nmov %{hi}, %{lo}\n", "reject")
