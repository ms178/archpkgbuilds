+    fn interpret_rotation_fixture(f: &IrFunction) -> i64 {
+        fn read(op: Operand, values: &FxHashMap<u32, i64>) -> i64 {
+            match op {
+                Operand::Const(c) => c.to_i64().unwrap(),
+                Operand::Value(v) => values[&v.0],
+            }
