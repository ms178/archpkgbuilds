+        // be. A reader (cmov/setCC/adc/sbb/conditional jump/pushfq) before
+        // the next full flag writer would observe the wrong flags.
+        let guard_end = (seq_indices[test_scan + 1] + 64).min(len);
+        let mut flags_hazard = false;
