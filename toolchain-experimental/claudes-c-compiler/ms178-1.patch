--- /dev/null
+++ b/scripts/ci_resources.sh
@@ -0,0 +1,62 @@
+#!/usr/bin/env bash
+# Resolve Cargo parallelism/profile for the machine running CI.
+#
+# The default research host has 2 vCPUs, ~2 GiB RAM and (when the container
+# permits it) 3 GiB swap. A full Rust codegen process for lccc can approach the
+# RAM limit by itself. If swap activation is unavailable, use a low-memory
+# compiler profile rather than starting two optimized rustc processes and
+# letting the OOM killer turn a deterministic gate into a flaky failure.
+#
+# Source this file and call lccc_configure_resources before *all* Cargo
+# commands in a run. Exports are deliberate: build, test and clippy must share
+# the exact Cargo fingerprint/profile settings or each will rebuild lccc.
+# Optional `RAM_MB SWAP_MB CPUS` arguments let the policy be tested without
+# mutating the host's memory/swap state; production callers pass no arguments.
+
+lccc_configure_resources() {
+    local ram_mb=0 swap_mb=0 jobs=2 cpus=2
+    if (( $# > 0 )); then
+        if (( $# != 3 )); then
+            echo "usage: lccc_configure_resources [RAM_MB SWAP_MB CPUS]" >&2
+            return 2
+        fi
+        ram_mb=$1 swap_mb=$2 cpus=$3
+    elif [[ -r /proc/meminfo ]]; then
+        ram_mb=$(awk '/^MemTotal:/{print int($2/1024)}' /proc/meminfo)
+        swap_mb=$(awk '/^SwapTotal:/{print int($2/1024)}' /proc/meminfo)
+        cpus=$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 2)
+    elif command -v free >/dev/null 2>&1; then
+        ram_mb=$(free -m | awk '/^Mem:/{print $2}')
+        swap_mb=$(free -m | awk '/^Swap:/{print $2}')
+        cpus=$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 2)
+    fi
+    [[ $ram_mb =~ ^[0-9]+$ ]] || ram_mb=0
+    [[ $swap_mb =~ ^[0-9]+$ ]] || swap_mb=0
+
+    # Honor an explicit caller setting, but cap jobs at the CPU count and at
+    # two: this is a research/CI profile, never an oversubscription benchmark.
+    local requested=${CI_LOCAL_JOBS:-${CARGO_BUILD_JOBS:-2}}
+    [[ $requested =~ ^[1-9][0-9]*$ ]] || requested=2
+    [[ $cpus =~ ^[1-9][0-9]*$ ]] || cpus=2
+    jobs=$requested
+    (( jobs > 2 )) && jobs=2
+    (( jobs > cpus )) && jobs=$cpus
+
+    if (( ram_mb > 0 && ram_mb < 3072 && swap_mb < 2048 )); then
+        # No usable swap on a host too small for the normal fastbuild profile.
+        # Opt-level 0 affects only the Rust compiler executable, not the C
+        # optimization pipeline or generated code. It reduces peak LLVM memory;
+        # assertions remain enabled for cargo test below.
+        jobs=1
+        export CARGO_PROFILE_FASTBUILD_DEBUG=0
+        export CARGO_PROFILE_FASTBUILD_OPT_LEVEL=0
+        export CARGO_INCREMENTAL=0
+        echo "CI resources: ${ram_mb} MiB RAM / ${swap_mb} MiB swap; using one Cargo job, fastbuild opt-level 0, no debuginfo/incremental (memory-safe fallback)." >&2
+    else
+        echo "CI resources: ${ram_mb} MiB RAM / ${swap_mb} MiB swap; Cargo jobs=$jobs, fastbuild profile unchanged." >&2
+    fi
+    # Export the CLAMPED count, not the original requested value (otherwise
+    # clippy's separate -j option could undo the memory/CPU limit).
+    export CARGO_BUILD_JOBS=$jobs
+    export CI_LOCAL_JOBS=$jobs
+}
