+        );
+        assert!(
+            rejected >= 170,
+            "only {rejected} rejected rows remain; there were 172"
+        );
+        assert!(
+            drift.is_empty(),
+            "{} matrix row(s) disagree with this encoder:\n{}",
+            drift.len(),
+            drift
+                .iter()
+                .take(20)
+                .cloned()
+                .collect::<Vec<_>>()
+                .join("\n")
+        );
+    }
