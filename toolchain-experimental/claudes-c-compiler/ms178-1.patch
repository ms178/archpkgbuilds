+    let end = align_up(dot, 8);
+    RwLayout {
+        base: inp.base,
+        sections,
+        relro_sections,
+        init_arrays,
+        dynamic,
+        got,
+        relro_end_raw,
+        relro_seg_end,
+        got_plt,
+        irel_slots,
+        irela,
+        tls,
+        data_begin,
+        sdata_begin,
+        edata,
+        copies,
+        bss_end,
+        end,
+        file_end,
+    }
+}
