+                .any(|i| matches!(i, Instruction::BinOp { dest, op: IrBinOp::Mul, lhs: Operand::Value(l), rhs: Operand::Value(r), .. } if dest.0 == 9 && l.0 == 0 && r.0 == 1)),
+            "the invariant duplicate Mul is deleted"
+        );
+    }
