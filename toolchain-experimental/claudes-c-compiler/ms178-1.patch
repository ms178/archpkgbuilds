+/// passes through for the error message (`nop` stays `nop`).
+fn prefix_stem(mnemonic: &str) -> String {
+    let m = mnemonic.strip_suffix(".s").unwrap_or(mnemonic);
+    if m == "mov" || LOCKABLE_STEMS.contains(&m) {
+        return m.to_string();
+    }
