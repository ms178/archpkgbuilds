@@ -1970,11 +1987,9 @@ pub(super) fn fold_accumulator_alu_store(store: &mut LineStore, infos: &mut [Lin
                 LineKind::LoadRbp { reg, .. } if reg == src_family => break,
                 LineKind::Other { dest_reg } if dest_reg == src_family => break,
                 _ => {
