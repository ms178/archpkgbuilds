+    #[test]
+    fn sections_are_padded_to_the_strictest_alignment() {
+        // crt1.o's shape: CIE (0x18) + FDE (0x14) = 0x2c bytes, 8-aligned.
+        let full = synth_eh_frame(1, PCREL_SDATA4);
