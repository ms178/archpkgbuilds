+            kind: LineKind::InlineAsm,
+            ext_kind: ExtKind::None,
+            trim_start: infos[i].trim_start,
+            has_indirect_mem: true,
+            rbp_offset: RBP_OFFSET_NONE,
+            reg_refs: u16::MAX,
+            pinned: true,
