+    if std::env::var_os("CCC_NO_COPY_SUBREG_EXTEND_FOLD").is_some() {
+        return false;
+    }
+    let len = infos.len();
+    let mut changed = false;
+    let mut i = 0;
+    while i < len {
+        if infos[i].is_nop() {
+            i += 1;
+            continue;
+        }
+        let ti = trimmed(store, &infos[i], i);
+        // Line i: the staging copy — reg-to-reg `movl %S, %A` only.
+        let Some(rest) = ti.strip_prefix("movl ") else {
+            i += 1;
