+        _ => match reg {
+            "eax" => Some("eax"),
+            "ebx" => Some("ebx"),
+            "ecx" => Some("ecx"),
+            "edx" => Some("edx"),
+            "esi" => Some("esi"),
+            "edi" => Some("edi"),
+            "ebp" => Some("ebp"),
+            _ => None,
+        },
+    }
