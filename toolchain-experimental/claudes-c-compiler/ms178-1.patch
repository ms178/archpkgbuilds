+        // conservatively survive — this documents the soundness contract,
+        // not a missed optimization: real compiler output always carries
+        // the CFI delimiters.
+        let asm = "\
+.LBB3:
+    movl $1, %ecx
+    addl %ecx, %eax
+    movl %eax, (%rdi)
+    movl $1, %ecx
