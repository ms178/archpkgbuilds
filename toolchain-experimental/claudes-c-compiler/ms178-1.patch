+            and asm_option(cmd, "--lccc") == "target/fastbuild/lccc-x86"
+            and "gas-2.47-x86_64-linux-gnu/bin/as" in (asm_option(cmd, "--as") or "")
+            and set(ENCDIFF_CORPUS_FILES) == {t for t in cmd if t.endswith(".insn")}
+            for cmd in commands
