+/// byte lanes added by OP-05d.
+fn map_elem_size(elem_ty: &IrType) -> Option<u32> {
+    match elem_ty {
+        IrType::F64 | IrType::I64 | IrType::U64 => Some(8),
+        IrType::F32 | IrType::I32 | IrType::U32 => Some(4),
+        IrType::I8 | IrType::U8 => Some(1),
