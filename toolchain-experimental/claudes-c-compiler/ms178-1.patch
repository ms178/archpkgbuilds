+  def reject():
+   for arm in clis:
+    q=run(arm,['-d','-c'],blob)
+    if q.returncode==0:raise ValueError('accepted malformed frame '+arm)
+  check(tag,reject)
+ def memory_limit():
+  for arm in clis:
+   if run(arm,['-d','-c','-M1K'],frame.stdout).returncode==0:raise ValueError('memory ceiling ignored '+arm)
+ check('memory-limit',memory_limit)
