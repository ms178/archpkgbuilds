+        // Direct proof call: the weak body must fail even though its body
+        // only loads.
+        let mut cache = FxHashMap::default();
+        let fns = vec![reader];
+        assert!(!callee_readonly_through(&fns, "reader", 0, &mut cache));
+        // And the cache agrees on a second ask.
+        assert!(!callee_readonly_through(&fns, "reader", 0, &mut cache));
+    }
+
+    /// A duplicated ParamRef for the same index rejects (fail closed rather
+    /// than auditing whichever one was seen last).
+    #[test]
+    fn duplicated_param_ref_rejects() {
+        let mut reader = IrFunction::new("reader".to_string(), IrType::I32, vec![], false);
+        reader.blocks = vec![block(
+            0,
+            vec![
+                Instruction::ParamRef {
+                    dest: Value(1),
+                    param_idx: 0,
+                    ty: IrType::Ptr,
+                },
+                Instruction::ParamRef {
+                    dest: Value(4),
+                    param_idx: 0,
+                    ty: IrType::Ptr,
+                },
+                Instruction::Load {
+                    dest: Value(2),
+                    ptr: Value(1),
+                    ty: IrType::I32,
+                    volatile: false,
+                    seg_override: crate::common::types::AddressSpace::Default,
+                },
+            ],
+            Terminator::Return(Some(Operand::Value(Value(2)))),
+        )];
+        reader.next_value_id = 5;
+        let mut cache = FxHashMap::default();
+        let fns = vec![reader];
+        assert!(!callee_readonly_through(&fns, "reader", 0, &mut cache));
+    }
+
+    /// `BuiltinSetjmp` writes its jump buffer through `args[0]` with no
+    /// `dest_ptr` and no `writes_memory_via_args` membership: the callee
+    /// proof must reject a pointer that reaches it.
+    #[test]
+    fn builtin_setjmp_argument_rejects() {
+        let mut reader = IrFunction::new("reader".to_string(), IrType::I32, vec![], false);
+        reader.blocks = vec![block(
+            0,
+            vec![
+                Instruction::ParamRef {
+                    dest: Value(1),
+                    param_idx: 0,
+                    ty: IrType::Ptr,
+                },
+                Instruction::Intrinsic {
+                    dest: None,
+                    dest_ptr: None,
+                    op: IntrinsicOp::BuiltinSetjmp,
+                    args: vec![Operand::Value(Value(1))],
+                },
+            ],
+            Terminator::Return(Some(Operand::Const(IrConst::I32(0)))),
+        )];
+        reader.next_value_id = 2;
+        let mut cache = FxHashMap::default();
+        let fns = vec![reader];
+        assert!(
+            !callee_readonly_through(&fns, "reader", 0, &mut cache),
+            "setjmp's buffer argument is a memory write"
+        );
+    }
+
+    /// A pointer-to-integer cast fed to a scalar pure intrinsic (CRC32)
+    /// OBSERVES the address: promotion would change the computed value, so
+    /// the proof must reject. Casting back to a pointer (re-entry) must
+    /// still be allowed.
+    #[test]
+    fn pointer_identity_observation_rejects() {
+        let mut reader = IrFunction::new("reader".to_string(), IrType::I64, vec![], false);
+        reader.blocks = vec![block(
+            0,
+            vec![
+                Instruction::ParamRef {
+                    dest: Value(1),
+                    param_idx: 0,
+                    ty: IrType::Ptr,
+                },
+                // ptr -> int: the address value becomes observable.
+                Instruction::Cast {
+                    dest: Value(2),
+                    src: Operand::Value(Value(1)),
+                    from_ty: IrType::Ptr,
+                    to_ty: IrType::I64,
+                },
+                // int -> ptr on a COPY of the same integer: re-entry is fine
+                // when nothing else consumed the integer — so build the
+                // observation on a separate chain.
+                Instruction::Cast {
+                    dest: Value(6),
+                    src: Operand::Value(Value(1)),
+                    from_ty: IrType::Ptr,
+                    to_ty: IrType::I64,
+                },
+                Instruction::Cast {
+                    dest: Value(7),
+                    src: Operand::Value(Value(6)),
+                    from_ty: IrType::I64,
+                    to_ty: IrType::Ptr,
+                },
+                Instruction::Load {
+                    dest: Value(8),
+                    ptr: Value(7),
+                    ty: IrType::I32,
+                    volatile: false,
+                    seg_override: crate::common::types::AddressSpace::Default,
+                },
+                Instruction::Intrinsic {
+                    dest: Some(Value(3)),
+                    dest_ptr: None,
+                    op: IntrinsicOp::Crc32_64,
+                    args: vec![Operand::Value(Value(2))],
+                },
+            ],
+            Terminator::Return(Some(Operand::Value(Value(3)))),
+        )];
+        reader.next_value_id = 9;
+        let mut cache = FxHashMap::default();
+        let fns = vec![reader];
+        assert!(
+            !callee_readonly_through(&fns, "reader", 0, &mut cache),
+            "crc32 of the pointer's integer value observes the address"
+        );
+
+        // Without the crc32 consumption (the int only flows back into a
+        // pointer), the proof holds: re-entry is a legitimate round trip.
+        let mut roundtrip = IrFunction::new("roundtrip".to_string(), IrType::I32, vec![], false);
+        roundtrip.blocks = vec![block(
+            0,
+            vec![
+                Instruction::ParamRef {
+                    dest: Value(1),
+                    param_idx: 0,
+                    ty: IrType::Ptr,
+                },
+                Instruction::Cast {
+                    dest: Value(2),
+                    src: Operand::Value(Value(1)),
+                    from_ty: IrType::Ptr,
+                    to_ty: IrType::I64,
+                },
+                Instruction::Cast {
+                    dest: Value(3),
+                    src: Operand::Value(Value(2)),
+                    from_ty: IrType::I64,
+                    to_ty: IrType::Ptr,
+                },
+                Instruction::Load {
+                    dest: Value(4),
+                    ptr: Value(3),
+                    ty: IrType::I32,
+                    volatile: false,
+                    seg_override: crate::common::types::AddressSpace::Default,
+                },
+            ],
+            Terminator::Return(Some(Operand::Value(Value(4)))),
+        )];
+        roundtrip.next_value_id = 5;
+        let mut cache = FxHashMap::default();
+        let fns = vec![roundtrip];
+        assert!(
+            callee_readonly_through(&fns, "roundtrip", 0, &mut cache),
+            "a pure ptr->int->ptr round trip observes nothing"
+        );
+    }
+
+    /// A load through a caller-side COPY of the address (the derivation
+    /// chains the rewrite now supports) must promote — the copy's source is
+    /// substituted with the GlobalAddr.
+    #[test]
+    fn caller_side_copy_derivation_promotes() {
+        let mut reader = IrFunction::new("reader".to_string(), IrType::I32, vec![], false);
+        reader.is_static = true;
+        reader.blocks = vec![block(
+            0,
+            vec![
+                Instruction::ParamRef {
+                    dest: Value(1),
+                    param_idx: 0,
+                    ty: IrType::Ptr,
+                },
+                Instruction::Load {
+                    dest: Value(2),
+                    ptr: Value(1),
+                    ty: IrType::I32,
+                    volatile: false,
+                    seg_override: crate::common::types::AddressSpace::Default,
+                },
+            ],
+            Terminator::Return(Some(Operand::Value(Value(2)))),
+        )];
+        reader.next_value_id = 3;
+
+        let mut caller = IrFunction::new("caller".to_string(), IrType::I32, vec![], false);
+        let mut stores = Vec::new();
+        let mut next = 3;
+        for i in 0..4usize {
+            stores.push(Instruction::GetElementPtr {
+                dest: Value(next),
+                base: Value(1),
+                offset: Operand::Const(IrConst::I64((i * 4) as i64)),
+                ty: IrType::U8,
+            });
+            stores.push(Instruction::Store {
+                val: Operand::Const(IrConst::I32(i as i32)),
+                ptr: Value(next),
+                ty: IrType::I32,
+                volatile: false,
+                seg_override: crate::common::types::AddressSpace::Default,
+            });
+            next += 1;
+        }
+        // const int *p = a; reader(p);
+        stores.push(Instruction::Copy {
+            dest: Value(next),
+            src: Operand::Value(Value(1)),
+        });
+        let p = Value(next);
+        next += 1;
+        caller.blocks = vec![block(
+            0,
+            {
+                let mut v = vec![Instruction::Alloca {
+                    dest: Value(1),
+                    size: 16,
+                    align: 1,
+                    ty: IrType::U8,
+                    volatile: false,
+                    semantic_volatile: false,
+                }];
+                v.extend(stores);
+                v.push(Instruction::Call {
+                    func: "reader".to_string(),
+                    info: crate::ir::reexports::CallInfo {
+                        args: vec![Operand::Value(p)],
+                        ..crate::ir::reexports::CallInfo::default()
+                    },
+                });
+                v
+            },
+            Terminator::Return(Some(Operand::Const(IrConst::I32(0)))),
+        )];
+        caller.next_value_id = next;
+        let mut m = mk_module(vec![caller, reader], vec![]);
+        let n = run(&mut m);
+        assert_verified(&m, "constarr:copy-derivation");
+        assert_eq!(n, 1, "the copy-derived read promotes");
+        // The caller's remaining instructions reference the GlobalAddr, and
+        // no instruction references the deleted alloca id 1.
+        let caller = &m.functions[0];
+        let mut has_global = false;
+        for b in &caller.blocks {
+            for inst in &b.instructions {
+                if let Instruction::GlobalAddr { .. } = inst {
+                    has_global = true;
+                }
+                inst.for_each_used_value(|id| {
+                    assert_ne!(id, 1, "deleted alloca still referenced");
+                });
+            }
+        }
+        assert!(has_global, "the GlobalAddr is materialized");
+    }
+
+    /// A write-only object (no load, no read-only call) must NOT promote:
+    /// it would become permanent dead .rodata.
+    #[test]
+    fn write_only_object_does_not_promote() {
+        let mut caller = IrFunction::new("caller".to_string(), IrType::I32, vec![], false);
+        let mut insts = vec![Instruction::Alloca {
+            dest: Value(1),
+            size: 4,
+            align: 1,
+            ty: IrType::U8,
+            volatile: false,
+            semantic_volatile: false,
+        }];
+        insts.push(Instruction::Store {
+            val: Operand::Const(IrConst::I32(7)),
+            ptr: Value(1),
+            ty: IrType::I32,
+            volatile: false,
+            seg_override: crate::common::types::AddressSpace::Default,
+        });
+        caller.blocks = vec![block(
+            0,
+            insts,
+            Terminator::Return(Some(Operand::Const(IrConst::I32(0)))),
+        )];
+        caller.next_value_id = 2;
+        let mut m = mk_module(vec![caller], vec![]);
+        let n = run(&mut m);
+        assert_eq!(n, 0, "write-only object stays an alloca");
+        assert!(m.globals.is_empty(), "no .rodata materialized");
+    }
+
+    /// Sparse pre-existing `.LCA_` names cannot collide with generated ones:
+    /// with `.LCA_0` and `.LCA_2` already present, the first fresh name is
+    /// `.LCA_1` (count-based generation would emit `.LCA_2` again).
+    #[test]
+    fn sparse_preexisting_lca_names_do_not_collide() {
+        let mut reader = IrFunction::new("reader".to_string(), IrType::I32, vec![], false);
+        reader.is_static = true;
+        reader.blocks = vec![block(
+            0,
+            vec![
+                Instruction::ParamRef {
+                    dest: Value(1),
+                    param_idx: 0,
+                    ty: IrType::Ptr,
+                },
+                Instruction::Load {
+                    dest: Value(2),
+                    ptr: Value(1),
+                    ty: IrType::I32,
+                    volatile: false,
+                    seg_override: crate::common::types::AddressSpace::Default,
+                },
+            ],
+            Terminator::Return(Some(Operand::Value(Value(2)))),
+        )];
+        reader.next_value_id = 3;
+
+        let mut caller = IrFunction::new("caller".to_string(), IrType::I32, vec![], false);
+        let mut insts = vec![Instruction::Alloca {
+            dest: Value(1),
+            size: 4,
+            align: 1,
+            ty: IrType::U8,
+            volatile: false,
+            semantic_volatile: false,
+        }];
+        insts.push(Instruction::Store {
+            val: Operand::Const(IrConst::I32(7)),
+            ptr: Value(1),
+            ty: IrType::I32,
+            volatile: false,
+            seg_override: crate::common::types::AddressSpace::Default,
+        });
+        insts.push(Instruction::Call {
+            func: "reader".to_string(),
+            info: crate::ir::reexports::CallInfo {
+                args: vec![Operand::Value(Value(1))],
+                ..crate::ir::reexports::CallInfo::default()
+            },
+        });
+        caller.blocks = vec![block(
+            0,
+            insts,
+            Terminator::Return(Some(Operand::Const(IrConst::I32(0)))),
+        )];
+        caller.next_value_id = 2;
+
+        let pre = |name: &str| IrGlobal {
+            name: name.to_string(),
+            ty: IrType::U8,
+            size: 1,
+            align: 1,
+            init: GlobalInit::Array(vec![IrConst::I8(0)]),
+            is_static: true,
+            is_const: true,
+            is_extern: false,
+            is_common: false,
+            section: None,
+            is_weak: false,
+            visibility: None,
+            has_explicit_align: false,
+            is_used: true,
+            is_thread_local: false,
+        };
+        let mut m = mk_module(vec![caller, reader], vec![pre(".LCA_0"), pre(".LCA_2")]);
+        let n = run(&mut m);
+        assert_verified(&m, "constarr:sparse-names");
+        assert_eq!(n, 1);
+        let names: Vec<&str> = m.globals.iter().map(|g| g.name.as_str()).collect();
+        assert!(names.contains(&".LCA_1"), "names: {:?}", names);
+        // No duplicates.
+        let mut sorted = names.clone();
+        sorted.sort_unstable();
+        sorted.dedup();
+        assert_eq!(sorted.len(), names.len(), "no duplicate globals");
+    }
+
+    /// A store through a variable-offset GEP of the array rejects the
+    /// candidate (the shipped P0: the runtime store landed in .rodata).
+    #[test]
+    fn variable_offset_store_rejects() {
+        let mut reader = IrFunction::new("reader".to_string(), IrType::I32, vec![], false);
+        reader.is_static = true;
+        reader.blocks = vec![block(
+            0,
+            vec![
+                Instruction::ParamRef {
+                    dest: Value(1),
+                    param_idx: 0,
+                    ty: IrType::Ptr,
+                },
+                Instruction::Load {
+                    dest: Value(2),
+                    ptr: Value(1),
+                    ty: IrType::I32,
+                    volatile: false,
+                    seg_override: crate::common::types::AddressSpace::Default,
+                },
+            ],
+            Terminator::Return(Some(Operand::Value(Value(2)))),
+        )];
+        reader.next_value_id = 3;
+
+        let mut caller = IrFunction::new("caller".to_string(), IrType::I32, vec![], false);
+        let mut insts = vec![
+            Instruction::ParamRef {
+                dest: Value(9),
+                param_idx: 0,
+                ty: IrType::I32,
+            },
+            Instruction::Alloca {
+                dest: Value(1),
+                size: 16,
+                align: 1,
+                ty: IrType::U8,
+                volatile: false,
+                semantic_volatile: false,
+            },
+        ];
+        // Constant tiling first.
+        for i in 0..4usize {
+            insts.push(Instruction::GetElementPtr {
+                dest: Value(10 + i as u32),
+                base: Value(1),
+                offset: Operand::Const(IrConst::I64((i * 4) as i64)),
+                ty: IrType::U8,
+            });
+            insts.push(Instruction::Store {
+                val: Operand::Const(IrConst::I32(i as i32)),
+                ptr: Value(10 + i as u32),
+                ty: IrType::I32,
+                volatile: false,
+                seg_override: crate::common::types::AddressSpace::Default,
+            });
+        }
+        // Then the variable-offset runtime store.
+        insts.push(Instruction::GetElementPtr {
+            dest: Value(20),
+            base: Value(1),
+            offset: Operand::Value(Value(9)),
+            ty: IrType::U8,
+        });
+        insts.push(Instruction::Store {
+            val: Operand::Value(Value(9)),
+            ptr: Value(20),
+            ty: IrType::I32,
+            volatile: false,
+            seg_override: crate::common::types::AddressSpace::Default,
+        });
+        insts.push(Instruction::Call {
+            func: "reader".to_string(),
+            info: crate::ir::reexports::CallInfo {
+                args: vec![Operand::Value(Value(1))],
+                ..crate::ir::reexports::CallInfo::default()
+            },
+        });
+        caller.blocks = vec![block(
+            0,
+            insts,
+            Terminator::Return(Some(Operand::Const(IrConst::I32(0)))),
+        )];
+        caller.next_value_id = 21;
+        let mut m = mk_module(vec![caller, reader], vec![]);
+        let n = run(&mut m);
+        assert_eq!(n, 0, "the variable-offset store rejects promotion");
+    }
+}
