diff --git a/tests/data/got_slot_local_addend_i686.s b/tests/data/got_slot_local_addend_i686.s
new file mode 100644
index 00000000..557034a4
--- /dev/null
+++ b/tests/data/got_slot_local_addend_i686.s
@@ -0,0 +1,33 @@
+# Regression: the same GOT-slot reference on i686 (`q@GOT(%ebx)`), where the
+# GOT base comes from the i386 PC thunk.  `main` returns 3*5 + 5*2 = 25.
+#
+# i686 has two spellings for this operator: GAS emits `R_386_GOT32X` for the
+# `mov`-load form (the linker may relax it to `q@GOTOFF(%ebx)`, removing the
+# GOT entry and the load) and `R_386_GOT32` elsewhere.  LCCC currently emits
+# `R_386_GOT32` in both cases: the relocation is correct and the pipelines
+# below all return 25, but the relaxable spelling is not offered.  The gate
+# asserts the values and reports the spelling difference explicitly against
+# the GAS oracle; the follow-up ledger carries the analysis
+# (engineering/FOLLOWUP-2026-10-13-audit-fix-session.md).
+	.data
+	.local	q1
+	.p2align 2
+q1:	.long	3
+	.local	q2
+	.p2align 2
+q2:	.long	5
+	.text
+	.globl	main
+main:
+	pushl	%ebx
+	call	__x86.get_pc_thunk.bx
+	addl	$_GLOBAL_OFFSET_TABLE_, %ebx
+	movl	q1@GOT(%ebx), %ecx
+	movl	(%ecx), %eax
+	movl	q2@GOT(%ebx), %edx
+	movl	(%edx), %edx
+	leal	(%eax,%eax,4), %eax
+	addl	%edx, %edx
+	addl	%edx, %eax
+	popl	%ebx
+	ret
diff --git a/tests/data/got_slot_local_addend_x86_64.s b/tests/data/got_slot_local_addend_x86_64.s
new file mode 100644
index 00000000..3d02ada2
--- /dev/null
+++ b/tests/data/got_slot_local_addend_x86_64.s
@@ -0,0 +1,36 @@
+# Regression: a GOT-slot reference to a file-local symbol must keep the symbol
+# in the relocation, and the assembler must pick the spelling GAS picks.
+#
+# Two locals with nonzero offsets in `.data` are read through their GOT slots;
+# `main` returns 3*5 + 5*2 = 25.  If the assembler folds the symbol into the
+# section (the AUD-CPU-1 GOT32/GOTPCREL defect), the linker computes the slot
+# from `.data` and adds the symbol offset a second time: the program then
+# returns a garbage value in a static link (measured: 145 with GNU ld) or
+# faults under the LCCC linker, because the address it dereferences is
+# `slot + offset` instead of the symbol.
+#
+# Measured against GAS 2.47 on this exact file: both `movq q@GOTPCREL(%rip)`
+# references are `R_X86_64_REX_GOTPCRELX` against `q1`/`q2` -- the symbol is
+# never folded, and the relaxable spelling is the one the linker may rewrite
+# into a direct `lea` (which is what makes the static link return 25).
+#
+# Every pipeline in tests/regression/check_got_slot_local_addend.sh must give
+# exit status 25: LCCC x86-64 (default and -no-pie) and LCCC object + GNU ld.
+	.data
+	.local	q1
+	.p2align 3
+q1:	.quad	3
+	.local	q2
+	.p2align 3
+q2:	.quad	5
+	.text
+	.globl	main
+main:
+	movq	q1@GOTPCREL(%rip), %rcx
+	movq	(%rcx), %rax
+	movq	q2@GOTPCREL(%rip), %rdx
+	movq	(%rdx), %rdx
+	leaq	(%rax,%rax,4), %rax
+	addq	%rdx, %rdx
+	addq	%rdx, %rax
+	ret
diff --git a/tests/regression/builtin_cpu_supports_default.c b/tests/regression/builtin_cpu_supports_default.c
new file mode 100644
index 00000000..c93cced8
--- /dev/null
+++ b/tests/regression/builtin_cpu_supports_default.c
@@ -0,0 +1,67 @@
+/* AUD-CPU-1 differential: __builtin_cpu_supports answers the question "does
+ * the CPU executing this program have the feature?", for every modelled name,
+ * under the default target — GCC, Clang and ICX all lower it to a runtime
+ * CPU-model lookup and never fold it against -march (measured with
+ * scripts/godbolt.py; see tests/data/cpu_supports_name_census.json for the
+ * name-space oracle).
+ *
+ * Every name is written as a literal at the call site, because a loop over a
+ * name array is not accepted by any of the four compilers ("parameter to
+ * builtin must be a string constant or literal" / "parameter to builtin not
+ * valid"), and `tests/workloads/dispatch/README.md` records the same rule for
+ * the measurement harnesses.
+ *
+ * run_regression.py's GCC differential compares two *runtime* probes of the
+ * same host: any answer that depends on the compile flags (the AUD-CPU-1
+ * defect — `-march=x86-64` answered 0 for avx2/bmi2/sha on a CPU that has
+ * them, the default target answered 1 on machines that lack them) shows up as
+ * a diff.
+ *
+ * Host-independent invariants: SSE2 exists on every CPU this compiler can run
+ * on (x86-64 baseline / i686 with SSE2), and the two spellings of a feature
+ * must agree with each other, because GCC accepts both.
+ */
+#include <stdio.h>
+
+#define PROBE(name) printf(name "=%d\n", !!__builtin_cpu_supports(name))
+
+int main(void) {
+    PROBE("sse");
+    PROBE("sse2");
+    PROBE("sse3");
+    PROBE("ssse3");
+    PROBE("sse4.1");
+    PROBE("sse4.2");
+    PROBE("sse4a");
+    PROBE("popcnt");
+    PROBE("cmov");
+    PROBE("mmx");
+    PROBE("aes");
+    PROBE("pclmul");
+    PROBE("sha");
+    PROBE("avx");
+    PROBE("avx2");
+    PROBE("fma");
+    PROBE("f16c");
+    PROBE("bmi");
+    PROBE("bmi2");
+    PROBE("lzcnt");
+    PROBE("movbe");
+    PROBE("adx");
+    PROBE("rdseed");
+    PROBE("fsgsbase");
+    PROBE("avx512f");
+    PROBE("avx512bw");
+    PROBE("avx512vl");
+    PROBE("gfni");
+    PROBE("vaes");
+    PROBE("vpclmulqdq");
+    PROBE("amx-tile");
+    PROBE("cx16");
+    PROBE("xsave");
+
+    /* A compile-time answer would also fail these two. */
+    if (!__builtin_cpu_supports("sse2")) return 1;
+    if (!!__builtin_cpu_supports("sse4_2") != !!__builtin_cpu_supports("sse4.2")) return 2;
+    return 0;
+}
diff --git a/tests/regression/builtin_cpu_supports_guard.c b/tests/regression/builtin_cpu_supports_guard.c
new file mode 100644
index 00000000..188cfd70
--- /dev/null
+++ b/tests/regression/builtin_cpu_supports_guard.c
@@ -0,0 +1,112 @@
+/* AUD-CPU-1: the guarded probe initialiser must be transparent.
+ *
+ * Every function that reads a probe word gets one initialiser for the whole
+ * function, reached through an inline test of the ready flag (see
+ * `splice_cpu_probe_init`).  That makes the initialiser a call inside an
+ * otherwise leaf function, so the value it must not break is *anything live
+ * across it*: parameters still needed afterwards, values computed before the
+ * probe, and the caller's registers in general.  The cases below are the ones
+ * a register allocator gets wrong when a call is inserted late:
+ *
+ *   loop_probe     probe in a loop body (guard must dominate the back edge)
+ *   cond_probe     probe inside a nested conditional (guard in the entry
+ *                  block, not in the branch it is used from)
+ *   label_probe    goto loop (a back edge, so the guard's block has several
+ *                  successors and the probe is not in straight-line code)
+ *   two_sites      two probe sites in one function: exactly one initialiser
+ *   first_stmt     the probe is the function's first statement
+ *   many_args      8 arguments, all live across the initialiser call — the
+ *                  ones the ABI passes on the stack must survive it
+ *   lead/recurse   a function that is otherwise inlinable/leaf, and recursion
+ *
+ * The expected answers are computed from `main`'s own probes, so the test is
+ * host-independent: it fails only if a probe *inside* a function disagrees
+ * with a probe at top level, which is exactly the failure mode of a misplaced
+ * or missing initialiser.  run_regression.py additionally compares this
+ * program's output byte-for-byte against GCC's.
+ */
+#include <stdio.h>
+
+__attribute__((noinline)) static int loop_probe(void) {
+    int i, s = 0;
+    for (i = 0; i < 1000; i++) {
+        s += __builtin_cpu_supports("avx2") ? 1 : 0;
+    }
+    return s;
+}
+
+__attribute__((noinline)) static int cond_probe(int x, int y) {
+    int r = x;
+    if (x) {
+        if (__builtin_cpu_supports("sse2")) {
+            r += y;
+        } else {
+            r -= y;
+        }
+    }
+    return r;
+}
+
+__attribute__((noinline)) static int label_probe(int n) {
+    int s = 0;
+again:
+    if (__builtin_cpu_supports("sse2")) {
+        s += n;
+    }
+    if (n--) {
+        goto again;
+    }
+    return s;
+}
+
+__attribute__((noinline)) static int two_sites(int a, int b) {
+    int r = 0;
+    if (__builtin_cpu_supports("avx2")) {
+        r += a;
+    }
+    if (__builtin_cpu_supports("bmi2")) {
+        r += b;
+    }
+    return r;
+}
+
+__attribute__((noinline)) static int first_stmt(void) {
+    return __builtin_cpu_supports("avx512f") ? 7 : 3;
+}
+
+__attribute__((noinline)) static int many_args(int a, int b, int c, int d, int e, int f, int g,
+                                               int h) {
+    int s = a + b + c + d + e + f + g + h; /* live across the initialiser call */
+    int p = __builtin_cpu_supports("avx2") ? 1 : 0;
+    return s * 2 + p;
+}
+
+static int lead(void) { return __builtin_cpu_supports("sse2") ? 1 : 0; }
+
+__attribute__((noinline)) static int recurse(int n) {
+    if (n <= 0) {
+        return __builtin_cpu_supports("avx2") ? 1 : 0;
+    }
+    return recurse(n - 1) + (__builtin_cpu_supports("bmi") ? 0 : 0);
+}
+
+int main(void) {
+    int avx2 = __builtin_cpu_supports("avx2") ? 1 : 0;
+    int sse2 = __builtin_cpu_supports("sse2") ? 1 : 0;
+    int bmi2 = __builtin_cpu_supports("bmi2") ? 1 : 0;
+    int avx512f = __builtin_cpu_supports("avx512f") ? 1 : 0;
+    int ok = 1;
+
+    ok &= loop_probe() == 1000 * avx2;
+    ok &= cond_probe(1, 5) == 1 + (sse2 ? 5 : -5);
+    ok &= cond_probe(0, 5) == 0;
+    ok &= label_probe(9) == (9 + 8 + 7 + 6 + 5 + 4 + 3 + 2 + 1 + 0) * sse2;
+    ok &= two_sites(3, 4) == (avx2 ? 3 : 0) + (bmi2 ? 4 : 0);
+    ok &= first_stmt() == (avx512f ? 7 : 3);
+    ok &= many_args(1, 2, 3, 4, 5, 6, 7, 8) == 36 * 2 + avx2;
+    ok &= lead() == sse2;
+    ok &= recurse(4) == avx2;
+
+    printf("%d %d\n", ok, sse2);
+    return ok ? 0 : 1;
+}
