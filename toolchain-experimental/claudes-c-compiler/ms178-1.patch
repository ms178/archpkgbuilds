+            blk(
+                1,
+                vec![
+                    Instruction::Phi {
+                        dest: Value(4),
+                        ty: IrType::I64,
+                        incoming: vec![
+                            (Operand::Value(Value(3)), BlockId(0)),
+                            (Operand::Value(Value(5)), BlockId(1)),
