+  struct A {
+    int f(int i) {
+      i = this || 1;    // dead code removed when
+      i = this ? 1 : 0; // assume_this_cannot_be_null_in_conditional_operators
+                        // is TRUE
+      return i;
+    }
+  };
+  int main() {
+    A *a = 0;
+    return a->f(1);    // allowed at run-time by GNU/Microsoft compilers
+  }
