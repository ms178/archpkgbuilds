+    fn a_copy_out_of_rsp_is_never_folded() {
+        let out = fold(concat!(
+            "    movq %rsp, %r11\n",
+            "    addq %r11, %rax\n",
+            "    ret"
+        ));
+        assert_eq!(super::count(&out, "movq %rsp, %r11"), 1, "{out}");
+    }
+
+    /// A self-copy of a GPR `%rbp` is dead like any other 64-bit self-move.
+    #[test]
+    fn a_rbp_self_move_is_dead_but_rsp_is_kept() {
+        let out = fold("    movq %rbp, %rbp\n    movq %rsp, %rsp\n    ret");
+        assert_eq!(super::count(&out, "movq %rbp, %rbp"), 0, "{out}");
+        assert_eq!(super::count(&out, "movq %rsp, %rsp"), 1, "{out}");
