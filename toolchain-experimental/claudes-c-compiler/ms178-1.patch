diff --git a/src/backend/i686/codegen/emit.rs b/src/backend/i686/codegen/emit.rs
index 54899cd4..d8acc9d0 100644
--- a/src/backend/i686/codegen/emit.rs
+++ b/src/backend/i686/codegen/emit.rs
