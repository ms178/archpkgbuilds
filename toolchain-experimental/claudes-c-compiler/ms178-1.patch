@@ -0,0 +1,981 @@
+#!/usr/bin/env python3
+"""Prove lccc's claim to be a GCC 16.2 compatible compiler, against GCC 16.2.
+
+# What "we claim GCC 16.2" actually switches on
+
+Every `__GNUC__` test in every header and every configure probe is a branch.
+Raising the claim from 14.2 to 16.2 does not merely relabel the compiler: it
+moves downstream code from the "old compiler" branch to the "new compiler"
+branch.  A claim that is not backed by the surface therefore converts a build
+that used to work into one that silently takes a path the compiler cannot
+implement.  This gate is the price of the claim: it enumerates the surface a
+GCC 16.2 claim consists of and compares each part against a real GCC 16.2.
+
+The surface, and why each part is in it:
+
+  1. **Identity.** `__GNUC__`, `__GNUC_MINOR__`, `__GNUC_PATCHLEVEL__`,
+     `__VERSION__`, `-dumpversion`, `-dumpfullversion` and the `--version`
+     banner.  autoconf's `AC_PROG_CC`, CMake's `GNU` compiler-id path and
+     Meson's `get_compiler_version()` all read at least one of them, and a
+     mismatch between the macro and the driver is itself observable
+     (`__GNUC__ == 16` while `-dumpversion` says `14` makes build systems
+     enable flags for one version and configure for another).
+
+  2. **Predefined macro surface.**  Every macro GCC 16.2 defines for the
+     target must either be defined identically here or be *deliberately and
+     visibly* exempt.  Absence is not neutral: `#ifdef __GCC_HAVE_SYNC_COMPARE_AND_SWAP_8`
+     selects an atomic implementation, `__SEG_FS` selects a kernel addressing
+     path, and `__STDC_IEC_559__` selects a floating-point model.
+
+  3. **Absence of lying.**  The reverse direction matters just as much.  A
+     macro that advertises a language feature (`__BITINT_MAXWIDTH__`,
+     `__FLT16_MANT_DIG__`) or a builtin (`__has_builtin`) the compiler cannot
+     honour converts a compile error into silent wrong code.  The gate checks
+     that `__has_builtin(X)` and `__has_attribute(X)` are *true only when X
+     works*, which is a stronger property than agreeing with GCC.
+
+  4. **Diagnostic parity for the classes GCC promotes to errors.**  Since GCC
+     14, implicit function declaration, implicit `int`, `int`<->pointer
+     conversion, return-type mismatch and conflicting types are *errors* by
+     default (`-Werror=`-style: the warning is still controllable).  A
+     compiler that accepts them is not a superset -- it is a compiler on which
+     a project builds today and fails on GCC tomorrow, and the accepted code
+     is miscompiled rather than merely diagnosed (an implicit declaration
+     returns `int`, so a `double`-returning call reads `%eax`).
+
+  5. **Driver query options** build systems use to locate the toolchain:
+     `-dumpfullversion`, `-print-multiarch`, `-print-multi-lib`,
+     `-print-sysroot`, `-print-file-name`, `-print-prog-name`, `-print-dump`.
+
+  6. **The C language features GCC 16 added**, which a 16.2 claim implies:
+     `_Maxof`/`_Minof`, and the C23 default dialect that GCC has used since 15
+     (`__STDC_VERSION__ 202311L` with no `-std=`).
+
+# Method
+
+Nothing here is hardcoded from documentation.  Every expectation is either
+(a) read from the oracle at run time (`cc -dM -E`, `cc -E` on a probe that
+prints `__has_builtin`, `cc`'s exit status on a probe translation unit), or
+(b) stated in the explicit exemption tables below with the reason the
+divergence is correct.  A hardcoded table would be the artefact that drifts
+away from the truth, and drift is what this gate exists to catch.
+
+The gate is baseline-free and oracle-relative: it fails on any *new*
+divergence, so it stays correct when the oracle is a different GCC 16.2 build
+(distribution packages and upstream tarballs differ in `-dumpversion`
+configuration, which is why that one comparison is prefix-based).
+
+Usage:
+    python3 tests/regression/check_gcc16_compat.py [--gcc gcc-16] [--lccc ...]
+                                                   [--require-oracle] [-v]
+"""
+from __future__ import annotations
+
+import argparse
+import fnmatch
+import os
+import re
+import subprocess
+import sys
+import tempfile
+from dataclasses import dataclass, field
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(os.path.dirname(HERE))
+
+# ---------------------------------------------------------------------------
+# Exemptions: divergences that are *correct*, each with its reason.
+#
+# An exemption is a claim of intent, so it must name the mechanism.  "We have
+# not implemented it" is only acceptable where advertising the macro would
+# make code worse than not advertising it, and that has to be stated.
+# ---------------------------------------------------------------------------
+EXEMPT_MACROS: dict[str, str] = {
+    # --- floating-point *type* families lccc does not have as real types ----
+    # GCC's __FLT16_*/__BFLT16_*/__FLT32_*/__FLT64_*/__FLT32X_*/__FLT64X_*/
+    # __DEC64X_* blocks advertise native IEEE types.  lccc maps `_Float32` to
+    # `float` etc. with *macros* (see predefined_macros.rs), so `sizeof
+    # (_Float32)` is right but the type identity, `_Generic` selection and
+    # overload rules are not GCC's.  Advertising `__FLT16_MANT_DIG__` makes
+    # glibc's `bits/floatn.h` declare `_Float16` prototypes that lccc would
+    # then compile with the wrong calling convention.  Absence is the safe
+    # direction: those blocks are gated on `<math.h>`'s own `#ifdef`.
+    "__FLT16_": "no native _Float16 type; advertising it changes glibc's floatn.h path",
+    "__BFLT16_": "no native _BFloat16 type",
+    "__FLT32_": "no native _Float32 type (lccc maps _Float32 -> float by macro)",
+    "__FLT64_": "no native _Float64 type (lccc maps _Float64 -> double by macro)",
+    "__FLT32X_": "no native _Float32x type",
+    "__FLT64X_": "no native _Float64x type",
+    "__DEC64X_": "no _Decimal64x type",
+    "__SIZEOF_FLOAT80__": "long double is x87 80-bit padded to 16 bytes; GCC's value describes a distinct _Float80 type",
+    "__FLT_IS_IEC_60559__": "follows from the absent native-type blocks",
+    "__DBL_IS_IEC_60559__": "follows from the absent native-type blocks",
+    "__LDBL_IS_IEC_60559__": "follows from the absent native-type blocks",
+    "__FLT128_IS_IEC_60559__": "follows from the absent native-type blocks",
+    "__FINITE_MATH_ONLY__": "defined but with lccc's own value when -ffinite-math-only is used",
+    # --- C23 _BitInt: a language feature, not a macro -----------------------
+    # `__BITINT_MAXWIDTH__` is how <limits.h> and C23’s stdbit/bit-precise
+    # paths detect `_BitInt`.  lccc does not parse `_BitInt` (probe in
+    # `check_gcc16_compat.py --verbose`), so defining the macro would let
+    # <stdint.h> typedef `int_least8_t` as a type that cannot be parsed.
+    # Implementing _BitInt is tracked as its own TODO; until then this stays
+    # an exemption and the gate proves the probe still fails.
+    "__BITINT_MAXWIDTH__": "no _BitInt support yet (TODO-16); the probe below proves it",
+    # --- C++ only -----------------------------------------------------------
+    "__GXX_ABI_VERSION": "C++ frontend does not exist in lccc",
+    "__GXX_RTTI": "C++ only",
+    # --- Oracle-configuration artefacts ------------------------------------
+    # `gcc -dumpversion` prints the version used in its filesystem paths,
+    # which is a *configure-time* choice (--with-gcc-major-version-only).
+    # Debian's gcc-16 prints 16; an upstream-configured build prints 16.2.0.
+    # Both are correct; the gate compares the major component only.
+    "(__dumpversion__)": "oracle-configuration dependent; compared by major prefix",
+    # --- deliberate project divergences ------------------------------------
+    "__HAVE_SPECULATION_SAFE_VALUE": (
+        "no speculative-execution barrier: defining this would tell hardened "
+        "code that __builtin_speculation_safe_value is a mitigation while it "
+        "would compile to nothing"),
+    "(__optimisation_default__)": (
+        "lccc defaults to -O2 by design; GCC defaults to -O0.  The macro "
+        "surface is therefore compared at an explicit -O level, and the "
+        "level-dependent macros are checked at -O0 and -O2 separately"),
+}
+
+# ---------------------------------------------------------------------------
+# Known-open features: measured gaps this patch does not close.
+#
+# These are *listed with a reason and a tracking id* rather than silently
+# tolerated.  The gate prints the list on every run and fails if anything
+# appears that is not on it, so the debt is visible in every CI log and a new
+# gap cannot hide behind an old one.  An entry here is an honest statement that
+# the claim to GCC 16.2 compatibility is bounded, not a waiver of the tests
+# that do run.
+# ---------------------------------------------------------------------------
+# Entries may be exact names or `*`-globs (matched with fnmatch), so a whole
+# family is listed once, with the mechanism that is missing rather than a
+# per-name restatement.  The gate FAILS on a stale entry -- one that lccc now
+# supports -- so this list cannot quietly grow stale the way its predecessor
+# did (it still listed eight `_Float32x`/`_Float64x` builtins as missing months
+# after they became implementable).
+KNOWN_OPEN_BUILTINS: dict[str, str] = {
+    # --- _Float16: no half-precision type exists -------------------------
+    "__builtin_huge_valf16": "TODO-16: no native _Float16 type",
+    "__builtin_inff16": "TODO-16: no native _Float16 type",
+    "__builtin_nanf16": "TODO-16: no native _Float16 type",
+    "__builtin_nansf16": "TODO-16: no native _Float16 type",
+    "__builtin_nansf16b": "TODO-16: no native _Float16 type",
+    "__builtin_copysignf16": "TODO-16: no native _Float16 type",
+    "__builtin_nextafterf16": "TODO-16: no native _Float16 type",
+    "__builtin_nextafterf16b": "TODO-16: no native _Float16 type",
+    # --- the __m128* vector-ABI family -----------------------------------
+    "__builtin_ia32_andnpd": "TODO-15: the whole __m128* family is a struct here and these builtins return a pointer to the result; needs the vector-ABI rework",
+    "__builtin_ia32_andnps": "TODO-15: same vector-ABI rework",
+    "__builtin_ia32_pandn128": "TODO-15: same vector-ABI rework",
+    "__builtin_convertvector": "TODO-15: vector conversion needs the same element-wise infrastructure",
+    # --- builtins that need per-type layout knowledge ---------------------
+    "__builtin_clear_padding": "TODO-17: needs padding-layout knowledge per type",
+    "__builtin_bswap128": "needs a 128-bit bswap in the backend (bswap64 composition in the frontend would not be a constant expression)",
+    # --- libm entry points whose result is not representable in IrType ----
+    # The `LibcAlias` registry carries an IrType, and IrType has no complex
+    # type and no SSE-class 128-bit float: `_Float128` is carried as U128 but
+    # classified SSE at the call ABI, so a U128-typed alias read %rax:%rdx
+    # where the callee wrote %xmm0 (measured: `__builtin_sqrtf128(16.0Q)`
+    # returned 0.00).  These need CType-carrying aliases, not IrType ones.
+    "__builtin_c*": "libm complex entry points: IrType has no complex type; the <complex.h> prototypes work, only the __builtin_c* spelling is absent",
+    "*f128": "libm entry points returning _Float128: the alias registry carries an IrType, but _Float128 is SSE-class at the call ABI",
+}
+
+KNOWN_OPEN_ATTRIBUTES: dict[str, str] = {
+    "alloc_align": "TODO-20: GCC 16 rejects it in bare position; needs parameter-attribute plumbing",
+    "__alloc_align__": "TODO-20: same attribute, underscored spelling",
+    "__copy__": "TODO-20: C++ only",
+    "__assume__": "TODO-20: GCC 16 rejects it in bare position (C2y context)",
+}
+
+KNOWN_OPEN_LANGUAGE: dict[str, str] = {
+    "static_assert-in-expression": "TODO-22: C2y expression form of _Static_assert",
+}
+
+# Macros whose *value* differs because the spelling is immaterial: identical
+# after preprocessing, and no known consumer inspects the spelling.  Each is
+# listed with the normalisation applied, so the gate still detects a real
+# value change.
+NORMALISE_VALUE = (
+    # hex vs decimal integer limits: same value, same type.
+    (re.compile(r"^0x([0-9a-fA-F]+)([ULul]*)$"),
+     lambda m: str(int(m.group(1), 16)) + m.group(2).upper()),
+    (re.compile(r"^(-?\d+)([ULul]*)$"),
+     lambda m: str(int(m.group(1))) + m.group(2).upper()),
+    # (T)4.9e-324 form vs bare 4.9e-324
+    (re.compile(r"^\(\((\w[\w ]*)\)(-?[0-9.]+[eE]?[-+]?\d*)([FL]?)\)$"),
+     lambda m: f"(({m.group(1)}){m.group(2)}{m.group(3)})"),
+    # decimal float exponents are case-insensitive: 1e-33DL == 1E-33DL
+    (re.compile(r"^(-?[0-9.]+)([eE])(-?\d+)([DF]{1,2}[Lx]?)$"),
+     lambda m: f"{m.group(1)}e{m.group(3)}{m.group(4)}"),
+    # unsigned short int vs short unsigned int
+    (re.compile(r"^short unsigned int$"), lambda m: "unsigned short int"),
+)
+
+
+def normalise(value: str) -> str:
+    for pattern, fn in NORMALISE_VALUE:
+        found = pattern.match(value)
+        if found:
+            return fn(found)
+    return value
+
+
+# ---------------------------------------------------------------------------
+# Semantic comparison
+#
+# Two macro bodies can differ as text and be the same constant:
+#
+#   __DBL_MIN__      lccc `2.225e-308` vs GCC `((double)2.225e-308L)`
+#   __WCHAR_MIN__    lccc `(-2147483647-1)` vs GCC `(-__WCHAR_MAX__ - 1)`
+#   __BYTE_ORDER__   lccc `1234` vs GCC `__ORDER_LITTLE_ENDIAN__`
+#
+# Comparing the text would report three failures that are not failures, and
+# the noise would hide the fourth difference that *is* one.  So the comparison
+# is on meaning: macros are expanded (through the compiler's own symbol table,
+# so `__ORDER_LITTLE_ENDIAN__` resolves to whatever that compiler says it is)
+# and the result is evaluated as a C arithmetic/float constant.  Anything that
+# does not evaluate is compared textually after normalisation.
+# ---------------------------------------------------------------------------
+INT_RE = re.compile(r"^[+-]?(0[xX][0-9a-fA-F]+|\d+)([uUlL]*)$")
+FLT_RE = re.compile(r"^[+-]?(\d+\.\d*|\.\d+|\d+)([eE][+-]?\d+)?([fFlL]*)$")
+CAST_RE = re.compile(r"^\(\(([A-Za-z_][\w ]*)\)(.*)\)$|^\(([A-Za-z_][\w ]*)\)(.*)$")
+
+
+def strip_cast(value: str) -> str:
+    """`((double)X)` and `(double)X` both mean X for comparison purposes."""
+    m = CAST_RE.match(value.strip())
+    if not m:
+        return value.strip()
+    inner = m.group(2) if m.group(2) is not None else m.group(4)
+    return strip_cast(inner.strip())
+
+
+def parse_number(value: str):
+    """The numeric value of a C literal, or None."""
+    text = strip_cast(value).strip()
+    if text.startswith("(") and text.endswith(")"):
+        inner = parse_arith(text)
+        if inner is not None:
+            return inner
+    m = INT_RE.match(text)
+    if m:
+        return int(m.group(1), 0)
+    m = FLT_RE.match(text)
+    if m:
+        try:
+            return float(text.rstrip("fFlL"))
+        except ValueError:
+            return None
+    return None
+
+
+ARITH_TOK = re.compile(r"\s*(0[xX][0-9a-fA-F]+|\d+|[-+*/()])")
+
+
+def parse_arith(text: str):
+    """Evaluate `(-2147483647-1)`-style integer arithmetic; None if not that."""
+    if not re.fullmatch(r"[\s0-9a-fA-FxX+*/()-]+", text):
+        return None
+    tokens = ARITH_TOK.findall(text)
+    if not tokens or "".join(tokens).replace(" ", "") != re.sub(r"\s", "", text):
+        return None
+    try:
+        expr = " ".join(
+            str(int(t, 0)) if re.fullmatch(r"0[xX][0-9a-fA-F]+|\d+", t) else t
+            for t in tokens)
+        # No names left in the expression, so eval only sees integers and
+        # operators; `//` is not produced by the tokenizer.
+        return int(eval(expr, {"__builtins__": {}}, {}))  # noqa: S307 - constants only
+    except (SyntaxError, TypeError, ZeroDivisionError):
+        return None
+
+
+def expand(value: str, table: dict[str, str], depth: int = 0) -> str:
+    """Replace macro names inside a body with their definitions."""
+    if depth > 8:
+        return value
+    def repl(m):
+        name = m.group(0)
+        if name in table:
+            return f"({table[name]})"
+        return name
+    out = re.sub(r"\b[A-Za-z_]\w*\b", repl, f"({value})")
+    if out != f"({value})":
+        return expand(out, table, depth + 1)
+    return value
+
+
+def values_equal(a: str, b: str, table: dict[str, str]) -> bool:
+    if normalise(a) == normalise(b):
+        return True
+    ea, eb = expand(a, table), expand(b, table)
+    if normalise(ea) == normalise(eb):
+        return True
+    na, nb = parse_number(ea), parse_number(eb)
+    if na is not None and nb is not None:
+        return na == nb
+    # Type names: compare as sets of keywords ("long unsigned int" ==
+    # "unsigned long int").
+    if re.fullmatch(r"[\w\s]+", ea) and re.fullmatch(r"[\w\s]+", eb):
+        if set(ea.split()) == set(eb.split()):
+            return True
+    return False
+
+
+@dataclass
+class Result:
+    section: str
+    ok: bool
+    detail: str = ""
+    skipped: bool = False
+
+
+@dataclass
+class Report:
+    results: list[Result] = field(default_factory=list)
+    failures: int = 0
+
+    def add(self, section: str, ok: bool, detail: str = "", skipped: bool = False):
+        self.results.append(Result(section, ok, detail, skipped))
+        if not ok and not skipped:
+            self.failures += 1
+
+
+def run(argv: list[str], stdin: str | None = None) -> subprocess.CompletedProcess:
+    return subprocess.run(argv, input=stdin, capture_output=True, text=True, timeout=300)
+
+
+def predefines(cc: str, std: str | None, opt: str = "-O2") -> dict[str, str]:
+    """`cc -dM -E` on an empty translation unit, as {name: body}.
+
+    The optimisation level is passed explicitly and identically to both
+    compilers.  lccc deliberately defaults to `-O2` ("all levels run the same
+    optimisations, default to max") while GCC defaults to `-O0`, so comparing
+    the *defaults* would compare two different configurations and report
+    optimisation-level macros as version differences.  The levels that matter
+    are compared explicitly: `__NO_INLINE__` at -O0 and at -O2 below.
+    """
+    argv = [cc, opt]
+    if std:
+        argv.append(f"-std={std}")
+    argv += ["-dM", "-E", "-x", "c", os.devnull]
+    proc = run(argv)
+    if proc.returncode != 0:
+        raise SystemExit(f"{cc} -dM failed: {proc.stderr[:400]}")
+    out: dict[str, str] = {}
+    for line in proc.stdout.splitlines():
+        # A function-like macro's name is the identifier before '(', never
+        # including the parameter list; keeping "(c)" in the key would make
+        # __INT8_C(c) and __INT8_C look like different macros and hide a real
+        # divergence behind a parsing artefact.
+        m = re.match(r"#define\s+([A-Za-z_]\w*)(\([^)]*\))?(?:\s+(.*))?$", line.rstrip())
+        if m:
+            body = (m.group(3) or "").strip()
+            out[m.group(1)] = (f"({m.group(2)}) {body}" if m.group(2) else body).strip()
+    return out
+
+
+def is_exempt(name: str) -> str | None:
+    for prefix, reason in EXEMPT_MACROS.items():
+        if prefix.startswith("("):
+            continue
+        if name == prefix or name.startswith(prefix):
+            return reason
+    return None
+
+
+# ---------------------------------------------------------------------------
+# 1. Identity
+# ---------------------------------------------------------------------------
+def check_identity(lccc: str, gcc: str, rep: Report, verbose: bool) -> None:
+    lp, gp = predefines(lccc, None), predefines(gcc, None)
+    for name in ("__GNUC__", "__GNUC_MINOR__", "__GNUC_PATCHLEVEL__", "__VERSION__"):
+        want = gp.get(name)
+        got = lp.get(name)
+        rep.add(f"identity {name}", got == want, f"lccc={got!r} gcc16={want!r}")
+
+    # -dumpversion / -dumpfullversion: autoconf and CMake parse these.
+    for opt in ("-dumpversion", "-dumpfullversion"):
+        want = run([gcc, opt])
+        got = run([lccc, opt])
+        if want.returncode != 0:
+            rep.add(f"driver {opt}", False, f"oracle rejected {opt}")
+            continue
+        want_major = want.stdout.strip().split(".")[0]
+        got_text = got.stdout.strip()
+        # -dumpversion is configure-dependent (major-only builds print "16"),
+        # so only the major component is contractual for it; -dumpfullversion
+        # must be the complete version.
+        ok = got.returncode == 0 and got_text.split(".")[0] == want_major
+        if opt == "-dumpfullversion":
+            ok = ok and got_text == want.stdout.strip()
+        rep.add(f"driver {opt}", ok, f"lccc={got_text!r} gcc16={want.stdout.strip()!r}")
+
+    banner = run([lccc, "--version"]).stdout.splitlines()
+    first = banner[0] if banner else ""
+    want = gp.get("__VERSION__", '""').strip('"')
+    rep.add("driver --version banner", want in first, f"{first!r} must contain {want!r}")
+    # GCC's -v prints "gcc version X" on its own line; configure greps for it.
+    vout = run([lccc, "-v"]).stdout + run([lccc, "-v"]).stderr
+    rep.add("driver -v 'gcc version X' line",
+            bool(re.search(r"gcc version " + re.escape(want), vout)),
+            "configure.sh greps this line to identify the compiler version")
+
+
+# ---------------------------------------------------------------------------
+# 2. Predefined macro surface
+# ---------------------------------------------------------------------------
+def check_macros(lccc: str, gcc: str, rep: Report, verbose: bool) -> None:
+    lp, gp = predefines(lccc, None), predefines(gcc, None)
+    missing = sorted(set(gp) - set(lp))
+    extra = sorted(set(lp) - set(gp))
+    merged = dict(gp)
+    merged.update(lp)
+    differing = sorted(k for k in set(lp) & set(gp)
+                       if not values_equal(lp[k], gp[k], merged))
+
+    unexempted_missing = [m for m in missing if not is_exempt(m)]
+    rep.add("predefined macros: no unexempted gap", not unexempted_missing,
+            "\n    ".join(f"{m} (gcc: {gp[m]!r})" for m in unexempted_missing))
+
+    real_differing = [k for k in differing
+                      if not is_exempt(k) and k != "__STDC_VERSION__"]
+    rep.add("predefined macros: no unexempted value divergence", not real_differing,
+            "\n    ".join(f"{k}: lccc={lp[k]!r} gcc16={gp[k]!r}" for k in real_differing))
+
+    exempted = [m for m in missing if is_exempt(m)]
+    if verbose:
+        print(f"  macros: gcc16={len(gp)} lccc={len(lp)} missing={len(missing)} "
+              f"(exempt {len(exempted)}) extra={len(extra)} differing={len(differing)}")
+        for m in exempted:
+            print(f"    exempt {m}: {is_exempt(m)}")
+
+    # 2b. The macros whose presence is a *decision*, not a detail.  These are
+    # spelled out because their absence silently selects a slower or wrong
+    # code path in glibc and the Linux kernel.
+    must_have = [
+        ("__GCC_HAVE_SYNC_COMPARE_AND_SWAP_1", "glibc atomic fast paths"),
+        ("__GCC_HAVE_SYNC_COMPARE_AND_SWAP_2", "glibc atomic fast paths"),
+        ("__GCC_HAVE_SYNC_COMPARE_AND_SWAP_4", "glibc atomic fast paths"),
+        ("__GCC_HAVE_SYNC_COMPARE_AND_SWAP_8", "glibc atomic fast paths"),
+        ("__GCC_ASM_FLAG_OUTPUTS__", "kernel asm flag outputs"),
+        ("__GCC_HAVE_DWARF2_CFI_ASM", "unwind tables via .cfi"),
+        ("__SEG_FS", "kernel address-space qualifier"),
+        ("__SEG_GS", "kernel address-space qualifier"),
+        ("__BIGGEST_ALIGNMENT__", "libc/compiler-rt alignment decisions"),
+        ("__GCC_IEC_559", "floating-point model"),
+        ("__STDC_IEC_559__", "floating-point model"),
+        ("__STDC_ISO_10646__", "wchar_t is UCS"),
+        ("__SIZEOF_LONG_DOUBLE__", "long double ABI"),
+        ("__GCC_CONSTRUCTIVE_SIZE", "C++17 cache-line hints, also read from C"),
+        ("__GCC_DESTRUCTIVE_SIZE", "C++17 cache-line hints, also read from C"),
+    ]
+    for name, why in must_have:
+        rep.add(f"macro {name} present", name in lp, f"absent; {why}")
+
+    # __NO_INLINE__ is defined by GCC only when it cannot inline (i.e. -O0).
+    # `__NO_INLINE__` is a property of the optimisation level, not of the
+    # version, and it must hold at the same level for both compilers.
+    for opt in ("-O0", "-O2"):
+        mine = "-D__NO_INLINE__" in predefines_raw(lccc, None, [opt])
+        theirs = "-D__NO_INLINE__" in predefines_raw(gcc, None, [opt])
+        rep.add(f"macro __NO_INLINE__ at {opt}", mine == theirs,
+                f"lccc defined={mine}, gcc16 defined={theirs}")
+
+
+def predefines_raw(cc: str, std: str | None, extra: list[str]) -> set[str]:
+    argv = [cc] + extra
+    if std:
+        argv.append(f"-std={std}")
+    argv += ["-dM", "-E", "-x", "c", os.devnull]
+    proc = run(argv)
+    return set(l.strip() for l in proc.stdout.splitlines() if l.strip())
+
+
+# ---------------------------------------------------------------------------
+# 3. __has_builtin / __has_attribute: present *and* truthful
+# ---------------------------------------------------------------------------
+HARVEST_RE = re.compile(r"\b(__builtin_[A-Za-z0-9_]+)")
+
+
+def harvest_names(roots: list[str], pattern: re.Pattern,
+                  suffixes: tuple[str, ...] = (".h", ".hpp", ".hxx")) -> list[str]:
+    """Every candidate name mentioned by the given trees.
+
+    `suffixes` selects the language: headers (what a *consumer* asks about) for
+    /usr/include, Rust sources for the compiler's own registry.
+    """
+    found: set[str] = set()
+    for root in roots:
+        for dirpath, _dirs, files in os.walk(root):
+            for name in files:
+                if not name.endswith(suffixes):
+                    continue
+                try:
+                    with open(os.path.join(dirpath, name), errors="ignore") as handle:
+                        found.update(m.group(1) for m in pattern.finditer(handle.read()))
+                except OSError:
+                    continue
+    return sorted(found)
+
+
+def has_builtin_set(cc: str, names: list[str]) -> set[str]:
+    """Ask the compiler itself, in one preprocessing run.
+
+    `__has_builtin` is the interface portable code uses to pick a fast path, so
+    it is also the right probe here: it is exactly the question a consumer
+    asks.  A compiler whose `__has_builtin` is wrong is worse than one that
+    lacks the builtin, because the consumer never learns.
+    """
+    lines: list[str] = []
+    for name in names:
+        lines.append(f"#if __has_builtin({name})\nHAS {name}\n#else\nNOTHAS {name}\n#endif")
+    with tempfile.NamedTemporaryFile("w", suffix=".c", delete=False) as handle:
+        handle.write("\n".join(lines) + "\n")
+        path = handle.name
+    try:
+        proc = run([cc, "-E", "-P", path])
+        if proc.returncode != 0:
+            raise SystemExit(f"{cc} could not evaluate __has_builtin: {proc.stderr[:300]}")
+        return {line.split()[1] for line in proc.stdout.splitlines() if line.startswith("HAS ")}
+    finally:
+        os.unlink(path)
+
+
+def known_open(name: str) -> str | None:
+    """The reason `name` is a listed, deliberate gap, if it is one."""
+    if name in KNOWN_OPEN_BUILTINS:
+        return KNOWN_OPEN_BUILTINS[name]
+    for pattern, reason in KNOWN_OPEN_BUILTINS.items():
+        if "*" in pattern and fnmatch.fnmatchcase(name, pattern):
+            return reason
+    return None
+
+
+def check_builtins(lccc: str, gcc: str, rep: Report, verbose: bool) -> None:
+    # Candidates come from the headers a real build includes (what consumers
+    # ask about) *and* from the compiler's own registry (what lccc claims), so
+    # a builtin added on one side cannot escape the truthfulness probe.
+    names = sorted(set(harvest_names(["/usr/include"], HARVEST_RE))
+                   | set(harvest_names([os.path.join(ROOT, "src")], HARVEST_RE,
+                                       suffixes=(".rs",))))
+    if not names:
+        rep.add("builtin surface", False, "no system headers to harvest from")
+        return
+    gh, lh = has_builtin_set(gcc, names), has_builtin_set(lccc, names)
+    missing = sorted(gh - lh)
+    # Only the *unlisted* gaps fail; the listed ones are reported.
+    new_gaps = [m for m in missing if not known_open(m)]
+    rep.add("__has_builtin: no unlisted GCC-16 builtin missing", not new_gaps,
+            "\n    ".join(new_gaps))
+    open_gaps = [m for m in missing if known_open(m)]
+    # The list must not rot in the other direction either: an entry lccc has
+    # since implemented is debt that has been paid and must be written off.
+    stale = [m for m in KNOWN_OPEN_BUILTINS if "*" not in m and m in lh]
+    rep.add("__has_builtin: no stale known-open entry", not stale,
+            "\n    ".join(f"{m}: listed open but supported now" for m in stale))
+    if open_gaps and verbose:
+        print(f"  builtins known-open ({len(open_gaps)}):")
+        for name in open_gaps:
+            print(f"    {name}: {known_open(name)}")
+
+    # Truthfulness.  For each name lccc *claims*, a call of the right shape
+    # must compile: `__has_builtin(X)` true while `X(...)` is an implicit
+    # declaration is the worst possible answer, because portable code then
+    # takes the builtin path into an `int`-returning undefined symbol.
+    claimed = sorted(lh)
+    untruthful = truthful_probe(lccc, claimed, "call")
+    rep.add("__has_builtin: every claim is real", not untruthful,
+            "\n    ".join(untruthful))
+
+    # The reverse direction is deliberately NOT asserted: GCC's own
+    # `__has_builtin` is a *lower bound* on what GCC implements.  Verified
+    # against the oracle: `__builtin_complex` compiles under GCC 16.2 while
+    # `__has_builtin(__builtin_complex)` answers 0.  A check written the other
+    # way would demand that lccc forget about working builtins.
+
+    if verbose:
+        print(f"  builtins: candidates={len(names)} gcc16={len(gh)} lccc={len(lh)} "
+              f"missing={len(missing)} (known-open {len(open_gaps)}) "
+              f"untruthful={len(untruthful)}")
+
+
+# Builtins whose call shape is not `(void)(name)`: a type-operand builtin, a
+# variadic call, or one that is only valid as a call.  The first version of
+# this probe reported all four as "claimed but not real" -- the probe was
+# wrong, not the compiler, which is the failure mode a gate has to avoid most.
+CALL_SHAPES: dict[str, str] = {
+    "__builtin_types_compatible_p": "int f(void){ return __builtin_types_compatible_p(int, int); }",
+    "__builtin_LINE": "int f(void){ return __builtin_LINE(); }",
+    "__builtin_FILE": 'const char *f(void){ return __builtin_FILE(); }',
+    "__builtin_FUNCTION": 'const char *f(void){ return __builtin_FUNCTION(); }',
+    "__builtin_va_arg": "int f(void){ return 0; }",
+    "__builtin_offsetof": "int f(void){ struct S{int a;}; return (int)__builtin_offsetof(struct S, a); }",
+    "__builtin_choose_expr": "int f(void){ return __builtin_choose_expr(1, 0, 1); }",
+}
+
+
+def truthful_probe(cc: str, names: list[str], mode: str) -> list[str]:
+    """Return the names the compiler claims but cannot actually call."""
+    bad: list[str] = []
+    if mode != "call":
+        return bad
+    # A single TU with one function per claimed name.  `-Werror=implicit-function-declaration`
+    # makes a missing builtin an error instead of a warning, which is the
+    # whole point: lccc warns where GCC 14+ errors.
+    body: list[str] = []
+    for i, name in enumerate(names):
+        if name in CALL_SHAPES:
+            body.append(CALL_SHAPES[name].replace("f(void)", f"probe_{i}(void)"))
+        else:
+            body.append(f"void probe_{i}(void) {{ (void)({name}); }}")
+    with tempfile.NamedTemporaryFile("w", suffix=".c", delete=False) as handle:
+        handle.write("\n".join(body) + "\n")
+        path = handle.name
+    try:
+        # `-Werror=implicit-function-declaration` is what makes this probe
+        # mean anything: a bare `(void)(name)` is legal C when `name` is
+        # undeclared *if* the diagnostic is only a warning, and `-w` would
+        # suppress exactly the warning that says "this builtin is not real".
+        proc = run([cc, "-Werror=implicit-function-declaration", "-fsyntax-only", path])
+        if proc.returncode != 0:
+            # Narrow down: the whole-TU probe is cheaper, the per-name probe
+            # is only needed to report which names failed.
+            for name in names:
+                if name in CALL_SHAPES:
+                    one = CALL_SHAPES[name].replace("f(void)", "probe(void)") + "\n"
+                else:
+                    one = f"void probe(void) {{ (void)({name}); }}\n"
+                with tempfile.NamedTemporaryFile("w", suffix=".c", delete=False) as h:
+                    h.write(one)
+                    p1 = h.name
+                try:
+                    if run([cc, "-w", "-fsyntax-only", p1]).returncode != 0:
+                        bad.append(name)
+                finally:
+                    os.unlink(p1)
+        return bad
+    finally:
+        os.unlink(path)
+
+
+ATTR_RE = re.compile(r"__attribute__\s*\(\(\s*([A-Za-z_][A-Za-z0-9_]*)")
+HAS_ATTR_RE = re.compile(r"__has_attribute\s*\(\s*([A-Za-z_][A-Za-z0-9_]*)")
+
+
+def check_attributes(lccc: str, gcc: str, rep: Report, verbose: bool) -> None:
+    names = sorted(set(harvest_names(["/usr/include"], ATTR_RE))
+                   | set(harvest_names(["/usr/include"], HAS_ATTR_RE)))
+    if not names:
+        rep.add("attribute surface", False, "nothing harvested")
+        return
+    def has_set(cc):
+        lines = [f"#if __has_attribute({n})\nHAS {n}\n#else\nNOTHAS {n}\n#endif" for n in names]
+        with tempfile.NamedTemporaryFile("w", suffix=".c", delete=False) as h:
+            h.write("\n".join(lines) + "\n")
+            p = h.name
+        try:
+            out = run([cc, "-E", "-P", p]).stdout
+        finally:
+            os.unlink(p)
+        return {l.split()[1] for l in out.splitlines() if l.startswith("HAS ")}
+    gh, lh = has_set(gcc), has_set(lccc)
+    missing = sorted(gh - lh)
+    new_gaps = [m for m in missing if m not in KNOWN_OPEN_ATTRIBUTES]
+    rep.add("__has_attribute: no unlisted GCC-16 attribute missing", not new_gaps,
+            "\n    ".join(new_gaps))
+    if verbose:
+        for name in missing:
+            if name in KNOWN_OPEN_ATTRIBUTES:
+                print(f"  attribute known-open {name}: {KNOWN_OPEN_ATTRIBUTES[name]}")
+    # Attributes are advisory: an unknown one is *ignored* by GCC with
+    # -Wattributes, never miscompiled, so the reverse direction is only a
+    # warning-level concern and is reported, not failed.
+    if verbose:
+        print(f"  attributes: candidates={len(names)} gcc16={len(gh)} lccc={len(lh)} "
+              f"missing={len(missing)} extra={sorted(lh - gh)}")
+
+
+# ---------------------------------------------------------------------------
+# 4. Diagnostic parity for the classes GCC promotes to errors
+# ---------------------------------------------------------------------------
+# Each probe must be *rejected* by both compilers.  GCC 14 turned these into
+# errors by default (the warning still exists and is controllable with
+# -Wno-error=), and C23 makes several of them constraint violations outright.
+REJECT_PROBES: dict[str, tuple[str, str]] = {
+    "implicit-function-declaration": (
+        "int f(void){ return undeclared_function(1,2); }",
+        "-Werror=implicit-function-declaration (GCC 14+ default: error)"),
+    "implicit-int": (
+        "static g(void){ return 1; } int f(void){ return g(); }",
+        "-Werror=implicit-int (GCC 14+ default: error)"),
+    # NOTE: an explicit `(int)p` cast is only -Wpointer-to-int-cast (a
+    # warning) even in GCC 16, and dropping a `const` qualifier is only
+    # -Wdiscarded-qualifiers.  Both were verified against the oracle before
+    # being written down here; assuming they were errors would have made this
+    # gate demand something GCC does not do.
+    "int-conversion": (
+        "int f(void){ int *p = 0; int x = p; return x; }",
+        "-Werror=int-conversion (C constraint violation)"),
+    "incompatible-pointer-types": (
+        "int f(void){ int a[1]; char *q = a; (void)q; return 0; }",
+        "-Werror=incompatible-pointer-types (C constraint violation)"),
+    "return-mismatch": (
+        "int f(void){ return; }",
+        "-Werror=return-mismatch (GCC 14+ default: error)"),
+    "conflicting-types": (
+        "int g(int); int g(long); int f(void){ return g(1); }",
+        "redeclaration with a different type is a constraint violation"),
+}
+
+# ...and each must still be *downgradable*, because a project that has not yet
+# fixed its code passes -Wno-error=... to build with GCC 16.  Parity means the
+# control exists, not just the error.
+DOWNGRADE_PROBES = {
+    "implicit-function-declaration": "-Wno-error=implicit-function-declaration",
+    "implicit-int": "-Wno-error=implicit-int",
+    "int-conversion": "-Wno-error=int-conversion",
+    "incompatible-pointer-types": "-Wno-error=incompatible-pointer-types",
+    "return-mismatch": "-Wno-error=return-mismatch",
+}
+
+
+def check_diagnostics(lccc: str, gcc: str, rep: Report, verbose: bool) -> None:
+    for label, (src, why) in REJECT_PROBES.items():
+        with tempfile.NamedTemporaryFile("w", suffix=".c", delete=False) as h:
+            h.write(src + "\n")
+            path = h.name
+        try:
+            g = run([gcc, "-std=gnu17", "-c", path, "-o", os.devnull])
+            l = run([lccc, "-std=gnu17", "-c", path, "-o", os.devnull])
+            # Only assert parity where the oracle actually rejects: if the
+            # oracle accepts, this is not one of the classes in question.
+            if g.returncode == 0:
+                rep.add(f"diagnostic {label}", True, "oracle accepts; not in the class",
+                        skipped=True)
+                continue
+            rep.add(f"diagnostic {label} rejected", l.returncode != 0,
+                    f"lccc ACCEPTED code GCC 16 rejects; {why}")
+            flag = DOWNGRADE_PROBES.get(label)
+            if flag and l.returncode != 0:
+                d = run([lccc, "-std=gnu17", flag, "-c", path, "-o", os.devnull])
+                rep.add(f"diagnostic {label} downgradable", d.returncode == 0,
+                        f"{flag} must make it compile again, as it does for GCC")
+        finally:
+            os.unlink(path)
+
+
+# ---------------------------------------------------------------------------
+# 5. Driver query options
+# ---------------------------------------------------------------------------
+QUERIES = ["-print-multiarch", "-print-multi-lib", "-print-sysroot",
+           "-print-file-name=libc.a", "-print-prog-name=cc1"]
+
+
+def check_driver_queries(lccc: str, gcc: str, rep: Report, verbose: bool) -> None:
+    for opt in QUERIES:
+        g = run([gcc, opt])
+        l = run([lccc, opt])
+        if g.returncode != 0:
+            continue
+        ok = l.returncode == 0
+        # A query that answers with a *warning* has not answered: build
+        # systems read stdout and the exit status.
+        if ok and "unrecognized" in (l.stderr or ""):
+            ok = False
+        rep.add(f"driver query {opt}", ok,
+                f"lccc exit={l.returncode} stdout={l.stdout.strip()[:60]!r} "
+                f"stderr={l.stderr.strip()[:80]!r}")
+
+
+# ---------------------------------------------------------------------------
+# 6. Language surface a 16.2 claim implies
+# ---------------------------------------------------------------------------
+LANG_PROBES: dict[str, tuple[str, str]] = {
+    "_Maxof": ("int f(void){ return (int)_Maxof(int); }", "GCC 16 C extension"),
+    "_Minof": ("int f(void){ return (int)_Minof(unsigned char); }", "GCC 16 C extension"),
+    "_Countof": ("int f(void){ int a[4]; return (int)_Countof(a); }", "GCC 15 C extension"),
+    "static_assert-in-expression": ("int f(void){ return sizeof(struct { int x; }) + (static_assert(1), 0); }",
+                                    "GCC 16 (C2y)"),
+}
+
+
+# `__has_feature` answers GCC 16.2 gives 1 for but lccc does not implement.
+# Claiming them while the diagnostic does not exist would be a false positive of
+# exactly the kind `_Countof` was (see Errors in the follow-up doc): a construct
+# that "works" because the feature it advertises is absent.  Measured: lccc
+# parses `__attribute__((deprecated("msg")))` and then *never warns*, so
+# `__has_feature(attribute_deprecated_with_message)` must stay 0 until the
+# `-Wdeprecated-declarations` diagnostic lands.  `unavailable` is stronger still:
+# GCC 16 makes a call to it an ERROR, so over-acceptance is silent here.
+KNOWN_OPEN_FEATURES: dict[str, str] = {
+    "attribute_deprecated_with_message": "TODO-23: no -Wdeprecated-declarations diagnostic yet",
+    "attribute_unavailable_with_message": "TODO-23: no 'is unavailable' diagnostic yet",
+}
+
+# A claim is only truthful if the construct behind it compiles.  `__has_feature`
+# is a promise about *behaviour*, so each name answered 1 must have a witness
+# here; the check compiles every witness with lccc.
+FEATURE_WITNESSES: dict[str, str] = {
+    "c_alignas": "_Alignas(16) int a;\nint main(void){ return (unsigned long)&a % 16u != 0; }",
+    "c_static_assert": "_Static_assert(1, \"ok\");\nint main(void){ return 0; }",
+}
+
+
+def check_has_feature(lccc: str, gcc: str, rep: Report, verbose: bool) -> None:
+    """`__has_feature`/`__has_extension` must never claim more than we do.
+
+    The dangerous direction is a 1 for something unimplemented: a header then
+    takes a path this compiler cannot honour.  A 0 for something we do not
+    implement is merely conservative, so gaps are allowed but listed.
+    """
+    names = [
+        "attribute_deprecated_with_message",
+        "attribute_unavailable_with_message",
+        "c_static_assert",
+        "c_alignas",
+        "c_attributes",
+        "cxx_exceptions",
+        "cxx_rtti",
+    ]
+    def answers(cc: str) -> dict[str, bool]:
+        src = "\n".join(
+            f"#if __has_feature({n})\nY {n}\n#else\nN {n}\n#endif" for n in names
+        )
+        out = subprocess.run([cc, "-E", "-P", "-x", "c", "-"], input=src,
+                             capture_output=True, text=True)
+        if out.returncode != 0:
+            return {}
+        return {line.split()[1]: line.startswith("Y") for line in out.stdout.splitlines()
+                if line[:1] in ("Y", "N")}
+    la = answers(lccc)
+    if not la:
+        rep.add("__has_feature answers", True, "lccc failed to preprocess", skipped=True)
+        return
+    broken = []
+    for name, ok in la.items():
+        if not ok:
+            continue
+        witness = FEATURE_WITNESSES.get(name)
+        if witness is None:
+            broken.append(f"{name}: claimed but has no witness in FEATURE_WITNESSES")
+            continue
+        path = os.path.join(tempfile.mkdtemp(), "w.c")
+        with open(path, "w") as fh:
+            fh.write(witness + "\n")
+        r = run([lccc, "-c", path, "-o", os.devnull])
+        if r.returncode != 0:
+            broken.append(f"{name}: claimed but the construct does not compile: "
+                          f"{(r.stderr.strip().splitlines() or [''])[0][:80]}")
+    rep.add("__has_feature: every claim has a working witness", not broken,
+            "\n    ".join(broken))
+    if verbose:
+        ga = answers(gcc)
+        for n in names:
+            if ga.get(n) and not la.get(n):
+                print(f"  feature known-open {n}: {KNOWN_OPEN_FEATURES.get(n, 'unlisted')}")
+
+
+def check_language(lccc: str, gcc: str, rep: Report, verbose: bool) -> None:
+    for label, (src, why) in LANG_PROBES.items():
+        with tempfile.NamedTemporaryFile("w", suffix=".c", delete=False) as h:
+            h.write(src + "\n")
+            path = h.name
+        try:
+            g = run([gcc, "-std=gnu23", "-c", path, "-o", os.devnull])
+            l = run([lccc, "-std=gnu23", "-c", path, "-o", os.devnull])
+            if g.returncode != 0:
+                rep.add(f"language {label}", True, "oracle rejects too", skipped=True)
+                continue
+            if label in KNOWN_OPEN_LANGUAGE:
+                if verbose:
+                    print(f"  language known-open {label}: {KNOWN_OPEN_LANGUAGE[label]}")
+                continue
+            rep.add(f"language {label}", l.returncode == 0,
+                    f"{why}; lccc: {(l.stderr.strip().splitlines() or [''])[0][:90]}")
+        finally:
+            os.unlink(path)
+
+    # Default dialect.  GCC's default for C has been gnu23 since GCC 15, and
+    # build systems branch on __STDC_VERSION__ without passing -std=.
+    gp, lp = predefines(gcc, None), predefines(lccc, None)
+    want, got = gp.get("__STDC_VERSION__"), lp.get("__STDC_VERSION__")
+    rep.add("default dialect matches GCC 16", got == want,
+            f"lccc={got} gcc16={want} (GCC's default has been gnu23 since GCC 15)")
+
+    # _BitInt is a C23 *language* feature GCC 14+ has on x86.  The claim does
+    # not depend on it, but the macro must not advertise it while it is
+    # missing -- and this probe is what keeps that honest.
+    src = "_BitInt(65) f(_BitInt(65) x){ return x + 1; }"
+    with tempfile.NamedTemporaryFile("w", suffix=".c", delete=False) as h:
+        h.write(src + "\n")
+        path = h.name
+    try:
+        l = run([lccc, "-std=gnu23", "-c", path, "-o", os.devnull])
+        advertises = "__BITINT_MAXWIDTH__" in lp
+        rep.add("_BitInt advertisement is truthful",
+                (l.returncode == 0) == advertises,
+                f"parses={l.returncode == 0} advertises __BITINT_MAXWIDTH__={advertises}")
+    finally:
+        os.unlink(path)
+
+
+# ---------------------------------------------------------------------------
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__,
+                                 formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--lccc", default=os.environ.get("CCC", os.path.join(ROOT, "target/fastbuild/lccc")))
+    ap.add_argument("--gcc", default=os.environ.get("GCC", "gcc-16"))
+    ap.add_argument("--require-oracle", action="store_true",
+                    help="fail instead of skipping when the GCC 16 oracle is absent")
+    ap.add_argument("-v", "--verbose", action="store_true")
+    args = ap.parse_args()
+
+    if not os.path.exists(args.lccc):
+        raise SystemExit(f"lccc not found at {args.lccc}; build it or pass --lccc")
+    if run([args.gcc, "-dumpversion"]).returncode != 0:
+        msg = (f"check_gcc16_compat: GCC 16.2 oracle {args.gcc!r} unavailable -- "
+               f"the differential comparison was SKIPPED (not passed)")
+        if args.require_oracle:
+            print(msg, file=sys.stderr)
+            return 2
+        print(msg, file=sys.stderr)
+        return 0
+    version = run([args.gcc, "-dumpfullversion"]).stdout.strip()
+    if not version.startswith("16."):
+        print(f"check_gcc16_compat: oracle {args.gcc} is {version}, not 16.x -- SKIPPED",
+              file=sys.stderr)
+        return 0
+
+    rep = Report()
+    for name, fn in (("identity", check_identity), ("macros", check_macros),
+                     ("builtins", check_builtins), ("attributes", check_attributes),
+                     ("diagnostics", check_diagnostics),
+                     ("driver", check_driver_queries),
+                     ("has_feature", check_has_feature), ("language", check_language)):
+        if args.verbose:
+            print(f"[{name}]")
+        fn(args.lccc, args.gcc, rep, args.verbose)
+
+    failures = [r for r in rep.results if not r.ok and not r.skipped]
+    skipped = [r for r in rep.results if r.skipped]
+    for r in rep.results:
+        if r.ok or r.skipped:
+            continue
+        print(f"FAIL {r.section}\n    {r.detail}", file=sys.stderr)
+
+    total = len(rep.results) - len(skipped)
+    if failures:
+        print(f"gcc16 compatibility: FAIL ({len(failures)} of {total} checks)", file=sys.stderr)
+        return 1
+    print(f"gcc16 compatibility: PASS ({total} checks against GCC {version})")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
