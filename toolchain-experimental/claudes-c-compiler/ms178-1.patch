+                if r.returncode != 0:
+                    return Result(name, "FAIL", f"{mode}/{tag} link: {r.stderr.decode()[:300]}")
+                run = sh([os.path.join(td, exe)], cwd=td)
+                if run.returncode != 0 or run.stdout.decode() != want:
+                    return Result(name, "FAIL",
