+pub enum GotRelax {
+    /// `mov foo@GOTPCREL(%rip), %reg` -> `lea foo(%rip), %reg`.
+    Lea,
+    /// `call *foo@GOTPCREL(%rip)` -> `addr32 call foo` (same 6 bytes).
+    Call,
+    /// `jmp *foo@GOTPCREL(%rip)` -> `jmp foo; nop`.
