+fn hoistable(info: &LineInfo, t: &str) -> bool {
+    !info.pinned
+        && !info.is_barrier()
+        && !matches!(info.kind, LineKind::Empty | LineKind::Nop)
+        && super::flag_peepholes::flags_effect(t) == super::flag_peepholes::FlagsEffect::Neutral
