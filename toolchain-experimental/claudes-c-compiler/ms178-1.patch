+    // ── W10. PARAMETRIC BREADTH: every encoder rejects SP/WSP ─────────────
+    // Surfaces ALL four affected functions in one shrinkable failure.
+    #[test]
+    fn all_encoders_reject_sp_wsp(n in 0u32..=30, set_flags in any::<bool>()) {
