diff --git a/tests/linker/check_riscv_relocation_contract.py b/tests/linker/check_riscv_relocation_contract.py
new file mode 100644
index 0000000..5b7e28d
--- /dev/null
+++ b/tests/linker/check_riscv_relocation_contract.py
@@ -0,0 +1,198 @@
+#!/usr/bin/env python3
+"""A14-17: reject lost/invalid relocations without rejecting valid RV64 ELF.
+
+Fixtures are deterministic ELF64 RELA objects (no assembler/toolchain dependency).
+--oracle additionally checks acceptance against a real RISC-V-capable ELF linker.
+Every invocation has a private temporary directory and a bounded timeout; a
+panic, signal, missing tool or malformed output is never a valid rejection.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+import struct
+import subprocess
+import tempfile
+
+
+def fixture(kind=2, offset=0, symidx=2, addend=0, binding=0, visibility=0,
+            defined=True):
+    """NULL, .text, .data, .data.more, .rela.data, .symtab, .strtab, .shstrtab.
+
+    .data.more deliberately follows .data after section merging, so checking
+    the merged buffer alone cannot catch a relocation spilling across inputs.
+    """
+    names = ["", ".text", ".data", ".data.more", ".rela.data", ".symtab",
+             ".strtab", ".shstrtab"]
+    shstr = b"\0"
+    name_offsets = [0]
+    for name in names[1:]:
+        name_offsets.append(len(shstr))
+        shstr += name.encode() + b"\0"
+    strings = b"\0_start\0target\0"
+    # exit(0), independent of the data-relocation tests.
+    text = struct.pack("<III", 0x00000513, 0x05D00893, 0x00000073)
+    symbols = bytes(24)
+    symbols += struct.pack("<IBBHQQ", 8, binding << 4, visibility,
+                           1 if defined else 0, 0, 0)
+    symbols += struct.pack("<IBBHQQ", 1, 0x12, 0, 1, 0, len(text))
+    # Local symbols precede globals. Relocations normally target symbol 1;
+    # symidx=2 denotes the abstract target in callers, not an ELF index.
+    target_idx = 1
+    if binding:
+        symbols = bytes(24) + symbols[48:72] + symbols[24:48]
+        target_idx = 2
+    actual_idx = target_idx if symidx == 2 else symidx
+    rela = struct.pack("<QQq", offset, (actual_idx << 32) | kind, addend)
+    chunks = [b"", text, bytes(16), b"\xa5" * 16, rela, symbols, strings, shstr]
+    meta = [(0, 0, 0, 0, 0, 0), (1, 6, 0, 0, 4, 0), (1, 3, 0, 0, 8, 0),
+            (1, 3, 0, 0, 8, 0), (4, 0, 5, 2, 8, 24),
+            (2, 0, 6, 1 if binding else 2, 8, 24), (3, 0, 0, 0, 1, 0),
+            (3, 0, 0, 0, 1, 0)]
+    data = bytearray(64)
+    headers = []
+    for i, (chunk, (ty, flags, link, info, align, entsize)) in enumerate(zip(chunks, meta)):
+        if i == 0:
+            headers.append(bytes(64))
+            continue
+        data.extend(bytes((-len(data)) % align))
+        start = len(data)
+        data.extend(chunk)
+        headers.append(struct.pack("<IIQQQQIIQQ", name_offsets[i], ty, flags,
+                                   0, start, len(chunk), link, info, align, entsize))
+    data.extend(bytes((-len(data)) % 8))
+    shoff = len(data)
+    data.extend(b"".join(headers))
+    ident = b"\x7fELF\x02\x01\x01" + bytes(9)
+    data[:64] = struct.pack("<16sHHIQQQIHHHHHH", ident, 1, 243, 1, 0, 0,
+                            shoff, 0, 64, 0, 0, 64, len(headers), 7)
+    return bytes(data)
+
+
+def sections(path):
+    data = path.read_bytes()
+    hdr = struct.unpack_from("<16sHHIQQQIHHHHHH", data)
+    assert hdr[0][:7] == b"\x7fELF\x02\x01\x01" and hdr[2] == 243, "not RV64 ELF"
+    assert hdr[11] == 64, "unexpected section header size"
+    headers = [struct.unpack_from("<IIQQQQIIQQ", data, hdr[6] + i * 64)
+               for i in range(hdr[12])]
+    names = headers[hdr[13]]
+    strings = data[names[4]:names[4] + names[5]]
+    result = {}
+    for sh in headers:
+        end = strings.find(b"\0", sh[0])
+        assert end >= sh[0], "unterminated section name"
+        name = strings[sh[0]:end].decode()
+        result[name] = (sh, data[sh[4]:sh[4] + sh[5]])
+    return result
+
+
+def run(command):
+    p = subprocess.run(command, capture_output=True, text=True, timeout=20)
+    diagnostic = p.stdout + p.stderr
+    if p.returncode < 0 or any(s in diagnostic.lower() for s in
+                              ("panicked at", "internal compiler error", "segmentation fault")):
+        raise AssertionError(f"crash is not a diagnostic: {command}: {diagnostic}")
+    return p.returncode, diagnostic
+
+
+def cases():
+    # Unknown numbers span unsigned r_type, for local, preemptible, hidden,
+    # protected, weak and undefined symbols, not just the original 255 case.
+    for kind in (255, 0x7fffffff, 0xffffffff):
+        for binding, visibility, defined in ((0, 0, True), (1, 0, True),
+                (1, 2, True), (1, 3, True), (2, 0, True), (1, 0, False)):
+            yield (f"unknown-{kind}-{binding}-{visibility}-{defined}",
+                   dict(kind=kind, binding=binding, visibility=visibility, defined=defined),
+                   False, "unsupported RISC-V relocation")
+    for index in (3, 0xffffffff):
+        for kind in (2, 19, 20, 21, 22):
+            yield f"bad-symbol-{kind}-{index}", dict(kind=kind, symidx=index), False, "symbol index"
+    # Fixed-width stores, arithmetic, compressed and paired call instructions.
+    for kind, width in ((2, 8), (1, 4), (33, 1), (34, 2), (35, 4), (36, 8),
+                        (37, 1), (38, 2), (39, 4), (40, 8), (44, 2), (45, 2),
+                        (53, 1), (54, 1), (55, 2), (56, 4), (19, 8), (22, 4)):
+        for offset in sorted({17 - width, 16, (1 << 64) - 1}):
+            yield f"bad-extent-{kind}-{offset}", dict(kind=kind, offset=offset), False, "exceeds input section"
+    for addend in (-7, 0, 11):
+        for offset in (0, 8):
+            yield f"valid-64-{offset}-{addend}", dict(offset=offset, addend=addend), True, ""
+    # NONE and RELAX must not be confused with unknown relocation kinds.
+    for kind in (0, 51):
+        yield f"valid-marker-{kind}", dict(kind=kind, symidx=0), True, ""
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--lccc", required=True, help="lccc-riscv driver")
+    ap.add_argument("--oracle", help="optional real linker, e.g. ld.lld")
+    ap.add_argument("--json", type=Path)
+    args = ap.parse_args()
+    records = []
+    with tempfile.TemporaryDirectory(prefix="lccc-rv-reloc-") as tmp:
+        root = Path(tmp)
+        for name, options, accept, expected in cases():
+            src = root / (name + ".o")
+            src.write_bytes(fixture(**options))
+            # Check the fixture's own structure; oracle runs also validate it.
+            assert sections(src)[".rela.data"][0][5] == 24
+            for shared in (False, True):
+                for tool in (["lccc", "oracle"] if args.oracle else ["lccc"]):
+                    out = root / (name + f"-{shared}-{tool}.elf")
+                    command = ([args.lccc, "-nostdlib", "-shared" if shared else "-static"]
+                               if tool == "lccc" else
+                               [args.oracle, "-m", "elf64lriscv", "--no-relax"] +
+                               (["-shared"] if shared else []))
+                    command += [str(src), "-o", str(out)]
+                    try:
+                        rc, diagnostic = run(command)
+                        assert (rc == 0) == accept, f"expected accept={accept}, exit={rc}: {diagnostic}"
+                        if not accept and tool == "lccc":
+                            # ET_EXEC reports an undefined symbol before dispatch;
+                            # the ET_DYN twin must reach unknown-type rejection.
+                            needle = ("undefined symbols" if not shared and
+                                      not options.get("defined", True) else expected)
+                            accepted = [needle]
+                            if needle == "exceeds input section":
+                                # The shared ELF reader rejects an out-of-range
+                                # starting byte before target-width validation.
+                                accepted.append("outside the section it patches")
+                            assert any(n in diagnostic for n in accepted), f"wrong diagnostic: {diagnostic}"
+                            assert not out.exists(), "published output despite rejection"
+                        if accept:
+                            sec = sections(out)
+                            if options.get("kind", 2) == 2:
+                                offset = options.get("offset", 0)
+                                value = sec[".text"][0][3] + options.get("addend", 0)
+                                if shared:
+                                    relas = sec[".rela.dyn"][1]
+                                    entries = [struct.unpack_from("<QQq", relas, i)
+                                               for i in range(0, len(relas), 24)]
+                                    expected_rela = (sec[".data"][0][3] + offset, 3, value)
+                                    assert expected_rela in entries, (expected_rela, entries)
+                                else:
+                                    assert struct.unpack_from("<Q", sec[".data"][1], offset)[0] == value
+                            # No relocation may touch the adjacent contribution.
+                            # lld may retain its name instead of merging .data.*.
+                            adjacent = sec.get(".data.more", sec[".data"])[1][-16:]
+                            assert adjacent == b"\xa5" * 16, "adjacent section overwritten"
+                        records.append(dict(case=name, shared=shared, tool=tool, passed=True))
+                    except (AssertionError, OSError, subprocess.TimeoutExpired, ValueError,
+                            struct.error, KeyError) as error:
+                        records.append(dict(case=name, shared=shared, tool=tool, passed=False,
+                                            error=str(error)))
+    summary = dict(passed=sum(r["passed"] for r in records),
+                   failed=sum(not r["passed"] for r in records), skipped=0, records=records)
+    if args.json:
+        args.json.parent.mkdir(parents=True, exist_ok=True)
+        args.json.write_text(json.dumps(summary, indent=2) + "\n")
+    for record in records:
+        if not record["passed"]:
+            print("FAIL", record)
+    print(f"RISC-V relocation contract: {summary['passed']} PASS / {summary['failed']} FAIL / 0 SKIP")
+    return int(bool(summary["failed"]))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tests/regression/check_pgo_io.py b/tests/regression/check_pgo_io.py
new file mode 100644
index 0000000..6b7342f
--- /dev/null
+++ b/tests/regression/check_pgo_io.py
@@ -0,0 +1,144 @@
+#!/usr/bin/env python3
+"""PGO buffered-write lock lifetime, deterministic two-writer and error tests."""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import time
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def run(cmd, env=None, expected=0):
+    p = subprocess.run(cmd, env=env, capture_output=True, text=True, timeout=60)
+    assert p.returncode == expected, (cmd, p.returncode, p.stdout, p.stderr)
+    assert "panicked at" not in p.stderr, p.stderr
+    return p
+
+
+def source(count):
+    functions = [f"__attribute__((noinline)) int f{i}(int x) {{ return x > {i} ? x + {i} : x - {i}; }}"
+                 for i in range(count)]
+    calls = "".join(f"s += f{i}(argc);" for i in range(count))
+    return "#include <stdio.h>\n" + "\n".join(functions) + f"\nint main(int argc, char **argv) {{ int s=0; (void)argv; {calls} printf(\"%d\\n\",s); return 23; }}\n"
+
+
+def counters(text):
+    """Exact counter sum keyed by record identity, function and edge/site."""
+    result = {}
+    header = function = None
+    for line in text.splitlines():
+        fields = line.split()
+        if fields[0] == "lccc-pgo-v1":
+            assert len(fields) == 5, line
+            header = tuple(fields[1:])
+        elif fields[0] == "func":
+            assert len(fields) == 2 and header, line
+            function = fields[1]
+        elif fields[0] in ("e", "f"):
+            assert header and function, line
+            key = (header, function, tuple(fields[:-1]))
+            result[key] = result.get(key, 0) + int(fields[-1])
+        else:
+            raise AssertionError(f"unexpected profile line: {line}")
+    assert result
+    return result
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--lccc", required=True)
+    ap.add_argument("--cc", default="gcc", help="host compiler for LD_PRELOAD oracle only")
+    ap.add_argument("--json", type=Path)
+    args = ap.parse_args()
+    checks = []
+    with tempfile.TemporaryDirectory(prefix="lccc-pgo-io-") as tmp:
+        root = Path(tmp)
+        so = root / "interpose.so"
+        run([args.cc, "-shared", "-fPIC", "-O1", "-Wall", "-Wextra", "-Werror",
+             str(ROOT / "tests/regression/fixtures/pgo_io_interpose.c"), "-ldl", "-o", str(so)])
+        base_env = {k: v for k, v in os.environ.items() if not k.startswith(("LCCC_PGO_", "PGO_IO_"))
+                    and k not in ("LCCC_PROFILE_FILE", "LLVM_PROFILE_FILE", "LD_PRELOAD")}
+        for opt in ("-O0", "-O2", "-O3"):
+            for count in (1, 96):
+                src = root / f"unit-{opt}-{count}.c"
+                src.write_text(source(count))
+                exe = src.with_suffix(".exe")
+                golden = src.with_suffix(".profraw")
+                run([args.lccc, opt, "-fprofile-generate=" + str(golden), str(src), "-o", str(exe)])
+                expected = run([str(exe)], env=base_env, expected=23)
+                assert not expected.stderr, expected.stderr
+                raw = golden.read_bytes()
+                if count == 96:
+                    assert len(raw) > 8192, len(raw)
+                baseline_counts = counters(raw.decode())
+                checks.append(f"{opt}/{count}: single-process profile")
+                # Faults must diagnose, preserve application status/output, and
+                # never write profile data after failure to acquire the lock.
+                for fault, diagnostic in (("fopen", "cannot open profile"),
+                        ("fileno", "cannot lock profile"), ("flock", "cannot lock profile"),
+                        ("eintr", "cannot lock profile"), ("ferror", "profile write failed"),
+                        ("fclose", "profile close/flush failed")):
+                    profile = root / f"fault-{opt}-{count}-{fault}.profraw"
+                    env = dict(base_env, LD_PRELOAD=str(so), LCCC_PROFILE_FILE=str(profile), PGO_IO_FAULT=fault)
+                    p = run([str(exe)], env=env, expected=23)
+                    assert p.stdout == expected.stdout and diagnostic in p.stderr, (fault, p.stdout, p.stderr)
+                    if fault in ("fopen", "fileno", "flock", "eintr"):
+                        assert not profile.exists() or profile.stat().st_size == 0, fault
+                    checks.append(f"{opt}/{count}: injected {fault}")
+                p = run([str(exe)], env=dict(base_env, LCCC_PROFILE_FILE="/dev/full"), expected=23)
+                assert p.stdout == expected.stdout and "lccc: PGO: profile" in p.stderr, p.stderr
+                checks.append(f"{opt}/{count}: ENOSPC")
+                # Force the old unlock-before-flush bug, without relying on a
+                # lucky scheduling race. B cannot start until A has the lock.
+                shared = root / f"shared-{opt}-{count}.profraw"
+                sync = root / f"sync-{opt}-{count}"
+                sync.mkdir()
+                env = dict(base_env, LD_PRELOAD=str(so), LCCC_PROFILE_FILE=str(shared), PGO_IO_SYNC=str(sync))
+                processes = []
+                try:
+                    a = subprocess.Popen([str(exe)], env=dict(env, PGO_IO_ROLE="A"), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+                    processes.append(a)
+                    deadline = time.monotonic() + 15
+                    while not (sync / "A-held").exists():
+                        assert a.poll() is None, "A exited before acquiring profile lock"
+                        assert time.monotonic() < deadline, "A lock acquisition timed out"
+                        time.sleep(.001)
+                    b = subprocess.Popen([str(exe)], env=dict(env, PGO_IO_ROLE="B"), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+                    processes.append(b)
+                    for p in processes:
+                        stdout, stderr = p.communicate(timeout=20)
+                        assert p.returncode == 23 and stdout.decode() == expected.stdout and not stderr, (p.returncode, stdout, stderr)
+                finally:
+                    for p in processes:
+                        if p.poll() is None:
+                            p.kill()
+                        p.wait()
+                assert shared.read_bytes() == raw * 2, "interleaved profile records"
+                assert not (sync / "unlocked-close").exists(), "final flush outside lock"
+                assert counters(shared.read_text()) == {key: value * 2 for key, value in baseline_counts.items()}
+                checks.append(f"{opt}/{count}: deterministic two writers, exact counts")
+                # Exercise the production reader and optimization pipeline,
+                # not just the independent raw-byte/counter parser above.
+                ingested = root / "ingested.txt"
+                use = root / "use.exe"
+                p = run([args.lccc, opt, "-fprofile-use=" + str(shared), str(src), "-o", str(use)],
+                        env=dict(base_env, LCCC_PGO_DUMP_TEXT=str(ingested)))
+                assert f"loaded {count + 1} functions" in p.stderr, p.stderr
+                assert counters(ingested.read_text()) == {key: value * 2 for key, value in baseline_counts.items()}
+                assert run([str(use)], env=base_env, expected=23).stdout == expected.stdout
+                checks.append(f"{opt}/{count}: production ingestion and use")
+    summary = dict(passed=len(checks), failed=0, skipped=0, checks=checks)
+    if args.json:
+        args.json.parent.mkdir(parents=True, exist_ok=True)
+        args.json.write_text(json.dumps(summary, indent=2) + "\n")
+    print(f"PGO I/O: {len(checks)} PASS / 0 FAIL / 0 SKIP")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
