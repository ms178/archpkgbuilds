diff --git a/tests/regression/compound_unsigned_widening.c b/tests/regression/compound_unsigned_widening.c
new file mode 100644
index 0000000000000000000000000000000000000000..bf117f7f6560fdd2854ad80d4476e7aee8cd191d
--- /dev/null
+++ b/tests/regression/compound_unsigned_widening.c
@@ -0,0 +1,91 @@
+/* Compound assignment performs the usual arithmetic conversions BEFORE
+   widening to an IR carrier (C11 6.3.1.3, 6.3.1.8, 6.5.16.2).
+   Inspired by sametyilmaztemel/claudes-c-compiler a50a017f26.
+   All quotient/remainder results below fit their signed destination: this
+   reproducer does not depend on an out-of-range unsigned-to-signed result. */
+#define OPS(name, lhs, rhs) \
+    __attribute__((noinline)) static lhs name##_div(lhs x, rhs y) { \
+        x /= y; return x; \
+    } \
+    __attribute__((noinline)) static lhs name##_mod(lhs x, rhs y) { \
+        x %= y; return x; \
+    }
+OPS(c32, signed char, unsigned int)
+OPS(s32, short, unsigned int)
+OPS(i32, int, unsigned int)
+OPS(c64, signed char, unsigned long long)
+OPS(s64, short, unsigned long long)
+OPS(i64, int, unsigned long long)
+OPS(l64, long long, unsigned long long)
+OPS(u64, unsigned int, unsigned long long)
+OPS(signed64, int, long long)
+#ifdef __SIZEOF_INT128__
+OPS(i128, int, unsigned __int128)
+OPS(l128, long long, unsigned __int128)
+OPS(u128, unsigned int, unsigned __int128)
+#endif
+#undef OPS
+
+static volatile short cell;
+static int calls;
+__attribute__((noinline)) static volatile short *cell_address(void) {
+    ++calls;
+    return &cell;
+}
+
+#define CHECK(expr) do { if (!(expr)) return __LINE__; } while (0)
+int main(void) {
+    CHECK(c32_div(-8, 1U << 25) == 127);
+    CHECK(s32_div(-8, 1U << 17) == 32767);
+    CHECK(i32_div(-8, 1U << 31) == 1);
+    CHECK(c64_div(-8, 1ULL << 57) == 127);
+    CHECK(s64_div(-8, 1ULL << 49) == 32767);
+    CHECK(i64_div(-8, 1ULL << 63) == 1);
+    CHECK(l64_div(-8, 1ULL << 63) == 1);
+
+    /* Dynamic operands and boundary values; ordinary casts are an independent
+       lowering path. Remainders are at most 96 and fit every signed LHS. */
+    for (int x = -128; x <= 127; ++x) {
+        unsigned int u32 = (unsigned int)x;
+        unsigned long long u64 = (unsigned long long)x;
+        CHECK(c32_mod((signed char)x, 97U) == u32 % 97U);
+        CHECK(s32_mod((short)x, 97U) == u32 % 97U);
+        CHECK(i32_mod(x, 97U) == u32 % 97U);
+        CHECK(c64_mod((signed char)x, 97ULL) == u64 % 97ULL);
+        CHECK(s64_mod((short)x, 97ULL) == u64 % 97ULL);
+        CHECK(i64_mod(x, 97ULL) == u64 % 97ULL);
+        CHECK(l64_mod(x, 97ULL) == u64 % 97ULL);
+#ifdef __SIZEOF_INT128__
+        unsigned __int128 u128_value = (unsigned __int128)x;
+        CHECK(i128_mod(x, 97) == u128_value % 97);
+        CHECK(l128_mod(x, 97) == u128_value % 97);
+#endif
+    }
+    CHECK(s32_div(-32768, 1U << 17) == 32767);
+    CHECK(i64_div(-2147483647 - 1, 1ULL << 63) == 1);
+    CHECK(i64_div(2147483647, 1ULL << 63) == 0);
+    CHECK(u64_div(0xffffffffU, 1ULL << 31) == 1);
+    CHECK(u64_mod(0xffffffffU, 1ULL << 32) == 0xffffffffU);
+    CHECK(signed64_div(-8, 4) == -2);
+    CHECK(signed64_mod(-8, 3) == -2);
+#ifdef __SIZEOF_INT128__
+    CHECK(i128_div(-8, (unsigned __int128)1 << 127) == 1);
+    CHECK(l128_div(-8, (unsigned __int128)1 << 127) == 1);
+    CHECK(u128_div(0xffffffffU, (unsigned __int128)1 << 64) == 0);
+    CHECK(u128_mod(0xffffffffU, (unsigned __int128)1 << 64) == 0xffffffffU);
+#endif
+    cell = -8;
+    calls = 0;
+    *cell_address() /= 1U << 17;
+    CHECK(calls == 1 && cell == 32767);
+
+    /* The RHS type must not turn a signed shift into a logical shift. */
+    int signed_shift = -8;
+    unsigned unsigned_shift = 0xfffffff0U;
+    unsigned char byte_shift = 248;
+    signed_shift >>= 1U;
+    unsigned_shift >>= 1ULL;
+    byte_shift >>= 1U;
+    CHECK(signed_shift == -4 && unsigned_shift == 0x7ffffff8U && byte_shift == 124);
+    return 0;
+}
diff --git a/tests/regression/declarator_inferred_scope.c b/tests/regression/declarator_inferred_scope.c
new file mode 100644
index 0000000000000000000000000000000000000000..3da38effc4beca804da2e752b3b90e218d4ac397
--- /dev/null
+++ b/tests/regression/declarator_inferred_scope.c
@@ -0,0 +1,10 @@
+/* GNU __auto_type's name enters scope AFTER its initializer (GCC manual,
+   "Referring to a Type with typeof"). This is a negative control for the
+   ordinary C declarator-scope fix. GCC 16.2 accepts it; Clang 23.1.5 rejects
+   the typedef-shaped initializer. Do not silently relabel that disagreement
+   as a three-compiler pass; run this fixture against GCC and LCCC. */
+typedef long long Inferred;
+int main(void) {
+    __auto_type Inferred = (Inferred)7;
+    return !(Inferred == 7 && sizeof(Inferred) == sizeof(long long));
+}
diff --git a/tests/regression/declarator_point_of_scope.c b/tests/regression/declarator_point_of_scope.c
new file mode 100644
index 0000000000000000000000000000000000000000..de950cdb1883c69a1e0e00c9d6e66f5028120bae
--- /dev/null
+++ b/tests/regression/declarator_point_of_scope.c
@@ -0,0 +1,91 @@
+/* C11 6.2.1p7: a name enters scope after its declarator, before its
+   initializer and later comma siblings. The GNU inferred-type exception has
+   its own GCC-only fixture, declarator_inferred_scope.c. No uninitialized value is read.
+   Inspired by sametyilmaztemel/claudes-c-compiler c6e8d717b8. */
+typedef double FileScalar, (*FileFn)(FileScalar);
+typedef int FileInt, FileArray[(FileInt)2.5 + 1];
+typedef char T;
+typedef char Aligned[16];
+enum { Enum = 99 };
+
+__attribute__((noinline)) static double plus_half(double x) { return x + 0.5; }
+
+static int own_initializer(void) {
+    int T = sizeof(T);
+    return T == sizeof(int);
+}
+static int later_initializer(void) {
+    int before = sizeof(T), T = 5, after = sizeof(T), difference = (T) - 1;
+    return before == 1 && T == 5 && after == sizeof(int) && difference == 4;
+}
+static int static_initializer(void) {
+    static int T = sizeof(T);
+    return T == sizeof(int);
+}
+static int array_declarator(void) {
+    typedef long long T;
+    {
+        char T[sizeof(T)];
+        return sizeof(T) == sizeof(long long);
+    }
+}
+static int restored_scope(void) {
+    { long long T = sizeof(T); if (T != sizeof(long long)) return 0; }
+    if (sizeof(T) != 1) return 0;
+    { typedef volatile long long T; T x = 3; if (x != 3) return 0; }
+    return sizeof(T) == 1;
+}
+static int sibling_typedef(void) {
+    typedef double A, (*B)(A);
+    B fn = plus_half;
+    return fn(1.5) == 2.0;
+}
+static int typedef_array_size(void) {
+    int Local = 9;
+    {
+        typedef char Local, Bytes[sizeof(Local)];
+        return sizeof(Bytes) == 1;
+    }
+}
+static int later_attribute(void) {
+    int Aligned = 0, later __attribute__((aligned(sizeof(Aligned))));
+    return __alignof__(later) == sizeof(int);
+}
+static int own_attribute(void) {
+    int Aligned __attribute__((aligned(sizeof(Aligned)))) = 0;
+    return __alignof__(Aligned) == 16;
+}
+static int typedef_attribute(void) {
+    typedef long long Wide, Other __attribute__((aligned(sizeof(Wide))));
+    return __alignof__(Other) == sizeof(long long);
+}
+static int for_initializer(void) {
+    int result = 0;
+    for (int T = sizeof(T); T == sizeof(int); ++T) result = T;
+    return result == sizeof(int) && sizeof(T) == 1;
+}
+static int enum_shadow(void) {
+    int Enum = 3, extent = Enum;
+    int array[Enum];
+    return extent == 3 && sizeof(array) == 3 * sizeof(int);
+}
+
+#define CHECK(expr) do { if (!(expr)) return __LINE__; } while (0)
+int main(void) {
+    FileFn fn = plus_half;
+    CHECK(fn(1.5) == 2.0 && sizeof(FileArray) == 3 * sizeof(int));
+    CHECK(own_initializer());
+    CHECK(later_initializer());
+    CHECK(static_initializer());
+    CHECK(array_declarator());
+    CHECK(restored_scope());
+    CHECK(sibling_typedef());
+    CHECK(typedef_array_size());
+    CHECK(later_attribute());
+    CHECK(own_attribute());
+    CHECK(typedef_attribute());
+    CHECK(for_initializer());
+    CHECK(enum_shadow());
+    CHECK(Enum == 99);
+    return 0;
+}
diff --git a/tests/regression/preprocessor_ternary_type.c b/tests/regression/preprocessor_ternary_type.c
new file mode 100644
index 0000000000000000000000000000000000000000..6ba3e762fe3416de530936e3772d2601e99631db
--- /dev/null
+++ b/tests/regression/preprocessor_ternary_type.c
@@ -0,0 +1,63 @@
+/* C11 6.10.1p4 and 6.5.15p5: #if uses intmax_t/uintmax_t, and
+   ?: converts BOTH arms to their common type before selecting a value.
+   Inspired by sametyilmaztemel/claudes-c-compiler 5d3f86f8de.
+   Keep this separate from C-expression folding: preprocessing chooses code. */
+#if (1 ? -1 : 0U) < 0
+#error selected_signed_arm_must_convert_to_unsigned
+#endif
+#if (0 ? 0U : -1) < 0
+#error unsigned_true_arm_also_affects_false_arm
+#endif
+#if (0 ? 1U : -1) / 2 != 9223372036854775807
+#error unsigned_division_after_conditional
+#endif
+#if (1 ? -1 : 0xffffffffffffffff) < 0
+#error unsuffixed_unsigned_literal_affects_result
+#endif
+#if (1 ? (1 ? -1 : 0) : 0U) < 0
+#error nested_common_type_must_propagate
+#endif
+#if (1 ? -1 : (0 ? 0 : 1U)) < 0
+#error inactive_nested_unsigned_arm_affects_result
+#endif
+#if (1U ? -1 : 0) >= 0
+#error condition_type_must_not_affect_result_type
+#endif
+#if (0 ? 0 : -1) >= 0
+#error two_signed_arms_stay_signed
+#endif
+#if (1 ? -1 : (0U == 0)) >= 0
+#error comparison_result_is_signed
+#endif
+#if (1 ? -1 : !0U) >= 0
+#error logical_result_is_signed
+#endif
+#if (1 ? -1 : (0U, 0)) >= 0
+#error comma_result_has_right_operand_type
+#endif
+#if (1 ? -1 : (0, 0U)) < 0
+#error comma_right_operand_can_make_result_unsigned
+#endif
+/* The middle operand is an expression, not a conditional-expression. */
+#if (1 ? 0, 7 : 9) != 7
+#error comma_in_middle_operand
+#endif
+#if (0 ? 0, 7U : -1) < 0
+#error inactive_middle_comma_preserves_result_type
+#endif
+#if (1 ? 1U, -1 : 0) >= 0
+#error middle_comma_discards_left_operand_type
+#endif
+/* Inactive arms still supply their type, but must not emit -Wundef diagnostics. */
+#if (1 ? -1 : (UNDEFINED_TERNARY_ARM + 0U)) < 0
+#error inactive_undefined_arm_has_unsigned_type
+#endif
+#if (0 ? UNDEFINED_TERNARY_ARM : 1) != 1
+#error inactive_undefined_arm_value
+#endif
+#if 1 ? 0 ? 0 : 1 : 0
+#define LCCC_PP_TERNARY_RIGHT_ASSOCIATIVE 1
+#else
+#error conditional_operator_associativity
+#endif
+int main(void) { return 0; }
