+    pub(super) fn vla_cursor_close_run_for_field(&mut self, cursor: &mut VlaDynCursor) {
+        if !cursor.run_open {
+            return;
+        }
+        let bytes = ((cursor.run_bits + 7) / 8) as usize;
+        cursor.post += bytes;
+        cursor.guarantee = gcd_usize(cursor.guarantee, bytes.max(1));
+        cursor.run_open = false;
+        cursor.run_bits = 0;
+    }
