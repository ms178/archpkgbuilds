+    ("sqrt", 1, false),
+    ("sqrtf", 1, false),
+    ("sqrtl", 1, false),
+    ("stpcpy", 2, false),
+    ("stpncpy", 3, false),
+    ("strcat", 2, false),
+    ("strchr", 2, false),
+    ("strcpy", 2, false),
+    ("strcspn", 2, false),
+    ("strlen", 1, false),
+    ("strncat", 3, false),
+    ("strncpy", 3, false),
+    ("strpbrk", 2, false),
+    ("strrchr", 2, false),
+    ("strspn", 2, false),
+    ("strstr", 2, false),
+    ("tanhl", 1, false),
+    ("tanl", 1, false),
+    ("tgammal", 1, false),
+    ("trunc", 1, false),
+    ("truncf", 1, false),
