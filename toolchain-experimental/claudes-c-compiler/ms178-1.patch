+        uint64_t expected = expat_siphash24(data, n, key);
+        for (split = 0; split <= n; ++split) {
+            struct siphash h = SIPHASH_INITIALIZER;
+            sip24_init(&h, key);
+            sip24_update(&h, data, split);
+            sip24_update(&h, data + split, n - split);
+            if (sip24_final(&h) != expected) return 0;
+        }
+    }
+    return 1;
+}
+
+int main(void)
+{
+    unsigned char data[144];
+    struct sipkey key = {{ UINT64_C(0x0706050403020100), UINT64_C(0x0f0e0d0c0b0a0908) }};
+    uint32_t random = UINT32_C(0x178);
+    uint64_t sum = UINT64_C(0x9e3779b97f4a7c15);
+    unsigned int i;
+    for (i = 0; i < sizeof(data); ++i) {
+        random = random * UINT32_C(1664525) + UINT32_C(1013904223);
+        data[i] = (unsigned char)(random >> 24);
+    }
+    if (!check_streaming(data, &key)) return 1;
+    for (i = 0; i < PASSES; ++i) {
+        /* Vary length, alignment, key and data with the carried hash; no
+           repeated constant call, dead result or invariant-loop collapse. */
+        size_t len = (size_t)((sum >> 32) & 127U);
+        size_t offset = (size_t)(sum & 7U);
+        key.k[0] += sum | 1U;
+        data[i & 127U] ^= (unsigned char)(sum >> 48);
+        sum ^= expat_siphash24(data + offset, len, &key);
+    }
+    printf("%016llx\n", (unsigned long long)sum);
+    return 0;
+}
