+                    .any(|(n, b)| n == &s.name && *b == Binding::Link(n.clone())),
+                _ => false,
+            };
+            if mentions_self && !v.contains(&s.name.as_str()) {
+                v.push(s.name.as_str());
+            }
+        }
+        v
+    }
