+    let mut binding = SharedBinding::new(libraries);
+    for step in steps {
+        match *step {
+            LinkStep::Object(obj) => binding.object(obj),
+            LinkStep::Library { index, lib, defs } => {
+                binding.library(
+                    index,
+                    lib,
+                    defs,
+                    decided.and_then(|d| d.get(index).copied()),
+                );
+            }
+        }
+    }
