+CLIPPY_ARGS = [
+    "clippy",
+    "--all-targets",
+    "--profile",
+    "fastbuild",
+    "--locked",
+    "-j",
+    os.environ.get("CARGO_BUILD_JOBS", "2"),
+    "--",
+    "-D",
+    "warnings",
