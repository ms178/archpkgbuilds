+ * follow the host CPUID instead. */
+#ifndef ZSTD_ORACLE_HOST_CPU
+#include "zstd/common/cpu.h"
+static inline int zstd_oracle_no_bmi2(ZSTD_cpuid_t c) { (void)c; return 0; }
+#define ZSTD_cpuid_bmi2 zstd_oracle_no_bmi2
+#endif
