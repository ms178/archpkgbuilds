+++ b/tests/regression/cfi_unwind/unwind.c
@@ -0,0 +1,79 @@
+/* Unwinding through lccc-compiled frames: every function on the chain
+   main -> f1 -> lib_entry -> f2 -> f3 must be found by libgcc's unwinder,
+   identified by the start address of its FDE.
+
+   Built whole, or split: -DUNWIND_LIB (cb, f2, f3, lib_entry; as a shared
+   library, where only PT_GNU_EH_FRAME leads the unwinder to the FDEs) and
+   -DUNWIND_MAIN (f1, main). f2/f3 are hidden in the split build so the
+   library records their real addresses (a canonical function address seen
+   from the executable may be a PLT stub). */
+extern int _Unwind_Backtrace(int (*)(void *, void *), void *);
+extern unsigned long _Unwind_GetRegionStart(void *);
+extern int printf(const char *, ...);
+
+struct st {
+    unsigned long want[5];
+    int found;
+    int depth;
+};
+
+int lib_entry(struct st *s, int x);
+
+#ifndef UNWIND_MAIN
+#ifdef UNWIND_LIB
+#define LOCAL __attribute__((visibility("hidden")))
+#else
+#define LOCAL
+#endif
+
+static int cb(void *ctx, void *arg) {
+    struct st *s = arg;
+    unsigned long r = _Unwind_GetRegionStart(ctx);
+    for (int i = 0; i < 5; i++)
+        if (r == s->want[i])
+            s->found |= 1 << i;
+    s->depth++;
+    return 0; /* _URC_NO_REASON */
+}
+
+volatile int lib_sink;
+
+LOCAL __attribute__((noinline)) int f3(struct st *s, int x) {
+    volatile char big[5000]; /* frame larger than a 12-bit immediate */
+    big[x] = (char)x;
+    _Unwind_Backtrace(cb, s);
+    return s->found + big[x];
+}
+
+LOCAL __attribute__((noinline)) int f2(struct st *s, int x) {
+    int r = f3(s, x + 1);
+    lib_sink = r;
+    return r + x;
+}
+
+__attribute__((noinline)) int lib_entry(struct st *s, int x) {
+    s->want[0] = (unsigned long)f3;
+    s->want[1] = (unsigned long)f2;
+    s->want[2] = (unsigned long)lib_entry;
+    int r = f2(s, x);
+    lib_sink = r;
+    return r - 2;
+}
+#endif
+
+#ifndef UNWIND_LIB
+volatile int sink;
+
+__attribute__((noinline)) int f1(struct st *s, int x) {
+    int r = lib_entry(s, x * 2);
+    sink = r;
+    return r - 1;
+}
+
+int main(void) {
+    struct st s = {{0, 0, 0, (unsigned long)f1, (unsigned long)main}, 0, 0};
+    int r = f1(&s, 3);
+    printf("found=%x depth=%d r=%d\n", s.found, s.depth, r);
+    return s.found == 31 ? 0 : 1;
+}
+#endif
diff --git a/tests/regression/check_builtin_dso_link.sh b/tests/regression/check_builtin_dso_link.sh
new file mode 100755
index 000000000..548e998a7
--- /dev/null
+++ b/tests/regression/check_builtin_dso_link.sh
@@ -0,0 +1,77 @@
+#!/usr/bin/env bash
+# Shared libraries and dynamic executables linked by lccc's builtin linker
+# (each target's lccc driver links with it by default), against gcc's link
+# semantics:
+#   - `-shared` links crti/crtbeginS/crtendS/crtn and -lgcc -lgcc_s -lc
+#     (the DSO's constructor registers atexit: __dso_handle + libc_nonshared);
+#   - the user's -l libraries precede the defaults in DT_NEEDED, i.e. in the
+#     loader's search order (libdso's getenv interposes libc's);
+#   - `-rpath` becomes DT_RUNPATH (the program finds libdso.so through
+#     $ORIGIN, no LD_LIBRARY_PATH);
+#   - the driver's implicit libm is not NEEDED by a program using no libm;
+#   - atexit (libc_nonshared.a, via the libc.so linker script) resolves in
+#     the executable as in the DSO;
+#   - a missing user -l library fails the link with GNU ld's diagnostic.
+# Legs: x86-64, i686 (with gcc -m32 libraries), and AArch64/RISC-V under
+# qemu when cross gcc and sysroot are installed. One compile+link per leg.
+#
+# Usage: [CCC=target/fastbuild/lccc] bash tests/regression/check_builtin_dso_link.sh
+set -u
+here=$(cd "$(dirname "$0")" && pwd)
+CCC=${CCC:-$here/../../target/fastbuild/lccc}
+[ -x "$CCC" ] || { echo "check_builtin_dso_link: SKIP ($CCC not built)"; exit 0; }
+bin=$(cd "$(dirname "$CCC")" && pwd)
+src=$here/builtin_dso
+work=$(mktemp -d "${TMPDIR:-/tmp}/dsolink.XXXXXX")
+trap 'rm -rf "$work"' EXIT
+fail=0
+expect=$'dso ctor\nmain interposed 42\nmain atexit\ndso atexit'
+missing='cannot find -lno_such_lib_dsolink: No such file or directory'
+
+# leg LABEL CC READELF [RUNNER...]
+leg() {
+    local label=$1 cc=$2 re=$3; shift 3
+    local d=$work/${label// /_}
+    mkdir -p "$d"
+    if ! "$cc" -O2 -fPIC -c "$src/lib.c" -o "$d/lib.o" ||
+       ! "$cc" -O2 -c "$src/main.c" -o "$d/main.o"; then
+        echo "FAIL [$label]: compile"; fail=1; return
+    fi
+    if ! "$cc" -shared "$d/lib.o" -o "$d/libdso.so" ||
+       ! "$cc" "$d/main.o" -L"$d" -ldso -Wl,-rpath,'$ORIGIN' -o "$d/main"; then
+        echo "FAIL [$label]: link"; fail=1; return
+    fi
+    local dyn_exe dyn_so got err why=""
+    err=$("$cc" "$d/main.o" -L"$d" -lno_such_lib_dsolink -o "$d/bad" 2>&1) &&
+        why+=" missing-lib-linked"
+    grep -qF "$missing" <<<"$err" || why+=" missing-lib-diagnostic=[${err//$'\n'/|}]"
+    dyn_exe=$("$re" -dW "$d/main")
+    dyn_so=$("$re" -dW "$d/libdso.so")
+    grep -q 'RUNPATH.*\[\$ORIGIN\]' <<<"$dyn_exe" || why+=" no-RUNPATH"
+    grep -q 'NEEDED.*\[libc\.so' <<<"$dyn_so" || why+=" dso-without-libc-NEEDED"
+    grep -q 'NEEDED.*\[libm\.so' <<<"$dyn_exe" && why+=" unused-libm-NEEDED"
+    got=$(cd / && timeout 60 "$@" "$d/main" 2>&1)
+    [ "$got" = "$expect" ] || why+=" output=[${got//$'\n'/|}]"
+    if [ -z "$why" ]; then
+        echo "PASS [$label]"
+    else
+        echo "FAIL [$label]:$why"; fail=1
+    fi
+}
+
+leg "x86-64" "$CCC" readelf
+if [ -x "$bin/lccc-i686" ] && echo 'int main(void){return 0;}' | gcc -m32 -x c - -o "$work/m32" 2>/dev/null; then
+    leg "i686" "$bin/lccc-i686" readelf
+else
+    echo "SKIP [i686: lccc-i686 or gcc -m32 unavailable]"
+fi
+for t in aarch64:arm riscv64:riscv; do
+    tri=${t%%:*}; cc=$bin/lccc-${t##*:}
+    if [ -x "$cc" ] && command -v "$tri-linux-gnu-gcc" >/dev/null 2>&1 &&
+       command -v "qemu-$tri" >/dev/null 2>&1 && [ -d "/usr/$tri-linux-gnu" ]; then
+        leg "$tri" "$cc" "$tri-linux-gnu-readelf" "qemu-$tri" -L "/usr/$tri-linux-gnu"
+    else
+        echo "SKIP [$tri: cross gcc, qemu-$tri or sysroot missing]"
+    fi
+done
+[ "$fail" = 0 ] && echo "check_builtin_dso_link: PASS" || { echo "check_builtin_dso_link: FAIL"; exit 1; }
diff --git a/tests/regression/check_cfi_unwind.sh b/tests/regression/check_cfi_unwind.sh
new file mode 100755
index 000000000..c78f910cd
--- /dev/null
+++ b/tests/regression/check_cfi_unwind.sh
@@ -0,0 +1,99 @@
+#!/usr/bin/env bash
+# Run-time witness that libgcc's unwinder walks through lccc-compiled frames
+# on every target: the integrated assemblers lower `.cfi_*` into
+# `.eh_frame` (src/backend/cfi_lower.rs; RV-AS-CFI/A64-AS-CFI: AArch64 and
+# RISC-V dropped every CFI directive, so no unwinder -- pthread_cancel,
+# C++ exceptions through C callbacks, backtrace(), gdb -- got past the first
+# lccc frame). cfi_unwind/unwind.c fails unless _Unwind_Backtrace reports
+# the FDE of every function on the chain main -> f1 -> lib_entry -> f2 ->
+# f3, built as one executable and split into executable + shared library
+# (the unwinder reaches a library's FDEs only through its PT_GNU_EH_FRAME:
+# RV-LD-EHFRAMEHDR, lccc-ld wrote that header pointing at address 0 in
+# executables and none at all in RISC-V shared libraries).
+#
+# Legs: x86-64 (bfd, lccc-ld, mold, lld), i686, and AArch64/RISC-V under
+# qemu when the cross toolchain and sysroot are installed (also linked by
+# the builtin lccc-ld), each at -O0 and -O2, whole and split.
+set -uo pipefail
+here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+CCC=${CCC:-$here/../../target/fastbuild/lccc}
+bin=$(cd "$(dirname "$CCC")" && pwd)
+src=$here/cfi_unwind/unwind.c
+work=$(mktemp -d "${TMPDIR:-/tmp}/cfiunw.XXXXXX")
+trap 'rm -rf "$work"' EXIT
+fail=0
+n=0
+
+# leg LABEL CC "LINK-DRIVER" "LINK-FLAGS" [RUNNER...]
+leg() {
+    local label=$1 cc=$2 drv=$3 lflags=$4; shift 4
+    local o
+    for o in 0 2; do
+        local d=$work/$((n += 1))
+        mkdir -p "$d"
+        if ! "$cc" -O$o -c "$src" -o "$d/u.o"; then
+            echo "FAIL [$label -O$o]: compile"; fail=1; continue
+        fi
+        # The object itself must carry unwind tables.
+        if ! readelf -SW "$d/u.o" | grep -Eq '\.eh_frame +PROGBITS +[0-9a-f]+ +[0-9a-f]+ +0*[1-9a-f]'; then
+            echo "FAIL [$label -O$o]: no .eh_frame in the object"; fail=1; continue
+        fi
+        if ! $drv $lflags "$d/u.o" -o "$d/u"; then
+            echo "FAIL [$label -O$o]: link"; fail=1; continue
+        fi
+        run "$label -O$o" "$d/u" "$@"
+        if ! "$cc" -O$o -fPIC -DUNWIND_LIB -c "$src" -o "$d/l.o" ||
+           ! "$cc" -O$o -DUNWIND_MAIN -c "$src" -o "$d/m.o"; then
+            echo "FAIL [$label -O$o shared]: compile"; fail=1; continue
+        fi
+        if ! $drv $lflags -shared "$d/l.o" -o "$d/libunw.so" ||
+           ! $drv $lflags "$d/m.o" -L"$d" -lunw -Wl,-rpath,'$ORIGIN' -o "$d/m"; then
+            echo "FAIL [$label -O$o shared]: link"; fail=1; continue
+        fi
+        run "$label -O$o shared" "$d/m" "$@"
+    done
+}
+
+# run LABEL EXE [RUNNER...]
+run() {
+    local label=$1 exe=$2; shift 2
+    local got rc
+    got=$(timeout 60 "$@" "$exe" 2>&1); rc=$?
+    if [ "$rc" = 0 ]; then
+        echo "PASS [$label] $got"
+    else
+        echo "FAIL [$label] rc=$rc: $got"; fail=1
+    fi
+}
+
+shim=$work/shim
+mkdir -p "$shim"
+ln -s "$bin/lccc-ld" "$shim/ld"
+leg "x86-64 bfd" "$CCC" gcc ""
+leg "x86-64 lccc-ld" "$CCC" gcc "-B$shim"
+for l in mold lld; do
+    if command -v "ld.$l" >/dev/null 2>&1; then
+        leg "x86-64 $l" "$CCC" gcc "-fuse-ld=$l"
+    else
+        echo "SKIP [x86-64 $l: ld.$l not found]"
+    fi
+done
+if [ -x "$bin/lccc-i686" ] && echo 'int main(void){return 0;}' | gcc -m32 -x c - -o "$work/m32" 2>/dev/null; then
+    leg "i686 bfd" "$bin/lccc-i686" "gcc -m32" ""
+    # lccc-ld writes i386 executables as ET_EXEC only (it refuses -pie).
+    leg "i686 lccc-ld (non-PIE)" "$bin/lccc-i686" "gcc -m32" "-no-pie -B$shim"
+else
+    echo "SKIP [i686: lccc-i686 or gcc -m32 unavailable]"
+fi
+for t in aarch64:arm riscv64:riscv; do
+    tri=${t%%:*}; cc=$bin/lccc-${t##*:}
+    if [ -x "$cc" ] && command -v "$tri-linux-gnu-gcc" >/dev/null 2>&1 &&
+       command -v "qemu-$tri" >/dev/null 2>&1 && [ -d "/usr/$tri-linux-gnu" ]; then
+        leg "$tri bfd" "$cc" "$tri-linux-gnu-gcc" "" "qemu-$tri" -L "/usr/$tri-linux-gnu"
+        # The lccc driver links with its builtin linker by default.
+        leg "$tri lccc-ld" "$cc" "$cc" "" "qemu-$tri" -L "/usr/$tri-linux-gnu"
+    else
+        echo "SKIP [$tri: cross gcc, qemu-$tri or sysroot missing]"
+    fi
+done
+[ "$fail" = 0 ] && echo "check_cfi_unwind: PASS" || { echo "check_cfi_unwind: FAIL"; exit 1; }
