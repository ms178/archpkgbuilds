+        },
+        dst: MachOperand::StackSlot(-40),
+    });
+    assert_eq!(
+        lines,
+        vec!["movdqu 16(%rbx), %xmm0", "movdqu %xmm0, -40(%rbp)"],
+        "pointer-to-slot 16-byte move"
+    );
+}
