diff --git a/tests/regression/vectorize_sum_f64.c b/tests/regression/vectorize_sum_f64.c
new file mode 100644
index 0000000..931f997
--- /dev/null
+++ b/tests/regression/vectorize_sum_f64.c
@@ -0,0 +1,11 @@
+double sum_f64(const double *restrict a, int n) {
+    double s = 0.0;
+    for (int i = 0; i < n; i++) s += a[i];
+    return s;
+}
+int main(void) {
+    double a[8] = {1,2,3,4,5,6,7,8};
+    double s = sum_f64(a, 8);
+    if (s < 35.9 || s > 36.1) return 1;
+    return 0;
+}
diff --git a/tests/regression/vectorize_sum_i32.c b/tests/regression/vectorize_sum_i32.c
new file mode 100644
index 0000000..7884897
--- /dev/null
+++ b/tests/regression/vectorize_sum_i32.c
@@ -0,0 +1,13 @@
+int sum_i32(const int *restrict a, int n) {
+    int s = 0;
+    for (int i = 0; i < n; i++) s += a[i];
+    return s;
+}
+int main(void) {
+    int a[16];
+    int expect = 0;
+    for (int i = 0; i < 16; i++) { a[i] = i + 1; expect += a[i]; }
+    if (sum_i32(a, 16) != expect) return 1;
+    if (sum_i32(a, 0) != 0) return 2;
+    return 0;
+}
