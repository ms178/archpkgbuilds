diff --git a/tests/regression/check_vectorize_round_maps.sh b/tests/regression/check_vectorize_round_maps.sh
new file mode 100755
index 0000000000000000000000000000000000000000..4ff95e7ec32ea554a68460da8025131ef30023b6
--- /dev/null
+++ b/tests/regression/check_vectorize_round_maps.sh
@@ -0,0 +1,93 @@
+#!/usr/bin/env bash
+set -euo pipefail
+CCC=${CCC:-target/fastbuild/lccc}
+GCC=${GCC:-gcc}
+TD=$(mktemp -d)
+trap 'rm -rf "$TD"' EXIT
+SRC=tests/regression/vectorize_round_maps/vectorize_round_maps.c
+fail() { echo "FAIL: $*" >&2; exit 1; }
+body() { sed -n "/^$2:/,/^\.size $2/p" "$1"; }
+
+"$CCC" -O3 -march=x86-64-v3 -S "$SRC" -o "$TD/v3.s"
+for spec in \
+    'floor_f64 vroundpd.*\$9' 'floor_f32 vroundps.*\$9' \
+    'ceil_f64 vroundpd.*\$10' 'ceil_f32 vroundps.*\$10' \
+    'trunc_f64 vroundpd.*\$11' 'trunc_f32 vroundps.*\$11' \
+    'rint_f64 vroundpd.*\$4' 'rint_f32 vroundps.*\$4' \
+    'nearby_f64 vroundpd.*\$12' 'nearby_f32 vroundps.*\$12' \
+    'roundeven_f64 vroundpd.*\$8' 'roundeven_f32 vroundps.*\$8'; do
+    set -- $spec
+    body "$TD/v3.s" "$1" | grep -Ec "$2" >/dev/null || fail "$1 lacks its packed rounding mode"
+done
+for spec in 'sqrt_f64 vsqrtpd' 'sqrt_f32 vsqrtps'; do
+    set -- $spec
+    body "$TD/v3.s" "$1" | grep -Ec "$2" >/dev/null || fail "$1 lacks packed square root"
+done
+body "$TD/v3.s" floor_f64 | grep -Ec 'vroundpd.*\(' >/dev/null || fail 'round failed to fold its source load'
+body "$TD/v3.s" ceil_f32 | grep -Ec 'vroundps.*\(' >/dev/null || fail 'roundf failed to fold its source load'
+body "$TD/v3.s" sqrt_f64 | grep -Ec 'vsqrtpd.*\(' >/dev/null || fail 'sqrt failed to fold its source load'
+body "$TD/v3.s" sqrt_f32 | grep -Ec 'vsqrtps.*\(' >/dev/null || fail 'sqrtf failed to fold its source load'
+# Dynamic signed-long bounds need a guarded byte limit, not a second hot-loop
+# induction variable. Between the packed op and its backedge there must be only
+# the byte-IV increment; an element-counter `addq $1` costs every vector trip.
+for fn in floor_f64 floor_f32; do
+    hot=$(body "$TD/v3.s" "$fn" | sed -n '/vroundp[sd].*(/,/jl /p' | sed -n '1,20p')
+    [ "$(printf '%s\n' "$hot" | grep -Ec 'addq')" -eq 1 ] || fail "$fn kept two hot induction increments"
+    printf '%s\n' "$hot" | grep -Ec 'addq[[:space:]]+\$32' >/dev/null || fail "$fn lacks its byte-IV increment"
+done
+# Register-source legs are independently required: a memory fold alone must
+# not hide a backend that cannot carry a computed packed value into round/sqrt.
+for spec in \
+    'floor_add_f64 vaddpd' 'floor_add_f64 vroundpd.*%ymm' \
+    'floor_add_f32 vaddps' 'floor_add_f32 vroundps.*%ymm' \
+    'sqrt_add_f64 vaddpd' 'sqrt_add_f64 vsqrtpd.*%ymm' \
+    'sqrt_add_f32 vaddps' 'sqrt_add_f32 vsqrtps.*%ymm'; do
+    set -- $spec
+    body "$TD/v3.s" "$1" | grep -Ec "$2" >/dev/null || fail "$1 lacks register-source packed chain: $2"
+done
+# Register-to-register unary chains must remain in the SIMD scratch register:
+# a dead stack home between load, round/sqrt and store erased most of the win.
+for fn in floor_f64 floor_f32 sqrt_f64 sqrt_f32 \
+          floor_add_f64 floor_add_f32 sqrt_add_f64 sqrt_add_f32; do
+    if body "$TD/v3.s" "$fn" | grep -Ec 'vmovdqu.*%rsp|vmovdqu.*\(%rsp\)' >/dev/null; then
+        fail "$fn regressed to dead vector stack traffic"
+    fi
+done
+# The negative controls are part of legality, not merely shape preferences.
+CCC_NO_MAP_VEC=1 "$CCC" -O3 -march=x86-64-v3 -S "$SRC" -o "$TD/off.s"
+if grep -Eq 'vroundp[sd]' "$TD/off.s"; then
+    fail 'map kill switch did not restore scalar rounding'
+fi
+"$CCC" -O3 -march=x86-64 -S "$SRC" -o "$TD/sse2.s"
+if grep -Eq '(^|[[:space:]])v?roundp[sd]' "$TD/sse2.s"; then
+    fail 'SSE4.1 packed rounding leaked into the SSE2 baseline'
+fi
+"$CCC" -O3 -march=x86-64-v3 -mno-avx -S "$SRC" -o "$TD/sse41.s"
+grep -Eq '(^|[[:space:]])roundpd' "$TD/sse41.s" || fail '128-bit F64 rounding fallback missing'
+grep -Eq '(^|[[:space:]])roundps' "$TD/sse41.s" || fail '128-bit F32 rounding fallback missing'
+if grep -Eq '(^|[[:space:]])vroundp[sd]' "$TD/sse41.s"; then
+    fail 'VEX packed rounding leaked through -mno-avx'
+fi
+
+# Integrated assembly and full runtime parity over every tail length, signed
+# zero, infinities, fractional boundaries and quiet-NaN payloads.
+"$CCC" -O3 -march=x86-64-v3 -DTEST_MAIN "$SRC" -lm -o "$TD/lccc"
+"$GCC" -O3 -march=x86-64-v3 -DTEST_MAIN "$SRC" -lm -o "$TD/gcc"
+"$TD/lccc" >"$TD/lccc.out"
+"$TD/gcc" >"$TD/gcc.out"
+cmp "$TD/lccc.out" "$TD/gcc.out" || fail 'packed/scalar-tail results differ from GCC'
+
+# i686 currently uses its exact x87 scalar implementation: the x86-64 map
+# family must neither leak YMM ops nor silently drop a result on the 32-bit
+# backend. Exercise every mode and tail there as a mandatory cross-leg.
+"$CCC" -m32 -O3 -msse4.1 -S "$SRC" -o "$TD/i686.s"
+if grep -Eq 'v?roundp[sd]|v?sqrtp[sd]' "$TD/i686.s"; then
+    fail 'x86-64 packed map leaked into i686 lowering'
+fi
+"$CCC" -m32 -O3 -msse4.1 -DTEST_MAIN "$SRC" -lm -o "$TD/lccc32"
+"$GCC" -m32 -O3 -msse4.1 -DTEST_MAIN "$SRC" -lm -o "$TD/gcc32"
+"$TD/lccc32" >"$TD/lccc32.out"
+"$TD/gcc32" >"$TD/gcc32.out"
+cmp "$TD/lccc32.out" "$TD/gcc32.out" || fail 'i686 scalar rounding differs from GCC'
+
+echo 'vector round maps: PASS'
diff --git a/tests/regression/vectorize_round_maps/vectorize_round_maps.c b/tests/regression/vectorize_round_maps/vectorize_round_maps.c
new file mode 100644
index 0000000000000000000000000000000000000000..816aa6e98e12cb9c036037eef4034a1d508d21ed
--- /dev/null
+++ b/tests/regression/vectorize_round_maps/vectorize_round_maps.c
@@ -0,0 +1,110 @@
+typedef unsigned long long u64;
+typedef unsigned int u32;
+
+#define MAP(NAME, TYPE, OP)                                      \
+    __attribute__((noinline))                                    \
+    void NAME(TYPE *restrict d, const TYPE *restrict s, long n) { \
+        for (long i = 0; i < n; ++i) d[i] = OP(s[i]);             \
+    }
+MAP(floor_f64, double, __builtin_floor)
+MAP(floor_f32, float, __builtin_floorf)
+MAP(ceil_f64, double, __builtin_ceil)
+MAP(ceil_f32, float, __builtin_ceilf)
+MAP(trunc_f64, double, __builtin_trunc)
+MAP(trunc_f32, float, __builtin_truncf)
+MAP(rint_f64, double, __builtin_rint)
+MAP(rint_f32, float, __builtin_rintf)
+MAP(nearby_f64, double, __builtin_nearbyint)
+MAP(nearby_f32, float, __builtin_nearbyintf)
+MAP(roundeven_f64, double, __builtin_roundeven)
+MAP(roundeven_f32, float, __builtin_roundevenf)
+MAP(sqrt_f64, double, __builtin_sqrt)
+MAP(sqrt_f32, float, __builtin_sqrtf)
+
+/* Register-source legs: these ensure packed round/sqrt consume another packed
+   producer directly rather than relying only on their memory-source shortcut. */
+#define MAP2(NAME, TYPE, OP)                                                   \
+    __attribute__((noinline))                                                  \
+    void NAME(TYPE *restrict d, const TYPE *restrict a,                        \
+              const TYPE *restrict b, long n) {                                \
+        for (long i = 0; i < n; ++i) d[i] = OP(a[i] + b[i]);                   \
+    }
+MAP2(floor_add_f64, double, __builtin_floor)
+MAP2(floor_add_f32, float, __builtin_floorf)
+MAP2(sqrt_add_f64, double, __builtin_sqrt)
+MAP2(sqrt_add_f32, float, __builtin_sqrtf)
+
+#ifdef TEST_MAIN
+extern int printf(const char *, ...);
+extern int fesetround(int);
+static u64 dbits(double x) { union { double f; u64 u; } v = { x }; return v.u; }
+static u32 fbits(float x) { union { float f; u32 u; } v = { x }; return v.u; }
+static double dfrom(u64 x) { union { double f; u64 u; } v = { .u = x }; return v.f; }
+static float ffrom(u32 x) { union { float f; u32 u; } v = { .u = x }; return v.f; }
+
+int main(void) {
+    double sd[40], dd[40];
+    float sf[40], df[40];
+    static const u64 dseed[] = {
+        0, 0x8000000000000000ULL, 0x3fe0000000000000ULL,
+        0xbfe0000000000000ULL, 0x3ff8000000000000ULL,
+        0xbff8000000000000ULL, 0x432fffffffffffffULL,
+        0x7ff0000000000000ULL, 0xfff0000000000000ULL,
+        0x7ff8123456789abcULL
+    };
+    static const u32 fseed[] = {
+        0, 0x80000000U, 0x3f000000U, 0xbf000000U, 0x3fc00000U,
+        0xbfc00000U, 0x4affffffU, 0x7f800000U, 0xff800000U, 0x7fc12345U
+    };
+    for (int i = 0; i < 40; ++i) {
+        sd[i] = dfrom(dseed[i % 10]);
+        sf[i] = ffrom(fseed[(i * 7) % 10]);
+    }
+    static const int modes[] = { 0, 0x400, 0x800, 0xc00 };
+    for (int m = 0; m < 4; ++m) {
+      if (fesetround(modes[m])) return 2;
+      for (long n = 0; n <= 39; ++n) {
+        u64 h = 0xcbf29ce484222325ULL;
+#define MIXD(F) do { F(dd, sd, n); for (long j=0;j<n;++j) h=(h^dbits(dd[j]))*0x100000001b3ULL; } while (0)
+#define MIXF(F) do { F(df, sf, n); for (long j=0;j<n;++j) h=(h^fbits(df[j]))*0x100000001b3ULL; } while (0)
+#define MIXD2(F) do { F(dd, sd, sd, n); for (long j=0;j<n;++j) h=(h^dbits(dd[j]))*0x100000001b3ULL; } while (0)
+#define MIXF2(F) do { F(df, sf, sf, n); for (long j=0;j<n;++j) h=(h^fbits(df[j]))*0x100000001b3ULL; } while (0)
+        MIXD(floor_f64); MIXF(floor_f32);
+        MIXD(ceil_f64); MIXF(ceil_f32);
+        MIXD(trunc_f64); MIXF(trunc_f32);
+        MIXD(rint_f64); MIXF(rint_f32);
+        MIXD(nearby_f64); MIXF(nearby_f32);
+        MIXD(roundeven_f64); MIXF(roundeven_f32);
+        MIXD(sqrt_f64); MIXF(sqrt_f32);
+        MIXD2(floor_add_f64); MIXF2(floor_add_f32);
+        MIXD2(sqrt_add_f64); MIXF2(sqrt_add_f32);
+        printf("%016llx\n", h);
+#undef MIXD
+#undef MIXF
+#undef MIXD2
+#undef MIXF2
+      }
+    }
+    return 0;
+}
+#endif
+
+#ifdef BENCH_MAIN
+extern int printf(const char *, ...);
+static double bd[4096], bdo[4096];
+static float bf[4096], bfo[4096];
+int main(void) {
+    for (int i=0;i<4096;++i) { bd[i]=(double)(i-2048)+0.375; bf[i]=(float)(i-2048)+0.625f; }
+    for (int r=0;r<200;++r) {
+        floor_f64(bdo,bd,4096); floor_f32(bfo,bf,4096);
+        ceil_f64(bdo,bd,4096); ceil_f32(bfo,bf,4096);
+        trunc_f64(bdo,bd,4096); trunc_f32(bfo,bf,4096);
+        rint_f64(bdo,bd,4096); rint_f32(bfo,bf,4096);
+        nearby_f64(bdo,bd,4096); nearby_f32(bfo,bf,4096);
+        roundeven_f64(bdo,bd,4096); roundeven_f32(bfo,bf,4096);
+        sqrt_f64(bdo,bd,4096); sqrt_f32(bfo,bf,4096);
+    }
+    printf("%.0f %.0f\n", bdo[123], (double)bfo[321]);
+    return 0;
+}
+#endif
