+        assert_eq!(implicit_reg_refs(b"mulx %r9, %r8"), 1 << 2);
+        assert_eq!(implicit_write_refs(b"mulx %r9, %r8"), 0);
+        assert_eq!(implicit_reg_refs(b"imulq %r11"), (1 << 0) | (1 << 2));
+        assert_eq!(implicit_write_refs(b"imulq %r11"), (1 << 0) | (1 << 2));
+        assert_eq!(implicit_write_refs(b"imulq %r11, %r12"), 0);
+        assert_eq!(implicit_write_refs(b"imulq $3, %r11, %r12"), 0);
+        assert_eq!(implicit_reg_refs(b"rep movsb"), (1 << 1) | (1 << 6) | (1 << 7));
+        assert_eq!(implicit_write_refs(b"rep movsb"), (1 << 6) | (1 << 7));
+        assert_eq!(implicit_reg_refs(b"stosq"), (1 << 0) | (1 << 7));
+        assert_eq!(implicit_write_refs(b"stosq"), 1 << 7);
+        assert_eq!(implicit_reg_refs(b"jrcxz .L1"), 1 << 1);
+        assert_eq!(implicit_write_refs(b"jrcxz .L1"), 0);
+        assert_eq!(implicit_write_refs(b"xlatb"), 1 << 0);
+        assert_eq!(implicit_write_refs(b"lahf"), 1 << 0);
+        assert_eq!(implicit_write_refs(b"sahf"), 0);
+        assert_eq!(implicit_write_refs(b"loop .L1"), 1 << 1);
+        assert_eq!(implicit_write_refs(b"cmpxchg8b (%rdi)"), (1 << 0) | (1 << 2));
+        assert_eq!(implicit_write_refs(b"cpuid"), (1 << 0) | (1 << 1) | (1 << 2) | (1 << 3));
+        assert_eq!(implicit_write_refs(b"syscall"), (1 << 0) | (1 << 1) | (1 << 11));
+        assert_eq!(implicit_write_refs(b"leave"), (1 << 4) | (1 << 5));
+        // Labels, directives and comments contribute nothing.
+        assert_eq!(implicit_reg_refs(b".LBB1:"), 0);
+        assert_eq!(implicit_reg_refs(b"# comment"), 0);
+    }
+
+    #[test]
+    fn scan_register_refs_unions_the_implicit_set() {
+        // The oracle that every text pass consults must see the architectural
+        // registers too: `cqto` touches `%rdx` even though no text says so.
+        assert_ne!(scan_register_refs(b"cqto") & (1 << 2), 0);
+        assert_ne!(scan_register_refs(b"idivq %r11") & (1 << 2), 0);
+        assert_ne!(scan_register_refs(b"rep movsb") & (1 << 1), 0);
+        // Explicit text still contributes as before.
+        assert_ne!(scan_register_refs(b"movq %rdx, %r8") & (1 << 2), 0);
+        assert_ne!(scan_register_refs(b"movq %rdx, %r8") & (1 << 8), 0);
+    }
+}
