+        "#define RES (HDR + \\\n",
+        "  /* change, size, atime,\n",
+        "   * mtime, deleg_atime */\\\n",
+        "  (2 + 2 + 3 + 3) * 4)\n",
+        "int arr[RES];\n",
+        "int after;\n",
+    );
+    let (pp, out) = preprocess(src);
+    assert!(pp.errors().is_empty(), "errors: {:?}", pp.errors());
+    assert!(pp.macros.is_defined("RES"), "{out}");
+    assert!(
+        squeeze(&out).contains("int arr[((2 * 4) + (2 + 2 + 3 + 3) * 4)];"),
+        "macro body truncated or arithmetic leaked:\n{out}"
+    );
