+/// coverage (observed: reads at element ~2x the intended index,
+/// out-of-bounds for large n).
+fn reduction_array_a_base(func: &IrFunction, pattern: &ReductionPattern) -> Value {
+    let body_block = &func.blocks[pattern.body_idx];
