+                    FmaRoleOrder::RmBVvvvCDstA => ("b", "c", "a"),
+                    FmaRoleOrder::RmCVvvvADstB => ("c", "a", "b"),
+                    FmaRoleOrder::RmBVvvvADstC => ("b", "a", "c"),
+                };
+                let got = sdm(digits, slot(dst), slot(vvvv), slot(rm));
+                let want = a * b + c;
+                assert_eq!(got, want, "{digits} with a={a} b={b} c={c}");
+            }
+        }
+    }
+}
