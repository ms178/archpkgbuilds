+            .unwrap_or(rest.len());
+        let token = &rest[..end];
+        match token {
+            "rep" | "repe" | "repz" | "repne" | "repnz" => {
+                saw_rep = true;
+                rest = rest[end..].trim_start();
+                if rest.is_empty() {
+                    return (false, None);
+                }
+            }
+            "lock" | "bnd" | "data16" | "notrack" | "xacquire" | "xrelease" | "cs" | "ds"
+            | "es" | "ss" => {
