+    // .sbss, .bss; this linker's COPY slots close .bss; then
+    // `. = ALIGN(. != 0 ? 8 : 1)` inside .bss and `. = ALIGN(8)` after.
+    for name in [".sbss", ".bss"] {
+        if let Some(i) = by_name(name) {
+            if ms[i].sh_flags & SHF_TLS == 0 {
