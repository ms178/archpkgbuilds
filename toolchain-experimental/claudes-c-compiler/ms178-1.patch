+# Use mold for fastest possible links on the constrained 2-vCPU research box.
+# Mold's i686 preset ("-m elf_i386") is enabled automatically when the target
+# is i686-unknown-linux-gnu; for the default x86_64 host target mold picks the
+# x86_64 preset.  This saves ~300-500 ms per rebuild and cuts peak RSS during
+# LTO/fastbuild links enough to stay out of OOM on the 2 GB VM.
+[target.x86_64-unknown-linux-gnu]
+linker = "clang"
+rustflags = ["-C", "link-arg=-fuse-ld=mold"]
+
+[target.i686-unknown-linux-gnu]
+linker = "clang"
+rustflags = ["-C", "link-arg=-fuse-ld=mold", "-C", "link-arg=-m32"]
