+   the plain address &gs_storage + X are different addresses: a dropped or
+   spurious %gs: prefix changes the observed value. */
+static unsigned char gs_storage[8192] __attribute__((aligned(64)));
+static int __seg_gs *arr[4];
+
+static long
+set_gs_base (void *base)
+{
+  register long code __asm__ ("rdi") = 0x1001;
+  register void *addr __asm__ ("rsi") = base;
+  register long nr __asm__ ("rax") = 158;
+  __asm__ volatile ("syscall" : "+r" (nr) : "r" (code), "r" (addr)
+                    : "rcx", "r11", "memory");
+  return nr;
+}
+
+int
+main (void)
+{
+  if (set_gs_base (gs_storage + 4096) != 0)
+    { printf ("seg-ptr-array-storage: no-gs\\n"); return 0; }
+  gs_storage[4096 + 64] = 0x5a;   /* gs-relative 64, the real target      */
+  gs_storage[64] = 0x3c;          /* decoy a dropped %gs: prefix reads    */
+  arr[2] = (int __seg_gs *)(uintptr_t)64;
+  printf ("seg-ptr-array-storage: deref %d plain %d\\n", *arr[2],
+          gs_storage[64]);
+  return 0;
 }
     ''', [], None),
 ]
diff --git a/tests/regression/check_isa_gate_escape.sh b/tests/regression/check_isa_gate_escape.sh
new file mode 100755
index 00000000..57947345
--- /dev/null
+++ b/tests/regression/check_isa_gate_escape.sh
@@ -0,0 +1,177 @@
+#!/usr/bin/env bash
+# ISA-escape gate: an explicit `-march=` is a CEILING, not a suggestion.
+#
+# WHY THIS EXISTS
+# ---------------
+# The linux-cachymod-6.18 package builds with CONFIG_X86_NATIVE_CPU, and
+# arch/x86/Makefile therefore appends `-march=native`.  A kernel built that way
+# only runs on the build host's CPU class, which is fine for the owner's own
+# machine and disastrous for a QEMU boot gate: on QEMU's default `qemu64`
+# model the first BMI2/AVX2 instruction raises #UD, and in early 64-bit
+# startup a #UD is a triple fault with NO serial output at all — it looks
+# exactly like "the compiler miscompiled everything".
+#
+# The kernel was not at fault; neither was the ISA gate.  What was missing was
+# a gate that checks the negative direction: that a TU compiled for a lower
+# target contains no instruction from a higher one.  `-march=x86-64` (and
+# `-march=x86-64-v2`, and `-mno-bmi2`, ...) must be honored exactly, including
+# where the flag is *absent* for a Makefile that replaces KBUILD_CFLAGS.
+#
+# WHAT IS CHECKED
+# ---------------
+#   1. NEGATIVE: benchmark corpus + BMI-triggering probes compiled with
+#      `-march=x86-64` and with `-march=x86-64-v2` emit no BMI/BMI2/AVX-class
+#      mnemonic.  v2 is the interesting case: POPCNT/SSE4.2 are legal there,
+#      BMI1 (andn/bextr/bls*) and BMI2 (rorx/shlx/shrx/sarx/bzhi/mulx/pdep/
+#      pext) are not, and the peephole layer rewrites freely between
+#      `and`/`not` and `andn` — so a single missing feature check shows up here.
+#   2. NEGATIVE: `-mno-bmi2` suppresses the BMI2 class even when `-mavx2`
+#      would otherwise open it, while `-mbmi` still selects `andn`.
+#   3. POSITIVE (anti-vacuous): the same probes compiled with `-mavx2 -mbmi
+#      -mbmi2` DO contain the class, so a typo in the regex cannot make the
+#      gate pass forever.
+#   4. THE REAL SOURCE: the kernel decompressor's own flags — the ones
+#      arch/x86/boot/compressed/Makefile produces — applied to `ident_map`
+#      style code, must stay baseline-clean.  That is the exact configuration
+#      that triple-faulted, and it is a normal `make` invocation, so it is
+#      checked through `scripts/build_kernel_compressed.sh`'s CF array when a
+#      kernel tree is present (skipped otherwise: the gate must stay runnable
+#      on a bare checkout).
+set -euo pipefail
+
+CCC=${CCC:-./target/fastbuild/lccc}
+REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
+tmp=${TMPDIR:-/tmp}/lccc-isa-gate.$$
+trap 'rm -rf "$tmp"' EXIT
+mkdir -p "$tmp"
+cd "$REPO"
+
+if ! command -v "$CCC" >/dev/null 2>&1; then
+    echo "FAIL: compiler '$CCC' not found" >&2
+    exit 2
+fi
+
+# The BMI/BMI2 class.  PCRE-free (POSIX ERE) so this runs on any host grep.
+BMI_RE='\b(rorx[ql]|andn[ql]?|shrx[ql]|shlx[ql]|sarx[ql]|mulx[ql]|bzhi[ql]|bextr[ql]?|blsi[ql]?|blsmsk[ql]?|blsr[ql]?|pdep[ql]?|pext[ql]?|bzhi[ql]?)\b'
+# AVX/AVX2 VEX class (v-prefixed mnemonics, including `vmovdqu`).
+VEX_RE='(^|[[:space:]])v[a-z][a-z0-9]+[[:space:]]'
+# Baseline-illegal SSE4.2 class used by the v2 boundary.
+V2RE='\b(pcmpgtq|pcmpistri|pcmpestri|crc32[ql]?|popcnt[ql]?)\b'
+
+# Probes: the exact shapes whose passes emit the class (and-not fusion,
+# rotates -> rorx, variable shifts -> shlx/shrx/sarx, mask -> bzhi/bextr,
+# count-zero -> bls*, CRC/POPCNT table).
+cat >"$tmp/probe.c" <<'EOF'
+#include <stdint.h>
+uint32_t  andn_fused(uint32_t x, uint32_t y) { return x & ~y; }
+uint64_t  andn_fused64(uint64_t x, uint64_t y) { return x & ~y; }
+uint32_t  rot19(uint32_t x) { return (x >> 19) | (x << 13); }
+uint64_t  rot19l(uint64_t x) { return (x >> 19) | (x << 45); }
+uint32_t  shv(uint32_t a, uint32_t n) { return a >> n; }
+uint64_t  shvl(uint64_t a, uint64_t n) { return a << n; }
+int32_t   sar32(int32_t a, uint32_t n) { return a >> n; }
+uint32_t  mask_bits(uint32_t a, uint32_t n) { return a & ((1u << n) - 1); }
+int       lowest_bit(unsigned x) { return (int)(x & -x); }
+int       clear_lowest(unsigned x) { return (int)(x & (x - 1)); }
+int       highest_bit(unsigned x) { return x ? (int)(31 - __builtin_clz(x)) : 0; }
+unsigned  count_zero(unsigned x) { return x ? (unsigned)__builtin_ctz(x) : 32u; }
+uint64_t  mulhi(uint64_t a, uint64_t b) { return (uint64_t)(((unsigned __int128)a * b) >> 64); }
+EOF
+# A second probe with the kernel's scalar idioms (byte swap, popcount, CRC-ish
+# loops) because those are the shapes the decompressor is full of.
+cat >"$tmp/probe2.c" <<'EOF'
+#include <stdint.h>
+uint32_t bswap32(uint32_t x) { return __builtin_bswap32(x); }
+uint64_t bswap64(uint64_t x) { return __builtin_bswap64(x); }
+int popc(uint64_t x) { return __builtin_popcountll(x); }
+uint64_t rol_mix(uint64_t a, uint64_t b) {
+    uint64_t h = a ^ b;
+    for (int i = 0; i < 4; i++) h = (h >> 7) | (h << 57), h ^= b + (uint64_t)i;
+    return h;
+}
+EOF
+
+fail=0
+probe_only() { # the two probe files are ours: a compile failure is a defect
+    case $(basename "$1") in probe.c|probe2.c) return 0 ;; *) return 1 ;; esac
+}
+scan() { # scan <tag> <regex> <flags...>
+    local tag=$1 re=$2; shift 2
+    local hits=0 file skipped=0
+    for f in "$tmp/probe.c" "$tmp/probe2.c" \
+             tests/benchmark/programs/*.c; do
+        [ -f "$f" ] || continue
+        if ! "$CCC" "$@" -S "$f" -o "$tmp/out.s" 2>"$tmp/err.txt"; then
+            if probe_only "$f"; then
+                echo "FAIL: $tag: $(basename "$f") does not compile under '$*'" >&2
+                sed -n '1,5p' "$tmp/err.txt" >&2
+                fail=1
+            else
+                # A corpus program that cannot be built for a LOWER target
+                # (it may use higher-ISA intrinsics by design) is reported,
+                # never silently ignored.
+                skipped=$((skipped + 1))
+            fi
+            continue
+        fi
+        file=$(basename "$f")
+        local n clean
+        # Strip `#` comments first: a comment mentioning `vmovdqu` is not an
+        # instruction, and scanning raw text would make this gate lie.
+        sed 's/#.*//' "$tmp/out.s" >"$tmp/out.clean.s"
+        n=$(grep -cE "$re" "$tmp/out.clean.s" || true)
+        if [ "${n:-0}" != "0" ]; then
+            clean=$(grep -oE "$re" "$tmp/out.clean.s" | sort -u | tr '\n' ' ')
+            echo "FAIL: $tag: $file emitted $clean" >&2
+            hits=$((hits + n))
+        fi
+    done
+    echo "  $tag: $hits illegal instruction(s), $skipped corpus file(s) not buildable at this ISA"
+    [ "$hits" = 0 ] || fail=1
+}
+
+echo "ISA-escape gate: explicit -march is a ceiling"
+scan "-march=x86-64 (baseline: no BMI, no VEX)" "$BMI_RE|$VEX_RE" -march=x86-64 -O2
+scan "-march=x86-64-v2 (SSE4.2 legal, BMI still not)" "$BMI_RE" -march=x86-64-v2 -O2
+
+# -mno-bmi2 must win over a positive -mavx2 (which on this compiler implies
+# the v3 integer set), while -mbmi keeps `andn`.
+hits=0
+"$CCC" -march=x86-64 -mavx2 -mno-bmi2 -O2 -S "$tmp/probe.c" -o "$tmp/out.s"
+sed 's/#.*//' "$tmp/out.s" >"$tmp/out.clean.s"
+n=$(grep -cE '\b(rorx[ql]|shrx[ql]|shlx[ql]|sarx[ql]|mulx[ql]|bzhi[ql]|pdep[ql]?|pext[ql]?)\b' "$tmp/out.s" || true)
+[ "${n:-0}" = 0 ] || { echo "FAIL: -mno-bmi2 leaked: $(grep -oE '\b(rorx|shrx|shlx|sarx|mulx|bzhi)[ql]?' "$tmp/out.s" | sort -u | tr '\n' ' ')" >&2; hits=$n; }
+echo "  -mavx2 -mno-bmi2: $hits BMI2 instruction(s)"
+[ "$hits" = 0 ] || fail=1
+
+# Anti-vacuous positive control: the class MUST appear when the features are
+# granted, or a regex typo would make every negative above pass forever.
+"$CCC" -mavx2 -mbmi -mbmi2 -O2 -S "$tmp/probe.c" -o "$tmp/pos.s"
+sed 's/#.*//' "$tmp/pos.s" >"$tmp/pos.clean.s"
+pos=$(grep -cE "$BMI_RE" "$tmp/pos.clean.s" || true)
+if [ "${pos:-0}" = 0 ]; then
+    echo "FAIL: positive control emitted no BMI instruction with -mavx2 -mbmi -mbmi2" >&2
+    fail=1
+fi
+echo "  positive control (-mavx2 -mbmi -mbmi2): $pos BMI instruction(s)"
+
+# The DEFAULT (no -march at all) is the integer-v3 profile — a deliberate,
+# documented divergence from GCC's baseline default (commit "x86-64 /
+# peephole / middle-end: integer-v3 default ISA").  It is pinned here because
+# two harnesses depend on knowing it: scripts/build_kernel_compressed.sh must
+# pass -march=x86-64 explicitly for Makefiles that REPLACE KBUILD_CFLAGS, and
+# scripts/qemu_boot_test.sh pins the QEMU CPU model.  If the default ever
+# changes, this gate says so instead of a kernel triple-faulting silently.
+"$CCC" -O2 -S "$tmp/probe.c" -o "$tmp/def.s"
+sed 's/#.*//' "$tmp/def.s" >"$tmp/def.clean.s"
+def=$(grep -cE "$BMI_RE" "$tmp/def.clean.s" || true)
+if [ "${def:-0}" = 0 ]; then
+    echo "NOTE: the absent--march default no longer emits the v3 integer set" >&2
+    echo "      ($def BMI instructions) — revisit the kernel harness assumptions" >&2
+    echo "      in scripts/build_kernel_compressed.sh / kernel-vm.fragment." >&2
+else
+    echo "  default (-O2, no -march): $def BMI instruction(s) => integer-v3 profile (pinned)"
+fi
+
+echo "PASS: ISA ceilings honored ($pos mnemonic(s) in the positive control)"
+exit "$fail"
diff --git a/tests/regression/check_kernel_boot_isa.sh b/tests/regression/check_kernel_boot_isa.sh
new file mode 100644
index 00000000..c8226ea0
--- /dev/null
+++ b/tests/regression/check_kernel_boot_isa.sh
@@ -0,0 +1,242 @@
+#!/usr/bin/env bash
+# ISA contract of the kernel boot path — self-test for scripts/kernel_boot_isa.sh.
+#
+# WHY THIS EXISTS
+# ---------------
+# arch/x86/boot/compressed/Makefile and drivers/firmware/efi/libstub/Makefile
+# REPLACE KBUILD_CFLAGS, which discards the `-march=` that arch/x86/Makefile
+# derives from CONFIG_GENERIC_CPU/X86_64_VERSION.  GCC/Clang/ICC default to the
+# x86-64 baseline when `-march` is absent; LCCC's documented default ISA is the
+# integer-v3 profile, so the same Makefile silently built a BMI2 decompressor:
+# `shrxq` in kernel_ident_mapping_init is #UD on QEMU's `qemu64`, and a #UD in
+# early 64-bit startup is a triple fault with no serial output at all.
+#
+# The fix has two halves and BOTH are tested here, because either half alone
+# can rot silently:
+#   1. `patch`  — the two flag-wiping Makefiles name the x86-64 baseline ISA,
+#                 idempotently, and refuse to guess when the file is refactored.
+#   2. `scan`   — the BUILT boot/decompressor objects contain no BMI/ABM, VEX or
+#                 SSE4.2-class instruction.  That is the measured half.
+#
+# WHAT IS CHECKED
+# ---------------
+#   A. pristine fixtures -> patch rewrites exactly the x86-64 line, leaves the
+#      32-bit line and every other byte untouched, and is idempotent.
+#   B. a reverted line -> `check` FAILS (the gate can fail, it is not vacuous),
+#      and a second `patch` repairs it.
+#   C. refactored fixtures (32-bit reference line gone; x86-64 line gone) ->
+#      `patch` FAILS LOUDLY and does not modify the file.
+#   D. `scan` on a real object with BMI2 (`-mbmi2`) and on a real object with
+#      VEX (`-mavx2 -mno-bmi2`, so the hit cannot come from the integer set)
+#      FAILS and names the instruction; on a baseline object it PASSES; a
+#      directory argument is honored; a missing path and an empty directory
+#      both fail.
+set -euo pipefail
+
+CCC=${CCC:-./target/fastbuild/lccc}
+REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
+SCRIPT=$REPO/scripts/kernel_boot_isa.sh
+tmp=${TMPDIR:-/tmp}/lccc-boot-isa.$$
+trap 'rm -rf "$tmp"' EXIT
+mkdir -p "$tmp"
+cd "$REPO"
+
+fail=0
+[[ -f $SCRIPT ]] || { echo "FAIL: $SCRIPT missing" >&2; exit 2; }
+if ! command -v "$CCC" >/dev/null 2>&1; then
+    echo "FAIL: compiler '$CCC' not found" >&2
+    exit 2
+fi
+
+# --- fixtures ----------------------------------------------------------------
+K=$tmp/k
+mkdir -p "$K/arch/x86/boot/compressed" "$K/drivers/firmware/efi/libstub"
+
+cat > "$K/arch/x86/boot/compressed/Makefile" <<'EOF'
+# SPDX-License-Identifier: GPL-2.0
+KBUILD_CFLAGS := -m$(BITS) -O2 $(CLANG_FLAGS)
+KBUILD_CFLAGS += -std=gnu18
+cflags-$(CONFIG_X86_32) := -march=i386
+cflags-$(CONFIG_X86_64) := -mcmodel=small -mno-red-zone
+KBUILD_CFLAGS += $(cflags-y)
+EOF
+# The EFI-stub file separates its assignments with tabs, exactly as upstream.
+{
+    printf 'cflags-y\t\t\t:= $(KBUILD_CFLAGS)\n'
+    printf '\n'
+    printf 'cflags-$(CONFIG_X86_32)\t\t:= -march=i386\n'
+    printf 'cflags-$(CONFIG_X86_64)\t\t:= -mcmodel=small\n'
+} > "$K/drivers/firmware/efi/libstub/Makefile"
+
+cp "$K/arch/x86/boot/compressed/Makefile" "$tmp/compressed.pristine"
+cp "$K/drivers/firmware/efi/libstub/Makefile" "$tmp/efi.pristine"
+
+# --- A. patch ----------------------------------------------------------------
+echo "== patch (pristine fixture tree) =="
+if ! bash "$SCRIPT" patch "$K" > "$tmp/patch1.log" 2>&1; then
+    echo "FAIL: patch exited non-zero on a pristine tree:" >&2
+    sed 's/^/  /' "$tmp/patch1.log" >&2
+    fail=1
+fi
+grep -c -- '-march=x86-64' "$K/arch/x86/boot/compressed/Makefile" >/dev/null || {
+    echo "FAIL: decompressor line was not made explicit" >&2
+    fail=1
+}
+grep -c -- '-march=x86-64 -mcmodel=small$' "$K/drivers/firmware/efi/libstub/Makefile" >/dev/null || {
+    echo "FAIL: EFI stub line was not made explicit" >&2
+    fail=1
+}
+# The 32-bit branch and every unrelated byte must survive the rewrite.
+if ! cmp -s <(sed 's/-march=x86-64 -mcmodel=small -mno-red-zone/-mcmodel=small -mno-red-zone/' \
+                "$K/arch/x86/boot/compressed/Makefile") "$tmp/compressed.pristine"; then
+    echo "FAIL: patch changed more than the x86-64 line (decompressor)" >&2
+    diff -u "$tmp/compressed.pristine" "$K/arch/x86/boot/compressed/Makefile" >&2 || true
+    fail=1
+fi
+if ! cmp -s <(sed 's/\t\t:= -march=x86-64 -mcmodel=small$/\t\t:= -mcmodel=small/' \
+                "$K/drivers/firmware/efi/libstub/Makefile") "$tmp/efi.pristine"; then
+    echo "FAIL: patch changed more than the x86-64 line (EFI stub)" >&2
+    diff -u "$tmp/efi.pristine" "$K/drivers/firmware/efi/libstub/Makefile" >&2 || true
+    fail=1
+fi
+
+echo "== patch is idempotent =="
+cp "$K/arch/x86/boot/compressed/Makefile" "$tmp/compressed.patched"
+cp "$K/drivers/firmware/efi/libstub/Makefile" "$tmp/efi.patched"
+if ! bash "$SCRIPT" patch "$K" > "$tmp/patch2.log" 2>&1; then
+    echo "FAIL: second patch run exited non-zero" >&2
+    sed 's/^/  /' "$tmp/patch2.log" >&2
+    fail=1
+fi
+cmp -s "$tmp/compressed.patched" "$K/arch/x86/boot/compressed/Makefile" || {
+    echo "FAIL: second patch run changed the decompressor file" >&2
+    fail=1
+}
+cmp -s "$tmp/efi.patched" "$K/drivers/firmware/efi/libstub/Makefile" || {
+    echo "FAIL: second patch run changed the EFI stub file" >&2
+    fail=1
+}
+grep -c 'already explicit' "$tmp/patch2.log" >/dev/null || {
+    echo "FAIL: second patch run did not report the fixture as already explicit" >&2
+    fail=1
+}
+
+echo "== check passes on a patched tree =="
+if ! bash "$SCRIPT" check "$K" > "$tmp/check1.log" 2>&1; then
+    echo "FAIL: check exited non-zero on a patched tree" >&2
+    sed 's/^/  /' "$tmp/check1.log" >&2
+    fail=1
+fi
+
+# --- B. a reverted line must fail the check ---------------------------------
+echo "== NEGATIVE CONTROL: check fails on a reverted tree =="
+cp "$tmp/compressed.pristine" "$K/arch/x86/boot/compressed/Makefile"
+if bash "$SCRIPT" check "$K" > "$tmp/check2.log" 2>&1; then
+    echo "FAIL: check passed with the decompressor line reverted (vacuous gate)" >&2
+    fail=1
+fi
+bash "$SCRIPT" patch "$K" > /dev/null 2>&1 || { echo "FAIL: repair patch failed" >&2; fail=1; }
+bash "$SCRIPT" check "$K" > /dev/null 2>&1 || { echo "FAIL: check failed after repair" >&2; fail=1; }
+
+# --- C. refactored fixtures must fail LOUDLY ---------------------------------
+echo "== refactor: the 32-bit reference line is gone =="
+mkdir -p "$tmp/refactor1/arch/x86/boot/compressed" "$tmp/refactor1/drivers/firmware/efi/libstub"
+sed 's/^cflags-\$(CONFIG_X86_32) := -march=i386$/# x86-32 flags moved elsewhere/' \
+    "$tmp/compressed.pristine" > "$tmp/refactor1/arch/x86/boot/compressed/Makefile"
+cp "$tmp/efi.patched" "$tmp/refactor1/drivers/firmware/efi/libstub/Makefile"
+cp "$tmp/refactor1/arch/x86/boot/compressed/Makefile" "$tmp/refactor1.before"
+if bash "$SCRIPT" patch "$tmp/refactor1" > "$tmp/refactor1.log" 2>&1; then
+    echo "FAIL: patch accepted a tree whose 32-bit reference line was removed" >&2
+    fail=1
+fi
+cmp -s "$tmp/refactor1.before" "$tmp/refactor1/arch/x86/boot/compressed/Makefile" || {
+    echo "FAIL: patch modified a file it could not reason about" >&2
+    fail=1
+}
+
+echo "== refactor: neither pristine nor patched x86-64 line =="
+mkdir -p "$tmp/refactor2/arch/x86/boot/compressed" "$tmp/refactor2/drivers/firmware/efi/libstub"
+sed 's/^cflags-\$(CONFIG_X86_64) := .*/cflags-$(CONFIG_X86_64) := -mcmodel=large/' \
+    "$tmp/compressed.pristine" > "$tmp/refactor2/arch/x86/boot/compressed/Makefile"
+cp "$tmp/efi.patched" "$tmp/refactor2/drivers/firmware/efi/libstub/Makefile"
+cp "$tmp/refactor2/arch/x86/boot/compressed/Makefile" "$tmp/refactor2.before"
+if bash "$SCRIPT" patch "$tmp/refactor2" > "$tmp/refactor2.log" 2>&1; then
+    echo "FAIL: patch guessed at an unknown x86-64 line" >&2
+    fail=1
+fi
+cmp -s "$tmp/refactor2.before" "$tmp/refactor2/arch/x86/boot/compressed/Makefile" || {
+    echo "FAIL: patch modified a file whose x86-64 line it did not recognize" >&2
+    fail=1
+}
+
+# --- D. scan: real objects, both directions ----------------------------------
+echo "== scan: baseline object passes, BMI/ABM/VEX objects fail =="
+# Probe bodies are the ISA gate's proven BMI/BMI2 triggers (check_isa_gate_
+# escape.sh), plus a float add for the VEX control: `x & ~y` -> andn,
+# variable shifts -> shlx/shrx/sarx, bit masks -> bzhi, a float op -> VEX.
+cat > "$tmp/probe.c" <<'EOF'
+#include <stdint.h>
+uint32_t andn_fused(uint32_t x, uint32_t y) { return x & ~y; }
+uint64_t andn_fused64(uint64_t x, uint64_t y) { return x & ~y; }
+uint32_t shv(uint32_t a, uint32_t n) { return a >> n; }
+uint64_t shvl(uint64_t a, uint64_t n) { return a << n; }
+uint32_t mask_bits(uint32_t a, uint32_t n) { return a & ((1u << n) - 1); }
+uint64_t mulhi(uint64_t a, uint64_t b) { return (uint64_t)(((unsigned __int128)a * b) >> 64); }
+float vadd(float *restrict a, float *restrict b, int i) { return a[i] + b[i]; }
+EOF
+"$CCC" -O2 -march=x86-64 -c "$tmp/probe.c" -o "$tmp/base.o"
+if ! bash "$SCRIPT" scan "$tmp/base.o" > "$tmp/scan_base.log" 2>&1; then
+    echo "FAIL: scan rejected a baseline object" >&2
+    sed 's/^/  /' "$tmp/scan_base.log" >&2
+    fail=1
+fi
+# The project's documented default ISA profile: BMI1+BMI2 granted, so the
+# integer probes must produce the class and a baseline-claiming boot path
+# must never see it.
+"$CCC" -O2 -march=x86-64-v3 -c "$tmp/probe.c" -o "$tmp/bmi.o"
+if bash "$SCRIPT" scan "$tmp/bmi.o" > "$tmp/scan_bmi.log" 2>&1; then
+    echo "FAIL: scan accepted an object with BMI/ABM instructions (vacuous scan)" >&2
+    fail=1
+fi
+grep -cE '\b(andn[ql]?|rorx[ql]|sh[lr]x[ql]|sarx[ql]|mulx[ql]|bzhi[ql]|blsr[ql]?|tzcnt[ql]?|lzcnt[ql]?)\b' "$tmp/scan_bmi.log" >/dev/null || {
+    echo "FAIL: scan failed but named no BMI/ABM mnemonic" >&2
+    sed 's/^/  /' "$tmp/scan_bmi.log" >&2
+    fail=1
+}
+"$CCC" -O2 -mavx2 -mno-bmi -mno-bmi2 -c "$tmp/probe.c" -o "$tmp/vex.o"
+if bash "$SCRIPT" scan "$tmp/vex.o" > "$tmp/scan_vex.log" 2>&1; then
+    echo "FAIL: scan accepted an object with VEX instructions" >&2
+    fail=1
+fi
+grep -cE '(^|[[:space:]])v[a-z][a-z0-9]+[[:space:]]' "$tmp/scan_vex.log" >/dev/null || {
+    echo "FAIL: scan failed but named no VEX mnemonic" >&2
+    sed 's/^/  /' "$tmp/scan_vex.log" >&2
+    fail=1
+}
+echo "== scan: directory argument, empty directory, missing path =="
+mkdir -p "$tmp/objdir"
+cp "$tmp/base.o" "$tmp/objdir/a.o"
+if ! bash "$SCRIPT" scan "$tmp/objdir" > "$tmp/scan_dir.log" 2>&1; then
+    echo "FAIL: scan rejected a clean object directory" >&2
+    sed 's/^/  /' "$tmp/scan_dir.log" >&2
+    fail=1
+fi
+cp "$tmp/bmi.o" "$tmp/objdir/b.o"
+if bash "$SCRIPT" scan "$tmp/objdir" > /dev/null 2>&1; then
+    echo "FAIL: scan accepted a directory containing a BMI/ABM object" >&2
+    fail=1
+fi
+mkdir -p "$tmp/emptydir"
+if bash "$SCRIPT" scan "$tmp/emptydir" > /dev/null 2>&1; then
+    echo "FAIL: scan accepted an empty directory (nothing was audited)" >&2
+    fail=1
+fi
+if bash "$SCRIPT" scan "$tmp/does-not-exist" > /dev/null 2>&1; then
+    echo "FAIL: scan accepted a missing path" >&2
+    fail=1
+fi
+
+if [ "$fail" = 0 ]; then
+    echo "PASS: boot-path ISA contract (patch, idempotence, refactor refusal, artifact scan)"
+fi
+exit "$fail"
diff --git a/tests/regression/check_seg_const_offset_fold.sh b/tests/regression/check_seg_const_offset_fold.sh
new file mode 100644
index 00000000..9804c60a
--- /dev/null
+++ b/tests/regression/check_seg_const_offset_fold.sh
@@ -0,0 +1,195 @@
+#!/usr/bin/env bash
+# Segment-override constant-displacement fold gate.
+#
+# WHY THIS EXISTS
+# ---------------
+# A per-CPU access with a computed base and a constant struct displacement
+#
+#     per_cpu_ptr(&pcp, cpu)->field        /* struct S __seg_gs *ptr; ptr->f */
+#
+# must fold the displacement into the segment memory operand, exactly as GCC
+# and Clang do:
+#
+#     movq %gs:8(%rax), %rax               /* 1 instruction */
+#
+# lccc used to materialise the address first:
+#
+#     leaq 8(%rax), %rcx
+#     movq %gs:(%rcx), %rax                /* 2 instructions + a second GPR */
+#
+# That is the kernel's hottest per-CPU shape (`this_cpu_read`, per-CPU
+# counters in softirq/sched paths), so the extra laq/register is a real
+# regression against the oracle compilers. The fold lives in
+# emit_seg_load_with_const_offset (x86 backend) and is reached from
+# generate_load's segment branch; the GEP fold map keeps seg-overridden loads
+# as foldable consumers so the producer really is skipped.
+#
+# The same displacement must fold when the field feeds an ALU instruction
+# (`acc + p->b` -> `addq %gs:8(%rdi), %reg`): the segment operand replaces a
+# whole scratch load, so the fold saves a register as well as an instruction.
+# GCC keeps the scratch load in this leaf-add form, so for it lccc emits fewer
+# instructions than the oracle, not merely as few.
+#
+# This gate is the codegen half of the contract; seg_gs_const_offset_fold.c
+# is the behavioural half (it installs a real GS base and checks the values).
+# A gate that only greps for the operand shape is not enough on its own —
+# likewise a behavioural test cannot see the extra instruction. Both run.
+set -euo pipefail
+
+CCC=${CCC:-./target/fastbuild/lccc}
+REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
+tmp=${TMPDIR:-/tmp}/lccc-seg-const-offset-fold.$$
+trap 'rm -rf "$tmp"' EXIT
+mkdir -p "$tmp"
+cd "$REPO"
+
+if ! command -v "$CCC" >/dev/null 2>&1; then
+    echo "FAIL: compiler '$CCC' not found" >&2
+    exit 2
+fi
+
+# The folded shape: a register base plus a constant displacement.
+cat >"$tmp/fold.c" <<'EOF'
+struct S { long a; long b; long c[4]; };
+long read_b(struct S __seg_gs *p) { return p->b; }         /* +8            */
+long read_c3(struct S __seg_gs *p) { return p->c[3]; }     /* +16+8*3 = +40 */
+long read_a(struct S __seg_gs *p) { return p->a; }         /* +0            */
+long fold_after_call(struct S __seg_gs *base(void)) { return base()->b; }
+struct F { long a; double d; float f; };
+double read_d(struct F __seg_gs *p) { return p->d; }       /* +8            */
+float  read_f(struct F __seg_gs *p) { return p->f; }       /* +16           */
+/* ALU consumers: the field is read straight in the operand
+ * (`addq %gs:8(%rdi), %reg`, `cmpq ...`), never via a scratch load. */
+long acc_b(struct S __seg_gs *p, long acc) { return acc + p->b; }
+int  cmp_c3(struct S __seg_gs *p, long x) { return p->c[3] == x; } /* +40  */
+EOF
+
+"$CCC" -O2 -S -o "$tmp/fold.s" "$tmp/fold.c"
+
+fail=0
+
+# body_of <symbol>  -> the instruction lines of that function, no directives.
+body_of() {
+    awk -v fn="^$1:" '
+        $0 ~ fn { inb = 1; next }
+        inb && /^\.size/ { exit }
+        inb && /^[[:space:]]*#/ { next }
+        inb && /^[[:space:]]*\./ { next }
+        inb { print }
+    ' "$tmp/fold.s"
+}
+
+# NOTE: `grep -c ... >/dev/null`, never `grep -q`: these run under `set -o
+# pipefail`, and `grep -q` exits at the first match, killing `body_of` with
+# SIGPIPE and turning a real pass into a spurious failure (the pipefail-sigpipe
+# gate checks exactly this file).
+expect() { # expect <symbol> <needle> <description>
+    if ! body_of "$1" | grep -cF -- "$2" >/dev/null; then
+        echo "FAIL: $1: expected $3 ('$2')" >&2
+        echo "--- actual ---" >&2
+        body_of "$1" >&2
+        fail=1
+    fi
+}
+
+reject() { # reject <symbol> <needle> <description>
+    if body_of "$1" | grep -cF -- "$2" >/dev/null; then
+        echo "FAIL: $1: unwanted $3 ('$2')" >&2
+        echo "--- actual ---" >&2
+        body_of "$1" >&2
+        fail=1
+    fi
+}
+
+# Displacement folded into the segment operand, base register used directly.
+# `c[3]` is the struct's third array element after a and b: 16 + 8*3 = 40.
+expect read_b  '%gs:8(%rdi)'  'folded +8 displacement on the base register'
+expect read_c3 '%gs:40(%rdi)' 'folded +40 displacement on the base register'
+# Offset 0 stays the plain form (no bogus "+0" displacement).
+expect read_a  '%gs:(%rdi)'   'zero displacement form'
+reject read_a  '%gs:0(%rdi)'  'zero displacement must not print as 0(%rdi)'
+# No address materialisation for any of the three.
+reject read_b  'leaq'         'address materialisation (leaq)'
+reject read_c3 'leaq'         'address materialisation (leaq)'
+# A call-separated base still folds: the load is what carries the displacement.
+expect fold_after_call '%gs:8(%rax)' 'folded displacement after a call'
+reject fold_after_call 'leaq'        'address materialisation (leaq) after a call'
+# Scalar FP per-CPU loads stay in the SSE domain: one `movsd`/`movss`, never a
+# GPR round trip (`movq %gs:..,%rax` + a cross-domain move).
+expect read_d 'movsd %gs:8(%rdi)'  'SSE-domain double load'
+expect read_f 'movss %gs:16(%rdi)' 'SSE-domain float load'
+reject read_d 'movq'               'GPR round trip for a double load'
+reject read_f 'movq'               'GPR round trip for a float load'
+# ALU fusion: the per-CPU field feeds the add/compare directly (`addq
+# %gs:8(%rdi), %reg`), one instruction and no scratch register — the shape
+# `this_cpu_ptr(p)->field` takes inside any accumulation.  Any `movq %gs:`
+# left in these two bodies means the consumer got a materialised load
+# instead; the parity loop below then pins the operand text against GCC.
+expect acc_b  'addq %gs:8(%rdi)'   'ALU-fused per-CPU field read (add)'
+reject acc_b  'movq %gs:'          'unfused segment load in an add consumer'
+reject cmp_c3 'movq %gs:'          'unfused segment load in a compare consumer'
+
+# Cross-check against GCC when it is available: same instruction count for the
+# folded shape. gcc is an oracle here, never a dependency.
+if command -v gcc >/dev/null 2>&1; then
+    gcc -O2 -S -o "$tmp/fold_gcc.s" "$tmp/fold.c"
+    count_body() { # count_body <file> <symbol>
+        awk -v fn="^$1:" '
+            $0 ~ fn { inb = 1; next }
+            inb && /^\.size/ { exit }
+            inb && /^[[:space:]]*\./ { next }
+            inb && /^[[:space:]]*#/ { next }
+            inb { n++ }
+            END { print n + 0 }
+        ' "$2"
+    }
+    # `cmp_c3` is deliberately absent here: its one extra instruction is the
+    # boolean-materialisation tail (`sete %r9b; movzbl %r9b, %r9d; movl
+    # %r9d, %eax` where GCC zeroes %eax and does `sete %al`), which the SAME
+    # function shows without any segment override (`cmpq %rsi, 40(%rdi)`) —
+    # it is a return-register coalescing gap, not a segment-fold gap.
+    # docs/FOLLOWUP-2026-10-11-kernel-percpu-segment-fold.md §5.4 carries the
+    # reproducer; the folded OPERAND of cmp_c3 is still pinned by the loop
+    # below, so the segment half of the contract stays checked here.
+    for fn in read_b read_c3 read_a acc_b; do
+        ours=$(count_body "$fn" "$tmp/fold.s")
+        theirs=$(count_body "$fn" "$tmp/fold_gcc.s")
+        if [ "$ours" -gt "$theirs" ]; then
+            echo "FAIL: $fn: lccc $ours instructions vs GCC $theirs" >&2
+            fail=1
+        fi
+    done
+    # Exact-operand cross-check: the segment operand GCC folds must be the
+    # operand lccc emits, character for character.  Instruction counts alone
+    # cannot see a wrong constant — this gate itself once expected +32 for a
+    # +40 field (`c[3]` after `long a, b`), so the oracle compares the operand
+    # text, not just the count.  GCC spells a zero displacement the same way
+    # (`%gs:(%rdi)`), so all four shapes are compared.
+    for fn in read_b read_c3 read_a fold_after_call read_d read_f acc_b cmp_c3; do
+        want=$(awk -v fn="^$fn:" '
+            $0 ~ fn { inb = 1; next }
+            inb && /^\.size/ { exit }
+            inb && /%gs:[^,)]*\(%r[a-z0-9]+\)/ {
+                match($0, /%gs:[^,)]*\(%r[a-z0-9]+\)/)
+                print substr($0, RSTART, RLENGTH)
+                exit
+            }
+        ' "$tmp/fold_gcc.s")
+        if [ -z "$want" ]; then
+            # A vacuous oracle would silently pass: every shape listed here is
+            # expected to make GCC emit a folded segment operand.
+            echo "FAIL: $fn: GCC emitted no folded segment operand to compare against" >&2
+            fail=1
+        elif ! body_of "$fn" | grep -cF -- "$want" >/dev/null; then
+            echo "FAIL: $fn: GCC folds '$want' but lccc emits:" >&2
+            body_of "$fn" >&2
+            fail=1
+        fi
+    done
+fi
+
+if [ "$fail" -ne 0 ]; then
+    echo "FAIL: segment constant-displacement fold gate" >&2
+    exit 1
+fi
+echo "PASS: segment constant-displacement fold (%gs:disp(base), no leaq, GCC instruction parity)"
diff --git a/tests/regression/check_seg_direct_home.sh b/tests/regression/check_seg_direct_home.sh
new file mode 100755
index 00000000..fc3d5d06
--- /dev/null
+++ b/tests/regression/check_seg_direct_home.sh
@@ -0,0 +1,158 @@
+#!/usr/bin/env bash
+# Segment-override load: the value must land in its own GPR home.
+#
+# WHY THIS EXISTS
+# ---------------
+# A per-CPU access whose result is immediately used as the next pointer step
+#
+#     p = p->next;                     /* struct node __seg_gs *p */
+#
+# used to round-trip through %rax:
+#
+#     movq %gs:24(%rdi), %rax          /* load                                */
+#     movq %rax, %rdi                  /* relay into the value's home         */
+#
+# GCC and Clang emit the single-instruction form
+#
+#     movq %gs:24(%rdi), %rdi
+#
+# because the segment load has no reason to be pinned to %rax.  lccc's
+# *default-space* twin (`emit_load_with_const_offset`) and the segment
+# const-ADDRESS form (`emit_seg_load_const_addr`) both already load straight
+# into the destination's register; only the segment base+displacement path
+# (`emit_seg_load_with_const_offset`) went through %rax.  That is the kernel's
+# hottest per-CPU shape (`this_cpu_ptr(p)->field`, per-CPU counters in the
+# softirq/sched paths), so it costs one instruction and one live register per
+# access.
+#
+# This gate is the codegen half of the contract: it checks the emitted shape
+# (direct home, no relay) and that the walk loop stays within the oracle's
+# instruction count.  The behavioural half is
+# tests/correctness/programs/seg_gs_const_offset_fold.c, which installs a real
+# GS base and checks the loaded values — a shape-only gate cannot see a wrong
+# offset, and a behavioural test cannot see the extra instruction.  Both run.
+set -euo pipefail
+
+CCC=${CCC:-./target/fastbuild/lccc}
+REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
+tmp=${TMPDIR:-/tmp}/lccc-seg-direct-home.$$
+trap 'rm -rf "$tmp"' EXIT
+mkdir -p "$tmp"
+cd "$REPO"
+
+if ! command -v "$CCC" >/dev/null 2>&1; then
+    echo "FAIL: compiler '$CCC' not found" >&2
+    exit 2
+fi
+
+# The kernel's per-CPU pointer walk: three segment loads and a segment load of
+# the next pointer per iteration.
+cat >"$tmp/walk.c" <<'EOF'
+struct node { unsigned long tag; unsigned long hits; unsigned long miss; struct node __seg_gs *next; };
+unsigned long walk(struct node __seg_gs *p)
+{
+    unsigned long acc = 0;
+    while (p) {
+        acc += p->hits;
+        acc ^= p->miss;
+        acc += p->tag & 7UL;
+        p = p->next;
+    }
+    return acc;
+}
+EOF
+
+compile() { # compile <outfile> [extra-env-assignment...]
+    local out=$1; shift
+    # `export` with no arguments PRINTS the environment, so the extra
+    # assignments (if any) are applied only when present.
+    if [ "$#" -gt 0 ]; then
+        ( export "$@"; "$CCC" -O2 -S "$tmp/walk.c" -o "$out" )
+    else
+        "$CCC" -O2 -S "$tmp/walk.c" -o "$out"
+    fi
+}
+
+# The inner loop: the LAST label block that ends in a back edge (the walk has a
+# pre-header guard block, so "the first label" would capture both).
+verdict() { # verdict <asm-file>  -> 0 = pass, 1 = fail (prints the reason)
+    local asm=$1
+    awk '
+        /^\.LBB[0-9]+:$/ { cur = $0; body = ""; next }
+        cur != "" {
+            body = body $0 "\n"
+            if ($0 ~ /^[[:space:]]*(jne|jmp)[[:space:]]/) { lastc = cur; lastl = body; cur = "" }
+        }
+        END { if (lastl == "") exit 1; printf "%s%s", lastc, lastl }
+    ' "$asm" >"$tmp/loop.txt" || {
+        echo "FAIL: no back edge found in the walk function"
+        return 1
+    }
+    if ! grep -q '%gs:' "$tmp/loop.txt"; then
+        echo "FAIL: no segment load in the walk loop"
+        sed -n '1,80p' "$asm"
+        return 1
+    fi
+
+    # Regexes live in variables: an unquoted `(`/`)` inside `[[ =~ ... ]]` is
+    # parsed by bash as a grouping construct (`[^(]` looks unbalanced) and the
+    # script dies with "unexpected EOF while looking for matching `)'".
+    local re_load_rax='movq[[:space:]]+%gs:[^(]*\((%[a-z0-9]+)\),[[:space:]]*%rax[[:space:]]*$'
+    local re_rax_copy='^[[:space:]]*movq[[:space:]]+%rax,[[:space:]]*%[a-z0-9]+[[:space:]]*$'
+    local re_load_home='movq[[:space:]]+%gs:[^(]*\((%[a-z0-9%]+)\),[[:space:]]*(%[a-z0-9]+)[[:space:]]*$'
+
+    local prev="" line relay=0 direct=0 rc=0
+    while IFS= read -r line; do
+        # (1) No segment load may relay through %rax.
+        if [[ $prev =~ $re_load_rax ]] && [[ $line =~ $re_rax_copy ]]; then
+            echo "FAIL: segment load still relays through %rax:"
+            printf '%s\n%s\n' "$prev" "$line"
+            relay=1
+        fi
+        # (2) At least one load must write the same register the value lives in.
+        if [[ $line =~ $re_load_home ]] && [[ ${BASH_REMATCH[1]} == ${BASH_REMATCH[2]} ]]; then
+            direct=1
+        fi
+        prev="$line"
+    done <"$tmp/loop.txt"
+    [ "$relay" = 0 ] || rc=1
+    if [ "$direct" = 0 ]; then
+        echo "FAIL: no direct-to-home segment load found"
+        cat "$tmp/loop.txt"
+        rc=1
+    fi
+
+    # (3) The loop must not be longer than the oracle's: GCC and Clang emit
+    #     eight instructions for this body (the lea-inplace fold removes one;
+    #     no pass may add one).  A leading label may share its line with the
+    #     first instruction, so strip it before counting.  `grep -c` exits 1 on
+    #     a zero count; under `set -euo pipefail` that must not abort the run.
+    local n
+    n=$(sed 's/^\.LBB[0-9]*://' "$tmp/loop.txt" | grep -cE '^[[:space:]]*[a-z]' || true)
+    n=${n:-0}
+    if [ "$n" -gt 8 ]; then
+        echo "FAIL: loop body has $n instructions (oracle: 8)"
+        cat "$tmp/loop.txt"
+        rc=1
+    fi
+    [ "$rc" = 0 ] && echo "PASS: segment loads land in their own home ($n instructions in the walk loop)"
+    return $rc
+}
+
+compile "$tmp/walk.s" || { echo "FAIL: compile failed" >&2; exit 1; }
+if ! out=$(verdict "$tmp/walk.s"); then
+    printf '%s\n' "$out" >&2
+    exit 1
+fi
+printf '%s\n' "$out"
+
+# SELF-TEST: with the lea-inplace fold disabled the accumulator relay returns
+# and the loop grows past the oracle's count, so the SAME verdict must fail.
+# A gate that cannot fail is not a gate.
+compile "$tmp/walk.skip.s" CCC_PEEPHOLE_SKIP=load_lea_inplace
+if out=$(verdict "$tmp/walk.skip.s"); then
+    echo "SELF-TEST FAIL: the gate still passes with the lea-inplace fold disabled:" >&2
+    printf '%s\n' "$out" >&2
+    exit 1
+fi
+echo "self-test: fold disabled => gate fails, as required"
diff --git a/tests/regression/seg_gs_address_of_percpu.c b/tests/regression/seg_gs_address_of_percpu.c
new file mode 100644
index 00000000..d488070c
--- /dev/null
+++ b/tests/regression/seg_gs_address_of_percpu.c
@@ -0,0 +1,127 @@
+/* `&obj` carries the object's named address space (__seg_gs / kernel __percpu).
+ *
+ * WHY THIS TEST EXISTS
+ * --------------------
+ * A Linux per-CPU object is declared in the GS segment:
+ *
+ *     static DEFINE_PER_CPU(struct tasklet_head, tasklet_vec);
+ *     -> static __seg_gs __attribute__((section(".data..percpu")))
+ *            __typeof__(struct tasklet_head) tasklet_vec;
+ *
+ * and handed to a function whose parameter is __percpu-qualified:
+ *
+ *     __tasklet_schedule_common(t, &tasklet_vec, TASKLET_SOFTIRQ);
+ *     static void __tasklet_schedule_common(struct tasklet_struct *t,
+ *                                           struct tasklet_head __percpu *headp, ...)
+ *
+ * `&tasklet_vec` must therefore have type `__seg_gs struct tasklet_head *`, or
+ * the call is rejected with "have 'struct tasklet_head *' but expected
+ * '__seg_gs struct tasklet_head *'" and kernel/softirq.c does not compile
+ * (the diagnostic pointed at kernel/softirq.c:671/677 in the 6.18.55 build).
+ *
+ * The same rule reaches through members and subscripts, and it must NOT be
+ * over-applied: GCC reads `__seg_gs` as a type QUALIFIER, so in a pointer
+ * declaration the space belongs to the POINTEE while the object keeps default
+ * storage. Measured with gcc 14.2 for `static __seg_gs T *p;`:
+ * `T **b = &p;` is REJECTED ("&p" has type `__seg_gs T **`) and
+ * `T __seg_gs **c = &p;` is ACCEPTED. The same shape occurs in
+ * include/linux/percpu-refcount.h: `__ref_is_percpu(ref, &percpu_count)` where
+ * percpu_count is `ulong __percpu *`; applying the declaration space to the
+ * object unconditionally double-qualifies it there and breaks asm-offsets.s.
+ *
+ * Nothing here dereferences a segment pointer: %gs is not set up in this test
+ * process, so only the types and the addresses are exercised.
+ */
+
+extern int printf(const char *, ...);
+
+#define __percpu __seg_gs
+
+typedef unsigned long ulong;
+
+struct tasklet_head {
+    void *head;
+    void *tail;
+};
+
+/* File-scope per-CPU object, exactly the DEFINE_PER_CPU expansion shape. */
+static __seg_gs __attribute__((section(".data..percpu")))
+__typeof__(struct tasklet_head) tasklet_vec;
+static __seg_gs __typeof__(struct tasklet_head) tasklet_hi_vec;
+
+/* A default-space object of the same type, for contrast. */
+static struct tasklet_head plain_vec;
+
+/* The kernel's parameter shape: an __percpu-qualified pointer. Addresses are
+ * kept as integers: a cast from a segment pointer to a generic `void *` is a
+ * warning in GCC ("disjoint address space"), and the property under test is
+ * the type of the argument, not a comparison of unlike pointers. */
+static ulong seen[4];
+static int nseen;
+
+static void schedule_common(void *t, struct tasklet_head __percpu *headp)
+{
+    if (nseen < 4)
+        seen[nseen++] = (ulong)headp;
+    (void)t;
+}
+
+/* `&percpu_obj->member` must also be accepted (member lives in the segment). */
+static ulong tail_of(struct tasklet_head __percpu *headp)
+{
+    return (ulong)&headp->tail;
+}
+
+/* Pointer declarator: the space qualifies the POINTEE, so the object `p`
+ * itself has default storage and `&p` reaches a `__percpu **` parameter. */
+static int is_percpu_ref(ulong __percpu **percpu_countp)
+{
+    return *percpu_countp == 0;
+}
+
+struct percpu_ref {
+    ulong __percpu *percpu_count;
+};
+
+int main(void)
+{
+    int rc = 0;
+    ulong __percpu *local_count = 0;
+    struct percpu_ref ref;
+    ulong tail;
+
+    ref.percpu_count = 0;
+
+    /* 1. &object of a per-CPU variable, straight into the __percpu parameter. */
+    schedule_common((void *)0, &tasklet_vec);
+    schedule_common((void *)0, &tasklet_hi_vec);
+    if (nseen != 2)
+        rc = 1;
+
+    /* 2. The address survives a member access on a per-CPU object. */
+    tail = tail_of(&tasklet_vec);
+    if (tail != (ulong)&tasklet_vec.tail)
+        rc = 2;
+
+    /* 3. &object really is the object's address, and distinct per object. */
+    if (seen[0] == seen[1])
+        rc = 3;
+    if (seen[0] != (ulong)&tasklet_vec)
+        rc = 4;
+    if ((ulong)&tasklet_vec == (ulong)&plain_vec)
+        rc = 5;
+
+    /* 4. Pointer-declarator absorption (no double __seg_gs). */
+    if (!is_percpu_ref(&local_count))
+        rc = 6;
+    if (!is_percpu_ref(&ref.percpu_count))
+        rc = 7;
+
+    printf("seg-gs: nseen=%d distinct=%d tail_ok=%d refs_ok=%d rc=%d\n",
+           nseen,
+           (int)(seen[0] != seen[1]),
+           (int)(tail == (ulong)&tasklet_vec.tail),
+           (int)(is_percpu_ref(&local_count) && is_percpu_ref(&ref.percpu_count)),
+           rc);
+    return rc;
+}
diff --git a/tests/regression/seg_gs_const_offset_fold.c b/tests/regression/seg_gs_const_offset_fold.c
new file mode 100644
index 00000000..117cc7be
--- /dev/null
+++ b/tests/regression/seg_gs_const_offset_fold.c
@@ -0,0 +1,114 @@
+/* Kernel-style per-CPU access through the GS segment, end to end.
+ *
+ * WHY THIS TEST EXISTS
+ * --------------------
+ * Linux accesses per-CPU data as `%gs:offset`, where the offset is a
+ * *computed* base (per_cpu_ptr's result) plus a constant struct displacement:
+ *
+ *     this_cpu_read(x)            -> %gs:x(%rip)
+ *     per_cpu_ptr(&pcp, cpu)->f   -> GEP(per_cpu_ptr(...), +off) then load
+ *
+ * The second shape used to materialise `base + off` into a scratch register
+ * first (`leaq 8(%rax), %rcx ; movq %gs:(%rcx), %rax`) where GCC and Clang fold
+ * the displacement into the memory operand (`movq %gs:8(%rax), %rax`). The
+ * codegen fold is gated by check_seg_const_offset_fold.sh; THIS test is the
+ * behavioural half: it installs a real GS base with arch_prctl(ARCH_SET_GS)
+ * and reads/writes through `struct S __seg_gs *` offsets, so a wrong
+ * displacement (a fold that fires with a stale or wrong offset) cannot pass.
+ *
+ * Everything is arithmetic on a private 64-byte-aligned buffer, so the program
+ * is deterministic and prints the same lines under lccc, GCC and Clang.
+ */
+#include <stdio.h>
+#include <stdint.h>
+
+struct S { long a; long b; long c[4]; };
+
+/* The argument is an OFFSET into the GS segment, exactly like per_cpu_ptr(). */
+static long read_b(uintptr_t off) { return ((struct S __seg_gs *)off)->b; }
+static void write_c3(uintptr_t off, long v) { ((struct S __seg_gs *)off)->c[3] = v; }
+static long read_c0(uintptr_t off) { return ((struct S __seg_gs *)off)->c[0]; }
+
+/* Base RETURNED FROM A CALL: the pointer arrives in %rax and the fold must
+ * still happen (`call base_at; movq %gs:8(%rax), %rax`), which is the shape
+ * `per_cpu_ptr()` produces at -O2 when it is not inlined.  This is the half of
+ * the contract the accumulator (no register home, no stack slot) exercises: the
+ * displacement is folded into the operand at the call result, and the address
+ * materialisation disappears. */
+static struct S __seg_gs *base_at(uintptr_t off) { return (struct S __seg_gs *)off; }
+static long read_b_call(uintptr_t off) { return base_at(off)->b; }
+static void write_c3_call(uintptr_t off, long v) { base_at(off)->c[3] = v; }
+
+/* INDEXED per-CPU access (`per_cpu(arr, cpu)[i]`): the address is `base` plus a
+ * scaled index plus a constant, and GCC still folds all of it into the segment
+ * operand (`movq %gs:16(%rax,%rdx,8), %rax`).  The index-scaled GEP is the shape
+ * whose producer may now be dropped in favour of the fold, so it must be
+ * exercised behaviourally as well as textually. */
+static long read_ci(uintptr_t off, long i) { return ((struct S __seg_gs *)off)->c[i]; }
+
+/* Scalar FP member: the load must stay in the SSE domain
+ * (`movsd %gs:8(%rax), %xmm0`); a GPR round trip is both slower and a
+ * different instruction, so the printed bits pin the value end to end. */
+struct F { long a; double d; };
+static double read_d(uintptr_t off) { return ((struct F __seg_gs *)off)->d; }
+
+/* SYS_arch_prctl(ARCH_SET_GS, base), without a libc wrapper. */
+static long set_gs_base(void *base) {
+    register long code __asm__("rdi") = 0x1001; /* ARCH_SET_GS */
+    register void *addr __asm__("rsi") = base;
+    register long nr __asm__("rax") = 158;      /* SYS_arch_prctl */
+    __asm__ volatile("syscall" : "+r"(nr) : "r"(code), "r"(addr) : "rcx", "r11", "memory");
+    return nr;
+}
+
+#define N 8
+static uintptr_t storage[N] __attribute__((aligned(64)));
+
+int main(void) {
+    if (set_gs_base(storage) != 0) {
+        printf("arch_prctl(ARCH_SET_GS) failed\n");
+        return 2;
+    }
+    for (int i = 0; i < N; i++) {
+        storage[i] = 0x1111UL * (unsigned long)(i + 1);
+    }
+
+    /* Layout: a=0, b=8, c[0..3]=16,24,32,40, so a base at `off` addresses byte
+     * off+8 for b and off+16+8*i for c[i].  storage[k] starts at byte 8*k and
+     * initially holds 0x1111*(k+1):
+     *   storage = 1111 2222 3333 4444 5555 6666 7777 8888
+     * Every expectation below is a byte offset resolved against that table, so
+     * a fold that fires with a wrong displacement changes a printed value. */
+    printf("read_b(0)   = %ld\n", read_b(0)); /* 0+8   = 0x2222 */
+    printf("read_b(24)  = %ld\n", read_b(24)); /* 24+8  = 0x5555 */
+    printf("read_c0(8)  = %ld\n", read_c0(8)); /* 8+16  = 0x4444 (base 8!) */
+    write_c3(8, 0x2B2B);                       /* 8+40 = byte 48 = storage[6] */
+    printf("c3 raw      = %ld\n", (long)storage[6]); /* 0x2B2B */
+    printf("read_b(0)   = %ld\n", read_b(0)); /* unchanged: byte 8 */
+
+    /* Same offsets through a call-returned base (byte 8 and byte 32 are still
+     * 0x2222 and 0x5555; the write above hit storage[6]). */
+    printf("call_b(0)   = %ld\n", read_b_call(0));  /* 0+8  = 0x2222 */
+    printf("call_b(24)  = %ld\n", read_b_call(24)); /* 24+8 = 0x5555 */
+    write_c3_call(0, 0x3C3C);                       /* 0+40 = byte 40 = storage[5] */
+    printf("call_c3raw  = %ld\n", (long)storage[5]); /* 0x3C3C */
+    printf("call_b(24)  = %ld\n", read_b_call(24));  /* unchanged: byte 32 */
+
+    /* Indexed: byte off + 16 + 8*i. */
+    printf("read_ci(0,0)= %ld\n", read_ci(0, 0)); /* 16    = storage[2] = 0x3333 */
+    printf("read_ci(0,1)= %ld\n", read_ci(0, 1)); /* 24    = storage[3] = 0x4444 */
+    printf("read_ci(0,3)= %ld\n", read_ci(0, 3)); /* 40    = storage[5] = 0x3C3C */
+    printf("read_ci(8,2)= %ld\n", read_ci(8, 2)); /* 8+32  = storage[5] = 0x3C3C */
+    write_c3_call(8, 0x4D4D);                    /* 8+40 = byte 48 = storage[6] */
+    printf("read_ci(0,3)= %ld\n", read_ci(0, 3)); /* 40 = storage[5], untouched */
+    printf("c6 raw      = %ld\n", (long)storage[6]); /* 0x4D4D */
+
+    /* FP member (d at byte 8, read through the SSE-domain fold).  The bit
+     * patterns are pi and e, so the printed values pin both the loaded bits and
+     * the destination XMM register the value lands in. */
+    storage[1] = 0x400921FB54442D18UL; /* pi   */
+    storage[3] = 0x4005BF0A8B145769UL; /* e    */
+    printf("read_d(0)   = %.17g\n", read_d(0));  /* byte  8 -> storage[1] */
+    printf("read_d(16)  = %.17g\n", read_d(16)); /* byte 24 -> storage[3] */
+    return 0;
+}
diff --git a/tests/regression/seg_gs_percpu_address_of.c b/tests/regression/seg_gs_percpu_address_of.c
new file mode 100644
index 00000000..2e496881
--- /dev/null
+++ b/tests/regression/seg_gs_percpu_address_of.c
@@ -0,0 +1,82 @@
+/* `&obj` must keep the object's named address space (__seg_gs == kernel __percpu).
+ *
+ * WHY THIS TEST EXISTS
+ * --------------------
+ * Linux declares per-CPU objects in the GS segment:
+ *
+ *     DEFINE_PER_CPU(struct tasklet_head, tasklet_vec)
+ * --> static __seg_gs __attribute__((section(".data..percpu")))
+ *         __typeof__(struct tasklet_head) tasklet_vec;
+ *
+ * and passes their address to a `__percpu`-qualified parameter:
+ *
+ *     __tasklet_schedule_common(t, &tasklet_vec, TASKLET_SOFTIRQ);
+ *     static void __tasklet_schedule_common(struct tasklet_struct *t,
+ *                                           struct tasklet_head __percpu *headp, ...)
+ *
+ * before the fix lccc typed `&tasklet_vec` as a plain `struct tasklet_head *`
+ * and rejected the call:
+ *
+ *     error: incompatible pointer type for argument 2 to
+ *     '__tasklet_schedule_common': have 'struct tasklet_head *' but
+ *     expected '__seg_gs struct tasklet_head *'   (kernel/softirq.c, 2 errors)
+ *
+ * The space belongs to the OBJECT's storage, not to its value, so it survives
+ * `&` — and it must NOT be double-applied through a pointer declarator, where
+ * GCC reads `__seg_gs` as a qualifier on the type name (measured with gcc 14.2,
+ * `static __seg_gs T *p;`): `T **b = &p;` is REJECTED, while
+ * `T __seg_gs **c = &p;` is ACCEPTED. Applying the object space there too
+ * produced `have '__seg_gs __seg_gs unsigned long **'` and killed
+ * arch/x86/kernel/asm-offsets.s via include/linux/percpu-refcount.h.
+ *
+ * Everything here is address-taking and type-checking only: the test never
+ * dereferences a segment pointer, so it runs to completion with GS unset.
+ */
+#include <stdio.h>
+
+struct tasklet_head {
+    void *head;
+    void *tail;
+};
+
+/* The kernel's DEFINE_PER_CPU expansion shape, verbatim. */
+static __seg_gs __attribute__((section(".data..percpu")))
+__typeof__(struct tasklet_head) tasklet_vec;
+static __seg_gs __attribute__((section(".data..percpu")))
+__typeof__(struct tasklet_head) tasklet_hi_vec;
+
+/* A pointer object in the segment: the space qualifies the POINTEE here. */
+static __seg_gs struct tasklet_head *tasklet_ptr;
+
+/* Parameters of the two shapes the kernel uses. */
+static int take_percpu(struct tasklet_head __seg_gs *headp)
+{
+    return headp != 0;
+}
+static int take_percpu_ptrptr(struct tasklet_head __seg_gs **pp)
+{
+    return pp != 0;
+}
+
+int main(void)
+{
+    int fails = 0;
+    const char *why = "ok";
+
+    /* &percpu_object into a __percpu-qualified parameter. */
+    if (!take_percpu(&tasklet_vec)) { fails++; why = "&tasklet_vec rejected or null"; }
+    if (!take_percpu(&tasklet_hi_vec)) { fails++; why = "&tasklet_hi_vec rejected or null"; }
+    /* Through a member access, and through the __typeof__ form. */
+    if (!take_percpu(&tasklet_vec.tail ? &tasklet_hi_vec : &tasklet_vec)) {
+        fails++;
+        why = "member-derived segment address rejected";
+    }
+    /* Distinct objects stay distinct after the space is attached. */
+    if (&tasklet_vec == &tasklet_hi_vec) { fails++; why = "distinct per-CPU objects compared equal"; }
+
+    /* Pointer declarator: &p is a __seg_gs T ** (NOT double-qualified). */
+    if (!take_percpu_ptrptr(&tasklet_ptr)) { fails++; why = "&tasklet_ptr rejected"; }
+
+    printf("seg_gs: fails=%d (%s)\n", fails, why);
+    return fails != 0;
+}
