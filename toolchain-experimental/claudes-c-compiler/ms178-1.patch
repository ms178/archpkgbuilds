+                      // the position of "{" and the "inner" one records the
+                      // position of "1" (the first element of the sub-
+                      // aggregate of type "int[3]").
+  S y = { { 1, { 2 }, 3 } };
+                      // Two ck_aggregate entries: The "outer" one records
+                      // the position of the first "{" and the "inner" one
+                      // records the position of the second "{".  Note that
+                      // the innermost braces (in "{ 2 }") are superfluous
+                      // and do not represent an aggregate initializer: Their
+                      // position is not recorded.
