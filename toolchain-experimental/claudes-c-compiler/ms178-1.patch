+    use super::*;
+
+    #[test]
+    fn string_forms_agree_with_the_numeric_constants() {
+        assert_eq!(GCC_MAJOR_STR.parse::<u32>().unwrap(), GCC_MAJOR);
+        assert_eq!(GCC_MINOR_STR.parse::<u32>().unwrap(), GCC_MINOR);
+        assert_eq!(GCC_PATCHLEVEL_STR.parse::<u32>().unwrap(), GCC_PATCHLEVEL);
+        assert_eq!(VERSION_QUOTED, format!("\"{GCC_VERSION}\""));
+        assert_eq!(GCC_DUMPVERSION, GCC_MAJOR_STR);
+    }
+}
