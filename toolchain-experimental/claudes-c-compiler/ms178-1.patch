+        assert_eq!(eh[17], 7);
+        assert_eq!(eh[18], 0x9b);
+        assert_eq!(eh[23], 0x1b, "LSDA encoding");
+        assert_eq!(eh[24], 0x1b, "FDE encoding");
+    }
