--- /dev/null
+++ b/tests/regression/check_quoted_include_search.py
@@ -0,0 +1,120 @@
+#!/usr/bin/env python3
+"""Quoted `#include` search order must match GCC.
+
+C11 6.10.2p3: a quoted include is searched "in the directory of the file
+containing the directive" first, then the `-iquote` paths, then `-I`, ... .
+An extra fallback to the *main source file's* directory used to sit in
+`resolve_include_path_uncached`.  It is a correctness hazard rather than a
+convenience: given
+
+    sub/t.c        #include "deep/b.h"
+    sub/deep/b.h   #include "a.h"
+    sub/a.h        <-- only exists here
+
+GCC reports `a.h: No such file or directory` (correct: `sub/deep/` is the
+directory of the including file), while lccc reached out of `sub/deep/` into
+`sub/` and silently compiled against a *different* header than GCC would.  A
+build that succeeds against the wrong header is the worst possible outcome, so
+this is a gate rather than a note.
+
+The test also pins the legitimate behaviour that made the removal safe: an
+include issued from the main file still finds headers beside that file.
+"""
+
+from __future__ import annotations
+
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+
+ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+
+def write(path: str, text: str) -> None:
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(path, "w") as fh:
+        fh.write(text)
+
+
+def run(compiler: str, args: list[str]) -> subprocess.CompletedProcess:
+    return subprocess.run([compiler, *args], capture_output=True, text=True)
+
+
+def main() -> int:
+    lccc = os.path.join(ROOT, "target/fastbuild/lccc")
+    if not os.path.exists(lccc):
+        print(f"lccc not found at {lccc}", file=sys.stderr)
+        return 2
+    oracle = os.environ.get("GCC", "gcc-16")
+    have_oracle = run(oracle, ["-dumpfullversion"]).returncode == 0
+    if have_oracle:
+        v = run(oracle, ["-dumpfullversion"]).stdout.strip()
+        have_oracle = v.startswith("16.")
+        if not have_oracle:
+            oracle = "gcc"
+
+    failures = 0
+    with tempfile.TemporaryDirectory() as tmp:
+        # --- case 1: the nested include must NOT be found ---------------
+        write(os.path.join(tmp, "sub", "a.h"), "int a_h = 1;\n")
+        write(os.path.join(tmp, "sub", "deep", "b.h"), '#include "a.h"\n')
+        write(os.path.join(tmp, "sub", "t.c"),
+              '#include "deep/b.h"\nint main(void) { return a_h; }\n')
+        t = os.path.join(tmp, "sub", "t.c")
+        r = run(lccc, ["-fsyntax-only", t])
+        if r.returncode == 0:
+            print("FAIL: lccc resolved 'a.h' from the main file's directory "
+                  "(GCC rejects: the search starts in the including file's "
+                  "directory, sub/deep/)", file=sys.stderr)
+            failures += 1
+        elif "a.h" not in r.stderr:
+            print(f"FAIL: rejected for the wrong reason: {r.stderr[:200]}",
+                  file=sys.stderr)
+            failures += 1
+        if have_oracle:
+            ro = run(oracle, ["-fsyntax-only", t])
+            if (ro.returncode == 0) != (r.returncode == 0):
+                print(f"FAIL: verdict differs from the oracle "
+                      f"(lccc {r.returncode}, oracle {ro.returncode})",
+                      file=sys.stderr)
+                failures += 1
+
+        # --- case 2: the include from the main file still works ---------
+        write(os.path.join(tmp, "flat", "h.h"), "int flat_h = 2;\n")
+        write(os.path.join(tmp, "flat", "m.c"),
+              '#include "h.h"\nint main(void) { return flat_h; }\n')
+        r = run(lccc, ["-fsyntax-only", os.path.join(tmp, "flat", "m.c")])
+        if r.returncode != 0:
+            print(f"FAIL: main-file-relative include broke: {r.stderr[:200]}",
+                  file=sys.stderr)
+            failures += 1
+
+        # --- case 3: -iquote still works and is searched after the
+        #             including file's directory ---------------------------
+        write(os.path.join(tmp, "quoted", "q.h"), "int q_h = 3;\n")
+        r = run(lccc, ["-fsyntax-only", "-iquote",
+                       os.path.join(tmp, "quoted"),
+                       os.path.join(tmp, "flat", "m.c")])
+        # flat/m.c still includes "h.h", which lives beside it; -iquote must
+        # not shadow that.  A second TU includes "q.h" only available there.
+        write(os.path.join(tmp, "use_q.c"),
+              '#include "q.h"\nint main(void) { return q_h; }\n')
+        r2 = run(lccc, ["-fsyntax-only", "-iquote",
+                        os.path.join(tmp, "quoted"),
+                        os.path.join(tmp, "use_q.c")])
+        if r.returncode != 0 or r2.returncode != 0:
+            print(f"FAIL: -iquote search broke: {r.stderr[:150]} / "
+                  f"{r2.stderr[:150]}", file=sys.stderr)
+            failures += 1
+
+    if failures:
+        print(f"check_quoted_include_search: FAIL ({failures})", file=sys.stderr)
+        return 1
+    print("check_quoted_include_search: PASS")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
