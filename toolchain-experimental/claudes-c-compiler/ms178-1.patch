+/// Helper to define a function-like macro (used by the C23 `<stdbit.h>`
+/// builtin layer below).
+fn def_fn(macros: &mut MacroTable, name: &str, params: &[&str], body: &str) {
+    macros.define(MacroDef {
+        name: name.to_string(),
+        is_function_like: true,
+        params: params.iter().map(|p| p.to_string()).collect(),
+        is_variadic: false,
+        has_named_variadic: false,
+        body: body.to_string(),
+    });
