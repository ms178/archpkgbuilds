+/// paths preserve their full width and comparison semantics.
+fn reduction_remainder_types_supported(iv_ty: IrType, limit_ty: IrType, signed: bool) -> bool {
+    iv_ty == IrType::I32 && limit_ty == IrType::I32 && signed
+}
