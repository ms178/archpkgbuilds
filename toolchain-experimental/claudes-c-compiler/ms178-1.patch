+            "    movl %eax, 8(%esp)\n",
+            "    call g\n",
+            "    movl 8(%esp), %edx\n",
+            "    movl %edx, (%ecx)\n",
+            "    ret\n",
+            ".cfi_endproc\n",
+            ".size f, .-f\n",
+        )
+        .to_string();
+        let result = peephole_optimize(asm);
+        let stores = result.matches(", 8(%esp)\n").count();
+        assert_eq!(stores, 1, "first store must die, second must survive:\n{result}");
+        assert!(result.contains("movl 8(%esp), %edx"), "{result}");
+    }
