diff --git a/tests/regression/unsigned_affine_loop.c b/tests/regression/unsigned_affine_loop.c
new file mode 100644
index 0000000..f06ddb6
--- /dev/null
+++ b/tests/regression/unsigned_affine_loop.c
@@ -0,0 +1,35 @@
+#include <stdint.h>
+#include <stdio.h>
+__attribute__((noinline)) uint64_t bounded_u64(const unsigned char *p) {
+    uint64_t s = 0;
+    for (uint64_t i = 0; i + 8 <= 4096; i += 8) s += p[i] ^ i;
+    return s;
+}
+__attribute__((noinline)) uint32_t bounded_u32(const unsigned char *p) {
+    uint32_t s = 0;
+    for (uint32_t i = 0; i + 8 <= 4096; i += 8) s += p[i] ^ i;
+    return s;
+}
+__attribute__((noinline)) uint64_t wraps_u64(void) {
+    uint64_t s = 0;
+    for (uint64_t i = UINT64_MAX - 3; i + 8 <= 32; i += 4) s += i;
+    return s;
+}
+__attribute__((noinline)) uint32_t wraps_u32(void) {
+    uint32_t s = 0;
+    for (uint32_t i = UINT32_MAX - 3; i + 8 <= 32; i += 4) s += i;
+    return s;
+}
+int main(void) {
+    unsigned char p[4096]; uint64_t total = 0;
+    for (unsigned sample = 0; sample < 32; ++sample) {
+        for (unsigned i = 0; i < 4096; ++i) p[i] = (unsigned char)(i * 37 + sample * 71);
+        uint64_t ref = 0;
+        for (unsigned i = 0; i < 4096; i += 8) ref += p[i] ^ i;
+        if (bounded_u64(p) != ref || bounded_u32(p) != ref) return 1;
+        total += ref;
+    }
+    if (wraps_u64() != 80 || wraps_u32() != 80) return 2;
+    printf("unsigned-affine %llu\n", (unsigned long long)total);
+    return 0;
+}
diff --git a/tests/regression/unsigned_affine_model.py b/tests/regression/unsigned_affine_model.py
new file mode 100644
index 0000000..e5fb3b6
--- /dev/null
+++ b/tests/regression/unsigned_affine_model.py
@@ -0,0 +1,45 @@
+#!/usr/bin/env python3
+"""Independent modular check of the bounded unsigned exit-test proof.
+
+All 4-bit seeds/addends/bounds/steps and both predicates are enumerated;
+300,000 seeded 8-bit samples supplement them. This is not an exhaustive
+32/64-bit compiler verification. Rust tests check admission/CFG restrictions.
+"""
+import itertools
+import random
+
+
+def check(bits, cases):
+    maximum = (1 << bits) - 1
+    total = admitted = 0
+    for start, addend, bound, step, inclusive in cases:
+        total += 1
+        threshold = bound + int(inclusive) - addend
+        new_bound = bound - addend
+        if step == 0 or not 0 <= threshold <= maximum or not 0 <= new_bound <= maximum:
+            continue
+        if start + addend > maximum or start >= threshold:
+            continue
+        last = start + ((threshold - start + step - 1) // step) * step
+        if last + addend > maximum:
+            continue
+        admitted += 1
+        value = start
+        for _ in range(maximum + 2):
+            wrapped = (value + addend) & maximum
+            original = wrapped <= bound if inclusive else wrapped < bound
+            rewritten = value <= new_bound if inclusive else value < new_bound
+            assert original == rewritten, (bits, start, addend, bound, step, inclusive, value)
+            if not original:
+                break
+            value = (value + step) & maximum
+        else:
+            raise AssertionError('proof admitted a nonterminating loop')
+    assert admitted > 0
+    print(f'unsigned affine model: {bits}-bit {total} cases, {admitted} admitted; every observed condition identical')
+
+
+if __name__ == '__main__':
+    check(4, (args + (le,) for args in itertools.product(range(16), repeat=4) for le in (False, True)))
+    rng = random.Random(824)
+    check(8, (tuple(rng.randrange(256) for _ in range(4)) + (bool(rng.randrange(2)),) for _ in range(300000)))
