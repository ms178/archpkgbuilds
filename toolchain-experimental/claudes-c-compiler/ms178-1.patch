diff --git a/tests/regression/switch_lut_two_val_modulo.c b/tests/regression/switch_lut_two_val_modulo.c
new file mode 100644
index 000000000..f766115f7
--- /dev/null
+++ b/tests/regression/switch_lut_two_val_modulo.c
@@ -0,0 +1,56 @@
+#include <limits.h>
+#include <stdio.h>
+
+#define NOINLINE __attribute__((noinline))
+
+NOINLINE int i64_low_two_val(long long x) {
+    switch (x) {
+    case LLONG_MIN: return -7;
+    case LLONG_MIN + 2: return 11;
+    case LLONG_MIN + 5: return -7;
+    default: return 23;
+    }
+}
+
+NOINLINE int i64_high_two_val(long long x) {
+    switch (x) {
+    case LLONG_MAX - 5: return -7;
+    case LLONG_MAX - 2: return 11;
+    case LLONG_MAX: return -7;
+    default: return 23;
+    }
+}
+
+NOINLINE int u64_top_membership(unsigned long long x) {
+    switch (x) {
+    case ULLONG_MAX - 2: return 1;
+    case ULLONG_MAX - 1: return 0;
+    case ULLONG_MAX: return 1;
+    default: return 0;
+    }
+}
+
+static unsigned long long h = 1469598103934665603ULL;
+static void mix(int x) {
+    h ^= (unsigned long long)x + 0x9e3779b97f4a7c15ULL + (h << 6) + (h >> 2);
+    h *= 1099511628211ULL;
+}
+
+int main(void) {
+    const long long lows[] = {LLONG_MIN,      LLONG_MIN + 1, LLONG_MIN + 2,
+                              LLONG_MIN + 3,  LLONG_MIN + 5, LLONG_MIN + 6,
+                              LLONG_MIN + 64, 0,             LLONG_MAX};
+    const long long highs[] = {LLONG_MAX - 6,  LLONG_MAX - 5, LLONG_MAX - 2,
+                               LLONG_MAX - 1,  LLONG_MAX,     LLONG_MAX - 64,
+                               LLONG_MIN,      0};
+    const unsigned long long tops[] = {0, 1, 63, 64, ULLONG_MAX - 3,
+                                       ULLONG_MAX - 2, ULLONG_MAX - 1, ULLONG_MAX};
+    for (unsigned i = 0; i < sizeof(lows) / sizeof(lows[0]); ++i)
+        mix(i64_low_two_val(lows[i]));
+    for (unsigned i = 0; i < sizeof(highs) / sizeof(highs[0]); ++i)
+        mix(i64_high_two_val(highs[i]));
+    for (unsigned i = 0; i < sizeof(tops) / sizeof(tops[0]); ++i)
+        mix(u64_top_membership(tops[i]));
+    printf("%016llx\n", h);
+    return h != 0xbdddfb537d009427ULL;
+}
diff --git a/tests/regression/switch_u32_high_jump_table.c b/tests/regression/switch_u32_high_jump_table.c
new file mode 100644
index 000000000..16ed28007
--- /dev/null
+++ b/tests/regression/switch_u32_high_jump_table.c
@@ -0,0 +1,33 @@
+#include <stdint.h>
+
+__attribute__((noinline)) unsigned int high_dense_switch(unsigned int x) {
+    switch (x) {
+        case UINT32_MAX - 3: return 11;
+        case UINT32_MAX - 2: return 13;
+        case UINT32_MAX - 1: return 17;
+        case UINT32_MAX: return 19;
+        default: return 7;
+    }
+}
+
+static unsigned int expected(unsigned int x) {
+    if (x == UINT32_MAX - 3) return 11;
+    if (x == UINT32_MAX - 2) return 13;
+    if (x == UINT32_MAX - 1) return 17;
+    if (x == UINT32_MAX) return 19;
+    return 7;
+}
+
+int main(void) {
+    const uint32_t inputs[] = {
+        0, 1, UINT32_C(0x7fffffff), UINT32_C(0x80000000),
+        UINT32_MAX - 4, UINT32_MAX - 3, UINT32_MAX - 2,
+        UINT32_MAX - 1, UINT32_MAX,
+    };
+    for (unsigned int i = 0; i < sizeof(inputs) / sizeof(inputs[0]); ++i) {
+        if (high_dense_switch(inputs[i]) != expected(inputs[i])) {
+            return (int)i + 1;
+        }
+    }
+    return 0;
+}
diff --git a/tests/regression/vector_scalar_lhs_shift.c b/tests/regression/vector_scalar_lhs_shift.c
new file mode 100644
index 000000000..80722dc9b
--- /dev/null
+++ b/tests/regression/vector_scalar_lhs_shift.c
@@ -0,0 +1,22 @@
+typedef short v8si __attribute__((vector_size(16)));
+
+v8si counts = {0, 1, 2, 3, 4, 5, 6, 7};
+
+int main(void)
+{
+    v8si left = 2 << counts;
+    v8si right = 2 >> counts;
+    __typeof__(2 << counts) typed = left;
+
+    if (sizeof(2 << counts) != sizeof(v8si))
+        return 1;
+    for (int i = 0; i < 8; ++i) {
+        if (left[i] != (short)(2 << counts[i]))
+            return 2;
+        if (right[i] != (short)(2 >> counts[i]))
+            return 3;
+        if (typed[i] != left[i])
+            return 4;
+    }
+    return 0;
+}
