+                let yname = {
+                    let t = trimmed(store, &infos[y], y);
+                    t[..t.len() - 1].to_string() // strip ':'
+                };
+                store.replace(xj, format!("    jmp {}", yname));
+                infos[xj] = classify_line(store.get(xj));
+                for &x in insns.iter().skip(1) {
+                    infos[x].kind = LineKind::Nop;
+                }
+                infos[k].kind = LineKind::Nop;
+                for &x in &y_insns {
+                    infos[x].kind = LineKind::Nop;
+                }
+                changed = true;
+                i += 1;
+            }
+        }
