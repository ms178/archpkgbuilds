diff --git a/engineering/evidence/redteam104/check-native.py b/engineering/evidence/redteam104/check-native.py
new file mode 100644
index 00000000..2e8b7c1c
--- /dev/null
+++ b/engineering/evidence/redteam104/check-native.py
@@ -0,0 +1,15 @@
+import pathlib,subprocess,json,hashlib,sys,re
+R=pathlib.Path('/home/user/.cache/redteam104');repo=pathlib.Path('/home/user/lccc');cc=R/'candidate';expected='bmi2 mask: 8015315070701535232';rows=[]
+compilers={'candidate':str(cc),'prior':'/home/user/.cache/redteam103/candidate','gcc':'/usr/bin/gcc-16','clang':'/usr/bin/clang-23','icx':'/home/user/.cache/redteam94/intel/opt/intel/oneapi/compiler/2026.1/bin/icx'}
+for name,compiler in compilers.items():
+ for opt in ['-O0','-O1','-O2','-O3','-Os']:
+  dest=R/(name+opt);cmd=[compiler,'-std=gnu17',opt,'-march=x86-64-v3','-Werror',str(repo/'tests/regression/bmi2_saturating_mask.c'),'-o',str(dest)];p=subprocess.run(cmd,capture_output=True,text=True,timeout=120);row={'arm':name,'opt':opt,'command':cmd,'exit':p.returncode,'stderr':p.stderr};rows.append(row);assert p.returncode==0 and not p.stderr,row
+  q=subprocess.run([str(dest)],capture_output=True,text=True,timeout=30);row.update(run_exit=q.returncode,stdout=q.stdout,run_stderr=q.stderr,sha256=hashlib.sha256(dest.read_bytes()).hexdigest());assert q.returncode==0 and q.stdout.strip()==expected,row
+  asm=subprocess.check_output(['objdump','-d',str(dest)],text=True);row['bzhi_instructions']=sum(bool(re.search(r'^\s*[0-9a-f]+:\s+(?:[0-9a-f]{2}\s+)+bzhi[lq]?\s', line)) for line in asm.splitlines());print(name,opt,'PASS','bzhi',row['bzhi_instructions'],flush=True)
