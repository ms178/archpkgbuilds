+    if (calls != 1) return 2;
+    calls = 0;
+    if (0 && side(1)) return 3;
+    if (calls != 0) return 4;
+    if (side(0) && 0) return 5;
+    if (calls != 1) return 6;
+    calls = 0;
+    if (!(side(1) || 1)) return 7;
+    if (calls != 1) return 8;
+    if (!p || (p == 0)) return 9;
+    if (-0.0) return 10;
