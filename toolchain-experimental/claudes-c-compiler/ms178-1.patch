diff --git a/tests/regression/call_return_type_function_pointer_shadow.c b/tests/regression/call_return_type_function_pointer_shadow.c
new file mode 100644
index 0000000..a8bd86a
--- /dev/null
+++ b/tests/regression/call_return_type_function_pointer_shadow.c
@@ -0,0 +1,33 @@
+/* Linux timer_migration.c: a callback parameter named `up` shadows the
+ * global void up(struct semaphore *). Its return type, not the global's,
+ * governs value contexts. Exercise boolean and floating ABI return paths. */
+#include <stdio.h>
+
+struct semaphore;
+extern void up(struct semaphore *);
+typedef _Bool (*predicate)(int *);
+typedef double (*transform)(int *);
+static _Bool positive(int *p) { return *p > 0; }
+static double fraction(int *p) { return *p + 0.5; }
+
+__attribute__((noinline)) static int run_bool(predicate up, int *p)
+{
+    return up(p) ? 11 : 22;
+}
+__attribute__((noinline)) static double run_double(transform up, int *p)
+{
+    return up(p) + 1.0;
+}
+__attribute__((noinline)) static int run_local(int *p)
+{
+    predicate up = positive;
+    return (*up)(p) ? 33 : 44;
+}
+int main(void)
+{
+    int p = 2, n = -1;
+    int ok = run_bool(positive, &p) == 11 && run_bool(positive, &n) == 22 &&
+             run_double(fraction, &p) == 3.5 && run_local(&p) == 33;
+    puts(ok ? "shadow returns: ok" : "shadow returns: FAIL");
+    return !ok;
+}
diff --git a/tests/regression/check_boot_offset_isolation.sh b/tests/regression/check_boot_offset_isolation.sh
new file mode 100755
index 0000000..24bcf1c
--- /dev/null
+++ b/tests/regression/check_boot_offset_isolation.sh
@@ -0,0 +1,23 @@
+#!/usr/bin/env bash
+# Setup-size probes must never replace Kbuild's real generated offsets.
+set -euo pipefail
+repo=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
+tmp=$(mktemp -d)
+trap 'rm -rf -- "$tmp"' EXIT
+mkdir -p "$tmp/tree/arch/x86/boot" "$tmp/stage"
+printf '#include "zoffset.h"\n#include "voffset.h"\n' > "$tmp/tree/arch/x86/boot/header.S"
+printf '#define ZO_startup_32 0x9876\n' > "$tmp/tree/arch/x86/boot/zoffset.h"
+printf '#define VO__text 0x7654\n#define VO__end 0x7655\n' > "$tmp/tree/arch/x86/boot/voffset.h"
+cd "$tmp/tree"
+before=$(sha256sum arch/x86/boot/{header.S,zoffset.h,voffset.h})
+# shellcheck source=../../scripts/boot_offsets.sh
+source "$repo/scripts/boot_offsets.sh"
+lccc_boot_stage_header "$tmp/stage"
+[[ $(sha256sum arch/x86/boot/{header.S,zoffset.h,voffset.h}) == "$before" ]]
+cmp arch/x86/boot/header.S "$tmp/stage/header.S"
+grep -q '^#define ZO_efi32_stub_entry ' "$tmp/stage/zoffset.h"
+grep -q '^#define VO__text 0x100000$' "$tmp/stage/voffset.h"
+# Prove quoted include resolution favors the staged offsets, not tree files.
+printf '#include "zoffset.h"\nZO_startup_32\n' > "$tmp/stage/probe.c"
+gcc -E -P -I arch/x86/boot "$tmp/stage/probe.c" | grep -qx '0x1000'
+echo 'PASS: private boot offset staging leaves Kbuild offsets untouched'
