+        doc=self.manifest_for(['mock-mine','mock-ref','-O2','--out-root','OUTROOT','--','fib'])
+        self.assertEqual(sorted(doc['results']),['fib'])
+
+    def test_missing_option_string_is_reported_not_swallowed(self):
