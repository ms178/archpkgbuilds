+        R_386_32 => ("R_386_32", 4),
+        R_386_PC32 => ("R_386_PC32", 4),
+        R_386_PLT32 => ("R_386_PLT32", 4),
+        R_386_GOTOFF => ("R_386_GOTOFF", 4),
+        R_386_GOTPC => ("R_386_GOTPC", 4),
+        R_386_16 => ("R_386_16", 2),
+        R_386_PC16 => ("R_386_PC16", 2),
+        R_386_8 => ("R_386_8", 1),
+        R_386_PC8 => ("R_386_PC8", 1),
+        R_386_SIZE32 => ("R_386_SIZE32", 4),
+        R_386_NONE => return None,
+        _ => return None,
+    })
+}
