+        1 => 1 << 7,                                                // rdi
+        2 => (1 << 7) | (1 << 6),                                   // +rsi
+        3 => (1 << 7) | (1 << 6) | RDX,                             // +rdx
+        4 => (1 << 7) | (1 << 6) | RDX | RCX,                       // +rcx
+        5 => (1 << 7) | (1 << 6) | RDX | RCX | (1 << 8),            // +r8
+        _ => (1 << 7) | (1 << 6) | RDX | RCX | (1 << 8) | (1 << 9), // +r9
+    };
+    let mut reads = if variadic {
+        arg_reads | RAX | mentioned
