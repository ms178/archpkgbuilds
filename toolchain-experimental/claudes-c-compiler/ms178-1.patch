+    // fold -- the failure mode the gate exists to prevent.
+    let out = run(&f(concat!(
+        "    leaq 8(%rdi), %rax\n",
+        "    movq %rax, %rdx\n",
+        "    movzbl %al, %ecx\n",
+        "    movl %ecx, %r8d\n",
