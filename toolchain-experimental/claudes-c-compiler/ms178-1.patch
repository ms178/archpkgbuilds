diff --git a/src/backend/arm/assembler/encoder/neon.rs b/src/backend/arm/assembler/encoder/neon.rs
index 15d84de0..cdeee497 100644
--- a/src/backend/arm/assembler/encoder/neon.rs
+++ b/src/backend/arm/assembler/encoder/neon.rs
@@ -1462,6 +1462,32 @@ pub(crate) fn encode_neon_two_misc(operands: &[Operand], u_bit: u32, opcode: u32
