+                    | Instruction::UnaryOp { dest, ty, .. }
+                    | Instruction::Load { dest, ty, .. }
+                    | Instruction::ParamRef { dest, ty, .. }
+                    | Instruction::Select { dest, ty, .. }
+                    | Instruction::AtomicLoad { dest, ty, .. }
+                    | Instruction::AtomicRmw { dest, ty, .. }
