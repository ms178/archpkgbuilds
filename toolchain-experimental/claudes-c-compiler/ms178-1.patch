+        p = REPO / cand
+        if p.is_file():
+            return str(p)
+    return None
+
+
+def run_lccc(words_path: Path, lccc: str, names: list[str], tmp: Path) -> list[str]:
+    """Assemble the whole list with this crate, one instruction per line."""
+    link = tmp / "aarch64-linux-gnu-ccc"
+    if not link.exists():
+        link.symlink_to(Path(lccc).resolve())
+    src = tmp / "lccc.s"
+    obj = tmp / "lccc.o"
+    binf = tmp / "lccc.bin"
