-            BuiltinPolicy::default(),
-            crate::common::builtin::symbol_inventory(&module),
-        );
-        assert!(
-            may_assume_builtin("memcpy"),
-            "a self-label on a declaration is not a definition"
-        );
-    }
-
-    #[test]
-    fn half_published_policy_is_not_enough() {
-        // The driver spoke, the module has not: a `memset` defined by this TU
-        // would not be in the inventory yet, so the expansion must not fire.
-        let _window = policy_only_for_test(BuiltinPolicy::default());
-        assert!(!may_assume_builtin("memcpy"));
-        assert!(!may_assume_builtin("memset"));
-    }
-
-    #[test]
-    fn half_published_inventory_is_not_enough() {
-        // The mirror image: the symbol set is known, the CLI state is not, so
-        // a `-fno-builtin` on the command line would be invisible.
-        let _window = module_only_for_test(SymbolInventory::default());
-        assert!(!may_assume_builtin("memcpy"));
-        assert!(!may_assume_builtin("memset"));
-    }
-
-    #[test]
-    fn dropping_a_window_restores_the_fail_closed_world() {
-        {
-            let _window =
-                published_policy_for_test(BuiltinPolicy::default(), SymbolInventory::default());
-            assert!(may_assume_builtin("memcpy"));
-        }
-        // The window is gone: the next compilation starts unpublished, and
-        // the predicate says so.  (Asserted here because a window that leaked
-        // its world is exactly how a fail-open bug would survive this suite.)
-        assert!(!may_assume_builtin("memcpy"));
-        assert!(!may_assume_builtin("memset"));
-        assert!(!may_assume_builtin("__memset_chk"));
-    }
-}
