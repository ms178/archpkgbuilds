diff --git a/tests/regression/builtin_dso/lib.c b/tests/regression/builtin_dso/lib.c
new file mode 100644
index 000000000..bd6054fc7
--- /dev/null
+++ b/tests/regression/builtin_dso/lib.c
@@ -0,0 +1,20 @@
+/* A shared library linked by lccc's builtin linker (check_builtin_dso_link.sh).
+   The constructor's atexit() needs crtbeginS.o's __dso_handle and
+   libc_nonshared.a's atexit; getenv() interposes libc's for every module
+   whose lookup scope reaches this library before libc. */
+extern int printf(const char *, ...);
+extern int atexit(void (*)(void));
+
+static void bye(void) { printf("dso atexit\n"); }
+
+__attribute__((constructor)) static void init(void) {
+    printf("dso ctor\n");
+    atexit(bye);
+}
+
+char *getenv(const char *name) {
+    (void)name;
+    return "interposed";
+}
+
+int dso_value(void) { return 42; }
diff --git a/tests/regression/builtin_dso/main.c b/tests/regression/builtin_dso/main.c
new file mode 100644
index 000000000..e522689e4
--- /dev/null
+++ b/tests/regression/builtin_dso/main.c
@@ -0,0 +1,18 @@
+/* Linked as `main.o -L. -ldso -Wl,-rpath,$ORIGIN`: libdso.so must be found
+   through DT_RUNPATH and searched before libc (gcc's -l order). atexit is
+   libc_nonshared.a's (named by the libc.so linker script) in executables
+   too; handlers run in reverse registration order, so this one runs before
+   the one libdso's constructor registered. */
+extern int printf(const char *, ...);
+extern int puts(const char *);
+extern char *getenv(const char *);
+extern int atexit(void (*)(void));
+int dso_value(void);
+
+static void main_bye(void) { puts("main atexit"); }
+
+int main(void) {
+    atexit(main_bye);
+    printf("main %s %d\n", getenv("HOME"), dso_value());
+    return 0;
+}
