+/// `no-`), or `None` for a name lccc does not model.
+#[must_use]
+pub(crate) fn x86_target_option(name: &str) -> Option<&'static X86TargetOption> {
+    X86_TARGET_OPTIONS
+        .binary_search_by(|option| option.name.cmp(name))
+        .ok()
+        .map(|i| &X86_TARGET_OPTIONS[i])
+}
