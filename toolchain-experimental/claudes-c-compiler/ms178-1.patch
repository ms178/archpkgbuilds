From 602f7480a28e00ab50b4ed9144e4f850e96568ed Mon Sep 17 00:00:00 2001
From: ms178 <ms178@users.noreply.github.com>
Date: Fri, 28 Aug 2026 21:11:03 +0000
Subject: [PATCH 2/6] riscv: va_arg for __int128 and full-precision long double
 varargs
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

  * va_arg(ap, __int128) had no arm at all — it fell into the plain
    8-byte scalar path and read half of every 128-bit vararg. New arm:
    16-byte-aligned overflow-area read, 16-byte store to the dest slot
    (the dest is marked i128 by generation's VaArg handling).
  * va_arg(ap, long double) round-tripped through __trunctfdf2 and
    stored only the low 8 bytes: every long-double vararg was silently
    truncated to double precision. The full binary128 value is now
    stored and registered as an f128 source (the same repair aarch64
    received for va-arg-5/va-arg-6; riscv never got the equivalent).
  * both new arms stage the value through t3/t4: the first cut used
    t0/t1, clobbering t1 — the &va_list pointer needed for the
    write-back — and store()ed the advanced pointer over constant data
    (SIGSEGV inside the first vararg read, caught by the gdbstub).

Validation: rvva probe (i128 sum + long double sum through 16-byte
varargs) GCC-exact; va_arg_wide_struct passes on riscv64 (rc=0, was
broken/segfaulting); lib 1273/0/6; ARM and x86 suites unchanged.
---
 src/backend/riscv/codegen/variadic.rs | 44 +++++++++++++++++++++------
 1 file changed, 34 insertions(+), 10 deletions(-)

diff --git a/src/backend/riscv/codegen/variadic.rs b/src/backend/riscv/codegen/variadic.rs
index 2c651e89..e0063c24 100644
--- a/src/backend/riscv/codegen/variadic.rs
+++ b/src/backend/riscv/codegen/variadic.rs
@@ -25,22 +25,46 @@ impl RiscvCodegen {
         // Load the current va_list pointer value (points to next arg)
         self.state.emit("    ld t2, 0(t1)");
 
-        if result_ty.is_long_double() {
-            // F128 (long double): 16 bytes, 16-byte aligned.
+        if crate::backend::generation::is_i128_type(result_ty) {
+            // __int128: 16 bytes, 16-byte aligned in the overflow area.
+            // The value rides t3/t4 — t1 holds the &va_list pointer for the
+            // write-back below, and t2 walks the arg pointer.
             self.state.emit("    addi t2, t2, 15");
             self.state.emit("    andi t2, t2, -16");
-            self.state.emit("    ld a0, 0(t2)");
-            self.state.emit("    ld a1, 8(t2)");
+            self.state.emit("    ld t3, 0(t2)");
+            self.state.emit("    ld t4, 8(t2)");
             self.state.emit("    addi t2, t2, 16");
             self.state.emit("    sd t2, 0(t1)");
-            self.state.emit("    call __trunctfdf2");
-            self.state.emit("    fmv.x.d t0, fa0");
-        } else {
-            // Standard 8-byte arg
-            self.state.emit("    ld t0, 0(t2)");
-            self.state.emit("    addi t2, t2, 8");
+            if let Some(slot) = self.state.get_slot(dest.0) {
+                self.emit_store_to_s0("t3", slot.0, "sd");
+                self.emit_store_to_s0("t4", slot.0 + 8, "sd");
+            }
+            return;
+        }
+        if result_ty.is_long_double() {
+            // F128 (long double): 16 bytes, 16-byte aligned. Store the FULL
+            // binary128 value — a __trunctfdf2 round-trip here silently
+            // truncated every long-double vararg to double precision
+            // (aarch64 fixed the identical defect for va-arg-5/va-arg-6;
+            // riscv never received the equivalent).
+            self.state.emit("    addi t2, t2, 15");
+            self.state.emit("    andi t2, t2, -16");
+            // Value rides t3/t4 (t1 = &va_list must survive the round trip).
+            self.state.emit("    ld t3, 0(t2)");
+            self.state.emit("    ld t4, 8(t2)");
+            self.state.emit("    addi t2, t2, 16");
             self.state.emit("    sd t2, 0(t1)");
+            if let Some(slot) = self.state.get_slot(dest.0) {
+                self.emit_store_to_s0("t3", slot.0, "sd");
+                self.emit_store_to_s0("t4", slot.0 + 8, "sd");
+                self.state.track_f128_self(dest.0);
+            }
+            return;
         }
+        // Standard 8-byte arg
+        self.state.emit("    ld t0, 0(t2)");
+        self.state.emit("    addi t2, t2, 8");
+        self.state.emit("    sd t2, 0(t1)");
         self.store_t0_to(dest);
     }
 
-- 
