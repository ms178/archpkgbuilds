+/* AUD-SILENT-ZERO-1 companion fixture: PORTABLE builtins only.
+ *
+ * The gate next to this file (check_cross_target_intrinsic_trap.sh) compiles
+ * this translation unit for all four targets and the x86-only one for the x86
+ * targets only.  Splitting them is what makes the negative test possible: a
+ * single TU mixing both would be rejected as a whole off x86, and "rejected"
+ * would then also hide a regression that rejects the portable builtins --
+ * `sqrt`/`fabs`/`popcount` must keep lowering on every backend.
+ */
+double portable_sqrt(double x) { return __builtin_sqrt(x); }
+
+double portable_fabs(double x) { return __builtin_fabs(x); }
+
+int portable_popcount(unsigned int x) { return __builtin_popcount(x); }
diff --git a/tests/regression/cross_target_intrinsics/x86_families.c b/tests/regression/cross_target_intrinsics/x86_families.c
new file mode 100644
index 00000000..8e67d879
--- /dev/null
+++ b/tests/regression/cross_target_intrinsics/x86_families.c
@@ -0,0 +1,45 @@
+/* AUD-SILENT-ZERO-1 family sweep: one representative of every x86-only
+ * intrinsic family the frontend accepts, so the gate can assert that the
+ * "not available on <target>" diagnostic fires family by family rather than
+ * only for the AES-NI case that exposed the silent-zero bug.
+ *
+ * Deliberately in this subdirectory: `tests/regression/*.c` is globbed
+ * non-recursively and compiled as a stand-alone program for the HOST target,
+ * and half of these are 256-bit shapes.
+ *
+ * Kept out of the corpus for a second reason: every function here is invalid
+ * on a non-x86 target, which is exactly what the gate wants and exactly what
+ * the corpus (one flag set, host target) cannot express.
+ */
+typedef long long v2di __attribute__((vector_size(16)));
+typedef int v8si __attribute__((vector_size(32)));
+typedef long long v4di __attribute__((vector_size(32)));
+typedef float v8sf __attribute__((vector_size(32)));
+typedef double v4df __attribute__((vector_size(32)));
+
+/* AES-NI, 128-bit: the family that first exposed the silent zero-fill. */
+v2di x86_fam_aesenc(v2di a, v2di b) { return __builtin_ia32_aesenc128(a, b); }
+
+/* Carry-less multiply, 128-bit. */
+v2di x86_fam_pclmul(v2di a, v2di b) { return __builtin_ia32_pclmulqdq128(a, b, 0); }
+
+/* SSE4.2 CRC32. */
+unsigned x86_fam_crc32(unsigned a, unsigned char b) { return __builtin_ia32_crc32qi(a, b); }
+
+/* VAES, 256-bit. */
+v4di x86_fam_vaes256(v4di a, v4di b) { return _mm256_aesenc_epi128(a, b); }
+
+/* VPCLMULQDQ, 256-bit. */
+v4di x86_fam_vpclmul256(v4di a, v4di b) { return _mm256_clmulepi64_epi128(a, b, 0); }
+
+/* AVX float. */
+v8sf x86_fam_addps256(v8sf a, v8sf b) { return _mm256_add_ps(a, b); }
+
+/* AVX double. */
+v4df x86_fam_mulpd256(v4df a, v4df b) { return _mm256_mul_pd(a, b); }
+
+/* AVX2 integer broadcast. */
+v4di x86_fam_broadcast(v2di a) { return _mm256_broadcastsi128_si256(a); }
+
+/* No-operand VEX housekeeping: the op the AArch64 catch-all used to swallow. */
+void x86_fam_zeroupper(void) { _mm256_zeroupper(); }
diff --git a/tests/regression/cross_target_intrinsics/x86_only.c b/tests/regression/cross_target_intrinsics/x86_only.c
new file mode 100644
index 00000000..7ca0d651
--- /dev/null
+++ b/tests/regression/cross_target_intrinsics/x86_only.c
@@ -0,0 +1,22 @@
+/* AUD-SILENT-ZERO-1 fixture, compiled by check_cross_target_intrinsic_trap.sh
+ * (it is not a corpus entry: the gate needs one compilation per target, and
+ * the corpus compiles everything for the host target with one flag set).
+ *
+ * `__builtin_ia32_aesenc128` is an x86-only intrinsic: AArch64 and RISC-V have
+ * no instruction for it, and their backends cannot compute it.  Before the fix
+ * those backends "zeroed dest if present" -- a 16-byte store of zeros, or
+ * NOTHING AT ALL when the destination was register-known -- so an x86
+ * intrinsic compiled for another target silently produced a wrong value with
+ * rc=0 and no diagnostic anywhere in the pipeline.
+ *
+ * The two functions below pin both halves of the contract: the x86-only one
+ * must be unable to hand back a value (trap), and the portable ones must keep
+ * lowering to real instructions (no collateral trapping).
+ */
+typedef long long v2di __attribute__((vector_size(16)));
+
+v2di x86_only_enc(v2di a, v2di b) { return __builtin_ia32_aesenc128(a, b); }
+
+double portable_sqrt(double x) { return __builtin_sqrt(x); }
+
+double portable_fabs(double x) { return __builtin_fabs(x); }
