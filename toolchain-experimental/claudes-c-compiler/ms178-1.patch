+        *records[0].at == 47 && records[0].func() == 23 &&
+        records[0].raw == 0 && mixed.a[0][0] == 1 && mixed.a[1][2] == 6 &&
+        *mixed.p == 53 && *box.a[0] == 59 && box.a[1] == 0 &&
