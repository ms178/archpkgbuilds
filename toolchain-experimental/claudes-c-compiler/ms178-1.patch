+    for (int i = 0; i < n; i++) s += p[i];
+    return s;
+}
+int main(void) {
+    for (int i = 0; i < 65; i++) a[i] = (double)(i + 1);
+    return sum(a, 65) == 2145.0 ? 0 : 1;
+}
