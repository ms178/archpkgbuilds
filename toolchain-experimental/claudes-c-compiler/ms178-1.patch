+        let header_phis = func.blocks[1]
+            .instructions
+            .iter()
+            .filter(|i| matches!(i, Instruction::Phi { .. }))
+            .count();
+        assert_eq!(header_phis, 2, "IV phi + shared pointer phi");
+        assert!(
+            func.blocks[2].instructions.iter().any(|i| matches!(
+                i,
+                Instruction::Copy {
+                    dest,
+                    src: Operand::Value(_)
