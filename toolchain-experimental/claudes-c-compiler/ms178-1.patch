+                "t.c", "-o", "t.o"], cwd=td)
+        if r.returncode != 0:
+            return Result(name, "SKIP", r.stderr.decode()[:150])
+        lccc_ld = os.path.join(os.path.dirname(args.lccc), "lccc-ld")
+        common = ["-shared", "--hash-style=both", "-Bsymbolic", "-soname",
+                  "linux-vdso-test.so.1", "-z", "max-page-size=4096",
