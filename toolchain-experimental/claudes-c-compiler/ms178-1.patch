+/// consumer `start` when nothing needed renaming), or `None` on veto.
+fn rename_product_range(
+    store: &mut LineStore,
+    infos: &mut [LineInfo],
+    start: usize,
+    from: RegId,
+    to: RegId,
+    lv: &FileLiveness,
+) -> Option<usize> {
+    if from == RSP_FAM || to == RSP_FAM {
+        return None;
+    }
+    let len = store.len();
+    let d_bit = 1u16 << from;
+    let t_bit = 1u16 << to;
