diff --git a/tests/regression/path_range_var_minus_one_uintmax.c b/tests/regression/path_range_var_minus_one_uintmax.c
new file mode 100644
index 0000000..296cd66
--- /dev/null
+++ b/tests/regression/path_range_var_minus_one_uintmax.c
@@ -0,0 +1,16 @@
+/* gcc.c-torture/execute/20041114-1.c reduced.
+ * On the false edge of `var <= 0`, signed int var is positive, so
+ * `(unsigned)(var - 1) < UINT_MAX` is necessarily true without invoking signed
+ * overflow. The link_failure edge must be deleted at -O2.
+ */
+#include <limits.h>
+void link_failure(void);
+volatile int v;
+void foo(int var) {
+    if (!(var <= 0 || ((long unsigned)(unsigned)(var - 1) < UINT_MAX)))
+        link_failure();
+}
+int main(void) {
+    foo(v);
+    return 0;
+}
diff --git a/tests/regression/vla_struct_assignment_runtime_memcpy.c b/tests/regression/vla_struct_assignment_runtime_memcpy.c
