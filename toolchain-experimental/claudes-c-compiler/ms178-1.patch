diff --git a/tests/regression/i128_stack_argument.c b/tests/regression/i128_stack_argument.c
new file mode 100644
index 0000000000000000000000000000000000000000..2d110d82b4ff5ca7e5c5e77ac0b096d1fd3deef7
--- /dev/null
+++ b/tests/regression/i128_stack_argument.c
@@ -0,0 +1,17 @@
+/* Regression: a 128-bit argument after six GP arguments is a 16-byte stack arg. */
+#include <stdio.h>
+
+typedef unsigned __int128 u128;
+
+static u128 combine(long a, long b, long c, long d, long e, long f, u128 x) {
+    return x + (u128)(a + b + c + d + e + f);
+}
+
+int main(void) {
+    u128 input = ((u128)1 << 100) + 17;
+    u128 got = combine(1, 2, 3, 4, 5, 6, input);
+    unsigned long high = (unsigned long)(got >> 64);
+    unsigned long low = (unsigned long)got;
+    printf("%lu %lu\n", high, low);
+    return high != ((unsigned long)((u128)1 << 36)) || low != 38;
+}
diff --git a/tests/regression/leaq_sib_address_liveness.c b/tests/regression/leaq_sib_address_liveness.c
new file mode 100644
index 0000000000000000000000000000000000000000..41a60f3f9387047d0e0244fea99663962fb597a6
--- /dev/null
+++ b/tests/regression/leaq_sib_address_liveness.c
@@ -0,0 +1,25 @@
+/* Regression: LEA-to-SIB peephole must retain an address that remains live
+   across a fall-through/join after its first dereference. */
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+
+static uint64_t probe(const uint8_t *base, size_t index, unsigned gate) {
+    const uint8_t *address = base + index;
+    uint64_t value = *address;
+    if (gate & 1u)
+        goto join;
+    value += UINT64_C(0x100);
+join:
+    /* `address` is intentionally read again after the control-flow join. */
+    return value + address[1] + (uint64_t)(gate >> 1);
+}
+
+int main(void) {
+    static const uint8_t bytes[] = { 3, 17, 29, 41, 53, 67, 79, 97 };
+    uint64_t sum = 0;
+    for (unsigned gate = 0; gate < 16; ++gate)
+        sum += probe(bytes, (size_t)(gate & 3u), gate);
+    printf("%llu\n", (unsigned long long)sum);
+    return sum != UINT64_C(3024);
+}
