+            let (changed, out) = run(&format!("    xorl %eax, %eax\n    {test}\n    {set} %al\n"));
+            assert!(changed, "{test}");
+            assert_eq!(out, want, "{test}");
+        }
+    }
+
+    #[test]
+    fn memory_sign_tests_become_loads_and_shifts() {
+        for (head, set, want) in [
+            (
+                "cmpb $0, (%rdi)",
+                "setl",
+                ["movsbl (%rdi), %eax", "shrl $31, %eax"],
+            ),
+            (
+                "cmpl $0, 8(%rdi)",
+                "sets",
+                ["movl 8(%rdi), %eax", "shrl $31, %eax"],
+            ),
