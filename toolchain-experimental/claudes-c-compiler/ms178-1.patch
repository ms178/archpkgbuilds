+
+fn map_offset_proof_limit(iv_ty: IrType, limit: &Operand, op: IrCmpOp, elem_size: u32) -> Operand {
+    map_dynamic_u64_byte_limit(iv_ty, limit, op, elem_size)
+        .map_or_else(|| limit.clone(), |n| Operand::Const(IrConst::I64(n)))
