+    "vpmullw", "vpaddsb", "vpaddsw", "vpaddusb", "vpaddusw",
+    "vpminub", "vpmaxub", "vpminsw", "vpmaxsw", "vpavgb", "vpavgw",
+    "vpmulhw", "vpmulhuw", "vpcmpeqb", "vpcmpeqw", "vpcmpeqd",
