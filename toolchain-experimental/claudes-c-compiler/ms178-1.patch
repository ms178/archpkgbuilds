+/// Optimize two independent dual-layout candidates concurrently when there is
+/// enough work and more than one host thread is available.  The metric inputs
+/// are temporary function fragments, so this does not affect whole-file
+/// peephole ordering or emitted assembly.
+pub(crate) fn peephole_optimize_pair_with_config(
+    first: String,
+    second: String,
+    ra_config: &RaConfig,
+    optimize_for_size: bool,
+) -> (String, String) {
+    const MIN_PARALLEL_BYTES: usize = 8 * 1024;
+    let enough_work = first.len().saturating_add(second.len()) >= MIN_PARALLEL_BYTES;
+    let has_parallelism = std::thread::available_parallelism().is_ok_and(|n| n.get() > 1);
+    if !enough_work || !has_parallelism {
+        return (
+            peephole_optimize_with_config(first, ra_config, optimize_for_size),
+            peephole_optimize_with_config(second, ra_config, optimize_for_size),
+        );
+    }
+
+    std::thread::scope(|scope| {
+        let first_handle =
+            scope.spawn(|| peephole_optimize_with_config(first, ra_config, optimize_for_size));
+        let second_result = peephole_optimize_with_config(second, ra_config, optimize_for_size);
+        let first_result = match first_handle.join() {
+            Ok(result) => result,
+            Err(payload) => std::panic::resume_unwind(payload),
+        };
+        (first_result, second_result)
+    })
+}
