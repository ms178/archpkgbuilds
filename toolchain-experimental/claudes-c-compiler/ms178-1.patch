+                    | IrBinOp::Or | IrBinOp::Xor | IrBinOp::Mul)
+                    && !ty.is_float()
+                    && !ty.is_128bit()
+                    && !matches!(ty, IrType::I8 | IrType::U8 | IrType::I16 | IrType::U16) =>
+            {
