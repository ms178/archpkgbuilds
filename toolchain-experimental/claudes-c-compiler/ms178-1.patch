+    fn machinst_gpr_value(&self, value: u32) -> bool {
+        self.reg_assignments
+            .get(&value)
+            .is_some_and(|reg| reg.0 < 20)
+    }
+
+    fn machinst_all_operands_are_gpr_or_const(
+        &self,
+        inst: &crate::ir::reexports::Instruction,
+    ) -> bool {
+        use crate::backend::liveness::for_each_operand_in_instruction;
+        let mut ok = true;
+        for_each_operand_in_instruction(inst, |operand| {
+            if let crate::ir::reexports::Operand::Value(value) = operand {
+                ok &= self.machinst_gpr_value(value.0);
+            }
+        });
+        ok
+    }
+
+    fn is_safe_machinst_instruction(&self, inst: &crate::ir::reexports::Instruction) -> bool {
+        use crate::ir::reexports::{Instruction, IrBinOp, IrUnaryOp};
+        let gpr_dest = |dest: &Value| self.machinst_gpr_value(dest.0);
+        match inst {
+            Instruction::BinOp { dest, op, ty, .. }
