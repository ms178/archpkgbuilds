diff --git a/tests/regression/alignas_type_layout.c b/tests/regression/alignas_type_layout.c
new file mode 100644
index 000000000..a5ed3b80f
--- /dev/null
+++ b/tests/regression/alignas_type_layout.c
@@ -0,0 +1,54 @@
+/*
+ * `_Alignas(type-name)` on struct members whose alignment the parser cannot
+ * know (typedefs, enums, records built from them), and the strictest-wins
+ * merge of several alignment sources (C11 6.7.5p6). The parser used to guess
+ * (typedef -> pointer size, enum -> 4) and the guess decided the layout:
+ * `struct { char a; _Alignas(uint16_t) char b; }` was 16 bytes, not 4.
+ * Expected values hold for GCC 16.2 and Clang 23.1.3 on x86-64, i686 and
+ * AArch64; every fact is asserted statically and checked at run time.
+ */
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+
+typedef char C;
+typedef uint16_t U16;
+typedef struct { char x[3]; } S3;
+typedef int __attribute__((aligned(16))) I16;
+enum Mix { MA, MB = 1LL << 40 };
+enum __attribute__((packed)) P { PA };
+struct W { char c; enum Mix m; };
+
+struct A1 { char a; _Alignas(C) char b; };
+struct A2 { char a; _Alignas(U16) char b; };
+struct A3 { char a; _Alignas(S3) char b; };
+struct A4 { char a; _Alignas(enum Mix) char b; };
+struct A5 { char a; _Alignas(enum P) char b; };
+struct A6 { char a; _Alignas(struct W) char b; };
+struct A7 { char a; _Alignas(I16) char b; };
+struct A8 { char a; _Alignas(U16) char b __attribute__((aligned(8))); };
+struct A9 { char a; _Alignas(16) char b __attribute__((aligned(4))); };
+
+#define LL_ALIGN _Alignof(unsigned long long)
+#define CHECKS(X)                                                              \
+    X(offsetof(struct A1, b) == 1 && sizeof(struct A1) == 2)                   \
+    X(offsetof(struct A2, b) == 2 && sizeof(struct A2) == 4)                   \
+    X(offsetof(struct A3, b) == 1 && sizeof(struct A3) == 2)                   \
+    X(offsetof(struct A4, b) == LL_ALIGN && sizeof(struct A4) == 2 * LL_ALIGN) \
+    X(offsetof(struct A5, b) == 1 && sizeof(struct A5) == 2)                   \
+    X(_Alignof(struct W) == LL_ALIGN && offsetof(struct A6, b) == LL_ALIGN)    \
+    X(offsetof(struct A7, b) == 16 && sizeof(struct A7) == 32)                 \
+    X(offsetof(struct A8, b) == 8 && sizeof(struct A8) == 16)                  \
+    X(offsetof(struct A9, b) == 16 && sizeof(struct A9) == 32)
+
+#define STATIC_CHECK(cond) _Static_assert(cond, #cond);
+CHECKS(STATIC_CHECK)
+
+int main(void)
+{
+    int fails = 0;
+#define RUNTIME_CHECK(cond) fails += !(cond);
+    CHECKS(RUNTIME_CHECK)
+    puts(fails ? "alignas type layout: FAIL" : "alignas type layout: ok");
+    return fails != 0;
+}
diff --git a/tests/regression/bmi2_bzhi.c b/tests/regression/bmi2_bzhi.c
new file mode 100644
index 000000000..19f065d0f
--- /dev/null
+++ b/tests/regression/bmi2_bzhi.c
@@ -0,0 +1,71 @@
+/* BMI2 BZHI edge cases: `_bzhi_u32`/`_bzhi_u64` read only bits 7:0 of the
+ * index and return the source unchanged from the operand width on.  Every
+ * result is printed so a mismatch names its case.  `vbzhi32`/`vbzhi64` keep
+ * both operands opaque (one `bzhi` each with BMI2); the `const_*` functions
+ * give the simplifier a constant index and the constant folder two constant
+ * operands, so all three evaluation paths are compared with the oracle. */
+#include <immintrin.h>
+#include <stdio.h>
+
+static const unsigned long long values[] = {
+    0x0ULL, 0x1ULL, 0x80000000ULL, 0x80000001ULL, 0xffffffffULL,
+    0x8000000000000000ULL, 0xffffffffffffffffULL, 0x0123456789abcdefULL,
+    0xfedcba9876543210ULL,
+};
+
+static const unsigned long long indices[] = {
+    0, 1, 7, 8, 15, 16, 31, 32, 33, 63, 64, 65, 127, 128, 200, 255, 256, 257,
+    0x1ff, 0x120, 0x13f, 0x140, 0x80000000ULL, 0x100000020ULL,
+    0x8000000000000005ULL, 0xffffffffffffffffULL, 0xffffffffffffff1fULL,
+};
+
+__attribute__((noinline)) unsigned long long vbzhi64(unsigned long long x, unsigned long long n)
+{
+    return _bzhi_u64(x, n);
+}
+
+__attribute__((noinline)) unsigned vbzhi32(unsigned x, unsigned n)
+{
+    return _bzhi_u32(x, n);
+}
+
+/* Index known, source opaque: Bzhi(x, k) simplifies to an `and`, a copy of
+ * x (k >= W after `& 0xFF`) or zero (k == 0). */
+__attribute__((noinline)) unsigned long long const_index64(unsigned long long x)
+{
+    return _bzhi_u64(x, 0) ^ (_bzhi_u64(x, 1) << 1) ^ (_bzhi_u64(x, 40) << 2)
+           ^ (_bzhi_u64(x, 63) << 3) ^ (_bzhi_u64(x, 64) << 4) ^ (_bzhi_u64(x, 256 + 12) << 5)
+           ^ (_bzhi_u64(x, 0xffffffffffffff3fULL) << 6);
+}
+
+__attribute__((noinline)) unsigned const_index32(unsigned x)
+{
+    return _bzhi_u32(x, 0) ^ (_bzhi_u32(x, 1) << 1) ^ (_bzhi_u32(x, 20) << 2)
+           ^ (_bzhi_u32(x, 31) << 3) ^ (_bzhi_u32(x, 32) << 4) ^ (_bzhi_u32(x, 0x11f) << 5)
+           ^ (_bzhi_u32(x, 0xffffff40U) << 6);
+}
+
+/* Both operands constant: folded at compile time. */
+static unsigned long long const_both(void)
+{
+    return _bzhi_u64(0xfedcba9876543210ULL, 36) + _bzhi_u64(0x8000000000000001ULL, 64)
+           + _bzhi_u64(0xffffffffffffffffULL, 0x100) + _bzhi_u32(0x80000001U, 31)
+           + _bzhi_u32(0xffffffffU, 33) + _bzhi_u32(0xdeadbeefU, 0x210);
+}
+
+int main(void)
+{
+    unsigned nv = sizeof values / sizeof values[0];
+    unsigned ni = sizeof indices / sizeof indices[0];
+    for (unsigned i = 0; i < nv; i++) {
+        for (unsigned j = 0; j < ni; j++) {
+            unsigned long long x = values[i], n = indices[j];
+            printf("64 %016llx %016llx %016llx\n", x, n, vbzhi64(x, n));
+            printf("32 %08x %08x %08x\n", (unsigned)x, (unsigned)n, vbzhi32((unsigned)x, (unsigned)n));
+        }
+        printf("k64 %016llx %016llx\n", values[i], const_index64(values[i]));
+        printf("k32 %08x %08x\n", (unsigned)values[i], const_index32((unsigned)values[i]));
+    }
+    printf("both %016llx\n", const_both());
+    return 0;
+}
diff --git a/tests/regression/check_affine_wrapv_differential.py b/tests/regression/check_affine_wrapv_differential.py
new file mode 100755
index 000000000..a27d81d54
--- /dev/null
+++ b/tests/regression/check_affine_wrapv_differential.py
@@ -0,0 +1,142 @@
+#!/usr/bin/env python3
+"""Differential witness for the exit-compare bound folds under -fwrapv.
+
+Generates counted loops `for (T i = S; i + C <op> N; i += K)` whose constants
+sit next to the type boundaries (INT_MIN/INT_MAX, 2^32-1, steps up to 2^30-1)
+and compares every loop's observable trajectory hash with a reference
+compiler at -O0 -fwrapv. Signed loops are filtered to those that terminate
+under wrapping semantics (simulated here) and carry a second test of the same
+IV in the body, so a range certified over a wrapping trajectory changes the
+output. Unsigned loops carry a trip cap.
+
+The run also requires that the folds actually fire (CCC_DEBUG_AFFINE_FOLD),
+so a matcher change that silently stops folding cannot pass vacuously.
+Mutation check (2026-10-16): disabling the three no-wrap range obligations in
+`loop_rotate::loop_exit_threshold` makes seed 3 fail at -O2 and -O3.
+"""
+import argparse
+import os
+import random
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+OPS = {'<': lambda a, b: a < b, '<=': lambda a, b: a <= b,
+       '>': lambda a, b: a > b, '>=': lambda a, b: a >= b}
+SIGNED = [0, 1, 2, 3, 4, 7, 8, 16, 100, 399, (1 << 30) - 1, 1 << 30, (1 << 31) - 1,
+          (1 << 31) - 2, (1 << 31) - 8, (1 << 31) - 100, -(1 << 31), -(1 << 31) + 3, -5, -100]
+UNSIGNED = [0, 1, 2, 7, 100, 1 << 20, 1 << 31, (1 << 32) - 1, (1 << 32) - 2, (1 << 32) - 8,
+            (1 << 31) - 1, 1 << 30]
+
+
+def w32(x):
+    x &= 0xffffffff
+    return x - (1 << 32) if x >= 1 << 31 else x
+
+
+def lit(x):
+    return f'({x})' if x > -(1 << 31) else '(-2147483647-1)'
+
+
+def program(seed, count=150):
+    rng = random.Random(seed)
+    fns, calls = [], []
+    while len(fns) < count:
+        k = len(fns)
+        if rng.random() < 0.6:
+            s, c, n = (w32(rng.choice(SIGNED) + rng.choice([0, 0, 1, -1, 2])) for _ in range(3))
+            op = rng.choice(list(OPS))
+            step = rng.choice([1, 1, 2, 3, 4, (1 << 30) - 1])
+            c2, n2 = (w32(rng.choice(SIGNED) + rng.choice([0, 1, -1])) for _ in range(2))
+            if rng.random() < 0.4:
+                # Crossing family: the controlling sum steps over INT_MAX
+                # within a few iterations while the IV itself climbs close to
+                # INT_MAX, so a small offset in a second test wraps -- the
+                # case the no-wrap certificate exists to refuse.
+                step = rng.choice([(1 << 30) - 1, (1 << 30) - 1, 1 << 29, 1000003])
+                s = rng.randrange(0, 2 if step == (1 << 30) - 1 else 6)
+                n = (1 << 31) - 1 - rng.randrange(0, 8)
+                c = w32(n - s - step * rng.randrange(0, 3) + rng.randrange(-8, 9))
+                op = rng.choice(['<', '<='])
+                c2 = rng.choice([1, 2, 7, 100])
+                n2 = rng.choice([0, 1000, (1 << 31) - 2])
+            if op[0] == '>':
+                step = -step
+            i, trips = s, 0
+            while OPS[op](w32(i + c), n) and trips <= 600:
+                i, trips = w32(i + step), trips + 1
+            if trips > 600:
+                continue
+            head = f"for (int i = {lit(s)}; i + {lit(c)} {op} {lit(n)}; i += {lit(step)})"
+            # A second test of the same IV borrows the controlling range: if
+            # that range is certified over a wrapping trajectory, it folds
+            # wrongly (the #841 `affine_control_proof.c` class).
+            op2 = rng.choice(list(OPS))
+            # Half the loops keep `i` out of the hash, so the IV stays a
+            # plain 32-bit counter instead of being widened for the cast.
+            seen = "(unsigned long long)(long long)i" if k % 2 else "(unsigned long long)++trips"
+            body = (f"h = h * 31 + {seen} + (unsigned)*g; "
+                    f"h += (i + {lit(c2)} {op2} {lit(n2)});")
+        else:
+            s, c, n = ((rng.choice(UNSIGNED) + rng.choice([0, 0, 1, -1, 3])) % (1 << 32)
+                       for _ in range(3))
+            op = rng.choice(['<', '<='])
+            step = rng.choice([1, 2, 3, 7, 1 << 20, 1 << 31])
+            head = f"for (unsigned i = {s}u; (unsigned)(i + {c}u) {op} {n}u; i += {step}u)"
+            body = ("h = h * 31 + i + (unsigned)*g; if (++trips == 600) break;")
+        fns.append(f"__attribute__((noinline)) static unsigned long long t{k}(volatile int *g) "
+                   f"{{ unsigned long long h = 0; int trips = 0; (void)trips; {head} {{ {body} }} "
+                   f"return h; }}")
+        calls.append(f'printf("%d %llu\\n", {k}, t{k}(&g));')
+    return ("#include <stdio.h>\nvolatile int g = 0;\n" + "\n".join(fns) +
+            "\nint main(void) {\n" + "\n".join(calls) + "\nreturn 0;\n}\n")
+
+
+def run(cmd, **kw):
+    return subprocess.run(cmd, capture_output=True, timeout=120, **kw)
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument('--lccc', required=True)
+    ap.add_argument('--cc', default=os.environ.get('GCC_BIN', 'gcc'))
+    ap.add_argument('--seeds', type=int, default=4)
+    ap.add_argument('--min-folds', type=int, default=20)
+    args = ap.parse_args()
+    opts = [['-O1'], ['-O2'], ['-O3', '-march=x86-64-v3']]
+    failures, folds = [], 0
+    with tempfile.TemporaryDirectory(prefix='affine-wrapv-') as tmp:
+        tmp = Path(tmp)
+        for seed in range(1, args.seeds + 1):
+            src = tmp / f'seed{seed}.c'
+            src.write_text(program(seed))
+            ref = tmp / 'ref'
+            p = run([args.cc, '-w', '-O0', '-fwrapv', str(src), '-o', str(ref)])
+            if p.returncode:
+                print(f'FAIL: reference compile seed {seed}: {p.stderr.decode()[-400:]}')
+                return 1
+            expected = run([str(ref)]).stdout
+            for opt in opts:
+                exe = tmp / 'lccc.out'
+                p = run([args.lccc, '-w', '-fwrapv', *opt, str(src), '-o', str(exe)])
+                got = run([str(exe)]).stdout if p.returncode == 0 else None
+                if got != expected:
+                    failures.append((seed, ' '.join(opt), p.stderr.decode()[-200:]))
+            env = dict(os.environ, CCC_DEBUG_AFFINE_FOLD='1')
+            p = run([args.lccc, '-w', '-fwrapv', '-O2', '-c', str(src), '-o', os.devnull], env=env)
+            folds += sum(line.startswith('[AFFOLD]') for line in p.stderr.decode().splitlines())
+    for seed, opt, err in failures:
+        print(f'FAIL: seed {seed} {opt}: trajectory differs from the -O0 -fwrapv reference {err}')
+    if folds < args.min_folds:
+        print(f'FAIL: only {folds} exit-compare folds fired (< {args.min_folds}); the witness is vacuous')
+        return 1
+    if failures:
+        return 1
+    print(f'PASS: affine -fwrapv differential: {args.seeds} seeds x 150 loops x {len(opts)} levels, '
+          f'{folds} folds fired, 0 mismatches')
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
