+            .filter(|i| matches!(i, Instruction::Store { .. }))
+            .collect();
+        assert_eq!(stores.len(), 1);
+    }
+
+    #[test]
+    fn load_between_stores_keeps_both() {
+        let mut f = mkfunc();
+        f.blocks.push(BasicBlock {
+            label: BlockId(0),
+            instructions: vec![
+                Instruction::Alloca {
