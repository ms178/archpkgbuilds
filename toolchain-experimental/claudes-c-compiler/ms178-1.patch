diff --git a/tests/regression/inline_elide_copy_source_write.c b/tests/regression/inline_elide_copy_source_write.c
new file mode 100644
index 000000000..80fcd1e7b
--- /dev/null
+++ b/tests/regression/inline_elide_copy_source_write.c
@@ -0,0 +1,93 @@
+/* A small local copied from memory and then only read may be elided by the
+ * inliner (`elide_readonly_local_memcpys`), but its readers must still see
+ * the bytes the copy took, not whatever the source holds when they run.
+ *
+ *     E e = t[i];        // memcpy %e <- &t[i]: the copy the inliner elides
+ *     t[i].a = 99;       // a write to the SOURCE after the copy
+ *     return e.a;        // must read the copied value
+ *
+ * The elision proved the LOCAL read-only and then re-rooted its loads at the
+ * source, so any write to the source between the copy and a read (a field
+ * store, a store through an aliasing pointer, a loop-carried update) leaked
+ * into the copy. `control` never writes the source and is the positive
+ * control for the elision itself.
+ *
+ * GCC 16.2: "7 1 30 3 11 9".
+ */
+#include <stdio.h>
+
+typedef struct {
+    int a, b;
+} E;
+
+/* Field store to the source after the copy, same block. */
+static inline __attribute__((always_inline)) int field_store(E *t, int i) {
+    E e = t[i];
+    t[i].a = 99;
+    return e.a + e.b;
+}
+
+/* Store through a pointer that aliases the source. */
+static inline __attribute__((always_inline)) int aliased(E *t, int *p) {
+    E e = *t;
+    *p = 50;
+    return e.a;
+}
+
+/* The source is rewritten on every iteration after the copy; the read
+ * happens later in the same iteration and on the exit path. */
+static inline __attribute__((always_inline)) int loop_carried(E *t, int n) {
+    E e = *t;
+    int acc = 0;
+    for (int k = 0; k < n; k++) {
+        t->a = t->a * 2 + k;
+        acc += e.a;
+    }
+    return acc + e.b;
+}
+
+/* By-value parameter: the inliner copies the argument into a local and
+ * elides it; the caller's object is written inside the body. */
+static inline __attribute__((always_inline)) int by_value(E e, E *src) {
+    src->b = 1000;
+    return e.a + e.b;
+}
+
+/* Positive control: no write to the source, the elision must still apply. */
+static inline __attribute__((always_inline)) int control(const E *t) {
+    E e = *t;
+    return e.a + e.b;
+}
+
+/* A conditional read of the copy: the read must still see the snapshot when
+ * the source was rewritten on the other path. */
+static inline __attribute__((always_inline)) int conditional(E *t, int c) {
+    E e = *t;
+    if (c)
+        t->a = 77;
+    return c ? e.a + 8 : e.b;
+}
+
+__attribute__((noinline)) static int run_field_store(E *t, int i) { return field_store(t, i); }
+__attribute__((noinline)) static int run_aliased(E *t, int *p) { return aliased(t, p); }
+__attribute__((noinline)) static int run_loop(E *t, int n) { return loop_carried(t, n); }
+__attribute__((noinline)) static int run_by_value(E *s) { return by_value(*s, s); }
+__attribute__((noinline)) static int run_control(const E *t) { return control(t); }
+__attribute__((noinline)) static int run_conditional(E *t, int c) { return conditional(t, c); }
+
+int main(void) {
+    E t[2] = {{1, 2}, {3, 4}};
+    E u = {1, 9};
+    E v = {9, 3};
+    E w = {5, 6};
+    E x = {1, 2};
+    E y = {1, 9};
+    int r1 = run_field_store(t, 1);  /* 3 + 4 */
+    int r2 = run_aliased(&u, &u.a);  /* 1 */
+    int r3 = run_loop(&v, 3);        /* 9 * 3 + 3 */
+    int r4 = run_by_value(&x);       /* 1 + 2: the copy precedes the write */
+    int r5 = run_control(&w);        /* 11 */
+    int r6 = run_conditional(&y, 1); /* 1 + 8 */
+    printf("%d %d %d %d %d %d\n", r1, r2, r3, r4, r5, r6);
+    return 0;
+}
diff --git a/tests/regression/rotate_highbit_idioms.c b/tests/regression/rotate_highbit_idioms.c
new file mode 100644
index 000000000..8fdb3648d
--- /dev/null
+++ b/tests/regression/rotate_highbit_idioms.c
@@ -0,0 +1,77 @@
+/* Differential (vs GCC) coverage for the rotate / highest-set-bit / guarded
+ * count lowerings:
+ *  - the UB-free masked rotate `(x << (n & (W-1))) | (x >> (-n & (W-1)))`
+ *    (and its mirror), now one rol/ror, at every count incl. 0 and W;
+ *  - `(W-1) - __builtin_clz(x)` (highbit) under an `if (x)` guard, which
+ *    proves the count's operand nonzero: a bare bsr, including a use whose
+ *    flags feed a branch right after the cancelled XOR pair;
+ *  - `x ? __builtin_ctz(x) : W` guards with zero inputs (defined), which
+ *    fold to the zero-defined count.
+ * Zero is never passed to an unguarded builtin (UB in C). */
+#include <stdio.h>
+
+typedef unsigned u32;
+typedef unsigned long long u64;
+
+static u32 rotl32(u32 x, int n) { return (x << (n & 31)) | (x >> (-n & 31)); }
+static u32 rotr32(u32 x, int n) { return (x >> (n & 31)) | (x << (-n & 31)); }
+static u64 rotl64(u64 x, int n) { return (x << (n & 63)) | (x >> (-n & 63)); }
+static u64 rotr64(u64 x, unsigned n) { return (x >> (n & 63)) | (x << ((64 - n) & 63)); }
+static u32 rotl32_unmasked(u32 x, u32 n) { return (x << n) | (x >> (-n & 31)); }
+
+static u32 highbit32(u32 x) { return 31 - __builtin_clz(x); }
+static u32 highbit64(u64 x) { return 63 - __builtin_clzll(x); }
+static u32 tz32(u32 x) { return x ? __builtin_ctz(x) : 32; }
+static u32 lz32(u32 x) { return x ? __builtin_clz(x) : 32; }
+static u64 tz64(u64 x) { return x ? __builtin_ctzll(x) : 64; }
+static u64 lz64(u64 x) { return x ? __builtin_clzll(x) : 64; }
+
+static u64 h = 0x9E3779B97F4A7C15ull;
+static void mix(u64 v) { h = (h ^ v) * 0x100000001B3ull; h ^= h >> 29; }
+
+__attribute__((noinline)) static u32 bucket(u32 x)
+{
+    /* The highbit result feeds a compare-and-branch: the flags after the
+     * cancelled `xor $31` pair must come from a fresh compare. */
+    u32 hb = highbit32(x | 1);
+    if (hb > 20)
+        return hb * 3;
+    if (hb == 0)
+        return 7;
+    return hb + ((x << 8) >> hb);
+}
+
+int main(void)
+{
+    static const u64 in[] = {
+        0, 1, 2, 3, 0x80, 0xFF, 0x8000, 0x10000, 0x7FFFFFFF, 0x80000000,
+        0xFFFFFFFF, 0x100000000ull, 0x8000000000000000ull, 0xFFFFFFFFFFFFFFFFull,
+        0x0123456789ABCDEFull, 0xFEDCBA9876543210ull, 0x00000000DEADBEEFull,
+    };
+    static const int counts[] = {0, 1, 5, 31, 32, 33, 63, 64, 65, 127, -1, -31, -32, -33};
+    volatile int vsel = 0;
+    for (unsigned i = 0; i < sizeof in / sizeof in[0]; i++) {
+        u64 x = in[i] + (u64)vsel;
+        u32 x32 = (u32)x;
+        for (unsigned c = 0; c < sizeof counts / sizeof counts[0]; c++) {
+            int n = counts[c] + vsel;
+            mix(rotl32(x32, n));
+            mix(rotr32(x32, n));
+            mix(rotl64(x, n));
+            mix(rotr64(x, (unsigned)n));
+            if ((u32)n < 32)
+                mix(rotl32_unmasked(x32, (u32)n));
+        }
+        mix(tz32(x32));
+        mix(lz32(x32));
+        mix(tz64(x));
+        mix(lz64(x));
+        mix(bucket(x32));
+        if (x32)
+            mix(highbit32(x32) * 1000 + (__builtin_ctz(x32) >> 1));
+        if (x)
+            mix(highbit64(x) + ((x >> (__builtin_ctzll(x) & 63)) & 0xFF));
+    }
+    printf("%016llx\n", h);
+    return 0;
+}
