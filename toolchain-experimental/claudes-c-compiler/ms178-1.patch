+    These are development bookkeeping ("v10:", "(v13)", "v14 baseline") that
+    carry no meaning to a reader of the final source. The on-disk profile
+    FORMAT tags (`lccc-pgo-v1` and the legacy v3/v4/v5 spellings) are real
+    protocol identifiers and are preserved.
+    """
+    total = 0
+    for f in sorted(root.rglob("*.rs")):
+        if "/target/" in str(f):
+            continue
+        orig = f.read_text()
+        out = []
+        for line in orig.splitlines(keepends=True):
+            if "//" in line and not SKIP_LINE.search(line):
+                new = line
+                for rx, rep in REVISION_PATTERNS:
+                    new = rx.sub(rep, new)
+                if new != line:
+                    total += 1
