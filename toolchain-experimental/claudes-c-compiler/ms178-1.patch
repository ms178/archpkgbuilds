+        for ty in [
+            IrType::I32,
+            IrType::U32,
+            IrType::I64,
+            IrType::U64,
+            IrType::F32,
+            IrType::F64,
+            IrType::F128,
+        ] {
+            assert_eq!(cast_normalization_instruction(ty), None);
+        }
+    }
+
