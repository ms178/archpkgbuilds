+                let r3 = (reg5 >> 3) & 1;
+                let r4 = (reg5 >> 4) & 1;
+                let b3 = mem.base.as_ref()
+                    .map(|b| Self::evex_gp_num(&b.name).map(|n| (n >> 3) & 1).unwrap_or(0))
+                    .unwrap_or(0);
+                let x3 = mem.index.as_ref()
+                    .map(|i| Self::evex_gp_num(&i.name).map(|n| (n >> 3) & 1).unwrap_or(0))
