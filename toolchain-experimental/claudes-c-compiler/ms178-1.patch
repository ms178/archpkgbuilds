@@ -0,0 +1,127 @@
+/* AUD-VABI-1 gate input: 16-byte (and 8-byte) VECTOR arguments and returns
+ * across a compiler boundary.
+ *
+ * The SysV AMD64 psABI classifies the FIRST eightbyte of a vector as SSE and
+ * every further eightbyte as SSEUP -- "the upper half of the same register" --
+ * so `<4 x i32>` travels in ONE %xmm, unlike a `{double, double}` struct whose
+ * two SSE eightbytes take two registers.  lccc classified vectors with the
+ * *struct* rule, which has no SSEUP notion, so:
+ *
+ *   * its caller put the two halves of each argument into a GP pair where gcc's
+ *     callee read %xmm0/%xmm1, and read the result from %rdx:%rax where gcc's
+ *     callee had written %xmm0 -- `lccc main.o + gcc ext.o` printed
+ *     `16 0 65536 0` for an answer of `11 22 33 44`;
+ *   * its callee read %rdi/%rsi/%rdx/%rcx where gcc's caller had passed
+ *     %xmm0/%xmm1, and returned the first argument unchanged.
+ *
+ * Linking a program against system libraries compiled by gcc is the normal
+ * case, so this file is compiled twice -- once as the CALLEE by each compiler
+ * and once as the CALLER by each compiler -- and all four combinations must
+ * print the same numbers.
+ *
+ * The struct-shaped control (`struct two_f64`) is in the file on purpose: it
+ * must KEEP the two-register convention (SSE + SSE, two registers), which is
+ * what makes the vector rule a special case rather than a rewrite.
+ */
+#include <stdio.h>
+
+typedef int v4si __attribute__((vector_size(16)));
+typedef int v2si __attribute__((vector_size(8)));
+typedef long long v2di __attribute__((vector_size(16)));
+typedef double v2df __attribute__((vector_size(16)));
+
+struct two_f64 { double a, b; };
+struct mixed { int n; v4si v; };
+
+#ifdef CALLEE_ONLY
+/* Every shape a boundary can take: vector-only, vector among scalars (so the
+ * GP and SSE register sequences are interleaved), 8-byte and 16-byte vectors,
+ * a struct embedding one, and a vector smuggled through a function pointer. */
+/* Self-test hook for the gate (never compiled into a real run): with
+ * -DVABI_CALLEE_MUTATION the vector callees answer with something that is NOT
+ * the ABI answer, and the gate requires its own comparison to notice.  A gate
+ * that diffs the wrong file passes vacuously -- this gate did exactly that
+ * until review -- so the mutation is what keeps the comparison honest.
+ *
+ * The macro form matters: the mutation must not remove any definition, or the
+ * mutated object fails to link for an unrelated reason and the check would be
+ * measuring the linker instead. */
+#ifdef VABI_CALLEE_MUTATION
+#define VABI_ANSWER(a, b) (b)
+#define VABI_BIAS(n) ((n) + 1)
+#else
+#define VABI_ANSWER(a, b) ((a) + (b))
+#define VABI_BIAS(n) (n)
+#endif
+
+v4si add_v4si(v4si a, v4si b) { return VABI_ANSWER(a, b); }
+
+v4si scale_v4si(v4si a, int k) { return a * VABI_BIAS(k); }
+
+int sum_v4si(int tag, v4si a, int k) { return tag + a[0] + a[1] + a[2] + a[3] + VABI_BIAS(k); }
+
+v4si pick_third(v4si a, v4si b, v4si c) { return VABI_ANSWER(c, b); }
+
+v4si add_three(v4si a, v4si b, v4si c) { return a + b + c + (v4si){VABI_BIAS(0), VABI_BIAS(0), VABI_BIAS(0), VABI_BIAS(0)}; }
+
+v2si add_v2si(v2si a, v2si b) { return VABI_ANSWER(a, b); }
+
+v2di xor_v2di(v2di a, v2di b) { return VABI_ANSWER(a, b); }
+
+v2df add_v2df(v2df a, v2df b) { return VABI_ANSWER(a, b); }
+
+struct two_f64 add_two_f64(struct two_f64 x, struct two_f64 y) {
+    struct two_f64 r;
+    r.a = x.a + y.a;
+    r.b = x.b + y.b;
+    return r;
+}
+
+v4si mixed_apply(struct mixed m, v4si extra) { return m.v * m.n + extra; }
+
+v4si (*pick_impl(int which))(v4si, v4si, v4si) { return which ? pick_third : add_three; }
+
+#else /* caller TU: declarations only */
+/* Caller half: the SAME declarations, no definitions (the gate links this
+ * object against an object built with -DCALLEE_ONLY). */
+v4si add_v4si(v4si a, v4si b);
+v4si scale_v4si(v4si a, int k);
+int sum_v4si(int tag, v4si a, int k);
+v4si pick_third(v4si a, v4si b, v4si c);
+v4si add_three(v4si a, v4si b, v4si c);
+v2si add_v2si(v2si a, v2si b);
+v2di xor_v2di(v2di a, v2di b);
+v2df add_v2df(v2df a, v2df b);
+struct two_f64 add_two_f64(struct two_f64 x, struct two_f64 y);
+v4si mixed_apply(struct mixed m, v4si extra);
+v4si (*pick_impl(int which))(v4si, v4si, v4si);
+
+
+static void show(const char *what, v4si v) {
+    printf("%s: %d %d %d %d\n", what, v[0], v[1], v[2], v[3]);
+}
+
+int main(void) {
+    v4si a = {1, 2, 3, 4}, b = {10, 20, 30, 40}, c = {100, 200, 300, 400};
+    v2si s1 = {7, 8}, s2 = {1, 2};
+    v2di d1 = {0x0102030405060708LL, 0x1112131415161718LL};
+    v2di d2 = {0x00ff00ff00ff00ffLL, 0x0000ffff0000ffffLL};
+    v2df f1 = {1.5, 2.25}, f2 = {0.5, 0.75};
+    struct two_f64 p = {1.5, 2.5}, q = {10.25, 20.5};
+    struct mixed m = {3, {2, 4, 6, 8}};
+    struct two_f64 pr = add_two_f64(p, q);
+
+    show("add", add_v4si(a, b));
+    show("scale", scale_v4si(a, 5));
+    printf("sum: %d\n", sum_v4si(1000, a, 7));
+    show("third", pick_third(a, b, c));
+    show("v2si", (v4si){s1[0] + s2[0], s1[1] + s2[1], 0, 0});
+    show("v2di", (v4si){xor_v2di(d1, d2)[0] & 0x7fffffff, 0, 0, 0});
+    show("v2df", (v4si){(int)add_v2df(f1, f2)[0], (int)add_v2df(f1, f2)[1], 0, 0});
+    printf("two_f64: %.2f %.2f\n", pr.a, pr.b);
+    show("mixed", mixed_apply(m, a));
+    show("fptr", pick_impl(0)(a, b, c));
+    show("fptr2", pick_impl(1)(a, b, c));
+    return 0;
+}
+#endif
diff --git a/tests/regression/vector_abi_boundary/wide.c b/tests/regression/vector_abi_boundary/wide.c
new file mode 100644
index 00000000..6261d4a0
--- /dev/null
+++ b/tests/regression/vector_abi_boundary/wide.c
@@ -0,0 +1,96 @@
+/* AUD-VABI-2 reproducer: 32-byte VECTOR arguments and returns across a
+ * compiler boundary.
+ *
+ * The SysV AMD64 psABI classifies a vector as SSE + one SSEUP per further
+ * eightbyte, so with AVX enabled a 32-byte vector travels in ONE %ymm
+ * ("the upper part of the same register").  lccc has no SSEUP notion and its
+ * struct rule stops at 16 bytes, so a 32-byte vector falls back to the
+ * memory/sret convention instead -- invisible inside an all-lccc program,
+ * fatal the moment a gcc-compiled library takes or returns one:
+ *
+ *   measured at the commit that added this file (see the gate):
+ *     gcc/gcc                      -> r=42 ...        (the reference)
+ *     lccc/lccc                    -> r=42 ...        (self-consistent)
+ *     lccc caller + gcc callee     -> r=0 0 0 ...     (silent garbage)
+ *     gcc caller + lccc callee     -> SIGSEGV
+ *
+ * The 16-byte case of exactly this bug is AUD-VABI-1 (fixed and gated, see the
+ * sibling vector_abi.c); the 32-byte case needs a %ymm carrier the object
+ * format/lowering path does not have yet, so it is tracked, measured and
+ * latched rather than left to be rediscovered by a user.
+ *
+ * The struct-shaped control (`struct big`) is here on purpose: a 32-byte
+ * STRUCT must keep the two-register / memory convention the psABI gives it
+ * (SSE+SSE for `struct { double a,b,c,d; }`'s four eightbytes is not SSEUP),
+ * so a fix for the vector case must not sweep it along.
+ */
+#include <stdio.h>
+
+typedef int v8si __attribute__((vector_size(32)));
+typedef double v4df __attribute__((vector_size(32)));
+
+struct big {
+    double a, b, c, d;
+};
+
+#ifdef CALLEE_ONLY
+v8si add_v8si(v8si a, v8si b) { return a + b; }
+
+v8si splat_v8si(int k) {
+    v8si r;
+    for (int i = 0; i < 8; i++) r[i] = k;
+    return r;
+}
+
+v8si scale_v8si(v8si a, int k) { return a * k; }
+
+int sum_v8si(int tag, v8si a, int k) {
+    int s = tag + k;
+    for (int i = 0; i < 8; i++) s += a[i];
+    return s;
+}
+
+v4df add_v4df(v4df a, v4df b) { return a + b; }
+
+struct big add_big(struct big x, struct big y) {
+    struct big r;
+    r.a = x.a + y.a;
+    r.b = x.b + y.b;
+    r.c = x.c + y.c;
+    r.d = x.d + y.d;
+    return r;
+}
+
+#else /* caller TU: declarations only */
+v8si add_v8si(v8si a, v8si b);
+v8si splat_v8si(int k);
+v8si scale_v8si(v8si a, int k);
+int sum_v8si(int tag, v8si a, int k);
+v4df add_v4df(v4df a, v4df b);
+struct big add_big(struct big x, struct big y);
+
+static void show(const char *what, v8si v) {
+    printf("%s:", what);
+    for (int i = 0; i < 8; i++) printf(" %d", v[i]);
+    printf("\n");
+}
+
+int main(void) {
+    v8si a = splat_v8si(7), b = splat_v8si(35);
+    v4df f1 = {1.5, 2.5, 3.5, 4.5}, f2 = {10.0, 20.0, 30.0, 40.0};
+    struct big x = {1.0, 2.0, 3.0, 4.0}, y = {10.0, 20.0, 30.0, 40.0};
+
+    show("add", add_v8si(a, b));
+    show("scale", scale_v8si(a, 5));
+    printf("sum: %d\n", sum_v8si(1000, a, 7));
+    {
+        v4df fr = add_v4df(f1, f2);
+        printf("v4df: %.2f %.2f %.2f %.2f\n", fr[0], fr[1], fr[2], fr[3]);
+    }
+    {
+        struct big br = add_big(x, y);
+        printf("big: %.2f %.2f %.2f %.2f\n", br.a, br.b, br.c, br.d);
+    }
+    return 0;
+}
+#endif
diff --git a/tests/workloads/gzip-1.14/run.py b/tests/workloads/gzip-1.14/run.py
index 5c6aed33..c6200881 100644
--- a/tests/workloads/gzip-1.14/run.py
+++ b/tests/workloads/gzip-1.14/run.py
@@ -79,6 +79,28 @@ def extractall_takes_filter() -> bool:
         return False
 
 
+def chmod_ignores_a_none_mode() -> bool:
+    """True when ``TarFile.chmod`` tolerates the filter's ``mode=None``.
+
+    PEP 706 shipped the ``filter=`` keyword to 3.12/3.11.4 *and* an early
+    return for ``mode is None`` in ``TarFile.chmod``.  A floor interpreter
+    (docs/getting-started.md: Python 3.9+) can have neither, and one whose
+    distro backported only the keyword -- Debian 12's 3.11.2, measured --
+    raises ``TypeError`` from ``os.chmod(path, None)`` for every DIRECTORY
+    member whose mode the neutralizer cleared.  Probed by calling the unbound
+    method, which never reads ``self`` on any version, so ``None`` is a safe
+    receiver and no version number has to be trusted.
+    """
+    probe = tarfile.TarInfo("probe")
+    probe.type = tarfile.DIRTYPE
+    probe.mode = None
+    try:
+        tarfile.TarFile.chmod(None, probe, os.devnull)
+    except TypeError:
+        return False
+    return True
+
+
 def _neutralize_archive_attrs(m: tarfile.TarInfo) -> tarfile.TarInfo:
     """Metadata half of tarfile's ``data`` filter, for pre-3.12 interpreters.
 
@@ -179,8 +201,20 @@ def extract_untrusted(tf: tarfile.TarFile, dest: Path) -> None:
         # tests/corpus/test_workload_extraction_safety.py, which feeds both
         # helpers the same hostile archives and compares verdicts and the
         # resulting on-disk attributes.
+        guarded = chmod_ignores_a_none_mode()
+        umask = os.umask(0)
+        os.umask(umask)
         for m in tf.getmembers():
             _neutralize_archive_attrs(m)
+            if m.isdir() and m.mode is None and not guarded:
+                # The neutralizer mirrors the data filter, which expresses
+                # "ignore this member's mode" as mode=None; an interpreter
+                # whose chmod predates the PEP 706 guard dies on that for
+                # every directory, so substitute the mode its own unfiltered
+                # extraction ends up with: os.mkdir's default.  The umask can
+                # only CLEAR bits, so the group/other-write clamp this helper
+                # exists for is unaffected.
+                m.mode = 0o777 & ~umask
         tf.extractall(dest)
 
 
