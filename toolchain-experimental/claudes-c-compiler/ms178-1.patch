+        // the same register must be renamed with it.
+        assert_eq!(
+            replace_vec_reg("vaddpd %ymm1, %ymm15, %ymm1", 1, 3),
+            "vaddpd %ymm3, %ymm15, %ymm3"
+        );
+        assert_eq!(
+            replace_vec_reg("vfmadd231pd %zmm2, %zmm1, %zmm2", 2, 5),
+            "vfmadd231pd %zmm5, %zmm1, %zmm5"
