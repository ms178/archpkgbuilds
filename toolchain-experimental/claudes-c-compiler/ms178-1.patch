+#!/usr/bin/env python3
+"""Gate: no peephole walker may treat a directive's *class* as its semantics.
+
+Why this exists
+---------------
+Every flag / liveness / memory walk in the x86 and i686 backends used to open
+with the same line:
+
+    if infos[j].is_nop() || infos[j].kind == LineKind::Directive { step }
+
+which asserts, without argument, that *no assembler directive can matter*.
+Directives that emit data do: in a function body `.byte 0xf5` is `cmc`,
+`.byte 0xb8,...` is `mov $imm32,%eax`, `.p2align 4,0xcc` is a run of `int3`,
+and `.long .L1-.L2` changes what the neighbouring labels mean.  A walker that
+steps over one can move a flag write across a hidden flag read, delete a store
+a hidden instruction reads, narrow a `movsq` across a hidden wide read, or drop
+a callee-saved save whose restore the hidden code expects.
+
+The law has a single home -- `directive_emits_data` (in `peephole_common`, so
+both backends share it) wrapped by `steps_over_line` / `LineInfo::is_steppable`
+per backend.  A new pass that hand-rolls the skip test re-opens the hole, and no
+unit test would notice unless someone thinks to write one; this gate makes the
+omission loud instead.
+
+What it enforces
+----------------
+Any test against `LineKind::Directive` -- `==`, `!=`, or `matches!`, in either
+polarity -- must be *answered* in one of two ways:
+
+  * the same condition consults a classifying predicate (`LAW_HELPERS` below),
+    so the decision is made about the directive's content and not its class; or
+  * the site carries a declared exemption, a `DIRECTIVE-LAW: <reason>` comment on
+    the test line or the line above it, where `<reason>` is one of:
+        selecting    -- the scan hunts for one named directive (`.cfi_startproc`,
+                        `.size`), so it reads directives rather than passing them
+        classifying  -- this IS the law (the definition of steppability)
+        bails        -- a directive ends the window; the pass loses an
+                        optimization rather than crossing opacity
+
+Exemptions are counted and printed, so "PASS" never means "found nothing to
+look at", and an exemption whose reason is not in the vocabulary is itself a
+finding.
+
+Polarity matters and is no longer trusted to a substring list.  The predecessor
+of this gate allowed `!= LineKind::Directive` outright -- which is exactly the
+shape of the bypass it existed to catch, because the *negated* class test is what
+`if !a && kind != Directive { return }` uses to step past every directive in a
+function body.  A whitelist of substrings cannot tell those two apart; a rule
+that every site must answer can.
+
+The `--self-test` mode runs the detector over witness snippets, including the
+bypass this gate used to miss, so the matcher cannot be quietly neutered.
+"""
+
+from __future__ import annotations
+
+import argparse
+import re
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+# Where the line model is walked.  Both backends are in scope: the bug was found
+# by grepping, not by reading one file.
+TARGETS = [
+    ROOT / "src" / "backend" / "x86" / "codegen" / "peephole",
+    ROOT / "src" / "backend" / "i686" / "codegen",
+]
+
+# A test of a line's *class* against the directive variant.  Requiring the
+# `.kind` accessor keeps the classifier's own constructions
+# (`line_info(LineKind::Directive, ts)`) and prose out of the report: this gate is
+# about deciding by class, and a construction decides nothing.
+DIRECTIVE_TEST = re.compile(
+    r"\.kind\s*[!=]=\s*LineKind::Directive"
+    r"|matches!\s*\(\s*[^)]*\.kind\s*,\s*LineKind::Directive"
+)
+
+# A `match kind` arm naming the directive variant.  Its class test sits on the
+# scrutinee line, so it needs its own shape: the arm body must either read the
+# line's text or consult a law helper, or the arm is passing a directive by class.
+ARM_TEST = re.compile(r"^\s*(?:\|\s*)?LineKind::Directive\s*(?:\||=>)")
+
+# A condition that mentions one of these has consulted the law about the
+# directive's content, which is the whole requirement.
+LAW_HELPERS = (
+    "steps_over_line",
+    "directive_emits_data",
+    "is_alignment_directive",
+    "is_debug_marker_directive",
+    "benign_directive",
+    "inert_directive",
+    "is_steppable",
+    "is_barrier",
+    "directive_is_transparent",
+    "opaque_data_directive",
+    "is_debug_location",
+    "inert_dir",
+)
+
+EXEMPTION = re.compile(r"DIRECTIVE-LAW:\s*(selecting|classifying|bails)\b")
+REASONS = ("selecting", "classifying", "bails")
+# An exemption comment that names a reason outside the vocabulary: a typo or an
+# invented excuse must not silence the site it sits on.
+EXEMPTION_ANY = re.compile(r"DIRECTIVE-LAW:\s*([A-Za-z_-]+)")
+
+
+def strip_comments(text: str) -> str:
+    """Blank out comment bodies, keeping line structure and code.
+
+    Prose about the law must not be reported as if it tested by class, and a
+    `//`-only line can never change behaviour -- so the detector reads a file with
+    comments removed while the exemption scan reads the original, where the
+    `DIRECTIVE-LAW:` marker still exists.
+    """
+    out = []
+    for line in text.split("\n"):
+        stripped = line.lstrip()
+        if stripped.startswith("//"):
+            out.append("")
+            continue
+        cut = line.find("//")
+        # `//` inside a string literal is not a comment; the tests in this tree
+        # carry directive text in string literals, so cut only outside quotes.
+        if cut > 0:
+            before = line[:cut]
+            if before.count('"') % 2 == 0:
+                out.append(before)
+                continue
+        out.append(line)
+    return "\n".join(out)
+
+
+def condition_span(lines: list[str], idx: int) -> str:
+    """Text of the condition that line `idx` belongs to, and its body opener.
+
+    Scans up to the enclosing `if`/`while`/`&&` chain and down to the `{`, so a
+    test written across three lines is judged as the single decision it is.
+    """
+    start = idx
+    while start > 0:
+        prev = lines[start - 1].strip()
+        if not prev:
+            break
+        if any(m in lines[start] for m in ("&&", "||")) or prev.endswith(("&&", "||")):
+            start -= 1
+            continue
+        if prev.startswith(("if ", "while ", "for ", "if(")) or prev.endswith("{"):
+            break
+        start -= 1
+    end = idx
+    while end < len(lines) - 1 and "{" not in lines[end]:
+        end += 1
+    return " ".join(l.strip() for l in lines[start : end + 1])
+
+
+def exempt_reason(lines: list[str], idx: int) -> tuple[str | None, str | None]:
+    """(reason, malformed_reason) for the exemption governing line `idx`.
+
+    Only the test line and the line above it are consulted: an exemption has to
+    be *about* the site it excuses, and a comment at the top of a function must
+    not silence everything below it.
+    """
+    probes = [idx]
+    probe = idx - 1
+    # A `//` comment block immediately above the test belongs to it; a blank line
+    # or a statement ends the claim.  Only the last comment line is not enough --
+    # the honest exemptions in this tree are two lines long, and reading one line
+    # would have made the guard reject comments it exists to accept.
+    while probe >= 0 and lines[probe].lstrip().startswith("//"):
+        probes.append(probe)
+        probe -= 1
+    for at in probes:
+        line = lines[at]
+        m = EXEMPTION.search(line)
+        if m:
+            return m.group(1), None
+        m = EXEMPTION_ANY.search(line)
+        if m and m.group(1) not in REASONS:
+            return None, m.group(1)
+    return None, None
+
+
+def if_body(lines: list[str], lineno: int) -> str:
+    """The text inside the `if` at `lineno`, whether it opens there or below.
+
+    A class test and its consequence are routinely written on one line
+    (`if kind == LineKind::Directive { j += 1; continue; }`).  Reading the body
+    from the *next* line then mistakes the following statement (`break;`) for the
+    consequence, so a step-over looks like a conservative bail -- which is how
+    this gate was evaded once.
+    """
+    tail = lines[lineno]
+    brace = tail.find("{")
+    if brace < 0:
+        return "\n".join(lines[lineno + 1 : lineno + 5])
+    return "\n".join([tail[brace + 1 :]] + lines[lineno + 1 : lineno + 5])
+
+
+def scan_text(text: str, rel: str, raw: str | None = None) -> tuple[list[str], int]:
+    """Findings for one file, plus the count of exemptions that covered them.
+
+    `text` is comment-stripped (what the detector judges); `raw` is the file as
+    written, which is where an exemption marker lives.
+    """
+    lines = text.split("\n")
+    marker_lines = (raw if raw is not None else text).split("\n")
+    findings: list[str] = []
+    exemptions = 0
+    for m in DIRECTIVE_TEST.finditer(text):
+        lineno = text.count("\n", 0, m.start())
+        cond = condition_span(lines, lineno)
+        if any(helper in cond for helper in LAW_HELPERS):
+            continue  # the directive's content decides, not its class
+        negated = "!= LineKind::Directive" in " ".join(cond.split()) or re.search(
+            r"!\s*\([^)]*LineKind::Directive", cond
+        )
+        # A *negated* class test is how a walker steps past directives
+        # (`if !a && kind != Directive { return }`), and nothing about the body
+        # makes that safe: the line it lands on was chosen by class.  A positive
+        # test can also be a conservative bail ("a directive ends this window") or
+        # a content decision made one line later, so those are judged on the body
+        # -- but only there, and the leniency is not extended to the negated form.
+        if not negated:
+            # Two lines above, because the idiom in this tree binds the text first
+            # (`let t = infos[n].trimmed(store.get(n)); if kind == Directive { … }`).
+            window = "\n".join(lines[max(0, lineno - 2) : lineno + 9])
+            if any(h in window for h in LAW_HELPERS) or "trimmed(" in window or "store.get(" in window:
+                continue
+            # The *branch body* decides whether anything is crossed: a real exit
+            # (return/break) is conservative and legal, while `continue` in a
+            # scanning loop *is* the step-over.  Judged on the body alone, because a
+            # window that also contains the code above the test would read an
+            # unrelated `continue` as this site stepping past something.
+            branch = if_body(lines, lineno)
+            if re.search(r"\b(return|break)\b", branch) and not re.search(
+                r"\+=\s*1|next_non_nop|\bcontinue\b", branch
+            ):
+                continue  # conservative: a directive ends the window, nothing is crossed
+        reason, malformed = exempt_reason(marker_lines, lineno)
+        if reason:
+            exemptions += 1
+            continue
+        if malformed:
+            findings.append(
+                f"{rel}:{lineno + 1}: exemption reason {malformed!r} is not one of "
+                f"{'/'.join(REASONS)}\n    {lines[lineno].strip()}"
+            )
+            continue
+        findings.append(
+            f"{rel}:{lineno + 1}: steps past (or through) a directive by class without "
+            f"consulting the law or declaring DIRECTIVE-LAW: <{'|'.join(REASONS)}>\n"
+            f"    {marker_lines[lineno].strip()}\n"
+            f"    condition: {' '.join(cond.split())[:160]}"
+        )
+    # `match kind` arms: the class test lives on the scrutinee line, so it is
+    # judged on whether the arm reads the directive at all.
+    for m in ARM_TEST.finditer(text):
+        lineno = text.count("\n", 0, m.start())
+        body = "\n".join(lines[lineno : lineno + 6])
+        if any(h in body for h in LAW_HELPERS) or "trimmed(" in body or "store.get(" in body:
+            continue
+        reason, _ = exempt_reason(marker_lines, lineno)
+        if reason:
+            exemptions += 1
+            continue
+        findings.append(
+            f"{rel}:{lineno + 1}: a Directive match arm neither reads the line's text "
+            f"nor consults the law, so it passes a data directive by class"
+        )
+    return findings, exemptions
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--self-test", action="store_true", help="run the witness corpus and exit")
+    args = ap.parse_args(argv)
+    if args.self_test:
+        return self_test()
+    # The matcher is run before the matcher: a guard whose regex can be dulled is
+    # worse than no guard, because a green run then *means* something it does not.
+    # The witnesses include the bypass this gate used to miss, so an allow-list
+    # "simplification" that re-admits it fails here first.
+    if (rc := self_test()) != 0:
+        print("FAIL: the directive-step guard no longer matches its own witnesses", file=sys.stderr)
+        return rc
+
+    findings: list[str] = []
+    scanned = 0
+    exemptions = 0
+    for base in TARGETS:
+        if not base.is_dir():
+            findings.append(f"{base}: missing -- the gate would silently pass")
+            continue
+        for path in sorted(base.rglob("*.rs")):
+            text = path.read_text(encoding="utf-8")
+            scanned += len(text.split("\n"))
+            found, used = scan_text(
+                strip_comments(text), str(path.relative_to(ROOT)), raw=text
+            )
+            findings.extend(found)
+            exemptions += used
+    if findings:
+        print(
+            "FAIL: a directive can emit data; decide about its content "
+            "(directive_emits_data/steps_over_line) or declare why this site is not "
+            "a step-over\n",
+            file=sys.stderr,
+        )
+        for f in findings:
+            print(f"  {f}", file=sys.stderr)
+        print(
+            f"\n{len(findings)} site(s); see "
+            "src/backend/peephole_common.rs (`inert_directive`) and "
+            "src/backend/x86/codegen/peephole/passes/helpers.rs for the law.",
+            file=sys.stderr,
+        )
+        return 1
+    print(
+        f"PASS: every directive class test in the peephole walkers consults the law or "
+        f"declares its reason ({scanned} lines scanned, {exemptions} declared exemptions)"
+    )
+    return 0
+
+
+# ── witness corpus ────────────────────────────────────────────────────────────
+
+WITNESSES: list[tuple[str, str, bool]] = [
+    (
+        "a compound test whose step-over is written on the condition line",
+        """\
+fn probe(infos: &[LineInfo], j: &mut usize) {
+    let mut j = *j;
+    loop {
+        if j >= infos.len() {
+            break;
+        }
+        if infos[j].kind != LineKind::Label
+            && (infos[j].is_nop() || infos[j].kind == LineKind::Directive) { j += 1; continue; }
+        break;
+    }
+}
+""",
+        True,
+    ),
+    (
+        "the same shape, stepped through the law instead of the class",
+        """\
+fn probe(infos: &[LineInfo], j: &mut usize) {
+    let mut j = *j;
+    loop {
+        if j >= infos.len() {
+            break;
+        }
+        if infos[j].kind != LineKind::Label && infos[j].is_steppable() { j += 1; continue; }
+        break;
+    }
+}
+""",
+        False,
+    ),
+    (
+        "the bypass this gate used to allow: a negated class test that steps past data",
+        """\
+fn next_real(infos: &[LineInfo], len: usize) -> Option<usize> {
+    let mut k = 0;
+    while k < len {
+        if !infos[k].is_nop() && infos[k].kind != LineKind::Directive {
+            return Some(k);
+        }
+        k += 1;
+    }
+    None
+}
+""",
+        True,
+    ),
+    (
+        "the same walk written through the law",
+        """\
+fn next_real(infos: &[LineInfo], len: usize) -> Option<usize> {
+    let mut k = 0;
+    while k < len {
+        if !infos[k].is_steppable() {
+            return Some(k);
+        }
+        k += 1;
+    }
+    None
+}
+""",
+        False,
+    ),
+    (
+        "a positive class test used to step over, from the original bug",
+        """\
+fn walk(infos: &[LineInfo]) {
+    if infos[j].is_nop() || infos[j].kind == LineKind::Directive {
+        j += 1;
+    }
+}
+""",
+        True,
+    ),
+    (
+        "a class test whose condition consults the content law",
+        """\
+fn walk(infos: &[LineInfo], store: &LineStore) {
+    if infos[j].kind == LineKind::Directive && !directive_emits_data(store.get(j)) {
+        j += 1;
+    }
+}
+""",
+        False,
+    ),
+    (
+        "a scan for one named directive, declared as such",
+        """\
+fn find_start(infos: &[LineInfo]) {
+    // DIRECTIVE-LAW: selecting -- this loop reads directives to find
+    // `.cfi_startproc`; it never passes one of them over.
+    if infos[i].is_nop() || infos[i].kind != LineKind::Directive {
+        i += 1;
+    }
+}
+""",
+        False,
+    ),
+    (
+        "a positive class test whose body decides by content, one line later",
+        """\
+fn walk(infos: &[LineInfo], store: &LineStore) {
+    if infos[j].kind == LineKind::Directive {
+        let dl = infos[j].trimmed(store.get(j));
+        if is_alignment_directive(dl) {
+            j += 1;
+        }
+    }
+}
+""",
+        False,
+    ),
+    (
+        "a positive class test that advances by class -- data directives crossed",
+        """\
+fn walk(infos: &[LineInfo]) {
+    if infos[k].kind == LineKind::Directive {
+        k += 1;
+        continue;
+    }
+}
+""",
+        True,
+    ),
+    (
+        "a positive class test that ends the window is conservative, and legal",
+        """\
+fn walk(infos: &[LineInfo]) {
+    if infos[q].kind == LineKind::Directive {
+        break; // a directive may emit data: do not hoist across it
+    }
+}
+""",
+        False,
+    ),
+    (
+        "an invented exemption reason must not silence the site",
+        """\
+fn walk(infos: &[LineInfo]) {
+    // DIRECTIVE-LAW: harmless
+    if infos[j].kind == LineKind::Directive {
+        j += 1;
+    }
+}
+""",
+        True,
+    ),
+    (
+        "an exemption two lines up governs nothing: too far to be about this site",
+        """\
+fn walk(infos: &[LineInfo]) {
+    // DIRECTIVE-LAW: selecting
+    let x = 1;
+    if infos[j].kind == LineKind::Directive {
+        j += 1;
+    }
+}
+""",
+        True,
+    ),
+]
+
+
+def self_test() -> int:
+    checks = 0
+    with tempfile.TemporaryDirectory() as tmp:
+        for i, (label, source, expect_finding) in enumerate(WITNESSES):
+            path = Path(tmp) / f"witness{i}.rs"
+            path.write_text(source, encoding="utf-8")
+            findings, used = scan_text(source, path.name)
+            got = bool(findings)
+            checks += 1
+            if got != expect_finding:
+                verb = "missed" if expect_finding else "flagged"
+                print(f"FAIL: self-test {verb} {label!r}\n{findings}", file=sys.stderr)
+                return 1
+            if not expect_finding and "kind != LineKind::Directive" in source and not used:
+                print(f"FAIL: self-test {label!r} passed without consuming an exemption", file=sys.stderr)
+                return 1
+            checks += 1
+    print(f"peephole directive-step guard: {checks} witness checks passed")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/check_pr_claim_fidelity.py b/scripts/check_pr_claim_fidelity.py
new file mode 100644
index 00000000..09d40915
--- /dev/null
+++ b/scripts/check_pr_claim_fidelity.py
@@ -0,0 +1,282 @@
+#!/usr/bin/env python3
+"""Check that a commit's own words about the tree are true of the tree.
+
+Every round of review on this branch has produced the same class of finding: a
+message (or a PR body, or a report) that says "the ratchet is 151" while the
+gate still assigns 153, or that names `tests/regression/foo.c` after the file was
+moved into a subdirectory.  Neither is a code defect, and both are worse than
+one, because the reader -- a reviewer, a future me, CI -- cannot tell a stale
+sentence from a lying gate.  The fix is not more care in prose, it is a check:
+claims that *can* be verified mechanically must be.
+
+Two claim forms are verified, because those are the two that have actually
+fooled someone here:
+
+1. ``NAME=153`` / ``NAME 153`` for a NAME that is assigned a numeric literal in
+   the tree (a shell ratchet, a python budget, a Rust const).  The claim and the
+   assignment must be the same number.
+2. Any tree-relative path in the prose (``src/...``, ``tests/...``,
+   ``scripts/...``, ``tools/...``, ``docs/...``).  It must exist at the revision
+   the message describes -- which is HEAD, unless ``--at`` says otherwise.
+
+Deliberately *not* verified: counts of passing tests, timings, "measured on
+-m32" claims.  Those are properties of a run, not of the tree; this gate would be
+either a no-op or a lie-generator if it pretended otherwise, and the honest place
+for them is the log file the run leaves behind.
+
+Usage:
+    scripts/check_pr_claim_fidelity.py [--base REF] [--head HEAD] [--self-test]
+"""
+
+from __future__ import annotations
+
+import argparse
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+# A path mention in prose: must start at a known top-level directory and look
+# like a file (extension required -- a bare `src/backend` heading is not a
+# claim that a file exists).
+# The extension is matched as long-as-it-gets and then required to end: a
+# `{1,6}`-style cap silently truncated `scripts/kernel-vm.fragment` to
+# `scripts/kernel-vm.fragme`, which of course does not exist, and the gate
+# reported a true claim as a lie.  A false positive on an honest message is the
+# fastest way for a check like this to be ignored.
+PATH_CLAIM = re.compile(
+    r"(?<![\w./-])"
+    r"((?:src|tests|scripts|tools|docs|\.github)(?:/[\w.\-]+)+\.[A-Za-z0-9]{1,12}(?![A-Za-z0-9]))"
+)
+
+# `IDENT=12`, `IDENT = 12`, or "IDENT 12" where IDENT is upper-snake and the
+# number is not part of a date/version (no dots, not a 4-digit year alone).
+NUM_CLAIM = re.compile(r"\b([A-Z][A-Z0-9_]{3,})\s*[=:]\s*(\d{1,6})\b")
+NUM_CLAIM_LOOSE = re.compile(r"\b([A-Z][A-Z0-9_]{3,})\s+(\d{2,6})\b")
+
+# Where a number is *assigned* in the tree, per language.
+ASSIGNMENTS = (
+    re.compile(r"^[ \t]*([A-Z][A-Z0-9_]{3,})=(\d+)[ \t]*$", re.M),  # shell
+    re.compile(r"^([A-Z][A-Z0-9_]{3,})\s*=\s*(\d+)\s*$", re.M),  # python
+    re.compile(
+        r"const\s+([A-Z][A-Z0-9_]{3,})\s*:\s*(?:usize|u32|u64|i64|usize)\s*=\s*(\d+)",
+        re.M,
+    ),  # rust
+)
+
+# Files worth scanning for assignments: the gates and scripts, where a budget or
+# ratchet lives.  `src/` is included for Rust consts.
+SCAN_GLOBS = ("tests/regression/*.sh", "scripts/*.py", "scripts/*.sh", "src/**/*.rs")
+
+
+def tree_assignments() -> dict[str, list[tuple[str, int]]]:
+    """Every `NAME = number` in the gate/script/source files, with its location."""
+    found: dict[str, list[tuple[str, int]]] = {}
+    for pattern in SCAN_GLOBS:
+        for path in ROOT.glob(pattern):
+            if not path.is_file():
+                continue
+            try:
+                text = path.read_text(encoding="utf-8", errors="replace")
+            except OSError:  # pragma: no cover - unreadable file is not a claim
+                continue
+            for rx in ASSIGNMENTS:
+                for m in rx.finditer(text):
+                    name, value = m.group(1), int(m.group(2))
+                    rel = str(path.relative_to(ROOT))
+                    found.setdefault(name, []).append((rel, value))
+    return found
+
+
+def rev_paths(rev: str) -> set[str]:
+    out = subprocess.run(
+        ["git", "-C", str(ROOT), "ls-tree", "-r", "--name-only", rev],
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    return set(out.stdout.split())
+
+
+def check_message(
+    subject: str, body: str, assigns: dict[str, list[tuple[str, int]]], paths: set[str]
+) -> list[str]:
+    findings: list[str] = []
+    prose = f"{subject}\n{body}"
+    # Strip fenced code blocks and quoted diff lines: a `-` line from a diff is
+    # not a claim about the tree, it is history.
+    prose = re.sub(r"```.*?```", "", prose, flags=re.S)
+    prose = "\n".join(l for l in prose.split("\n") if not l.startswith(("- ", "+ ")))
+
+    for m in PATH_CLAIM.finditer(prose):
+        claimed = m.group(1)
+        if claimed not in paths:
+            findings.append(
+                f"path claim {claimed!r} names no file in the tree at this revision "
+                "(moved, renamed or never written?)"
+            )
+
+    seen: set[tuple[str, int]] = set()
+    for rx in (NUM_CLAIM, NUM_CLAIM_LOOSE):
+        for m in rx.finditer(prose):
+            name, value = m.group(1), int(m.group(2))
+            if (name, value) in seen:
+                continue
+            seen.add((name, value))
+            entries = assigns.get(name)
+            if not entries:
+                continue  # not a tree constant we can judge
+            wanted = {v for _, v in entries}
+            if value not in wanted:
+                where = ", ".join(f"{f}:{n}" for f, n in entries)
+                findings.append(
+                    f"claim {name}={value} contradicts the tree: {name} is "
+                    f"{'/'.join(str(w) for w in sorted(wanted))} in {where}"
+                )
+    return findings
+
+
+def commits(base: str | None, head: str, single: bool = False) -> list[tuple[str, str, str]]:
+    if single:
+        rng_args = ["-1", head]
+    elif base:
+        rng_args = [f"{base}..{head}"]
+    else:
+        # `git log HEAD` would be "every message in the repository": an
+        # unbounded range is not what `--all` means here, and reading it as one
+        # is how this check spent a round accusing 5,517 commits it never looked
+        # at.  `--all` is the reachable-from-head sweep, said out loud.
+        rng_args = [head]
+    out = subprocess.run(
+        ["git", "-C", str(ROOT), "log", "--format=%H\x01%s\x01%b\x02", *rng_args],
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    rows = []
+    for chunk in out.stdout.split("\x02"):
+        chunk = chunk.strip("\n")
+        if not chunk:
+            continue
+        head_sha, rest = chunk.split("\x01", 1)
+        subject, body = rest.split("\n", 1) if "\n" in rest else (rest, "")
+        rows.append((head_sha[:9], subject.strip(), body))
+    return rows
+
+
+# ---------------------------------------------------------------------------
+# self-test: a claim checker that is never shown a lie is not a claim checker.
+# ---------------------------------------------------------------------------
+WITNESSES = [
+    (
+        "a budget that moved out from under the message",
+        "gates: pin the read budget\n\nThe ratchet is ENV_READ_BUDGET=999 for now.\n",
+        True,
+    ),
+    (
+        "the same message, with the number the file actually assigns",
+        "gates: pin the read budget\n\nThe ratchet is ENV_READ_BUDGET=151 for now.\n",
+        False,
+    ),
+    (
+        "a fixture renamed after the message was written",
+        "corpus: add a case\n\nSee tests/regression/i386_regparm_staging_three.c.\n",
+        True,
+    ),
+    (
+        "a path claim that matches the tree",
+        "corpus: add a case\n\nSee tests/regression/run_regression.py.\n",
+        False,
+    ),
+    (
+        "a long extension must not be truncated into a false accusation",
+        "kernel: pin the config\n\n`scripts/kernel-vm.fragment` pins CONFIG_GENERIC_CPU=y.\n",
+        False,
+    ),
+]
+
+
+def self_test() -> int:
+    fixture = "ENV_READ_BUDGET=151\n"
+    assigns = {"ENV_READ_BUDGET": [("tests/regression/check_env_test_hygiene.sh", 151)]}
+    paths = {
+        "tests/regression/run_regression.py",
+        "tests/regression/check_env_test_hygiene.sh",
+        "scripts/kernel-vm.fragment",
+    }
+    checks = 0
+    for label, msg, expect_finding in WITNESSES:
+        checks += 1
+        subject, _, body = msg.partition("\n")
+        got = check_message(subject, body, assigns, paths)
+        if bool(got) != expect_finding:
+            verb = "missed" if expect_finding else "flagged"
+            print(f"FAIL: self-test {verb} {label!r}: {got}", file=sys.stderr)
+            return 1
+    # The fixture above must also be a real file assignment, or the witness is
+    # testing the witness and nothing else.
+    checks += 1
+    if not re.search(ASSIGNMENTS[0], fixture):
+        print("FAIL: self-test fixture no longer parses as a shell assignment", file=sys.stderr)
+        return 1
+    print(f"claim-fidelity guard: {checks} witness checks passed")
+    return 0
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--base", default=None, help="exclusive base revision")
+    ap.add_argument("--head", default="HEAD")
+    ap.add_argument("--self-test", action="store_true")
+    ap.add_argument(
+        "--all",
+        action="store_true",
+        help="also check history: claims are judged against the tree at --head, so "
+        "a message that was true when written and is stale now will be reported",
+    )
+    args = ap.parse_args(argv)
+    # The witness run comes first: a check that silently stopped matching anything
+    # would report "no commits in range" as a pass otherwise.
+    if (rc := self_test()) != 0:
+        return rc
+    if args.self_test:
+        return 0
+
+    base = args.base
+    tip_only = False
+    if base is None and not args.all:
+        # One commit is the unit of accountability: the message being written now.
+        # A range is wrong for that default, because on a merge commit `HEAD~1..HEAD`
+        # walks the *other* side and reports someone else's history.
+        tip_only = True
+    assigns = tree_assignments()
+    paths = rev_paths(args.head)
+    rows = commits(None, args.head, single=tip_only) if tip_only else commits(base, args.head)
+    if not rows:
+        print("claim-fidelity guard: no commits in range (nothing claimed, nothing to check)")
+        return 0
+    findings: list[str] = []
+    for sha, subject, body in rows:
+        for f in check_message(subject, body, assigns, paths):
+            findings.append(f"{sha}: {f}")
+    if findings:
+        print(
+            f"FAIL: {len(findings)} claim(s) in {len(rows)} commit message(s) "
+            "do not hold of the tree:",
+            file=sys.stderr,
+        )
+        for f in findings:
+            print(f"  {f}", file=sys.stderr)
+        return 1
+    scope = "the tip commit" if tip_only else f"{len(rows)} message(s)"
+    print(
+        f"PASS: every verifiable claim in {scope} matches the "
+        f"tree ({len(assigns)} named budgets, {len(paths)} paths known)"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/ci_local.sh b/scripts/ci_local.sh
index 9d085530..ac6a751d 100755
--- a/scripts/ci_local.sh
+++ b/scripts/ci_local.sh
@@ -313,6 +313,44 @@ gate "differential-correctness-oracle" fast \
 gate "loop-alignment-contract" fast \
     python3 scripts/check_loop_alignment.py --lccc "$LCCC"
 
+# The loop-inversion census is #777's tooling, adopted with the latch its
+# original form lacked: as shipped, `main` returned 0 whatever it counted, so a
+# day on which the pass rotated nothing -- a default flipped off, its debug line
+# renamed away from these regexes -- would have printed "0 rotations" and stayed
+# green.  Three arms now, each with an input that reaches it: 2 when no TU yields
+# a parseable record (the census itself is broken, which is a different claim from
+# the optimiser being wrong), 1 when a corpus TU fails to compile (an enumeration
+# that quietly shrinks is the failure mode, not the metric), and 1 when the pass is
+# live but earns nothing.  6 s against the 91-TU corpus.
+# Documented debt, counted rather than forgotten: a 1-3 byte struct that is a
+# subobject of a larger by-value argument is mis-passed under -mregparm on i386
+# (six configurations, six different wrong answers, -m64 clean). The gate latches
+# the count in both directions -- growth is a regression, a drop means the debt is
+# partly repaid and the budget has to be re-measured -- and refuses to call an
+# empty sweep a pass.
+gate "i386-small-struct-abi-debt" fast \
+    bash tests/regression/check_i386_regparm_small_struct_abi.sh
+
+# Same predicate, three consumers (-Wreturn-type, switch fallthrough, statement
+# expression value) and two ways to get it wrong: resolving a call's entity by
+# bare name, and dropping an attribute written on a nested definition.  The faces
+# are the warning count *and* the emitted control flow (lowering starts a dead block
+# after a noreturn call), so rows are asserted absolutely as well as differentially
+# against gcc, and `--self-test` proves the checks with canned transcripts.
+gate "scoped-noreturn-diagnostics" fast \
+    bash tests/regression/check_scoped_noreturn_diagnostics.sh
+
+# i386 register-argument staging, on the emitted assembly plus the cross-compiler
+# boundary: no capture may spoil an ABI source register before its last read, a
+# 12-byte packed argument is never moved 16 bytes at a time, and caller/callee halves
+# from *different* compilers still agree -- the one test that can see a classification
+# both lccc and gcc would otherwise share a mistake in.
+gate "i386-call-staging-asm" fast \
+    bash tests/regression/check_i386_call_staging_asm.sh
+
+gate "loop-invert-census" fast \
+    python3 scripts/loop_invert_census.py --lccc "$LCCC" --quiet
+
 gate "fuzz-harness-tests" fast \
     python3 -m unittest discover -s tests/fuzz -p 'test_*.py'
 
@@ -629,6 +667,39 @@ gate "phi-acyclic-copy-order" fast \
 gate "doc-link-integrity" fast \
     python3 scripts/check_doc_links.py
 
+# The Expat differential is only a differential if both compilers ran the SAME
+# tests under the SAME feature configuration.  `junit_check.py` compares testcase
+# identity multisets and the CMake cache, and this gate runs its compiler-free
+# contract so the rule is enforced even where no Expat build happens.
+gate "expat-junit-contract" fast \
+    python3 tests/workloads/expat-2.8.5/junit_check.py --self-test
+
+# The AArch64 dispatcher ratchet is enforced twice -- by the committed goldens TSV
+# and by an in-crate test that re-encodes every row -- and both enumerate the
+# dispatcher by scanning Rust *text*.  A text scan that finds nothing prints a
+# satisfied count, so the scanner's rules (region end by brace depth, arm heads
+# invisible to comments, literals unable to fake a brace or a quote) are pinned
+# here, toolchain-free, rather than only by the consumer they feed.  The
+# "# arms:" header in the TSV is the latch between this scan and that consumer:
+# if the two disagree about how many arms exist, both gates fail.
+gate "dispatcher-region-contract" fast \
+    python3 -m unittest discover -s tests/aarch64 -p 'test_*.py'
+
+# A peephole walker may step over a `nop`, or over a directive that emits no
+# data -- never over a bare `.byte`, which is machine code no mnemonic table can
+# see.  48 of these skips existed in the two backends; the law now has one home
+# (peephole_common::directive_emits_data) and this gate fails the build when a
+# pass hand-rolls the old `is_nop() || kind == Directive` test again.
+gate "peephole-directive-step" fast \
+    python3 scripts/check_peephole_directive_step.py
+
+# A message that says "the ratchet is 151" while the gate still assigns 153 is
+# not a typo: it is a reader told the limit lives somewhere it does not.  The
+# verifiable half of a commit message -- named budgets, named paths -- is checked
+# against the tree, so prose cannot drift ahead of the gates it describes.
+gate "pr-claim-fidelity" fast \
+    python3 scripts/check_pr_claim_fidelity.py
+
 # Needs PyYAML (python3-yaml on Debian/Ubuntu). This gate is the FIRST
