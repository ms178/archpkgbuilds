diff --git a/tests/regression/check_scoped_noreturn_diagnostics.sh b/tests/regression/check_scoped_noreturn_diagnostics.sh
new file mode 100644
index 00000000..1a55c5d2
--- /dev/null
+++ b/tests/regression/check_scoped_noreturn_diagnostics.sh
@@ -0,0 +1,318 @@
+#!/usr/bin/env bash
+# Scoped-entity noreturn: the diagnostic face of the fallthrough answer.
+#
+# `is_noreturn_call` decides three things at once -- whether a function can fall
+# out of its body (-Wreturn-type), whether a switch segment falls through, and
+# whether a statement expression has a value.  All three read the *entity the call
+# resolves to*, and a GNU nested function is a distinct entity that merely shares a
+# basename with an outer declaration (C11 6.2.1p4).  Resolving by bare name
+# therefore mis-answers every one of them, in both directions; so does an
+# attribute the parser drops on a nested *definition*.
+#
+# Two faces, both asserted here.  Warnings are the fallthrough face, and the
+# expectations are absolute as well as differential:
+#   * `expect 1` rows fail a compiler that lost the warning machinery;
+#   * `expect 0` rows fail one that warns whenever a call ends a body.
+# Where GCC accepts the spelling its answer is the law (measured, not quoted);
+# where it refuses to parse (the trailing-attribute form on a definition), there
+# is no oracle and the row pins our documented superset instead.
+#
+# The second face is emitted control flow: `ir::lowering::expr_calls` starts a
+# dead block after a call to a function in `noreturn_functions`, which is keyed by
+# entity name, so a nested declaration that shares a basename with a noreturn
+# entity can delete live code -- a miscompile, not a missed warning.  The
+# `SHAPES` section at the bottom asserts that on the emitted asm.
+#
+# The fixtures live in tests/regression/scoped_noreturn/ so each row's source is a
+# file a human can compile by hand; they are deliberately *not* run_regression
+# cases, because exit codes cannot see either face.
+set -uo pipefail
+
+ROOT=$(cd "$(dirname "$0")/../.." && pwd)
+LCCC=${CCC:-$ROOT/target/fastbuild/lccc}
+CC=${CC:-gcc}
+TIMEOUT=${TIMEOUT:-60}
+SRC=$ROOT/tests/regression/scoped_noreturn
+WORK=$(mktemp -d)
+trap 'rm -rf "$WORK"' EXIT
+
+# --- self-test ----------------------------------------------------------------
+#
+# Every witness here is a fake compiler with a canned answer, so this half of the
+# gate runs on a host with no build tree and no 32-bit runtime at all -- which is
+# the point: the shape section exists to catch a miscompile that no diagnostic
+# reports, and a check nobody can prove bites is a check nobody can trust.
+if [[ ${1:-} == --self-test ]]; then  # (witnesses invoke us with --run)
+    fake=$WORK/fake
+    mkdir -p "$fake"
+    printf '%s\n' '#!/usr/bin/env bash' \
+        'out=""; mode=""; src=""' \
+        'while (( $# )); do case $1 in' \
+        '  -o) out=$2; shift 2;;' \
+        '  -S) mode=asm; shift;;' \
+        '  -c) mode=obj; shift;;' \
+        '  *) [[ -z $src && $1 != -* && -f $1 ]] && src=$1; shift;;' \
+        'esac; done' \
+        'if [[ $mode == asm ]]; then' \
+        '  [[ ${ASM_RC:-0} != 0 ]] && { printf "error: canned failure\n" >&2; exit "$ASM_RC"; }' \
+        '  cp "$CANNED_ASM" "$out" || exit 1' \
+        '  exit 0' \
+        'fi' \
+        'i=0' \
+        'while (( i < ${WARN_COUNT:-0} )); do' \
+        '  printf "warning: control reaches end of non-void function [-Wreturn-type]\n"' \
+        '  i=$((i + 1))' \
+        'done' \
+        'exit 0' >"$fake/cc"
+    chmod +x "$fake/cc"
+
+    # Two functions, four shapes: f's epilogue dead or kept, h's live or deleted.
+    printf '%s\n' '.text' 'f:' '	endbr64' '	call	die' 'h:' '	endbr64' '	movl	$7, %eax' '	ret' \
+        >"$fake/ok.s"
+    printf '%s\n' '.text' 'f:' '	endbr64' '	call	die' 'h:' '	endbr64' '	jmp	die' >"$fake/leak.s"
+    printf '%s\n' '.text' 'f:' '	endbr64' '	call	die' '	movl	$42, %eax' '	ret' 'h:' '	endbr64' '	movl	$7, %eax' '	ret' \
+        >"$fake/weak.s"
+    printf '%s\n' '.text' 'f:' '.LFB0:' '	.cfi_startproc' 'h:' '.LFB1:' '	.cfi_startproc' >"$fake/nolines.s"
+
+    run_witness() { # $1=name $2=expected FAIL count $3=grep -F pattern $4.. = env
+        local name=$1 want=$2 pat=$3; shift 3
+        local out rc fails
+        out=$(env "$@" CCC="$fake/cc" CC="$fake/cc" \
+            CCC_CASE="same_signature_calls_in_both_scopes.c|0|yes" \
+            "$SHELL" "$ROOT/tests/regression/check_scoped_noreturn_diagnostics.sh" --run 2>&1)
+        rc=$?
+        fails=$(printf '%s\n' "$out" | grep -c '^FAIL: ')
+        if (( fails != want )); then
+            printf 'self-test FAILED: %s reported %s failures, expected %s\n%s\n' \
+                "$name" "$fails" "$want" "$out"
+            return 1
+        fi
+        if (( want > 0 )) && ! grep -qF -- "$pat" <<<"$out"; then
+            printf 'self-test FAILED: %s did not name the failure it found (%s)\n%s\n' \
+                "$name" "$pat" "$out"
+            return 1
+        fi
+# A witness that passes by *not running* is the failure mode this whole
+        # file exists to avoid, so the sweep size is asserted as well: the clean
+        # one has to report its full count, and a red one has to say how many of
+        # the same seven configurations it failed.
+        local sig='checks passed (3 of them on emitted control flow)'
+        (( want > 0 )) && sig='of 7 checks FAILED'
+        if ! grep -qF -- "$sig" <<<"$out"; then
+            printf 'self-test FAILED: %s did not sweep all 7 configurations (%s)\n%s\n' "$name" "$sig" "$out"
+            return 1
+        fi
+        if [[ $name == clean ]] && (( rc != 0 )); then
+            printf 'self-test FAILED: the clean witness did not exit 0 (rc %s)\n%s\n' "$rc" "$out"
+            return 1
+        fi
+        if [[ $name != clean ]] && (( rc == 0 )); then
+            printf 'self-test FAILED: %s exited 0 while reporting %s failures\n' "$name" "$fails"
+            return 1
+        fi
+        printf 'self-test: %s ok\n' "$name"
+    }
+
+    bad=0
+    run_witness clean   0 "self-test: no pattern" \
+        CANNED_ASM=$fake/ok.s WARN_COUNT=0 ASM_RC=0 || bad=1
+    # The noreturn fact leaked into the nested scope: h's live `return 7` is gone.
+    # No warning row can see this -- both compilers answer 0 either way.
+    run_witness leak    2 "epilogue must be live after the call" \
+        CANNED_ASM=$fake/leak.s WARN_COUNT=0 ASM_RC=0 || bad=1
+    # Our own ratchet: a dead epilogue must be deleted, lccc only, so one failure.
+    run_witness weak    1 "dead code that must be gone" \
+        CANNED_ASM=$fake/weak.s WARN_COUNT=0 ASM_RC=0 || bad=1
+    # If the label match stopped finding instructions, every shape would "pass"
+    # by having nothing to say -- so an empty body is a failure, not a skip.
+    run_witness empty   3 "no instructions emitted" \
+        CANNED_ASM=$fake/nolines.s WARN_COUNT=0 ASM_RC=0 || bad=1
+    run_witness asmfail 3 "could not emit asm" \
+        CANNED_ASM=$fake/ok.s WARN_COUNT=0 ASM_RC=1 || bad=1
+    # The warning channel still bites: two answers where the row says none.
+    run_witness warnrow 4 "warnings, expected 0" \
+        CANNED_ASM=$fake/ok.s WARN_COUNT=2 ASM_RC=0 || bad=1
+
+    if (( bad )); then
+        echo "self-test: FAILED"
+        exit 1
+    fi
+    echo "self-test: ok (6 witnesses, fakes only -- no build tree needed)"
+    exit 0
+fi
+
+[[ -x $LCCC ]] || { echo "FAIL: no lccc at $LCCC (set CCC=)"; exit 1; }
+command -v "$CC" >/dev/null || { echo "FAIL: no $CC for the oracle"; exit 1; }
+[[ -d $SRC ]] || { echo "FAIL: no fixtures in $SRC"; exit 1; }
+
+# fixture | expected warnings | gcc accepts it (oracle available)
+CASES=(
+"outer_noreturn_shadowed_by_returning_nested.c|1|yes"
+"no_attribute_anywhere_control.c|1|yes"
+"noreturn_decl_specifier_on_nested_definition.c|0|yes"
+"block_scope_extern_keeps_file_entity.c|0|yes"
+"noreturn_does_not_leak_to_next_nested_definition.c|1|yes"
+"trailing_attribute_on_nested_definition.c|0|no"
+"same_signature_calls_in_both_scopes.c|0|yes"
+)
+
+# The self-test sweeps one row.  A witness that also ran the other six
+# fixtures would report the same failures for the wrong reasons, and a
+# witness that the gate ignores is a witness that proves nothing.
+if [[ -n ${CCC_CASE:-} ]]; then
+    CASES=("$CCC_CASE")
+fi
+
+
+# One warning answer, for a compiler, at one tier.  The count is what the row
+# asserts; the exit status is checked separately and only for lccc, because a
+# row's `oracle` field is precisely the statement that GCC may not compile it.
+warn_answer() { # $1=compiler $2=file $3=tier -> prints count
+    local out rc
+    out=$(timeout "$TIMEOUT" "$1" -std=gnu17 -Wall "$3" -c "$2" -o /dev/null 2>&1)
+    rc=$?
+    if (( rc != 0 )) && [[ $1 == "$LCCC" ]]; then
+        printf 'COMPILE-FAIL %s\n' "$rc"
+        return
+    fi
+    printf '%s' "$out" | grep -c "control reaches end of non-void function"
+}
+
+tiers=(-O1 -O2)
+executed=0
+want_executed=0
+failures=0
+differential=0
+
+for row in "${CASES[@]}"; do
+    IFS='|' read -r name expect oracle <<<"$row"
+    file="$SRC/$name"
+    [[ -f $file ]] || { echo "FAIL: missing fixture $file"; failures=$((failures + 1)); continue; }
+    for tier in "${tiers[@]}"; do
+        want_executed=$((want_executed + 1))
+        got=$(warn_answer "$LCCC" "$file" "$tier")
+        executed=$((executed + 1))
+        if [[ $got == COMPILE-FAIL* ]]; then
+            echo "FAIL: $name $tier: lccc could not compile its own fixture ($got)"
+            failures=$((failures + 1))
+        elif [[ $got != "$expect" ]]; then
+            echo "FAIL: $name $tier (lccc): $got warnings, expected $expect"
+            failures=$((failures + 1))
+        fi
+        if [[ $oracle == yes ]]; then
+            want_executed=$((want_executed + 1))
+            got=$(warn_answer "$CC" "$file" "$tier")
+            executed=$((executed + 1))
+            differential=$((differential + 1))
+            if [[ $got != "$expect" ]]; then
+                echo "FAIL: $name $tier (gcc): $got warnings, expected $expect -- the law this row cites no longer holds"
+                failures=$((failures + 1))
+            fi
+        else
+            # A row that claims there is no oracle must really have one missing:
+            # if GCC starts accepting the spelling, the row has to be re-measured
+            # rather than left asserting our answer alone.
+            if timeout "$TIMEOUT" "$CC" -std=gnu17 -Wall -O1 -c "$file" -o /dev/null >/dev/null 2>&1; then
+                echo "FAIL: $name: oracle=no but gcc now compiles it -- re-measure this row against gcc"
+                failures=$((failures + 1))
+            fi
+            executed=$((executed + 1))
+            want_executed=$((want_executed + 1))
+        fi
+    done
+done
+
+# --- emitted control flow -----------------------------------------------------
+#
+# The warning count cannot see the discriminating program: in
+# `same_signature_calls_in_both_scopes.c` neither call produces a warning
+# whichever entity it resolves to, because both functions return a value.  What
+# *does* change is the emitted code -- the dead block that
+# `ir::lowering::expr_calls` puts after a noreturn call either appears or does
+# not -- so the fixtures are asserted on the asm that comes out at -O2.
+#
+# `live` is a correctness claim and is checked against GCC too: a call that
+# returns must leave the rest of its function reachable.  A compiler that hands
+# that call the *other* scope's noreturn deletes a live epilogue and miscompiles
+# the program, and no diagnostic says so.
+#
+# `dead` is an optimisation claim, so it is asserted about lccc alone: after a
+# noreturn call the epilogue must be gone.  A compiler free to keep unreachable
+# code is weaker rather than wrong, and pinning GCC's choice here would measure
+# GCC instead of us.
+SHAPES=(
+"same_signature_calls_in_both_scopes.c|h|live|yes"
+"same_signature_calls_in_both_scopes.c|f|dead|no"
+)
+
+asm_body() { # $1=compiler $2=file $3=function -> indented instruction lines
+    local out=$WORK/$(basename "$2").$(basename "$1" | tr -c 'A-Za-z0-9' '_').s
+    if ! timeout "$TIMEOUT" "$1" -std=gnu17 -O2 -S "$2" -o "$out" 2>/dev/null; then
+        printf 'COMPILE-FAIL'
+        return
+    fi
+    # One function's instructions: after its label, indented, and not an assembler
+    # directive.  Both filters matter.  `.cfi_*` lines would otherwise become the
+    # "last instruction" of every function, so no shape could ever read as `ret`.
+    # And a label only *ends* a body when it names another function: `.LBB3:` and
+    # friends are basic-block labels, so treating them as function ends would
+    # truncate every body at its second block and quietly empty out the check.
+    # lccc's own `# LCCC_RET_*` / `# LCCC_CALL_ARGS` annotations are indented
+    # comments rather than instructions; they would otherwise become the "last
+    # instruction" of a body and decide a shape that the machine code says
+    # nothing about.
+    awk -v fn="$3" '
+        /^[A-Za-z_.][A-Za-z0-9_.]*:/ { if ($0 !~ /^\.L/) infn = ($0 == fn ":") }
+        infn && /^[ \t]+[^ \t.#]/ { print }
+    ' "$out"
+}
+
+shape_seen=0
+for row in "${SHAPES[@]}"; do
+    IFS='|' read -r name fn kind oracle <<<"$row"
+    file="$SRC/$name"
+    people=(lccc)
+    if [[ $oracle == yes ]]; then
+        people=(lccc gcc)
+    fi
+    for who in "${people[@]}"; do
+        compiler=$LCCC
+        [[ $who == gcc ]] && compiler=$CC
+        want_executed=$((want_executed + 1))
+        body=$(asm_body "$compiler" "$file" "$fn")
+        executed=$((executed + 1))
+        shape_seen=$((shape_seen + 1))
+        if [[ $body == COMPILE-FAIL* ]]; then
+            echo "FAIL: $name ($fn, $who): $compiler could not emit asm for its own fixture"
+            failures=$((failures + 1))
+            continue
+        fi
+        if [[ -z ${body//[[:space:]]/} ]]; then
+            echo "FAIL: $name ($fn, $who): no instructions emitted for \`$fn\` -- the label match is not seeing this function"
+            failures=$((failures + 1))
+            continue
+        fi
+        if [[ $kind == live ]]; then
+            last=$(printf '%s\n' "$body" | tail -1 | sed 's/^[[:space:]]*//')
+            if [[ $last != *ret* ]]; then
+                echo "FAIL: $name ($fn, $who): \`$fn\` returns, so its epilogue must be live after the call; last instruction is \`$last\`"
+                failures=$((failures + 1))
+            fi
+        elif [[ $who == lccc ]]; then
+            if grep -qE '(^|[^_[:alnum:]])ret([^_[:alnum:]]|$)' <<<"$body"; then
+                echo "FAIL: $name ($fn, $who): the call never returns, so \`$fn\`'s epilogue is dead code that must be gone"
+                failures=$((failures + 1))
+            fi
+        fi
+    done
+done
+
+if (( executed != want_executed )); then
+    echo "FAIL: $executed of $want_executed configurations ran -- a partial sweep is not a passed one"
+    exit 1
+fi
+if (( failures )); then
+    echo "scoped-noreturn diagnostics: $failures of $executed checks FAILED"
+    exit 1
+fi
+echo "scoped-noreturn diagnostics: $executed checks passed ($shape_seen of them on emitted control flow), $differential of them differential against gcc"
diff --git a/tests/regression/i386_staging/i386_mixed12_callee.c b/tests/regression/i386_staging/i386_mixed12_callee.c
new file mode 100644
index 00000000..8f75d23f
--- /dev/null
+++ b/tests/regression/i386_staging/i386_mixed12_callee.c
@@ -0,0 +1,9 @@
+#include "i386_mixed12_shared.h"
+
+/* The callee half, and the only definition: what `use` does with its parameter is
+ * fixed by the psABI's classification of the type, not by whichever compiler
+ * happens to be looking. */
+unsigned long long use(struct P p)
+{
+    return p.w + (unsigned long long)(int)p.f;
+}
diff --git a/tests/regression/i386_staging/i386_mixed12_caller.c b/tests/regression/i386_staging/i386_mixed12_caller.c
new file mode 100644
index 00000000..462acdae
--- /dev/null
+++ b/tests/regression/i386_staging/i386_mixed12_caller.c
@@ -0,0 +1,17 @@
+#include "i386_mixed12_shared.h"
+
+/* The caller half: poison the bytes around the object, hand it over, and let the
+ * answer say whether the callee got the twelve bytes it was promised. */
+int main(void)
+{
+    union {
+        struct P p;
+        unsigned char raw[16];
+    } u;
+
+    for (unsigned i = 0; i < sizeof u.raw; i++)
+        u.raw[i] = 0xAA;
+    u.p.w = 0x100000001ULL;
+    u.p.f = 3.0f;
+    return use(u.p) == 0x100000004ULL ? 0 : 1;
+}
diff --git a/tests/regression/i386_staging/i386_mixed12_shared.h b/tests/regression/i386_staging/i386_mixed12_shared.h
new file mode 100644
index 00000000..b678852c
--- /dev/null
+++ b/tests/regression/i386_staging/i386_mixed12_shared.h
@@ -0,0 +1,23 @@
+/* The shared half of the cross-compiler ABI test: one struct, one declaration,
+ * compiled twice -- once by the compiler under test and once by the oracle -- and
+ * linked together.  A calling convention is only *correct* at the boundary between
+ * two independent compilers, so this header exists to make the two TUs state the
+ * same type without either one seeing the other's source.
+ *
+ * The struct is deliberately 12 bytes and packed: eight bytes of INTEGER plus four
+ * of SSE, which is the size at which the x86-64 psABI stops being able to call the
+ * whole thing an integer, and the point at which a compiler that has no SSE class for
+ * an argument falls back to MEMORY.  `use` returns the folded value so a mismatched
+ * boundary is visible as a wrong number rather than a crash.
+ */
+#ifndef I386_MIXED12_SHARED_H
+#define I386_MIXED12_SHARED_H
+
+struct P {
+    unsigned long long w;
+    float f;
+} __attribute__((packed));
+
+unsigned long long use(struct P p);
+
+#endif /* I386_MIXED12_SHARED_H */
diff --git a/tests/regression/i386_staging/i386_regparm_small_mixed12.c b/tests/regression/i386_staging/i386_regparm_small_mixed12.c
new file mode 100644
index 00000000..6acb8237
--- /dev/null
+++ b/tests/regression/i386_staging/i386_regparm_small_mixed12.c
@@ -0,0 +1,61 @@
+/* A packed { unsigned long long; float } is twelve bytes and belongs to two classes
+ * at once: eight of INTEGER and four of SSE.
+ *
+ * The two halves of the classification are the whole point of this fixture.  On
+ * -m64 the object does not fit the two-integer prefix, so the integer half goes in
+ * %rdi and the float half in %xmm0 -- as a *4-byte* move; the callee side of that is
+ * `movq %xmm0, 16(%rsp)` in lccc's own output.  On -m32 -mregparm=3 there are exactly
+ * three integer registers, and gcc stages the whole object as three `movl`s with no
+ * SSE move at all (measured: `movl $1, %eax; movl $1, %edx; movl $1077936128, %ecx`).
+ * Neither answer may be reached by grabbing 16 bytes: a `movaps`/`movups` over a
+ * 12-byte argument reads four bytes the caller does not own, and it is exactly the
+ * move an exit status cannot see, because the callee never looks at the extra bytes.
+ *
+ * The value is therefore not a pinned number.  gcc answers 40 for the naive version
+ * of this program at -O2 and 98 at -O0 (-m32 -mregparm=3), so "agree with the
+ * oracle" would be pinning one of two disagreeing oracles -- true divergence about
+ * how a packed 12-byte struct is classified at -O0, and not a law anyone should
+ * latch to.  What *is* a law: passing an object by value cannot change the object.
+ * `main` computes the answer twice, once through the call and once from the members
+ * directly, and the surrounding bytes are poisoned to 0xAA first, so a staging
+ * sequence that reads wider than the subobject it was given has to show up as a
+ * non-zero exit -- in any compiler, at any tier.  0 means the round trip preserved
+ * the object; 1 means it did not, and that is what the gate asserts.
+ */
+struct P {
+    unsigned long long w;
+    float f;
+} __attribute__((packed));
+
+/* Volatile, so neither call can be folded away: the gate's assembly arms need the
+ * staging sequence to actually be emitted. */
+static volatile unsigned long long seed_w;
+static volatile float seed_f;
+
+__attribute__((noinline)) static unsigned long long use(struct P p)
+{
+    return p.w + (unsigned long long)(int)p.f;
+}
+
+int main(void)
+{
+    union {
+        struct P p;
+        unsigned char raw[16];
+    } u;
+    unsigned long long direct;
+
+    seed_w = 0x100000001ULL;
+    seed_f = 3.0f;
+    for (unsigned i = 0; i < sizeof u.raw; i++)
+        u.raw[i] = 0xAA;
+    u.p.w = seed_w;
+    u.p.f = seed_f;
+    direct = u.p.w + (unsigned long long)(int)u.p.f;
+    if (use(u.p) != direct)
+        return 1;
+    /* Twice through the ABI: a read of uninitialised surroundings is not stable
+     * across two calls that pass the same bytes, and this catches the case where
+     * the first comparison agreed by luck. */
+    return use(u.p) != direct;
+}
diff --git a/tests/regression/i386_staging/i386_regparm_staging_three.c b/tests/regression/i386_staging/i386_regparm_staging_three.c
new file mode 100644
index 00000000..ccf5d1e7
--- /dev/null
+++ b/tests/regression/i386_staging/i386_regparm_staging_three.c
@@ -0,0 +1,21 @@
+/* Three register-carried parameters whose values must all survive until the call.
+ *
+ * Under -mregparm=3 the callee receives a, b, c in %eax, %edx, %ecx, and the call
+ * to `sink` clobbers all three, so the prologue has to capture them first.  The
+ * captures are the interesting part: `i686/codegen/prologue.rs` records that params
+ * are processed in descending ABI-register order because "%ecx/%edx are themselves
+ * allocatable (caller-saved phase), so a pre-store target could be a later param's
+ * still-unread source".  The gate does not pin the *order* -- any order is correct
+ * when the targets are disjoint from the sources -- it pins the property the order
+ * exists to protect: no instruction may write one of %eax/%edx/%ecx before every
+ * read of it has happened.  A capture that stages through a register it still owes
+ * another param silently replaces one argument with another, and the miscompile is
+ * visible only as a wrong value at -O2.
+ */
+extern int sink(int, int, int);
+
+int f(int a, int b, int c)
+{
+    int t = sink(a, b, c);
+    return t + a * 3 + b * 5 + c * 7;
+}
diff --git a/tests/regression/scoped_noreturn/block_scope_extern_keeps_file_entity.c b/tests/regression/scoped_noreturn/block_scope_extern_keeps_file_entity.c
new file mode 100644
index 00000000..393364e5
--- /dev/null
+++ b/tests/regression/scoped_noreturn/block_scope_extern_keeps_file_entity.c
@@ -0,0 +1,5 @@
+/* C11 6.7.1p5: a block-scope function declaration *without* `auto` denotes the
+ * externally visible entity, so the outer `noreturn` applies and nothing falls
+ * through.  The scoped fix must not over-apply and treat this as a new entity. */
+extern void die(void) __attribute__((noreturn));
+int g(void) { extern void die(void); die(); }
diff --git a/tests/regression/scoped_noreturn/no_attribute_anywhere_control.c b/tests/regression/scoped_noreturn/no_attribute_anywhere_control.c
new file mode 100644
index 00000000..d208ff49
--- /dev/null
+++ b/tests/regression/scoped_noreturn/no_attribute_anywhere_control.c
@@ -0,0 +1,4 @@
+/* The control row: nothing is noreturn here, so the warning is owed by anyone.
+ * A gate without a row like this passes a compiler whose diagnostics are off. */
+extern void die(void);
+int g(void) { auto void die(void) { return; } die(); }
diff --git a/tests/regression/scoped_noreturn/noreturn_decl_specifier_on_nested_definition.c b/tests/regression/scoped_noreturn/noreturn_decl_specifier_on_nested_definition.c
new file mode 100644
index 00000000..ec04ab32
--- /dev/null
+++ b/tests/regression/scoped_noreturn/noreturn_decl_specifier_on_nested_definition.c
@@ -0,0 +1,6 @@
+/* `_Noreturn` written on the nested definition is a contract about *it*: the call
+ * cannot fall through, so no warning is owed.  The nested parser used to copy
+ * four attribute flags and drop this one, which made the warning (and the
+ * fallthrough answer behind it) wrong while the attribute was read fine on a
+ * file-scope definition. */
+int g(void) { _Noreturn auto void n(void) { for (;;) {} } n(); return 0; }
diff --git a/tests/regression/scoped_noreturn/noreturn_does_not_leak_to_next_nested_definition.c b/tests/regression/scoped_noreturn/noreturn_does_not_leak_to_next_nested_definition.c
new file mode 100644
index 00000000..a4a1b319
--- /dev/null
+++ b/tests/regression/scoped_noreturn/noreturn_does_not_leak_to_next_nested_definition.c
@@ -0,0 +1,5 @@
+/* The other half of consumption: `m` follows a `_Noreturn` nested definition in
+ * the same block, and an attribute left in the parser's accumulated state would
+ * silently become `m`'s too -- which would swallow this warning.  Measured
+ * against GCC, which reports the fallthrough. */
+int g(void) { _Noreturn auto void n(void) { for (;;) {} } void m(void) { return; } m(); }
diff --git a/tests/regression/scoped_noreturn/outer_noreturn_shadowed_by_returning_nested.c b/tests/regression/scoped_noreturn/outer_noreturn_shadowed_by_returning_nested.c
new file mode 100644
index 00000000..a8e0c5f1
--- /dev/null
+++ b/tests/regression/scoped_noreturn/outer_noreturn_shadowed_by_returning_nested.c
@@ -0,0 +1,5 @@
+/* C11 6.2.1p4: the nested `die` is its own entity and returns, so `g` can fall
+ * out of its body even though the outer `die` never does.  GCC warns; a compiler
+ * that resolves the call by bare name does not. */
+extern void die(void) __attribute__((noreturn));
+int g(void) { auto void die(void) { return; } die(); }
diff --git a/tests/regression/scoped_noreturn/same_signature_calls_in_both_scopes.c b/tests/regression/scoped_noreturn/same_signature_calls_in_both_scopes.c
new file mode 100644
index 00000000..5e20b8ce
--- /dev/null
+++ b/tests/regression/scoped_noreturn/same_signature_calls_in_both_scopes.c
@@ -0,0 +1,33 @@
+/* C11 6.2.1p4 and 6.7.6.3p6, in the shape that a type comparison cannot see:
+ * the nested declaration has the *same signature* as the file-scope one, and both
+ * entities are called -- each in the scope where it is the binding.
+ *
+ *   f calls the file-scope `die`, which never returns: its `return 42` is dead.
+ *   h calls a nested `die` with an identical prototype, which does return: its
+ *   `return 7` is live.
+ *
+ * The two halves fail in opposite directions, which is why both are here.  A
+ * compiler that resolves the call by bare name gives `h` the outer entity's
+ * noreturn and deletes h's epilogue -- a miscompile of a program that plainly
+ * returns 7.  A compiler that lets the nested (returning) declaration overwrite
+ * the file-scope entity's facts keeps f's dead epilogue alive and, worse, can
+ * drop f's noreturn for every *other* caller.  Neither shows up in a
+ * -Wreturn-type count, so the gate asserts the emitted control flow as well.
+ */
+extern void die(void) __attribute__((noreturn));
+
+int f(void)
+{
+    die();
+    return 42;
+}
+
+int h(void)
+{
+    auto void die(void)
+    {
+        return;
+    }
+    die();
+    return 7;
+}
diff --git a/tests/regression/scoped_noreturn/trailing_attribute_on_nested_definition.c b/tests/regression/scoped_noreturn/trailing_attribute_on_nested_definition.c
new file mode 100644
index 00000000..ae841efc
--- /dev/null
+++ b/tests/regression/scoped_noreturn/trailing_attribute_on_nested_definition.c
@@ -0,0 +1,6 @@
+/* GCC 14 rejects this spelling on a definition ("attributes should be specified
+ * before the declarator in a function definition"), so there is no oracle here:
+ * lccc accepts the attribute and honours it, which is a deliberate superset --
+ * the alternative is to discard what the user wrote.  No warning is owed. */
+extern void die(void);
+int g(void) { auto void die(void) __attribute__((noreturn)) { for (;;) {} } die(); }
diff --git a/tests/regression/small_aggregate_partial_eightbyte.c b/tests/regression/small_aggregate_partial_eightbyte.c
new file mode 100644
index 00000000..c9d54fc7
--- /dev/null
+++ b/tests/regression/small_aggregate_partial_eightbyte.c
@@ -0,0 +1,155 @@
+/*  Byte-exact by-value aggregates whose *last eightbyte is partial*, laid out so
+ *  that any read beyond the end of the object lands on a PROT_NONE page.
+ *
+ *  Why this file exists: a register-classified aggregate is copied one eightbyte
+ *  at a time, and the psABI leaves the bytes past the object's end unspecified --
+ *  which is a licence to omit them, not a licence to read them.  The INTEGER
+ *  family was already pinned for byte arrays by large_aggregate_call_copy.c, but
+ *  the SSE and mixed ([INTEGER,SSE] / [SSE,INTEGER]) classes were not: their
+ *  eightbytes are staged with `movq` into XMM registers too, so a 12-byte
+ *  `float[3]` argument reads 4 bytes it does not own and a 10-byte
+ *  `struct { double; short; }` reads 6 past the end.  Sizes here are chosen so
+ *  each class has a partial tail eightbyte:
+ *
+ *    struct fl3   12 B  -> [SSE, SSE]            second eightbyte 4 B of 8
+ *    struct ds     9 B  -> [SSE, INTEGER]        second eightbyte 1 B of 8
+ *    struct sbi    7 B  -> [INTEGER]             single  7 B of 8
+ *    struct u13   13 B  -> [INTEGER, INTEGER]     second eightbyte 5 B of 8
+ *
+ *  Neighbouring scalars ride in the registers between the aggregates: if a class
+ *  is skipped or shifted, the digest below changes even when the padding bytes
+ *  themselves happen to look right, and a wrong argument *width* (not just extra
+ *  bytes) shows up as a mismatch instead of a fault.
+ *
+ *  Compile with -DCALLER_ONLY (main + the checks) or -DCALLEE_ONLY (the callee
+ *  side) and link one of each, in any combination, so a caller and a callee built
+ *  by different compilers have to agree.  Returns 0 on success.
+ */
+#include <stdint.h>
+#include <stddef.h>
+
+struct fl3 {
+    float v[3];
+};
+/* `packed` is load-bearing, not decoration: an unpadded-free `struct { double d;
+ * short s; }` is 16 bytes with 6 bytes of trailing padding, which (a) makes the
+ * tail eightbyte whole, so it probes nothing, and (b) would put *unspecified*
+ * bytes into the digest below and let the two compilers disagree by design.  With
+ * `packed` the object is 9 bytes: [SSE, INTEGER] with one defined byte in the
+ * second eightbyte -- exactly the shape that makes an 8-byte load out of bounds. */
+struct ds {
+    double d;
+    short s;
+} __attribute__((packed));
+struct sbi {
+    unsigned char b[7];
+};
+struct u13 {
+    unsigned char b[13];
+};
+
+#define TAG_A 0x9e3779b97f4a7c15ull
+#define TAG_B 0x0123456789abcdefull
+
+#ifndef CALLER_ONLY
+static uint64_t fold(const volatile unsigned char *p, size_t n, uint64_t acc)
+{
+    for (size_t i = 0; i < n; ++i)
+        acc = (acc + p[i]) * 1099511628211ull;
+    return acc;
+}
+
+uint64_t probe(unsigned a, struct fl3 f, double x, struct ds d, uint64_t y,
+               struct sbi s, unsigned z, struct u13 u, uint64_t w)
+{
+    uint64_t acc = TAG_A ^ (uint64_t)a ^ y ^ (uint64_t)z ^ w;
+    /* Only the object's own bytes are examined -- never a rounded-up width. */
+    acc = fold((const volatile unsigned char *)&f, sizeof f, acc);
+    acc = fold((const volatile unsigned char *)&d, sizeof d, acc);
+    acc = fold((const volatile unsigned char *)&s, sizeof s, acc);
+    acc = fold((const volatile unsigned char *)&u, sizeof u, acc);
+    /* Scalars must arrive unharmed; a partial-eightbyte fix that shifted a
+     * register would be caught here rather than in the padding. */
+    uint64_t xb;
+    double xd = x;
+    for (xb = 0; xb < 8; ++xb)
+        acc = acc * 31u + ((const unsigned char *)&xd)[xb];
+    return acc;
+}
+#endif
+
+#ifndef CALLEE_ONLY
+#include <sys/mman.h>
+#include <unistd.h>
+
+uint64_t probe(unsigned, struct fl3, double, struct ds, uint64_t, struct sbi,
+               unsigned, struct u13, uint64_t);
+
+/* A `T` living at the very end of a readable page, with the next page
+ * PROT_NONE: an over-read of even one byte past `sizeof T` faults. */
+#define PLACE(dst, T, init)                                                                    \
+    do {                                                                                       \
+        size_t pg = (size_t)page;                                                              \
+        size_t span = ((sizeof(T) + pg - 1) / pg) * pg;                                       \
+        unsigned char *m = mmap(0, span + pg, PROT_READ | PROT_WRITE,                          \
+                                MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);                           \
+        if (m == MAP_FAILED)                                                                    \
+            return 91;                                                                          \
+        if (mprotect(m + span, pg, PROT_NONE))                                                  \
+            return 92;                                                                          \
+        T *p = (T *)(m + span - sizeof(T));                                                    \
+        *p = init;                                                                              \
+        dst = p;                                                                                \
+    } while (0)
+
+int main(void)
+{
+    long page = sysconf(_SC_PAGESIZE);
+    if (page <= 0)
+        return 90;
+    struct fl3 f0 = { { 1.5f, -2.25f, 8.0f } };
+    struct ds d0 = { 3.75, 511 };
+    struct sbi s0 = { { 1, 2, 3, 4, 5, 6, 7 } };
+    struct u13 u0 = { { 9, 8, 7, 6, 5, 4, 3, 2, 1, 11, 12, 13, 14 } };
+    struct fl3 *f = 0;
+    struct ds *d = 0;
+    struct sbi *s = 0;
+    struct u13 *u = 0;
+    PLACE(f, struct fl3, f0);
+    PLACE(d, struct ds, d0);
+    PLACE(s, struct sbi, s0);
+    PLACE(u, struct u13, u0);
+
+    volatile double xd = 1.25;
+    uint64_t expect = TAG_A ^ 7u ^ 0xfeedfacecafebeefull ^ 13u ^ 0x1234567890abcdefull;
+    const unsigned char *pb;
+    uint64_t acc = expect;
+    pb = (const unsigned char *)f;
+    for (size_t i = 0; i < sizeof *f; ++i)
+        acc = (acc + pb[i]) * 1099511628211ull;
+    pb = (const unsigned char *)d;
+    for (size_t i = 0; i < sizeof *d; ++i)
+        acc = (acc + pb[i]) * 1099511628211ull;
+    pb = (const unsigned char *)s;
+    for (size_t i = 0; i < sizeof *s; ++i)
+        acc = (acc + pb[i]) * 1099511628211ull;
+    pb = (const unsigned char *)u;
+    for (size_t i = 0; i < sizeof *u; ++i)
+        acc = (acc + pb[i]) * 1099511628211ull;
+    for (size_t i = 0; i < 8; ++i)
+        acc = acc * 31u + ((const unsigned char *)&xd)[i];
+
+    uint64_t got = probe(7, *f, xd, *d, 0xfeedfacecafebeefull, *s, 13, *u,
+                         0x1234567890abcdefull);
+    if (got != acc)
+        return 1;
+    /* Same objects through an indirect call: the classifier must not depend on
+     * the call being direct. */
+    uint64_t (*volatile indirect)(unsigned, struct fl3, double, struct ds, uint64_t,
+                                 struct sbi, unsigned, struct u13, uint64_t) = probe;
+    if (indirect(7, *f, xd, *d, 0xfeedfacecafebeefull, *s, 13, *u,
+                 0x1234567890abcdefull) != acc)
+        return 2;
+    return 0;
+}
+#endif
diff --git a/tests/workloads/expat-2.8.5/junit_check.py b/tests/workloads/expat-2.8.5/junit_check.py
new file mode 100644
index 00000000..dd9c6204
--- /dev/null
+++ b/tests/workloads/expat-2.8.5/junit_check.py
@@ -0,0 +1,408 @@
+#!/usr/bin/env python3
+"""Compare two CTest JUnit reports -- by identity, not by length.
+
+The Expat workload builds the same upstream suite twice, once with GCC and once
+with LCCC, and the workload is only a *differential* if both runs executed the
+same set of tests.  Counting `<testcase>` elements is not that check: a
+candidate configuration that silently dropped `runtests` (or renamed a test, or
+gained an extra one) produced the same "2 versus 1, status: pass" summary that a
+matching run produces.  Two equal counts over different test sets is the most
+convincing kind of nothing.
+
+So this module compares the *multiset of testcase identities* and each test's
+status, and it compares the CTest/CMake feature configuration that produced
+them -- equal test names must not excuse a weaker candidate build.
+
+Compiler-free by design: `--self-test` runs the whole contract against
+in-memory fixtures, which is what makes it a CI gate (`ci_local.sh`
+`expat-junit-contract`) rather than a claim about an Expat build.
+
+Usage:
+  junit_check.py --reference ctest-gcc.xml --candidate ctest-lccc.xml \
+      [--reference-config cmake-cache-gcc.txt --candidate-config cmake-cache-lccc.txt] \
+      [--out comparison.json]
+  junit_check.py --self-test
+"""
+from __future__ import annotations
+
+import argparse
+import tempfile
+import json
+import os
+import re
+import shlex
+import sys
+import xml.etree.ElementTree as ET
+from collections import Counter
+from dataclasses import dataclass
+from pathlib import Path
+
+# CTest's `--output-junit` writes <testsuites><testsuite><testcase .../>; older
+# or hand-written reports may start at <testsuite>. Both are accepted, and
+# nothing else is.
+ALLOWED_ROOTS = ("testsuites", "testsuite")
+# Every status a `<testcase>` can carry.  A report element we do not model must
+# not be readable as a pass: that is how a new CTest failure class becomes a
+# silent green.
+STATUSES = ("pass", "failure", "error", "skipped")
+# Only these CMake cache keys may differ between the two configurations: they
+# *are* the point of the differential (which compiler produced the objects) or
+# describe where the build happened.  Everything else that changes the compiled
+# surface -- EXPAT_* feature switches, build type, generator -- must match.
+#
+# `CMAKE_*_FLAGS*` used to be on this list, which put the flags themselves inside
+# "the compiler under test differs".  That is the one hole wide enough to lose the
+# measurement: -O2 against -O0, a dropped -DNDEBUG, a stray -m32 all sit in those
+# entries, and each would have been waved through while the JUnit rows still
+# matched.  They are compared now, with the paths that legitimately differ removed
+# -- see flag_signature.
+CONFIG_ALLOWLIST = (
+    "CMAKE_C_COMPILER",
+    "CMAKE_C_COMPILER_LAUNCHER",
+    "CMAKE_CXX_COMPILER",
+    "CMAKE_HOME_DIRECTORY",
+    "CMAKE_CACHEFILE_DIR",
+    "PROJECT_SOURCE_DIR",
+    "PROJECT_BINARY_DIR",
+    "CMAKE_INSTALL_PREFIX",
+)
+
+# `-I<dir>` and friends name a *location*, and the two build trees are different
+# locations; `run.sh` even adds an extra `-I$(gcc -print-file-name=include)` to the
+# lccc arm only, because the wrapper needs the compiler's own headers.  Those are
+# the legitimate delta, so the token and its argument are normalised away.  The
+# space-taking forms are listed too: `-isystem <dir>` would otherwise survive as
+# the bare word `-isystem` on one side and nothing on the other.
+_PATH_TAKING = ("-I", "-isystem", "-iquote", "-idirafter", "-include", "-imacros",
+                "-MF", "-MT", "-MQ", "-F", "-iframework", "-ifcse", "-gcc-toolchain")
+
+FLAGS_KEY = re.compile(r"^CMAKE_(C|CXX|OBJC|OBJCXX|ASM|ASM_MARM|Linker)_FLAGS")
+
+
+def flag_signature(value: str) -> tuple[str, ...]:
+    """The flags that change the program, with header-search paths removed.
+
+    Everything not consumed as a path is kept, including the cosmetic-looking
+    `-f` switches: guessing which of them are cosmetic is how a flag that changes
+    codegen ends up normalised away.  A false alarm here costs one run and buys a
+    rule that cannot be quietly widened.
+    """
+    try:
+        parts = shlex.split(value or "")
+    except ValueError:
+        parts = value.split()  # unbalanced quoting: judge the raw string, not nothing
+    kept: list[str] = []
+    skip_argument = False
+    for part in parts:
+        if skip_argument:
+            skip_argument = False
+            continue
+        if part in _PATH_TAKING:
+            skip_argument = True
+            continue
+        if part.startswith(_PATH_TAKING):
+            continue
+        kept.append(part)
+    return tuple(kept)
+
+
+@dataclass(frozen=True)
+class Case:
+    classname: str
+    name: str
+    status: str
+
+
+class ReportError(ValueError):
+    """A report that cannot be compared, as opposed to one that differs."""
+
+
+_ATTR_STATUS = {
+    "failed": "failure", "notrun": "skipped", "skipped": "skipped",
+    "timeout": "failure", "passed": "pass", "disabled": "skipped",
+}
+
+
+def _status_of(element: ET.Element) -> str:
+    """The status of one testcase, from child elements or from attributes.
+
+    CTest's `--output-junit` records a problem as a child element
+    (`<failure/>`, `<error/>`, `<skipped/>`); other JUnit writers -- and CTest's
+    own `<Test status="notrun">` style -- use an attribute.  Reading only the
+    children would call an attribute-flagged failure a pass, which is the exact
+    inversion this module must never perform, so both are consulted and an
+    unrecognised attribute value is refused instead of defaulted.
+    """
+    for tag, status in (("failure", "failure"), ("error", "error"), ("skipped", "skipped")):
+        if element.find(tag) is not None:
+            return status
+    for attribute in ("status", "result"):
+        value = element.get(attribute)
+        if value is None:
+            continue
+        normalized = _ATTR_STATUS.get(value.strip().lower())
+        if normalized is None:
+            raise ReportError(f"unrecognised {attribute}={value!r} on a <testcase>; "
+                              f"refusing to read an unknown status as a pass")
+        return normalized
+    return "pass"
+
+
+def parse_junit(path: Path) -> list[Case]:
+    """Every `<testcase>` in a CTest JUnit file, with a usable identity.
+
+    Raises `ReportError` rather than returning a shorter list when the report is
+    malformed: an unreadable XML file, no testcases at all, or a testcase
+    without a name are all reasons the *comparison* is invalid, not reasons to
+    compare fewer tests.
+    """
+    try:
+        root = ET.parse(path).getroot()
+    except (OSError, ET.ParseError) as exc:
+        raise ReportError(f"{path}: cannot be parsed as JUnit XML: {exc}") from exc
+    if root.tag not in ALLOWED_ROOTS:
+        raise ReportError(f"{path}: unexpected JUnit root <{root.tag}>, "
+                          f"expected one of {list(ALLOWED_ROOTS)}")
+    cases: list[Case] = []
+    for element in root.iter("testcase"):
+        name = (element.get("name") or "").strip()
+        if not name:
+            raise ReportError(f"{path}: a <testcase> without a name cannot be "
+                              f"compared; refusing to treat it as absent or as a pass")
+        cases.append(Case((element.get("classname") or "").strip(), name,
+                          _status_of(element)))  # ReportError propagates: unknown is fatal
+    if not cases:
+        raise ReportError(f"{path}: contains no <testcase> elements; an empty CTest "
+                          f"report is not a passing differential")
+    return cases
+
+
+def _index(cases: list[Case], label: str) -> dict[tuple[str, str], Counter]:
+    index: dict[tuple[str, str], Counter] = {}
+    for case in cases:
+        index.setdefault((case.classname, case.name), Counter())[case.status] += 1
+    for key, statuses in index.items():
+        if sum(statuses.values()) > 1 and len(statuses) > 1:
+            # Same identity, different recorded status: which one is the run?
+            raise ReportError(f"{label}: {key[0]}/{key[1]} appears with mixed statuses "
+                              f"{dict(statuses)}; the report is self-contradictory")
+    return index
+
+
+def compare(reference: list[Case], candidate: list[Case], *,
+            reference_label: str = "reference", candidate_label: str = "candidate") -> dict:
+    """Multiset identity + status comparison, with every difference named."""
+    problems: list[str] = []
+    ref = _index(reference, reference_label)
+    cand = _index(candidate, candidate_label)
+    missing = sorted(set(ref) - set(cand))
+    extra = sorted(set(cand) - set(ref))
+    if missing:
+        problems.append(f"{candidate_label} did not run {len(missing)} test(s) the "
+                        f"{reference_label} ran: "
+                        + ", ".join(f"{a}/{b}" for a, b in missing[:20]))
+    if extra:
+        problems.append(f"{candidate_label} ran {len(extra)} test(s) the {reference_label} "
+                        f"did not: " + ", ".join(f"{a}/{b}" for a, b in extra[:20]))
+    status_changes = []
+    for key in sorted(set(ref) & set(cand)):
+        if ref[key] != cand[key]:
+            status_changes.append(f"{key[0]}/{key[1]}: {dict(ref[key])} vs {dict(cand[key])}")
+    if status_changes:
+        problems.append(f"{len(status_changes)} test(s) changed status: "
+                        + "; ".join(status_changes[:20]))
+    not_green = []
+    for label, cases in ((reference_label, reference), (candidate_label, candidate)):
+        bad = [c for c in cases if c.status != "pass"]
+        if bad:
+            not_green.append(f"{label}: {len(bad)} non-passing test(s), e.g. "
+                             + ", ".join(f"{c.classname}/{c.name}({c.status})" for c in bad[:10]))
+    if not_green:
+        problems.extend(not_green)
+    return {
+        "comparable": not problems,
+        "problems": problems,
+        "reference_tests": len(reference),
+        "candidate_tests": len(candidate),
+        "reference_unique": len(ref),
+        "candidate_unique": len(cand),
+        "duplicate_identities": {
+            reference_label: sum(v for k, v in
+                                 Counter((c.classname, c.name) for c in reference).items() if v > 1),
+            candidate_label: sum(v for k, v in
+                                 Counter((c.classname, c.name) for c in candidate).items() if v > 1),
+        },
+    }
+
+
+_CACHE_LINE = re.compile(r"^(?P<key>[^:]+):(?P<type>[^=]*)=(?P<value>.*)$")
+
+
+def config_manifest(text: str) -> dict[str, str]:
+    """`KEY=VALUE` pairs from a CMakeCache.txt that describe the built surface."""
+    manifest: dict[str, str] = {}
+    for line in text.splitlines():
+        match = _CACHE_LINE.match(line.strip())
+        if not match:
+            continue
+        key = match.group("key")
+        if key.startswith(("EXPAT_", "CMAKE_BUILD_TYPE", "CMAKE_GENERATOR", "CMAKE_C_FLAGS",
+                           "CMAKE_INSTALL_PREFIX", "BUILD_SHARED")) or FLAGS_KEY.match(key):
+            manifest[key] = match.group("value")
+    return manifest
+
+
+def compare_config(reference: dict[str, str], candidate: dict[str, str]) -> list[str]:
+    """Configuration differences that are NOT the compiler under test."""
+    problems = []
+    for key in sorted(set(reference) | set(candidate)):
+        if FLAGS_KEY.match(key):
+            want = flag_signature(reference.get(key, ""))
+            got = flag_signature(candidate.get(key, ""))
+            if want != got:
+                problems.append(
+                    f"configuration differs on {key} beyond header search paths: "
+                    f"{' '.join(want)!r} vs {' '.join(got)!r} -- the two builds did "
+                    f"not compile the same program")
+            continue
+        if any(key == allowed or key.startswith(allowed + "-") for allowed in CONFIG_ALLOWLIST):
+            continue
+        if reference.get(key) != candidate.get(key):
+            problems.append(f"configuration differs on {key}: "
+                            f"{reference.get(key)!r} vs {candidate.get(key)!r}")
+    return problems
+
+
+def self_test() -> int:
+    """The witnesses this module exists to refuse, plus the control that passes."""
+    ok = 0
+    ref = [Case("s", "alpha", "pass"), Case("s", "beta", "pass")]
+    same = [Case("s", "alpha", "pass"), Case("s", "beta", "pass")]
+
+    def expect(label: str, want_problem: bool, result: dict) -> None:
+        nonlocal ok
+        got = not result["comparable"]
+        if got != want_problem:
+            raise AssertionError(f"{label}: expected problem={want_problem}, got {result}")
+        ok += 1
+
+    expect("identical suites pass", False, compare(ref, same))
+    expect("omitted test is a problem", True, compare(ref, same[:1]))
+    expect("equal count, different test is a problem", True,
+           compare(ref, [Case("s", "alpha", "pass"), Case("s", "gamma", "pass")]))
+    expect("status change is a problem", True,
+           compare(ref, [Case("s", "alpha", "failure"), Case("s", "beta", "pass")]))
+    expect("skipped is a problem", True,
+           compare(ref, [Case("s", "alpha", "skipped"), Case("s", "beta", "pass")]))
+    expect("duplicates on one side only are a problem", True,
+           compare(ref, [Case("s", "alpha", "pass"), Case("s", "alpha", "pass")]))
+    doubled = [Case("s", "alpha", "pass"), Case("s", "alpha", "pass"), Case("s", "beta", "pass")]
+    expect("matched duplicates are matched, not masked", False, compare(doubled, list(doubled)))
+    mixed = [Case("s", "alpha", "pass"), Case("s", "alpha", "failure"), Case("s", "beta", "pass")]
+    try:
+        compare(mixed, list(mixed))
+    except ReportError:
+        ok += 1
+    else:
+        raise AssertionError("a self-contradictory report must be refused, not compared")
+    for label, bad in (("empty report", "<testsuites></testsuites>"),
+                       ("unnamed testcase", '<testsuite><testcase classname="s"/></testsuite>'),
+                       ("wrong root", "<Foo/>")):
+        path = _fixture_text(label + ".xml", bad)
+        try:
+            parse_junit(path)
+        except ReportError:
+            ok += 1
+        else:
+            raise AssertionError(f"{label}: parse_junit accepted it")
+    config_problems = compare_config({"EXPAT_BUILD_TESTS": "ON"}, {"EXPAT_BUILD_TESTS": "OFF"})
+    if not config_problems:
+        raise AssertionError("a feature switch that differs must be a problem")
+    ok += 1
+    if compare_config({"CMAKE_C_COMPILER": "/usr/bin/gcc"},
+                      {"CMAKE_C_COMPILER": "/tmp/lccc"}):
+        raise AssertionError("the compiler under test is an allowed difference")
+    ok += 1
+    # The flags rule, in both directions.  The first pair is what `run.sh` actually
+    # passes today (`-I$(gcc -print-file-name=include)` on the lccc arm only) and
+    # must be accepted; the rest must be refused, because each one is a different
+    # *program* being compared and the JUnit rows alone would not show it.
+    gcc_flags = "-O2 -DNDEBUG"
+    # `-isystem <dir>` names a location and must normalise away like `-I<dir>`;
+    # a rule that only understands `-I<path>` would fail the real harness pair.
+    if compare_config({"CMAKE_C_FLAGS_RELEASE": "-O2 -DNDEBUG -isystem /tmp/a/inc"},
+                      {"CMAKE_C_FLAGS_RELEASE": "-O2 -DNDEBUG"}):
+        raise AssertionError("a spaced include-path argument must normalise too")
+    ok += 1
+    lccc_flags = "-O2 -DNDEBUG -I/usr/lib/gcc/x86_64-linux-gnu/14/include"
+    if compare_config({"CMAKE_C_FLAGS_RELEASE": gcc_flags},
+                      {"CMAKE_C_FLAGS_RELEASE": lccc_flags}):
+        raise AssertionError("a header path into each build tree is the allowed delta")
+    ok += 1
+    for label, other in (("-O0 instead of -O2", "-O0 -DNDEBUG"),
+                         ("-DNDEBUG dropped", "-O2"),
+                         ("-m32 appears on one side", "-O2 -DNDEBUG -m32"),
+                         ("-fwrapv appears on one side", "-O2 -DNDEBUG -fwrapv"),
+                         ("-UNDEBUG cancels the define", "-O2 -DNDEBUG -UNDEBUG"),
+                         ("empty on the candidate side", "")):
+        if not compare_config({"CMAKE_C_FLAGS_RELEASE": gcc_flags},
+                              {"CMAKE_C_FLAGS_RELEASE": other}):
+            raise AssertionError(f"{label}: a flag difference must be a problem")
+        ok += 1
+    if not compare_config({"CMAKE_C_FLAGS": gcc_flags}, {}):
+        raise AssertionError("a flags entry present on one side only must be a problem")
+    ok += 1
+    print(f"expat JUnit contract: {ok} checks passed")
+    return 0
+
+
+def _fixture_text(name: str, text: str) -> Path:
+    """A throwaway report file for the parse-level witnesses."""
+    path = Path(tempfile.mkdtemp(prefix="lccc-expat-junit-")) / name
+    path.write_text(text)
+    return path
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__,
+                                 formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--reference", type=Path)
+    ap.add_argument("--candidate", type=Path)
+    ap.add_argument("--reference-config", type=Path)
+    ap.add_argument("--candidate-config", type=Path)
+    ap.add_argument("--out", type=Path)
+    ap.add_argument("--self-test", action="store_true")
+    args = ap.parse_args(argv)
+    if args.self_test:
+        return self_test()
+    if not (args.reference and args.candidate):
+        ap.error("--reference and --candidate are required (or --self-test)")
+    reference = parse_junit(args.reference)
+    candidate = parse_junit(args.candidate)
+    result = compare(reference, candidate)
+    if args.reference_config and args.candidate_config:
+        problems = compare_config(config_manifest(args.reference_config.read_text()),
+                                  config_manifest(args.candidate_config.read_text()))
+        result["configuration_problems"] = problems
+        if problems:
+            result["comparable"] = False
+            result["problems"].extend(problems)
+    elif args.reference_config or args.candidate_config:
+        ap.error("--reference-config and --candidate-config come in pairs; a "
+                 "differential without both configurations is not comparable")
+    result["reference_path"] = str(args.reference)
+    result["candidate_path"] = str(args.candidate)
+    if args.out:
+        args.out.parent.mkdir(parents=True, exist_ok=True)
+        # A per-write temp name: the workload's own lock serialises writers, but
+        # a fixed `summary.json.tmp` in a shared artifact dir is one stray
+        # process away from two writers truncating each other.
+        tmp = args.out.with_name(f"{args.out.name}.tmp.{os.getpid()}")
+        tmp.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
+        tmp.replace(args.out)
+    print(json.dumps(result, indent=2, sort_keys=True))
+    return 0 if result["comparable"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
