+                    _ => ((source as i128) >> count) as u128,
+                };
+                let observed = execute(&split, &args, &[]);
+                assert_eq!(
+                    out_wide(&observed, 0),
+                    expected,
+                    "{op:?} by {count} {args:x?}"
