+fn parse_asm_i64(text: &str) -> Option<i64> {
+    let text = text.trim();
+    if let Some(hex) = text.strip_prefix("0x") {
+        i64::from_str_radix(hex, 16).ok()
+    } else if let Some(hex) = text.strip_prefix("-0x") {
+        i64::from_str_radix(hex, 16).ok()?.checked_neg()
+    } else {
+        text.parse().ok()
+    }
+}
