+ELF32_MODE=""   # native | runner | none | native-no-oracle
+probe_src="$WORK/elf32probe.c"
+probe_bin="$WORK/elf32probe.bin"
+cat > "$probe_src" <<'PEOF'
+void _start(void) {
+    __asm__ volatile ("int $0x80" : : "a"(1), "b"(42) : "memory");
+    __builtin_unreachable();
+}
+PEOF
