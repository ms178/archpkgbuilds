@@ -0,0 +1,30 @@
+# encdiff corpus verdict histogram — the aggregate coverage record of the
+# two 64-bit law corpora (index-fold-64 + data16-branches-64), as run by
+# the encdiff-corpus gate against the pinned binutils 2.47 pair
+# (as + objdump). Counts only, never bytes: this file records what the
+# corpus IS (which verdicts, how many rows), so that
+#   - a verdict DRIFT (a row silently slipping BEATS -> ok-best) cannot
+#     hide behind the gate's per-row exit contract,
+#   - a new row, a deleted row, or a brand-new verdict class forces a
+#     conscious baseline update in the same commit,
+# while a BEATS row staying BEATS through better bytes needs no update.
+# Update this file in the same commit that changes the corpus (or the
+# encoder in a way that shifts verdicts); the gate fails otherwise.
+#
+# Every verdict class is listed explicitly — zeros included — so a class
+# appearing from zero is also a baseline change.
+WRONG-BYTES 0
+UNVERIFIED-BEATS 0
+UNVERIFIED-BYTES 0
+REJECTS-VALID 0
+LONGER 0
+BEATS 174
+DISAGREE 0
+ok-best 0
+ok 21
+DECLINED-FP 0
+DECLINED-WRONG 0
+DECLINED-DATA16 0
+ORACLE-INVALID 10
+NO-ORACLE 0
+both-reject 0
diff --git a/tests/encdiff-corpus/index-fold-64.insn b/tests/encdiff-corpus/index-fold-64.insn
index bad22371..2fdc21b4 100644
--- a/tests/encdiff-corpus/index-fold-64.insn
+++ b/tests/encdiff-corpus/index-fold-64.insn
@@ -235,3 +235,36 @@ vmovdqu8 (,%r12,1), %xmm0
 vmovdqu64 64(,%r11,1), %xmm0
 {evex} vmovq (,%r10,1), %xmm0
 vmovdqu8 16(,%r13,1), %xmm0
+
+# APX x AVX-512 EVEX (the S18 oracle record): `gp_id' accepts r16-r31, so
+# the fold fires for EGPR indexes exactly like the classic rows -- the
+# extension bit moves X4 -> B4 with the slot -- and the fold output is
+# byte-identical to the base-form spelling that GAS 2.47 itself accepts
+# and emits. These rows ARE the CI oracle record for that law (until S18
+# the pins were lccc==lccc twins plus one-time manual probes; the gate
+# now runs every row against the pinned as+objdump 2.47 pair): each fold
+# row lands BEATS over GAS's 11-byte SIB+disp32 form with round-trip
+# verification, the base twin is ok. A UNVERIFIED-BYTES verdict here
+# means the ORACLE PAIR must be fixed, never the row deleted (the gate
+# exits 1 on UNVERIFIED-* by design).
+vmovdqu8 (,%r16,1), %xmm0
+vmovdqu8 (%r16), %xmm0
+vmovdqu8 (,%r20,1), %xmm0
+vmovdqu8 (,%r24,1), %xmm0
+vmovdqu64 (,%r18,1), %xmm0
+vmovdqu8 -16(,%r16,1), %xmm0
+{evex} vmovq (,%r16,1), %xmm0
+
+# The ebp half of the {rbp, ebp} flip set (S18): a 32-bit index in 64-bit
+# mode rides the 0x67 addr32 form; the fold moves ebp into the base slot,
+# flips the default segment DS -> SS, and the dead-byte law
+# (_ROW_SEG_FOLD) unifies lccc's folded view with GAS's raw view on
+# exactly these rows -- `ss:4(,%%ebp,1)' elides the 0x36 like `ss:4(%%ebp)'
+# (6 bytes, both views agree SS is default post-fold), while GAS's own
+# SIB form KEEPS it (raw view: no base, DS default, ss meaningful); the
+# ds twins mirror it with the 0x3e. The Rust twins of all four rows:
+# index_fold_tests::fold_decides_segment_elision_on_the_folded_view.
+mov %ss:4(,%ebp,1), %rax
+mov %ss:4(%ebp), %rax
+mov %ds:4(,%ebp,1), %rax
+mov %ds:4(%ebp), %rax
