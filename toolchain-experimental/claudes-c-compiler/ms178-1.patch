+            let trimmed = line.trim();
+            if let Some(symbol) = trimmed.strip_prefix("lccc_tls_call32 ") {
+                format!("    call *{}@TLSCALL(%eax)\n", symbol)
+            } else {
+                line.to_string()
+            }
+        })
+        .collect()
