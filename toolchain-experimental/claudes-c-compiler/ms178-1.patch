+// LLVM-exception).  Adapted into LCCC by scripts/edg_corpus_mine.py.
+//type: fn
+//options:  -DGNU -DGNU --c: --c++03 --c++: --c11 -DC11 -D__thread=_Thread_local -DC11 -D__thread=_Thread_local: --c++03 --c++ -DCXX11 -D__thread=thread_local: --c++11 --c++ -DC11 -D__thread=_Thread_local: --c++11 --c++: --c99 -D__thread=_Thread_local -DC99
+// RUN: %clang_cc1 -triple i686-pc-linux-gnu -fsyntax-only -Wno-private-extern -verify -pedantic %s -DGNU
+// RUN: %clang_cc1 -triple i686-pc-linux-gnu -fsyntax-only -Wno-private-extern -verify -pedantic -x c++ %s -DGNU -std=c++98
