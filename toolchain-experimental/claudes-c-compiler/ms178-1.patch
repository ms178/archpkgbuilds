From 8b06614c84a7f30d9020af210bb62648b5fe823b Mon Sep 17 00:00:00 2001
From: Z User <z@container>
Date: Sat, 26 Sep 2026 23:09:09 +0000
Subject: [PATCH 4/4] backend: confine the epoch-discipline opt-in to the crate
 that owns it

CodegenState::enable_rax_epoch_discipline is the flag that scopes the
%rax shadow-epoch assertion to the x86 family: arming it on a foreign
ISA is exactly the false-assertion exposure the flag exists to prevent
(the sink classifier speaks AT&T x86 only - a RISC-V call/mul/div line
moves the implicit-write table unconditionally). The doc already said
foreign-ISA backends must NOT call it; a must-not-call 'pub' API is a
documented bug waiting to compile. pub(crate) makes the constraint
mechanical: only the crate owning the x86-64 and i686 constructors can
arm the validator, and the must-not-call rule becomes a visibility rule
the compiler enforces.

No callers change: the two constructors are in-crate, and no test or
tool armed the flag directly (grep-verified).

1 file, +5/-1.
---
 src/backend/state.rs | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/backend/state.rs b/src/backend/state.rs
index e5b851eb..0baa723c 100644
--- a/src/backend/state.rs
+++ b/src/backend/state.rs
@@ -1273,8 +1273,12 @@ impl CodegenState {
     /// constructors. Foreign-ISA backends (AArch64, RISC-V) must NOT call
     /// this: their assembly is not AT&T x86 and the classifier's
     /// vocabulary cannot describe it (see `AsmOutput::rax_epoch_active`).
+    /// `pub(crate)` enforces exactly that: the flag is load-bearing for
+    /// the ASSERTION's soundness, so arming it must stay reviewable inside
+    /// the crate that owns the two constructors — a must-not-call API
+    /// visible beyond the crate is a documented bug waiting to compile.
     #[inline]
-    pub fn enable_rax_epoch_discipline(&mut self) {
+    pub(crate) fn enable_rax_epoch_discipline(&mut self) {
         #[cfg(debug_assertions)]
         {
             self.out.rax_epoch_active = true;
