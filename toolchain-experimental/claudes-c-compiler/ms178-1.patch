+    /// ```text
+    /// T(k) = max( latency,                          // each chain: 1 op / iteration
+    ///             (k·uops + 2) / dispatch_width,    // front end (+ IV add, fused cmp/jcc)
+    ///             k·loads / loads_per_cycle,         // L1D load ports
