+            Instruction::BinOp {
+                dest: Value(8),
+                op: IrBinOp::Add,
+                lhs: Operand::Value(Value(3)),
+                rhs: Operand::Const(IrConst::I32(1)),
+                ty: IrType::I32,
+            },
+        ];
+        let mut func = loop_fixture(body, 8, 10);
+        let changes = ivsr_function(&mut func);
