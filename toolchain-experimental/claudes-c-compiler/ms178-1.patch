+/// Parse `subq $N, %rsp` (constant adjustment only).
+fn parse_subq_rsp(line: &str) -> Option<i64> {
+    let rest = line.strip_prefix("subq $")?;
+    let val = rest.strip_suffix(", %rsp")?;
+    val.parse::<i64>().ok()
+}
