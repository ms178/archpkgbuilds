+
+void f1(void) {
+  // PR7673: Some versions of GCC support an empty clobbers section.
+  asm ("ret" : : :);
+}
+
+void f2(void) {
+  asm("foo" : "=r" (a)); // expected-error {{use of undeclared identifier 'a'}}
+  asm("foo" : : "r" (b)); // expected-error {{use of undeclared identifier 'b'}} 
