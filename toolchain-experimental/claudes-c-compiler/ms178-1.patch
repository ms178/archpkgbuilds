+                    Some(slot) => Ok(slot),
+                    None if matches!(
+                        n.as_str(),
+                        "ax" | "al" | "cx" | "cl" | "dx" | "dl" | "bx" | "bl"
+                    ) =>
+                    {
+                        Err(size_err())
+                    }
+                    None => Err(type_err()),
+                }
+            }
+            _ => Err(type_err()),
+        })
+        .collect::<Result<_, _>>()?;
+    match (mnemonic, regs.as_slice()) {
+        ("monitor" | "monitorx", [(0, w0), (1, w1), (2, w2)]) => {
+            if w1 != w2 {
+                return Err(type_err());
+            }
+            Ok(*w0 == 4)
