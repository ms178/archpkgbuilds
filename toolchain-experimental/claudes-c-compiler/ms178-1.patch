+    fi
+  fi
+}
+
 echo "LD   setup.elf (lccc-ld)"
-"$LCCC_LD" -m elf_i386 -z noexecstack -T arch/x86/boot/setup.ld \
-    "${OBJS[@]}" -o "$OUT/setup.elf"
+if "$LCCC_LD" -m elf_i386 -z noexecstack -T arch/x86/boot/setup.ld \
