diff --git a/tests/regression/frontend_hex_float_exp.c b/tests/regression/frontend_hex_float_exp.c
new file mode 100644
index 0000000..407f829
--- /dev/null
+++ b/tests/regression/frontend_hex_float_exp.c
@@ -0,0 +1,8 @@
+/* Hex float still parses (exp path uses digit accumulate). */
+int main(void) {
+    double d = 0x1.0p+0;
+    if (d != 1.0) return 1;
+    double e = 0x1p4;
+    if (e != 16.0) return 2;
+    return 0;
+}
diff --git a/tests/regression/frontend_string_concat_expr.c b/tests/regression/frontend_string_concat_expr.c
new file mode 100644
index 0000000..5701ab2
--- /dev/null
+++ b/tests/regression/frontend_string_concat_expr.c
@@ -0,0 +1,9 @@
+/* Adjacent string literal concatenation in expressions. */
+#include <stdio.h>
+int main(void) {
+    const char *s = "hel" "lo" "!" ;
+    if (s[0] != 'h' || s[4] != 'o' || s[5] != '!') return 1;
+    const char *t = "a" "b";
+    if (t[0] != 'a' || t[1] != 'b') return 2;
+    return 0;
+}
