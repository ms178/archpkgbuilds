+            .map(|r| (r.offset, r.reloc_type))
+            .collect();
+        assert_eq!(
+            relocs,
+            [
+                (0, 541),
+                (4, 542),
+                (8, 562),
+                (12, 563),
+                (16, 564),
+                (20, 569),
+                (24, 541),
+                (28, 542),
+                (32, 286)
+            ]
+        );
+        assert!(text.relocs.iter().all(|r| r.symbol_name == "v"));
+    }
