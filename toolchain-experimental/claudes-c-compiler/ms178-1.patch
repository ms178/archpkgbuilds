+/* pcre2 compile_branch stack-frame bloat regression.
+ *
+ * 1290 simultaneously-live 32-bit values around a call + deep recursion:
+ * with the historical 8-byte minimum slot the frame was 10320 bytes and
+ * 792 recursion levels overflowed the 8 MiB stack (pcre2 test 8,
+ * compile_branch with 792 nested parens). Width-partitioned 4-byte
+ * spill slots halve the frame; this test both computes the right value
+ * AND survives 850 levels of recursion within the default stack limit.
+ * GCC frame for comparison: 616 bytes at -O1. */
+#include <stdio.h>
+int sink(int x) { return x + 1; }
+int recurse(int n) {
+    int v0 = n + 0;
+    int v1 = n + 1;
+    int v2 = n + 2;
+    [... 1284 mechanically generated lines: int v3..v1289 = n + <i>; ...]
+    int s = v0;
+    s += v1;
+    [... s += v2 .. v1289 ...]
+    s += sink(s);
+    [... s ^= v0 + 0; s ^= v4 + 4; ... every 4th value ...]
+    int r = 0;
+    if (n > 0) r = recurse(n - 1);
+    return s + r + 1;
+}
+int main(void) { printf("%d\n", recurse(850)); return 0; }
