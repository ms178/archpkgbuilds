+    let iv_back = fresh();
+    body_insts.push(Instruction::BinOp {
+        dest: iv_back,
+        op: IrBinOp::Add,
+        lhs: Operand::Value(iv_vals[k - 1]),
+        rhs: Operand::Const(IrConst::from_i64(iv_step, iv_ty)),
+        ty: iv_ty,
+    });
