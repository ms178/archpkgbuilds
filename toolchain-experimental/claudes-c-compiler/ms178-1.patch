From 93b3dc650d3678a94d0dc90d7afdb5cdca82b5ec Mon Sep 17 00:00:00 2001
From: ms178 <ms178@users.noreply.github.com>
Date: Fri, 28 Aug 2026 18:25:26 +0000
Subject: [PATCH 5/7] riscv: store the accumulator, not saved-acc t3, in typed
 indirect stores
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

emit_store_default's Indirect/Reg arms resolve the target address into
t5 and load the VALUE into the accumulator via emit_load_operand ->
operand_to_t0, but RISC-V's emit_typed_store_indirect stored t3 — the
emit_save_acc scratch — which holds an unrelated value unless the
producer explicitly saved it. Every indirect store whose value was
simply live in the accumulator wrote garbage (observed: F64 array
element stores computed correct bits into t0 and then stored stale t3;
vex_move_false_dep and any array-of-double code miscompiled on riscv64).

ARM hit this same trap and its emit_typed_store_indirect already
documents the fix ("Using x1 here stores an unrelated value for globals,
heap fields, and all other indirect destinations"); RISC-V never
received the equivalent.

Validation: riscv64 array-store probes and the FP-chain differential now
match GCC output exactly (were 0.0/garbage); ARM 375/32/75 and x86 537/5
suites unchanged.
---
 src/backend/riscv/codegen/emit.rs | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/backend/riscv/codegen/emit.rs b/src/backend/riscv/codegen/emit.rs
index ddb80725..cd6bf10e 100644
--- a/src/backend/riscv/codegen/emit.rs
+++ b/src/backend/riscv/codegen/emit.rs
@@ -695,7 +695,12 @@ impl ArchCodegen for RiscvCodegen {
         self.state.emit("    mv t3, t0");
     }
     fn emit_typed_store_indirect(&mut self, instr: &'static str, _ty: IrType) {
-        self.state.emit_fmt(format_args!("    {} t3, 0(t5)", instr));
+        // The value rides the accumulator (t0) per the emit_store_default
+        // contract (emit_load_operand -> operand_to_t0); t3 is the SAVED-acc
+        // scratch and holds an unrelated value here. Storing t3 wrote
+        // garbage for every indirect store whose value wasn't explicitly
+        // saved first (observed: F64 array element stores on riscv64).
+        self.state.emit_fmt(format_args!("    {} t0, 0(t5)", instr));
     }
     fn emit_typed_load_indirect(&mut self, instr: &'static str) {
         self.state.emit_fmt(format_args!("    {} t0, 0(t5)", instr));
-- 
