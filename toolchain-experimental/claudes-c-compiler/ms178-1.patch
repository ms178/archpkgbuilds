+                        op: IrCmpOp::Slt,
+                        lhs: Operand::Value(Value(5)),
+                        rhs: Operand::Const(IrConst::I64(3)),
+                        ty: IrType::I64,
+                    },
+                ],
+                Terminator::CondBranch {
