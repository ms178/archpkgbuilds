+            format!(
+                "{}: REL addend {} exceeds 32 bits",
+                section.name, reloc.addend
+            )
+        })?;
+        let value =
+            i32::from_le_bytes([field[0], field[1], field[2], field[3]]).wrapping_add(addend);
+        field.copy_from_slice(&value.to_le_bytes());
+        reloc.addend = 0;
+    }
