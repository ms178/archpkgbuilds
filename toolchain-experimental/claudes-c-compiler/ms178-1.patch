@@ -0,0 +1,136 @@
+#!/usr/bin/env bash
+# A `const volatile` object is a volatile object at every read: C11 6.7.3p7
+# requires each access of a volatile lvalue to be evaluated strictly by the
+# abstract machine, so `cvi + cvi` reads the object twice. The `const` qualifier
+# only forbids writes; it must not make the object a compile-time constant.
+#
+# Sema used to record a folded value for every const object with a constant
+# initializer, volatile ones included, and lowering cached `const` locals the
+# same way. Both folded the reads away (`cvi + cvi` became 2, `(int)cvi + 1`
+# became 1, and `const volatile int lv = 1; lv + lv` became 2). Probes cover
+# globals, a cast, a typedef-qualified object, a `const volatile` member of a
+# `const` struct object, and a local.
+#
+# Non-volatile const objects must still fold: their reads are not accesses, so
+# the fold is correct and the control probes pin zero memory references.
+#
+# The check counts, per function at -O2, the memory-operand references (loads
+# and stores). lccc must match GCC 16.2 on every probe, and each probe's GCC
+# count is pinned, so a fixture drift is reported as drift, not as a lccc bug.
+#
+# One documented exception: `f_field_twice` reads the `const volatile` member
+# `f` of a `const struct` global. GCC 16.2 folds that read to 2 (no memory
+# reference), which C11 6.7.3p7 does not allow. lccc keeps the read, as the
+# standard requires, and the pinned lccc count is 1. A GCC/standard divergence
+# is reported here, not silently matched.
+#
+# At -O0 every local lives in the stack frame, so whole-function counts are
+# not meaningful. The -O0 check counts references to the global symbol only.
+set -euo pipefail
+. tests/regression/lib/gcc_oracle.sh
+require_gcc_oracle check_const_volatile_objects || exit 1
+
+CCC=${CCC:-target/fastbuild/lccc}
+[[ -x $CCC ]] || { echo "check_const_volatile_objects: FAIL: compiler not found at $CCC" >&2; exit 1; }
+tmp=$(mktemp -d "${TMPDIR:-/tmp}/lccc-cvo.XXXXXX")
+trap 'rm -rf "$tmp"' EXIT
+gcc_oracle_positive_control "$CCC" "$tmp" || exit 1
+gcc_oracle_positive_control "$GCC_ORACLE_BIN" "$tmp" || exit 1
+
+src=$tmp/cvo.c
+cat > "$src" <<'C'
+const volatile int cvi = 1;
+const volatile double cvd = 1.0;
+typedef const volatile int CVI;
+CVI tci = 1;
+typedef volatile int VI;
+const VI tvi = 1;
+struct cs { const volatile int f; };
+const struct cs csv = { 1 };
+const double kd = 1.0;
+const int ci = 2;
+int f_cvi_twice(void) { return cvi + cvi; }
+int f_cvd_cast(void) { return (int)cvd; }
+int f_cvi_plus(void) { return (int)cvi + 1; }
+int f_typedef_twice(void) { return tci + tci; }
+int f_typedef_vol_const(void) { return tvi + tvi; }
+int f_field_twice(void) { return csv.f + csv.f; }
+int f_local(void) { const volatile int lv = 1; return lv + lv; }
+int f_fold_double(void) { return (int)kd; }
+int f_fold_int(void) { return ci + ci; }
+int f_fold_ptr_ok(void) { const int *p = &ci; return *p; }
+C
+
+# Memory-operand references: every instruction that reads or writes memory.
+# The mnemonic may contain digits (`cvttsd2si`), and directives are skipped.
+count_mem_refs() {
+    awk -v want="$2" '
+        /^[A-Za-z_][A-Za-z0-9_]*:/ { fn = $0; sub(/:.*/, "", fn) }
+        /^[ \t]+[a-z][a-z0-9]*[ \t]/ && !/^[ \t]+\./ && fn == want && /\(%/ { n++ }
+        END { print n + 0 }' "$1"
+}
+# References to one global symbol inside one function (for -O0).
+count_sym_refs() {
+    awk -v want="$2" -v sym="$3" '
+        /^[A-Za-z_][A-Za-z0-9_]*:/ { fn = $0; sub(/:.*/, "", fn) }
+        fn == want && index($0, sym "(%rip)") > 0 { n++ }
+        END { print n + 0 }' "$1"
+}
+
+fail=0
+"$GCC_ORACLE_BIN" -O2 -S -o "$tmp/gcc.s" "$src"
+"$CCC" -O2 -S "$src" -o "$tmp/lccc.s"
+
+# function:pinned-GCC-count. Non-volatile controls pin 0 (folded).
+for probe in f_cvi_twice:2 f_cvd_cast:1 f_cvi_plus:1 f_typedef_twice:2 \
+    f_typedef_vol_const:2 f_local:3 f_fold_double:0 f_fold_int:0 f_fold_ptr_ok:0; do
+    fn=${probe%%:*}
+    want=${probe##*:}
+    g=$(count_mem_refs "$tmp/gcc.s" "$fn")
+    l=$(count_mem_refs "$tmp/lccc.s" "$fn")
+    if [[ $g != "$want" ]]; then
+        echo "FAIL $fn: GCC 16.2 memory-reference count is $g, the probe pins $want (fixture drift)" >&2
+        fail=$((fail + 1))
+    elif [[ $l != "$g" ]]; then
+        echo "FAIL $fn: lccc memory-reference count is $l, GCC 16.2 keeps $g" >&2
+        sed -n "/^$fn:/,/\\.size $fn,/p" "$tmp/lccc.s" >&2
+        fail=$((fail + 1))
+    fi
+done
+
+# Documented GCC/standard divergence: GCC folds the volatile member, lccc must
+# keep both reads as C11 6.7.3p7 requires. The pinned GCC count shows the fold.
+g=$(count_mem_refs "$tmp/gcc.s" f_field_twice)
+l=$(count_mem_refs "$tmp/lccc.s" f_field_twice)
+if [[ $g != 0 ]]; then
+    echo "FAIL f_field_twice: GCC 16.2 count is $g; the documented divergence pins 0 (fixture or GCC drift)" >&2
+    fail=$((fail + 1))
+elif [[ $l != 1 ]]; then
+    echo "FAIL f_field_twice: lccc memory-reference count is $l; the standard requires both volatile reads (pinned 1 load, the second read is reused from the first)" >&2
+    sed -n "/^f_field_twice:/,/\\.size f_field_twice,/p" "$tmp/lccc.s" >&2
+    fail=$((fail + 1))
+fi
+
+# -O0: symbol-specific reference counts. Each volatile read is one reference.
+"$GCC_ORACLE_BIN" -O0 -S -o "$tmp/gcc0.s" "$src"
+"$CCC" -O0 -S "$src" -o "$tmp/lccc0.s"
+for probe in f_cvi_twice:cvi:2 f_cvi_plus:cvi:1 f_cvd_cast:cvd:1 f_typedef_twice:tci:2; do
+    fn=$(echo "$probe" | cut -d: -f1)
+    sym=$(echo "$probe" | cut -d: -f2)
+    want=$(echo "$probe" | cut -d: -f3)
+    g=$(count_sym_refs "$tmp/gcc0.s" "$fn" "$sym")
+    l=$(count_sym_refs "$tmp/lccc0.s" "$fn" "$sym")
+    if [[ $g != "$want" ]]; then
+        echo "FAIL $fn at -O0: GCC 16.2 references $sym $g times, the probe pins $want (fixture drift)" >&2
+        fail=$((fail + 1))
+    elif [[ $l != "$g" ]]; then
+        echo "FAIL $fn at -O0: lccc references $sym $l times, GCC 16.2 references it $g times" >&2
+        fail=$((fail + 1))
+    fi
+done
+
+if (( fail > 0 )); then
+    echo "check_const_volatile_objects: FAILED ($fail)" >&2
+    exit 1
+fi
+echo "check_const_volatile_objects: PASSED (10 functions at -O2 and 4 symbol checks at -O0; volatile reads match GCC 16.2, non-volatile const controls still fold)"
diff --git a/tests/regression/check_cpu_supports_runtime.sh b/tests/regression/check_cpu_supports_runtime.sh
index 8ff64a92..dde38f77 100755
--- a/tests/regression/check_cpu_supports_runtime.sh
+++ b/tests/regression/check_cpu_supports_runtime.sh
@@ -269,16 +269,36 @@ cat >"$td/cross.c" <<'EOF'
 int f(void) { return __builtin_cpu_supports("avx2"); }
 int main(void) { return f(); }
 EOF
+# AUD-CPU-1 (3): an x86 feature NAME on a target that cannot answer it is a
+# diagnostic, not a silent 0 -- GCC's non-x86 builtin accepts only its own
+# architecture's names, and folding `avx2` to 0 turns a dispatch test into a
+# silent slow path.  Names from other architectures' sets keep the conservative
+# 0 (below), because LCCC does not model those names yet and rejecting them
+# would turn accepted GCC code into a compile error.
 for pair in "aarch64:$CCC_ARM" "riscv64:$CCC_RISCV"; do
     arch=${pair%%:*}; cc=${pair#*:}
     if [ -x "$cc" ]; then
         if "$cc" -O2 -c "$td/cross.c" -o /dev/null 2>"$td/cross.err"; then
-            ok "$arch: builtin compiles (conservative 0, no x86 probe)"
+            bad "$arch: an x86 feature name compiled (expected a diagnostic)"
+        elif grep -qF "parameter to builtin not valid: avx2" "$td/cross.err"; then
+            ok "$arch: x86 feature name diagnosed, not folded"
         else
-            bad "$arch: builtin does not compile"; head -3 "$td/cross.err" | sed 's/^/      /'
+            bad "$arch: not diagnosed with the builtin's own wording"
+            head -3 "$td/cross.err" | sed 's/^/      /'
+        fi
+        # A name this backend does not model (GCC's per-architecture set) still
+        # folds to the conservative 0 rather than being rejected.
+        cat >"$td/cross_other.c" <<'EOF'
+int f(void) { return __builtin_cpu_supports("crypto"); }
+EOF
+        if "$cc" -O2 -c "$td/cross_other.c" -o /dev/null 2>"$td/cross_other.err"; then
+            ok "$arch: an unmodelled architecture-specific name still folds"
+        else
+            bad "$arch: an unmodelled name is rejected"
+            head -3 "$td/cross_other.err" | sed 's/^/      /'
         fi
     else
-        echo "SKIP $arch row (no $cc)"
+        echo "SKIP $arch rows (no $cc)"
     fi
 done
 
diff --git a/tests/regression/check_cross_target_intrinsic_trap.sh b/tests/regression/check_cross_target_intrinsic_trap.sh
new file mode 100755
index 00000000..e06babb6
--- /dev/null
+++ b/tests/regression/check_cross_target_intrinsic_trap.sh
@@ -0,0 +1,226 @@
+#!/usr/bin/env bash
+# AUD-SILENT-ZERO-1: an intrinsic the target cannot execute must fail LOUDLY.
+#
+# The AArch64 and RISC-V intrinsic emitters carried an "x86-only" arm that
+# answered "zero dest if present": 16 bytes of zeros stored ONLY when the
+# destination was a known stack slot, and NOTHING AT ALL when it was
+# register-allocated.  Compiling an x86 intrinsic for either target therefore
+# produced a wrong value with rc=0 and no diagnostic (measured: `stp xzr, xzr,
+# [x9]` / `sd zero,`).  Two layers now stand against that, and both are pinned
+# here:
+#
+#   1. THE COMPILE-TIME CONTRACT.  Lowering rejects an x86-only builtin on a
+#      target that is not x86, naming the builtin and the architecture, and the
+#      driver fails the translation unit (rc=1) -- GCC rejects the same
+#      programs, because the name does not exist there.  Code that guards the
+#      call with `#ifdef __x86_64__` still compiles: the diagnostic fires only
+#      when the call is actually lowered.
+#
+#   2. THE BACKEND SAFETY NET.  The emitters no longer contain a silent arm or
+#      an `unimplemented!` ICE: an unlowerable op emits the target's own trap
+#      (`brk #0` / `ebreak`), so a future frontend gate that leaks one through
+#      yields a program that dies at the instruction instead of computing
+#      garbage.  This host cannot execute AArch64/RISC-V code (no qemu), so the
+#      trap is pinned where a runtime test cannot reach it: the instruction
+#      stream AND the encoded object (a trap the assembler rejects would be
+#      worse than the zeros it replaced).
+#
+# A pre-fix compiler fails at (1) with rc=0 and no message, and its object has
+# no trap encoding at all.
+set -euo pipefail
+
+repo=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
+ccc=${CCC:-$repo/target/fastbuild/lccc}
+ccc_arm=${CCC_ARM:-$repo/target/fastbuild/lccc-arm}
+ccc_riscv=${CCC_RISCV:-$repo/target/fastbuild/lccc-riscv}
+ccc_i686=${CCC_I686:-$repo/target/fastbuild/lccc-i686}
+src=$repo/tests/regression/cross_target_intrinsics/x86_only.c
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+
+for tool in "$ccc_arm" "$ccc_riscv" "$ccc_i686" "$ccc"; do
+    [ -x "$tool" ] || { echo "SKIP: $tool not built" >&2; exit 0; }
+done
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+function_body() {
+    local function=$1 file=$2
+    awk -v wanted="$function" '
+        $0 == wanted ":" { active=1 }
+        active { print }
+        active && $0 == ".size " wanted ", .-" wanted { exit }
+    ' "$file"
+}
+
+# Assert one of the given encodings is present in the object's EXECUTABLE
+# sections.  A whole-file byte search would be satisfied by a coincidental
+# pattern in a symbol table, so the section table is walked properly, and both
+# the full and the compressed (halfword) form of a value are accepted.
+trap_in_object() {
+    local object=$1
+    shift
+    python3 - "$object" "$@" <<'PYEOF'
+import struct
+import sys
+
+path, *wanted = sys.argv[1:]
+data = open(path, 'rb').read()
+if data[:4] != b'\x7fELF':
+    sys.exit(f'{path}: not an ELF file')
+is64 = data[4] == 2
+little = data[5] == 1
+end = '<' if little else '>'
+if is64:
+    (e_shoff,) = struct.unpack_from(end + 'Q', data, 0x28)
+    e_shentsize, e_shnum, e_shstrndx = struct.unpack_from(end + 'HHH', data, 0x3A)
+    fmt = end + 'IIQQQQIIQQ'
+else:
+    (e_shoff,) = struct.unpack_from(end + 'I', data, 0x20)
+    e_shentsize, e_shnum, e_shstrndx = struct.unpack_from(end + 'HHH', data, 0x2E)
+    fmt = end + 'IIIIIIIIII'
+
+
+def section(index):
+    return struct.unpack_from(fmt, data, e_shoff + index * e_shentsize)
+
+
+_, _, _, _, str_off, str_size, _, _, _, _ = section(e_shstrndx)
+strtab = data[str_off:str_off + str_size]
+
+code = b''
+for i in range(e_shnum):
+    name_off = section(i)[0]
+    sh_flags, sh_offset, sh_size = section(i)[2], section(i)[4], section(i)[5]
+    name = strtab[name_off:strtab.index(b'\0', name_off)].decode() if name_off < len(strtab) else ''
+    if sh_flags & 0x4 and sh_flags & 0x2:              # SHF_EXECINSTR | SHF_ALLOC
+        code += data[sh_offset:sh_offset + sh_size]
+        _ = name
+
+for word in wanted:
+    value = int(word, 0)
+    for width in (4, 2):                               # full and compressed form
+        if value >= 1 << (8 * width):
+            continue
+        packed = struct.pack(end + 'I', value)
+        if (packed if little else packed[::-1])[:width] in code or packed[:width] in code:
+            sys.exit(0)
+print(f'{path}: none of {" ".join(wanted)} is encoded in an executable section', file=sys.stderr)
+sys.exit(1)
+PYEOF
+}
+
+# 1. The compile-time contract: x86-only builtins are unavailable off x86, and
+#    the message says which builtin and which architecture.  The i686/riscv
+#    spelling of the target name comes from the same helper the diagnostic uses.
+for opt in -O0 -O2; do
+    for pair in "arm:$ccc_arm:aarch64" "riscv:$ccc_riscv:riscv64"; do
+        label=${pair%%:*}; rest=${pair#*:}; tool=${rest%%:*}; arch=${rest##*:}
+        # Capture first: reading the exit status of a pipeline would report the
+        # last stage, and `set -o pipefail` makes `producer | grep -q` a
+        # self-inflicted red (the repo gates that shape explicitly).
+        set +e
+        err=$("$tool" "$opt" -S "$src" -o "$tmp/$label$opt.s" 2>&1)
+        rc=$?
+        set -e
+        [ "$rc" -eq 1 ] ||
+            fail "lccc-$label $opt: x86-only intrinsic compiled with rc=$rc (expected 1)"
+        # The rejection must name the target architecture (GCC's own shape:
+        # "'_mm_add_ps' is not available on aarch64") — the wording itself is
+        # the compiler's, the contract is that the user learns both which
+        # builtin and which target.
+        grep -qF "is not available on $arch" <<<"$err" ||
+            { printf '%s\n' "$err" >&2;
+              fail "lccc-$label $opt: diagnostic does not name the builtin's target ($arch)"; }
+        grep -qF "__builtin_ia32_aesenc128" <<<"$err" ||
+            { printf '%s\n' "$err" >&2;
+              fail "lccc-$label $opt: diagnostic does not name the builtin"; }
+        grep -qE "internal error|panicked" <<<"$err" &&
+            { printf '%s\n' "$err" >&2; fail "lccc-$label $opt: internal error instead of a diagnostic"; }
+        true
+    done
+done
+
+# 1b. The same contract, family by family: one representative of every x86-only
+#     family the frontend accepts (AES-NI, PCLMUL, CRC32, VAES-256, VPCLMULQDQ,
+#     AVX float/double, AVX2 broadcast, and the no-operand VEX op the AArch64
+#     catch-all used to swallow silently).  Counting the diagnostics is the
+#     point: nine functions must produce nine independent rejections, so a gate
+#     that accidentally only checks the first one cannot pass.
+families=$repo/tests/regression/cross_target_intrinsics/x86_families.c
+family_count=$(grep -c '^[a-z].*x86_fam_' "$families")
+for opt in -O0 -O2; do
+    for pair in "arm:$ccc_arm:aarch64" "riscv:$ccc_riscv:riscv64"; do
+        label=${pair%%:*}; rest=${pair#*:}; tool=${rest%%:*}; arch=${rest##*:}
+        set +e
+        err=$("$tool" "$opt" -S "$families" -o "$tmp/fam-$label$opt.s" 2>&1)
+        rc=$?
+        set -e
+        [ "$rc" -eq 1 ] ||
+            fail "lccc-$label $opt: an x86-only intrinsic family compiled with rc=$rc (expected 1)"
+        got=$(grep -cF "is not available on $arch" <<<"$err" || true)
+        [ "$got" -eq "$family_count" ] ||
+            { printf '%s\n' "$err" >&2;
+              fail "lccc-$label $opt: $got of $family_count families were rejected with a diagnostic"; }
+        grep -qE "internal error|panicked" <<<"$err" &&
+            { printf '%s\n' "$err" >&2; fail "lccc-$label $opt: internal error instead of a diagnostic"; }
+        true
+    done
+done
+
+# 2. Portable builtins are NOT collateral damage: the same file's
+#    portable_sqrt/portable_fabs must still compile for every target.
+for opt in -O0 -O2; do
+    tag=${opt#-}
+    for tool in "$ccc_arm" "$ccc_riscv" "$ccc_i686" "$ccc"; do
+        out=$tmp/portable-$(basename "$tool")$tag.s
+        "$tool" "$opt" -S "$repo/tests/regression/cross_target_intrinsics/portable_only.c" -o "$out" 2>"$out.err" ||
+            { cat "$out.err" >&2; fail "$(basename "$tool") $opt: rejected a portable builtin"; }
+    done
+    # Each non-x86 target must still LOWER the portable builtin, not merely
+    # accept the file: asserting the arch's own square-root instruction is what
+    # separates "the target gate spared this builtin" from "it produced
+    # something".
+    body=$(function_body portable_sqrt "$tmp/portable-$(basename "$ccc_arm")$tag.s")
+    grep -qE '^[[:space:]]+fsqrt[[:space:]]' <<<"$body" ||
+        fail "AArch64 $opt: portable_sqrt no longer lowers to fsqrt"
+    body=$(function_body portable_sqrt "$tmp/portable-$(basename "$ccc_riscv")$tag.s")
+    grep -qE '^[[:space:]]+fsqrt' <<<"$body" ||
+        fail "RISC-V $opt: portable_sqrt no longer lowers to fsqrt"
+done
+
+# 3. Positive controls: an x86 target that HAS the extension keeps lowering the
+#    intrinsic.  AUD-CPU-3 is what makes `-maes` necessary here, and the
+#    i686 leg proves the target gate did not turn into "reject on 32-bit".
+for spec in "$ccc:-maes:" "$ccc_i686:-maes:"; do
+    tool=${spec%%:*}; flag=${spec#*:}; flag=${flag%%:*}
+    out=$tmp/$(basename "$tool").s
+    "$tool" -O2 "$flag" -S "$src" -o "$out" 2>"$out.err" ||
+        { cat "$out.err" >&2; fail "$(basename "$tool"): rejected an intrinsic this target supports"; }
+    grep -qE '^[[:space:]]+v?aesenc([[:space:]]|$)' "$out" ||
+        { printf '%s\n' "$(function_body x86_only_enc "$out")" >&2;
+          fail "$(basename "$tool"): AES-NI intrinsic no longer lowers to aesenc"; }
+done
+
+# 4. The safety net itself: the target's trap must assemble and encode.  The
+#    intrinsic path is no longer reachable from source (layer 1 rejects it
+#    first), so this pins the mechanism the emitters rely on -- an explicit
+#    trap, which is the same instruction `emit_unreachable` emits for an
+#    unlowerable op.
+for spec in "arm:$ccc_arm:0xd4200000" "riscv:$ccc_riscv:0x00100073"; do
+    label=${spec%%:*}; rest=${spec#*:}; tool=${rest%%:*}; enc=${rest##*:}
+    printf 'void lccc_trap_probe(void) { __builtin_trap(); }\n' >"$tmp/trap.c"
+    "$tool" -O1 -S "$tmp/trap.c" -o "$tmp/trap-$label.s"
+    body=$(function_body lccc_trap_probe "$tmp/trap-$label.s")
+    case $label in
+        arm) grep -qE '^[[:space:]]+brk[[:space:]]' <<<"$body" ||
+                 { printf '%s\n' "$body" >&2; fail "AArch64: the trap is no longer brk"; } ;;
+        riscv) grep -qE '^[[:space:]]+ebreak$' <<<"$body" ||
+                 { printf '%s\n' "$body" >&2; fail "RISC-V: the trap is no longer ebreak"; } ;;
+    esac
+    "$tool" -O1 -c "$tmp/trap.c" -o "$tmp/trap-$label.o"
+    trap_in_object "$tmp/trap-$label.o" "$enc" ||
+        fail "$label: the trap is not encoded in the object"
+done
+
+echo "PASS: x86-only intrinsics are rejected off x86 with a diagnostic, portable ones lower, and the trap safety net encodes"
diff --git a/tests/regression/check_designator_init.sh b/tests/regression/check_designator_init.sh
new file mode 100755
index 00000000..c82c2c8f
--- /dev/null
+++ b/tests/regression/check_designator_init.sh
@@ -0,0 +1,56 @@
+#!/usr/bin/env bash
+# Designator validity in braced initializers (C11 6.7.9p2-p6).
+#
+# A `.name` designator must name a member (searching anonymous members); a
+# `[i]` designator must be a non-negative index within a known array length.
+# Rows are in tests/regression/designator_init/cases.tsv and were measured
+# against GCC 16.2. Each row is checked twice:
+#   * the oracle must still give the recorded verdict (drift check), and
+#   * lccc must give the same verdict; a rejection must carry the diagnostic.
+# The oracle is GCC 16.2 (tests/regression/lib/gcc_oracle.sh). A missing oracle
+# fails the gate; it is never skipped.
+set -euo pipefail
+. tests/regression/lib/gcc_oracle.sh
+require_gcc_oracle check_designator_init || exit 1
+
+CCC=${CCC:-target/fastbuild/lccc}
+cases=tests/regression/designator_init/cases.tsv
+[[ -x $CCC ]] || { echo "check_designator_init: FAIL: compiler not found at $CCC" >&2; exit 1; }
+
+tmp=$(mktemp -d "${TMPDIR:-/tmp}/lccc-designator.XXXXXX")
+trap 'rm -rf "$tmp"' EXIT
+gcc_oracle_positive_control "$CCC" "$tmp" || exit 1
+gcc_oracle_positive_control "$GCC_ORACLE_BIN" "$tmp" || exit 1
+
+fail=0 rows=0
+while IFS=$'\t' read -r id expect diag body; do
+    [[ -z $id || $id == \#* ]] && continue
+    rows=$((rows + 1))
+    tu=$tmp/$id.c
+    printf '%s\n' "$body" > "$tu"
+
+    if "$GCC_ORACLE_BIN" -fsyntax-only -w "$tu" >/dev/null 2>&1; then gv=accept; else gv=reject; fi
+    if [[ $gv != "$expect" ]]; then
+        echo "FAIL $id: oracle drift: GCC 16.2 says $gv, the table says $expect" >&2
+        fail=$((fail + 1)); continue
+    fi
+
+    lerr=$tmp/$id.err
+    if "$CCC" -fsyntax-only "$tu" >/dev/null 2>"$lerr"; then lv=accept; else lv=reject; fi
+    if [[ $lv != "$expect" ]]; then
+        echo "FAIL $id: lccc $lv, GCC 16.2 $expect" >&2
+        sed -n '1,3p' "$lerr" >&2
+        fail=$((fail + 1)); continue
+    fi
+    if [[ $expect == reject && $diag != - ]] && ! grep -q -- "$diag" "$lerr"; then
+        echo "FAIL $id: rejected, but without '$diag'" >&2
+        sed -n '1,3p' "$lerr" >&2
+        fail=$((fail + 1)); continue
+    fi
+done < "$cases"
+
+if (( fail > 0 )); then
+    echo "check_designator_init: FAILED ($fail of $rows rows)" >&2
+    exit 1
+fi
+echo "check_designator_init: PASSED ($rows rows vs GCC 16)"
diff --git a/tests/regression/check_diagnostic_positions.sh b/tests/regression/check_diagnostic_positions.sh
new file mode 100755
index 00000000..35234e9c
--- /dev/null
+++ b/tests/regression/check_diagnostic_positions.sh
@@ -0,0 +1,123 @@
+#!/usr/bin/env bash
+# AUD-POS-1: a diagnostic's file:line:col is the compiler's contract with
+# everything that reads it -- the human, the editor that jumps to it, the build
+# log parser.  After a `#include`, LCCC used to report every position in the
+# rest of the file one line too high: the preprocessor wrote a
+# return-to-parent line marker (which already accounts for the directive's own
+# line) and then emitted a newline "to preserve line numbering", so a phantom
+# blank line sat between the marker and the parent's next line.
+#
+# The reference is GCC doing the same thing to the same file: whatever line and
+# column it blames, LCCC must blame.  Positions only -- the wording and the
+# caret art are the compiler's own.
+set -euo pipefail
+
+# The cases run inside a scratch directory, so both compilers must be
+# absolute before the cd below.
+CCC=$(realpath "${CCC:-./target/fastbuild/lccc}")
+GCC=$(command -v "${CCC_GCC:-gcc}")
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+cd "$tmp"
+
+pass=0
+fail=0
+
+# first-position <compiler> <file> [flags...] -> "line:col" of the first
+# diagnostic that names <file>, or "-" when the compiler reported none.
+first_position() {
+    local cc=$1 file=$2
+    shift 2
+    "$cc" "$@" -S -o /dev/null "$file" 2>&1 |
+        awk -v want="$file" '
+            index($0, want ":") == 1 {
+                split($0, parts, ":")
+                print parts[2] ":" parts[3]
+                exit
+            }
+            END { if (NR == 0) print "-" }' || true
+}
+
+# Every case is checked in both directions: LCCC must agree with GCC, and the
+# case must actually produce a diagnostic (an oracle gate that cannot fail is
+# no gate).  The expected position is spelled out as well, so a case whose
+# fixture no longer fails is a hard error rather than a silent agreement on
+# "no diagnostic".
+row() {
+    local name=$1 expected=$2 file=$3 want_file=$4
+    shift 4
+    local got want
+    got=$(first_position "$CCC" "$want_file" "$@" || true)
+    want=$(first_position "$GCC" "$want_file" "$@" || true)
+    if [ -z "$got" ] || [ -z "$want" ]; then
+        echo "FAIL $name: no diagnostic (lccc='${got:-<none>}' gcc='${want:-<none>}')" >&2
+        fail=$((fail + 1))
+        return 0
+    fi
+    if [ "$got" != "$want" ]; then
+        echo "FAIL $name: lccc blames $got, gcc blames $want" >&2
+        fail=$((fail + 1))
+        return 0
+    fi
+    if [ "$expected" != "-" ] && [ "$got" != "$expected" ]; then
+        echo "FAIL $name: lccc blames $got, fixture documents $expected" >&2
+        fail=$((fail + 1))
+        return 0
+    fi
+    pass=$((pass + 1))
+}
+
+printf 'int h;\n' > h.h
+printf 'int n;\n' > n.h
+printf 'int a;\nint bad = ;\n' > bad.h
+printf '#include "h.h"\nint n;\n' > nested.h
+printf 'int outer;\n#include "nested.h"\n' > n.h
+
+printf '#include <stddef.h>\nint bad = ;\n' > inc_first.c
+printf 'int a;\n#include <stddef.h>\nint bad = ;\n' > inc_middle.c
+printf '#include <stddef.h>\n#include <stdint.h>\nint bad = ;\n' > inc_twice.c
+printf '#include "h.h"\nint bad = ;\n' > inc_local.c
+printf '#include "n.h"\nint bad = ;\n' > inc_nested.c
+printf '#include "bad.h"\nint ok;\n' > inc_error_inside.h.c
+printf 'int a;\nint bad[;];\n' > no_include.c
+printf '#include <stddef.h>\nint a;\nint b;\nint c;\nint d;\nint bad = ;\n' > inc_far.c
+printf '#include <stddef.h>\nint a;\n#define M(x) (x)\nint b = M(1);\nint bad = ;\n' > inc_macro.c
+printf '#include <stddef.h>\nint a;\n#pragma GCC diagnostic ignored "-Wunused"\nint bad = ;\n' > inc_pragma.c
+
+row "error after include"            2:11 inc_first.c  inc_first.c
+row "include on line 2"              3:11 inc_middle.c inc_middle.c
+row "two includes"                   3:11 inc_twice.c  inc_twice.c
+row "local include"                  2:11 inc_local.c  inc_local.c
+row "nested include"                 2:11 inc_nested.c inc_nested.c
+row "error inside the header"        2:11 inc_error_inside.h.c bad.h
+row "no include at all"              2:9  no_include.c  no_include.c
+row "far below an include"           6:11 inc_far.c    inc_far.c
+row "after a #define past the include" 5:11 inc_macro.c inc_macro.c
+row "after a #pragma past the include" 4:11 inc_pragma.c inc_pragma.c
+
+# The include line itself is still blamed for a missing header -- the phantom
+# line was never the "not found" diagnostic's problem, and pinning it here keeps
+# the fix from turning into "stop reporting includes at all".
+printf '#include "definitely_missing_header.h"\nint ok;\n' > missing.c
+got=$("$CCC" -S -o /dev/null missing.c 2>&1 | grep -c 'definitely_missing_header.h' || true)
+if [ "$got" -lt 1 ]; then
+    echo "FAIL missing-include: no diagnostic mentions the missing header" >&2
+    fail=$((fail + 1))
+else
+    pass=$((pass + 1))
+fi
+
+# __LINE__ is the semantic twin of the same bookkeeping: a phantom line between
+# the include and the next line must not shift the macro either.
+printf '#include "h.h"\nint line_here = __LINE__;\n' > line.c
+got=$("$CCC" -E line.c 2>/dev/null | grep -c 'int line_here = 2;' || true)
+want=$("$GCC" -E line.c 2>/dev/null | grep -c 'int line_here = 2;' || true)
+if [ "$got" -lt 1 ] || [ "$want" -lt 1 ]; then
+    echo "FAIL __LINE__ after include: lccc=$got gcc=$want" >&2
+    fail=$((fail + 1))
+else
+    pass=$((pass + 1))
+fi
+
+echo "diagnostic positions: $pass passed, $fail failed"
+[ "$fail" -eq 0 ]
diff --git a/tests/regression/check_file_scope_init.sh b/tests/regression/check_file_scope_init.sh
new file mode 100755
index 00000000..9758ffeb
--- /dev/null
+++ b/tests/regression/check_file_scope_init.sh
@@ -0,0 +1,73 @@
+#!/usr/bin/env bash
+# File-scope initializers of static-storage objects must be constants
+# (C11 6.7.9p4), and every form lccc accepts must be emitted with its value.
+#
+# Two checks against GCC 16.2 (tests/regression/lib/gcc_oracle.sh):
+#   * tests/regression/file_scope_init/cases.tsv: each row is one translation
+#     unit. The oracle must still give the recorded verdict (drift check), lccc
+#     must give the same verdict, and a rejection must carry the diagnostic.
+#   * values.c: lccc and GCC 16.2 are linked and run; the printed values must
+#     match. A form accepted but zeroed would pass the verdict check and fail
+#     here.
+set -euo pipefail
+. tests/regression/lib/gcc_oracle.sh
+require_gcc_oracle check_file_scope_init || exit 1
+
+CCC=${CCC:-target/fastbuild/lccc}
+dir=tests/regression/file_scope_init
+cases=$dir/cases.tsv
+[[ -x $CCC ]] || { echo "check_file_scope_init: FAIL: compiler not found at $CCC" >&2; exit 1; }
+[[ -r $cases ]] || { echo "check_file_scope_init: FAIL: $cases missing" >&2; exit 1; }
+
+tmp=$(mktemp -d "${TMPDIR:-/tmp}/lccc-file-scope.XXXXXX")
+trap 'rm -rf "$tmp"' EXIT
+gcc_oracle_positive_control "$CCC" "$tmp" || exit 1
+gcc_oracle_positive_control "$GCC_ORACLE_BIN" "$tmp" || exit 1
+
+prelude='struct s2 { int a; int b; };'
+fail=0 rows=0
+while IFS=$'\t' read -r id expect diag decl; do
+    [[ -z $id || $id == \#* ]] && continue
+    rows=$((rows + 1))
+    tu=$tmp/$id.c
+    printf '%s\n%s\n' "$prelude" "$decl" > "$tu"
+
+    if "$GCC_ORACLE_BIN" -fsyntax-only -w "$tu" >/dev/null 2>&1; then gv=accept; else gv=reject; fi
+    if [[ $gv != "$expect" ]]; then
+        echo "FAIL $id: oracle drift: GCC 16.2 says $gv, the table says $expect" >&2
+        fail=$((fail + 1)); continue
+    fi
+    lerr=$tmp/$id.err
+    if "$CCC" -fsyntax-only "$tu" >/dev/null 2>"$lerr"; then lv=accept; else lv=reject; fi
+    if [[ $lv != "$expect" ]]; then
+        echo "FAIL $id: lccc $lv, GCC 16.2 $expect" >&2
+        sed -n '1,3p' "$lerr" >&2
+        fail=$((fail + 1)); continue
+    fi
+    if [[ $expect == reject && $diag != - ]] && ! grep -q -- "$diag" "$lerr"; then
+        echo "FAIL $id: rejected, but without '$diag'" >&2
+        sed -n '1,3p' "$lerr" >&2
+        fail=$((fail + 1)); continue
+    fi
+done < "$cases"
+
+# Runtime values: the same program through both compilers.
+vsrc=$dir/values.c
+"$GCC_ORACLE_BIN" -w -c "$vsrc" -o "$tmp/values_gcc.o"
+"$CCC" -c "$vsrc" -o "$tmp/values_lccc.o"
+"$GCC_ORACLE_BIN" -o "$tmp/values_gcc" "$tmp/values_gcc.o"
+"$GCC_ORACLE_BIN" -o "$tmp/values_lccc" "$tmp/values_lccc.o"
+"$tmp/values_gcc" > "$tmp/values_gcc.out"
+"$tmp/values_lccc" > "$tmp/values_lccc.out"
+if ! cmp -s "$tmp/values_gcc.out" "$tmp/values_lccc.out"; then
+    echo "FAIL values: folded values differ from GCC 16.2" >&2
+    echo "  gcc:  $(cat "$tmp/values_gcc.out")" >&2
+    echo "  lccc: $(cat "$tmp/values_lccc.out")" >&2
+    fail=$((fail + 1))
+fi
+
+if (( fail > 0 )); then
+    echo "check_file_scope_init: FAILED ($fail failure(s) of $rows rows + values)" >&2
+    exit 1
+fi
+echo "check_file_scope_init: PASSED ($rows rows vs GCC $GCC_ORACLE_MAJOR; values match)"
diff --git a/tests/regression/check_intrinsic_feature_gate.sh b/tests/regression/check_intrinsic_feature_gate.sh
new file mode 100644
index 00000000..d03bcb32
--- /dev/null
+++ b/tests/regression/check_intrinsic_feature_gate.sh
@@ -0,0 +1,392 @@
+#!/usr/bin/env bash
+# AUD-CPU-3: an intrinsic whose instruction-set extension the invocation does
+# not permit must be diagnosed, and the same invocation must still emit the
+# instruction when it DOES permit it.
+#
+# Before the fix `-march=x86-64` (SSE2 only) compiled `_mm_crc32_u8` to
+# `crc32b` and `_mm_aesenc_si128` to `aesenc`: instructions the declared target
+# does not have, i.e. a SIGILL on exactly the hardware the user said to assume,
+# with no diagnostic at any stage.  GCC and Clang reject that same source
+# ("target specific option mismatch" / "requires target feature"), so the
+# verdicts below are checked against GCC wherever GCC has the intrinsic --
+# the gate cannot pass by rejecting more than the oracle does.
+set -euo pipefail
+
+repo=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
+ccc=${CCC:-$repo/target/fastbuild/lccc}
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+
+[ -x "$ccc" ] || { echo "SKIP: $ccc not built" >&2; exit 0; }
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+# 1. Raw-builtin contract: one source per family, rejected exactly when the
+#    invocation lacks the extension and lowered when it has it.
+cat >"$tmp/crc.c" <<'EOF'
+unsigned crc_u8(unsigned c, unsigned char x) { return __builtin_ia32_crc32qi(c, x); }
+EOF
+cat >"$tmp/aes.c" <<'EOF'
+typedef int v4si __attribute__((vector_size(16)));
+v4si aes_enc(v4si a, v4si b) { return __builtin_ia32_aesenc128(a, b); }
+EOF
+cat >"$tmp/clmul.c" <<'EOF'
+typedef int v4si __attribute__((vector_size(16)));
+v4si clmul(v4si a, v4si b) { return __builtin_ia32_pclmulqdq128(a, b, 0); }
+EOF
+
+# The 256-bit AES/CLMUL forms.  They share the mnemonic with the 128-bit forms
+# and are a DIFFERENT extension: `vaesenc %ymm1, %ymm0, %ymm0` came out of
+# `-march=x86-64` before the fix below, i.e. a SIGILL on the hardware the user
+# named.  Their permission is a conjunction -- 256-bit vector class AND the
+# extension's own `-m` flag -- so the rejection cases below split along both
+# halves, and both are oracle-checked against GCC further down.
+cat >"$tmp/vaes256.c" <<'EOF'
+typedef long long v4di __attribute__((vector_size(32)));
+v4di aes_enc256(v4di a, v4di b) { return __builtin_ia32_aesenc256(a, b); }
+EOF
+cat >"$tmp/vpclmul256.c" <<'EOF'
+typedef long long v4di __attribute__((vector_size(32)));
+v4di clmul256(v4di a, v4di b) { return __builtin_ia32_vpclmulqdq256(a, b, 0); }
+EOF
+
+# reject <source> <flag-expected-in-message> <flags...>
+reject() {
+    local src=$1 want=$2
+    shift 2
+    local out rc asm=$tmp/reject-${src%.c}-$(echo "$@" | tr -c 'a-z0-9' '_').s
+    rm -f "$asm"
+    set +e
+    out=$("$ccc" -O2 "$@" -S "$tmp/$src" -o "$asm" 2>&1)
+    rc=$?
+    set -e
+    [ "$rc" -ne 0 ] || fail "$src compiled with $* (rc=0); the instruction needs an extension this target lacks"
+    grep -q -- "$want" <<<"$out" ||
+        { printf '%s\n' "$out" >&2; fail "$src: the diagnostic does not name $want"; }
+    [ ! -s "$asm" ] || fail "$src: assembly was emitted despite the diagnostic"
+}
+
+# accept <source> <required-instruction> <flags...>
+accept() {
+    local src=$1 want=$2
+    shift 2
+    local asm=$tmp/accept-${src%.c}-$(echo "$@" | tr -c 'a-z0-9' '_').s
+    "$ccc" -O2 "$@" -S "$tmp/$src" -o "$asm"
+    grep -qE "^[[:space:]]+v?$want" "$asm" ||
+        { printf '%s\n' "$(cat "$asm")" >&2;
+          fail "$src with $*: expected $want to be emitted"; }
+}
+
+reject crc.c -msse4.2 -march=x86-64
+accept crc.c crc32 -msse4.2
+accept crc.c crc32 -march=x86-64-v2
+accept crc.c crc32
+
+reject aes.c -maes -march=x86-64
+accept aes.c aesenc -maes
+accept aes.c aesenc -march=raptorlake
+
+reject clmul.c -mpclmul -march=x86-64
+accept clmul.c pclmulqdq -mpclmul
+
+# (the second argument of `reject` is the text the diagnostic must contain;
+#  every rejection names the `-m` flag that would have granted the extension.)
+reject vaes256.c -mvaes -march=x86-64             # v1: neither half
+reject vaes256.c -mvaes -march=x86-64-v3          # class yes, extension no
+reject vaes256.c -mvaes -march=x86-64-v3 -mno-avx2  # extension yes, class no
+reject vaes256.c -mvaes -march=x86-64-v3 -mno-avx   # no VEX at all
+reject vaes256.c -mvaes -march=alderlake -mno-vaes  # explicit denial of the profile's grant
+accept vaes256.c vaesenc -mvaes                   # project baseline is v3, so the class is granted
+accept vaes256.c vaesenc -march=alderlake
+
+reject vpclmul256.c -mvpclmulqdq -march=x86-64
+reject vpclmul256.c -mvpclmulqdq -march=x86-64-v3
+reject vpclmul256.c -mvpclmulqdq -march=alderlake -mno-vpclmulqdq
+# VAES is not VPCLMULQDQ: separate bits, separate rows (GCC rejects this too).
+reject vpclmul256.c -mvpclmulqdq -mvaes -march=x86-64-v3
+reject vpclmul256.c -mvpclmulqdq -mvaes -march=alderlake -mno-vpclmulqdq
+accept vpclmul256.c vpclmulqdq -mvpclmulqdq
+accept vpclmul256.c vpclmulqdq -march=alderlake
+
+# The 32-bit target has the same rule and the same escape hatch: i686 has no
+# SSE4.2 by default, and `-msse4.2` is what grants it.
+reject crc.c -msse4.2 -m32
+accept crc.c crc32 -m32 -msse4.2
+
+# 2. Nothing else is affected: a source with no ISA-sensitive intrinsic still
+#    compiles at the lowest target level.
+cat >"$tmp/plain.c" <<'EOF'
+double dot(const double *a, const double *b, int n) {
+    double s = 0.0;
+    for (int i = 0; i < n; i++) s += a[i] * b[i];
+    return s;
+}
+EOF
+"$ccc" -O2 -march=x86-64 -S "$tmp/plain.c" -o "$tmp/plain.s" ||
+    fail "a source without ISA-sensitive intrinsics was rejected at -march=x86-64"
+
+# 3. GCC oracle: where GCC ships the same intrinsic, its accept/reject verdict
+#    must match ours.  GCC's DEFAULT is x86-64 (v1) while this project's is
+#    x86-64-v3, so only the explicit cases are comparable.
+gcc_bin=${GCC:-gcc}
+if ! command -v "$gcc_bin" >/dev/null 2>&1; then
+    echo "SKIP: oracle unavailable ($gcc_bin not found); the contract above still ran" >&2
+    echo "PASS: intrinsic feature gate (no oracle on this host)"
+    exit 0
+fi
+
+cat >"$tmp/o_crc.c" <<'EOF'
+#include <nmmintrin.h>
+unsigned crc_u8(unsigned c, unsigned char x) { return _mm_crc32_u8(c, x); }
+EOF
+cat >"$tmp/o_aes.c" <<'EOF'
+#include <wmmintrin.h>
+__m128i aes_enc(__m128i a, __m128i b) { return _mm_aesenc_si128(a, b); }
+EOF
+
+# verdict <source> <flags...>: print "accept" or "reject" for compiler $1
+verdict() {
+    local cc=$1 src=$2
+    shift 2
+    if "$cc" -O2 "$@" -c "$tmp/$src" -o /dev/null >/dev/null 2>&1; then
+        echo accept
+    else
+        echo reject
+    fi
+}
+
+compare() {
+    local src=$1
+    shift
+    local ours theirs
+    ours=$(verdict "$ccc" "$src" "$@")
+    theirs=$(verdict "$gcc_bin" "$src" "$@")
+    [ "$ours" = "$theirs" ] ||
+        fail "$src with $*: lccc $ours, gcc $theirs (the oracle is the tie-breaker)"
+    echo "ok: $src $* -> $ours (gcc agrees)"
+}
+
+compare o_crc.c -march=x86-64
+compare o_crc.c -msse4.2
+compare o_crc.c -march=x86-64-v2
+compare o_aes.c -march=x86-64
+compare o_aes.c -maes
+
+# The 256-bit rows, same oracle rule.  `-march=alderlake` (not `raptorlake`:
+# GCC 12 does not know that name) is the CPU profile both compilers agree on.
+cat >"$tmp/o_vaes256.c" <<'EOF'
+#include <immintrin.h>
+__m256i aes_enc256(__m256i a, __m256i b) { return _mm256_aesenc_epi128(a, b); }
+EOF
+cat >"$tmp/o_vpclmul256.c" <<'EOF'
+#include <immintrin.h>
+__m256i clmul256(__m256i a, __m256i b) { return _mm256_clmulepi64_epi128(a, b, 0); }
+EOF
+
+compare o_vaes256.c -march=x86-64
+compare o_vaes256.c -march=x86-64-v3
+compare o_vaes256.c -march=x86-64-v3 -mvaes
+compare o_vaes256.c -march=x86-64-v3 -mvaes -mno-avx
+compare o_vaes256.c -march=alderlake
+compare o_vaes256.c -march=alderlake -mno-vaes
+compare o_vpclmul256.c -march=x86-64-v3
+compare o_vpclmul256.c -march=x86-64-v3 -mvaes
+compare o_vpclmul256.c -march=x86-64-v3 -mvpclmulqdq
+compare o_vpclmul256.c -march=alderlake
+
+# Documented deviation, asserted rather than compared.  lccc ties ALL 256-bit
+# emission to the AVX2-class permission (`x86_isa().ymm`), so `-mno-avx2` also
+# removes the 256-bit VEX forms whose float half GCC keeps with AVX alone:
+# GCC accepts `_mm256_aesenc_epi128` under `-mvaes -mno-avx2` (measured), lccc
+# refuses.  Refusing is the safe direction -- lccc emits no 256-bit code at all
+# on that target -- and it keeps the promise the fold makes.
+ours=$(verdict "$ccc" o_vaes256.c -march=x86-64-v3 -mvaes -mno-avx2)
+[ "$ours" = reject ] ||
+    fail "o_vaes256.c -mvaes -mno-avx2: lccc $ours, expected reject (no 256-bit class on that target)"
+echo "ok: o_vaes256.c -mvaes -mno-avx2 -> reject (documented deviation: GCC accepts)"
+
+# ---------------------------------------------------------------------------
+# AVX-VNNI, AVX-VNNI-INT8 and AVX-VNNI-INT16: three extensions, three bits,
+# three flags.  This is where the audit's live SIGILL case lived: measured
+# emitting `vpdpbusd %ymm1, %ymm0, %ymm0` for `_mm_dpbusd_epi32` under
+# `-march=x86-64`, an Alder-Lake-era instruction inside a v1 object.
+cat >"$tmp/vnni128.c" <<'EOF'
+typedef int v4si __attribute__((vector_size(16)));
+v4si dpbusd128(v4si a, v4si b, v4si c) { return __builtin_ia32_vpdpbusd128(a, b, c); }
+EOF
+cat >"$tmp/vnni256.c" <<'EOF'
+typedef int v8si __attribute__((vector_size(32)));
+v8si dpbusd256(v8si a, v8si b, v8si c) { return __builtin_ia32_vpdpbusd256(a, b, c); }
+EOF
+cat >"$tmp/vnni_int8.c" <<'EOF'
+typedef int v4si __attribute__((vector_size(16)));
+v4si dpbssd128(v4si a, v4si b, v4si c) { return __builtin_ia32_vpdpbssd128(a, b, c); }
+EOF
+cat >"$tmp/vnni_int16.c" <<'EOF'
+typedef int v4si __attribute__((vector_size(16)));
+v4si dpwusd128(v4si a, v4si b, v4si c) { return __builtin_ia32_vpdpwusd128(a, b, c); }
+EOF
+
+# Both halves of the conjunction, on both widths: no vector class (v1), no
+# request (v3), no class (v3 -mno-avx2), an explicit denial of a request that
+# the flag itself just made, and -- the row that keeps the families apart --
+# AVX-VNNI's flag must NOT grant the INT8/INT16 instructions.
+reject vnni128.c -mavxvnni -march=x86-64
+reject vnni256.c -mavxvnni -march=x86-64
+reject vnni128.c -mavxvnni -march=x86-64-v3
+reject vnni256.c -mavxvnni -march=x86-64-v3
+reject vnni256.c -mavxvnni -march=x86-64-v3 -mno-avx2
+reject vnni256.c -mavxvnni -mavxvnni -mno-avxvnni
+reject vnni128.c -mavxvnni -march=alderlake -mno-avxvnni
+reject vnni_int8.c -mavxvnniint8 -march=x86-64
+reject vnni_int8.c -mavxvnniint8 -mavxvnni
+reject vnni_int8.c -mavxvnniint8 -march=alderlake
+reject vnni_int16.c -mavxvnniint16 -mavxvnni
+reject vnni_int16.c -mavxvnniint16 -march=alderlake
+accept vnni128.c vpdpbusd -mavxvnni
+accept vnni256.c vpdpbusd -mavxvnni
+accept vnni128.c vpdpbusd -march=alderlake
+accept vnni256.c vpdpbusd -mavx512vnni -mavx512vl
+accept vnni_int8.c vpdpbssd -mavxvnniint8
+accept vnni_int16.c vpdpwusd -mavxvnniint16
+accept vnni128.c vpdpbusd -mavxvnni -mno-avxvnni -mavxvnni  # re-enabled after denial
+
+# The i686 driver shares the flag spelling and rejects without it -- but its
+# fold reaches the intrinsic table through `x86_isa()`, which is `NONE` for
+# anything but x86-64 (by design: the 32-bit backend does not route its
+# *scalar/SSE* work through that model), so the 256-bit VEX intrinsics are
+# refused there even when `-mavx -mavxvnni` asks for them.  Refusing is the safe
+# direction and the row below pins it; the inconsistent half -- the `__m256`
+# *vector-op* path emitting `%ymm` on i686 with no permission at all -- is
+# latched separately as AUD-CPU-4 at the bottom of this gate.
+reject vnni128.c -mavxvnni -m32 -march=i686
+reject vnni128.c -mavxvnni -m32 -msse2 -mavx -mavxvnni
+
+# GCC oracle for the classic AVX-VNNI group (`-mavxvnni` exists in GCC 12).
+# The INT8/INT16 halves get no oracle on this toolchain and are declared as
+# such below rather than compared against a compiler that cannot express them.
+cat >"$tmp/o_vnni128.c" <<'EOF'
+#include <immintrin.h>
+__m128i dpbusd128(__m128i a, __m128i b, __m128i c) { return _mm_dpbusd_epi32(a, b, c); }
+EOF
+cat >"$tmp/o_vnni256.c" <<'EOF'
+#include <immintrin.h>
+__m256i dpbusd256(__m256i a, __m256i b, __m256i c) { return _mm256_dpbusd_epi32(a, b, c); }
+EOF
+
+compare o_vnni128.c -march=x86-64
+compare o_vnni256.c -march=x86-64
+compare o_vnni128.c -march=x86-64-v3
+compare o_vnni256.c -march=x86-64-v3
+compare o_vnni128.c -mavxvnni
+compare o_vnni256.c -mavxvnni
+compare o_vnni256.c -mavxvnni -mno-avx
+compare o_vnni256.c -mavxvnni -mno-avx2
+compare o_vnni128.c -mavx512vnni
+compare o_vnni256.c -mavx512vnni
+compare o_vnni128.c -mavx512vnni -mavx512vl
+compare o_vnni256.c -mavx512vnni -mavx512vl
+compare o_vnni128.c -march=alderlake
+compare o_vnni256.c -march=alderlake
+
+# Documented deviation, asserted rather than compared: GCC's `-mavxvnni` also
+# implies AVX2, so `-march=x86-64 -mavxvnni` is accepted there while lccc
+# refuses it -- the user asked for a v1 baseline and the 256-bit class is what
+# the backend would need to encode the instruction.  Refusing a request is the
+# safe direction; emitting an unrequested instruction is not.
+ours=$(verdict "$ccc" o_vnni128.c -march=x86-64 -mavxvnni)
+[ "$ours" = reject ] ||
+    fail "o_vnni128.c -march=x86-64 -mavxvnni: lccc $ours, expected reject (no 256-bit class on a v1 target)"
+echo "ok: o_vnni128.c -march=x86-64 -mavxvnni -> reject (documented deviation: GCC accepts)"
+
+# Declared no-oracle region: GCC 12.2 neither knows `-mavxvnniint8` /
+# `-mavxvnniint16` (measured: "unrecognized command-line option") nor declares
+# those intrinsics in its headers, so there is nothing to compare against.  The
+# rows above still pin the contract on the lccc side, and the two families are
+# accepted by no flag but their own.
+if "$gcc_bin" -mavxvnniint8 -E - </dev/null >/dev/null 2>&1; then
+    cat >"$tmp/o_vnni_int8.c" <<'EOF'
+#include <immintrin.h>
+__m128i dpbssd128(__m128i a, __m128i b, __m128i c) { return _mm_dpbssd_epi32(a, b, c); }
+EOF
+    compare o_vnni_int8.c -mavxvnniint8
+else
+    echo "note: no GCC oracle for AVX-VNNI-INT8/-INT16 on this toolchain ($gcc_bin rejects the flag); the lccc contract rows above are the whole gate for those two families"
+fi
+
+# ---------------------------------------------------------------------------
+# GFNI: the Galois-field byte instructions.  Legacy-encoded (no VEX), so this
+# is the one extension whose permission is the flag ALONE -- `-mno-avx` must
+# not remove it, and, measured before the row below existed, `-march=x86-64`
+# emitted `gf2p8mulb %xmm1, %xmm0` with no diagnostic.  GCC rejects that same
+# source, and GCC 12.2 knows `-mgfni`, so every row here is oracle-checked.
+cat >"$tmp/gfni.c" <<'EOF'
+typedef char v16qi __attribute__((vector_size(16)));
+v16qi gmul(v16qi a, v16qi b) { return __builtin_ia32_gf2p8mulb(a, b); }
+EOF
+
+reject gfni.c -mgfni -march=x86-64
+reject gfni.c -mgfni -march=x86-64-v3
+reject gfni.c -mgfni -maes
+reject gfni.c -mgfni -march=alderlake -mno-gfni
+accept gfni.c gf2p8mulb -mgfni
+accept gfni.c gf2p8mulb -mgfni -mavx
+accept gfni.c gf2p8mulb -mgfni -mno-avx
+accept gfni.c gf2p8mulb -march=alderlake
+
+cat >"$tmp/o_gfni.c" <<'EOF'
+#include <immintrin.h>
+__m128i gmul(__m128i a, __m128i b) { return _mm_gf2p8mul_epi8(a, b); }
+EOF
+compare o_gfni.c -march=x86-64
+compare o_gfni.c -march=x86-64-v3
+compare o_gfni.c -mgfni
+compare o_gfni.c -mgfni -mavx
+compare o_gfni.c -mgfni -mno-avx
+compare o_gfni.c -march=alderlake
+compare o_gfni.c -maes
+compare o_gfni.c -march=alderlake -mno-gfni
+
+# ---------------------------------------------------------------------------
+# RECORDED DEBT (AUD-CPU-4), asserted rather than fixed here: the i686
+# *vector-op* path emits 256-bit VEX code with no permission at all.  Measured
+# before this row was written:
+#
+#   lccc -O2 -m32            -S f256.c   ->  vaddps %ymm1, %ymm0, %ymm0
+#   lccc -O2 -m32 -mno-avx   -S f256.c   ->  vaddps %ymm1, %ymm0, %ymm0
+#   lccc -O2 -m32 -mno-avx   -S i256.c   ->  vpaddd %ymm1, %ymm0, %ymm0
+#
+# So on the 32-bit target a `__m256` operand is lowered to AVX instructions
+# regardless of `-mno-avx`, while the intrinsic table refuses the same class of
+# instruction there.  Both halves are the SIGILL class AUD-CPU-3 closed on
+# x86-64; they need one model, which is a change of its own.  These rows fail
+# the moment the behaviour changes in EITHER direction, so the fix cannot land
+# without updating them in the same commit.
+# (The debt is in the *intrinsic* 256-bit path: a bare `vector_size(32)`
+#  operator addition on i686 is lowered scalar-wise and correctly -- measured
+#  `addss` per lane, no `%ymm` -- so the probe has to name the intrinsic.)
+cat >"$tmp/i686_ymm_float.c" <<'EOF'
+#include <immintrin.h>
+__m256 add256(__m256 a, __m256 b) { return _mm256_add_ps(a, b); }
+EOF
+cat >"$tmp/i686_ymm_int.c" <<'EOF'
+#include <immintrin.h>
+__m256i addi256(__m256i a, __m256i b) { return _mm256_add_epi32(a, b); }
+EOF
+debt_ymm() {
+    local src=$1 want=$2
+    shift 2
+    local asm=$tmp/debt-${src%.c}-$(echo "$@" | tr -c 'a-z0-9' '_').s
+    "$ccc" -O2 "$@" -S "$tmp/$src" -o "$asm" ||
+        fail "$src with $*: the recorded AUD-CPU-4 debt no longer reproduces (lccc now refuses); flip this row to a rejection assertion"
+    grep -qE "%ymm" "$asm" ||
+        fail "$src with $*: no %ymm operand any more (AUD-CPU-4 may be fixed); flip this row"
+    grep -qE "^[[:space:]]+v?$want" "$asm" ||
+        fail "$src with $*: expected $want"
+    echo "ok: AUD-CPU-4 debt still reproduces: $src $* emits $want on %ymm"
+}
+debt_ymm i686_ymm_float.c addps -m32
+debt_ymm i686_ymm_float.c addps -m32 -mno-avx
+debt_ymm i686_ymm_int.c paddd -m32 -mno-avx2
+
+echo "PASS: ISA-sensitive intrinsics are gated on the permitted feature set, oracle-checked"
diff --git a/tests/regression/check_ivsr_reproducers.sh b/tests/regression/check_ivsr_reproducers.sh
new file mode 100755
index 00000000..b394c093
--- /dev/null
+++ b/tests/regression/check_ivsr_reproducers.sh
@@ -0,0 +1,122 @@
+#!/usr/bin/env bash
+# AUD-HYGIENE-1: the IVSR/univsr probe sources that used to sit loose in
+# `tests/` (simple_loop.c, test_ivsr_indexed.c, plus their pre-fix `.s`
+# snapshots) are gates now.
+#
+# The probes only make sense as a CONTRACT, because their interesting property
+# is not "which instructions the pass happens to pick today" -- that changes
+# with every improvement -- but that turning induction-variable strength
+# reduction on or off cannot change what the program computes, on the shapes the
+# pass targets: a plain indexed sum, a sum through a struct member, an indexed
+# fill, and an indexed read-modify-write.
+#
+# So the gate is metamorphic in the pass and differential against GCC:
+#
+#   lccc -O2                      (pass on)   ==  GCC -O2
+#   lccc -O2 CCC_NO_IVSR=1        (pass off)  ==  the leg above
+#   lccc -O3                      (vectorizer on top)  still the same numbers
+#
+# A wrong result here is a miscompile in the loop-strength-reduction or
+# vectorization path, not an instruction-selection quibble.
+#
+# Usage: CCC=target/fastbuild/lccc bash tests/regression/check_ivsr_reproducers.sh
+set -euo pipefail
+
+repo=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
+ccc=${CCC:-$repo/target/fastbuild/lccc}
+[ -x "$ccc" ] || { echo "SKIP: $ccc not built" >&2; exit 0; }
+
+src=$repo/tests/regression/fixtures/ivsr/test_ivsr_indexed.c
+simple=$repo/tests/regression/fixtures/ivsr/simple_loop.c
+td=$(mktemp -d)
+trap 'rm -rf "$td"' EXIT
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+# The driver is generated here, not checked in: it must stay in lockstep with
+# the probe signatures above it, and a mismatch is a compile error rather than
+# a silently skipped comparison.
+cat >"$td/driver.c" <<'EOF'
+#include <stdio.h>
+
+/* Declared BEFORE the prototype on purpose: a `struct Point` first mentioned
+   inside a parameter list has function-prototype scope, i.e. it is a different
+   type from the file-scope one, and the two TUs then disagree about how the
+   argument is passed. */
+struct Point { double x, y, z; };  /* must match the probe TU, 24 bytes */
+
+double sum_array(const double *arr, int n);
+double sum_points_x(const struct Point *pts, int n);
+void fill_array(double *arr, int n, double value);
+void scale_array(double *arr, int n, double factor);
+double test(const double *arr, int n);
+
+static double arr[257];
+
+int main(void) {
+    for (int i = 0; i < 257; i++) {
+        arr[i] = (double)(i % 17) * 0.5 - 3.25;
+    }
+    /* Odd trip counts on purpose: a strength-reduction prologue/epilogue that
+       is off by one shows up here and nowhere in a power-of-two run. */
+    for (int n = 0; n <= 257; n += 7) {
+        printf("sum %d %.6f\n", n, sum_array(arr, n));
+        printf("test %d %.6f\n", n, test(arr, n));
+
+        struct Point pts[40];
+        for (int i = 0; i < 40; i++) {
+            pts[i].x = arr[(i * 3) % 257];
+            pts[i].y = arr[(i * 5 + 1) % 257];
+            pts[i].z = arr[(i * 7 + 2) % 257];
+        }
+        printf("pts %d %.6f\n", n, sum_points_x(pts, n < 40 ? n : 40));
+
+        double buf[64];
+        for (int i = 0; i < 64; i++) {
+            buf[i] = 1.0;
+        }
+        fill_array(buf, n < 64 ? n : 64, 2.5);
+        for (int i = 0; i < 64; i++) {
+            buf[i] += (double)i;
+        }
+        scale_array(buf, n < 64 ? n : 64, -0.75);
+        double acc = 0.0;
+        for (int i = 0; i < 64; i++) {
+            acc += buf[i] * (double)(i + 1);
+        }
+        printf("buf %d %.6f\n", n, acc);
+    }
+    return 0;
+}
+EOF
+
+gcc -O2 -fno-strict-aliasing "$td/driver.c" "$src" "$simple" -o "$td/gcc" 2>"$td/gcc.err" ||
+    { cat "$td/gcc.err" >&2; fail "gcc could not build the probes"; }
+"$td/gcc" >"$td/gcc.out" || fail "gcc reference exited non-zero"
+
+# 37 trip counts (0,7,...,252) x 4 shapes; an exact count, so a truncated or
+# aborted sweep cannot pass by producing "enough" output.
+lines=$(wc -l <"$td/gcc.out")
+[ "$lines" -eq 148 ] || fail "the driver produced $lines lines; expected 148 (37 trip counts x 4 shapes)"
+
+for opt in -O2 -O3; do
+    tag="on${opt#-}"
+    "$ccc" "$opt" "$td/driver.c" "$src" "$simple" -o "$td/$tag" 2>"$td/$tag.err" ||
+        { cat "$td/$tag.err" >&2; fail "$tag: compile failed"; }
+    "$td/$tag" >"$td/$tag.out" || fail "$tag: program exited non-zero"
+    cmp -s "$td/gcc.out" "$td/$tag.out" ||
+        { diff -u "$td/gcc.out" "$td/$tag.out" | sed -n '1,20p' >&2;
+          fail "$opt ($tag): IVSR-primed loop disagreed with GCC"; }
+done
+
+for opt in -O0 -O1 -O2 -O3; do
+    tag="off${opt#-}"
+    CCC_NO_IVSR=1 "$ccc" "$opt" "$td/driver.c" "$src" "$simple" -o "$td/$tag" 2>"$td/$tag.err" ||
+        { cat "$td/$tag.err" >&2; fail "$tag: compile failed"; }
+    "$td/$tag" >"$td/$tag.out" || fail "$tag: program exited non-zero"
+    cmp -s "$td/gcc.out" "$td/$tag.out" ||
+        { diff -u "$td/gcc.out" "$td/$tag.out" | sed -n '1,20p' >&2;
+          fail "$opt ($tag): CCC_NO_IVSR=1 disagreed with GCC"; }
+done
+
+echo "PASS: IVSR/univsr probe shapes agree with GCC with and without the pass"
