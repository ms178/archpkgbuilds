+        assert_eq!(f.blocks[4].instructions[1].dest().unwrap(), Value(13));
+        assert_eq!(f.blocks[4].instructions[2].dest().unwrap(), Value(30));
+        assert_eq!(count_defs(&f, 13), 1);
+        assert_eq!(count_defs(&f, 30), 1);
+        assert!(
+            !f.blocks[1]
