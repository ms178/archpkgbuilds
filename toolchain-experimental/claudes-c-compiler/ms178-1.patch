+  if q.returncode or not dictionary.is_file():raise ValueError('dictionary training failure')
+  roundtrip(base,['-3','-D',str(dictionary)],['-D',str(dictionary)])
+  roundtrip(base,['-3','--no-dictID','-D',str(dictionary)],['-D',str(dictionary)])
