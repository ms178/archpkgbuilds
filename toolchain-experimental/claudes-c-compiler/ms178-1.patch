 src/backend/i686/codegen/peephole.rs | 200 +++++++++++++++++++++++++++
 1 file changed, 200 insertions(+)

diff --git a/src/backend/i686/codegen/peephole.rs b/src/backend/i686/codegen/peephole.rs
index 1d6990a..c73176f 100644
