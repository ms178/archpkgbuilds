From 46cf220e0049ac3a229cc4d097414085f6817805 Mon Sep 17 00:00:00 2001
From: Z User <z@container>
Date: Fri, 28 Aug 2026 20:03:35 +0000
Subject: [PATCH] build: default .cargo linker to gcc/bfd, drop clang+mold pin

Neither clang nor mold is installed on the current research VM, so the
pinned 'clang -fuse-ld=mold' pairing forced every build to fail or to
rely on per-invocation CARGO_TARGET_*_LINKER/RUSTFLAGS overrides.

.cargo/config.toml now defaults to linker = "gcc" (GNU ld/bfd) for
x86_64-unknown-linux-gnu; i686-unknown-linux-gnu keeps gcc + -m32. The
reference recipe is scripts/build_lccc_o1_j2.sh (fastbuild, -O1, -j 2,
foreground) with no environment overrides; verified end-to-end with a
37 s fastbuild build and a compile/link/run smoke test.

mold/wild remain differential test oracles only (tests/linker/). RULES.md
rule 26 and DECISIONS.md gain a superseding session86 entry.
---
 .cargo/config.toml         | 23 ++++++++++++-----------
 engineering/DECISIONS.md   | 12 ++++++++++++
 engineering/agent/RULES.md | 14 ++++++++------
 3 files changed, 32 insertions(+), 17 deletions(-)

diff --git a/.cargo/config.toml b/.cargo/config.toml
index d12d44e3..b55c3fbc 100644
--- a/.cargo/config.toml
+++ b/.cargo/config.toml
@@ -1,15 +1,16 @@
-# Use mold for fastest possible links on the constrained 2-vCPU research box.
-# Mold's i686 preset ("-m elf_i386") is enabled automatically when the target
-# is i686-unknown-linux-gnu; for the default x86_64 host target mold picks the
-# x86_64 preset.  This saves ~300-500 ms per rebuild and cuts peak RSS during
-# LTO/fastbuild links enough to stay out of OOM on the 2 GB VM.
+# Default toolchain: gcc + GNU ld (bfd).
 #
-# scripts/build_lccc_fast.sh keeps this clang+mold pairing when both tools
-# are installed and falls back to gcc + GNU ld otherwise.
+# gcc/bfd is the proven default pairing on this box. The previous
+# clang+mold pin caused repeated build friction (and neither tool is
+# even installed on the current research VM), so it is no longer
+# pinned here. Explicit override is still possible per-invocation via
+# CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER if ever needed.
+#
+# Reference build recipe (foreground, constrained-memory safe):
+#   scripts/build_lccc_o1_j2.sh   # fastbuild, -O1, -j 2, gcc/bfd
 [target.x86_64-unknown-linux-gnu]
-linker = "clang"
-rustflags = ["-C", "link-arg=-fuse-ld=mold"]
+linker = "gcc"
 
 [target.i686-unknown-linux-gnu]
-linker = "clang"
-rustflags = ["-C", "link-arg=-fuse-ld=mold", "-C", "link-arg=-m32"]
+linker = "gcc"
+rustflags = ["-C", "link-arg=-m32"]
diff --git a/engineering/DECISIONS.md b/engineering/DECISIONS.md
index ecf1b3b3..9586d894 100644
--- a/engineering/DECISIONS.md
+++ b/engineering/DECISIONS.md
@@ -655,6 +655,18 @@ anyway (the bullet carries the *why*).
   the environment (`--config rustflags=[]` does NOT override the file).
   Prebuilt static mold 2.42.0 user-local + `RUSTFLAGS="-C
   link-arg=-fuse-ld=mold"` brings cold builds to ~3 m 10 s.
+- **[history/session86 / agent/CARGO_CONFIG_GCC_BFD]** **Supersedes the
+  session84 recipe above.** `.cargo/config.toml` now defaults to
+  `linker = "gcc"` (GNU ld/bfd) for both x86_64-unknown-linux-gnu and
+  i686-unknown-linux-gnu (the latter keeps `-m32`). Rationale: neither
+  clang nor mold is installed on the current research VM, so the old pin
+  forced every build either to fail or to rely on per-invocation
+  environment overrides — a standing footgun. The reference recipe is now
+  simply `scripts/build_lccc_o1_j2.sh` (fastbuild, `-O1`, `-j 2`,
+  foreground, gcc/bfd) with no environment overrides needed. mold/wild
+  remain available as **differential test oracles only**
+  (`tests/linker/setup_oracles.sh`, git-HEAD builds) — they are build
+  linkers nowhere.
 - **[history/session84/10]** Snapshot discipline: commit + regenerate the
   `ms178-N.patch` + artifact + bundle immediately after every validated
   fix (session 84 lost a fix to a mid-session wipe and re-implemented it);
diff --git a/engineering/agent/RULES.md b/engineering/agent/RULES.md
index e2db317f..138a1137 100644
--- a/engineering/agent/RULES.md
+++ b/engineering/agent/RULES.md
@@ -94,12 +94,14 @@ the evidence. Re-oracle and check gzip `longest_match` stack-mem after
 
 ## Environment / process
 
-26. Build: `scripts/build_lccc_fast.sh` → `target/fastbuild/lccc`. Swap:
-    `scripts/ensure_swap.sh` on 2 GiB VMs (needs CAP_SYS_ADMIN; otherwise
-    rely on `-j2`). Mold-less sandboxes: pass
-    `CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=gcc` and `RUSTFLAGS` as
-    environment variables — `--config` does not override
-    `.cargo/config.toml`.
+26. Build: `scripts/build_lccc_o1_j2.sh` → `target/fastbuild/lccc`
+    (fastbuild, `-O1`, `-j 2`, foreground — lower parallelism on the
+    4 GiB no-swap VM OOM-kills less). Swap: `scripts/ensure_swap.sh` on
+    2 GiB VMs (needs CAP_SYS_ADMIN; otherwise rely on `-j2`).
+    `.cargo/config.toml` defaults to gcc/bfd — no linker environment
+    overrides are needed anymore; do not reintroduce clang/mold pins
+    (mold/wild are differential test oracles only, see
+    `tests/linker/setup_oracles.sh`).
 27. Linker oracles (mold, wild) must be **git-HEAD builds**; stale release
     binaries produced false failures. GAS/binutils pin: 2.47. Record
     resolved oracle revisions in `ORACLE_REVISIONS.txt`.
