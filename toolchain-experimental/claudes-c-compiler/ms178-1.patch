+/// Parse `. = expression` using the representable, same-section .org forms.
+/// Unsupported symbolic products/differences fail closed, never become a symbol.
+fn parse_dot_assignment(rhs: &str) -> Result<AsmItem, String> {
+    if rhs.is_empty() {
+        return Err("missing location-counter expression".into());
+    }
+    if let Ok(value) = parse_integer_expr(rhs) {
+        if value < 0 {
+            return Err("location-counter assignment cannot move backwards".into());
+        }
+        return Ok(AsmItem::Org(String::new(), value, 0));
+    }
+    let mut depth = 0i32;
+    let mut plus = None;
+    for (i, &b) in rhs.as_bytes().iter().enumerate() {
+        match b {
+            b'(' => depth += 1,
+            b')' => {
+                depth -= 1;
+                if depth < 0 {
+                    return Err("unbalanced location-counter expression".into());
+                }
+            }
+            b'+' if depth == 0 && plus.is_none() => plus = Some(i),
+            _ => {}
+        }
+    }
+    if depth != 0 {
+        return Err("unbalanced location-counter expression".into());
+    }
+    let (symbol, addend) = match plus {
+        Some(i) => (&rhs[..i], &rhs[i + 1..]),
+        None => (rhs, "0"),
+    };
+    let symbol = symbol.trim();
+    // GAS numeric local labels (`2b`, `2f`) are ordinary .org targets; the
+    // writer resolves them relative to the directive's source position.
+    let numeric_local = symbol.len() >= 2
+        && symbol.as_bytes()[..symbol.len() - 1].iter().all(u8::is_ascii_digit)
+        && matches!(symbol.as_bytes().last(), Some(b'b' | b'f'));
+    if !is_valid_gas_identifier(symbol) && symbol != "." && !numeric_local {
+        return Err(format!("unsupported location-counter expression: {rhs}"));
+    }
+    let addend = parse_integer_expr(addend.trim())
+        .map_err(|_| format!("unsupported location-counter expression: {rhs}"))?;
+    Ok(AsmItem::Org(symbol.to_string(), addend, 0))
+}
