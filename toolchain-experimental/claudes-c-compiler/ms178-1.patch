+/// The 14 `__builtin_stdc_*` builtins behind C23 `<stdbit.h>`.
+///
+/// **Why macros and not a new IR intrinsic.**  Each one is a one-line
+/// composition of `__builtin_clzll`/`__builtin_ctzll`/`__builtin_popcountll`,
+/// which lccc already lowers to `LZCNT`/`TZCNT`/`POPCNT` (or the `BSR`/`BSF`
+/// fallback), plus a mask and a compare.  Routing them through the existing,
+/// heavily exercised lowering paths is worth more than a bespoke IR node: the
+/// emitted machine code is the same, and the only new surface is the text
+/// below -- which is verified exhaustively against the oracle (every 8- and
+/// 16-bit input; the edge set plus random sampling for 32/64-bit) instead of
+/// being argued about.  See `tests/regression/check_stdbit_builtins.py`.
+///
+/// **Single evaluation.**  The argument is bound once to a `__typeof__(x)`
+/// temporary inside a statement expression.  `__typeof__` does not evaluate
+/// its operand, so `__builtin_stdc_bit_width(f())` calls `f()` exactly once,
+/// like GCC's builtin.
+///
+/// **Result types, measured on gcc-16.2.0** with `_Generic` over the builtins:
+/// the counting forms (`count_ones/zeros`, `leading_*`, `trailing_*`,
+/// `first_*`, `bit_width`) have type `unsigned int` for *every* argument type,
+/// `bit_floor`/`bit_ceil` have the argument's own type, and `has_single_bit`
+/// is `_Bool`.  The casts below follow that exactly, which is why
+/// `__builtin_stdc_bit_floor((unsigned char)200)` is an `unsigned char` 128
+/// rather than an `int` 128.
+///
+/// **Width.**  `__w` is `sizeof(__v) * 8`, so an `unsigned char` argument
+/// answers as an 8-bit value -- the same arithmetic glibc's `__clz8_inline`
+/// fallback performs.  Widths above 64 bits (`unsigned __int128`, a GCC
+/// extension past C23's `<stdbit.h>` surface) are rejected by the
+/// `_Static_assert` rather than silently answered with a wrong number.
+fn define_stdbit_builtin_macros(macros: &mut MacroTable) {
+    // Common prologue.  Every **clz** operand is OR-ed with 1: clz is
+    // undefined at zero, and `clz(x | 1) == clz(x)` for every `x != 0`, so the
+    // OR makes the zero case harmless and leaves the *outer* ternary as the
+    // only test in the generated code (measured: 12 instructions for
+    // `stdc_bit_width` before, against GCC's 5).
+    //
+    // `ctz` deliberately does NOT get the trick: `ctz(x | 1) == ctz(x)` is
+    // false -- OR-ing bit 0 turns every even input odd, and `ctz(2) = 1` would
+    // become `ctz(3) = 0`.  An earlier version applied it to both and the
+    // exhaustive stdbit differential (tests/regression/check_stdbit_builtins.py,
+    // every 8- and 16-bit input) caught it immediately; that is the whole
+    // reason the test is exhaustive rather than sampled.
+    //
+    // `__w`, `__u` (the zero-extended 64-bit value) and
+    // `__m` (its complement inside the type's width) are computed only in the
+    // bodies that need them, so no expansion leaves an unused local behind
+    // under -Wall.
+    const PRE: &str = "({ __typeof__(x) __v = (x);";
+    const GUARD: &str = " _Static_assert(sizeof(__v) <= 8, \"__builtin_stdc_* supports unsigned integer types up to 64 bits\");";
+    const W: &str = " int __w = (int)(sizeof(__v) * 8);";
+    const U: &str = " unsigned long long __u = (unsigned long long)__v;";
+    const M: &str = " unsigned long long __m = ~__u & (~0ULL >> (64 - __w));";
+    const END: &str = " })";
+    let b = |decls: &str, expr: &str| -> String {
+        format!("{PRE}{GUARD}{decls} {expr}{END}")
+    };
+
+    def_fn(macros, "__builtin_stdc_count_ones", &["x"],
+           &b(U, "(unsigned int)__builtin_popcountll(__u);"));
+    def_fn(macros, "__builtin_stdc_count_zeros", &["x"],
+           &b(&format!("{W}{U}"),
+             "(unsigned int)__w - (unsigned int)__builtin_popcountll(__u);"));
+    def_fn(macros, "__builtin_stdc_leading_zeros", &["x"],
+           &b(&format!("{W}{U}"),
+             "(unsigned int)(__u ? (int)__builtin_clzll(__u | 1) - (64 - __w) : __w);"));
+    def_fn(macros, "__builtin_stdc_leading_ones", &["x"],
+           &b(&format!("{W}{U}{M}"),
+             "(unsigned int)(__m ? (int)__builtin_clzll(__m | 1) - (64 - __w) : __w);"));
+    def_fn(macros, "__builtin_stdc_trailing_zeros", &["x"],
+           &b(&format!("{W}{U}"), "(unsigned int)(__u ? __builtin_ctzll(__u) : __w);"));
+    def_fn(macros, "__builtin_stdc_trailing_ones", &["x"],
+           &b(&format!("{W}{U}{M}"), "(unsigned int)(__m ? __builtin_ctzll(__m) : __w);"));
+    def_fn(macros, "__builtin_stdc_first_leading_zero", &["x"],
+           &b(&format!("{W}{U}{M}"),
+             "(unsigned int)(__m ? (int)__builtin_clzll(__m | 1) - (64 - __w) + 1 : 0);"));
+    def_fn(macros, "__builtin_stdc_first_leading_one", &["x"],
+           &b(&format!("{W}{U}"),
+             "(unsigned int)(__u ? (int)__builtin_clzll(__u | 1) - (64 - __w) + 1 : 0);"));
+    def_fn(macros, "__builtin_stdc_first_trailing_zero", &["x"],
+           &b(&format!("{W}{U}{M}"),
+             "(unsigned int)(__m ? __builtin_ctzll(__m) + 1 : 0);"));
+    def_fn(macros, "__builtin_stdc_first_trailing_one", &["x"],
+           &b(&format!("{W}{U}"), "(unsigned int)(__u ? __builtin_ctzll(__u) + 1 : 0);"));
+    def_fn(macros, "__builtin_stdc_bit_width", &["x"],
+           &b(U, "(unsigned int)(__u ? 64 - __builtin_clzll(__u | 1) : 0);"));
+    // bit_floor/bit_ceil have the argument's own type (`__typeof__(x)`), so the
+    // 64-bit intermediate is cast back through it.
+    def_fn(macros, "__builtin_stdc_bit_floor", &["x"],
+           &b(U, "(__typeof__(x))(__u ? 1ULL << (63 - __builtin_clzll(__u | 1)) : 0);"));
+    // bit_ceil: 0 when the next power of two is not representable in the
+    // argument's type -- gcc-16.2.0 answers 0 for `0x80000001u` and for
+    // `(unsigned char)0xf0`, and the original value when it is already a
+    // power of two (`0x80000000u` stays `0x80000000`).
+    def_fn(macros, "__builtin_stdc_bit_ceil", &["x"],
+           &b(&format!("{W}{U}"),
+             "(__typeof__(x))(__u <= 1 ? 1 \
+              : ((__u & (__u - 1)) == 0 ? __u \
+              : ((64 - (int)__builtin_clzll(__u | 1)) >= __w ? 0 \
+              : 1ULL << (64 - __builtin_clzll(__u | 1)))));"));
+    def_fn(macros, "__builtin_stdc_has_single_bit", &["x"],
+           &b(U, "(_Bool)(__u != 0 && (__u & (__u - 1)) == 0);"));
+}
