+    cmp_defs: &[Option<CmpDef>],
+    binop_defs: &[Option<BinOpDef>],
+    select_defs: &[Option<SelectDef>],
+    phi_defs: &[Option<PhiDef>],
+    is_boolean: &[bool],
+) -> bool {
+    sign_bit_clear_walk(
+        src,
+        bits,
+        cmp_defs,
+        binop_defs,
+        select_defs,
+        phi_defs,
+        is_boolean,
+        0,
