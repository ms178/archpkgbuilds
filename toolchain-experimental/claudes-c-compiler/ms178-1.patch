+/// `__GNUC_PATCHLEVEL__`
+pub(crate) const GCC_PATCHLEVEL_STR: &str = "0";
+/// `__VERSION__`, including the quotes GCC puts in the macro body.
+pub(crate) const VERSION_QUOTED: &str = "\"16.2.0\"";
