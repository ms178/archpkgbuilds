@@ -0,0 +1,114 @@
+#!/usr/bin/env python3
+"""Paired LZ4 runtime measurement for the x86 loop-IV spill pass.
+
+The standard x86-64 path is handled earlier by the byte-compare window
+vectorizer, so the loop-IV pass has no emitted-code effect there. This harness
+measures the real scalar fallback (`-mno-sse`), where that vector arm is
+ineligible and loop-IV spill coalescing is applicable. Pass-on/off binaries
+come from the same compiler and are sampled alternately after output identity
+is checked.
+"""
+from __future__ import annotations
+
+import argparse
+import os
+from pathlib import Path
+import statistics
+import subprocess
+import tempfile
+import time
+
+ROOT = Path(__file__).resolve().parents[1]
+DEFAULT_COMPILER = ROOT / "target" / "fastbuild" / "lccc"
+SOURCE = ROOT / "tests" / "benchmark" / "programs" / "lz4_compress.c"
+DEFINES = ("-DMATCH_RICH=1", "-DPASSES=2048")
+EXPECTED = "29f49acaab81f800"
+
+
+def invoke(compiler: Path, source: Path, output: Path, *, assembly: bool, off: bool) -> None:
+    env = {key: value for key, value in os.environ.items()
+           if not key.startswith(("CCC_", "LCCC_"))}
+    if off:
+        env["CCC_PEEPHOLE_SKIP"] = "loop_iv_spill,__none__"
+    args = [str(compiler), "-O2", "-mno-sse", *DEFINES]
+    if assembly:
+        args += ["-S"]
+    args += ["-o", str(output), str(source)]
+    result = subprocess.run(args, cwd=ROOT, env=env, text=True, capture_output=True)
+    if result.returncode:
+        raise RuntimeError(f"compile failed ({'off' if off else 'on'}): {result.stderr[-2000:]}")
+
+
+def run(binary: Path) -> tuple[float, str]:
+    start = time.perf_counter()
+    result = subprocess.run([str(binary)], text=True, capture_output=True, check=False, timeout=600)
+    elapsed = time.perf_counter() - start
+    if result.returncode:
+        raise RuntimeError(f"{binary} exited {result.returncode}: {result.stderr[-1000:]}")
+    return elapsed, result.stdout.strip()
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--lccc", type=Path, default=DEFAULT_COMPILER)
+    parser.add_argument("--reps", type=int, default=11)
+    args = parser.parse_args()
+    if args.reps < 4:
+        parser.error("--reps must be at least 4 to report an interquartile range")
+    compiler = args.lccc.resolve()
+    if not compiler.is_file() or not os.access(compiler, os.X_OK):
+        parser.error(f"compiler is not executable: {compiler}")
+
+    with tempfile.TemporaryDirectory(prefix="lccc-loop-iv-bench-") as temporary:
+        work = Path(temporary)
+        on_asm, off_asm = work / "on.s", work / "off.s"
+        on_bin, off_bin = work / "on", work / "off"
+        invoke(compiler, SOURCE, on_asm, assembly=True, off=False)
+        invoke(compiler, SOURCE, off_asm, assembly=True, off=True)
+        on_text, off_text = on_asm.read_text(), off_asm.read_text()
+        if ".Lcciv_st" not in on_text:
+            raise RuntimeError("loop-IV rewrite did not fire in the pass-on assembly")
+        if ".Lcciv_st" in off_text or on_text == off_text:
+            raise RuntimeError("pass-off arm is not a discriminating baseline")
+
+        invoke(compiler, SOURCE, on_bin, assembly=False, off=False)
+        invoke(compiler, SOURCE, off_bin, assembly=False, off=True)
+        on_output, off_output = run(on_bin)[1], run(off_bin)[1]
+        if on_output != off_output or on_output != EXPECTED:
+            raise RuntimeError(
+                f"output mismatch: on={on_output!r}, off={off_output!r}, expected={EXPECTED}"
+            )
+        print(f"output identical: {on_output}", flush=True)
+
+        on_times: list[float] = []
+        off_times: list[float] = []
+        ratios: list[float] = []
+        for index in range(args.reps):
+            pair = (run(on_bin), run(off_bin)) if index % 2 == 0 else (run(off_bin), run(on_bin))
+            if index % 2 == 0:
+                on_time, off_time = pair[0][0], pair[1][0]
+            else:
+                off_time, on_time = pair[0][0], pair[1][0]
+            on_times.append(on_time)
+            off_times.append(off_time)
+            ratios.append(on_time / off_time)
+            print(
+                f"rep {index + 1:2}: on {on_time * 1000:8.2f} ms  "
+                f"off {off_time * 1000:8.2f} ms  ratio {on_time / off_time:.4f}",
+                flush=True,
+            )
+
+        ratio = statistics.median(on_times) / statistics.median(off_times)
+        wins = sum(value < 1.0 for value in ratios)
+        q1, _, q3 = statistics.quantiles(ratios, n=4)
+        print(
+            f"median on {statistics.median(on_times) * 1000:.2f} ms; "
+            f"off {statistics.median(off_times) * 1000:.2f} ms; "
+            f"ratio {ratio:.4f} ({(ratio - 1) * 100:+.2f}%); "
+            f"paired wins {wins}/{args.reps}; IQR [{q1:.4f}, {q3:.4f}]"
+        )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
