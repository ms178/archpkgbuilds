+        lines.append(f"{'movzwl' if d in GP32 else 'movzwq'} %{s16}, %{d}")
+        lines.append(f"{'movswl' if d in GP32 else 'movswq'} %{s16}, %{d}")
+    for s32, d in itertools.product(GP32[:6] + GP32[8:11], GP64[:6]):
