+        assert_eq!(hex("cmovzq %rax, %r16"), "d5 c8 44 c0");
+        assert_eq!(hex("setzb %r16b"), "d5 90 94 c0");
+        assert_eq!(hex("bswapq %r16"), "d5 98 c8");
+    }
+
