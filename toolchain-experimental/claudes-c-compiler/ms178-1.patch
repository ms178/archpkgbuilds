-/* A non-tail recursion deep enough that the compile-time constant evaluator
- * cannot finish it: `deep(100000)` nests 100,000 levels in the interpreter,
- * `ackermann(3, 11)` (the deepest fold the pass is meant to serve) nests
- * ~16,400. `MAX_EVAL_CALL_DEPTH` therefore refuses this call and leaves it as
- * a call instead of recursing until the pipeline's 64 MiB stack is gone —
- * which aborted the compiler outright before the depth bound existed.
- *
- * The seed is `volatile` so nothing but the pass under test can fold it.
- */
+/* Exercise the constant evaluator with actual constant arguments.  The small
+ * recursion must fold; the larger one exceeds MAX_EVAL_CALL_DEPTH and must
+ * remain a runtime call.  The volatile result keeps the latter observable,
+ * without hiding its argument from the evaluator. */
 #include <stdio.h>
 
-static int deep(int n) {
+__attribute__((noinline)) static int deep(int n) {
     if (n == 0) return 0;
     return 1 + deep(n - 1);
 }
 
 int main(void) {
-    volatile int n = 100000;
-    volatile int result = deep(n);
-    printf("%d\n", result);
+    int small = deep(100);
+    volatile int result = deep(100000);
+    printf("%d %d\n", small, result);
     return 0;
 }
diff --git a/tests/regression/ptr_iv_counter_wrap.c b/tests/regression/ptr_iv_counter_wrap.c
new file mode 100644
index 0000000..8ad5dba
--- /dev/null
+++ b/tests/regression/ptr_iv_counter_wrap.c
@@ -0,0 +1,60 @@
+/* A uint32_t loop counter can wrap while pointer IVs continue to advance.
+ * Reserve sparse address space, touching only a few pages: this exercises
+ * the real 32-bit wrap after four iterations without allocating 4 GiB of RAM.
+ * The last byte is inside the mapping and is reached without pointer overflow.
+ */
+#define _GNU_SOURCE
+#include <stdint.h>
+#include <stdio.h>
+#include <sys/mman.h>
+
+#define STRIDE (UINT32_C(1) << 30)
+
+__attribute__((noinline))
+static unsigned unreachable_bound(const unsigned char *a, const unsigned char *b) {
+    uint32_t i = 0;
+    do {
+        if (*a != *b)
+            return 42;
+        a += STRIDE;
+        b += STRIDE;
+        i += STRIDE;
+    } while (i != STRIDE + 1);
+    return 17;
+}
+
+__attribute__((noinline))
+static unsigned reachable_bound(const unsigned char *a, const unsigned char *b) {
+    uint32_t i = 0;
+    do {
+        if (*a != *b)
+            return 42;
+        a += STRIDE;
+        b += STRIDE;
+        i += STRIDE;
+    } while (i != STRIDE * 2);
+    return 17;
+}
+
+int main(void) {
+    const size_t size = ((size_t)1 << 32) + 4096;
+    unsigned char *p = mmap(NULL, size, PROT_READ | PROT_WRITE,
+                            MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+    if (p == MAP_FAILED) {
+        perror("sparse mmap for pointer-IV wrap regression");
+        return 1;
+    }
+    p[(size_t)1 << 32] = 1;
+    unsigned unreachable = unreachable_bound(p, p + 8);
+    unsigned reachable = reachable_bound(p, p + 8);
+    if (munmap(p, size) != 0) {
+        perror("munmap");
+        return 1;
+    }
+    if (unreachable != 42 || reachable != 17) {
+        printf("incorrect IV wrap results: %u %u\n", unreachable, reachable);
+        return 1;
+    }
+    puts("pointer IV counter-wrap semantics: PASS");
+    return 0;
+}
