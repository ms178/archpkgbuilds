+        eprintln!(
+            "[VEC-RED]   Divided dynamic limit in {}: Value({})",
+            if preheader_idx.is_some() {
+                "the preheader"
+            } else {
+                "the header (no single preheader)"
+            },
+            div_dest.0
+        );
+    }
+
+    let bound = if has_byte_limit {
+        Operand::Value(mul_dest)
+    } else {
+        Operand::Value(div_dest)
+    };
+    (bound, has_byte_limit)
+}
