+extern int plain_var __asm__("__GI_plain_var");
+int plain_var = 5;
+
+extern int arr[3] __asm__("__GI_arr");
+int arr[3] = {10, 20, 30};
+
+struct s { int a; int b; };
+extern struct s st __asm__("__GI_st");
+struct s st = {7, 8};
