diff --git a/tests/regression/check_shuffle_diagnostics.sh b/tests/regression/check_shuffle_diagnostics.sh
new file mode 100644
index 00000000..241a7a88
--- /dev/null
+++ b/tests/regression/check_shuffle_diagnostics.sh
@@ -0,0 +1,195 @@
+#!/usr/bin/env bash
+# AUD-ICE-1 / AUD-DIAG-1 — `__builtin_shuffle*` must diagnose, never ICE.
+#
+# All three rejected inputs below reached a bare `panic!` in the lowering
+# (`src/ir/lowering/expr_builtins.rs`), i.e. a user could crash the compiler
+# with a two-line translation unit, and the compiler *aborted* with a Rust
+# backtrace instead of a diagnostic. One of them (the float mask) was worse
+# than a crash: it was accepted, its bit patterns silently reinterpreted as
+# lane indices, and the program produced wrong answers with no diagnostic at
+# all.
+#
+# The contract pinned here:
+#   * every rejected input produces a `file:line:col: error: ...` diagnostic
+#     with the message naming the actual violation (not an ICE),
+#   * GCC rejects the same inputs (so the verdict is oracle-checked, not
+#     self-referential),
+#   * the VALID forms still compile AND run: the 2-argument form, the
+#     3-argument form, runtime (non-constant) masks, and negative "don't care"
+#     indices in `__builtin_shufflevector`. A gate that only asserted
+#     rejections would pass with the builtin deleted.
+set -euo pipefail
+
+CCC=${CCC:-./target/fastbuild/lccc}
+if [[ ! -x $CCC ]]; then
+    echo "SKIP: $CCC not built" >&2
+    exit 1
+fi
+CCC=$(cd "$(dirname -- "$CCC")" && pwd)/$(basename -- "$CCC")
+
+tmp=$(mktemp -d "${TMPDIR:-/tmp}/lccc-shuffle-diag.XXXXXX")
+trap 'rm -rf "$tmp"' EXIT
+cd "$tmp"
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+# --- the three rejected inputs, each with the fragment its message must name --
+cat >count.c <<'C'
+typedef int v4si __attribute__((vector_size(16)));
+typedef int v8si __attribute__((vector_size(32)));
+v4si f(v4si a, v4si b, v8si m) { return __builtin_shuffle(a, b, m); }
+C
+cat >floatmask.c <<'C'
+typedef int v4si __attribute__((vector_size(16)));
+typedef float v4sf __attribute__((vector_size(16)));
+v4si g(v4si a, v4si b, v4sf m) { return __builtin_shuffle(a, b, m); }
+C
+cat >nonvector.c <<'C'
+typedef float v4sf __attribute__((vector_size(16)));
+v4sf h(v4sf a, v4sf b, int m) { return __builtin_shuffle(a, b, m); }
+C
+
+# expect_rejected <file> <message fragment>
+expect_rejected() {
+    local file=$1 want=$2 err
+    if "$CCC" -O0 -S "$file" -o "$file.s" 2>"$file.err"; then
+        fail "$file was accepted; it must be diagnosed"
+    fi
+    # A panic is an ICE: the compiler must never answer a bad program that way.
+    ! grep -qE "panicked at|internal compiler error|RUST_BACKTRACE" "$file.err" \
+        || { cat "$file.err" >&2; fail "$file ICEd instead of diagnosing"; }
+    grep -q "$want" "$file.err" \
+        || { cat "$file.err" >&2; fail "$file: diagnostic does not mention '$want'"; }
+    # The span matters: the offending operand can be deep inside a large TU.
+    grep -qE "^${file}:[0-9]+:[0-9]+: error:" "$file.err" \
+        || { cat "$file.err" >&2; fail "$file: diagnostic has no file:line:col prefix"; }
+    echo "ok: $file -> $(head -1 "$file.err")"
+}
+
+expect_rejected count.c "mask element count must match"
+expect_rejected floatmask.c "must be a vector of integers"
+expect_rejected nonvector.c "must be a vector of integers"
+
+# AUD-ICE-1's sibling arms (the same `panic!` family, reached through
+# `__builtin_shufflevector`'s constant-index form).
+cat >svrange.c <<'C'
+typedef int v4si __attribute__((vector_size(16)));
+v4si r(v4si a, v4si b) { return __builtin_shufflevector(a, b, 0, 1, 2, 9); }
+C
+cat >svnonconst.c <<'C'
+typedef int v4si __attribute__((vector_size(16)));
+v4si s(v4si a, v4si b, int i) { return __builtin_shufflevector(a, b, 0, 1, 2, i); }
+C
+expect_rejected svrange.c "out of range"
+expect_rejected svnonconst.c "must be an integer constant expression"
+
+# --- the oracle: GCC rejects the same three programs ------------------------
+if command -v gcc >/dev/null 2>&1; then
+    for file in count.c floatmask.c nonvector.c; do
+        if gcc -O0 -S "$file" -o /dev/null 2>"gcc-$file.err"; then
+            fail "oracle disagreement: gcc accepted $file (this gate's verdict is wrong)"
+        fi
+        grep -q "must be an integer vector\|number of elements of the argument vector" \
+            "gcc-$file.err" \
+            || { cat "gcc-$file.err" >&2; fail "gcc rejects $file for another reason"; }
+    done
+    echo "ok: gcc rejects the same three programs (verdict is oracle-checked)"
+    # ...and the positive control is NOT oracle-comparable as a whole: the
+    # narrow_mask case is the documented acceptance superset above, so the
+    # runtime comparison against gcc is done on a form gcc also compiles.
+fi
+
+# --- positive control: the valid forms must still compile AND agree ----------
+cat >valid.c <<'C'
+#include <stdio.h>
+typedef int v4si __attribute__((vector_size(16)));
+typedef unsigned char v4u8 __attribute__((vector_size(4)));
+
+static v4si two_arg(v4si v) { return __builtin_shuffle(v, (v4si){3, 2, 1, 0}); }
+static v4si three_arg(v4si a, v4si b) { return __builtin_shuffle(a, b, (v4si){4, 5, 6, 7}); }
+/* Runtime mask: the lowering unrolls the gather, so this is not a
+   constant-only builtin. Values are taken modulo the vector length. */
+static v4si runtime_mask(v4si a, v4si b, v4si m) { return __builtin_shuffle(a, b, m); }
+static v4si clang_static(v4si a, v4si b) {
+    return __builtin_shufflevector(a, b, 0, 5, 2, -1); /* -1 = don't care */
+}
+/* Only lanes 0-2 are COMPARED below: Clang documents a negative index as
+   "don't care" (the lane is undefined), so an implementation may leave
+   anything there and gcc's choice is not a spec.  Lane 3 is still checked for
+   stability against lccc's documented choice (lane 0 of the first vector). */
+static int dont_care_lane(v4si a, v4si b) {
+    return __builtin_shufflevector(a, b, 0, 5, 2, -1)[3];
+}
+/* AUD-ICE-1 second half: EVERY consumer that needs the builtin's type must see
+   the vector type, or it treats the 16 bytes as an untyped scalar.  These four
+   forms were separately broken: `sizeof` reported 8, `_Generic` matched
+   nothing, `x[1]` read the wrong lane, and `return __builtin_shuffle(...)`
+   handed the caller the result alloca's ADDRESS instead of the data (the
+   32-byte form returned all-zeros, and dereferenced the address at -O2). */
+static v4si direct_return(v4si v) { return __builtin_shuffle(v, (v4si){3, 2, 1, 0}); }
+static v4si casted(v4si v) { return (v4si)__builtin_shuffle(v, (v4si){3, 2, 1, 0}); }
+static int subscripted(v4si v) { return __builtin_shuffle(v, (v4si){3, 2, 1, 0})[1]; }
+typedef int v8si __attribute__((vector_size(32)));
+static v8si wide_return(v8si v) { return __builtin_shuffle(v, (v8si){7, 6, 5, 4, 3, 2, 1, 0}); }
+
+/* Documented acceptance superset: a mask whose inner type is NARROWER than
+   the vector's (`v4u8` for a `v4si`), which GCC rejects with "argument
+   vector(s) inner type must have the same size as inner type of the mask".
+   lccc has always taken it (the mask elements are read at their own width and
+   reduced modulo the lane count), no GCC-targeting program can contain it, and
+   rejecting it now would turn a working build into a hard error -- so the
+   superset is pinned here as a *decision*, visible instead of accidental.
+   Narrowing it to GCC-exact is AUD-DIAG-2 in the follow-up document. */
+static v4si narrow_mask(v4si a, v4u8 m) { return __builtin_shuffle(a, m); }
+
+int main(void) {
+    v4si a = {10, 20, 30, 40}, b = {50, 60, 70, 80};
+    v4si r2 = two_arg(a);
+    v4si r3 = three_arg(a, b);
+    v4si rm = runtime_mask(a, b, (v4si){0, 5, 2, 7});
+    v4si rs = clang_static(a, b);
+    v4si rn = narrow_mask(a, (v4u8){1, 0, 3, 2});
+    v4si rd = direct_return(a);
+    v4si rc2 = casted(a);
+    int rx = subscripted(a);
+    v8si w = {1, 2, 3, 4, 5, 6, 7, 8};
+    v8si rw = wide_return(w);
+    /* The element type must be the first operand's (gcc agrees; _Generic is
+       how the two implementations are compared, not a comment). */
+#if defined(__GNUC__) && !defined(__clang__)
+    _Static_assert(sizeof(__builtin_shuffle(a, (v4si){0, 1, 2, 3})) == 16,
+                   "shuffle result must be the first operand's 16-byte vector");
+#endif
+    printf("direct: %d %d %d %d\n", rd[0], rd[1], rd[2], rd[3]);
+    printf("casted: %d %d %d %d\n", rc2[0], rc2[1], rc2[2], rc2[3]);
+    printf("sub: %d\n", rx);
+    printf("wide: %d %d %d %d %d %d %d %d\n", rw[0], rw[1], rw[2], rw[3], rw[4], rw[5], rw[6], rw[7]);
+    printf("%d %d %d %d\n", r2[0], r2[1], r2[2], r2[3]);
+    printf("%d %d %d %d\n", r3[0], r3[1], r3[2], r3[3]);
+    printf("%d %d %d %d\n", rm[0], rm[1], rm[2], rm[3]);
+    printf("%d %d %d\n", rs[0], rs[1], rs[2]);
+    printf("%d %d %d %d\n", rn[0], rn[1], rn[2], rn[3]);
+    return 0;
+}
+C
+# GCC-comparable subset (everything but the documented superset).
+sed '/narrow_mask/d; /typedef unsigned char v4u8/d; /^ *printf.*rn\[/d' valid.c > valid_gcc.c
+for opt in -O0 -O2; do
+    "$CCC" $opt valid.c -o "valid$opt.bin" || fail "valid forms rejected at $opt"
+    ./"valid$opt.bin" > "lccc$opt.txt" || fail "valid forms crashed at $opt"
+    if command -v gcc >/dev/null 2>&1; then
+        # The superset line is removed for the cross-compiler run; the gcc half
+        # must still cover the 2-arg, 3-arg, runtime-mask and negative-index
+        # forms (four printed lines).
+        "$CCC" $opt valid_gcc.c -o "lccc-gcc$opt.bin" || fail "gcc-comparable file failed"
+        ./"lccc-gcc$opt.bin" > "lccc-gcc$opt.txt"
+        gcc $opt valid_gcc.c -o "gcc$opt.bin" || fail "oracle build failed at $opt"
+        ./"gcc$opt.bin" > "gcc$opt.txt"
+        [[ $(wc -l < "gcc$opt.txt") == 8 ]] || fail "oracle output shape changed at $opt"
+        cmp "lccc-gcc$opt.txt" "gcc$opt.txt" \
+            || { paste "lccc-gcc$opt.txt" "gcc$opt.txt" >&2; fail "valid-form results differ from gcc at $opt"; }
+    fi
+    echo "ok: valid forms $opt -> $(tr '\n' ';' < "lccc$opt.txt")"
+done
+
+echo "PASS: __builtin_shuffle diagnoses bad masks and still lowers the valid forms"
diff --git a/tests/regression/check_static_local_init.sh b/tests/regression/check_static_local_init.sh
new file mode 100755
index 00000000..b8a3ee4e
--- /dev/null
+++ b/tests/regression/check_static_local_init.sh
@@ -0,0 +1,64 @@
+#!/usr/bin/env bash
+# Block-scope `static` objects need constant initializers (C11 6.7.9p4).
+#
+# A static local is initialized once, before main, so its initializer must be
+# a constant expression: an address constant (of a static object, a function,
+# or a string) or an arithmetic constant. lccc used to accept `static int *p =
+# &a;` for an automatic `a`, and stored a stack address into static storage
+# that dangles after the function returns. GCC 16.2 rejects it with
+# "initializer element is not constant".
+#
+# Rows: tests/regression/static_local/cases.tsv, measured against GCC 16.2.
+# Each row is checked twice:
+#   * the oracle must still give the recorded verdict (drift check), and
+#   * lccc must give the same verdict, and a rejection must carry the
+#     "not constant" diagnostic.
+# The oracle is GCC 16.2 (tests/regression/lib/gcc_oracle.sh). A missing
+# oracle fails the gate; it is never skipped.
+set -euo pipefail
+. tests/regression/lib/gcc_oracle.sh
+require_gcc_oracle check_static_local_init || exit 1
+
+CCC=${CCC:-target/fastbuild/lccc}
+dir=tests/regression/static_local
+cases=$dir/cases.tsv
+[[ -x $CCC ]] || { echo "check_static_local_init: FAIL: compiler not found at $CCC" >&2; exit 1; }
+[[ -r $cases ]] || { echo "check_static_local_init: FAIL: $cases missing" >&2; exit 1; }
+
+tmp=$(mktemp -d "${TMPDIR:-/tmp}/lccc-static-local.XXXXXX")
+trap 'rm -rf "$tmp"' EXIT
+gcc_oracle_positive_control "$CCC" "$tmp" || exit 1
+gcc_oracle_positive_control "$GCC_ORACLE_BIN" "$tmp" || exit 1
+
+fail=0 rows=0
+while IFS=$'\t' read -r id expect diag body; do
+    [[ -z $id || $id == \#* ]] && continue
+    rows=$((rows + 1))
+    tu=$tmp/$id.c
+    { cat "$dir/prelude.c"; printf 'void f(int n, struct s *q) {\n%s\n}\n' "$body"; } > "$tu"
+
+    if "$GCC_ORACLE_BIN" -fsyntax-only -w "$tu" >/dev/null 2>&1; then gv=accept; else gv=reject; fi
+    if [[ $gv != "$expect" ]]; then
+        echo "FAIL $id: oracle drift: GCC 16.2 says $gv, the table says $expect" >&2
+        fail=$((fail + 1)); continue
+    fi
+
+    lerr=$tmp/$id.err
+    if "$CCC" -fsyntax-only "$tu" >/dev/null 2>"$lerr"; then lv=accept; else lv=reject; fi
+    if [[ $lv != "$expect" ]]; then
+        echo "FAIL $id: lccc $lv, GCC 16.2 $expect" >&2
+        sed -n '1,3p' "$lerr" >&2
+        fail=$((fail + 1)); continue
+    fi
+    if [[ $expect == reject && $diag != - ]] && ! grep -q -- "$diag" "$lerr"; then
+        echo "FAIL $id: rejected, but without '$diag'" >&2
+        sed -n '1,3p' "$lerr" >&2
+        fail=$((fail + 1)); continue
+    fi
+done < "$cases"
+
+if (( fail > 0 )); then
+    echo "check_static_local_init: FAILED ($fail of $rows rows)" >&2
+    exit 1
+fi
+echo "check_static_local_init: PASSED ($rows rows vs GCC $GCC_ORACLE_MAJOR)"
diff --git a/tests/regression/check_temp_symlink.sh b/tests/regression/check_temp_symlink.sh
new file mode 100644
index 00000000..e9137d69
--- /dev/null
+++ b/tests/regression/check_temp_symlink.sh
@@ -0,0 +1,182 @@
+#!/usr/bin/env bash
+# AUD-TMP-1 — temp files must not be attacker-redirectable.
+#
+# The compiler used to name its temp objects `$TMPDIR/ccc_<pid>_<stem>.<n>.<ext>`
+# with the pid as the only unknown, and wrote them with a plain open() that
+# follows symlinks. A local user who pre-placed a symlink at the predicted path
+# made lccc overwrite *any* file the invoking user can write:
+#
+#   ln -s ~/victim.o /tmp/ccc_<pid>_big.0.o
+#   TMPDIR=/tmp exec lccc -O1 big.c -o big.out     # victim.o replaced by an ELF
+#
+# The `exec` in the reproducer keeps the pid stable so the pre-placement is
+# deterministic (no race needed to demonstrate the mechanism), which is exactly
+# how this gate drives it. Requirements checked here:
+#
+#   1. the victim file is bit-identical afterwards;
+#   2. lccc still succeeds and produces a correct, runnable binary;
+#   3. nothing is written directly into $TMPDIR: the temp files live in a
+#      0700 directory owned by the invoking user, which is reaped afterwards;
+#   4. the same holds for the `CCC_ASM_DEBUG` assembly dump, whose historical
+#      path was the fixed /tmp/asm_debug_<stem>.s;
+#   5. a pre-placed *directory* at the legacy path cannot be adopted either.
+#
+# Mutation check (the gate must be able to fail): `--expect-vulnerable` asserts
+# the historical behaviour instead, i.e. that a symlink pre-placed at a legacy
+# temp path IS followed. The hardening is therefore verified in both
+# directions with the same script:
+#
+#   CCC=/path/to/pre-fix/lccc bash check_temp_symlink.sh --expect-vulnerable  # passes
+#   CCC=/path/to/pre-fix/lccc bash check_temp_symlink.sh                      # fails
+#   CCC=/path/to/fixed/lccc   bash check_temp_symlink.sh                      # passes
+set -euo pipefail
+
+CCC=${CCC:-./target/fastbuild/lccc}
+CCC_ARM=${CCC_ARM:-./target/fastbuild/lccc-arm}
+
+if [[ ! -x $CCC ]]; then
+    echo "SKIP: $CCC not built" >&2
+    exit 1
+fi
+# The body of this gate runs from a scratch directory, so resolve the compiler
+# once, now, while the caller's cwd (and any relative CCC) is still meaningful.
+CCC=$(cd "$(dirname -- "$CCC")" && pwd)/$(basename -- "$CCC")
+if [[ -x $CCC_ARM ]]; then CCC_ARM=$(cd "$(dirname -- "$CCC_ARM")" && pwd)/$(basename -- "$CCC_ARM"); fi
+
+EXPECT_VULNERABLE=0
+[[ ${1:-} == --expect-vulnerable ]] && EXPECT_VULNERABLE=1
+
+tmp=$(mktemp -d "${TMPDIR:-/tmp}/lccc-tmpsymlink.XXXXXX")
+trap 'rm -rf "$tmp"' EXIT
+work="$tmp/work"
+vault="$tmp/tmpd"
+mkdir -p "$work" "$vault"
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+# A small but non-trivial translation unit: enough objects to exercise the
+# multi-file temp-object path of `run_full`.
+make_sources() {
+    local dir=$1
+    printf 'int f1(int x){return x*3+1;}\n' >"$dir/a.c"
+    printf 'int f2(int x){return x*5-2;}\n' >"$dir/b.c"
+    echo 'int f1(int); int f2(int); int main(void){return (f1(3)+f2(4)) == 28 ? 0 : 1;}' >"$dir/main.c"
+}
+
+# ---------------------------------------------------------------------------
+# 1. symlink pre-placed at every legacy temp-object name for the pid we exec
+# ---------------------------------------------------------------------------
+make_sources "$work"
+echo VICTIM >"$vault/victim.txt"
+cp "$vault/victim.txt" "$vault/victim.expected"
+victim_size_before=$(wc -c <"$vault/victim.txt")
+
+# The symlinks and the compiler run must happen in ONE shell process: the
+# legacy name contains the pid, and `exec` keeps `$$` (- the shell's pid, which
+# lccc then has) stable across the hand-off. Doing the pre-placement in a
+# separate subshell would guess a pid that never appears.
+set +e
+bash -c '
+    set -e
+    vault=$1; ccc=$2; work=$3; log=$4
+    for n in 0 1 2 3 4 5 6 7; do
+        for stem in a b main big; do
+            ln -sf "$vault/victim.txt" "$vault/ccc_$$_$stem.$n.o"
+            ln -sf "$vault/victim.txt" "$vault/ccc_asm_$$_$stem.$n.s"
+        done
+    done
+    cd "$work"
+    TMPDIR="$vault" exec "$ccc" -O1 a.c b.c main.c -o prog >"$log" 2>&1
+' _ "$vault" "$CCC" "$work" "$tmp/build.log"
+rc=$?
+set -e
+
+if [[ $EXPECT_VULNERABLE == 1 ]]; then
+    # The historical code writes its objects *through* the pre-placed symlinks,
+    # so all three objects land in the same file and the link step then rejects
+    # the duplicated definitions (exit != 0). The observable that matters here
+    # is the clobbered victim, not the exit status.
+    if cmp -s "$vault/victim.txt" "$vault/victim.expected"; then
+        fail "--expect-vulnerable: victim.txt was NOT overwritten; the gate cannot detect the legacy behaviour"
+    fi
+    echo "PASS: legacy behaviour detected (victim.txt overwritten through the pre-placed symlink; lccc rc=$rc)"
+    exit 0
+fi
+
+[[ $rc -eq 0 ]] || { cat "$tmp/build.log" >&2; fail "lccc exited $rc under a pre-placed-symlink TMPDIR"; }
+[[ -x "$work/prog" ]] || fail "no executable produced"
+"$work/prog" || fail "produced program returned non-zero"
+
+cmp -s "$vault/victim.txt" "$vault/victim.expected" \
+    || fail "victim.txt was overwritten through a pre-placed symlink ($victim_size_before -> $(wc -c <"$vault/victim.txt") bytes)"
+[[ $(wc -c <"$vault/victim.txt") == "$victim_size_before" ]] \
+    || fail "victim.txt changed size"
+
+# ---------------------------------------------------------------------------
+# 2. no stray files in $TMPDIR; private dir is 0700 and reaped
+# ---------------------------------------------------------------------------
+strays=$(find "$vault" -maxdepth 1 -type f ! -name 'ccc_*' ! -name 'victim.*' ! -name 'a_asm.o' | sed -n '1,5p')
+[[ -z $strays ]] || fail "unexpected files written directly into TMPDIR: $strays"
+
+leftovers=$(find "$vault" -maxdepth 1 -type d -name 'lccc-*' | sed -n '1,5p')
+[[ -z $leftovers ]] || fail "private temp directory was not reaped: $leftovers"
+
+# Prove the private directory is really used (and really 0700) rather than the
+# flat names happening to collide with nothing: ask for a dump and inspect it.
+# The dump is written by the built-in assembler path, i.e. for .s/.S inputs.
+cat >"$work/a.S" <<'ASM'
+    .text
+    .globl asm_probe
+asm_probe:
+    ret
+ASM
+set +e
+( cd "$work" && TMPDIR="$vault" CCC_ASM_DEBUG=1 "$CCC" -c a.S -o a_asm.o ) >"$tmp/dbg.log" 2>&1
+set -e
+dump=$(sed -n 's/^\[ccc\] CCC_ASM_DEBUG: wrote //p' "$tmp/dbg.log" | sed -n '1p')
+[[ -n $dump ]] || { cat "$tmp/dbg.log" >&2; fail "CCC_ASM_DEBUG produced no dump path"; }
+[[ -f $dump ]] || fail "CCC_ASM_DEBUG dump $dump does not exist"
+[[ $dump == "$vault"/lccc-*/* ]] || fail "CCC_ASM_DEBUG dump $dump is not inside a private TMPDIR subdirectory"
+dumpperm=$(stat -c '%a' "$(dirname "$dump")")
+[[ $dumpperm == 700 ]] || fail "private temp directory mode is $dumpperm, expected 700"
+[[ $(stat -c '%u' "$(dirname "$dump")") == "$(id -u)" ]] || fail "private temp directory is not owned by the invoking user"
+
+# The fixed historical dump path must not be written by this run either.
+if [[ -e /tmp/asm_debug_a.s && ! -L /tmp/asm_debug_a.s ]]; then
+    echo "note: unrelated /tmp/asm_debug_a.s exists (not created by this gate)" >&2
+fi
+
+# ---------------------------------------------------------------------------
+# 3. a pre-placed *directory* at a legacy flat name cannot break or capture us
+#    (the "adopt something that already exists" shape, one step up from the
+#    symlink: mkdir must fail with EEXIST and the compiler must pick another
+#    candidate directory)
+# ---------------------------------------------------------------------------
+rm -rf "$vault"/ccc_*
+set +e
+bash -c '
+    set -e
+    vault=$1; ccc=$2; work=$3; log=$4
+    mkdir -p "$vault/ccc_$$_a.0.o" "$vault/ccc_$$_b.1.o" "$vault/ccc_$$_main.2.o"
+    cd "$work"
+    TMPDIR="$vault" exec "$ccc" -O1 a.c b.c main.c -o prog2 >"$log" 2>&1
+' _ "$vault" "$CCC" "$work" "$tmp/build2.log"
+rc=$?
+set -e
+[[ $rc -eq 0 ]] || { cat "$tmp/build2.log" >&2; fail "lccc exited $rc with a pre-placed directory in TMPDIR"; }
+[[ -x "$work/prog2" ]] || fail "no executable produced with a pre-placed directory in TMPDIR"
+[[ -z $(find "$vault" -maxdepth 1 -type f -newer "$vault/victim.expected" | sed -n '1p') ]]     || fail "files were written directly into TMPDIR"
+
+# ---------------------------------------------------------------------------
+# 4. cross-target sanity: the same discipline for a non-x86 backend
+# ---------------------------------------------------------------------------
+if [[ -x $CCC_ARM ]]; then
+    set +e
+    ( cd "$work" && TMPDIR="$vault" "$CCC_ARM" -S a.c -o a_arm.s ) >"$tmp/arm.log" 2>&1
+    rc=$?
+    set -e
+    [[ $rc -eq 0 ]] || { cat "$tmp/arm.log" >&2; fail "lccc-arm exited $rc under the hardened TMPDIR"; }
+    cmp -s "$vault/victim.txt" "$vault/victim.expected" || fail "lccc-arm followed a pre-placed symlink"
+fi
+
+echo "PASS: temp files are symlink-safe (private 0700 directory, victim untouched, no TMPDIR debris)"
diff --git a/tests/regression/check_typedef_volatile_codegen.sh b/tests/regression/check_typedef_volatile_codegen.sh
new file mode 100755
index 00000000..38274215
--- /dev/null
+++ b/tests/regression/check_typedef_volatile_codegen.sh
@@ -0,0 +1,83 @@
+#!/usr/bin/env bash
+# A typedef name is a synonym for its declarator text (C11 6.7.8), so an object
+# declared through `typedef volatile int VI;` is volatile: each store to it must
+# survive optimization. lccc used to drop them (the typedef's qualifier was
+# lost), so `VI z; z = 1; z = 2;` compiled to no store at all.
+#
+# The check counts the stores that survive at -O2 in each probe function and
+# requires lccc to match GCC 16.2 (the oracle is checked for the same counts).
+# It covers the volatile object forms: a typedef'd scalar, a typedef'd pointer
+# with a volatile object qualifier (`VIP`), a volatile pointee through a typedef
+# (`VPI`), a volatile array typedef (`VAV`), a volatile pointer object
+# (`int *volatile p`), a volatile pointee stored through a local pointer, and an
+# array of typedef'd volatile pointers (`VIP a[2]`), locally and as a struct member.
+# Each form was a miscompile: its stores were dropped at -O2.
+set -euo pipefail
+. tests/regression/lib/gcc_oracle.sh
+require_gcc_oracle check_typedef_volatile_codegen || exit 1
+
+CCC=${CCC:-target/fastbuild/lccc}
+[[ -x $CCC ]] || { echo "check_typedef_volatile_codegen: FAIL: compiler not found at $CCC" >&2; exit 1; }
+tmp=$(mktemp -d "${TMPDIR:-/tmp}/lccc-tv.XXXXXX")
+trap 'rm -rf "$tmp"' EXIT
+gcc_oracle_positive_control "$CCC" "$tmp" || exit 1
+gcc_oracle_positive_control "$GCC_ORACLE_BIN" "$tmp" || exit 1
+
+src=$tmp/tv.c
+cat > "$src" <<'C'
+typedef volatile int VI;
+VI gv;
+void f_local(void) { VI z; z = 1; z = 2; }
+void f_global(void) { gv = 1; gv = 2; }
+void f_written_local(void) { volatile int z; z = 1; z = 2; }
+typedef int *volatile VIP;
+typedef volatile int *VPI;
+typedef volatile int VAV[2];
+void f_ptr_typedef(void) { VIP p; p = 0; p = 0; }
+void f_pointee(void) { int a = 0; VPI p = &a; *p = 1; *p = 2; }
+void f_array(void) { VAV a; a[0] = 1; a[0] = 2; }
+void f_written_ptr(void) { int *volatile p; p = 0; p = 0; }
+void f_written_pointee(void) { int a = 0; volatile int *p = &a; *p = 1; *p = 2; }
+void f_param_leak(VI p, int y) { y = 1; y = 2; (void)p; }
+void f_member_leak(void) { struct S { VIP m; int n; } s; s.n = 1; s.n = 2; (void)s; }
+void f_decl_leak(void) { VIP p; int z; z = 1; z = 2; (void)p; }
+void f_arr_ptr_typedef(void) { VIP a[2]; a[0] = 0; a[0] = 0; (void)a; }
+struct SA { VIP m[2]; };
+void f_struct_arr_ptr_typedef(void) { struct SA s; s.m[0] = 0; s.m[0] = 0; (void)s; }
+C
+
+# Store count per function in an assembly file: a store is a mov with an
+# immediate source to a memory operand, inside the named function.
+count_stores() {
+    awk -v want="$2" '
+        /^[A-Za-z_][A-Za-z0-9_]*:/ { fn = $0; sub(/:.*/, "", fn) }
+        /^[ \t]+mov[lq]?[ \t]+\$/ && fn == want && /\(/ { n++ }
+        END { print n + 0 }' "$1"
+}
+
+fail=0
+"$GCC_ORACLE_BIN" -O2 -S -o "$tmp/gcc.s" "$src"
+"$CCC" -O2 -S "$src" -o "$tmp/lccc.s"
+# function:expected-count. The leak cases keep no stores: a parameter's or a
+# member's qualifiers must not leak into a later declaration, so GCC 16.2 drops them.
+for probe in f_local:2 f_global:2 f_written_local:2 f_ptr_typedef:2 f_pointee:2 f_array:2 \
+    f_written_ptr:2 f_written_pointee:2 f_param_leak:0 f_member_leak:0 f_decl_leak:0 \
+    f_arr_ptr_typedef:2 f_struct_arr_ptr_typedef:2; do
+    fn=${probe%%:*}
+    want=${probe##*:}
+    g=$(count_stores "$tmp/gcc.s" "$fn")
+    l=$(count_stores "$tmp/lccc.s" "$fn")
+    if [[ $g != "$want" ]]; then
+        echo "FAIL $fn: GCC 16.2 keeps $g stores, the probe expects $want (fixture drift)" >&2
+        fail=$((fail + 1))
+    elif [[ $l != "$g" ]]; then
+        echo "FAIL $fn: lccc keeps $l stores, GCC 16.2 keeps $g" >&2
+        sed -n "/^$fn:/,/ret/p" "$tmp/lccc.s" >&2
+        fail=$((fail + 1))
+    fi
+done
+if (( fail > 0 )); then
+    echo "check_typedef_volatile_codegen: FAILED ($fail)" >&2
+    exit 1
+fi
+echo "check_typedef_volatile_codegen: PASSED (13 functions, store counts match GCC 16.2)"
diff --git a/tests/regression/check_vec_chain_exit_phi.sh b/tests/regression/check_vec_chain_exit_phi.sh
index ffc2eb9f..7fd3da61 100755
--- a/tests/regression/check_vec_chain_exit_phi.sh
+++ b/tests/regression/check_vec_chain_exit_phi.sh
@@ -105,10 +105,15 @@ run_case "no-zerorem-O2" "-O2 -march=$arch" "CCC_NO_MAP_ZERO_REM=1"
 # ---------------------------------------------------------------- contract 2
 note "contract 2: one broadcast per packed loop in the object code (fma == 4*bc / fma == bc)"
 count_sym() { # binary symbol insn-regex
+    # The reader must consume every line objdump writes: `exit`-ing out of the
+    # symbol body sends SIGPIPE to objdump, and under `set -o pipefail` that
+    # pipeline status (141) aborts the whole gate — measured with binutils
+    # 2.40, where objdump keeps writing past the blank line that ends a
+    # symbol. Leave the symbol on the blank line instead of leaving the loop.
     objdump -d --no-show-raw-insn "$1" \
         | awk -v sym="<$2>:" -v pat="$3" '
             $0 ~ "^[0-9a-f]+ " sym { inside=1; next }
-            inside && /^$/ { exit }
+            inside && /^$/ { inside=0; next }
             inside && $0 ~ pat { n++ }
             END { print n+0 }'
 }
diff --git a/tests/regression/check_vector_abi_boundary.sh b/tests/regression/check_vector_abi_boundary.sh
new file mode 100644
index 00000000..e2811da7
--- /dev/null
+++ b/tests/regression/check_vector_abi_boundary.sh
@@ -0,0 +1,100 @@
+#!/usr/bin/env bash
+# AUD-VABI-1: a vector crossing a compiler boundary must use the psABI rule
+# (SSE + SSEUP = ONE %xmm), in BOTH directions, not lccc's own convention.
+#
+# The shape this pins: lccc's struct rule has no SSEUP notion, so a 16-byte
+# vector was passed and returned as a two-register INTEGER pair.  That is
+# invisible in an all-lccc build and fatal the moment a system library compiled
+# by gcc returns or accepts a vector: `lccc main.o + gcc ext.o` read the result
+# from %rdx:%rax where gcc had written %xmm0.
+#
+# The oracle is gcc itself, in all four combinations (each side compiled by each
+# compiler), so the gate cannot pass by inventing a third convention that only
+# lccc understands -- lccc/gcc must agree with gcc/gcc AND with gcc/lccc.
+set -euo pipefail
+
+repo=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
+ccc=${CCC:-$repo/target/fastbuild/lccc}
+gcc_bin=${GCC:-gcc}
+src=$repo/tests/regression/vector_abi_boundary/vector_abi.c
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+
+[ -x "$ccc" ] || { echo "SKIP: $ccc not built" >&2; exit 0; }
+command -v "$gcc_bin" >/dev/null 2>&1 || {
+    echo "SKIP: oracle unavailable ($gcc_bin not found)" >&2; exit 0; }
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+# The callee half is built from the same source with main() compiled out, so
+# both compilers see identical declarations on both sides.
+for opt in -O0 -O2; do
+    tag=${opt#-}
+    "$gcc_bin" "$opt" -DCALLEE_ONLY -c "$src" -o "$tmp/callee_gcc$tag.o"
+    "$ccc" "$opt" -DCALLEE_ONLY -c "$src" -o "$tmp/callee_lccc$tag.o"
+    "$gcc_bin" "$opt" -c "$src" -o "$tmp/caller_gcc$tag.o"
+    "$ccc" "$opt" -c "$src" -o "$tmp/caller_lccc$tag.o"
+
+    # gcc/gcc is the reference the other three must match.
+    "$gcc_bin" "$tmp/caller_gcc$tag.o" "$tmp/callee_gcc$tag.o" -o "$tmp/ref$tag"
+    "$tmp/ref$tag" >"$tmp/ref$tag.out"
+
+    # caller lccc -> callee gcc (lccc must SPEAK the ABI)
+    "$gcc_bin" "$tmp/caller_lccc$tag.o" "$tmp/callee_gcc$tag.o" -o "$tmp/c1$tag" ||
+        fail "$opt: linking lccc caller with gcc callee failed"
+    "$tmp/c1$tag" >"$tmp/c1$tag.out"
+    diff -u "$tmp/ref$tag.out" "$tmp/c1$tag.out" >&2 ||
+        fail "$opt: lccc caller + gcc callee disagrees with gcc/gcc"
+
+    # caller gcc -> callee lccc (lccc must UNDERSTAND the ABI)
+    "$gcc_bin" "$tmp/caller_gcc$tag.o" "$tmp/callee_lccc$tag.o" -o "$tmp/c2$tag" ||
+        fail "$opt: linking gcc caller with lccc callee failed"
+    "$tmp/c2$tag" >"$tmp/c2$tag.out"
+    # Compare THIS leg's output: an earlier version of this gate diffed
+    # "$tmp/c1$tag.out" here, so the gcc-caller/lccc-callee leg -- the one that
+    # proves lccc UNDERSTANDS the ABI -- passed vacuously on the back of the
+    # previous leg's already-verified file.
+    diff -u "$tmp/ref$tag.out" "$tmp/c2$tag.out" >&2 ||
+        fail "$opt: gcc caller + lccc callee disagrees with gcc/gcc"
+
+    # and lccc/lccc must not have been left behind by the fix
+    "$ccc" -I"$repo/include" "$tmp/caller_lccc$tag.o" "$tmp/callee_lccc$tag.o" -o "$tmp/c3$tag" ||
+        fail "$opt: linking the two lccc objects failed"
+    "$tmp/c3$tag" >"$tmp/c3$tag.out"
+    diff -u "$tmp/ref$tag.out" "$tmp/c3$tag.out" >&2 ||
+        fail "$opt: lccc/lccc disagrees with gcc/gcc"
+    echo "ok: $opt all four caller/callee combinations match gcc/gcc"
+
+    # Liveness of the comparison itself.  A gate that diffs the wrong file
+    # passes vacuously -- which is precisely what this gate did before review
+    # (the gcc-caller/lccc-callee leg compared the previous leg's output).  A
+    # callee that returns the wrong value MUST make one of those diffs fail;
+    # if it does not, the comparison is not looking at the callee's result.
+    "$ccc" "$opt" -DCALLEE_ONLY -DVABI_CALLEE_MUTATION -c "$src" -o "$tmp/callee_mut$tag.o"
+    "$gcc_bin" "$tmp/caller_gcc$tag.o" "$tmp/callee_mut$tag.o" -o "$tmp/mut$tag"
+    "$tmp/mut$tag" >"$tmp/mut$tag.out" || true
+    if cmp -s "$tmp/ref$tag.out" "$tmp/mut$tag.out"; then
+        fail "$opt: a deliberately wrong callee produced the reference output; the comparison is not live"
+    fi
+done
+
+# Assert the CONVENTION, not the arithmetic: which registers the arguments
+# ARRIVE in.  A v2df argument pair must arrive in %xmm1 (one register per
+# argument) while the {double,double} control must arrive in %xmm2/%xmm3 (two
+# registers per argument).  Checking the arrival registers stays true at every
+# optimisation level; an arithmetic-operand match would only hold at -O0, where
+# the optimizer has not yet spilled the arguments to their homes.
+for opt in -O0 -O2; do
+    tag=${opt#-}
+    "$ccc" "$opt" -DCALLEE_ONLY -S "$src" -o "$tmp/callee$tag.s"
+    awk '/^add_v2df:/{f=1} f{print} f&&/\.size/{exit}' "$tmp/callee$tag.s" >"$tmp/v2df$tag.s"
+    grep -qE '%xmm1' "$tmp/v2df$tag.s" ||
+        { cat "$tmp/v2df$tag.s" >&2;
+          fail "$opt: add_v2df's second argument no longer arrives in %xmm1"; }
+    awk '/^add_two_f64:/{f=1} f{print} f&&/\.size/{exit}' "$tmp/callee$tag.s" >"$tmp/two_f64$tag.s"
+    grep -qE '%xmm3' "$tmp/two_f64$tag.s" ||
+        { cat "$tmp/two_f64$tag.s" >&2;
+          fail "$opt: the {double,double} control no longer arrives in four registers"; }
+done
+
+echo "PASS: vector arguments and returns use the psABI xmm convention across compilers"
diff --git a/tests/regression/check_volatile_member_codegen.sh b/tests/regression/check_volatile_member_codegen.sh
new file mode 100755
index 00000000..32e5f16c
--- /dev/null
+++ b/tests/regression/check_volatile_member_codegen.sh
@@ -0,0 +1,102 @@
+#!/usr/bin/env bash
+# A member declared `volatile` is a volatile object at every access: `s.f`,
+# `p->f`, `p[i].f`, nested `p->in.f`, and members of anonymous unions. The
+# memory-mapped register block idiom (`struct regs { volatile u32 ctrl; }`
+# through a pointer) depends on it. lccc used to drop every such access at -O2
+# (no store, no load), so a register write could vanish and a status read could
+# be folded. The same holds for `*(volatile T *)addr` casts (the kernel MMIO idiom)
+# and for a volatile load whose value is unused (both reads must stay).
+# Non-volatile loads are not compared: lccc may fold them, as it does. A
+# member's qualifier must also not leak into the next member or into the
+# enclosing declaration.
+#
+# The check counts, per function at -O2, the stores with an immediate source
+# (`mov $imm, mem`) and the memory-operand references (loads and stores). lccc
+# must match GCC 16.2 on every probe, and each probe's GCC count is pinned so a
+# fixture drift is reported as drift, not as a lccc bug.
+set -euo pipefail
+. tests/regression/lib/gcc_oracle.sh
+require_gcc_oracle check_volatile_member_codegen || exit 1
+
+CCC=${CCC:-target/fastbuild/lccc}
+[[ -x $CCC ]] || { echo "check_volatile_member_codegen: FAIL: compiler not found at $CCC" >&2; exit 1; }
+tmp=$(mktemp -d "${TMPDIR:-/tmp}/lccc-vm.XXXXXX")
+trap 'rm -rf "$tmp"' EXIT
+gcc_oracle_positive_control "$CCC" "$tmp" || exit 1
+gcc_oracle_positive_control "$GCC_ORACLE_BIN" "$tmp" || exit 1
+
+src=$tmp/vm.c
+cat > "$src" <<'C'
+struct regs { volatile unsigned ctrl; unsigned data; };
+struct regs gregs;
+void m_ptr_store(struct regs *r) { r->ctrl = 1; r->ctrl = 2; }
+void m_obj_store(void) { struct regs r; r.ctrl = 1; r.ctrl = 2; (void)r; }
+void m_global_store(void) { gregs.ctrl = 1; gregs.ctrl = 2; }
+void m_arr_store(struct regs *r) { r[1].ctrl = 1; r[1].ctrl = 2; }
+struct inner { volatile int v; };
+struct outer { int pad; struct inner in; };
+void m_nested_store(struct outer *o) { o->in.v = 1; o->in.v = 2; }
+struct anon_u { union { volatile int av; int plain; }; int z; };
+void m_anon_store(struct anon_u *a) { a->av = 1; a->av = 2; }
+struct next_leak { volatile int a; int b; };
+void m_next_member_store(void) { struct next_leak s; s.b = 1; s.b = 2; (void)s; }
+void m_plain_field_store(struct regs *r) { r->data = 1; r->data = 2; }
+unsigned l_vol_read(volatile struct regs *r) { unsigned a = r->ctrl; unsigned b = r->ctrl; return a + b; }
+void c_cast_store(unsigned long a) { *(volatile unsigned *)a = 1; *(volatile unsigned *)a = 2; }
+void c_arr_cast_store(unsigned long a) { ((volatile unsigned *)a)[1] = 1; ((volatile unsigned *)a)[1] = 2; }
+void c_cast_read(unsigned long a) { unsigned x = *(volatile unsigned *)a; unsigned y = *(volatile unsigned *)a; (void)(x + y); }
+void c_cast_stmt_read(unsigned long a) { *(volatile unsigned *)a; *(volatile unsigned *)a; }
+void v_unused_member_read(volatile struct regs *r) { unsigned a = r->ctrl; unsigned b = r->ctrl; (void)(a + b); }
+C
+
+# Store count: a mov with an immediate source to a memory operand.
+count_stores() {
+    awk -v want="$2" '
+        /^[A-Za-z_][A-Za-z0-9_]*:/ { fn = $0; sub(/:.*/, "", fn) }
+        /^[ \t]+mov[lq]?[ \t]+\$/ && fn == want && /\(/ { n++ }
+        END { print n + 0 }' "$1"
+}
+# Memory-operand references: every instruction that reads or writes memory.
+count_mem_refs() {
+    awk -v want="$2" '
+        /^[A-Za-z_][A-Za-z0-9_]*:/ { fn = $0; sub(/:.*/, "", fn) }
+        /^[ \t]+[a-z]+[ \t]/ && fn == want && /\(%/ { n++ }
+        END { print n + 0 }' "$1"
+}
+
+fail=0
+"$GCC_ORACLE_BIN" -O2 -S -o "$tmp/gcc.s" "$src"
+"$CCC" -O2 -S "$src" -o "$tmp/lccc.s"
+
+# function:metric:pinned-GCC-count. Store probes count immediate stores; load
+# probes count memory-operand references.
+for probe in m_ptr_store:store:2 m_obj_store:store:2 m_global_store:store:2 \
+    m_arr_store:store:2 m_nested_store:store:2 m_anon_store:store:2 \
+    m_next_member_store:store:0 m_plain_field_store:store:1 \
+    l_vol_read:mem:2 c_cast_store:store:2 c_arr_cast_store:store:2 c_cast_read:mem:2 \
+    c_cast_stmt_read:mem:2 v_unused_member_read:mem:2; do
+    rest=${probe#*:}
+    fn=${probe%%:*}
+    metric=${rest%%:*}
+    want=${rest##*:}
+    if [[ $metric == store ]]; then
+        g=$(count_stores "$tmp/gcc.s" "$fn")
+        l=$(count_stores "$tmp/lccc.s" "$fn")
+    else
+        g=$(count_mem_refs "$tmp/gcc.s" "$fn")
+        l=$(count_mem_refs "$tmp/lccc.s" "$fn")
+    fi
+    if [[ $g != "$want" ]]; then
+        echo "FAIL $fn: GCC 16.2 $metric count is $g, the probe pins $want (fixture drift)" >&2
+        fail=$((fail + 1))
+    elif [[ $l != "$g" ]]; then
+        echo "FAIL $fn: lccc $metric count is $l, GCC 16.2 keeps $g" >&2
+        sed -n "/^$fn:/,/\.size $fn,/p" "$tmp/lccc.s" >&2
+        fail=$((fail + 1))
+    fi
+done
+if (( fail > 0 )); then
+    echo "check_volatile_member_codegen: FAILED ($fail)" >&2
+    exit 1
+fi
+echo "check_volatile_member_codegen: PASSED (15 functions, store and memory-reference counts match GCC 16.2)"
