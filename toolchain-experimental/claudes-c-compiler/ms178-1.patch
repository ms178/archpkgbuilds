+fn flag_stem<'a>(m: &'a str, stems: &[&str]) -> Option<&'a str> {
+    if stems.contains(&m) {
+        return Some(m);
+    }
+    let base = m.strip_suffix(['b', 'w', 'l'])?;
+    stems.contains(&base).then_some(base)
