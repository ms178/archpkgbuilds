diff --git a/tests/workloads/dispatch/README.md b/tests/workloads/dispatch/README.md
new file mode 100644
index 00000000..b93cf120
--- /dev/null
+++ b/tests/workloads/dispatch/README.md
@@ -0,0 +1,23 @@
+# Dispatch-shaped micro-workloads (AUD-CPU-1 evidence)
+
+Two small programs whose purpose is to make the *cost of the runtime
+`__builtin_cpu_supports` model* measurable with a plain instruction counter
+(valgrind/callgrind), because this VM has no PMU and wall-clock numbers on a
+shared 2-vCPU box are not evidence.
+
+* `two_way_dispatch.c` — one dispatch site, called 50 M times from a
+  `noinline` callee, so the loop-invariant probe cannot be hoisted out of the
+  loop.  `-DINIT_ONLY` compiles the single-call variant that exposes the
+  one-time CPUID initialisation instead.
+* `crc32_dispatch.c` — the idiom every runtime-dispatched library uses: one
+  `__builtin_cpu_supports` query chooses between a narrow and a wide integer
+  kernel over a deterministic 64 KiB buffer.  It is byte-for-byte
+  output-identical across compilers, so the instruction counts are comparable.
+
+`run.sh` builds each program with LCCC (and, when present, GCC and Clang),
+runs it under `callgrind`, and prints `PROGRAM TOTALS` per binary.  The
+numbers are instruction counts, i.e. independent of the host's load and
+frequency — the only honest measurement available here.
+
+No wall-clock claims are made from this directory: the target hardware is an
+i7-14700KF, and this VM cannot stand in for it.
diff --git a/tests/workloads/dispatch/crc32_dispatch.c b/tests/workloads/dispatch/crc32_dispatch.c
new file mode 100644
index 00000000..cdece2b9
--- /dev/null
+++ b/tests/workloads/dispatch/crc32_dispatch.c
@@ -0,0 +1,57 @@
+/* Dispatch-shaped workload: one runtime feature test decides the inner loop,
+ * like zlib-ng/zstd/xz/OpenSSL.  The kernel body is loop-carried and
+ * deterministic so LCCC and GCC binaries can be compared instruction-for-
+ * instruction with callgrind.
+ */
+#include <stdio.h>
+#include <stdint.h>
+
+static uint32_t table[256];
+static void init_table(void) {
+    uint32_t c;
+    int n, k;
+    for (n = 0; n < 256; n++) {
+        c = (uint32_t)n;
+        for (k = 0; k < 8; k++) c = (c & 1) ? 0xEDB88320u ^ (c >> 1) : (c >> 1);
+        table[n] = c;
+    }
+}
+
+static uint32_t crc32_byte(const unsigned char *p, long n) {
+    uint32_t crc = 0xFFFFFFFFu;
+    long i;
+    for (i = 0; i < n; i++) crc = table[(crc ^ p[i]) & 0xFF] ^ (crc >> 8);
+    return crc ^ 0xFFFFFFFFu;
+}
+
+static uint32_t crc32_word(const unsigned char *p, long n) {
+    uint32_t crc = 0xFFFFFFFFu;
+    long i;
+    for (i = 0; i + 4 <= n; i += 4) {
+        uint32_t w;
+        __builtin_memcpy(&w, p + i, 4);
+        crc = table[(crc ^ w) & 0xFF] ^ (crc >> 8);
+        crc = table[(crc ^ (w >> 8)) & 0xFF] ^ (crc >> 8);
+        crc = table[(crc ^ (w >> 16)) & 0xFF] ^ (crc >> 8);
+        crc = table[(crc ^ (w >> 24)) & 0xFF] ^ (crc >> 8);
+    }
+    for (; i < n; i++) crc = table[(crc ^ p[i]) & 0xFF] ^ (crc >> 8);
+    return crc ^ 0xFFFFFFFFu;
+}
+
+int main(void) {
+    static unsigned char buf[1 << 16];
+    long i, rounds = 4000;
+    uint32_t acc = 0;
+    init_table();
+    for (i = 0; i < (long)sizeof(buf); i++) buf[i] = (unsigned char)(i * 31 + 7);
+    /* The dispatch site: exactly one runtime query, both paths integer-only
+     * (the vector path is what a real dispatcher would select). */
+    if (__builtin_cpu_supports("avx2") || __builtin_cpu_supports("sse2")) {
+        for (i = 0; i < rounds; i++) acc ^= crc32_word(buf, sizeof(buf));
+    } else {
+        for (i = 0; i < rounds; i++) acc ^= crc32_byte(buf, sizeof(buf));
+    }
+    printf("%u\n", acc);
+    return 0;
+}
diff --git a/tests/workloads/dispatch/run.sh b/tests/workloads/dispatch/run.sh
new file mode 100755
index 00000000..dedabce7
--- /dev/null
+++ b/tests/workloads/dispatch/run.sh
@@ -0,0 +1,78 @@
+#!/usr/bin/env bash
+# Instruction-count evidence for the __builtin_cpu_supports runtime model.
+#
+# Usage: tests/workloads/dispatch/run.sh [compiler ...]   (default: lccc gcc clang)
+# Env:   LCCC=/path/to/lccc   GCC_BIN=...   CLANG_BIN=...   VALGRIND=valgrind
+#        ITERS=50000000   loop trips of two_way_dispatch (kept identical for
+#                         every compiler, so the counts are comparable)
+#        KEEP=1           keep the raw callgrind outputs under OUT=<dir>
+#
+# For every compiler the script prints callgrind `PROGRAM TOTALS`
+# (= retired instructions, a PMU-free proxy that is immune to host load):
+#
+#   probe    two_way_dispatch.c              one __builtin_cpu_supports per call
+#   control  two_way_dispatch.c -DNO_PROBE   one volatile flag load per call
+#   delta    (probe - control) / ITERS       marginal cost of the probe itself
+#   init     two_way_dispatch.c -DINIT_ONLY  one-time CPUID initialisation
+#   crc32    crc32_dispatch.c                dispatch site over a CRC32 loop
+#
+# A binary that does not run, or prints the wrong answer, is not evidence: the
+# script refuses to report a count for it.
+set -uo pipefail
+here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+repo=$(CDPATH= cd -- "$here/../../.." && pwd)
+LCCC=${LCCC:-$repo/target/fastbuild/lccc}
+VALGRIND=${VALGRIND:-valgrind}
+ITERS=${ITERS:-50000000}
+out=${OUT:-$(mktemp -d)}
+trap '[ -n "${KEEP:-}" ] || rm -rf "$out"' EXIT
+mkdir -p "$out"
+
+compilers=("$@")
+[ ${#compilers[@]} -gt 0 ] || compilers=(lccc gcc clang)
+
+pick_cc() {
+    case $1 in
+        lccc) printf '%s' "$LCCC" ;;
+        gcc)  printf '%s' "${GCC_BIN:-gcc}" ;;
+        clang) printf '%s' "${CLANG_BIN:-clang}" ;;
+        *)   printf '%s' "$1" ;;
+    esac
+}
+
+count() {  # binary, label -> executed instructions (printable)
+    local bin=$1 label=$2
+    "$VALGRIND" --tool=callgrind --callgrind-out-file="$out/cg.$label" \
+        --quiet "$bin" >"$out/stdout.$label" 2>"$out/err.$label"
+    callgrind_annotate "$out/cg.$label" 2>/dev/null |
+        awk '/PROGRAM TOTALS/ {gsub(/,/, "", $1); print $1; exit}'
+}
+
+for ccname in "${compilers[@]}"; do
+    cc=$(pick_cc "$ccname")
+    command -v "$cc" >/dev/null 2>&1 || { echo "$ccname: not found"; continue; }
+    src="$here/two_way_dispatch.c"
+    build() {  # output-suffix, defs...
+        local suffix=$1; shift
+        "$cc" -O2 -DITERS="$ITERS" "$@" "$src" -o "$out/$suffix.$ccname" \
+            2>"$out/build.$ccname.err" || return 1
+    }
+    build two_way               || { echo "$ccname: build failed"; head -3 "$out/build.$ccname.err"; continue; }
+    build control -DNO_PROBE    || { echo "$ccname: control build failed"; continue; }
+    build init    -DINIT_ONLY   || { echo "$ccname: init build failed"; continue; }
+    "$cc" -O2 "$here/crc32_dispatch.c" -o "$out/crc32.$ccname" 2>/dev/null \
+        || { echo "$ccname: crc32 build failed"; continue; }
+    [ "$("$out/two_way.$ccname")" = "1" ] || { echo "$ccname: two_way output wrong"; continue; }
+    [ "$("$out/control.$ccname")" = "1" ] || { echo "$ccname: control output wrong"; continue; }
+    [ -n "$("$out/init.$ccname")" ] || { echo "$ccname: init output wrong"; continue; }
+    [ -n "$("$out/crc32.$ccname")" ] || { echo "$ccname: crc32 output wrong"; continue; }
+
+    probe=$(count "$out/two_way.$ccname" "tw.$ccname")
+    control=$(count "$out/control.$ccname" "ct.$ccname")
+    init=$(count "$out/init.$ccname" "in.$ccname")
+    crc32=$(count "$out/crc32.$ccname" "cr.$ccname")
+    delta=$(( (probe - control) / ITERS ))
+    printf '%-8s probe=%-12s control=%-12s delta=%-3s/call init=%-8s crc32=%s\n' \
+        "$ccname" "$probe" "$control" "$delta" "$init" "$crc32"
+done
+echo "(callgrind PROGRAM TOTALS; delta = marginal per-call cost of the probe over one plain load)"
diff --git a/tests/workloads/dispatch/two_way_dispatch.c b/tests/workloads/dispatch/two_way_dispatch.c
new file mode 100644
index 00000000..ff486eaa
--- /dev/null
+++ b/tests/workloads/dispatch/two_way_dispatch.c
@@ -0,0 +1,60 @@
+/* Per-call cost of the runtime __builtin_cpu_supports probe (AUD-CPU-1).
+ *
+ * The builtin is loop-invariant, so a naive loop lets the optimiser hoist it
+ * out (correctly - it is a plain load).  Measuring the *per-site* cost
+ * therefore needs one probe per call: `pick()` is noinline and the result
+ * depends on the induction variable, so every iteration pays one real call,
+ * one real probe and one select, and no compiler can collapse the loop.
+ *
+ * Three modes, all built from this file so the loop is character-identical:
+ *
+ *   (default)    pick() = __builtin_cpu_supports("avx2") ? i+1 : -i
+ *   -DNO_PROBE   pick() = control_flag          ? i+1 : -i   (one volatile
+ *                load, i.e. the cheapest possible stand-in for "read a flag";
+ *                volatile so no compiler may hoist or fold it).  The delta
+ *                `probe - control` is the marginal cost of the probe
+ *                machinery: its initialisation guard plus the word load and
+ *                AND, over and above one memory read.
+ *   -DINIT_ONLY  calls the builtin exactly once, so callgrind sees the
+ *                one-time initialisation cost (the CPUID sequence).
+ *
+ * A measured binary must print `1` (probe stable across the loop); run.sh
+ * refuses to report a count for a binary that did not.
+ */
+#include <stdio.h>
+
+#if defined(NO_PROBE)
+static volatile int control_flag = 1;
+#endif
+
+#ifndef ITERS
+#define ITERS 50000000
+#endif
+
+__attribute__((noinline)) int pick(long i) {
+#if defined(INIT_ONLY)
+    (void)i;
+    return !!__builtin_cpu_supports("avx2");
+#elif defined(NO_PROBE)
+    return control_flag ? (int)i + 1 : -(int)i;
+#else
+    return __builtin_cpu_supports("avx2") ? (int)i + 1 : -(int)i;
+#endif
+}
+
+int main(void) {
+#ifdef INIT_ONLY
+    printf("%d\n", pick(0));
+    return 0;
+#else
+    long i;
+    int s = 0;
+    for (i = 0; i < ITERS; i++) {
+        s += pick(i);
+    }
+    /* Both arms are positive for every i and the sign of the sum is stable,
+     * so this is 1 iff the probe answer did not change under the loop. */
+    printf("%d\n", s > 0 ? 1 : 0);
+    return 0;
+#endif
+}
diff --git a/tools/workspace_dirs.sh b/tools/workspace_dirs.sh
new file mode 100644
index 00000000..53a7ba36
--- /dev/null
+++ b/tools/workspace_dirs.sh
@@ -0,0 +1,39 @@
+#!/usr/bin/env bash
+# Shared resolution of the PERSISTED (user-facing) workspace directories.
+#
+# AUD-DOC-1: 30 scripts hardcoded `/home/user`, which is the path in ONE of the
+# harnesses this project runs in.  A second harness mounts the user-facing
+# directory at /mnt/user-data/outputs and has no /home/user at all, so every
+# hardcoded path silently wrote into a void (or failed late, after the work was
+# done).  Resolve once, from the environment, with a loud failure:
+#
+#   LCCC_WORKSPACE   explicit override (wins)
+#   /home/user       this project's primary harness
+#   /mnt/user-data/outputs   the alternate harness
+#   $PWD             last resort: the caller's directory (never silent)
+#
+# Usage:
+#   . "$(dirname "$0")/..//tools/workspace_dirs.sh"
+#   ws=$(lccc_workspace_dir)          # persisted workspace root
+#   art=$(lccc_artifacts_dir)         # $ws/artifacts
+#   patch=$(lccc_deliverable_path)    # $ws/ms178-1.patch
+lccc_workspace_dir() {
+    if [[ -n ${LCCC_WORKSPACE:-} ]]; then
+        [[ -d $LCCC_WORKSPACE ]] || { echo "LCCC_WORKSPACE=$LCCC_WORKSPACE is not a directory" >&2; return 1; }
+        printf '%s\n' "$LCCC_WORKSPACE"; return 0
+    fi
+    local candidate
+    for candidate in /home/user /mnt/user-data/outputs; do
+        if [[ -d $candidate && -w $candidate ]]; then
+            printf '%s\n' "$candidate"; return 0
+        fi
+    done
+    if [[ -w $PWD ]]; then
+        printf '%s\n' "$PWD"; return 0
+    fi
+    echo "no writable persisted workspace found; set LCCC_WORKSPACE" >&2
+    return 1
+}
+
+lccc_artifacts_dir() { printf '%s/artifacts\n' "$(lccc_workspace_dir)" || return 1; }
+lccc_deliverable_path() { printf '%s/ms178-1.patch\n' "$(lccc_workspace_dir)" || return 1; }
