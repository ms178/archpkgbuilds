+fn local_symbol(text: &str) -> Option<&str> {
+    let b = text.as_bytes();
+    if b.len() < 3 || b[0] != b'.' || b[1] != b'L' {
+        return None;
+    }
+    let mut n = 2;
+    while n < b.len()
+        && (b[n].is_ascii_alphanumeric() || b[n] == b'_' || b[n] == b'.' || b[n] == b'$')
