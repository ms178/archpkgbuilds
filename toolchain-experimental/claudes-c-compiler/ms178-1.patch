+                    "-T", "gc.ld", "gc.o"]
+        r = sh([lccc_ld] + override + ["-o", "out.nogc.lccc"], cwd=td)
+        if r.returncode != 0:
+            return Result(name, "FAIL", f"lccc no-GC override failed: {r.stderr.decode()[:300]}")
+        r = sh(["ld.bfd"] + override + ["-o", "out.nogc.bfd"], cwd=td)
+        if r.returncode != 0:
