+! grep -Eq 'movq[[:space:]]+%r(di|si),' <<<"$on"
+grep -q '\.cfi_def_cfa_offset 8' <<<"$on"
+grep -q 'pushq' <<<"$off"
+grep -Eq 'subq.*%rsp' <<<"$off"
