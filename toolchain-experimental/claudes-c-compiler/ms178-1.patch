+                         {'clang-cache-asset', 'clang-agent-payload', 'clang-tag-tree'},
+                         {'clang-cache-asset', 'clang-agent-payload', 'clang-tag-tree'})
+        self.assertEqual(fresh.offline_problems(pins), [])
