From c388b864e376d229bbee35729d22c4b31095b623 Mon Sep 17 00:00:00 2001
From: Arena Agent <agent@arena.ai>
Date: Mon, 17 Aug 2026 09:21:06 +0000
Subject: [PATCH 2/2] i686 asm: A0/A1/A2/A3 accumulator moffs shortform for
 absolute mov

GAS encodes `movl sym, %eax` as A1 <disp32> and `movl %eax, sym` as
A3 <disp32> -- one byte shorter than the 8B/89 ModRM form we emitted.
Same for the byte forms A0/A2 and, with the 66 prefix, the 16-bit
accumulator. This was a documented, deliberately-deferred deviation;
it is now implemented and byte-exact against GAS in BOTH .code32 and
.code16 (moffs.s / moffs16.s probes: raw .text cmp equal, relocation
offsets equal, R_386_16 in .code16).

Non-accumulator registers keep the ModRM form, exactly like GAS.

Validation: cargo test 687; regression 200; correctness 50;
intrinsics 3; linker 86; asm-diff exact; fuzz 300/300 (O2+Os).
---
 src/backend/i686/assembler/encoder/core.rs    | 24 +++++++++++++++++++
 .../i686/assembler/encoder/gp_integer.rs      | 13 ++++++++++
 2 files changed, 37 insertions(+)

diff --git a/src/backend/i686/assembler/encoder/core.rs b/src/backend/i686/assembler/encoder/core.rs
index dc0b8558..51f0caf2 100644
--- a/src/backend/i686/assembler/encoder/core.rs
+++ b/src/backend/i686/assembler/encoder/core.rs
@@ -52,6 +52,30 @@ impl super::InstructionEncoder {
     /// .code16:     mod=00 rm=110 + disp16 + R_386_16 (GAS: `8b 16 <d16>`
     /// for `movw sym, %dx`). A 16-bit reloc field also means the addend
     /// must fit 16 bits, which holds for all real-mode setup symbols.
+    /// Emit ONLY the absolute-address displacement (no ModRM) -- the moffs
+    /// field of the accumulator shortforms A0/A1/A2/A3. Width follows the
+    /// current code mode: disp16 + R_386_16 in .code16, disp32 + R_386_32
+    /// otherwise (matching GAS).
+    pub(super) fn encode_abs_addr_disp_only(&mut self, label: &str) -> Result<(), String> {
+        if let Ok(addr) = label.parse::<i64>() {
+            if self.code16 {
+                self.bytes.extend_from_slice(&(addr as i16).to_le_bytes());
+            } else {
+                self.bytes.extend_from_slice(&(addr as i32).to_le_bytes());
+            }
+            return Ok(());
+        }
+        let (sym, addend) = split_label_offset(label);
+        if self.code16 {
+            self.add_relocation(sym, R_386_16, addend);
+            self.bytes.extend_from_slice(&[0, 0]);
+        } else {
+            self.add_relocation(sym, R_386_32, addend);
+            self.bytes.extend_from_slice(&[0, 0, 0, 0]);
+        }
+        Ok(())
+    }
+
     pub(super) fn encode_abs_addr_modrm(&mut self, reg_field: u8, label: &str) -> Result<(), String> {
         // Numeric literal labels are absolute addresses with no relocation.
         if let Ok(addr) = label.parse::<i64>() {
diff --git a/src/backend/i686/assembler/encoder/gp_integer.rs b/src/backend/i686/assembler/encoder/gp_integer.rs
index 05e722dd..a395ce65 100644
--- a/src/backend/i686/assembler/encoder/gp_integer.rs
+++ b/src/backend/i686/assembler/encoder/gp_integer.rs
@@ -72,6 +72,14 @@ impl super::InstructionEncoder {
                 let dst_num = reg_num(&dst.name).ok_or_else(|| format!("bad register: {}", dst.name))?;
                 if size == 2 || size == 4 { self.sized_op = true; }
         if size == 2 { self.bytes.push(0x66); }
+                // GAS uses the accumulator moffs shortform: A0 (byte) / A1
+                // (word/dword) followed by the bare address -- one byte
+                // shorter than the ModRM form. Match it exactly (asm-diff
+                // oracle: `movl sym, %eax` == a1 <disp32>).
+                if dst_num == 0 {
+                    self.bytes.push(if size == 1 { 0xA0 } else { 0xA1 });
+                    return self.encode_abs_addr_disp_only(label);
+                }
                 self.bytes.push(if size == 1 { 0x8A } else { 0x8B });
                 self.encode_abs_addr_modrm(dst_num, label)
             }
@@ -80,6 +88,11 @@ impl super::InstructionEncoder {
                 let src_num = reg_num(&src.name).ok_or_else(|| format!("bad register: {}", src.name))?;
                 if size == 2 || size == 4 { self.sized_op = true; }
         if size == 2 { self.bytes.push(0x66); }
+                // Accumulator shortform: A2 (byte) / A3 (word/dword).
+                if src_num == 0 {
+                    self.bytes.push(if size == 1 { 0xA2 } else { 0xA3 });
+                    return self.encode_abs_addr_disp_only(label);
+                }
                 self.bytes.push(if size == 1 { 0x88 } else { 0x89 });
                 self.encode_abs_addr_modrm(src_num, label)
             }
