+            LineKind::Label | LineKind::CondJmp | LineKind::Jmp | LineKind::JmpIndirect
+            | LineKind::Ret => {
+                zero_upper = [false; 16];
+                i += 1;
+                continue;
+            }
+            LineKind::Call => {
+                for &f in &CALLER_SAVED {
+                    zero_upper[f] = false;
+                }
+                i += 1;
+                continue;
+            }
+            LineKind::Pop { reg } => {
+                if reg <= 15 {
+                    zero_upper[reg as usize] = false;
+                }
