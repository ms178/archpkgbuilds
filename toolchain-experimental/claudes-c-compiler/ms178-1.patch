+/// explicitly (`-msse4.2 -mno-popcnt` has no POPCNT; an `arch=` forgets
+/// what the command line made explicit).
+pub(crate) const X86_IMPLIED: &[(u64, u64)] = &[
+    (1 << Sse as u8, 1 << Mmx as u8),
+    (1 << Sse42 as u8, 1 << Popcnt as u8),
+    (ABM, 1 << Lzcnt as u8),
