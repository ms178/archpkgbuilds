+        // clang::offset(N) skips the first N bytes; limit bounds the count
+        // of what remains.
+        let skip = params.offset.unwrap_or(0).min(bytes.len());
+        let remaining = &bytes[skip..];
+        let take = match params.limit {
+            Some(n) if n < remaining.len() => n,
+            _ => remaining.len(),
