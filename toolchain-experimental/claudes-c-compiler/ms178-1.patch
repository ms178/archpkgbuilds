+            "    movq %rsp, %rbp\n",
+            "    movq %rbp, %r11\n",
+            "    addq %r11, %rax\n",
+            "    popq %rbp\n",
+            "    ret"
+        ));
+        assert_eq!(super::count(&out, "movq %rbp, %r11"), 1, "{out}");
+        assert!(out.contains("addq %r11, %rax"), "{out}");
+    }
+
+    /// `%rsp` is never a copy source or destination, frameless or not:
+    /// push/pop/call move it implicitly.
