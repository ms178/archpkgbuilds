+        let asm = "f:\n    pushl %ebx\n    movl %eax, %ebx\n    call *%ebx\n    popl %ebx\n    ret\n".to_string();
+        let result = peephole_optimize(asm);
+        assert!(result.contains("call *%ebx"), "must stay a call:\n{}", result);
+    }
