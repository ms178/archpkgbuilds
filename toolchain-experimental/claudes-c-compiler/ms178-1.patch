+#[derive(Clone)]
+struct ConditionalIncrementFusion {
+    select_idx: usize,
+    add_idx: usize,
+    cmp_idx: Option<usize>,
+    base: Operand,
+    increment_ty: IrType,
+    increment_on_true: bool,
