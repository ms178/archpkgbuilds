+        ("movq 16(%rsp), %r15", "addq %r10, %r15", "adcq $0, %r15"),
+        ("movq %rbx, %r15", "addq %r10, %r15", "adcq $0, %r15"),
+        ("movq $7, %r15", "addq %r10, %r15", "adcq $0, %r15"),
