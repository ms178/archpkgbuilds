+#[cfg(test)]
+mod parser_frame_budget_tests {
+    use super::Parser;
+    use crate::frontend::lexer::Lexer;
+
+    fn parser_for(source: &str) -> Parser {
+        let mut lexer = Lexer::new(source, 0);
+        Parser::new(lexer.tokenize())
+    }
+
+    #[test]
+    fn comma_expression_frames_unwind_to_zero() {
+        let mut parser = parser_for("1, 2, 3, 4, 5");
+        let _expr = parser.parse_expr();
+        assert_eq!(parser.parser_frame_depth, 0);
+        assert_eq!(parser.error_count, 0);
+    }
+
+    #[test]
+    fn assignment_expression_frames_unwind_to_zero() {
+        let mut parser = parser_for("a = b += c = 0");
+        let _expr = parser.parse_expr();
+        assert_eq!(parser.parser_frame_depth, 0);
+        assert_eq!(parser.error_count, 0);
+    }
+
+    #[test]
+    fn conditional_expression_frames_unwind_to_zero() {
+        let mut parser = parser_for("1 ? 2 : 3 ? 4 : 5");
+        let _expr = parser.parse_expr();
+        assert_eq!(parser.parser_frame_depth, 0);
+        assert_eq!(parser.error_count, 0);
+    }
+
+    #[test]
+    fn budget_exhaustion_emits_one_diagnostic_and_unwinds_all_frames() {
+        // The production driver gives the parser thread 64 MiB (src/lib.rs).
+        // Match that here: the Rust test harness's default 2 MiB stack is
+        // intentionally not the compiler's supported parser stack ceiling.
+        std::thread::Builder::new()
+            .name("parser-frame-budget-test".into())
+            .stack_size(64 * 1024 * 1024)
+            .spawn(|| {
+                let mut source = String::from("int main(void) { return (");
+                for _ in 0..40_000 {
+                    source.push_str("1,");
+                }
+                source.push_str("1); }\n");
+                let mut parser = parser_for(&source);
+                let _tu = parser.parse();
+                assert!(parser.nesting_budget_diagnosed);
+                assert_eq!(
+                    parser.error_count, 1,
+                    "one budget error per translation unit"
+                );
+                assert_eq!(parser.parser_frame_depth, 0, "all entered frames unwind");
+            })
+            .expect("create production-sized parser test stack")
+            .join()
+            .expect("parser budget test thread must not panic");
+    }
+}
