+        // `fadd %st(1), %st`.
+        assert_eq!(hex("fadd"), "de c1");
+        assert_eq!(hex("fsub"), "de e1");
+        assert_eq!(hex("fsubr"), "de e9");
+        assert_eq!(hex("fmul"), "de c9");
+        assert_eq!(hex("fdiv"), "de f1");
+        assert_eq!(hex("fdivr"), "de f9");
