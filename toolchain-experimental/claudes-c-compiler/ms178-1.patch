+        match feature.as_str() {
+            "sse" => grant[0] = true,
+            "sse2" => grant[..2].fill(true),
+            "sse3" | "ssse3" | "sse4" | "sse4.1" | "sse4.2" | "avx" | "avx2" | "avx512f"
+            | "avx512bw" | "avx512dq" | "avx512vl" | "fma" => grant = [true; 3],
+            _ => {}
+        }
+    }
+    if has("no-sse2") {
+        grant[1] = false;
+        grant[2] = false;
+    }
+    if has("no-sse3") {
+        grant[2] = false;
+    }
+    grant
+}
