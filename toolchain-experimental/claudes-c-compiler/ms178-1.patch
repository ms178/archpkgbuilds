+    debug_assert!(
+        !(needs_scratch(imm) && *other == MachReg::Phys(super::machinst::RAX)),
+        "a wide immediate must be staged through %rax, but %rax is already an \
+         operand of this instruction; the staging would clobber it"
+    );
+}
