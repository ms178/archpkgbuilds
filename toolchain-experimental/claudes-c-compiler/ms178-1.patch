+            }
+        }
+        if flags_hazard {
+            if std::env::var_os("CCC_DEBUG_CMP_FUSE").is_some() {
+                eprintln!("[CMPFUSE] flags-reader hazard after fused jcc — refusing");
+            }
+            i += 1;
+            continue;
+        }
