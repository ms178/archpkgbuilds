+                            if name != "__builtin_memcmp" && ca == 0 { break; }
+                            if i >= ab.len() && i >= bb.len() { break; }
+                            i += 1;
+                        }
+                        return Some(Operand::Const(IrConst::I32(result.signum() as i32)));
