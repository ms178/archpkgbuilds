+            Some(r) => matches!(r.0, 0..=3),
+            None => matches!(
+                self.state.resolve_slot_addr(info.base.0),
+                Some(crate::backend::state::SlotAddr::Direct(_))
+            ),
+        };
+        idx_ok && base_ok
+    }
