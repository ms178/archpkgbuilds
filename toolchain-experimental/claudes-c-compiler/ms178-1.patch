+        let mut infos: Vec<LineInfo> = (0..store.len())
+            .map(|i| classify_line(store.get(i)))
+            .collect();
+        fuse_zero_ext_cmp(&mut store, &mut infos);
+        lines(&store.build_result(|i| infos[i].is_nop()))
+    }
