+                state = state.wrapping_mul(6364136223846793005).wrapping_add(1);
+                let x = if i == 0 {
+                    0
+                } else if i <= 64 {
+                    1u64 << (i - 1)
+                } else {
+                    state
+                };
+                let expected = if trailing {
+                    x.trailing_zeros().min(63)
