+    text = "/* generated by measure_label_ref_cost.py --shape mixed */\n"
+    for function in range(functions):
+        cases = rng.randint(6, 12)
+        lines = [
+            f"__attribute__((noinline)) long mixed_{function}"
+            "(long a, long b, const int *p, int n) {",
+            "    long acc = a ^ b;",
