+    fn numeric_type_classification() {
+        for ty in [
+            IrType::I8,
+            IrType::U8,
+            IrType::I16,
+            IrType::U16,
+            IrType::I32,
+            IrType::U32,
+            IrType::I64,
+            IrType::U64,
+        ] {
+            assert!(cast_is_integer(ty));
+            assert!(!cast_is_float(ty));
+        }
