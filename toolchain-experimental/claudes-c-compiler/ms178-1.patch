+        v_pop
+    } else {
+        let vc = alloc_value(func);
+        extra.push(Instruction::Cast {
+            dest: vc,
+            src: Operand::Value(v_pop),
+            from_ty: pop_ty,
+            to_ty: m.r_ty,
+        });
+        vc
+    };
+
+    let v_res = if operand_const_int(&m.r_init) == Some(0) {
+        v_pop_r
+    } else {
+        let vr = alloc_value(func);
+        extra.push(Instruction::BinOp {
+            dest: vr,
+            op: IrBinOp::Add,
+            lhs: m.r_init,
+            rhs: Operand::Value(v_pop_r),
