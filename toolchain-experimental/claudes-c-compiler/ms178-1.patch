+/// unreachable block is rewriting dead code either way, and refusing is the
+/// conservative answer.
+pub fn dominates_idom(idom: &[usize], a: usize, b: usize) -> bool {
+    if a >= idom.len() || b >= idom.len() {
+        return false;
+    }
+    if a == b {
