+    __asm__ volatile(".long %c0" : : "i"(flags));
+}
+EOF
+if ! "$CCC" -O2 -c "$TMP/local-constant-immediate.c" -o "$TMP/local-constant-immediate.o"; then
+    echo "FAIL local_constant_immediate: optimized local constant should compile" >&2
