+    printf("%d %d\n", sv.a[1], (1 ? sv.a : sv.a)[1]);
+    printf("%d %d %d\n", (0, inc)(4), (1 ? inc : dec)(4), (0 ? inc : dec)(4));
+    int (*f)(int) = 1 ? inc : dec;
+    printf("%d\n", f(10));
+    printf("%d %d\n", *((0, arr) + 1), *(1 ? arr : arr + 1));
