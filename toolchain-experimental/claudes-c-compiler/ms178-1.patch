+/// Linux assigns different O_NONBLOCK values to a few architectures; the
+/// generic 0x800 value is wrong on MIPS and SPARC (and on Linux Alpha/PA-RISC
+/// should those Rust targets become available). These values mirror the
+/// Linux UAPI asm-generic/fcntl.h and arch/{mips,sparc,alpha,parisc}/.../fcntl.h.
+#[cfg(any(target_os = "linux", target_os = "android"))]
+fn linux_nonblock_flag_for_arch(arch: &str) -> i32 {
+    match arch {
+        "mips" | "mips32r6" | "mips64" | "mips64r6" => 0x0080,
+        "sparc" | "sparc64" => 0x4000,
+        "alpha" => 0x0004,
+        "parisc" | "hppa" => 0x1_0000,
+        _ => 0x0800,
+    }
+}
+
+/// Open an embed resource without letting a FIFO with no writer block the
+/// compiler in `open(2)`. O_NONBLOCK is a no-op for regular files and allows
+/// nonblocking character-device reads (e.g. `/dev/zero`). Linux/Android use
+/// the target architecture's UAPI value; Darwin/BSD use 0x4. On other Unix
+/// hosts, reject a FIFO explicitly rather than risking a blocking open; other
+/// resource types retain the platform's normal file-open semantics.
+#[cfg(all(
+    unix,
+    any(
+        target_os = "linux",
+        target_os = "android",
+        target_os = "macos",
+        target_os = "ios",
+        target_os = "freebsd",
+        target_os = "dragonfly",
+        target_os = "openbsd",
+        target_os = "netbsd"
+    )
+))]
+fn open_embed_resource(path: &Path) -> std::io::Result<std::fs::File> {
+    use std::os::unix::fs::OpenOptionsExt;
+    let nonblock = if cfg!(any(target_os = "linux", target_os = "android")) {
+        linux_nonblock_flag_for_arch(std::env::consts::ARCH)
+    } else {
+        0x4
+    };
+    std::fs::OpenOptions::new()
+        .read(true)
+        .custom_flags(nonblock)
+        .open(path)
+}
