+            },
+            Instruction::Load {
+                volatile: false,
+                dest: Value(8),
+                ptr: Value(7),
+                ty: IrType::I64,
+                seg_override: AddressSpace::Default,
+            },
+            Instruction::BinOp {
+                dest: Value(9),
+                op: IrBinOp::Add,
+                lhs: Operand::Value(Value(3)),
+                rhs: Operand::Const(IrConst::I32(1)),
+                ty: IrType::I32,
+            },
+            Instruction::Cast {
+                dest: Value(10),
+                src: Operand::Value(Value(9)),
+                from_ty: IrType::I32,
+                to_ty: IrType::I64,
+            },
+            Instruction::BinOp {
+                dest: Value(11),
+                op: IrBinOp::Mul,
+                lhs: Operand::Value(Value(10)),
+                rhs: Operand::Const(IrConst::I64(56)),
