+                self.state.emit("    setp %al");
+                self.state.emit("    setne %cl");
+                self.state.emit("    orb %cl, %al");
+            }
+            IrCmpOp::Slt | IrCmpOp::Ult | IrCmpOp::Sgt | IrCmpOp::Ugt => {
+                self.state.emit("    seta %al");
+            }
+            IrCmpOp::Sle | IrCmpOp::Ule | IrCmpOp::Sge | IrCmpOp::Uge => {
