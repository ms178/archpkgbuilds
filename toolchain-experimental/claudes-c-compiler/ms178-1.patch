+            }
+            continue;
+        }
+        // Frame-pointer setup / restore / leave.
+        if t.starts_with("movq %rsp, %rbp")
+            || t.starts_with("mov %rsp, %rbp")
+            || t.starts_with("movq %rbp, %rsp")
+            || t.starts_with("mov %rbp, %rsp")
+            || t.starts_with("leave")
