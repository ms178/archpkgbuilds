+}
+expect_accept() { # expect_accept <label> <file>
+    if ! "$CCC" -S -o "$tmp/acc.s" "$2" 2>"$tmp/acc.err"; then
+        echo "FAIL: $1: rejected; GCC 14.2 accepts it" >&2
