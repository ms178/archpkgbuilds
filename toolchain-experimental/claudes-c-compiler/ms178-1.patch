+                Instruction::UnaryOp {
+                    dest,
+                    op,
+                    src: Operand::Value(src),
+                    ty,
+                } if !ty.is_float()
+                    && !matches!(ty, IrType::I128 | IrType::U128 | IrType::F128)
+                    && matches!(op, IrUnaryOp::Neg | IrUnaryOp::Not | IrUnaryOp::Bswap) =>
