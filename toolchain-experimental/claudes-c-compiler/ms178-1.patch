+            src: Operand::Value(next),
+            ..
+        } => next,
+        _ => return false,
+    };
+    if next == iv {
+        return false;
+    }
+
+    let mut next_defs = Vec::new();
+    for (bi, block) in func.blocks.iter().enumerate() {
+        for (ii, inst) in block.instructions.iter().enumerate() {
+            if inst.dest() == Some(next) {
+                next_defs.push((bi, ii));
+            }
+        }
+    }
