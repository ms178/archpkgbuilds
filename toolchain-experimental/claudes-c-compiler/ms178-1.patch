+            X86ExtraFeature::AmxTile => "amx-tile",
+            X86ExtraFeature::AmxInt8 => "amx-int8",
+            X86ExtraFeature::AmxBf16 => "amx-bf16",
+            X86ExtraFeature::Avx10_1 => "avx10.1",
+            X86ExtraFeature::Avx10_2 => "avx10.2",
+            X86ExtraFeature::ApxF => "apxf",
