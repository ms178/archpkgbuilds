+            assert_eq!(run(&mut f), 0);
+        }
+    }
+
+    #[test]
+    fn a_32_bit_source_is_not_matched() {
+        let mut insts = roundtrip(2, 3);
+        insts[4] = cast(13, 12, IrType::U32, IrType::I128);
+        let mut f = func_with(insts);
+        assert_eq!(run(&mut f), 0);
+    }
+}
