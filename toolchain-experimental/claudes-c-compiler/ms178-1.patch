+/// contained in `data`.  Overflow-safe: `off + len` is computed with
+/// `checked_add`, so wrap-around cannot produce a false "in bounds" verdict.
+#[inline]
+pub fn slice_at(data: &[u8], off: usize, len: usize) -> Option<&[u8]> {
