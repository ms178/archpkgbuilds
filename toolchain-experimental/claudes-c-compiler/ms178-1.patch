+    is_loop_guard_shape(
+        data.is_plain_static,
+        data.is_always_inline,
+        data.is_gnu_inline_def,
+        data.has_loops,
+        data.is_recursive,
+        data.address_referenced,
+        data.direct_call_count,
+        data.loop_in_site_count,
+        data.blocks.iter().map(|b| b.instructions.len()).sum(),
+        data.blocks.len(),
+    )
+}
