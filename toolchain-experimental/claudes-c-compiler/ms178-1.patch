+
+        let w = assemble(".text\n.p2align 4\n").unwrap();
+        assert_eq!(w.base.sections[".text"].sh_addralign, 16);
+
+        let w = assemble(".section .foo,\"ax\"\n.byte 1\n").unwrap();
+        assert_eq!(w.base.sections[".foo"].sh_addralign, 1);
+    }
