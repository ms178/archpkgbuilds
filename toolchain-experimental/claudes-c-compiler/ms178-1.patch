diff --git a/tests/regression/switch_i32_negative_jump_table.c b/tests/regression/switch_i32_negative_jump_table.c
new file mode 100644
index 000000000..87573493c
--- /dev/null
+++ b/tests/regression/switch_i32_negative_jump_table.c
@@ -0,0 +1,31 @@
+/* A 32-bit switch index must not depend on unspecified upper argument bits. */
+__attribute__((noinline)) int negative_dense_switch(int x) {
+    switch (x) {
+        case -3: return -50;
+        case -2: return 10;
+        case 0: return 120;
+        case 2: return -10;
+        case 4: return 200;
+        default: return -999;
+    }
+}
+
+static int expected(int x) {
+    if (x == -3) return -50;
+    if (x == -2) return 10;
+    if (x == 0) return 120;
+    if (x == 2) return -10;
+    if (x == 4) return 200;
+    return -999;
+}
+
+int main(void) {
+    /* On AArch64 this w-register increment can leave x with a zero upper
+       half even while its signed 32-bit value is still negative. */
+    for (int x = -8; x <= 8; ++x) {
+        if (negative_dense_switch(x) != expected(x)) {
+            return 1 + (x + 8);
+        }
+    }
+    return 0;
+}
diff --git a/tests/regression/switch_i64_min_jump_table.c b/tests/regression/switch_i64_min_jump_table.c
new file mode 100644
index 000000000..e00a06a65
--- /dev/null
+++ b/tests/regression/switch_i64_min_jump_table.c
@@ -0,0 +1,36 @@
+#include <limits.h>
+
+/* Negating the lowest signed case value must not overflow the table-base
+   computation or turn into an invalid/truncated assembler immediate. */
+__attribute__((noinline)) int min_dense_switch(long long x) {
+    switch (x) {
+        case LLONG_MIN: return 11;
+        case LLONG_MIN + 1: return 13;
+        case LLONG_MIN + 2: return 17;
+        case LLONG_MIN + 3: return 19;
+        case LLONG_MIN + 4: return 23;
+        default: return 7;
+    }
+}
+
+static int expected(long long x) {
+    if (x == LLONG_MIN) return 11;
+    if (x == LLONG_MIN + 1) return 13;
+    if (x == LLONG_MIN + 2) return 17;
+    if (x == LLONG_MIN + 3) return 19;
+    if (x == LLONG_MIN + 4) return 23;
+    return 7;
+}
+
+int main(void) {
+    const long long inputs[] = {
+        0, LLONG_MAX, LLONG_MIN, LLONG_MIN + 1,
+        LLONG_MIN + 2, LLONG_MIN + 3, LLONG_MIN + 4, LLONG_MIN + 5,
+    };
+    for (unsigned int i = 0; i < sizeof(inputs) / sizeof(inputs[0]); ++i) {
+        if (min_dense_switch(inputs[i]) != expected(inputs[i])) {
+            return (int)i + 1;
+        }
+    }
+    return 0;
+}
diff --git a/tests/regression/switch_jump_table_dirty_abi.c b/tests/regression/switch_jump_table_dirty_abi.c
new file mode 100644
index 000000000..bde822577
--- /dev/null
+++ b/tests/regression/switch_jump_table_dirty_abi.c
@@ -0,0 +1,62 @@
+#include <stdint.h>
+#include <stdio.h>
+
+/* A direct SIB jump-table index must use the defined low 32 bits, never
+ * arbitrary upper argument bits. Large sparse return values keep this switch
+ * out of switch_lut so the backend jump-table path is exercised directly. */
+__attribute__((noinline)) int jt32(uint32_t x) {
+    switch (x) {
+    case 0: return 1001;
+    case 1: return 2003;
+    case 2: return 3007;
+    case 3: return 4013;
+    case 4: return 5017;
+    case 5: return 6019;
+    case 6: return 7027;
+    case 7: return 8033;
+    default: return 9901;
+    }
+}
+
+#if defined(__x86_64__)
+typedef int (*jt32_fn)(uint32_t);
+__asm__(
+    ".text\n"
+    ".globl call_dirty32\n"
+    ".type call_dirty32,@function\n"
+    "call_dirty32:\n"
+    "    subq $8, %rsp\n"
+    "    movq %rdi, %rax\n"
+    "    movq %rsi, %rdi\n"
+    "    movl %edx, %edx\n"
+    "    orq %rdx, %rdi\n"
+    "    call *%rax\n"
+    "    addq $8, %rsp\n"
+    "    ret\n"
+    ".size call_dirty32, .-call_dirty32\n");
+extern int call_dirty32(jt32_fn fn, uint64_t upper, uint32_t low);
+#endif
+
+static const int expected[10] = {
+    1001, 2003, 3007, 4013, 5017, 6019, 7027, 8033, 9901, 9901
+};
+
+int main(void) {
+    for (uint32_t x = 0; x < 10; ++x) {
+        if (jt32(x) != expected[x])
+            return 1;
+    }
+#if defined(__x86_64__)
+    const uint64_t uppers[] = {
+        0x1234567800000000ULL, 0xffffffff00000000ULL, 0x8000000000000000ULL
+    };
+    for (unsigned p = 0; p < 3; ++p) {
+        for (uint32_t x = 0; x < 10; ++x) {
+            if (call_dirty32(jt32, uppers[p], x) != expected[x])
+                return 2;
+        }
+    }
+#endif
+    puts("jt32 ok");
+    return 0;
+}
