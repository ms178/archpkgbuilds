+ANCHORS = {'perf14-first-screen-2026-10-11.json': '78e3157109c0a10687c1be588bfaa8ce724fd54cb36fd3aa5479808f28a0ec13',
+ 'perf14-memory-dataflow-2026-10-11.json': '1a47c5469f0868e643c086f8ce5d14a343adf15f5f7ed2b888e106e2812bc23f',
+ 'perf14-vector-address-2026-10-11.json': 'be3c93ab7aefba83281783bf1d5a0429f3a2539b7c43c86f1e9d52dc8e5106dc',
