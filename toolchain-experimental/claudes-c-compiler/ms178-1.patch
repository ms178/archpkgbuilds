+/// Return true when a function contains an intrinsic whose vector/register
+/// representation is outside GVN's scalar value-number and memory-alias model.
+///
+/// GVN only proves equivalence for the explicit scalar ExprKey variants above.
+/// SIMD/AES/PCLMUL intrinsics can carry 128-bit values through stack-backed
+/// temporaries and have target-specific memory semantics. Treating their
+/// surrounding loads/stores as ordinary scalar CSE allowed a later vector fold
+/// to observe stale data (gzip's PCLMUL CRC path at -O2+). This is a
+/// function-local legality bailout, not a global GVN disablement.
+fn contains_intrinsic(func: &IrFunction) -> bool {
+    func.blocks.iter().any(|block| {
+        block.instructions.iter().any(|inst| matches!(inst, Instruction::Intrinsic { .. }))
+    })
+}
