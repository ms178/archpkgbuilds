+        def shape(exe):
+            out = sh(["objdump", "-d", "--no-show-raw-insn", exe], cwd=td).stdout.decode()
+            lines, fn = [], None
+            for ln in out.splitlines():
+                m = re.match(r"^[0-9a-f]+ <(f_\w+)>:$", ln)
+                if m:
+                    fn = m.group(1)
+                    continue
+                if not ln.strip():
