+            self.state.emit_fmt(format_args!(
+                "    {mn} {}(%rax), {ferry}",
+                (off + done) as i64
+            ));
+            self.state
+                .emit_fmt(format_args!("    {mn} {ferry}, {}(%rsp)", done as i64));
+            done += width;
+        }
+        self.state
+            .out
+            .emit_instr_mem_reg("    movq", 0, "rsp", dest);
+        self.state.emit("    movq 8(%rsp), %rax");
+        self.state.emit("    addq $16, %rsp");
+    }
