+/* glibc_hex_float_f128.c — hex-float literals with _FloatN suffixes
+ * (`0x1p-65f128` in glibc s_compoundn_template.c). The lexer used to split
+ * them as "0x1p-65f" + "128" -> syntax error. Also checks q/Q suffixes. */
