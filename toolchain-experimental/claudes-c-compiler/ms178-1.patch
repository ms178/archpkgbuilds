From c519b76952d3b18ce73f246671fa8f5163c3fc0e Mon Sep 17 00:00:00 2001
From: lccc-agent <agent@arena.invalid>
Date: Sat, 24 Oct 2026 21:54:11 +0000
Subject: [PATCH 10/66] passes: fold affine exit compares before the vectorizer

The vectorizer ran on pre-affold IR: `for (i = 0; i + 4 < N; i++)` kept
its exit as `iv + 4 < N` on an I32 IV, which every counted-loop matcher
requires as `iv < limit`.  affine_countdown's byte sum stayed scalar
(5 instructions per byte) although the trip count is a constant.

`affold_prevec` runs fold_affine_exit_compares once (iter 0, -O2+, not
-Os, x86-64/AArch64) right before the main vectorizer, on the dirty-set
driver like its neighbours.  The fold carries its own domain certificate
(constant seed and step, type bounds, fail-closed on non-SSA multi-defs),
so it relies on no later pass; the existing later run stays, because
loop rotation clones exit compares after this point.  Disabled together
with `affold` (CCC_DISABLE_PASSES=affold) or the vectorizer.
---
 src/passes/mod.rs | 32 ++++++++++++++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/src/passes/mod.rs b/src/passes/mod.rs
index 506280733..ad0e9a474 100644
--- a/src/passes/mod.rs
+++ b/src/passes/mod.rs
@@ -2369,6 +2369,38 @@ pub(crate) fn run_passes(
 
         // Phase 2b-vec: x86-64 vectorization — iter 0 only, EARLY in pipeline.
         // Run before GVN/LICM/etc to catch IR in simpler state.
+        // Phase 2b-affold-pre: the affine exit-compare fold, once more right
+        // before the vectorizer.  Every vectorizer arm requires the IV itself
+        // on the left of the exit compare, so the unfolded `iv + C < N` of
+        // `for (i = 0; i + C < N; i++)` kept those loops scalar: the regular
+        // affold run sits after rotation (below), i.e. after the vectorizer.
+        // The fold is a value equivalence with its own domain certificate
+        // (constant seed and step, type bounds), so running it earlier needs
+        // nothing the later passes provide; the later run still folds the
+        // compares rotation clones.  Same kill switch (`affold`).
+        if iter == 0
+            && opt_level >= 2
+            && !optimize_for_size
+            && matches!(
+                target,
+                crate::backend::Target::X86_64 | crate::backend::Target::Aarch64
+            )
+            && !pass_disabled(&disabled, "affold")
+            && !pass_disabled(&disabled, "vectorize")
+        {
+            let n = timed_pass!(
+                "affold_prevec",
+                run_on_visited(
+                    module,
+                    &dirty,
+                    &mut changed,
+                    loop_rotate::fold_affine_exit_compares
+                )
+            );
+            total_changes += n;
+            total_changes_excl_dce += n;
+        }
+
         // The vectorizer currently emits Vec* intrinsics backed by XMM/YMM
         // registers. Other backends deliberately reject those intrinsics, so
         // running this pass for them turns ordinary scalar loops into a compiler
