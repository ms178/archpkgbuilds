+        flags = ["-x", "c", "-Xclang", "-load", "-Xclang", "plugin.so", "-Xlinker", "--as-needed", "-L", "libs", "-lm"]
+        self.assertEqual(perf.binary_command("clang", Path("test.c"), "test.bin", flags),
