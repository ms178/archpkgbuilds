+
+        for mode in ("-pie", "-no-pie"):
+            shapes, glob = {}, {}
+            for tag, bflag in (("lccc", ["-B" + shim]), ("gnu", [])):
+                exe = f"t{mode}.{tag}"
+                r = sh([CC] + bflag + ["-O1", mode, "f.s", "m.c", "-o", exe], cwd=td)
+                if r.returncode != 0:
