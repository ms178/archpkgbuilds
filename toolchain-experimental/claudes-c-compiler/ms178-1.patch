+    /// Every expected word below was produced by GNU as, which assembles
+    /// `fmov d0,lr` to exactly the word it assembles `fmov d0,x30` to.
+    #[test]
+    fn lr_is_a_64bit_general_purpose_register() {
+        assert_eq!(gp_reg_width("lr"), Ok(64));
