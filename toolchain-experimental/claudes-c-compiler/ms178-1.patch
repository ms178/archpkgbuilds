+            let deref_line = infos[k].trimmed(store.get(k));
+            let Some((mnem, _base_reg, dest_text)) = parse_plain_deref(&deref_line, load_reg) else {
+                dbg_stats[4] += 1;
+                i += 1;
+                continue;
+            };
+            dbg_stats[3] += 1;
