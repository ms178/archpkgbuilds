                 // ── Kernel -m flags with per-flag semantic justification ──
                 // (The blanket -mno-* fallback below covers pure ISA-disable
@@ -1078,10 +1094,14 @@ impl Driver {
                 "-msse3" => {
                     self.enable_sse3 = true;
