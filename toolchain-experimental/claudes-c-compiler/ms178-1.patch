+#!/usr/bin/env python3
+"""Differential test: every expression FORM that can produce a by-value
+vector / vector-wrapping-struct argument, for every x86-64 SysV carrier
+(GP, one SSE eightbyte, one 16-byte XMM, MEMORY), passed directly, through
+`...`, and to an unprototyped callee.
+
+The callee is always compiled by the oracle (GCC); the caller is compiled by
+the oracle and by lccc, and the two runs must print identical lines.  This
+pins the *caller-side* operand representation (value vs. address) that a
+shape fuzzer with only lvalue arguments cannot reach: call results, raw
+builtins, ternaries, statement expressions, compound literals, casts.
+
+Usage: check_vector_arg_forms.py --lccc PATH [--cc gcc-16] [--opt -O2 ...]
+"""
+import argparse
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+
+# name, element C type, lane count, printf-able lane expression
+TYPES = [
+    ("v4c", "char", 4),        # 4 B integer lanes: GP
+    ("v2i", "int", 2),         # 8 B: one SSE eightbyte
+    ("v2f", "float", 2),       # 8 B float: one SSE eightbyte
+    ("v4f", "float", 4),       # 16 B: one XMM
+    ("v2d", "double", 2),      # 16 B: one XMM
+    ("v4i", "int", 4),         # 16 B integer lanes: one XMM
+    ("v1d", "double", 1),      # one-lane FP: MEMORY
+]
+
+FORMS = [
+    # id, expression producing the argument (T = vector type, S = wrapper)
+    ("lval_mem", "g_arr[1]"),
+    ("lval_ptr", "p[1]"),
+    ("local", "loc"),
+    ("param", "prm"),
+    ("call", "mk(3)"),
+    ("call_ptr", "fp_mk(4)"),
+    ("arith", "(g_arr[0] + g_arr[1])"),
+    ("ternary", "(sel ? g_arr[0] : mk(5))"),
+    ("comma", "(sel++, g_arr[1])"),
+    ("stmt_expr", "({ T t_ = g_arr[1]; t_ + t_; })"),
+    ("compound", "((T){LANES})"),
+    ("member", "g_wrap.v"),
+    ("call_member", "mkw(6).v"),
+    ("assign", "(loc = g_arr[0])"),
+]
+
+
+def lanes_init(elem, n, base):
+    return ", ".join(f"({elem})({base} + {i} * 3)" for i in range(n))
+
+
+def gen(tname, elem, n):
+    size = n * {"char": 1, "int": 4, "float": 4, "double": 8}[elem]
+    hdr = f"""#include <stdarg.h>
+#include <stdio.h>
+typedef {elem} T __attribute__((vector_size({size})));
+typedef struct {{ T v; }} S;
+"""
+    callee = hdr + f"""
+static long long h(T x) {{ long long r = 0; for (int i = 0; i < {n}; i++) r = r * 131 + (long long)(x[i] * 4); return r; }}
+long long take(int a, T x, int b) {{ return h(x) * 7 + a * 3 + b; }}
+long long takes(int a, S x, int b) {{ return h(x.v) * 11 + a * 3 + b; }}
+long long take_va(int n, ...) {{ va_list ap; va_start(ap, n); T x = va_arg(ap, T); int b = va_arg(ap, int); va_end(ap); return h(x) * 5 + n + b; }}
+long long take_vas(int n, ...) {{ va_list ap; va_start(ap, n); S x = va_arg(ap, S); int b = va_arg(ap, int); va_end(ap); return h(x.v) * 13 + n + b; }}
+long long take_kr(int a, T x, int b) {{ return h(x) * 17 + a * 3 + b; }}
+T mk(int k) {{ T r = {{{lanes_init(elem, n, "k")}}}; return r; }}
+S mkw(int k) {{ S r = {{{{{lanes_init(elem, n, "k * 2")}}}}}; return r; }}
+"""
+    lines = []
+    for fid, expr in FORMS:
+        e = expr.replace("LANES", lanes_init(elem, n, 9))
+        w = e if fid not in ("member", "call_member") else None
+        # vector-typed argument
+        lines.append(f'  sel = 1; loc = g_arr[1]; printf("{fid} direct %lld\\n", take(1, {e}, 2));')
+        lines.append(f'  sel = 0; loc = g_arr[1]; printf("{fid} va %lld\\n", take_va(3, {e}, 4));')
+        lines.append(f'  sel = 1; loc = g_arr[1]; printf("{fid} kr %lld\\n", ((long long (*)())take_kr)(5, {e}, 6));')
+        # struct-wrapped argument built from the same form
+        lines.append(f'  sel = 1; loc = g_arr[1]; {{ S s_ = {{ {e} }}; printf("{fid} wrap %lld\\n", takes(7, s_, 8)); }}')
+        lines.append(f'  sel = 1; loc = g_arr[1]; {{ S s_ = {{ {e} }}; printf("{fid} wrapva %lld\\n", take_vas(9, s_, 10)); }}')
+    caller = hdr + f"""
+long long take(int a, T x, int b);
+long long takes(int a, S x, int b);
+long long take_va(int n, ...);
+long long take_vas(int n, ...);
+long long take_kr();
+T mk(int k);
+S mkw(int k);
+T g_arr[2] = {{ {{{lanes_init(elem, n, 1)}}}, {{{lanes_init(elem, n, 2)}}} }};
+S g_wrap = {{ {{{lanes_init(elem, n, 7)}}} }};
+T (*volatile fp_mk)(int) = mk;
+volatile int sel;
+static void run(T *p, T prm) {{
+  T loc;
+{chr(10).join(lines)}
+  printf("call_wrap %lld\\n", takes(1, mkw(2), 3));
+  printf("call_wrapva %lld\\n", take_vas(1, mkw(2), 3));
+}}
+int main(void) {{ setvbuf(stdout, NULL, _IOLBF, 0); run(g_arr, g_arr[0]); return 0; }}
+"""
+    return callee, caller
+
+
+def sh(cmd, cwd):
+    return subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=120)
+
+
+
+def oracle_error(cc):
+    """None when `cc` is a GCC 16 (the pinned oracle, as in
+    tests/regression/lib/gcc_oracle.sh), otherwise why not: a missing or
+    different compiler is a configuration error, never a silent substitute."""
+    if shutil.which(cc) is None:
+        return f"oracle {cc} not found"
+    try:
+        ver = subprocess.run([cc, "-dumpfullversion"], capture_output=True, text=True, timeout=30).stdout.strip()
+    except (OSError, subprocess.SubprocessError) as e:
+        return f"oracle {cc} unusable: {e}"
+    if ver.split(".")[0] != "16":
+        return f"oracle {cc} is GCC {ver or '?'}, GCC 16 required"
+    return None
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--lccc", required=True)
+    ap.add_argument("--cc", default="gcc-16")
+    ap.add_argument("--opt", action="append", default=None)
+    ap.add_argument("--keep")
+    a = ap.parse_args()
+    err = oracle_error(a.cc)
+    if err:
+        print(f"check_vector_arg_forms: FAIL: {err}", file=sys.stderr)
+        return 2
+    lccc = os.path.abspath(a.lccc)
+    opts = a.opt or ["-O0", "-O2"]
+    fails = 0
+    total = 0
+    with tempfile.TemporaryDirectory() as td:
+        wd = a.keep or td
+        os.makedirs(wd, exist_ok=True)
+        for tname, elem, n in TYPES:
+            callee, caller = gen(tname, elem, n)
+            d = os.path.join(wd, tname)
+            os.makedirs(d, exist_ok=True)
+            open(os.path.join(d, "callee.c"), "w").write(callee)
+            open(os.path.join(d, "caller.c"), "w").write(caller)
+            flags = ["-std=gnu17", "-w"]
+            r = sh([a.cc, "-O2", *flags, "-c", "callee.c", "-o", "callee.o"], d)
+            if r.returncode:
+                print(f"ERROR oracle callee {tname}: {r.stderr[:400]}")
+                return 2
+            r = sh([a.cc, "-O2", *flags, "callee.o", "caller.c", "-o", "ref"], d)
+            if r.returncode:
+                print(f"ERROR oracle caller {tname}: {r.stderr[:400]}")
+                return 2
+            ref = sh(["./ref"], d).stdout.splitlines()
+            for opt in opts:
+                r = sh([lccc, opt, *flags, "-c", "caller.c", "-o", "caller.lccc.o"], d)
+                if r.returncode:
+                    print(f"FAIL {tname} {opt}: lccc compile error: {r.stderr.strip()[:300]}")
+                    fails += len(ref)
+                    total += len(ref)
+                    continue
+                r = sh([a.cc, "callee.o", "caller.lccc.o", "-o", "t"], d)
+                if r.returncode:
+                    print(f"ERROR link {tname} {opt}: {r.stderr[:300]}")
+                    return 2
+                run = sh(["./t"], d)
+                got = run.stdout.splitlines()
+                if run.returncode:
+                    print(f"FAIL {tname} {opt}: exit {run.returncode} after {len(got)} lines")
+                for i, want in enumerate(ref):
+                    total += 1
+                    have = got[i] if i < len(got) else "<missing>"
+                    if have != want:
+                        fails += 1
+                        print(f"FAIL {tname} {opt}: want '{want}' got '{have}'")
+    print(f"check_vector_arg_forms: {total - fails}/{total} pass")
+    return 1 if fails else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tests/regression/check_vector_static_init.sh b/tests/regression/check_vector_static_init.sh
new file mode 100755
index 000000000..c21dc3814
--- /dev/null
+++ b/tests/regression/check_vector_static_init.sh
@@ -0,0 +1,45 @@
+#!/usr/bin/env bash
+# Vector initializers inside aggregates, byte for byte against GCC 16.2.
+#
+# tests/regression/vector_static_init/vsi.c dumps the object representation of
+# every static, static-local and automatic object it initializes.  lccc used to
+# emit a vector member of a static aggregate as its first lane truncated to one
+# byte (`struct { v2d v; } g = {{7.0, 10.0}}` -> `.byte 7; .zero 15`), accept
+# brace elision into vector members only as written, and fold no vector cast.
+# The program is built by the oracle and by lccc at -O0 and -O2; every line
+# must match.  A missing oracle fails the gate; it is never skipped.
+set -euo pipefail
+. tests/regression/lib/gcc_oracle.sh
+require_gcc_oracle check_vector_static_init || exit 1
+
+CCC=${CCC:-target/fastbuild/lccc}
+src=tests/regression/vector_static_init/vsi.c
+[[ -x $CCC ]] || { echo "check_vector_static_init: FAIL: compiler not found at $CCC" >&2; exit 1; }
+
+tmp=$(mktemp -d "${TMPDIR:-/tmp}/lccc-vsi.XXXXXX")
+trap 'rm -rf "$tmp"' EXIT
+
+"$GCC_ORACLE_BIN" -O2 -std=gnu17 -w "$src" -o "$tmp/ref"
+"$tmp/ref" > "$tmp/ref.txt"
+rows=$(wc -l < "$tmp/ref.txt")
+(( rows >= 40 )) || { echo "check_vector_static_init: FAIL: oracle printed only $rows rows" >&2; exit 1; }
+
+fail=0
+for opt in -O0 -O2; do
+    if ! "$CCC" "$opt" -std=gnu17 -w "$src" -o "$tmp/t$opt" 2> "$tmp/err$opt"; then
+        echo "FAIL $opt: lccc rejected the program" >&2
+        sed -n '1,5p' "$tmp/err$opt" >&2
+        fail=$((fail + 1)); continue
+    fi
+    "$tmp/t$opt" > "$tmp/out$opt.txt" || true
+    if ! diff -q "$tmp/ref.txt" "$tmp/out$opt.txt" > /dev/null; then
+        diff "$tmp/ref.txt" "$tmp/out$opt.txt" | grep '^>' | sed "s/^/FAIL $opt: /" >&2 || true
+        fail=$((fail + 1))
+    fi
+done
+
+if (( fail > 0 )); then
+    echo "check_vector_static_init: FAILED" >&2
+    exit 1
+fi
+echo "check_vector_static_init: PASSED ($rows objects x 2 opt levels vs GCC 16)"
diff --git a/tests/regression/check_void_declarators.sh b/tests/regression/check_void_declarators.sh
new file mode 100755
index 000000000..13327ddfd
--- /dev/null
+++ b/tests/regression/check_void_declarators.sh
@@ -0,0 +1,69 @@
+#!/usr/bin/env bash
+# C's constraints on `void` in declarators and on how declarator suffixes
+# compose (C11 6.7p7, 6.7.2.1p3, 6.7.6.2p1, 6.7.6.3p1/p10, 6.5.2.5p1): arrays
+# of void, void objects and members, misplaced void parameters, void compound
+# literals, functions returning arrays or functions, arrays of functions.
+#
+# tests/regression/void_declarators/cases.tsv holds one translation unit per
+# row. GCC 16.2 (tests/regression/lib/gcc_oracle.sh) must still give the
+# recorded verdict and first error (drift check); lccc must give the same
+# verdict and its recorded first error, and accepted rows must compile.
+set -euo pipefail
+. tests/regression/lib/gcc_oracle.sh
+require_gcc_oracle check_void_declarators || exit 1
+
+CCC=${CCC:-target/fastbuild/lccc}
+cases=tests/regression/void_declarators/cases.tsv
+[[ -x $CCC ]] || { echo "check_void_declarators: FAIL: compiler not found at $CCC" >&2; exit 1; }
+[[ -r $cases ]] || { echo "check_void_declarators: FAIL: $cases missing" >&2; exit 1; }
+
+tmp=$(mktemp -d "${TMPDIR:-/tmp}/lccc-void-decl.XXXXXX")
+trap 'rm -rf "$tmp"' EXIT
+gcc_oracle_positive_control "$CCC" "$tmp" || exit 1
+gcc_oracle_positive_control "$GCC_ORACLE_BIN" "$tmp" || exit 1
+
+# The first error message of a compile, without the location prefix.
+first_error() {
+    local out
+    if out=$("$@" 2>&1); then return 0; fi
+    printf '%s\n' "$out" | grep -m1 'error: ' | sed 's/.*error: //'
+    return 1
+}
+
+fail=0 rows=0
+while IFS=$'\t' read -r id expect diag gcc_diag src; do
+    [[ -z $id || $id == \#* ]] && continue
+    rows=$((rows + 1))
+    tu=$tmp/$id.c
+    printf '%s\n' "$src" > "$tu"
+    [[ $gcc_diag == = ]] && gcc_diag=$diag
+
+    if gerr=$(first_error "$GCC_ORACLE_BIN" -std=gnu17 -w -c -o "$tmp/$id.gcc.o" "$tu"); then
+        gv=accept; gerr=-
+    else
+        gv=reject
+    fi
+    if [[ $gv != "$expect" || $gerr != "$gcc_diag" ]]; then
+        echo "FAIL $id: oracle drift: GCC 16.2 gives $gv ($gerr), the table says $expect ($gcc_diag)" >&2
+        fail=$((fail + 1)); continue
+    fi
+    if lerr=$(first_error "$CCC" -std=gnu17 -c -o "$tmp/$id.lccc.o" "$tu"); then
+        lv=accept; lerr=-
+    else
+        lv=reject
+    fi
+    if [[ $lv != "$expect" || $lerr != "$diag" ]]; then
+        echo "FAIL $id: lccc gives $lv ($lerr), expected $expect ($diag)" >&2
+        fail=$((fail + 1)); continue
+    fi
+done < "$cases"
+
+if (( rows == 0 )); then
+    echo "check_void_declarators: FAIL: no rows in $cases" >&2
+    exit 1
+fi
+if (( fail )); then
+    echo "check_void_declarators: FAIL: $fail of $rows rows" >&2
+    exit 1
+fi
+echo "check_void_declarators: PASS ($rows rows)"
