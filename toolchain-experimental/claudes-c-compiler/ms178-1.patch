+/// (it denotes "no index"), and dynamic stack-pointer destinations are excluded.
+fn parse_two_reg_leaq(line: &str) -> Option<(String, String)> {
+    let rest = line.strip_prefix("leaq ")?;
+    let (address, dest) = rest.rsplit_once(", ")?;
+    let dest = dest.trim();
+    if !dest.starts_with('%') {
+        return None;
+    }
+    let dest_family = register_family_fast(dest);
+    if dest_family == REG_NONE || dest_family > REG_GP_MAX || dest_family == 4 {
+        return None;
+    }
