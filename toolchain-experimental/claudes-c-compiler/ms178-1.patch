+    movslq 8(%rsp), %rcx\n\
+    movq %rcx, %rdx\n\
+    shldq $1, %rdx, %rax\n\
+";
+        let (changed, _) = run(asm);
+        assert!(!changed, "shld reads %cl implicitly; fuse must be refused");
