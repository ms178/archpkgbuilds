+            None
+        );
+        let got = relax_to(&mov, R_X86_64_REX_GOTPCRELX, false, abs(0x1234), 0x1234);
+        assert_eq!(got.unwrap(), with_imm(&[0x48, 0xc7, 0xc0], 0x1234));
+        assert_eq!(
+            relax_to(&call, R_X86_64_GOTPCRELX, false, abs(0x1234), 0x1234),
+            None
+        );
+    }
