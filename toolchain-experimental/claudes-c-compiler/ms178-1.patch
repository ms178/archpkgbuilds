+        // registers (notably rdi/rsi/rcx on x86) even though they are not IR
+        // Call instructions.
+        Instruction::Memcpy { .. }
+        | Instruction::VaArg { .. }
+        | Instruction::VaStart { .. }
+        | Instruction::VaCopy { .. }
+        | Instruction::VaArgStruct { .. } => true,
+
+        // Wide division/remainder and int128<->float conversions lower to
+        // compiler-rt helper calls, which obey normal caller-clobber ABI rules.
+        Instruction::BinOp { op, ty, .. }
