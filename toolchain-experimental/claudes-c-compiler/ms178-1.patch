+    if std::env::var("CCC_DEBUG_SLOT_COALESCE").is_ok() && !aliases.is_empty() {
+        let mut pairs: Vec<(u32, u32)> = aliases.iter().map(|(&a, &b)| (a, b)).collect();
+        pairs.sort_unstable();
+        eprintln!(
+            "[CFG-SLOT-COALESCE] fn={} candidates={} aliases={} pairs={:?}",
+            func.name,
+            tracked.len(),
+            pairs.len(),
+            pairs,
+        );
+    }
+    (aliases, force_aliases)
+}
