+    echo "FAIL: could not build the probe at -mavx -mavx2" >&2
+    exit 1
+fi
+ROWS_AVX="$rows"
+
+if [ -z "$ROWS_SSE" ] || [ -z "$ROWS_AVX" ]; then
+    echo "FAIL: the probe printed no rows" >&2
+    exit 1
+fi
