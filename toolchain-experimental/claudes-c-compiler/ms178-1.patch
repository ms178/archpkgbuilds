+            assert_eq!(ppnumber_end(b"0x1p-3'0f)", 0), 9);
+        });
+        with_c23(false, || {
+            assert!(!is_digit_separator(b"1'000", 1));
+            assert_eq!(ppnumber_end(b"1'000", 0), 1);
+        });
+    }
+}
