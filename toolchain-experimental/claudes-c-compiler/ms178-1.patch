+        assert!(check(R_X86_64_PC8, 128, "s", "a.o").is_err());
+        assert!(check(R_X86_64_PC8, -128, "s", "a.o").is_ok());
+        assert!(check(R_X86_64_PC8, -129, "s", "a.o").is_err());
