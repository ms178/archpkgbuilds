+    /// EVEX unary op, AT&T (src, dst) with optional mask on dst; vvvv = 1 (GAS).
+    /// Used for vpabs*, vpopcnt*, vsqrt*, vpmovzx*/vpmovsx* (src may be narrower).
+    pub(crate) fn encode_evex_unary(
