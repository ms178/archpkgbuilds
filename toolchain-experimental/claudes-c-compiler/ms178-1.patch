+"$CCC" -O2 -S "$tmp/addr.c" -o "$tmp/addr.s"
+"$CCC" -O2 "$tmp/addr.c" -o "$tmp/addr"
+"$tmp/addr" >"$tmp/addr_got.txt"
+"$tmp/ref" >/dev/null 2>&1 || true
