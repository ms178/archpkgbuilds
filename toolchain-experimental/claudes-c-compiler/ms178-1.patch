+            return None;
+        }
+        let pos = incoming.start;
+        let incoming_cost = incoming.spill_cost_at(pos);
+        if incoming_cost == 0 {
+            return None;
+        }
+        let mut best_idx: Option<usize> = None;
+        let mut best_cost = u64::MAX;
+        let mut best_next_use = 0u32;
