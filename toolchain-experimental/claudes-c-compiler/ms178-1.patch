+                | "vphaddubw"
+                | "vphaddbw"
+                | "vphaddubq"
+                | "vphaddbq"
+                | "vphaddubd"
+                | "vphaddbd"
+                | "vphadduwd"
+                | "vphaddwd"
+                | "vphadduwq"
+                | "vphaddwq"
+                | "vphaddudq"
+                | "vphadddq"
+                | "vphsubbw"
+                | "vphsubwd"
+                | "vphsubdq"
+                // XOP vfrcz* (map 9, unary 2-op, xmm+ymm).
+                | "vfrczps"
+                | "vfrczpd"
+                | "vfrczss"
+                | "vfrczsd"
