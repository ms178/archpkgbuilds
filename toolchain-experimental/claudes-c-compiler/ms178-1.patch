+            Instruction::Cast {
+                dest: Value(5),
+                src: Operand::Value(Value(3)),
+                from_ty: IrType::I32,
+                to_ty: IrType::I64,
+            },
+            Instruction::BinOp {
+                dest: Value(6),
+                op: IrBinOp::Mul,
+                lhs: Operand::Value(Value(5)),
+                rhs: Operand::Const(IrConst::I64(8)),
+                ty: IrType::I64,
+            },
+            Instruction::Intrinsic {
+                dest: Some(Value(7)),
+                op: IntrinsicOp::VecLoadF64x2,
+                dest_ptr: None,
+                args: vec![
+                    Operand::Value(Value(0)),
+                    Operand::Value(Value(6)),
+                    Operand::Const(IrConst::I64(24)),
+                ],
+            },
+            Instruction::Intrinsic {
+                dest: None,
+                op: IntrinsicOp::VecStoreF64x2,
+                dest_ptr: None,
+                args: vec![
+                    Operand::Value(Value(7)),
+                    Operand::Value(Value(0)),
+                    Operand::Value(Value(6)),
+                    Operand::Const(IrConst::I64(16)),
+                ],
+            },
+            Instruction::GetElementPtr {
+                dest: Value(8),
+                base: Value(0),
+                offset: Operand::Value(Value(6)),
+                ty: IrType::I64,
+            },
+            Instruction::Load {
+                volatile: false,
+                dest: Value(9),
+                ptr: Value(8),
+                ty: IrType::I64,
+                seg_override: AddressSpace::Default,
+            },
+            Instruction::BinOp {
+                dest: Value(10),
+                op: IrBinOp::Add,
+                lhs: Operand::Value(Value(3)),
+                rhs: Operand::Const(IrConst::I32(1)),
+                ty: IrType::I32,
+            },
+        ];
+        let mut func = loop_fixture(body, 10, 11);
