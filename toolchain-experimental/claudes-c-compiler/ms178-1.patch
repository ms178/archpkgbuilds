From da6670dd64a6602465e3057bf7c012a5a0656cfc Mon Sep 17 00:00:00 2001
From: ms178 <ms178@users.noreply.github.com>
Date: Fri, 28 Aug 2026 18:25:38 +0000
Subject: [PATCH 7/7] aarch64: gate f128 store-tracking on slot-anchored homes
 + const carriers
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Completion of the U128-carrier tracking in the aarch64 i128 store path:
(1) tracking the destination is sound only for Direct/OverAligned homes
— an Indirect/Reg destination stores THROUGH a pointer, so its own slot
does not anchor the bytes and a self-track would redirect later F128
reads at pointer bytes; (2) constants stored through a U128-typed store
(LongDouble bytes / I128 carrier bits) are full-precision by
construction — track them, mirroring the riscv fix that unblocked
const-initialized _Float128 locals from the lossy f64-extend fallback.

Validated as part of the f128 probe battery: aarch64 f128_softfloat,
f128_global_carrier and f1-f7 all GCC-oracle parity; suites unchanged
(ARM 375/32/75, x86 537/5, lib 1273/0/6).
---
 src/backend/arm/codegen/memory.rs | 28 ++++++++++++++++++++++------
 1 file changed, 22 insertions(+), 6 deletions(-)

diff --git a/src/backend/arm/codegen/memory.rs b/src/backend/arm/codegen/memory.rs
index bf1bb512..e57861c5 100644
--- a/src/backend/arm/codegen/memory.rs
+++ b/src/backend/arm/codegen/memory.rs
@@ -259,12 +259,28 @@ impl ArmCodegen {
             // holding the full 16 bytes — record it so later F128 paths can
             // read them instead of degrading to the f64-extend fallback.
             crate::backend::traits::emit_store_default(self, val, ptr, ty);
-            if let Operand::Value(v) = val {
-                if self.state.get_f128_source(v.0).is_some() {
-                    if let Some(_dest_slot) = self.state.get_slot(ptr.0) {
-                        self.state.track_f128_self(ptr.0);
-                    }
-                }
+            // Tracking is sound only when the destination slot anchors
+            // the bytes themselves (Direct alloca/value slot or an
+            // over-aligned alloca): an Indirect/Reg home stores THROUGH a
+            // pointer, so its own slot does not hold the data.
+            let slot_anchored = matches!(
+                self.state.resolve_slot_addr(ptr.0),
+                Some(SlotAddr::Direct(_) | SlotAddr::OverAligned(_, _))
+            );
+            let tracked_val = match val {
+                Operand::Value(v) => self.state.get_f128_source(v.0).is_some(),
+                // A constant stored through a U128-typed store IS the
+                // full-precision bit pattern by construction (LongDouble
+                // bytes, or the I128 carrier bits): the destination slot is
+                // a full-precision F128 source. Without this, a
+                // const-initialized local _Float128 forced every later
+                // intrinsic/argument staging into the lossy f64-extend
+                // fallback (observed: -1.5F128 negated to -0.0 on RISC-V).
+                Operand::Const(c) => matches!(c, IrConst::LongDouble(_, _) | IrConst::I128(_)),
+                _ => false,
+            };
+            if tracked_val && slot_anchored {
+                self.state.track_f128_self(ptr.0);
             }
             return;
         }
