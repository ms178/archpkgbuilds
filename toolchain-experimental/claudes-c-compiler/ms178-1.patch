+    /// Pointer value `v` in GPR `reg` (`Indirect` + register home).
+    fn ptr_in_reg(cg: &mut I686Codegen, v: u32, reg: u8) {
+        cg.state
+            .value_locations
+            .insert(v, StackSlot(-200 - 4 * v as i64));
+        cg.reg_assignments.insert(v, PhysReg(reg));
+    }
