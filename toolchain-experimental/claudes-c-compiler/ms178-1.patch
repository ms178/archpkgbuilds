+    #[test]
+    fn refuses_to_cross_an_idivq_implicit_write() {
+        // The counterexample in full: the shift scales the dividend, `idivq`
+        // replaces `%rax` with the quotient, and the add consumes the quotient.
+        let out = run(&[
+            "shlq $3, %rax",
+            "cqto",
+            "idivq %r11",
+            "addq %rax, %r9",
+            "movq %r9, %rax",
+            "ret",
+        ]);
