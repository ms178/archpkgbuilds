From 274cb3777728ff3b8bce6c7fb292d0b66c402611 Mon Sep 17 00:00:00 2001
From: lccc-v2 <v2@localhost>
Date: Thu, 13 Aug 2026 14:57:12 +0000
Subject: [PATCH 2/5] v2: add C23 alignas/alignof keyword spellings +
 regression test

gzip 1.14 (and other C23 code) builds with -std=gnu23 and uses the C23
spellings alignas/alignof as native keywords; lccc only knew _Alignas/_Alignof.
gzip's DECLARE(uch BUFFER_ALIGNED, ...) => 'uch alignas (4096) inbuf[...]'
failed to parse. Map alignas/alignof to the existing C11 token kinds.

Test-compile validation (this commit's data):
- zlib-ng 109/109 TUs, gzip 17/17 real TUs (130/140 incl. gnulib; the rest
  fail identically under gcc), expat 5/5 real TUs, glibc 2.44 with
  ms178-glibc.patch: 5/5 patched files + 13/15 core sample (2 failures are
  generated-header deps, not lccc).
---
 src/frontend/lexer/token.rs    |  4 ++--
 tests/regression/c23_alignas.c | 18 ++++++++++++++++++
 2 files changed, 20 insertions(+), 2 deletions(-)
 create mode 100644 tests/regression/c23_alignas.c

diff --git a/src/frontend/lexer/token.rs b/src/frontend/lexer/token.rs
index 4c9dd3e9..65c348ee 100644
--- a/src/frontend/lexer/token.rs
+++ b/src/frontend/lexer/token.rs
@@ -427,8 +427,8 @@ impl TokenKind {
             "__restrict" | "__restrict__" => Some(TokenKind::Restrict),
             "__signed__" => Some(TokenKind::Signed),
             "while" => Some(TokenKind::While),
-            "_Alignas" => Some(TokenKind::Alignas),
-            "_Alignof" => Some(TokenKind::Alignof),
+            "_Alignas" | "alignas" => Some(TokenKind::Alignas),
+            "_Alignof" | "alignof" => Some(TokenKind::Alignof),
             "_Atomic" => Some(TokenKind::Atomic),
             "_Bool" => Some(TokenKind::Bool),
             "_Complex" | "__complex__" | "__complex" => Some(TokenKind::Complex),
diff --git a/tests/regression/c23_alignas.c b/tests/regression/c23_alignas.c
new file mode 100644
index 00000000..472d6c0a
--- /dev/null
+++ b/tests/regression/c23_alignas.c
@@ -0,0 +1,18 @@
+/* C23 alignas/alignof keyword spellings (gzip 1.14 builds with -std=gnu23 and
+ * uses `alignas (4096)` as a declaration specifier via the DECLARE macro).
+ * LCCC previously only knew the C11 _Alignas/_Alignof spellings. */
+#include <stdio.h>
+
+#define BUFFER_ALIGNED alignas (4096)
+typedef unsigned char uch;
+#define DECLARE(type, array, size) type array[size]
+DECLARE(uch BUFFER_ALIGNED, inbuf, 16384 + 64);
+
+int main(void) {
+    if (((unsigned long)inbuf & 0xFFF) != 0) { printf("FAIL align\n"); return 1; }
+    if (alignof(int) != 4) { printf("FAIL alignof\n"); return 1; }
+    inbuf[0] = 7;
+    if (inbuf[0] != 7) { printf("FAIL store\n"); return 1; }
+    printf("OK\n");
+    return 0;
+}
-- 
