+        let asm = "f:\n    movl (%rdi), %eax\n    bswapl %eax\n    addl %eax, %ecx\n    ret\n";
+        let out = run(asm);
+        assert!(out.contains("movbel (%rdi), %eax"), "{out}");
+        assert!(!out.contains("bswap"), "{out}");
+    }
+
