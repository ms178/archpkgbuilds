+            return;
+        };
+        let mut fresh = FileLiveness {
+            live_out: self.live_out.clone(),
+            live_in: self.live_in.clone(),
+            known: self.known.clone(),
+            structural: self.structural.clone(),
+            effect: self.effect.clone(),
+            func_of: Vec::new(),
+            textual_ret: FxHashSet::default(),
