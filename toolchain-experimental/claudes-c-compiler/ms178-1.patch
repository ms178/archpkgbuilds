+            let bits = scan_register_refs_explicit(text.as_bytes());
+            for fam in 0..16u8 {
+                if bits & (1u16 << fam) != 0 {
+                    assert!(
+                        mentions_family(text.as_bytes(), fam),
+                        "bitmask sees family {fam} in {text:?} but mentions_family does not"
+                    );
+                }
+            }
+        }
+    }
