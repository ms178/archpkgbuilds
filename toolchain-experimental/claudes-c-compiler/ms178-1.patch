+    /// is homed in callee-saved %rbx and read again after the call. A call
+    /// does not end a callee-saved family's lifetime, so the relay must stay.
+    #[test]
+    fn callee_saved_tmp_read_after_call_is_live() {
+        let asm = "\
+    movslq %eax, %rbx\n\
+    movq %rbx, %rdi\n\
+    call malloc@PLT\n\
+    # LCCC_CALL_ARGS 1\n\
+    movq %rax, %rdi\n\
+    xorl %esi, %esi\n\
+    movq %rbx, %rdx\n\
+    call memset@PLT\n\
+    # LCCC_CALL_ARGS 3\n\
+";
+        let (changed, out) = run(asm);
