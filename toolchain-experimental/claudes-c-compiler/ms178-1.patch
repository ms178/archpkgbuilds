+            "body GEP must become a Copy of the pointer IV"
+        );
+        let init_ptr = match func.blocks[1].instructions.iter().find_map(|i| match i {
+            Instruction::Phi {
+                dest: _,
+                ty,
+                incoming,
+                ..
+            } if *ty == IrType::Ptr => Some(incoming.clone()),
+            _ => None,
