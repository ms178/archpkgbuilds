+#!/usr/bin/env python3
+"""GAS location-counter assignment: macro vector layout, bytes and symbols."""
+import argparse,pathlib,subprocess,tempfile
+ROOT=pathlib.Path(__file__).resolve().parents[2]
+ap=argparse.ArgumentParser(); ap.add_argument('--lccc',type=pathlib.Path,default=ROOT/'target/fastbuild/lccc'); ap.add_argument('--as',dest='gas',default='as'); a=ap.parse_args()
+SRC=r'''
+.set WIDTH, 6
+.text
+.globl base
+base:
+.macro vec n
+. = base + (\n * WIDTH)
+nop
+nop
+pushq $\n
+jmp target
+.endm
+vec 0
+vec 1
+vec 2
+target:
+ret
+.globl end
+end:
+.data
+.globl data_base
+data_base:
+. = data_base + (3 * 4)
+.byte 7
+'''
+NEG=['.text\n. = 8\n. = 4\nret\n','.text\n. = unknown * 2\nret\n','.text\n. = (1 + 2\nret\n']
+def run(cmd):
+ r=subprocess.run([str(x) for x in cmd],capture_output=True,text=True); assert r.returncode==0,(cmd,r.stderr); return r
+with tempfile.TemporaryDirectory(prefix='lccc-dot-') as td:
+ t=pathlib.Path(td); src=t/'v.S'
+ for bits in (64,32):
+  src.write_text(SRC if bits==64 else SRC.replace('pushq','pushl'))
+  objects=[]
+  for name,cc in [('lccc',a.lccc),('gas',a.gas)]:
+   obj=t/f'{name}{bits}.o'; objects.append(obj); run([cc,f'-m{bits}','-c',src,'-o',obj] if name=='lccc' else [cc,f'--{bits}','-o',obj,src])
+  def loaded(obj):
+   out=obj.with_suffix('.bin'); run(['objcopy','--only-section=.text','-O','binary',obj,out]); return out.read_bytes()
+  assert loaded(objects[0])==loaded(objects[1]),'loaded bytes differ'
+  assert loaded(objects[0])[:18]==bytes.fromhex('90906a00eb0c 90906a01eb06 90906a02eb00')
+  syms=[]
+  for obj in objects:
+   lines=run(['nm','-n',obj]).stdout.splitlines(); syms.append({x.split()[-1]:int(x.split()[0],16) for x in lines if x.split()[-1] in ('base','end','data_base')})
+  assert syms[0]==syms[1] and syms[0]['end']-syms[0]['base']==19,syms
+  print(f'PASS ELF{bits}: macro vector offsets, fill, symbols, GAS bytes')
+ # Numeric local labels are valid .org/location-counter targets (Linux perf).
+ local_src = '.text\n2:\nnop\n. = 2b + 8\nnop\n'
+ src.write_text(local_src)
+ local_objs=[]
+ for name,cc in [('lccc',a.lccc),('gas',a.gas)]:
+  obj=t/f'local-{name}.o'; local_objs.append(obj)
+  run([cc,'-c',src,'-o',obj] if name=='lccc' else [cc,'--64','-o',obj,src])
+ assert loaded(local_objs[0])==loaded(local_objs[1])
+ print('PASS numeric local label: 2b + constant matches GAS')
+ for i,text in enumerate(NEG):
+  src.write_text(text); r=subprocess.run([str(a.lccc),'-c',src,'-o',t/'neg.o'],capture_output=True,text=True); assert r.returncode!=0,(i,r.stderr)
+ print('PASS negative controls: backward, unsupported product, unbalanced expression')
