+        replace_line(store, &mut infos[i], i, format!("    movdqu {}, {}", xmm, dst));
+        if store_idx != i {
+            mark_nop(&mut infos[store_idx]);
+        }
+        for &idx in &indexes {
+            mark_nop(&mut infos[idx]);
+        }
+        changed = true;
+        i = indexes[3] + 1;
+    }
+    changed
+}
