+            continue;
+        };
+        if !(20..=33).contains(&reg.0) {
+            continue;
+        }
+        let def = iv_map.get(&seg.value_id).map_or(seg.start, |&(s, _)| s);
+        for cp in segment_spanned_calls(seg, def, &liveness.call_points) {
+            let k = liveness
+                .cold_call_points
+                .binary_search(&cp)
+                .expect("XMM home live across a non-cold call");
