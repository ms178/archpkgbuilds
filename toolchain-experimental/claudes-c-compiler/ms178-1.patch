+    for q in qemu-i386 qemu-i386-static; do
+        command -v "$q" >/dev/null 2>&1 || continue
+        if out=$("$q" "$td/tls_exe" 2>/dev/null) && [ "$out" = "$want_out" ]; then
+            elf32_runner=$q
