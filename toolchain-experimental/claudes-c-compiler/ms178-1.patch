+    /// Runs the pass; returns how many `movl %R, %R` lines survive.
+    fn survivors(asm: &str, self_zext: &str) -> usize {
+        let store = LineStore::new(asm.to_string());
+        let mut infos: Vec<_> = (0..store.len())
+            .map(|i| classify_line(store.get(i)))
