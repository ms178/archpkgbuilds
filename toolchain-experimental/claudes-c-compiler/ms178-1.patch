+// ── XMM spill -> rep movsb relay folding ───────────────────────────────────
+//
+// Vector intrinsics are represented as stack-backed 128-bit temporaries.  The
+// generic aggregate lowering often emits an avoidable relay:
+//
+//   movdqu %xmmN, SCRATCH(%rsp)
+//   leaq DEST(%rsp), %rdi
+//   leaq SCRATCH(%rsp), %rsi
+//   movq $16, %rcx
+//   rep movsb
+//
+// The XMM value is already available, so write it directly to DEST.  This is
+// especially valuable in gzip's PCLMUL CRC loop.  We require an exact local
+// shape and prove that the scratch address/register effects are dead afterwards;
+// any barrier, register read, or later scratch access rejects the fold.
+
+fn parse_xmm_store_to_stack(line: &str) -> Option<(String, String)> {
+    let rest = line.strip_prefix("movdqu ")?;
+    let (src, dst) = rest.split_once(", ")?;
+    let src = src.trim();
+    let dst = dst.trim();
+    if !src.starts_with("%xmm")
+        || !(dst.ends_with("(%rsp)") || dst.ends_with("(%rbp)"))
+        || dst.contains(',')
+    {
+        return None;
+    }
+    Some((src.to_string(), dst.to_string()))
+}
+
+fn parse_leaq_to_stack_reg(line: &str, reg: &str) -> Option<String> {
+    let suffix = format!(", %{}", reg);
+    let addr = line.strip_prefix("leaq ")?.strip_suffix(&suffix)?.trim();
+    if !(addr.ends_with("(%rsp)") || addr.ends_with("(%rbp)")) || addr.contains(',') {
+        return None;
+    }
+    Some(addr.to_string())
+}
+
+fn parse_xmm_store_via_rax(line: &str) -> Option<String> {
+    let rest = line.strip_prefix("movdqu ")?;
+    let (src, dst) = rest.split_once(", ")?;
+    if !src.trim().starts_with("%xmm") || dst.trim() != "(%rax)" {
+        return None;
+    }
+    Some(src.trim().to_string())
+}
+
