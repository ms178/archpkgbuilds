+#define X3(b, ...) {b, ## __VA_ARGS__}
+3: X3(foo)
+
+
+
+// PR3880
+// CHECK: 4: AA BB
+#define X4(...)  AA , ## __VA_ARGS__ BB
+4: X4()
+
+// PR7943
+// CHECK: 5: 1
+#define X5(x,...) x##,##__VA_ARGS__
+5: X5(1)
