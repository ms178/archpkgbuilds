+/// (`output_section == usize::MAX` is this backend's "no section" marker);
+/// the undefined-symbol check and the PLT/GOT need scan both see them.
+fn apply_defsyms(
+    global_symbols: &mut FxHashMap<String, LinkerSymbol>,
+    defs: &[(String, String)],
