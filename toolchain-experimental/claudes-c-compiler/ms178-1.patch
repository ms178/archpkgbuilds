+        fi
+    done
+fi
+if [ -z "$elf32_runner" ] && ! out=$("$td/tls_exe" 2>/dev/null); then
+    echo "SKIP: no working ELF32 execution path (native i386 blocked and no"
+    echo "      runner produced the expected output; set LCCC_I686_RUNNER)"
