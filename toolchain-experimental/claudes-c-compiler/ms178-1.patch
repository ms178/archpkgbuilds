+            _ => false,
+        };
+        if dep_newer {
+            let text = if message.is_empty() {
+                format!("\"{}\" is newer than the current file", filename)
+            } else {
+                format!(
+                    "\"{}\" is newer than the current file: {}",
+                    filename, message
+                )
+            };
+            self.warnings.push(super::pipeline::PreprocessorDiagnostic {
+                file: self.current_file(),
+                line: line_num,
+                col,
+                message: text,
+            });
+        }
+    }
