+            out.contains("shlq $3, %rax"),
+            "shift deleted across cqto/idivq: {out}"
+        );
+        assert!(out.contains("idivq %r11"), "{out}");
+        assert!(!flat(&out).contains("leaq (%r9,%rax,8)"), "{out}");
+    }
