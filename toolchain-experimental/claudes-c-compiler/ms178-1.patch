diff --git a/tests/regression/puts_definition_no_selfcall.c b/tests/regression/puts_definition_no_selfcall.c
new file mode 100644
index 00000000..93f8ed92
--- /dev/null
+++ b/tests/regression/puts_definition_no_selfcall.c
@@ -0,0 +1,21 @@
+/* A TU-defined `puts`: the `fortify_fold` printf->puts rewrite must not turn
+ * the `printf` call inside this definition into `call puts@PLT`.  Before A13
+ * that is exactly what happened, and the program recursed until SIGSEGV.
+ *
+ * LCCC-only by construction: every reference compiler measured on the pinned
+ * oracles emits the same self-recursive call (GCC 14.2 crashes at -O2, GCC
+ * 16.2 / Clang 23.1 / ICX 2025 emit `call puts@PLT` inside `puts`), so no
+ * correct oracle exists to compare against.  The lccc self-check still has
+ * to pass: it must print `hello` once and exit 0.
+ */
+#include <stdio.h>
+
+int puts(const char *s) {
+    printf("hello\n");
+    return s != 0 ? 0 : -1;
+}
+
+int main(void) {
+    puts("x");
+    return 0;
+}
diff --git a/tests/regression/puts_definition_no_selfcall.env b/tests/regression/puts_definition_no_selfcall.env
new file mode 100644
index 00000000..28a09133
--- /dev/null
+++ b/tests/regression/puts_definition_no_selfcall.env
@@ -0,0 +1,5 @@
+# lccc-only: no correct oracle exists.  GCC 14.2 SIGSEGVs on this fixture at
+# -O2; GCC 16.2, Clang 23.1 and ICX 2025 (pinned Godbolt oracles) all emit the
+# same self-recursive `call puts@PLT` inside `puts`.  lccc's A13 gate refuses
+# the fold, which is the C-correct behaviour.
+LCCC_NO_COMPARE=1
