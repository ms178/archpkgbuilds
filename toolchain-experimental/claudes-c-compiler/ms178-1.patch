diff --git a/tests/regression/check_shift_count_demand.py b/tests/regression/check_shift_count_demand.py
new file mode 100755
index 000000000..d30be8ecd
--- /dev/null
+++ b/tests/regression/check_shift_count_demand.py
@@ -0,0 +1,142 @@
+#!/usr/bin/env python3
+"""Masks that only feed x86-64 shift counts must not be materialized.
+
+`tests/regression/shift_count_demand.c` holds shift counts masked in C
+(zstd's `BIT_lookBits` shape and variants). x86 shifts mask the count in
+hardware (6 bits for 64-bit forms, 5 bits for 32-bit forms), so the five
+`drop` functions must contain no `and` on a count, while the three `keep`
+functions must keep theirs: a 64-bit shift reads bit 5 that `& 31` clears,
+and a stored or added masked count is observable. `look_bits` and
+`high_bits` must also lose the constant subtract (`~nb` / `-n`).
+
+Negative control: `CCC_NO_SHIFT_COUNT_DEMAND=1` must bring the masks back
+(the detector sees the defect and the switch reaches the pass). Program
+output must equal GCC's with and without the rewrite.
+"""
+import argparse
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+SOURCE = ROOT / 'tests/regression/shift_count_demand.c'
+SWITCH = 'CCC_NO_SHIFT_COUNT_DEMAND'
+DROP = ('look_bits', 'high_bits', 'sar_wide_mask', 'shl32', 'non_congruent')
+KEEP = ('keep_narrow_mask', 'keep_escaping', 'keep_arith')
+NO_SUBTRACT = ('look_bits', 'high_bits')
+MASK = re.compile(r'^\s*and[lq]\s+\$(?:31|63|127),\s*%\w+\s*$')
+# A constant subtract materialized for the count: `movl $63, r` / `$64`.
+SUB_CONST = re.compile(r'^\s*mov[lq]\s+\$(?:63|64),\s*%\w+\s*$')
+
+
+def bodies(asm):
+    """Map function name -> instruction lines (labels and directives removed)."""
+    out, current = {}, None
+    for line in asm.splitlines():
+        label = re.fullmatch(r'([A-Za-z_]\w*):', line.strip())
+        if label and not line.startswith(('\t', ' ')) and not label.group(1).startswith('.'):
+            current = label.group(1)
+            out[current] = []
+            continue
+        if current is None:
+            continue
+        text = line.strip()
+        if text.startswith('.size') or text.startswith('.cfi_endproc'):
+            current = None
+            continue
+        if text and not text.startswith(('.', '#')) and not text.endswith(':'):
+            out[current].append(text)
+    return out
+
+
+def masks(body):
+    return [line for line in body if MASK.match(line)]
+
+
+def sub_consts(body):
+    return [line for line in body if SUB_CONST.match(line)]
+
+
+def selftest():
+    asm = ('look_bits:\n\t.cfi_startproc\n\tandl $63, %esi\n\tmovl $63, %eax\n\tret\n'
+           '\t.cfi_endproc\n\t.size look_bits, .-look_bits\n'
+           'high_bits:\n.LBB1:\n\tnegl %esi\n\tshrxq %rsi, %rdi, %rax\n\tret\n\t.size high_bits, .-high_bits\n')
+    parsed = bodies(asm)
+    assert masks(parsed['look_bits']) == ['andl $63, %esi']
+    assert sub_consts(parsed['look_bits']) == ['movl $63, %eax']
+    assert not masks(parsed['high_bits']) and not sub_consts(parsed['high_bits'])
+    assert not MASK.match('andl $63, (%rdi)') and not MASK.match('andq $-64, %rsp')
+
+
+def switched(disabled):
+    env = {k: v for k, v in os.environ.items() if k != SWITCH}
+    if disabled:
+        env[SWITCH] = '1'
+    return env
+
+
+def run(cmd, env=None):
+    result = subprocess.run(cmd, capture_output=True, text=True, env=env)
+    if result.returncode:
+        sys.exit(f'command failed: {" ".join(map(str, cmd))}\n{result.stderr}')
+    return result.stdout
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--lccc', default=os.environ.get('CCC', str(ROOT / 'target/fastbuild/lccc')))
+    parser.add_argument('--gcc', default=os.environ.get('GCC', 'gcc'))
+    args = parser.parse_args()
+    selftest()
+    failures = []
+    with tempfile.TemporaryDirectory() as work:
+        work = Path(work)
+        compiled = {}
+        for disabled in (False, True):
+            asm = work / f'shift-{int(disabled)}.s'
+            run([args.lccc, '-O2', '-march=x86-64-v3', '-S', SOURCE, '-o', asm], env=switched(disabled))
+            compiled[disabled] = bodies(asm.read_text())
+        on, off = compiled[False], compiled[True]
+        for name in DROP + KEEP:
+            if name not in on or name not in off:
+                sys.exit(f'FAIL: function {name} missing from the assembly')
+        for name in DROP:
+            if masks(on[name]):
+                failures.append(f'{name}: redundant count mask {masks(on[name])}')
+            if not masks(off[name]):
+                failures.append(f'{name}: negative control ({SWITCH}=1) shows no mask, '
+                                'so the fixture no longer exercises the rewrite')
+        for name in NO_SUBTRACT:
+            if sub_consts(on[name]):
+                failures.append(f'{name}: constant subtract kept {sub_consts(on[name])}')
+            if not sub_consts(off[name]):
+                failures.append(f'{name}: negative control shows no constant subtract')
+        for name in KEEP:
+            if not masks(on[name]):
+                failures.append(f'{name}: observable mask was removed')
+        run([args.gcc, '-O2', SOURCE, '-o', work / 'gcc'])
+        reference = run([work / 'gcc'])
+        for disabled in (False, True):
+            exe = work / f'lccc-{int(disabled)}'
+            run([args.lccc, '-O2', '-march=x86-64-v3', SOURCE, '-o', exe], env=switched(disabled))
+            mine = run([exe])
+            if mine != reference:
+                failures.append(f'output ({SWITCH}={int(disabled)}) {mine!r} != GCC {reference!r}')
+        # Baseline ISA too: legacy `shl %cl` lowering instead of BMI2 shlx.
+        exe = work / 'lccc-x86-64'
+        run([args.lccc, '-O2', '-march=x86-64', SOURCE, '-o', exe], env=switched(False))
+        mine = run([exe])
+        if mine != reference:
+            failures.append(f'output (-march=x86-64) {mine!r} != GCC {reference!r}')
+    if failures:
+        sys.exit('FAIL:\n  ' + '\n  '.join(failures))
+    print(f'check_shift_count_demand: PASS ({len(DROP)} masks dropped, {len(KEEP)} kept, '
+          'negative control fires, GCC output matches with and without the rewrite and on '
+          'baseline x86-64)')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tests/regression/check_static_assert_sema.sh b/tests/regression/check_static_assert_sema.sh
new file mode 100755
index 000000000..dce1b2b0d
--- /dev/null
+++ b/tests/regression/check_static_assert_sema.sh
@@ -0,0 +1,54 @@
+#!/usr/bin/env bash
+# _Static_assert with type-dependent conditions: the positive fixture must
+# compile, and every false assertion below must be rejected. These used to
+# pass silently because the parser accepted any condition it could not
+# evaluate without types. Each negative case is its own throwaway TU (the
+# regression corpus compiles every checked-in C file as a positive case) and
+# is checked against the host C compiler too, so a wrong expectation fails.
+set -euo pipefail
+
+root=$(cd -- "$(dirname -- "$0")/../.." && pwd)
+CCC=${CCC:-"$root/target/fastbuild/lccc"}
+CC=${CC:-gcc}
+[[ -x "$CCC" ]] || { echo "missing LCCC compiler: $CCC" >&2; exit 1; }
+command -v "$CC" >/dev/null 2>&1 || { echo "missing C oracle: $CC" >&2; exit 1; }
+work=$(mktemp -d)
+trap 'rm -rf "$work"' EXIT
+
+for opt in -O0 -O2; do
+    "$CC" -std=gnu17 "$opt" -c "$root/tests/regression/static_assert_sema.c" -o "$work/oracle.o"
+    "$CCC" "$opt" -c "$root/tests/regression/static_assert_sema.c" -o "$work/lccc.o"
+done
+
+prelude='#include <stddef.h>
+#define TY(x) _Generic((x), int: 1, unsigned: 2, default: 0)
+enum Small { SA };
+struct S { int a; char b; };'
+negatives=(
+    '_Static_assert(TY(SA) == 2, "generic");'
+    '_Static_assert(sizeof(SA) == 8, "enumerator sizeof");'
+    '_Static_assert(offsetof(struct S, b) == 2, "offsetof");'
+    '_Static_assert(sizeof(struct S) == 99);'
+    'void f(void) { enum { L = 0x80000000u }; _Static_assert(TY(L) == 1, "block"); }'
+    'void f(void) { { enum Small { SV = -5 }; } _Static_assert(TY(SA) == 1 && sizeof(enum Small) == 8, "scope"); }'
+    'struct M { int x; _Static_assert(sizeof(struct S) == 3, "member"); };'
+    'void f(void) { struct N { _Static_assert(_Alignof(struct S) == 1, "nested member"); int y; } n; (void)n; }'
+)
+for i in "${!negatives[@]}"; do
+    src="$work/neg$i.c"
+    printf '%s\n%s\n' "$prelude" "${negatives[$i]}" >"$src"
+    if "$CC" -std=gnu17 -c "$src" -o "$work/neg.o" 2>/dev/null; then
+        echo "oracle $CC accepted negative case $i: ${negatives[$i]}" >&2
+        exit 1
+    fi
+    if "$CCC" -c "$src" -o "$work/neg.o" >"$work/neg$i.err" 2>&1; then
+        echo "FAIL: lccc accepted a false static assertion: ${negatives[$i]}" >&2
+        exit 1
+    fi
+    grep -q 'static assertion failed' "$work/neg$i.err" || {
+        echo "FAIL: case $i rejected without the static-assertion diagnostic" >&2
+        cat "$work/neg$i.err" >&2
+        exit 1
+    }
+done
+echo "static assert sema: PASS (positive fixture at -O0/-O2, ${#negatives[@]} false assertions rejected)"
diff --git a/tests/regression/check_subscript_diagnostics.py b/tests/regression/check_subscript_diagnostics.py
new file mode 100644
index 000000000..2d1c8f81c
--- /dev/null
+++ b/tests/regression/check_subscript_diagnostics.py
@@ -0,0 +1,153 @@
+#!/usr/bin/env python3
+"""C11 6.5.2.1p1 subscript constraint: diagnose, never miscompile.
+
+One operand of `E1[E2]` must have pointer type (an array decays; GNU vectors
+are subscriptable) and the other integer type.  LCCC accepted every violation
+and lowered it as a pointer access: subscripting a struct loaded a pointer
+from the struct's first bytes, converted the stored value to an integer and
+stored through it, so
+
+    __m256 v = _mm256_loadu_ps(p); v[0] = s;
+
+(LCCC's `__m256` is a struct; GCC's is a vector) crashed at run time with no
+diagnostic.
+
+Gates:
+  * each rejected input produces a `file:line:col: error:` diagnostic naming
+    the violated rule (no panic/ICE), and GCC rejects the same input
+    (oracle-checked verdict), except the struct-based `__m256` case, which
+    GCC accepts as a vector subscript; LCCC must reject it rather than
+    miscompile it (a documented gap, not an oracle match);
+  * the valid forms (array, pointer, reversed `i[a]`, character, enum, bool
+    and `_Bool`-typed indices, string literals, GNU vectors read and written,
+    pointer-to-array, function-pointer table, compound literal) compile and
+    print GCC's output -- a gate that only asserted rejections would pass
+    with subscripting deleted;
+  * vector-valued operands whose inferred type is the scalar element
+    (vector comparison, negation and arithmetic results, casts to an
+    attribute-spelled vector type, `__typeof__` of a comparison, statement
+    expressions, conditionals) are NOT diagnosed: the first version of this
+    check rejected the replayed reproducer
+    `artifacts/repros/crash_gen_slot_stress_seed20260930_-O2.c` that way;
+  * vector types survive `__typeof__` and `__auto_type`: a comparison of
+    vectors is a vector of signed lanes (16 bytes here, `int` lanes for
+    `float`), and `__typeof__(v)` / `__auto_type u = v - w` declare vectors.
+    lccc used to type all three as scalars (sizeof 4 or 8), so `m[1]`
+    segfaulted at run time.
+"""
+import argparse
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+NOT_INTEGER = 'array subscript is not an integer'
+NOT_ADDRESSABLE = 'subscripted value is neither array nor pointer nor vector'
+
+REJECTED = {
+    'struct_base.c': ('struct S { float a[8]; };\n'
+                      'float f(struct S s) { s[0] = 2.0f; return s[1]; }\n', NOT_ADDRESSABLE),
+    'struct_reversed.c': ('struct S { int a; };\n'
+                          'int f(struct S s) { return 0[s]; }\n', NOT_ADDRESSABLE),
+    'int_base.c': ('int f(int x) { return x[0]; }\n', NOT_ADDRESSABLE),
+    'double_index.c': ('int f(int *p) { return p[1.0]; }\n', NOT_INTEGER),
+    'pointer_index.c': ('int f(int *p, int *q) { return p[q]; }\n', NOT_INTEGER),
+    'struct_index.c': ('struct S { int a; };\n'
+                       'int f(int *p, struct S s) { return p[s]; }\n', NOT_INTEGER),
+    'reversed_float_base.c': ('int f(int *p, float x) { return x[p]; }\n', NOT_INTEGER),
+}
+GCC_ACCEPTS = {
+    'm256_struct.c': ('#include <immintrin.h>\n'
+                      '__m256 f(const float *p, float s) {\n'
+                      '  __m256 v = _mm256_loadu_ps(p);\n'
+                      '  v[0] = s;\n'
+                      '  return v;\n'
+                      '}\n', NOT_ADDRESSABLE),
+}
+
+VALID = r'''
+#include <stdio.h>
+typedef int v4si __attribute__((vector_size(16)));
+typedef unsigned long long v2u __attribute__((vector_size(16)));
+enum E { ZERO, ONE, TWO };
+static int add1(int x) { return x + 1; }
+static int dbl(int x) { return x * 2; }
+int main(void) {
+  int a[4] = {10, 20, 30, 40}, *p = a + 1;
+  int (*pa)[4] = &a;
+  int (*fns[2])(int) = {add1, dbl};
+  char c = 2;
+  enum E e = TWO;
+  _Bool b = 1;
+  unsigned long long ul = 3;
+  v4si v = {1, 2, 3, 4};
+  v[2] = 7;
+  v[b] += a[e];
+  printf("%d %d %d %d %d %d %d\n", a[1], 2[a], p[-1], p[c], (*pa)[3], fns[1](a[b]), a[ul]);
+  printf("%c %c %d %d %d %d\n", "lccc"[1], 2["abc"], v[0], v[1], v[2], v[3]);
+  printf("%d\n", ((int[]){5, 6, 7})[ONE] + fns[0](0[p]));
+  v2u x = {3, 5}, y = {7, 11};
+  __typeof__(x == y) m = x == x;
+  unsigned long long __attribute__((vector_size(16))) z = x * y;
+  printf("%llu %llu %lld %lld %llu %llu\n",
+         ((unsigned long long __attribute__((vector_size(16))))x)[1], (x + y)[0],
+         (long long)(x == x)[0], (long long)m[1], (-x)[1] + z[0], (b ? x : y)[1] + ({ y; })[0]);
+  __typeof__(x) t = y;
+  __auto_type u = x - y;
+  float __attribute__((vector_size(16))) f = {1, 2, 0.5f, -3};
+  __typeof__(f < 1) fm = f < 1;
+  printf("%zu %zu %zu %zu %zu %llu %llu %d %d\n", sizeof m, sizeof(__typeof__(x < y)), sizeof t,
+         sizeof u, sizeof fm, t[1], u[1], fm[1], fm[3]);
+  return 0;
+}
+'''
+
+
+def run(cmd, check=True):
+    result = subprocess.run(cmd, capture_output=True, text=True)
+    if check and result.returncode:
+        sys.exit(f'FAIL: command failed: {" ".join(map(str, cmd))}\n{result.stderr}')
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--lccc', default=os.environ.get('CCC', str(ROOT / 'target/fastbuild/lccc')))
+    parser.add_argument('--gcc', default=os.environ.get('GCC', 'gcc'))
+    args = parser.parse_args()
+    with tempfile.TemporaryDirectory() as work:
+        work = Path(work)
+        for name, (source, message) in {**REJECTED, **GCC_ACCEPTS}.items():
+            path = work / name
+            path.write_text(source)
+            mine = run([args.lccc, '-O2', '-mavx', '-S', path, '-o', work / 'out.s'], check=False)
+            if mine.returncode == 0:
+                sys.exit(f'FAIL: {name} was accepted; it must be diagnosed')
+            if re.search(r'panicked at|internal compiler error|RUST_BACKTRACE', mine.stderr):
+                sys.exit(f'FAIL: {name} ICEd instead of diagnosing:\n{mine.stderr}')
+            if not re.search(rf'{re.escape(name)}:\d+:\d+: error: {re.escape(message)}', mine.stderr):
+                sys.exit(f'FAIL: {name}: expected "{message}", got:\n{mine.stderr}')
+            gcc = run([args.gcc, '-O2', '-mavx', '-S', path, '-o', work / 'gcc.s'], check=False)
+            expect_gcc_reject = name in REJECTED
+            if (gcc.returncode != 0) != expect_gcc_reject:
+                verdict = 'accepts' if gcc.returncode == 0 else 'rejects'
+                sys.exit(f'FAIL: oracle drift: GCC now {verdict} {name}')
+        valid = work / 'valid.c'
+        valid.write_text(VALID)
+        run([args.gcc, '-O2', valid, '-o', work / 'gcc'])
+        reference = run([work / 'gcc']).stdout
+        for opt in ('-O0', '-O2'):
+            exe = work / f'lccc{opt}'
+            run([args.lccc, opt, valid, '-o', exe])
+            mine = run([exe]).stdout
+            if mine != reference:
+                sys.exit(f'FAIL: valid subscripts at {opt}: {mine!r} != GCC {reference!r}')
+    print(f'check_subscript_diagnostics: PASS ({len(REJECTED) + len(GCC_ACCEPTS)} invalid subscripts '
+          'diagnosed (GCC agrees except the struct-based __m256); valid forms match GCC at -O0/-O2)')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tests/regression/check_sysv_aggregate_abi.py b/tests/regression/check_sysv_aggregate_abi.py
new file mode 100755
index 000000000..4d07ca2b5
--- /dev/null
+++ b/tests/regression/check_sysv_aggregate_abi.py
@@ -0,0 +1,427 @@
+#!/usr/bin/env python3
+"""SysV AMD64 by-value aggregate ABI interop gate (structs, unions, vectors).
+
+Generates a deterministic corpus of aggregate shapes -- curated psABI corner
+cases plus seeded random compositions -- and checks every shape across the
+call boundary in all three directions:
+
+    oracle callee  <- lccc caller
+    lccc callee    <- oracle caller
+    lccc callee    <- lccc caller      (self-consistency control)
+
+Per shape the provider TU exports five functions that together exercise
+argument classification, register exhaustion/rollback, the return
+convention, and va_arg:
+
+    S    get_K(int a)                                    -> make(a)
+    S    ret_K(int a, S x, int b)                        -> transform(x, a+b)
+    long sum_K(int a, S x, double d, S y, long long z)   -> weighted hash
+    long many_K(S, S, S, S, S, S, S, S, int tail)        -> weighted hash
+    long va_K(int n, ...)   (S, double, S, int)          -> weighted hash
+
+Expected values are computed by the caller from `static inline` helpers in a
+shared header, so both sides agree on the arithmetic and only the calling
+convention is under test. Each scalar leaf receives a distinct small integer
+value (exact in every floating format), so an eightbyte delivered in the
+wrong register, swapped, or truncated changes the result.
+
+Each case runs in its own process: a crash in one shape cannot mask the rest.
+Exit status is 0 only if every case passes on every leg.
+"""
+
+import argparse
+import os
+import random
+import shutil
+import subprocess
+import sys
+import tempfile
+
+# (C spelling, kind, size) -- kind drives value generation and hashing.
+LEAVES = [
+    ("char", "int", 1),
+    ("unsigned char", "int", 1),
+    ("short", "int", 2),
+    ("int", "int", 4),
+    ("long long", "int", 8),
+    ("_Bool", "bool", 1),
+    ("void *", "ptr", 8),
+    ("float", "fp", 4),
+    ("double", "fp", 8),
+    ("long double", "fp", 16),
+    ("_Complex float", "cplx", 8),
+    ("_Complex double", "cplx", 16),
+    ("__int128", "int", 16),
+    ("_Float128", "fp", 16),
+    ("v4c", "vec", 4),
+    ("v8c", "vec", 8),
+    ("v2s", "vec", 4),
+    ("v4s", "vec", 8),
+    ("v2i", "vec", 8),
+    ("v1ll", "vec", 8),
+    ("v2f", "vec", 8),
+    ("v1f", "vec", 4),
+    ("v1d", "vec", 8),
+    ("v4i", "vec", 16),
+    ("v4f", "vec", 16),
+    ("v2d", "vec", 16),
+]
+VEC_TYPEDEFS = """\
+typedef char v4c __attribute__((vector_size(4)));
+typedef char v8c __attribute__((vector_size(8)));
+typedef short v2s __attribute__((vector_size(4)));
+typedef short v4s __attribute__((vector_size(8)));
+typedef int v2i __attribute__((vector_size(8)));
+typedef long long v1ll __attribute__((vector_size(8)));
+typedef float v2f __attribute__((vector_size(8)));
+typedef float v1f __attribute__((vector_size(4)));
+typedef double v1d __attribute__((vector_size(8)));
+typedef int v4i __attribute__((vector_size(16)));
+typedef float v4f __attribute__((vector_size(16)));
+typedef double v2d __attribute__((vector_size(16)));
+"""
+VEC_LANES = {"v4c": 4, "v8c": 8, "v2s": 2, "v4s": 4, "v2i": 2, "v1ll": 1, "v2f": 2,
+             "v1f": 1, "v1d": 1, "v4i": 4, "v4f": 4, "v2d": 2}
+LEAF_BY_NAME = {name: (name, kind, size) for name, kind, size in LEAVES}
+
+
+class Shape:
+    """A struct/union type: list of members, each (decl_text, leaf_paths)."""
+
+    def __init__(self, tag, is_union, packed, members):
+        self.tag = tag
+        self.is_union = is_union
+        self.packed = packed
+        self.members = members  # list of (decl, [(path, kind, ctype)])
+
+
+def leaf_paths(prefix, ctype, kind):
+    """Scalar access paths for one leaf: (lvalue template, kind, C type).
+
+    Templates use `@` for the base object (`@.m0[1]`, `__real__ @.m2`), so a
+    nested member's paths compose by substituting `@` -> `@.name`.
+    """
+    prefix = "@" + prefix
+    if kind == "vec":
+        return [(f"{prefix}[{i}]", "veclane", ctype) for i in range(VEC_LANES[ctype])]
+    if kind == "cplx":
+        return [(f"__real__ {prefix}", "fp", ctype), (f"__imag__ {prefix}", "fp", ctype)]
+    return [(prefix, kind, ctype)]
+
+
+class Gen:
+    def __init__(self, rng):
+        self.rng = rng
+        self.defs = []  # nested struct definitions, emitted before users
+        self.counter = 0
+
+    def fresh(self, stem):
+        self.counter += 1
+        return f"{stem}{self.counter}"
+
+    def leaf(self):
+        return self.rng.choice(LEAVES)
+
+    def shape(self, depth=0, force=None):
+        rng = self.rng
+        is_union = rng.random() < 0.12
+        packed = rng.random() < 0.22
+        tag = self.fresh("U" if is_union else "S")
+        members = []
+        for i in range(rng.randint(1, 4)):
+            name = f"m{i}"
+            r = rng.random()
+            if r < 0.66:
+                ct, kind, _ = self.leaf()
+                members.append((f"{ct} {name};", leaf_paths(f".{name}", ct, kind)))
+            elif r < 0.78:
+                ct, kind, _ = self.leaf()
+                n = rng.randint(1, 3)
+                paths = []
+                for j in range(n):
+                    paths += leaf_paths(f".{name}[{j}]", ct, kind)
+                members.append((f"{ct} {name}[{n}];", paths))
+            elif r < 0.88 and depth < 2:
+                inner = self.shape(depth + 1)
+                self.defs.append(inner)
+                paths = []
+                for _, ps in inner.members:
+                    paths += [(p.replace("@", f"@.{name}"), k, c) for p, k, c in ps]
+                if inner.is_union:
+                    paths = paths[:1]
+                members.append((f"{'union' if inner.is_union else 'struct'} {inner.tag} {name};", paths))
+            else:
+                bt = rng.choice(["unsigned int", "unsigned char", "unsigned long long", "unsigned short"])
+                maxw = {"unsigned int": 32, "unsigned char": 8, "unsigned long long": 64, "unsigned short": 16}[bt]
+                w = rng.randint(1, maxw)
+                members.append((f"{bt} {name} : {w};", [(f"@.{name}", f"bf{w}", bt)]))
+        if is_union:
+            # Only the first member's leaves are read back (one active member).
+            members = [(d, ps if i == 0 else []) for i, (d, ps) in enumerate(members)]
+        return Shape(tag, is_union, packed, members)
+
+
+def curated():
+    """Shapes the psABI classifies non-trivially; each names its rule."""
+    out = []
+
+    def mk(tag, decls, packed=False, is_union=False):
+        members = []
+        for d in decls:
+            ct, name = d.rsplit(" ", 1)
+            name = name.rstrip(";")
+            n = None
+            if "[" in name:
+                name, n = name[:-1].split("[")
+                n = int(n)
+            kind = LEAF_BY_NAME[ct][1]
+            if n is None:
+                paths = leaf_paths(f".{name}", ct, kind)
+            else:
+                paths = []
+                for j in range(n):
+                    paths += leaf_paths(f".{name}[{j}]", ct, kind)
+            members.append((d, paths))
+        if is_union:
+            members = [(d, ps if i == 0 else []) for i, (d, ps) in enumerate(members)]
+        out.append(Shape(tag, is_union, packed, members))
+
+    mk("C_p5", ["char c;", "int i;"], packed=True)                 # misaligned int -> MEMORY
+    mk("C_p3", ["char c;", "short s;"], packed=True)               # misaligned short -> MEMORY
+    mk("C_pal", ["int a;", "int b;"], packed=True)                 # packed but aligned -> INTEGER
+    mk("C_p12", ["char c;", "long long l;", "int k;"], packed=True)
+    mk("C_ld", ["long double x;"])                                 # X87,X87UP: mem arg, st0 ret
+    mk("C_ldu", ["long double x;", "char c;"], is_union=True)      # INTEGER + X87UP -> MEMORY
+    mk("C_cf", ["_Complex float z;"])                              # SSE
+    mk("C_cd", ["_Complex double z;"])                             # SSE, SSE (two xmm)
+    mk("C_f128", ["_Float128 q;"])                                 # SSE, SSEUP (one xmm)
+    mk("C_v4i", ["v4i v;"])                                        # SSE, SSEUP
+    mk("C_v2d", ["v2d v;"])
+    mk("C_v8c", ["v8c v;"])                                        # SSE
+    mk("C_v4c", ["v4c v;"])                                        # INTEGER
+    mk("C_v1d", ["v1d v;"])                                        # BLKmode leaf -> MEMORY
+    mk("C_v1f", ["v1f v;"])
+    mk("C_v1fi", ["v1f v;", "int i;"])
+    mk("C_fi", ["float f;", "int i;"])                             # SSE+INTEGER merge -> INTEGER
+    mk("C_ff", ["float a;", "float b;"])                           # SSE
+    mk("C_dl", ["double d;", "long long l;"])                      # SSE, INTEGER
+    mk("C_ld2", ["long long l;", "double d;"])                     # INTEGER, SSE
+    mk("C_i128", ["__int128 x;"])
+    mk("C_f3", ["float f[3];"])                                    # SSE, SSE
+    mk("C_c3", ["char c[3];"])
+    mk("C_cfi", ["_Complex float z;", "int i;"])
+    mk("C_uv", ["v4i v;", "double d;"], is_union=True)             # SSE+SSE, SSEUP -> one xmm
+    mk("C_df128", ["double d;", "_Float128 q;"])                   # > 16 -> MEMORY
+    return out
+
+
+def emit_shape_def(sh):
+    kw = "union" if sh.is_union else "struct"
+    attr = " __attribute__((packed))" if sh.packed else ""
+    body = " ".join(d for d, _ in sh.members)
+    return f"{kw} {sh.tag} {{ {body} }}{attr};"
+
+
+def all_paths(sh):
+    out = []
+    for _, ps in sh.members:
+        out += ps
+    return out
+
+
+def value_expr(kind, ctype, v):
+    if kind == "bool":
+        return "1"
+    if kind == "ptr":
+        return f"(void *)(unsigned long)({v} * 16)"
+    if kind.startswith("bf"):
+        w = int(kind[2:])
+        return str(v % (1 << w))
+    return str(v)
+
+
+def lv(template):
+    return template.replace("@", "x")
+
+
+def helpers(sh, k):
+    """static inline set/transform/hash for shape k."""
+    T = f"{'union' if sh.is_union else 'struct'} {sh.tag}"
+    paths = all_paths(sh)
+    s = [f"static inline {T} mk_{k}(int salt) {{ {T} x; __builtin_memset(&x, 0, sizeof x);"]
+    for i, (p, kind, ct) in enumerate(paths):
+        base = (k * 7 + i * 3 + 1) % 50 + 1
+        if kind.startswith("bf") or kind in ("bool", "ptr"):
+            s.append(f"  {lv(p)} = {value_expr(kind, ct, base)};")
+        else:
+            s.append(f"  {lv(p)} = {base} + salt;")
+    s.append("  return x; }")
+    s.append(f"static inline {T} xf_{k}({T} x, int d) {{")
+    for p, kind, ct in paths:
+        if kind == "bool":
+            s.append(f"  {lv(p)} = !{lv(p)};")
+        elif kind == "ptr":
+            s.append(f"  {lv(p)} = (char *){lv(p)} + d;")
+        else:
+            s.append(f"  {lv(p)} = {lv(p)} + d;")
+    s.append("  return x; }")
+    s.append(f"static inline long long h_{k}({T} x) {{ long long h = 0;")
+    for i, (p, kind, ct) in enumerate(paths):
+        if kind == "ptr":
+            s.append(f"  h += (long long)(unsigned long){lv(p)} * {i + 3};")
+        else:
+            s.append(f"  h += (long long)({lv(p)}) * {i + 3};")
+    s.append("  return h; }")
+    return "\n".join(s)
+
+
+def build_sources(shapes):
+    hdr = ["#include <stdarg.h>", VEC_TYPEDEFS]
+    for sh in shapes:
+        hdr.append(emit_shape_def(sh))
+    prov = ['#include "abi.h"']
+    call = ['#include <stdio.h>', '#include <stdlib.h>', '#include "abi.h"']
+    for k, sh in enumerate(shapes):
+        T = f"{'union' if sh.is_union else 'struct'} {sh.tag}"
+        hdr.append(helpers(sh, k))
+        sig = (f"{T} get_{k}(int a);\n"
+               f"{T} ret_{k}(int a, {T} x, int b);\n"
+               f"long long sum_{k}(int a, {T} x, double d, {T} y, long long z);\n"
+               f"long long many_{k}({T} x0, {T} x1, {T} x2, {T} x3, {T} x4, {T} x5, {T} x6, {T} x7, int tail);\n"
+               f"long long va_{k}(int n, ...);")
+        hdr.append(sig)
+        # Scalar-only signature: no aggregate argument, so both sides take
+        # their plain-call fast paths and only the return convention decides.
+        prov.append(f"{T} get_{k}(int a) {{ return mk_{k}(a); }}")
+        prov.append(f"{T} ret_{k}(int a, {T} x, int b) {{ return xf_{k}(x, a + b); }}")
+        prov.append(f"long long sum_{k}(int a, {T} x, double d, {T} y, long long z) "
+                    f"{{ return h_{k}(x) * 3 + h_{k}(y) * 5 + a * 7 + (long long)d * 11 + z * 13; }}")
+        prov.append(f"long long many_{k}({T} x0, {T} x1, {T} x2, {T} x3, {T} x4, {T} x5, {T} x6, {T} x7, int tail) "
+                    f"{{ return h_{k}(x0) + h_{k}(x1) * 2 + h_{k}(x2) * 3 + h_{k}(x3) * 4 + h_{k}(x4) * 5"
+                    f" + h_{k}(x5) * 6 + h_{k}(x6) * 7 + h_{k}(x7) * 8 + tail * 9; }}")
+        prov.append(f"long long va_{k}(int n, ...) {{ va_list ap; va_start(ap, n); {T} x = va_arg(ap, {T});"
+                    f" double d = va_arg(ap, double); {T} y = va_arg(ap, {T}); int t = va_arg(ap, int); va_end(ap);"
+                    f" return h_{k}(x) * 3 + h_{k}(y) * 5 + (long long)d * 7 + t * 11 + n; }}")
+    call.append("static int fails;")
+    call.append("static volatile int sel_;")
+    call.append("#define CHECK(name, got, want) do { long long g_ = (got), w_ = (want); "
+                "if (g_ != w_) { fails++; printf(\"FAIL %s got=%lld want=%lld\\n\", name, g_, w_); } } while (0)")
+    for k, sh in enumerate(shapes):
+        T = f"{'union' if sh.is_union else 'struct'} {sh.tag}"
+        call.append(f"static void case_{k}(void) {{")
+        call.append(f"  {T} x = mk_{k}(0), y = mk_{k}(5), z[8];")
+        call.append(f"  for (int i = 0; i < 8; i++) z[i] = mk_{k}(i * 2);")
+        # The result of a scalar-only call consumed as an argument, through
+        # an initializer and through an assignment.
+        call.append(f"  CHECK(\"get_{k}\", h_{k}(get_{k}(3)), h_{k}(mk_{k}(3)));")
+        call.append(f"  {{ {T} v = get_{k}(4); CHECK(\"getinit_{k}\", h_{k}(v), h_{k}(mk_{k}(4))); }}")
+        call.append(f"  {{ {T} v; v = get_{k}(6); CHECK(\"getasg_{k}\", h_{k}(v), h_{k}(mk_{k}(6))); }}")
+        # A conditional mixing a call result with an lvalue, both selections.
+        call.append(f"  sel_ = 1; CHECK(\"tern_{k}\", h_{k}(sel_ ? x : get_{k}(3)), h_{k}(x));")
+        call.append(f"  sel_ = 0; CHECK(\"tern_{k}\", h_{k}(sel_ ? x : get_{k}(3)), h_{k}(mk_{k}(3)));")
+        call.append(f"  sel_ = 0; CHECK(\"tern_{k}\", h_{k}(sel_ ? get_{k}(5) : y), h_{k}(y));")
+        call.append(f"  CHECK(\"ret_{k}\", h_{k}(ret_{k}(3, x, 4)), h_{k}(xf_{k}(x, 7)));")
+        call.append(f"  CHECK(\"sum_{k}\", sum_{k}(2, x, 9.0, y, 100), h_{k}(x) * 3 + h_{k}(y) * 5 + 14 + 99 + 1300);")
+        call.append(f"  CHECK(\"many_{k}\", many_{k}(z[0], z[1], z[2], z[3], z[4], z[5], z[6], z[7], 17), "
+                    f"h_{k}(z[0]) + h_{k}(z[1]) * 2 + h_{k}(z[2]) * 3 + h_{k}(z[3]) * 4 + h_{k}(z[4]) * 5"
+                    f" + h_{k}(z[5]) * 6 + h_{k}(z[6]) * 7 + h_{k}(z[7]) * 8 + 153);")
+        call.append(f"  CHECK(\"va_{k}\", va_{k}(1, x, 4.0, y, 6), h_{k}(x) * 3 + h_{k}(y) * 5 + 28 + 66 + 1);")
+        call.append("}")
+    call.append("int main(int argc, char **argv) { int k = atoi(argv[1]); switch (k) {")
+    for k in range(len(shapes)):
+        call.append(f"  case {k}: case_{k}(); break;")
+    call.append("  default: return 2; } return fails ? 1 : 0; }")
+    return "\n".join(hdr) + "\n", "\n".join(prov) + "\n", "\n".join(call) + "\n"
+
+
+def run(cmd, cwd):
+    return subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)
+
+
+
+def oracle_error(cc):
+    """None when `cc` is a GCC 16 (the pinned oracle, as in
+    tests/regression/lib/gcc_oracle.sh), otherwise why not: a missing or
+    different compiler is a configuration error, never a silent substitute."""
+    if shutil.which(cc) is None:
+        return f"oracle {cc} not found"
+    try:
+        ver = subprocess.run([cc, "-dumpfullversion"], capture_output=True, text=True, timeout=30).stdout.strip()
+    except (OSError, subprocess.SubprocessError) as e:
+        return f"oracle {cc} unusable: {e}"
+    if ver.split(".")[0] != "16":
+        return f"oracle {cc} is GCC {ver or '?'}, GCC 16 required"
+    return None
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--lccc", required=True)
+    ap.add_argument("--cc", default="gcc-16", help="oracle compiler (GCC is the authority for vector_size)")
+    ap.add_argument("--seed", type=int, default=20261017)
+    ap.add_argument("--count", type=int, default=160, help="random shapes in addition to the curated set")
+    ap.add_argument("--opt", default="-O2")
+    ap.add_argument("--keep", help="write the generated sources to this directory")
+    ap.add_argument("--verbose", action="store_true")
+    args = ap.parse_args()
+
+    err = oracle_error(args.cc)
+    if err:
+        print(f"check_sysv_aggregate_abi: FAIL: {err}", file=sys.stderr)
+        return 2
+    rng = random.Random(args.seed)
+    gen = Gen(rng)
+    tops = curated() + [gen.shape() for _ in range(args.count)]
+    shapes = gen.defs + tops  # nested definitions precede their users
+    first_top = len(gen.defs)
+    hdr, prov, call = build_sources(shapes)
+
+    work = args.keep or tempfile.mkdtemp(prefix="sysvabi-")
+    os.makedirs(work, exist_ok=True)
+    for name, text in (("abi.h", hdr), ("prov.c", prov), ("call.c", call)):
+        with open(os.path.join(work, name), "w") as f:
+            f.write(text)
+
+    # Compilation runs inside the work directory: resolve path-like compiler
+    # arguments now so a relative `--lccc target/.../lccc` keeps working.
+    lccc = os.path.abspath(args.lccc) if os.sep in args.lccc else args.lccc
+    compilers = {"oracle": args.cc, "lccc": lccc}
+    objs = {}
+    for role, cc in compilers.items():
+        for tu in ("prov", "call"):
+            out = f"{tu}.{role}.o"
+            r = run([cc, args.opt, "-w", "-c", f"{tu}.c", "-o", out], work)
+            if r.returncode != 0:
+                print(f"check_sysv_aggregate_abi: {role} failed to compile {tu}.c:\n{r.stderr[-2000:]}")
+                return 1
+            objs[(role, tu)] = out
+
+    legs = [("lccc", "oracle"), ("oracle", "lccc"), ("lccc", "lccc")]  # (caller, callee)
+    total_fail = 0
+    for caller, callee in legs:
+        exe = f"t.{caller}-calls-{callee}"
+        r = run([args.cc, "-o", exe, objs[(callee, "prov")], objs[(caller, "call")]], work)
+        if r.returncode != 0:
+            print(f"link failed for {exe}:\n{r.stderr[-2000:]}")
+            return 1
+        failed = []
+        for k in range(first_top, len(shapes)):
+            p = subprocess.run([os.path.join(work, exe), str(k)], capture_output=True, text=True, timeout=20)
+            if p.returncode != 0:
+                why = "crash" if p.returncode < 0 else ",".join(
+                    line.split()[1].rsplit("_", 1)[0] for line in p.stdout.splitlines() if line.startswith("FAIL"))
+                failed.append((k, why))
+        n = len(shapes) - first_top
+        print(f"{caller:>6} calls {callee:<6}: {n - len(failed)}/{n} shapes pass")
+        for k, why in failed:
+            print(f"    FAIL {shapes[k].tag:<8} [{why}]  {emit_shape_def(shapes[k])}" if args.verbose
+                  else f"    FAIL {shapes[k].tag} [{why}]")
+        total_fail += len(failed)
+    if not args.keep:
+        shutil.rmtree(work, ignore_errors=True)
+    print("check_sysv_aggregate_abi: " + ("PASS" if total_fail == 0 else f"FAIL ({total_fail} shape-legs)"))
+    return 0 if total_fail == 0 else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
