+++ b/tests/regression/check_target_attribute_isa.sh
@@ -13,7 +13,13 @@
 #      `no-movbe` keeps `bswap`;
 #   6. FP a function's own target denies (`general-regs-only`, `no-sse`,
 #      `no-sse2`, `no-80387`) is refused naming the function, on x86-64 and
-#      i686, while integer-only and SSE1 code under the same denials builds.
+#      i686, while integer-only and SSE1 code under the same denials builds;
+#   7. intrinsics are accepted exactly where GCC 16.2 accepts them: `arch=`
+#      replaces the command line's ISA and the options before it, denials
+#      cascade (`no-sse2` revokes AES), `general-regs-only` revokes the SSE
+#      class but not integer extensions, and malformed `arch=` values are
+#      the errors GCC reports. With gcc-16 present every verdict is
+#      re-measured on GCC, so the table cannot drift from the oracle.
 # zstd relies on all four: its *_bmi2 clones are dispatched at run time
 # from plain code (DYNAMIC_BMI2).
 set -euo pipefail
@@ -154,4 +160,48 @@ if [[ -n "$GCC_ORACLE" ]]; then
             && fail "GCC accepts what the gate refuses: $src"
     done
 fi
+
+# 7. Intrinsic permission matrix: <verdict> <flags> <target> <body>, where
+#    verdict is `accept`, `reject` (lccc and GCC agree), or `portable:INSN`:
+#    lccc's portable header form (popcntintrin.h, like the BMI headers)
+#    builds without INSN where GCC rejects the call. `-dM -E` drift is the
+#    `march_profiles_match_gcc_feature_sets` unit test's.
+verdict() {
+    local want=$1 flags=$2 target=$3 body=$4 cc got gcc_want=$1
+    printf '#include <immintrin.h>\n__attribute__((target("%s"))) long f(__m256i *v, unsigned x) {\n    %s\n}\n' \
+        "$target" "$body" >"$tmp/p.c"
+    if [[ $want == portable:* ]]; then gcc_want=reject; want=accept; fi
+    for cc in "$CCC" ${GCC_ORACLE:+"$GCC_ORACLE"}; do
+        # shellcheck disable=SC2086 # $flags is a word list
+        if "$cc" -O2 $flags -S "$tmp/p.c" -o "$tmp/p.s" 2>"$tmp/p.err"; then got=accept; else got=reject; fi
+        [[ $cc == "$CCC" ]] || want=$gcc_want
+        [[ $got == "$want" ]] || fail "${cc##*/} ${got}s target(\"$target\") $flags: $body $(head -c 300 "$tmp/p.err")"
+        if [[ $cc == "$CCC" && $1 == portable:* ]] && grep -Eq "\\b${1#portable:}" "$tmp/p.s"; then
+            fail "target(\"$target\") $flags emitted ${1#portable:}: $body"
+        fi
+    done
+}
+aes='return _mm_cvtsi128_si64(_mm_aesenc_si128(_mm_set1_epi64x(x), _mm_set1_epi64x(3)));'
+add256='*v = _mm256_add_epi32(*v, *v); return 0;'
+pop='return _mm_popcnt_u32(x);'
+pdep='return _pdep_u32(x, 0xff00ff);'
+verdict portable:popcnt -mpopcnt "arch=x86-64" "$pop"
+verdict reject -mavx2 "arch=x86-64" "$add256"
+verdict reject "" "avx2,arch=x86-64" "$add256"
+verdict accept "" "arch=x86-64,avx2" "$add256"
+verdict reject "" "arch=haswell" "$aes"
+verdict accept "" "arch=haswell" "$pdep"
+verdict accept "" "arch=skylake" "$aes"
+verdict accept "" "aes" "$aes"
+verdict reject -maes "no-sse2" "$aes"
+verdict reject -maes "general-regs-only" "$aes"
+verdict accept -mbmi2 "general-regs-only" "$pdep"
+verdict accept "-maes -mpclmul" "no-avx" "$aes"
+verdict accept -mpopcnt "no-sse4.2" "$pop"
+verdict accept "" "popcnt" "$pop"
+verdict reject -mavx2 "no-sse4.1" "$add256"
+verdict reject -march=haswell "tune=generic" "$aes"
+for bad in arch=bogus arch=generic arch=native arch=pentium4 "arch=haswell,arch=skylake"; do
+    verdict reject "" "$bad" "return x;"
+done
 echo "target-attribute ISA gate: PASS"
diff --git a/tests/regression/check_x86_scalar_intrinsics.sh b/tests/regression/check_x86_scalar_intrinsics.sh
index 29b5f586c..901853607 100755
--- a/tests/regression/check_x86_scalar_intrinsics.sh
+++ b/tests/regression/check_x86_scalar_intrinsics.sh
@@ -1,6 +1,6 @@
 #!/bin/sh
 # Bundled scalar x86 intrinsics (bmiintrin.h, lzcntintrin.h, bmi2intrin.h,
-# ia32intrin.h): runtime semantics equal GCC on its own headers for every
+# popcntintrin.h, ia32intrin.h): runtime semantics equal GCC on its own headers for every
 # LCCC flag set, and the ISA flags select the single instructions.
 #   CCC/LCCC = compiler under test; GCC (default gcc-16, else gcc).
 set -eu
@@ -63,6 +63,64 @@ else
     note "SKIP-M32: no 32-bit GCC runtime (gcc-multilib)"
 fi
 
+# popcntintrin.h: lccc's portable form on every flag set against GCC
+# -mpopcnt (GCC refuses the call without POPCNT; lccc computes the count).
+pop=$here/x86_scalar_intrin/popcnt_intrin.c
+for mode in -m64 -m32; do
+    if ! "$gcc" $mode -O2 -mpopcnt "$pop" -o "$tmp/pref" 2>/dev/null; then
+        note "SKIP-POPCNT$mode: no GCC $mode runtime"
+        continue
+    fi
+    "$tmp/pref" >"$tmp/pref.out"
+    for flags in "-O0" "-O2" "-O2 -mpopcnt" "-O2 -march=x86-64-v2"; do
+        i=$((i + 1))
+        # shellcheck disable=SC2086
+        if "$cc" $mode $flags -Werror=implicit-function-declaration "$pop" -o "$tmp/t$i" 2>"$tmp/e$i" &&
+            "$tmp/t$i" >"$tmp/o$i" && cmp -s "$tmp/o$i" "$tmp/pref.out"; then
+            note "PASS: popcnt $mode $flags"
+        else
+            cat "$tmp/e$i"; bad "popcnt $mode $flags"
+        fi
+    done
+done
+
+# PDEP/PEXT inlined into a caller whose target("arch=x86-64") forbids
+# BMI2: the same values as GCC's BMI2 build (GCC itself rejects the call),
+# and no pdep/pext in those callers' text (whole bodies: only a global
+# label ends a function, local `.L` loop labels do not).
+pp=$here/x86_scalar_intrin/pdep_pext_target.c
+"$gcc" -O2 -mbmi2 -DTARGET_BASELINE= "$pp" -o "$tmp/ppref" 2>"$tmp/pp.err" \
+    || { cat "$tmp/pp.err"; bad "GCC pdep/pext oracle build"; }
+"$tmp/ppref" >"$tmp/ppref.out"
+for mode in -m64 -m32; do
+    for flags in "-O0" "-O2" "-O0 -mbmi2" "-O2 -mbmi2" "-O2 -march=x86-64-v3"; do
+        i=$((i + 1))
+        [ "$mode" = -m32 ] && ! "$gcc" -m32 -O2 -mbmi2 -DTARGET_BASELINE= "$pp" -o "$tmp/ppref32" 2>/dev/null \
+            && { note "SKIP-PDEP-PEXT-m32: no GCC -m32 runtime"; break; }
+        [ "$mode" = -m32 ] && "$tmp/ppref32" >"$tmp/ppref.out"
+        # shellcheck disable=SC2086
+        if "$cc" $mode $flags -Werror=implicit-function-declaration "$pp" -o "$tmp/t$i" 2>"$tmp/e$i" &&
+            "$tmp/t$i" >"$tmp/o$i" && cmp -s "$tmp/o$i" "$tmp/ppref.out"; then
+            note "PASS: pdep/pext target $mode $flags"
+        else
+            cat "$tmp/e$i" "$tmp/o$i" 2>/dev/null; bad "pdep/pext target $mode $flags"
+        fi
+    done
+done
+for flags in "-mbmi2" "-march=x86-64-v3"; do
+    # shellcheck disable=SC2086
+    "$cc" -O2 $flags -S "$pp" -o "$tmp/pp.s"
+    for f in base_dep32 base_ext32 base_dep64 base_ext64; do
+        awk -v f="$f:" '$0==f{p=1;next} p&&/^[A-Za-z_][A-Za-z0-9_.]*:$/{p=0} p' "$tmp/pp.s" |
+            grep -Eq '\b(pdep|pext)[lq]?\b' && bad "$f: pdep/pext under target(\"arch=x86-64\") $flags"
+    done
+    for f in dep32:pdep ext32:pext dep64:pdep ext64:pext; do
+        awk -v f="${f%%:*}:" '$0==f{p=1;next} p&&/^[A-Za-z_][A-Za-z0-9_.]*:$/{p=0} p' "$tmp/pp.s" |
+            grep -q "${f#*:}" || bad "${f%%:*}: no ${f#*:} under $flags"
+    done
+done
+[ "$fail" = 0 ] && note "PASS: pdep/pext per-function selection"
+
 # Instruction contracts: one instruction under the ISA flag, a correct
 # zero-defined fallback without it, and never a call or a bit loop.
 cat >"$tmp/k.c" <<'C'
@@ -74,19 +132,21 @@ unsigned long long lzq(unsigned long long x) { return _lzcnt_u64(x); }
 unsigned dep(unsigned x, unsigned m) { return _pdep_u32(x, m); }
 unsigned long long ext(unsigned long long x, unsigned long long m) { return _pext_u64(x, m); }
 unsigned rl(unsigned x, int n) { return _rotl(x, n); }
+int pc(unsigned x) { return _mm_popcnt_u32(x); }
+long long pcq(unsigned long long x) { return _mm_popcnt_u64(x); }
 C
 fn() { awk -v f="$1:" '$0==f{p=1;next} p&&/^[A-Za-z_.][A-Za-z0-9_.]*:$/{p=0} p' "$2"; }
-"$cc" -O2 -mbmi -mlzcnt -mbmi2 -S "$tmp/k.c" -o "$tmp/k.s"
+"$cc" -O2 -mbmi -mlzcnt -mbmi2 -mpopcnt -S "$tmp/k.c" -o "$tmp/k.s"
 "$cc" -O2 -S "$tmp/k.c" -o "$tmp/k0.s"
-for pair in tz:tzcnt lz:lzcnt tzq:tzcnt lzq:lzcnt dep:pdep ext:pext rl:rol; do
+for pair in tz:tzcnt lz:lzcnt tzq:tzcnt lzq:lzcnt dep:pdep ext:pext rl:rol pc:popcnt pcq:popcnt; do
     f=${pair%%:*}; insn=${pair#*:}
     body=$(fn "$f" "$tmp/k.s")
     printf '%s\n' "$body" | grep -q "$insn" || bad "$f: no $insn under the ISA flags"
     printf '%s\n' "$body" | grep -Eq '\bcall|\bj[a-z]+ ' && bad "$f: call/branch under the ISA flags"
 done
-for f in tz lz tzq lzq rl; do
+for f in tz lz tzq lzq rl pc pcq; do
     body=$(fn "$f" "$tmp/k0.s")
-    printf '%s\n' "$body" | grep -Eq 'tzcnt|lzcnt|rep[; ]*bsf' && bad "$f: BMI/LZCNT instruction on the baseline"
+    printf '%s\n' "$body" | grep -Eq 'tzcnt|lzcnt|popcnt|rep[; ]*bsf' && bad "$f: BMI/LZCNT/POPCNT instruction on the baseline"
     printf '%s\n' "$body" | grep -q '\bcall' && bad "$f: call on the baseline"
 done
 [ "$fail" = 0 ] && note "PASS: instruction contracts"
