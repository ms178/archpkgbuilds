+fn returned_product() -> (Build, Operand) {
+    let mut b = Build::new();
+    let lhs = Shape::Zext64.build(&mut b, 1);
+    let rhs = Shape::Zext64.build(&mut b, 2);
+    let product = b.bin(IrBinOp::Mul, lhs, rhs, IrType::U128);
+    (b, product)
