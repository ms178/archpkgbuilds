+    /// Convert a TypeSpecifier with derived declarators to CType.
+    fn ctype_from_type_spec_with_derived(
+        &self,
+        spec: &TypeSpecifier,
+        derived: &[DerivedDeclarator],
+    ) -> CType {
+        let mut ty = self.ctype_from_type_spec(spec);
