+        // Limit 0x80000003 in the U32 ring: 2*i wraps on the top iterations.
+        if let Instruction::Cmp { rhs, op, .. } = &mut f.blocks[1].instructions[1] {
+            *op = C::Ult;
+            *rhs = Operand::Const(IrConst::I32(-2147483645));
