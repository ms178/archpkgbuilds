+fn first_sse3_reference_unless(
+    asm: &str,
+    permitted: impl Fn(&str) -> bool,
+) -> Option<(String, String)> {
+    first_instruction_if(asm, |function, op, _| {
+        !permitted(function)
+            && (op.starts_with("fisttp")
+                || matches!(
+                    op,
+                    "addsubps"
+                        | "addsubpd"
+                        | "haddps"
+                        | "haddpd"
+                        | "hsubps"
+                        | "hsubpd"
+                        | "movddup"
+                        | "movshdup"
+                        | "movsldup"
+                        | "lddqu"
+                ))
