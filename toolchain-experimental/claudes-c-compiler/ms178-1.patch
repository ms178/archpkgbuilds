+        assert_eq!(hex("kxnorb %k1, %k2, %k0"), "c5 ed 46 c1");
+        assert_eq!(hex("kxorb %k1, %k2, %k0"), "c5 ed 47 c1");
+        assert_eq!(hex("kxorq %k1, %k2, %k0"), "c4 e1 ec 47 c1");
