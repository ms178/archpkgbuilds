+fn detect_and_not_fusions(block: &BasicBlock, use_counts: &[u32]) -> FxHashSet<usize> {
+    let mut and_indices = FxHashSet::default();
+    for (idx, pair) in block.instructions.windows(2).enumerate() {
+        let (not_dest, not_ty) = match &pair[0] {
+            Instruction::UnaryOp {
+                dest,
