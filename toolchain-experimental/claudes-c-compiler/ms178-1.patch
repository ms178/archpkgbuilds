+    ("intel", CpuModelField::Vendor, 1),
+    ("lujiazui", CpuModelField::Subtype, 28),
+    ("yongfeng", CpuModelField::Subtype, 35),
+    ("shijidadao", CpuModelField::Subtype, 37),
