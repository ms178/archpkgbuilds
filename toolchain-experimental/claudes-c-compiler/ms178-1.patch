+        CType::ComplexDouble => (vec![Sse, Sse], 64),
+        CType::ComplexLongDouble => (vec![ComplexX87], 128),
+        CType::Vector(elem, total) => {
+            let lanes_fp = matches!(**elem, CType::Float | CType::Double | CType::LongDouble);
