+cold_lea=$(grep -n 'leaq.*g(%rip)' <<<"$cold_body" | head -1 | cut -d: -f1)
+[ -n "$cold_test" ] && [ -n "$cold_lea" ] && [ "$cold_lea" -gt "$cold_test" ] || {
+    echo "cold singleton was eagerly materialized before its guard" >&2; echo "$cold_body" >&2; exit 1; }
