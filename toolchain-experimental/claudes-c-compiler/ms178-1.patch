+        assert_eq!(ctx.resolve_record_key("struct.S").as_ref(), "struct.S#2");
+        ctx.pop_scope();
+        assert_eq!(ctx.resolve_record_key("struct.S").as_ref(), "struct.S#1");
+        ctx.pop_scope();
+        assert_eq!(ctx.resolve_record_key("struct.S").as_ref(), "struct.S");
