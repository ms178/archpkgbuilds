+    fn evex_vec_reg(name: &str) -> Option<(u8, u8)> {
+        for (prefix, ll) in [("zmm", 2u8), ("ymm", 1u8), ("xmm", 0u8)] {
+            if let Some(num) = name.strip_prefix(prefix) {
+                let n: u8 = num.parse().ok()?;
