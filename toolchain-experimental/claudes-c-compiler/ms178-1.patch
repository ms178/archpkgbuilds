+/* expected-warning@+2 {{use of a '#elifdef' directive is a C23 extension}} */
+#ifdef FOO
+#elifdef BAR
+#error "got it"
+#endif
+#undef BAR
+
+/* expected-warning@+2 {{use of a '#elifdef' directive is a C23 extension}} */
