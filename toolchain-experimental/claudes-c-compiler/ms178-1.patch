+        m.insert(
+            "struct.B".to_string(),
+            Rc::new(layout(false, 4, 4, vec![field("i", CType::Int, 0)])),
+        );
+        assert!(!member_types_correspond(
+            &CType::Struct("struct.A".into()),
+            &CType::Struct("struct.B".into()),
