+            assumed(&m, "main"),
+            pairs(&[("strlen", false), ("sqrt", true), ("memset", true)])
+        );
+    }
+
+    #[test]
+    fn cli_withdrawal_spares_builtin_spellings() {
+        let mut f = func("main", true, &["memset", "memset"]);
