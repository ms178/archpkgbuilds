+                    | 0xC2 | 0x2A | 0x2C | 0x2D | 0x78 | 0x79 | 0x7B // cmp, cvt both ways
+                    | 0x10 | 0x11 => Some(n), // scalar mov load/store
+                    0x12 if pp == 3 => Some(n), // vmovddup (F2); pp=2 is packed vmovsldup
+                    _ => None,
+                }
+            }
