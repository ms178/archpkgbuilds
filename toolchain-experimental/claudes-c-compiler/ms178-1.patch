+                vec![Instruction::Phi {
+                    dest: Value(4),
+                    ty: IrType::I32,
+                    incoming: vec![
+                        (Operand::Const(IrConst::I32(0)), BlockId(0)),
+                        (Operand::Value(Value(3)), BlockId(1)),
