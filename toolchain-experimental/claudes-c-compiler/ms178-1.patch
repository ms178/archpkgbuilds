+                Some("ecx"),
+                Some(4),
+                I686AddressValue::Constant(127),
+            )
+            .unwrap();
+
+            assert_eq!(plan.encoded(true), &[0x44 | (reg_field << 3), 0x8C, 0x7F]);
+        }
+
+        for reg_field in 8u8..=u8::MAX {
+            assert!(
+                i686_plan_memory_address(
+                    false,
+                    reg_field,
+                    Some("eax"),
+                    None,
+                    None,
+                    I686AddressValue::Constant(0),
+                )
+                .is_err()
+            );
+        }
+    }
