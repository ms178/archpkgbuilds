+                let suffix = if sh == 12 { ", lsl #12" } else { "" };
                 self.operand_to_x0(lhs);
                 if use_32bit {
-                    self.state.emit_fmt(format_args!("    cmp w0, #{}", imm));
+                    self.state
+                        .emit_fmt(format_args!("    cmp w0, #{}{}", imm, suffix));
                 } else {
