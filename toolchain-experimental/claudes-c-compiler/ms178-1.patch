+                gpr_dest(dest)
+                    && match src {
+                        crate::ir::reexports::Operand::Value(value) => self.machinst_gpr_value(value.0),
+                        crate::ir::reexports::Operand::Const(_) => true,
+                    }
+            }
+            Instruction::UnaryOp { dest, op, src, ty }
+                if matches!(op, IrUnaryOp::Neg | IrUnaryOp::Not)
+                    && !ty.is_float()
+                    && !ty.is_128bit()
+                    && !matches!(ty, IrType::I8 | IrType::U8 | IrType::I16 | IrType::U16) =>
+            {
+                gpr_dest(dest)
+                    && match src {
+                        crate::ir::reexports::Operand::Value(value) => self.machinst_gpr_value(value.0),
+                        crate::ir::reexports::Operand::Const(_) => true,
