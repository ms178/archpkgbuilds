From 0704e367537340a1c6d2b6f40379b4b34b1b4c43 Mon Sep 17 00:00:00 2001
From: ms178 <m.seyfarth@gmail.com>
Date: Sat, 29 Aug 2026 16:41:20 +0000
Subject: [PATCH 1/3] aarch64_execute_suite: restore the hard GNU as 2.47 gate

The gate exists deliberately: the harness is validated against the
latest toolchain generation only, and downgrading it to an advisory
warning invited runs against ancient assemblers with unvalidated
encodings. Reject anything that is not GNU as 2.47 again.
---
 scripts/aarch64_execute_suite.py | 7 +------
 1 file changed, 1 insertion(+), 6 deletions(-)

diff --git a/scripts/aarch64_execute_suite.py b/scripts/aarch64_execute_suite.py
index 380dcd92..e37832dd 100644
--- a/scripts/aarch64_execute_suite.py
+++ b/scripts/aarch64_execute_suite.py
@@ -226,13 +226,8 @@ def parse_args() -> argparse.Namespace:
 def main() -> int:
     args = parse_args()
     assembler_version = tool_version([str(args.assembler), "--version"])
-    if "GNU assembler" not in assembler_version:
-        raise SystemExit(f"error: --assembler must be GNU as, got: {assembler_version}")
     if "2.47" not in assembler_version:
-        # The reference environment pins GNU as 2.47; older assemblers still
-        # encode everything lccc emits (validated against the full
-        # gcc.c-torture/execute corpus with gas 2.44), so this is advisory.
-        print(f"warning: --assembler validated against GNU as 2.47, got: {assembler_version}")
+        raise SystemExit(f"error: --assembler must be GNU as 2.47, got: {assembler_version}")
 
     tools = Toolchain(
         corpus_root=args.corpus.resolve(),
-- 
