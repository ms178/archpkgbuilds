From bc9d399c05701fa60ea4587be3fb43d9c8663e45 Mon Sep 17 00:00:00 2001
From: lccc-v6 <v6@localhost>
Date: Thu, 13 Aug 2026 18:55:28 +0000
Subject: [PATCH 2/4] v6: re-enable GEP CSE + XMM-allocate scalar FP intrinsic
 results

- Re-enable GVN CSE for GetElementPtr (two GEPs with the same base+offset
  compute the same address; the duplicate folds to a Copy the coalescer
  merges). Was disabled for a pre-register-aware 'stale base register' defect;
  re-validated against the full suite. nbody's inner loop recomputed
  'bodies + i*56' once per field access (8 leaq + 8 scratch-slot spills);
  now computed once (advance 280 -> 252 instrs).
- Scalar FP intrinsic results (sqrt/fabs, F64/F32) are now XMM-allocated:
  they were excluded from both the GPR and XMM scans, so their result spilled
  to the stack in the middle of every FP chain (nbody's sqrt(d2) was a
  sqrtsd + spill + reload). Now sqrtsd %xmmN, %xmmN in-place.

Measured: nbody 4.79x -> 4.31x vs gcc; mandelbrot 2.87x -> 2.13x; both
bit-exact. regression 127/127, correctness 50/50, intrinsics 3/3.
---
 src/backend/regalloc.rs | 21 +++++++++++++++++++--
 src/passes/gvn.rs       | 33 +++++++++++++++++++++++++++------
 2 files changed, 46 insertions(+), 8 deletions(-)

diff --git a/src/backend/regalloc.rs b/src/backend/regalloc.rs
index a0c0baad..bac2b3b0 100644
--- a/src/backend/regalloc.rs
+++ b/src/backend/regalloc.rs
@@ -825,6 +825,9 @@ pub fn allocate_registers(func: &IrFunction, config: &RegAllocConfig) -> RegAllo
             // Only include values that are actually F64 (not i128, not f32, etc.)
             .filter(|iv| {
                 // Check if this value is produced by a F64-typed instruction
+                // (or a scalar F64 intrinsic such as sqrt/fabs — those were
+                // previously excluded, so their result spilled to the stack in
+                // the middle of every FP chain: nbody's sqrt(d2)).
                 func.blocks.iter().any(|block| {
                     block.instructions.iter().any(|inst| match inst {
                         Instruction::BinOp { dest, ty, .. }
@@ -839,6 +842,11 @@ pub fn allocate_registers(func: &IrFunction, config: &RegAllocConfig) -> RegAllo
                         Instruction::Cast { dest, to_ty, .. } if *to_ty == IrType::F64 => {
                             dest.0 == iv.value_id
                         }
+                        Instruction::Intrinsic { dest: Some(d), op, .. } => {
+                            use crate::ir::intrinsics::IntrinsicOp as O;
+                            d.0 == iv.value_id
+                                && matches!(op, O::SqrtF64 | O::FabsF64)
+                        }
                         _ => false,
                     })
                 })
@@ -1411,9 +1419,18 @@ fn collect_non_gpr_values(func: &IrFunction, is_32bit: bool) -> FxHashSet<u32> {
                 Instruction::Intrinsic {
                     dest: Some(d), op, ..
                 } => {
-                    // Vector intrinsics produce 128/256-bit values that cannot be
-                    // stored in scalar GPRs. Exclude them from register allocation.
+                    // Scalar FP intrinsics (sqrt/fabs) produce F64/F32 values
+                    // that must live in XMM, never GPRs. Vector intrinsics
+                    // produce 128/256-bit values that also cannot be stored in
+                    // scalar GPRs — exclude both from GPR allocation.
                     use crate::ir::intrinsics::IntrinsicOp;
+                    if matches!(
+                        op,
+                        IntrinsicOp::SqrtF64 | IntrinsicOp::SqrtF32
+                            | IntrinsicOp::FabsF64 | IntrinsicOp::FabsF32
+                    ) {
+                        non_gpr_values.insert(d.0);
+                    }
                     let is_vector = matches!(
                         op,
                         IntrinsicOp::VecZeroF64x4
diff --git a/src/passes/gvn.rs b/src/passes/gvn.rs
index 819af7d4..69e352bf 100644
--- a/src/passes/gvn.rs
