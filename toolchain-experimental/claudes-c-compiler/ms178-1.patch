+    if !found_phi {
+        return None;
+    }
+    let mut matching_step = false;
+    let mut definitions = 0;
+    for &block_idx in loop_blocks {
+        for inst in &func.blocks[block_idx].instructions {
+            if inst.dest() != Some(step_value) {
+                continue;
+            }
+            definitions += 1;
