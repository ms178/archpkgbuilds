+                    if rr.returncode != 0 or rr.stdout != want_out:
+                        problems.append(f"{who} run [{' '.join(order)}]: rc={rr.returncode} "
+                                        f"out={rr.stdout!r}, want {want_out!r}")
+            results.append(Result(name, "FAIL" if problems else "PASS",
+                                  "; ".join(problems)[:600]))
