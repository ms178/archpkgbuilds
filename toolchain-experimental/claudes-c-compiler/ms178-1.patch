-  vmovsd (%rcx), %xmm1
-  vbroadcastsd %xmm1, %ymm1   # hoisted
-  xorl %ebp, %ebp
-.LBB6:
-  movslq %ebp, %r12
-  leaq (%r14, %r12), %r10
-  ...
-  vmovupd (%rax), %ymm0
-  vfmadd231pd (%rdx), %ymm1, %ymm0
-  vmovupd %ymm0, (%rax)
-  ... x4, 0 vmovsd inside LBB6
-```
-
-- `vmovsd` count total: 1 (preheader) vs 4 before inside loop.
-- `vbroadcastsd` count total: 1 vs 4 before.
-- LBB6 vmovsd count: 0 (was 4).
