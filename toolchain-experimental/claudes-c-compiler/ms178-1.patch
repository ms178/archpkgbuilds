From d20b91a7d1e6f37347cab9eb7c4e9a5d7da18077 Mon Sep 17 00:00:00 2001
From: lccc-v6 <v6@localhost>
Date: Thu, 13 Aug 2026 18:59:30 +0000
Subject: [PATCH 3/4] v6: FP register-direct loads/stores with folded constant
 offsets

The GEP-fold load/store path (movX off(base), dest) only had a register-direct
fast path for integers; F64/F32 fell to the GPR round-trip (movq off(base),
%rax; movq %rax,%xmmN and its store mirror). nbody's pairwise loop paid that
on every field access. Now movsd/movss off(%base), %xmmN into/from the
XMM-allocated home.

nbody: 4.79x -> 4.25x vs gcc (round-trips 13 -> 5); bit-exact.
regression 127/127, correctness 50/50, intrinsics 3/3.
---
 src/backend/x86/codegen/memory.rs | 49 +++++++++++++++++++++++++++++++
 1 file changed, 49 insertions(+)

diff --git a/src/backend/x86/codegen/memory.rs b/src/backend/x86/codegen/memory.rs
index 61493641..d9333034 100644
--- a/src/backend/x86/codegen/memory.rs
+++ b/src/backend/x86/codegen/memory.rs
@@ -883,6 +883,31 @@ impl X86Codegen {
 
         // Register-direct store: when val has a register, store directly to memory
         // without loading to %rax first. Handles Direct (alloca) and Indirect (ptr) cases.
+        // v6: FP variant — an XMM-allocated F64/F32 value stores straight to the
+        // folded-offset address (movsd/movss %xmmN, off(%base)) instead of the
+        // GPR round-trip (movq %xmmN,%rax; movq %rax,off(%base)).
+        if ty == IrType::F64 || ty == IrType::F32 {
+            if let Operand::Value(v) = val {
+                if let Some(v_reg) = self.reg_assignments.get(&v.0).copied() {
+                    if is_xmm_reg(v_reg) {
