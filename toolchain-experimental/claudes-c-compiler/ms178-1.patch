+                // `x << k` == `x * 2^k` in wrapping two's complement —
+                // exact at every wrap width, so the affine scale is exact.
+                Instruction::BinOp {
+                    op: IrBinOp::Shl,
+                    lhs,
+                    rhs,
+                    ..
+                } => {
+                    let Operand::Const(c) = rhs else {
+                        return Some(opaque_var(*v));
+                    };
+                    let k = c.to_i64()?;
+                    if !(0..=62).contains(&k) {
