diff --git a/tests/regression/fma_prefix_standin.sh b/tests/regression/fma_prefix_standin.sh
new file mode 100755
index 0000000..e91fced
--- /dev/null
+++ b/tests/regression/fma_prefix_standin.sh
@@ -0,0 +1,36 @@
+#!/usr/bin/env bash
+# Pre-fix stand-in compiler for the FMA digit-permutation gate.
+#
+# `check_fma_digit_permutation.sh --expect-defect` must go RED.  The repository
+# has no way to check out a pre-fix LCCC, so this wrapper manufactures the
+# exact SA-11 defect and nothing else: it makes all three digit spellings
+# compute the SAME expression, which is what one shared operand placement does.
+# Under it, `_213` and `_231` produce `a*b + c`'s... no: they produce whatever
+# the 132 placement produces for THEIR digits, i.e. `c*a + b` and `b*c + a`,
+# so their rows differ from `ref_*` and the gate reports red.
+#
+# Implementation: the probe declares the raw `__lccc_simd*` builtins itself, so
+# the wrapper simply -D-renames the 213/231 prototypes onto the 132 one, which
+# reproduces one placement for all three.  That is a single-line, single
+# behaviour change; if the gate stays green against it, the gate is not testing
+# the placement at all.
+#
+# Not a compiler in its own right -- it delegates to $REAL_CC (default `cc`).
+set -euo pipefail
+
+REAL_CC="${REAL_CC:-cc}"
+
+if [ $# -eq 0 ]; then
+    exec "$REAL_CC"
+fi
+
+exec "$REAL_CC" "$@" \
+    -U__CCC__ \
+    -D_lccc_simd128_ps_fmadd213ps128=_lccc_simd128_ps_fmadd132ps128 \
+    -D_lccc_simd128_ps_fmadd231ps128=_lccc_simd128_ps_fmadd132ps128 \
+    -D_lccc_simd128_ps_fmadd213pd128=_lccc_simd128_ps_fmadd132pd128 \
+    -D_lccc_simd128_ps_fmadd231pd128=_lccc_simd128_ps_fmadd132pd128 \
+    -D_lccc_simd256_ps_vfmadd213ps256=_lccc_simd256_ps_vfmadd132ps256 \
+    -D_lccc_simd256_ps_vfmadd231ps256=_lccc_simd256_ps_vfmadd132ps256 \
+    -D_lccc_simd256_ps_vfmadd213pd256=_lccc_simd256_ps_vfmadd132pd256 \
+    -D_lccc_simd256_ps_vfmadd231pd256=_lccc_simd256_ps_vfmadd132pd256
diff --git a/tests/regression/same_width_cast_range/cross.c b/tests/regression/same_width_cast_range/cross.c
new file mode 100644
index 0000000..3dd372e
--- /dev/null
+++ b/tests/regression/same_width_cast_range/cross.c
@@ -0,0 +1,267 @@
+/* Freestanding four-ISA execution fixture for same-width signedness casts.
+ *
+ * The range-gated `cast_sign_range` simplify rule may delete a same-width
+ * signedness Cast ONLY when the source's sign bit is provably clear.  These
+ * functions pair every foldable producer with a sign-bit-set control and an
+ * opaque volatile-Load control at each supported width.  These sign-bit
+ * controls are end-to-end ABI/execution checks for the four backends'
+ * canonicalisation (`sext.w`, `sxtw`/`mov w0,w0`, `cast_normalize_eax`,
+ * `movl`), NOT an architecture-safe unsoundness detector: a deliberately
+ * unconditional fold removes all 17 guard Casts yet three host compilers and
+ * all four ISAs still return the oracle because the ABI/backend repairs the
+ * upper bits.  The per-function IR census in
+ * `scripts/check_same_width_cast_range.py` is the load-bearing assertion;
+ * `CCC_SIMPLIFY_SKIP=cast_sign_range` proves the five folded sections have
+ * teeth of their own.
+ *
+ * No libc, no headers: the harness links a per-ISA `_start` and executes the
+ * exit status natively (x86-64) or under qemu-user (i686/AArch64/RISC-V64).
+ */
+static volatile unsigned int g_u;
+static volatile int g_v;
+static volatile int g_s;
+static volatile unsigned long long g_w;
+
+/* Full-width sign-bit-set sources.  Each pair covers BOTH directions. */
+static volatile unsigned char g_u8;
+static volatile signed char g_i8;
+static volatile unsigned short g_u16;
+static volatile short g_i16;
+static volatile unsigned long long g_u64;
+static volatile long long g_i64;
+
+/* Non-proven, sign-bit-CLEAR sources: a volatile Load is opaque to the proof.
+ * These must keep the Cast even though runtime values are non-negative. */
+static volatile unsigned char g_c8;
+static volatile unsigned short g_c16;
+static volatile unsigned int g_c32;
+static volatile unsigned long long g_c64;
+static volatile signed char g_s8;
+static volatile short g_s16;
+static volatile int g_s32;
+static volatile long long g_s64;
+
+/* U32 & 1 -> I32: sign bit clear, the Cast is representation-neutral. */
+__attribute__((noinline)) static int masked(void) {
+    return (int)(g_u & 1U);
+}
+
+/* U32 | 0x80000000 -> I32: sign bit SET, the Cast MUST canonicalize. */
+__attribute__((noinline)) static int signbit(void) {
+    return (int)(g_u | 0x80000000U);
+}
+
+/* I32 & 0x7fffffff -> U32: sign bit clear, reverse direction. */
+__attribute__((noinline)) static unsigned int masked_u(void) {
+    return (unsigned int)(g_v & 0x7fffffff);
+}
+
+/* I32 -> U32 of a negative value: sign bit SET, MUST zero-extend. */
+__attribute__((noinline)) static unsigned int signed_to_unsigned(void) {
+    return (unsigned int)g_s;
+}
+
+/* U64 >> 1 -> I64: a logical shift clears the sign bit. */
+__attribute__((noinline)) static long long shifted(void) {
+    return (long long)(g_w >> 1);
+}
+
+/* Narrow homes and a boolean result remain correct under either decision. */
+__attribute__((noinline)) static signed char narrow_i8(void) {
+    return (signed char)(g_u & 0x7fU);
+}
+
+__attribute__((noinline)) static int bool_cast(void) {
+    return (int)(unsigned char)(g_u == 3U);
+}
+
+/* JOIN TEETH: the frontend omits its own Cast for a plain mask, but it does
+ * NOT propagate non-negativity through a ternary merge, so these functions
+ * contain a REAL U32->I32 Cast on a Select.  `select_masked` and `phi_masked`
+ * must fold; `select_signbit` has one ambiguous arm and must keep the Cast. */
+__attribute__((noinline)) static int select_masked(unsigned int x, int c) {
+    unsigned int u = c ? (x & 0x7fffffffU) : (x & 1U);
+    return (int)u;
+}
+
+__attribute__((noinline)) static int phi_masked(unsigned int x, int c) {
+    unsigned int u;
+    if (c) u = x & 0x7fffffffU; else u = x & 1U;
+    return (int)u;
+}
+
+__attribute__((noinline)) static int select_signbit(unsigned int x, int c) {
+    unsigned int u = c ? (x | 0x80000000U) : (x & 1U);
+    return (int)u;
+}
+
+__attribute__((noinline)) static int select_is_negative(unsigned int x, int c) {
+    unsigned int u = c ? (x | 0x80000000U) : (x & 1U);
+    int y = (int)u;
+    return y < 0;
+}
+
+/* OBSERVATION TEETH: compare the sign-bit-set result INSIDE the function,
+ * before any call/return ABI canonicalization can repair the upper bits.
+ * On RISC-V the U32->I32 Cast must emit sext.w; without it x is a
+ * zero-extended positive 64-bit home and `x < 0` is false. */
+__attribute__((noinline)) static int signbit_is_negative(void) {
+    int x = (int)(g_u | 0x80000000U);
+    return x < 0;
+}
+
+/* On x86-64 the I32->U32 Cast emits `movl` (zero upper half).  Without it
+ * the U32->U64 widen below assumes an already zero-extended home and leaves
+ * 0xfffffffffffffffb, so the 64-bit comparison fails. */
+__attribute__((noinline)) static int s2u_wide_ok(void) {
+    unsigned int u = (unsigned int)g_s;
+    unsigned long long w = u;
+    return w == 0xfffffffbULL;
+}
+
+/* ===== Full-width sign-bit-set controls, observed before the ABI ===== */
+__attribute__((noinline)) static int u8_signbit(void) {
+    unsigned char u = (unsigned char)(g_u8 | 0x80U);   /* 0x85 */
+    signed char s = (signed char)u;                     /* MUST be negative */
+    return s < 0 && (unsigned char)s == u
+        && ((unsigned int)s & 0xffU) == (unsigned int)u;
+}
+
+__attribute__((noinline)) static int i8_signbit(void) {
+    signed char s = (signed char)g_i8;                  /* -5 */
+    unsigned char u = (unsigned char)s;                 /* 0xfb */
+    unsigned int widened = u;
+    return (unsigned int)u == 0xfbU && widened == 0xfbU;
+}
+
+__attribute__((noinline)) static int u16_signbit(void) {
+    unsigned short u = (unsigned short)(g_u16 | 0x8000U); /* 0x8005 */
+    short s = (short)u;                                    /* MUST be negative */
+    return s < 0 && (unsigned short)s == u
+        && ((unsigned int)s & 0xffffU) == (unsigned int)u;
+}
+
+__attribute__((noinline)) static int i16_signbit(void) {
+    short s = (short)g_i16;                             /* -5 */
+    unsigned short u = (unsigned short)s;               /* 0xfffb */
+    unsigned int widened = u;
+    return (unsigned int)u == 0xfffbU && widened == 0xfffbU;
+}
+
+__attribute__((noinline)) static int u64_signbit(void) {
+    unsigned long long u = g_u64 | 0x8000000000000000ULL;
+    long long s = (long long)u;                          /* MUST be negative */
+    return s < 0 && (unsigned long long)s == u;
+}
+
+__attribute__((noinline)) static int i64_signbit(void) {
+    long long s = g_i64;                                 /* -5 */
+    unsigned long long u = (unsigned long long)s;        /* 0xffff...fffb */
+    unsigned int lo = (unsigned int)u;
+    unsigned int hi = (unsigned int)(u >> 32);
+    return u == 0xfffffffffffffffbULL && lo == 0xfffffffbU
+        && hi == 0xffffffffU;
+}
+
+/* ===== Opaque volatile-Load controls: sign bit CLEAR, proof MUST refuse ===== */
+__attribute__((noinline)) static signed char u8_unproven(void) {
+    return (signed char)g_c8;
+}
+__attribute__((noinline)) static unsigned char i8_unproven(void) {
+    return (unsigned char)g_s8;
+}
+__attribute__((noinline)) static short u16_unproven(void) {
+    return (short)g_c16;
+}
+__attribute__((noinline)) static unsigned short i16_unproven(void) {
+    return (unsigned short)g_s16;
+}
+__attribute__((noinline)) static int u32_unproven(void) {
+    return (int)g_c32;
+}
+__attribute__((noinline)) static unsigned int i32_unproven(void) {
+    return (unsigned int)g_s32;
+}
+__attribute__((noinline)) static long long u64_unproven(void) {
+    return (long long)g_c64;
+}
+__attribute__((noinline)) static unsigned long long i64_unproven(void) {
+    return (unsigned long long)g_s64;
+}
+
+int lccc_main(void) {
+    g_u = 0x80000005U;
+    g_v = 0x80000005;
+    g_s = -5;
+    g_w = 0x8000000000000003ULL;
+    g_u8 = 0x85U;
+    g_i8 = -5;
+    g_u16 = 5U;
+    g_i16 = -5;
+    g_u64 = 3ULL;
+    g_i64 = -5;
+    g_c8 = 5U;
+    g_c16 = 5U;
+    g_c32 = 5U;
+    g_c64 = 5ULL;
+    g_s8 = 5;
+    g_s16 = 5;
+    g_s32 = 5;
+    g_s64 = 5;
+
+    int a = masked();                         /* 1 */
+    int b = signbit();                        /* 0x80000005 as int (negative) */
+    unsigned int c = masked_u();              /* 5 */
+    unsigned long long wide = (unsigned long long)signed_to_unsigned();
+    long long f = shifted();                  /* 0x4000000000000001 */
+    int d = narrow_i8();                      /* 5 */
+    int e = bool_cast();                      /* 0 */
+    int g = signbit_is_negative();            /* 1, pre-ABI home */
+    int k = s2u_wide_ok();                    /* 1, pre-ABI home */
+    int m = select_masked(g_u, 1);            /* 5, folded join */
+    int n = select_masked(g_u, 0);            /* 1, folded join */
+    int r = phi_masked(g_u, 1);               /* 5, folded join */
+    int q = select_signbit(g_u, 1);           /* 0x80000005, kept Cast */
+    int t = select_is_negative(g_u, 1);       /* 1, kept Cast */
+    int u8s = u8_signbit();                   /* 1 */
+    int i8s = i8_signbit();                   /* 1 */
+    int u16s = u16_signbit();                 /* 1 */
+    int i16s = i16_signbit();                 /* 1 */
+    int u64s = u64_signbit();                 /* 1 */
+    int i64s = i64_signbit();                 /* 1 */
+    signed char u8u = u8_unproven();          /* 5 */
+    unsigned char i8u = i8_unproven();        /* 5 */
+    short u16u = u16_unproven();              /* 5 */
+    unsigned short i16u = i16_unproven();     /* 5 */
+    int u32u = u32_unproven();                /* 5 */
+    unsigned int i32u = i32_unproven();       /* 5 */
+    long long u64u = u64_unproven();          /* 5 */
+    unsigned long long i64u = i64_unproven(); /* 5 */
+
+    int ok = (a == 1) && (b < 0) && ((unsigned int)b == 0x80000005U)
+          && (c == 5U) && (wide == 0xfffffffbULL) && (f > 0)
+          && (d == 5) && (e == 0) && (g == 1) && (k == 1)
+          && (m == 5) && (n == 1) && (r == 5) && (q < 0)
+          && ((unsigned int)q == 0x80000005U) && (t == 1)
+          && (u8s == 1) && (i8s == 1) && (u16s == 1) && (i16s == 1)
+          && (u64s == 1) && (i64s == 1)
+          && (u8u == 5) && ((unsigned int)i8u == 5U)
+          && (u16u == 5) && ((unsigned int)i16u == 5U)
+          && (u32u == 5) && (i32u == 5U)
+          && (u64u == 5) && (i64u == 5ULL);
+    unsigned int h = (unsigned int)a * 1u + (unsigned int)b * 3u
+                   + c * 5u + (unsigned int)wide * 7u
+                   + (unsigned int)f * 11u + (unsigned int)d * 13u
+                   + (unsigned int)e * 17u + (unsigned int)g * 19u
+                   + (unsigned int)k * 23u + (unsigned int)m * 29u
+                   + (unsigned int)n * 31u + (unsigned int)r * 37u
+                   + (unsigned int)q * 41u + (unsigned int)t * 43u
+                   + (unsigned int)u8s * 47u + (unsigned int)i8s * 53u
+                   + (unsigned int)u16s * 59u + (unsigned int)i16s * 67u
+                   + (unsigned int)u64s * 71u + (unsigned int)i64s * 73u
+                   + (unsigned int)u8u * 79u + (unsigned int)i8u * 83u
+                   + (unsigned int)u16u * 89u + (unsigned int)i16u * 97u
+                   + (unsigned int)u32u * 101u + (unsigned int)i32u * 103u
+                   + (unsigned int)u64u * 107u + (unsigned int)i64u * 109u;
+    return (int)((h ^ (ok ? 0x5au : 0xffu)) % 61u);
+}
diff --git a/tests/regression/same_width_cast_range/induction.c b/tests/regression/same_width_cast_range/induction.c
new file mode 100644
index 0000000..ff8d760
--- /dev/null
+++ b/tests/regression/same_width_cast_range/induction.c
@@ -0,0 +1,49 @@
+/* Range-gated same-width Cast fold: 32-bit induction-variable proof.
+ *
+ * `loop_count` has a U32 induction variable and a U32 bound.  A conservative
+ * backend used to widen both to U64, adding one prologue instruction and
+ * 64-bit compare/increment operations.  The range proof now keeps the loop in
+ * its native U32 domain: `i` starts at zero, increases by one only while
+ * `i < n`, and stops at `n <= UINT32_MAX`, so the increment never wraps.
+ *
+ * The harness compiles this fixture with LCCC, GCC 16.2, Clang 23.1.5 and
+ * (in the authenticated hosted lane) ICX 2026.2, then compares a checksum
+ * over every `n` in 0..4096 and a deterministic 4096-byte bitmap.  It also
+ * compiles with `CCC_SIMPLIFY_SKIP=cast_sign_range` to prove the improvement
+ * belongs to that fold.  The assembly and final-IR censuses are the
+ * architecture-independent proof; the runtime checksum is an end-to-end
+ * correctness check, not a substitute for the IR proof.
+ */
+#include <stdio.h>
+#include <stdint.h>
+
+typedef uint32_t u32;
+typedef uint64_t u64;
+
+void hit(u32 x) { (void)x; }
+
+__attribute__((noinline)) u32 loop_count(const unsigned char *b, u32 n) {
+    u32 s = 0;
+    for (u32 i = 0; i < n; i++)
+        s += (b[i >> 3] >> (i & 7)) & 1;
+    return s;
+}
+
+static unsigned char bits[4096];
+
+int main(int argc, char **argv) {
+    volatile unsigned seed = (unsigned)argc + 1u;
+    for (unsigned i = 0; i < sizeof(bits); i++) {
+        seed = seed * 1664525u + 1013904223u;
+        bits[i] = (unsigned char)(seed >> 24);
+    }
+    u64 h = 1469598103934665603ULL;
+    for (u32 n = 0; n <= 4096; n++) {
+        u32 v = loop_count(bits, n);
+        h ^= v;
+        h *= 1099511628211ULL;
+    }
+    printf("%016llx\n", (unsigned long long)h);
+    (void)argv;
+    return 0;
+}
diff --git a/tests/regression/seg_gs_runtime/seg_gs_i128_ptr.c b/tests/regression/seg_gs_runtime/seg_gs_i128_ptr.c
new file mode 100644
index 0000000..17dab01
--- /dev/null
+++ b/tests/regression/seg_gs_runtime/seg_gs_i128_ptr.c
@@ -0,0 +1,172 @@
+/* 16-byte objects (`__int128` / `_Float128`) through `__seg_gs` access.
+ *
+ * Two defects are pinned here, both of which corrupted memory silently:
+ *
+ *  1. `__int128 __seg_gs x` lost its address space.  The wide base token
+ *     returned straight out of the parser's base-token loop, skipping the
+ *     trailing qualifier/storage-class loop, so the compiled access was an
+ *     ordinary unsegmented one.  A `__int128 const` lost its `const` for the
+ *     same reason.
+ *  2. Once the segment survived, the segment emitters still moved a single
+ *     8-byte half: a store left the high word untouched, a load read whatever
+ *     the destination slot already held.
+ *
+ * Address model (shared with tests/bench/seg_gs.h): every object the segment
+ * accesses touch is published twice -- once at its own address and once in a
+ * mirror one 4 GiB window above it -- and the GS base is pointed at that
+ * window.  `%gs:A` therefore lands on A's mirror, while a plain access lands
+ * on A itself.  A dropped segment prefix is thus a *different value*, not a
+ * wild read, so each check below can distinguish the two.
+ */
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include <sys/mman.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#define ARCH_SET_GS 0x1001
+#define DISP ((uintptr_t)1 << 32)
+
+static void map_mirror(const void *g, size_t n) {
+    uintptr_t lo = (uintptr_t)g + DISP, end = lo + n;
+    for (uintptr_t p = lo & ~(uintptr_t)4095; p < end; p += 4096) {
+        void *w = (void *)p;
+        void *m = mmap(w, 4096, PROT_READ | PROT_WRITE,
+                       MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+        if (m == MAP_FAILED) {
+            /* EEXIST: an earlier object already published this page. */
+            if (errno == EEXIST) continue;
+            perror("mmap");
+            exit(2);
+        }
+        if (m != w) {
+            munmap(m, 4096);
+            if (mmap(w, 4096, PROT_READ | PROT_WRITE,
+                     MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0) != w)
+                exit(2);
+        }
+    }
+}
+
+/* Storage whose segment-relative addresses the pointers below hold. */
+static __int128 slot_a[2], slot_b[2];
+static _Float128 fslot[2];
+static __int128 arr[4];
+static __int128 __seg_gs gwide;
+static const __int128 konst = 7;
+
+static int failures;
+#define CHECK(cond, name) do { \
+    if (cond) printf("ok   %s\n", name); \
+    else { printf("FAIL %s\n", name); failures++; } \
+} while (0)
+
+static __int128 mix(__int128 v) { return (v << 3) ^ (v + 0x5a5a5a5a5a5a5a5aLL); }
+
+/* A copy through pointers in the segment: the shape that first exposed the
+ * 8-byte-only transfer. */
+__attribute__((noinline)) static void copy_through(
+    __int128 __seg_gs *dst, const __int128 __seg_gs *src) {
+    *dst = *src;
+}
+
+/* Store a value that arrives in registers and never has a slot of its own. */
+__attribute__((noinline)) static void copy_via_value(__int128 __seg_gs *dst,
+                                                     __int128 v) {
+    *dst = v;
+}
+
+__attribute__((noinline)) static __int128 read_back(const __int128 __seg_gs *p) {
+    return *p;
+}
+
+int main(void) {
+    map_mirror(slot_a, sizeof slot_a);
+    map_mirror(slot_b, sizeof slot_b);
+    map_mirror(fslot, sizeof fslot);
+    map_mirror(arr, sizeof arr);
+    /* Its mirror is published through an explicit integer cast: the object's
+     * own address is segment-relative, which is the whole point of the test. */
+    map_mirror((const void *)(uintptr_t)&gwide, sizeof gwide);
+
+    if (syscall(SYS_arch_prctl, ARCH_SET_GS, (void *)DISP) != 0) {
+        perror("arch_prctl");
+        return 2;
+    }
+
+    /* Segment-relative addresses: the objects themselves, reached through the
+     * GS window by the base above. */
+    __int128 __seg_gs *a = (__int128 __seg_gs *)slot_a;
+    __int128 __seg_gs *b = (__int128 __seg_gs *)slot_b;
+    __int128 want = ((__int128)0x1122334455667788ULL << 64) | 0x99aabbccddeeff00ULL;
+
+    /* 1. Plain store/load through a segment pointer. */
+    *a = want;
+    CHECK(*a == want, "store/load through __seg_gs pointer keeps all 16 bytes");
+
+    /* 2. Pointer-to-pointer copy: both halves must travel. */
+    copy_through(b, a);
+    CHECK(read_back(b) == want, "segment 16-byte copy through two pointers");
+
+    /* 3. Store from a register-born value. */
+    *b = 0;
+    copy_via_value(b, mix(want));
+    CHECK(read_back(b) == mix(want), "16-byte store from a register-born value");
+
+    /* 4. A wide constant image, including a non-zero high half. */
+    *b = ((__int128)0x0123456789abcdefLL << 64) | 0xfedcba9876543210ULL;
+    CHECK(read_back(b) == (((__int128)0x0123456789abcdefLL << 64) |
+                           0xfedcba9876543210ULL),
+          "16-byte constant store");
+    *b = 0;
+    CHECK(read_back(b) == 0, "16-byte zero store");
+
+    /* 5. A `_Float128` object in the segment keeps all 16 bytes.  The value
+     * stored is a bit pattern the compiler cannot round to a smaller
+     * precision, so a store that transfers only the low eight bytes leaves a
+     * visibly different low half -- and the comparison is back through the
+     * generic view, because casting binary128 to __int128 is a VALUE
+     * conversion rather than the bit copy under test. */
+    static const unsigned char fpat[16] = {0x00, 0x01, 0x02, 0x03, 0x04, 0x05,
+                                           0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b,
+                                           0x0c, 0x0d, 0x0e, 0x0f};
+    _Float128 fval;
+    memcpy(&fval, fpat, 16);
+    _Float128 __seg_gs *f = (_Float128 __seg_gs *)fslot;
+    memset(fslot, 0xff, sizeof fslot);
+    *f = fval;
+    /* Read back THROUGH the segment: the generic `fslot` is the other view and
+     * must still hold the 0xff filler. */
+    _Float128 fback = *f;
+    CHECK(memcmp(&fback, fpat, 16) == 0,
+          "_Float128 __seg_gs store keeps all 16 bytes");
+
+    /* 6. Indexed segment accesses at 16-byte stride. */
+    __int128 __seg_gs *base = (__int128 __seg_gs *)arr;
+    for (int i = 0; i < 4; i++) base[i] = want + i;
+    int idx_ok = 1;
+    for (int i = 0; i < 4; i++)
+        if (base[i] != want + i) idx_ok = 0;
+    CHECK(idx_ok, "indexed 16-byte segment accesses");
+
+    /* 7. A whole `__seg_gs` object, not just a pointee: this is the shape whose
+     * address space the parser used to drop. */
+    gwide = want;
+    CHECK(gwide == want, "__int128 __seg_gs object keeps its address space");
+    gwide = gwide + konst;
+    CHECK(gwide == want + 7, "const __int128 operand folds with the segment");
+
+    /* 8. The generic view must NOT see any of it: %gs really was used. */
+    CHECK(slot_a[0] != want && slot_b[0] != mix(want),
+          "accesses went through %gs, not the generic address");
+
+    if (failures == 0) {
+        printf("PASSED (0 failures)\n");
+        return 0;
+    }
+    printf("FAILED (%d failures)\n", failures);
+    return 1;
+}
diff --git a/tests/regression/seg_gs_runtime/seg_gs_wide_scratch.c b/tests/regression/seg_gs_runtime/seg_gs_wide_scratch.c
new file mode 100644
index 0000000..7bf31e9
--- /dev/null
+++ b/tests/regression/seg_gs_runtime/seg_gs_wide_scratch.c
@@ -0,0 +1,36 @@
+/* A live value in the pre-coloured %xmm1 scratch alongside a 16-byte segment
+   constant store. The store's constant form materialises its high half
+   through %xmm1; if the "is the scratch free" test only looks at %xmm0, the
+   live value is destroyed and this program computes the wrong result. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#include <stdint.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <errno.h>
+#define DISP ((uintptr_t)1<<32)
+static __int128 dst[2] __attribute__((aligned(16)));
+static void mapm(const void*g,size_t n){uintptr_t lo=(uintptr_t)g+DISP,e=lo+n;
+ for(uintptr_t p=lo&~(uintptr_t)4095;p<e;p+=4096){void*w=(void*)p;
+  void*m=mmap(w,4096,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS|MAP_FIXED_NOREPLACE,-1,0);
+  if(m==MAP_FAILED){if(errno==EEXIST)continue;return;}
+  if(m!=w){munmap(m,4096);if(mmap(w,4096,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS|MAP_FIXED,-1,0)!=w)return;}}}
+__attribute__((noinline)) static long two_wide(__int128 a, __int128 b) {
+    /* both arguments must survive; the store's staging is the hazard */
+    __int128 __seg_gs *p = (__int128 __seg_gs *)dst;
+    *p = ((__int128)0x1122334455667788LL << 64) | 0x99aabbccddeeff00ULL;
+    return (long)(a >> 64) + (long)b + (long)(*p >> 64);
+}
+int main(void){
+    mapm(dst, sizeof dst);
+    if(syscall(SYS_arch_prctl,0x1001,(void*)DISP)!=0){perror("gs");return 2;}
+    __int128 a = ((__int128)11<<64)|1, b = 22;
+    long want = 11 + 22 + 0x1122334455667788L;
+    long got = two_wide(a,b);
+    printf("%s got=%ld want=%ld\n", got==want?"ok":"WRONG", got, want);
+    if (got != want) { printf("FAILED (1 failures)\n"); return 1; }
+    printf("PASSED (0 failures)\n");
+    return 0;
+}
diff --git a/tests/regression/vector_home_relay_clobber.c b/tests/regression/vector_home_relay_clobber.c
new file mode 100644
index 0000000..d1129f7
--- /dev/null
+++ b/tests/regression/vector_home_relay_clobber.c
@@ -0,0 +1,17 @@
+typedef float vf8 __attribute__((vector_size(32)));
+static __attribute__((noinline)) void clobber(vf8 *p) {
+    *p = (vf8){7,7,7,7,7,7,7,7};
+}
+static __attribute__((noinline)) void relay(vf8 *out, const vf8 *in, vf8 hi) {
+    vf8 t = __builtin_ia32_minps256(*in, hi);
+    clobber(out);
+    *out = t;
+}
+int main(void) {
+    vf8 in = {5,5,5,5,5,5,5,5};
+    vf8 hi = {3,3,3,3,3,3,3,3};
+    vf8 out = {0,0,0,0,0,0,0,0};
+    relay(&out, &in, hi);
+    for (int i = 0; i < 8; ++i) if (out[i] != 3.0f) return 1;
+    return 0;
+}
