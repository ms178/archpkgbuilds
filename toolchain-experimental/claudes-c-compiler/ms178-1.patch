+            "adcxq %rsi, %r8",            // CF
+            "daa",                        // AF/CF
+            "kortestw %ax, %bx",          // ZF/CF
+            "fcomip %st(1)",              // ZF/PF/CF
+            "fcomip %st(1)",              // ZF/PF/CF
