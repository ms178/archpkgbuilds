+    // Oracle: reference — __builtin_choose_expr picks arg1 when cond != 0, else arg2.
+    #[test]
+    fn choose_expr_branches_on_cond_nonzero(cond in any::<i64>(), a in any::<i64>(), b in any::<i64>()) {
+        let f = |e: &Expr| -> Option<IrConst> { eval_literal(e) };
