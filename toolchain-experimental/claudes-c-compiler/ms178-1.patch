+    // `.rela.iplt` table.
+    if inp.got_plt_size != 0 || inp.ifunc_count != 0 {
+        dot = align_up(dot, 8);
+    }
+    let got_plt = dot;
+    dot += inp.got_plt_size;
+    let irel_slots = dot;
+    dot += inp.ifunc_count * 8;
+    if inp.ifunc_count != 0 {
+        dot = align_up(dot, 8);
+    }
+    let irela = dot;
+    dot += inp.ifunc_count * 24;
