+                    return None;
+                };
+                let value = c.to_i64()?;
+                if init.is_some_and(|previous| previous != value) {
+                    return None;
+                }
+                init = Some(value);
+                saw_non_latch = true;
+            }
+            return if latch_edges == 1 && saw_non_latch {
+                init
+            } else {
+                None
+            };
+        }
+    }
+    None
