+    let mut extra: Vec<Instruction> = Vec::new();
+    let (pop_src, pop_ty) = match m.x_ty {
+        IrType::I8 => {
+            let v_u8 = alloc_value(func);
+            let v_u32 = alloc_value(func);
+            extra.push(Instruction::Cast {
+                dest: v_u8,
+                src: m.x_init,
+                from_ty: IrType::I8,
+                to_ty: IrType::U8,
+            });
+            extra.push(Instruction::Cast {
+                dest: v_u32,
+                src: Operand::Value(v_u8),
+                from_ty: IrType::U8,
+                to_ty: IrType::U32,
+            });
+            (Operand::Value(v_u32), IrType::U32)
+        }
+        IrType::U8 => {
+            let v_u32 = alloc_value(func);
+            extra.push(Instruction::Cast {
+                dest: v_u32,
+                src: m.x_init,
+                from_ty: IrType::U8,
+                to_ty: IrType::U32,
+            });
+            (Operand::Value(v_u32), IrType::U32)
+        }
+        IrType::I16 => {
+            let v_u16 = alloc_value(func);
+            let v_u32 = alloc_value(func);
+            extra.push(Instruction::Cast {
+                dest: v_u16,
+                src: m.x_init,
+                from_ty: IrType::I16,
+                to_ty: IrType::U16,
+            });
+            extra.push(Instruction::Cast {
+                dest: v_u32,
+                src: Operand::Value(v_u16),
+                from_ty: IrType::U16,
+                to_ty: IrType::U32,
+            });
+            (Operand::Value(v_u32), IrType::U32)
+        }
+        IrType::U16 => {
+            let v_u32 = alloc_value(func);
+            extra.push(Instruction::Cast {
+                dest: v_u32,
+                src: m.x_init,
+                from_ty: IrType::U16,
+                to_ty: IrType::U32,
+            });
+            (Operand::Value(v_u32), IrType::U32)
+        }
+        IrType::I32 | IrType::U32 => (m.x_init, m.x_ty),
+        IrType::I64 | IrType::U64 => (m.x_init, m.x_ty),
+        _ => return false,
+    };
