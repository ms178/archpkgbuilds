+        match self {
+            Self::Unsigned64 => &["    mulq %rcx"],
+            Self::Signed64 => &["    imulq %rcx"],
+            Self::RightHighZero => &[
+                "    imulq %rcx, %rdx",
+                "    movq %rdx, %rsi",
+                "    mulq %rcx",
+                "    addq %rsi, %rdx",
+            ],
+            Self::LeftHighZero => &[
+                "    imulq %rax, %rsi",
+                "    mulq %rcx",
+                "    addq %rsi, %rdx",
