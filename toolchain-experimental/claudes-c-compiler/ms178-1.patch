+        assert!(!out.contains("movbeq (%rdi), %rax"), "{out}");
+    }
+
+    #[test]
+    fn fuses_each_width() {
+        let out = run(concat!(
+            "f:\n    movw (%rdi), %eax\n    bswapw %eax\n",
+            "g:\n    movl (%rdi), %eax\n    bswapl %eax\n",
+            "h:\n    movq 8(%rdi,%rsi,2), %r9\n    bswapq %r9\n"
