+        return false;
+    }
+    // `.byte`, `.2byte`/`.word`, `.4byte`/`.long`, `.8byte`/`.quad`,
+    // `.value`, `.inst`, `.insn`, `.ascii`, `.asciz`, `.string`, `.uleb128`,
+    // `.sleb128`, `.float`, `.double` -- and anything unrecognized.
+    let _ = name;
+    true
