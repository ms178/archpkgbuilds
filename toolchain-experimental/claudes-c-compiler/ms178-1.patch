+            self.state.emit("    subl $8, %esp");
+            self.state.emit("    movl %eax, (%esp)");
+            self.state.emit("    flds (%esp)");
+            self.state.emit("    fisttpq (%esp)");
+            self.state.emit("    movl (%esp), %eax");
+            self.state.emit("    movl 4(%esp), %edx");
+            self.state.emit("    addl $8, %esp");
