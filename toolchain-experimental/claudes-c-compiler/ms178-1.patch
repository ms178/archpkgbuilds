+/// Ordering comparisons that read their operands as unsigned.
+fn cmp_is_unsigned(op: IrCmpOp) -> bool {
+    matches!(op, IrCmpOp::Ult | IrCmpOp::Ule | IrCmpOp::Ugt | IrCmpOp::Uge)
+}
