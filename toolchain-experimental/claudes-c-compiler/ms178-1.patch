diff --git a/Cargo.toml b/Cargo.toml
index c627ff93..05656b1a 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -53,3 +53,26 @@ gcc_m16 = []
 #   opt-level via CARGO_PROFILE_RELEASE_OPT_LEVEL=1 per project policy.
 [profile.release]
 lto = "thin"
+
+# Fast-iteration profile for development / research loops (`cargo build
+# --profile fastbuild`). The release profile's thin LTO quadruples rebuild
+# times on small machines because LTO disables incremental compilation and
+# serializes all codegen behind the cross-unit link step. This profile keeps
+# the optimizer at the project-policy -O1 level (same codegen quality class
+# as the research builds) while restoring the fast edit-compile-test cycle:
+#
+# * lto = "off":            no cross-unit link step, parallel codegen.
+# * incremental = true:     only re-optimize dirty CGUs on rebuilds.
+# * codegen-units = 256:    maximum intra-crate codegen parallelism.
+# * debug = "line-tables-only": usable panic backtraces / gdb line info at
+#                           a fraction of full debuginfo cost.
+#
+# Binaries land in target/fastbuild/. Use scripts/build_lccc_fast.sh.
+# Ship-quality binaries still come from the release profile.
+[profile.fastbuild]
+inherits = "release"
+opt-level = 1
+lto = "off"
+incremental = true
+codegen-units = 256
+debug = "line-tables-only"
diff --git a/scripts/build_lccc_fast.sh b/scripts/build_lccc_fast.sh
new file mode 100644
index 00000000..99970607
--- /dev/null
+++ b/scripts/build_lccc_fast.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+# Fast-iteration build of the LCCC compiler for development / research loops.
+#
+# Uses the `fastbuild` Cargo profile (see Cargo.toml): opt-level 1 (project
+# research policy), LTO off, incremental compilation on, 256 codegen units,
+# line-tables-only debuginfo. On a 2-core box this restores the fast
+# edit-compile-test cycle that the release profile's thin LTO destroyed
+# (LTO disables incremental compilation and serializes codegen).
+#
+# Binaries land in target/fastbuild/{lccc,lccc-x86,lccc-arm,lccc-riscv,
+# lccc-i686,lccc-ld}.
+#
+# Ship-quality binaries still come from scripts/build_lccc_o1_j2.sh
+# (release profile, thin LTO, non-incremental, reproducible).
+set -euo pipefail
+
+repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+cd "$repo_root"
+
+export CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS:-2}
+
+printf '%s\n' "Building LCCC (fastbuild profile: -O1, no LTO, incremental)"
+
+exec cargo build --profile fastbuild --locked -j "${CARGO_BUILD_JOBS}"
