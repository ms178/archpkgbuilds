+            if let Some(pos) = t.find("global:") {
+                mode = Some("global");
+                t = t[pos + "global:".len()..].trim();
+            }
+            if let Some(pos) = t.find("local:") {
+                mode = Some("local");
+                t = t[pos + "local:".len()..].trim();
+            }
+            if t.is_empty() { continue; }
