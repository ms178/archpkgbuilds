 patch_sha=$(sha256sum "$patch_tmp" | awk '{print $1}')
 checkpoint_tmp=$(mktemp "$ART/.checkpoint.tmp.XXXXXX")
@@ -377,15 +386,17 @@ if [[ -f "$REPO/scripts/lccc_recover.py" ]]; then
