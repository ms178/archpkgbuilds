+        "panic_sites",
+        "panic_sites_hot",
+        "unsafe_sites",
+        "ignored_tests",
+        "fns_over_300",
+        "fns_over_500",
+        "fns_over_1000",
+        "knob_literals",
+        "knobs_undocumented",
