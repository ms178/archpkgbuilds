+/// situation where one allocator considers a value call-safe while another
+/// recognizes an implicit helper call or register-operand inline assembly.
+pub(crate) fn instruction_clobbers_caller_saved(inst: &Instruction) -> bool {
+    match inst {
+        // Ordinary calls clobber all ABI caller-saved registers.
+        Instruction::Call { .. } | Instruction::CallIndirect { .. } => true,
+
+        // Inline asm with a bound input/output can use arbitrary GP registers.
+        // Empty memory barriers have no GP operands and remain deliberately
+        // non-clobbering, matching the existing interval allocator policy.
+        Instruction::InlineAsm { outputs, inputs, .. } => !outputs.is_empty() || !inputs.is_empty(),
