+    let name_off32 = name_off as u32;
+    debug_assert_eq!(name_off32 as usize, name_off);
+    // Elf64_Verdef: vd_version, vd_flags, vd_ndx, vd_cnt, vd_hash, vd_aux, vd_next
+    w16(buf, start, 1);
