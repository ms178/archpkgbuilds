+/* C99 digraph tokens are alternate spellings of punctuators, not operators
+ * with different semantics. */
+#include <assert.h>
+
+#define OPEN <%
+#define CLOSE %>
+
+int main(void) {
+    int values<:3:> = <% 2, 3, 5 %>;
+    int macro_braces[] = OPEN 9, 11 CLOSE;
+    assert(values<:0:> == 2);
+    assert(values<:1:> + values<:2:> == 8);
+    assert(macro_braces[0] + macro_braces[1] == 20);
+    return 0;
+}
