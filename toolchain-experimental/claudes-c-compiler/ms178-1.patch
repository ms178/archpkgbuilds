+    /// markers are transparent; other directives are not).
+    fn next_insn(infos: &[LineInfo], from: usize) -> usize {
+        let mut k = from;
+        while k < infos.len() && (infos[k].is_nop() || infos[k].kind == LineKind::Empty) {
