+        __m64 a = _mm_set_pi16(1, 2, 3, 4), b = _mm_set_pi16(-5, 6, -7, 8);
+        __m64 r = c ? a : _mm_add_pi16(a, b);
+        OUT(mbits(r));
+        OUT(mbits(c ? _mm_sub_pi16(a, b) : b));
+        OUT(mbits((c, _mm_xor_si64(a, b))));
+    }
+    _mm_empty();
+    printf("small vector packed wrappers %016llx\n", hash);
+    return 0;
+}
