+        b"rdtsc" => (RAX | RDX, RAX | RDX),
+        b"rdtscp" => (RAX | RCX | RDX, RAX | RCX | RDX),
+        b"rdpmc" | b"rdmsr" => (RAX | RCX | RDX, RAX | RDX),
+        b"wrmsr" => (RAX | RCX | RDX, 0),
+        b"xgetbv" => (RAX | RCX | RDX, RAX | RDX),
+        b"xsetbv" => (RAX | RCX | RDX, 0),
+        b"monitor" => (RAX | RCX | RDX, 0),
+        b"mwait" => (RAX | RCX, 0),
+        // XSAVE stores/restores state; the mask comes from EDX:EAX.  No GP
