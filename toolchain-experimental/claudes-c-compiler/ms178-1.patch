+#include <stdio.h>
+unsigned rot_r(unsigned x) { return (x >> 11) | (x << 21); }
+unsigned rot_l(unsigned x) { return (x << 11) | (x >> 21); }
+unsigned chain(unsigned x) {
+    unsigned a = (x >> 6) | (x << 26);
+    unsigned b = (a >> 11) | (a << 21);
+    return (b >> 25) | (b << 7);
