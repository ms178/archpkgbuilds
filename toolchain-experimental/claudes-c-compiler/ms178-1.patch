diff --git a/tests/regression/sse2_scalar_fp_lane_semantics.c b/tests/regression/sse2_scalar_fp_lane_semantics.c
new file mode 100644
index 0000000..2dc030c
--- /dev/null
+++ b/tests/regression/sse2_scalar_fp_lane_semantics.c
@@ -0,0 +1,113 @@
+/* Bit-exact semantics for the fourteen scalar SSE lane intrinsics.
+ *
+ * These wrappers used to be written as C struct arithmetic
+ * (`__a.__val[0] > __b.__val[0] ? ... : ...`), which is cheap to read and
+ * expensive to compile: every call copied the 16-byte aggregate in and out of
+ * memory and the compare turned into `ucomisd`+`cmov`, so a single `maxsd`
+ * cost ~84 instructions in a loop. They now lower to the SSE instruction
+ * itself. This fixture is the contract that the rewrite must preserve, because
+ * "looks equivalent" is exactly the reasoning that ships sign-of-zero bugs.
+ *
+ * The whole point is the awkward inputs:
+ *   * NaN in either operand (SSE max/min return the SECOND operand),
+ *   * +0.0 against -0.0 in both orders (a comparison cannot see the difference;
+ *     the instruction can),
+ *   * denormals, infinities, and the sqrt of a negative (returns NaN),
+ *   * lanes above the low one, which scalar ops must copy from the first
+ *     operand and never recompute.
+ *
+ * Output is one hex word per case, so any divergence from the oracle's
+ * instruction semantics changes a byte rather than a printed decimal.
+ */
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <xmmintrin.h>
+#include <emmintrin.h>
+
+static uint64_t bits_d(double d) { uint64_t u; memcpy(&u, &d, 8); return u; }
+static uint32_t bits_f(float f) { uint32_t u; memcpy(&u, &f, 4); return u; }
+
+/* Lane access goes through the portable set/store intrinsics so the same
+ * source compiles against a struct-backed __m128d (LCCC) and a native vector
+ * type (GCC/Clang), which is what makes the differential meaningful. */
+static __m128d mk_d(double lo, double hi) { return _mm_set_pd(hi, lo); }
+
+static __m128 mk_f(float lo, float h0, float h1, float h2)
+{
+    return _mm_set_ps(h2, h1, h0, lo);
+}
+
+static void st_d(__m128d v, double out[2]) { _mm_storeu_pd(out, v); }
+static void st_f(__m128 v, float out[4]) { _mm_storeu_ps(out, v); }
+
+#define NAN_D (__builtin_nan(""))
+#define INF_D (__builtin_inf())
+
+int main(void)
+{
+    const double dn[] = { 0.0, -0.0, 1.0, -1.0, 2.5, -2.5, NAN_D, INF_D, -INF_D,
+                          1e-310 /* denormal */, 1e308, -1e308, 3.0, -3.0 };
+    const int nd = (int)(sizeof dn / sizeof dn[0]);
+    unsigned long long h = 1469598103934665603ULL;
+
+    for (int i = 0; i < nd; i++) {
+        for (int j = 0; j < nd; j++) {
+            /* Distinct upper lanes prove they are copied from `a`, not redone. */
+            __m128d a = mk_d(dn[i], 7.25);
+            __m128d b = mk_d(dn[j], -9.5);
+            __m128d r[7];
+            r[0] = _mm_add_sd(a, b);
+            r[1] = _mm_sub_sd(a, b);
+            r[2] = _mm_mul_sd(a, b);
+            r[3] = _mm_div_sd(a, b);
+            r[4] = _mm_max_sd(a, b);
+            r[5] = _mm_min_sd(a, b);
+            r[6] = _mm_sqrt_sd(a, b);
+            for (int k = 0; k < 7; k++) {
+                double lane[2];
+                st_d(r[k], lane);
+                (void)printf("%016llx%016llx\n",
+                             (unsigned long long)bits_d(lane[0]),
+                             (unsigned long long)bits_d(lane[1]));
+                h ^= bits_d(lane[0]);
+                h *= 1099511628211ULL;
+                h ^= bits_d(lane[1]);
+                h *= 1099511628211ULL;
+            }
+        }
+    }
+
+    const float fn[] = { 0.0f, -0.0f, 1.0f, -1.0f, 2.5f, -2.5f,
+                         __builtin_nanf(""), __builtin_inff(), -__builtin_inff(),
+                         1e-40f, 3.0f, -3.0f };
+    const int nf = (int)(sizeof fn / sizeof fn[0]);
+    for (int i = 0; i < nf; i++) {
+        for (int j = 0; j < nf; j++) {
+            __m128 a = mk_f(fn[i], 5.5f, 6.5f, 7.5f);
+            __m128 b = mk_f(fn[j], -1.5f, -2.5f, -3.5f);
+            __m128 r[7];
+            r[0] = _mm_add_ss(a, b);
+            r[1] = _mm_sub_ss(a, b);
+            r[2] = _mm_mul_ss(a, b);
+            r[3] = _mm_div_ss(a, b);
+            r[4] = _mm_max_ss(a, b);
+            r[5] = _mm_min_ss(a, b);
+            r[6] = _mm_sqrt_ss(b);
+            for (int k = 0; k < 7; k++) {
+                float lane[4];
+                st_f(r[k], lane);
+                (void)printf("%08x%08x%08x%08x\n",
+                             bits_f(lane[0]), bits_f(lane[1]),
+                             bits_f(lane[2]), bits_f(lane[3]));
+                for (int l = 0; l < 4; l++) {
+                    h ^= bits_f(lane[l]);
+                    h *= 1099511628211ULL;
+                }
+            }
+        }
+    }
+
+    (void)printf("hash %016llx\n", h);
+    return 0;
+}
diff --git a/tests/regression/test_sse2_codegen_matrix.py b/tests/regression/test_sse2_codegen_matrix.py
new file mode 100644
index 0000000..5933149
--- /dev/null
+++ b/tests/regression/test_sse2_codegen_matrix.py
@@ -0,0 +1,65 @@
+#!/usr/bin/env python3
+"""Compiler-free adversarial tests for the matrix's fail-closed ratchet."""
+import contextlib
+import copy
+import io
+import unittest
+
+import check_sse2_codegen_matrix as matrix
+
+
+class MatrixContractTests(unittest.TestCase):
+    def setUp(self):
+        self.row = matrix.ROWS[0]
+        self.cfg = "O2"
+        self.base = {
+            "verdicts": {self.row.mnemonic: {self.cfg: "loss"}},
+            "debt": {self.row.mnemonic: {self.cfg: {"lccc": 12, "best_oracle": 10}}},
+            "mnemonics": {},
+        }
+        self.result = {"rows": {self.row.mnemonic: {"compilers": {
+            "lccc": {self.cfg: {"status": "ok", "instructions": 12}},
+            "gcc": {self.cfg: {"status": "ok", "instructions": 10, "hash_match": True}},
+            "clang": {self.cfg: {"status": "ok", "instructions": 10, "hash_match": True}},
+        }}}}
+
+    def check(self, result=None, base=None):
+        with contextlib.redirect_stdout(io.StringIO()):
+            return matrix.check_baseline(
+                self.result if result is None else result, [self.row], [self.cfg],
+                ["lccc", "gcc", "clang"], base=self.base if base is None else base,
+            )
+
+    def test_unchanged_measurement_passes(self):
+        self.assertEqual(self.check(), 0)
+
+    def test_two_disagreeing_oracles_are_not_skipped_as_no_oracle(self):
+        for oracle in ("gcc", "clang"):
+            self.result["rows"][self.row.mnemonic]["compilers"][oracle][self.cfg].update(
+                status="hash-mismatch", hash_match=False)
+        self.assertNotEqual(self.check(), 0)
+
+    def test_missing_measurements_fail_closed(self):
+        for compiler in ("lccc", "gcc", "clang"):
+            for status in ("compile-error", "no-body", "missing-hash", "run-error"):
+                with self.subTest(compiler=compiler, status=status):
+                    result = copy.deepcopy(self.result)
+                    result["rows"][self.row.mnemonic]["compilers"][compiler][self.cfg]["status"] = status
+                    self.assertNotEqual(self.check(result), 0)
+
+    def test_a_missing_compiler_entry_is_not_a_success(self):
+        del self.result["rows"][self.row.mnemonic]["compilers"]["lccc"]
+        self.assertNotEqual(self.check(), 0)
+
+    def test_winning_and_tied_rows_keep_their_own_count_ratchet(self):
+        for verdict in ("win", "tie"):
+            with self.subTest(verdict=verdict):
+                base = copy.deepcopy(self.base)
+                base["debt"] = {}
+                base["verdicts"][self.row.mnemonic][self.cfg] = verdict
+                base["counts"] = {self.row.mnemonic: {self.cfg: 11}}
+                self.assertNotEqual(self.check(base=base), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/regression/vector_frame_slot_upper_half.c b/tests/regression/vector_frame_slot_upper_half.c
new file mode 100644
index 0000000..7c9a8e4
--- /dev/null
+++ b/tests/regression/vector_frame_slot_upper_half.c
@@ -0,0 +1,139 @@
+/* A 32-byte GNU vector built lane by lane must survive its frame slot.
+ *
+ * The defect this pins: the peephole classifier described every vector slot
+ * move as 16 bytes, because it derived the footprint from the mnemonic
+ * (`vmovdqu`) instead of from the register operand.  The never-read-store
+ * pass therefore believed the top half of a 32-byte slot was not read, deleted
+ * the stores that fill it, and the function returned a vector whose lanes
+ * 16..31 were whatever the slot held.  Every shape below builds its result in
+ * memory at some point -- lane-wise shifts, per-lane mul, lane extraction,
+ * nine-argument spills -- and the frame slot is 32 bytes wide in all of them.
+ *
+ * The functions are deliberately NON-STATIC and NOINLINE.  Inlining them
+ * removes the frame slot (the value stays in registers), and a static
+ * definition is inlined even at -O0-adjacent levels, so a corpus of statics
+ * passes with or without the fix -- measured: the defect reproduces only for
+ * out-of-line definitions at -O2 -mavx2.
+ *
+ * This file is compiler-independent: it needs no reference compiler, no
+ * ISA flags beyond x86-64, and no measurement.  It prints PASS or FAIL.
+ */
+#include <stdio.h>
+#include <string.h>
+
+typedef char v32c __attribute__((vector_size(32)));
+typedef short v32s __attribute__((vector_size(32)));
+typedef long v32l __attribute__((vector_size(32)));
+
+/* Per-lane variable shift: lanes are extracted from, and re-inserted into, a
+ * 32-byte object, which is the shape that allocates the wide slot. */
+__attribute__((noinline)) v32c vec_shl32c(v32c a, v32c b) { return a << b; }
+__attribute__((noinline)) v32s vec_shl32s(v32s a, v32s b) { return a << b; }
+__attribute__((noinline)) v32l vec_mul32l(v32l a, v32l b) { return a * b; }
+
+/* Lane read out of a 32-byte argument slot (MEMORY class below AVX here). */
+__attribute__((noinline)) long vec_lane2(v32l a) { return a[2]; }
+
+/* Lane insert: the value is staged through the same 32-byte slot. */
+__attribute__((noinline)) v32l vec_setlane2(v32l a, long x) { a[2] = x; return a; }
+
+/* Nine vector arguments: the ninth is passed on the stack, so the frame holds
+ * a 32-byte incoming argument area as well as the result slot. */
+__attribute__((noinline)) v32l vec_nine(v32l a, v32l b, v32l c, v32l d, v32l e,
+                                       v32l f, v32l g, v32l h, v32l i) {
+    return a + b + c + d + e + f + g + h + i;
+}
+
+/* A 32-byte value stored and reloaded through a named object. */
+__attribute__((noinline)) v32l vec_roundtrip(v32l a) {
+    v32l slot;
+    memcpy(&slot, &a, sizeof slot);
+    slot[1] = slot[1] + 1;
+    return slot;
+}
+
+static int fails;
+
+static void expect_bytes(const char *what, const void *got, const void *want,
+                         size_t n) {
+    if (memcmp(got, want, n) != 0) {
+        printf("FAIL: %s\n", what);
+        fails++;
+    }
+}
+
+int main(void) {
+    /* Lane values chosen so that a truncated upper half is unmistakable: the
+     * low half is all ones and the high half carries a distinct pattern. */
+    v32c ca, cb;
+    for (int i = 0; i < 32; i++) {
+        ca[i] = (char)(i * 3 + 1);
+        cb[i] = (char)(i % 5);
+    }
+    v32c cr = vec_shl32c(ca, cb);
+    for (int i = 0; i < 32; i++) {
+        char want = (char)((unsigned char)ca[i] << cb[i]);
+        if (cr[i] != want) {
+            printf("FAIL: v32c shift lane %d: %d != %d\n", i, cr[i], want);
+            fails++;
+            break;
+        }
+    }
+
+    v32s sa, sb;
+    for (int i = 0; i < 16; i++) {
+        sa[i] = (short)(i * 17 + 3);
+        sb[i] = (short)(i % 4);
+    }
+    v32s sr = vec_shl32s(sa, sb);
+    for (int i = 0; i < 16; i++) {
+        short want = (short)((unsigned short)sa[i] << sb[i]);
+        if (sr[i] != want) {
+            printf("FAIL: v32s shift lane %d: %d != %d\n", i, sr[i], want);
+            fails++;
+            break;
+        }
+    }
+
+    v32l la = {11, 22, 33, 44};
+    if (vec_lane2(la) != 33) {
+        printf("FAIL: lane2 = %ld, want 33 (upper-half lane read)\n",
+               vec_lane2(la));
+        fails++;
+    }
+
+    v32l parts[9];
+    v32l want_sum = {0, 0, 0, 0};
+    for (int i = 0; i < 9; i++) {
+        for (int k = 0; k < 4; k++) {
+            parts[i][k] = i * 4 + k;
+            want_sum[k] += parts[i][k];
+        }
+    }
+    v32l got_sum = vec_nine(parts[0], parts[1], parts[2], parts[3], parts[4],
+                            parts[5], parts[6], parts[7], parts[8]);
+    expect_bytes("nine-argument sum", &got_sum, &want_sum, sizeof got_sum);
+
+    v32l rt = vec_roundtrip(la);
+    v32l want_rt = {11, 23, 33, 44};
+    expect_bytes("memcpy round trip", &rt, &want_rt, sizeof rt);
+
+    /* Per-lane multiply over 64-bit lanes: the product of two 32-byte
+     * arguments, computed from lane extracts. */
+    v32l ma = {2, 3, 5, 7}, mb = {11, 13, 17, 19};
+    v32l want_mul = {22, 39, 85, 133};
+    v32l got_mul = vec_mul32l(ma, mb);
+    expect_bytes("v32l per-lane multiply", &got_mul, &want_mul, sizeof got_mul);
+
+    /* Lane insert into the upper half. */
+    v32l want_set = {11, 22, 99, 44};
+    v32l got_set = vec_setlane2(la, 99);
+    expect_bytes("lane insert at index 2", &got_set, &want_set, sizeof got_set);
+
+    if (fails) {
+        printf("FAIL: %d check(s)\n", fails);
+        return 1;
+    }
+    printf("PASS: 32-byte frame slots keep every lane\n");
+    return 0;
+}
