+        hashes = set()
+        for output in [b'value', b'value\n', b'value\r\n', b'value\xff']:
+            result = bench.invoke([sys.executable, '-c', 'import sys;sys.stdout.buffer.write(' + repr(output) + ')'], timeout_s=3)
