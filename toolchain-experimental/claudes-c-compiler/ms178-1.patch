+fn call_target(sym: &super::elf_read::Symbol, s: u64, ctx: &RelocContext) -> u64 {
+    if sym.name.is_empty() || sym.binding() == STB_LOCAL {
+        return s;
+    }
+    if let Some(&plt_addr) = ctx.plt_sym_addrs.get(sym.name.as_str()) {
+        return plt_addr;
+    }
