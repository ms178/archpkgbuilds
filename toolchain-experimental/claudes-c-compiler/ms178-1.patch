+            for inst in &b.instructions {
+                inst.for_each_used_value(|u| {
+                    if u == 3 {
+                        users += 1;
+                    }
+                });
+            }
+            b.terminator.for_each_used_value(|u| {
+                if u == 3 {
+                    users += 1;
+                }
+            });
+        }
+        assert_eq!(users, 0, "multiply fully replaced");
+    }
+
+    /// A dead `iv * C` earns no recurrence.
