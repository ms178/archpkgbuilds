+    Benchmark("zstd_double_fast", "Zstandard double-fast match search / dual hash tables",
+              ("zstd_double_fast.c",), ("workload", "zstd", "compression", "memory")),
 )
 
 
diff --git a/tests/regression/check_builtin_float_aliases.py b/tests/regression/check_builtin_float_aliases.py
new file mode 100755
index 000000000..dab58b806
--- /dev/null
+++ b/tests/regression/check_builtin_float_aliases.py
@@ -0,0 +1,359 @@
+#!/usr/bin/env python3
+"""Pin the `__builtin_<fn>f` aliases against the compiler that defines the class.
+
+# The defect this gate exists for
+
+lccc's `BuiltinKind::LibcAlias` table maps `__builtin_X` to the libc symbol `X`
+so a program written against GCC can call `__builtin_fmax` without including
+`<math.h>`. GCC offers the float spelling `__builtin_Xf` wherever it offers
+`__builtin_X`; lccc had added the *long double* siblings (`fmaxl`, `fminl`)
+while missing three of the float ones (`fmaxf`, `fminf`, `log2f`).
+
+The failure mode is quiet, which is why it needs a gate rather than a note. An
+unmapped `__builtin_fmaxf` parses as an **implicit function declaration**:
+
+  * lccc warns and continues (a warning, not an error);
+  * the emitted call targets the literal symbol `__builtin_fmaxf`, which no
+    libc defines, so the link fails pointing at the *object* rather than at the
+    missing table entry;
+  * where the diagnostic is ignored, the call's return type is `int`, so the
+    float result arrives as an integer conversion of `%eax` -- a silently wrong
+    value instead of a missing symbol.
+
+# Why the class is derived, not listed
+
+A hand-written list is the artefact that drifts; the drift is what caused the
+defect. The class is derived on every run from two authorities:
+
+  1. `src/frontend/sema/builtins.rs` -- the mappings lccc ships, parsed for
+     `BuiltinInfo::simple("<libc>")` entries whose libc name is a bare
+     identifier without an `f`/`l` suffix;
+  2. `gcc-16 -fsyntax-only` -- whether `__builtin_<libc>f` exists in the
+     reference compiler, and with what arity (probed, not assumed: `log2f` takes
+     one argument, `fmaxf` takes two, and passing doubles to a float parameter
+     would compare the wrong thing).
+
+For every derived pair, lccc must accept the spelling with
+`-Werror=implicit-function-declaration` (so "warned and continued" fails), must
+not leave the builtin name in the emitted assembly, and the runtime behaviour of
+the float spellings -- including both NaN operand orders -- must be
+bit-identical to GCC 16.2.
+
+# Anti-vacuity
+
+A name no compiler defines must fail lccc's `-Werror` probe, and must fail with
+an *implicit declaration* diagnostic specifically. If it passes, or fails for
+another reason, this gate is not testing what it claims and exits non-zero
+regardless of everything else.
+
+Usage:
+    check_builtin_float_aliases.py [--lccc PATH] [--gcc gcc-16] [--verbose]
+
+Exit status:
+    0  every derived pair is mapped, no builtin name survives, runtime matches
+    1  a pair is missing, a builtin name survived, the runtime differs, or the
+       control probe did not behave (the gate is broken, not the compiler)
+    2  a prerequisite is missing (lccc binary, gcc-16, sources)
+"""
+from __future__ import annotations
+
+import argparse
+import re
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[2]
+BUILTINS_RS = REPO / "src/frontend/sema/builtins.rs"
+
+# Prefixes whose `<name>f` spelling is a libm float function. Kept broad: the
+# GCC probe below discards everything that is not a real builtin, and a name
+# that is missed here can only make the gate *weaker*, never produce a false
+# failure -- except for `check_candidate_count`, which refuses a suspiciously
+# small derivation for exactly that reason.
+_SHAPE = re.compile(r'BuiltinInfo::simple\("([A-Za-z_][A-Za-z0-9_]*)"\)')
+
+
+def candidate_libc_names(source: str) -> list[str]:
+    """Libc names from `simple()` mappings that have a float sibling to probe."""
+    names = {match for match in _SHAPE.findall(source)}
+    # `fmax` -> probe `__builtin_fmaxf`. The long-double forms (`fmaxl`) and
+    # already-float names (`fabsf`) have no such sibling.
+    return sorted(name for name in names if not name.endswith(("f", "l")))
+
+
+def _gcc(gcc: str, program: str) -> tuple[bool, str]:
+    with tempfile.NamedTemporaryFile("w", suffix=".c", delete=False) as handle:
+        handle.write(program)
+        path = handle.name
+    try:
+        result = subprocess.run(
+            [gcc, "-fsyntax-only", "-x", "c", path],
+            capture_output=True, text=True)
+        return result.returncode == 0, result.stderr
+    finally:
+        Path(path).unlink(missing_ok=True)
+
+
+def gcc_arity(gcc: str, builtin: str) -> int | None:
+    """Arity of `builtin` according to the reference compiler.
+
+    Probed rather than tabulated: the answer decides how the lccc probe has to
+    call it, and a wrong arity would test the diagnostic for the arity instead
+    of the mapping.
+    """
+    for arity in (1, 2, 3):
+        args = ", ".join(["1.0"] * arity)
+        if _gcc(gcc, f"double f(double a);\n"
+                     f"double probe(void) {{ return (double){builtin}({args}); }}\n")[0]:
+            return arity
+    return None
+
+
+def lccc_probe(lccc: str, builtin: str, arity: int) -> tuple[bool, str, str]:
+    """Compile one call with lccc; implicit declarations are errors here."""
+    params = ", ".join(f"float a{i}" for i in range(arity))
+    args = ", ".join(f"a{i}" for i in range(arity))
+    body = (f"float probe({params}) {{ return (float){builtin}({args}); }}\n"
+            f"double probe_d(double d) {{ (void)d; return 0.0; }}\n")
+    with tempfile.TemporaryDirectory() as directory:
+        src = Path(directory) / "probe.c"
+        src.write_text(body)
+        result = subprocess.run(
+            [lccc, "-O2", "-S", "-Werror=implicit-function-declaration",
+             "-x", "c", str(src), "-o", "-"],
+            capture_output=True, text=True)
+        return result.returncode == 0, result.stderr, result.stdout
+
+
+RUNTIME_PROGRAM = r"""
+#include <math.h>
+#include <stdio.h>
+
+/* For every operand pair below the program prints
+ *     <case> <builtin result> <libc reference result>
+ * so the gate can ask two separate questions:
+ *
+ *  1. does lccc's builtin spelling agree with the libc function it names?
+ *     (that is the mapping contract, and it is checked on EVERY case);
+ *  2. do lccc and GCC agree with each other? (checked on every case whose
+ *     answer is not a signed zero -- see the note below).
+ *
+ * The reference is taken through a function POINTER so no compiler can fold,
+ * inline or constant-propagate the call: this is the library's answer.
+ *
+ * Signed zero is deliberately its own case group. glibc's fmax/fmin are
+ * comparison-based (`x >= y ? x : y`), so fmax(-0,+0) is -0 and fmin(-0,+0) is
+ * +0, while a compiler that inlines a `maxss`-style lowering answers +0 / -0 --
+ * the Annex F answer. GCC 16.2 inlines and answers +0/-0; lccc calls glibc and
+ * answers -0/+0. Both are defensible and neither is the other's bug, so the
+ * gate pins each compiler to the LIBRARY it binds to (question 1) and does not
+ * demand that a call and an inline expansion produce the same zero sign.
+ */
+static float (*ref_fmaxf)(float, float) = fmaxf;
+static float (*ref_fminf)(float, float) = fminf;
+static double (*ref_fmax)(double, double) = fmax;
+static double (*ref_fmin)(double, double) = fmin;
+
+int main(void) {
+    volatile float nf = __builtin_nanf(""), inf_f = __builtin_inff();
+    volatile double nd = __builtin_nan(""), inf_d = __builtin_inf();
+    volatile float mzf = -0.0f, pzf = 0.0f, one_f = 1.0f, two_f = 2.0f;
+    volatile float den_f = 1e-40f, neg_f = -2.5f;
+    volatile double mzd = -0.0, pzd = 0.0, one_d = 1.0, two_d = 2.0;
+    volatile double den_d = 1e-310, neg_d = -2.5;
+
+#define CASE_F(name, x, y) \
+    printf("%s %.17g %.17g\n", name, (double)__builtin_fmaxf(x, y), (double)ref_fmaxf(x, y)); \
+    printf("%s %.17g %.17g\n", name "|min", (double)__builtin_fminf(x, y), (double)ref_fminf(x, y))
+#define CASE_D(name, x, y) \
+    printf("%s %.17g %.17g\n", name, __builtin_fmax(x, y), ref_fmax(x, y)); \
+    printf("%s %.17g %.17g\n", name "|min", __builtin_fmin(x, y), ref_fmin(x, y))
+
+    CASE_F("ord-f", one_f, two_f);
+    CASE_F("ord-f-rev", two_f, one_f);
+    CASE_F("neg-f", neg_f, one_f);
+    CASE_F("den-f", den_f, one_f);
+    CASE_F("nan-f-a", nf, one_f);
+    CASE_F("nan-f-b", one_f, nf);
+    CASE_F("inf-f", inf_f, one_f);
+    CASE_F("zerof", mzf, pzf);
+    CASE_D("ord-d", one_d, two_d);
+    CASE_D("ord-d-rev", two_d, one_d);
+    CASE_D("neg-d", neg_d, one_d);
+    CASE_D("den-d", den_d, one_d);
+    CASE_D("nan-d-a", nd, one_d);
+    CASE_D("nan-d-b", one_d, nd);
+    CASE_D("inf-d", inf_d, one_d);
+    CASE_D("zerod", mzd, pzd);
+    /* log2f is the third name this gate was written for; compare against libc
+       too, so the float spelling is exercised on a non-NaN-symmetric op. */
+    printf("log2f %.17g %.17g\n", (double)__builtin_log2f(3.0f), (double)log2f(3.0f));
+    return 0;
+}
+"""
+
+
+def runtime_differential(lccc: str, gcc: str) -> tuple[bool, str]:
+    with tempfile.TemporaryDirectory() as directory:
+        src = Path(directory) / "rt.c"
+        src.write_text(RUNTIME_PROGRAM)
+        outputs = {}
+        for name, compiler in (("lccc", lccc), ("gcc", gcc)):
+            binary = Path(directory) / f"rt.{name}"
+            # -lm is part of the contract under test, not an incidental flag:
+            # the mappings resolve to libm symbols and libm is a separate DSO
+            # on glibc, so a run that cannot link them proves nothing.
+            build = subprocess.run([compiler, "-O2", str(src), "-o", str(binary), "-lm"],
+                                   capture_output=True, text=True)
+            if build.returncode != 0:
+                return False, f"{name} build failed:\n{build.stderr.strip()}"
+            run = subprocess.run([str(binary)], capture_output=True, text=True)
+            if run.returncode != 0:
+                return False, f"{name} run exited {run.returncode}"
+            outputs[name] = run.stdout
+        return adjudicate(outputs["lccc"], outputs["gcc"])
+
+
+ZERO_SIGN_CASES = ("zerof", "zerod")
+
+
+def adjudicate(lccc_out: str, gcc_out: str) -> tuple[bool, str]:
+    """Two independent questions, asked in the documented order.
+
+    1. lccc's builtin spelling must agree with the libc function it names, for
+       every case. The reference column is a real library call through a
+       function pointer, so this compares the *mapping*, not two inline
+       expansions.
+    2. lccc and GCC must agree with each other, except on the signed-zero cases,
+       where glibc and an Annex F inline expansion legitimately differ (the
+       program's header comment says which answers each gives).
+    """
+    def rows(text: str) -> dict[str, tuple[float, float]]:
+        out = {}
+        for line in text.splitlines():
+            parts = line.split()
+            if len(parts) != 3:
+                continue
+            out[parts[0]] = (float(parts[1]), float(parts[2]))
+        return out
+
+    mine, theirs = rows(lccc_out), rows(gcc_out)
+    if set(mine) != set(theirs):
+        return False, f"case sets differ: {sorted(set(mine) ^ set(theirs))}"
+    problems = []
+    for name, (builtin, reference) in mine.items():
+        if not _same(builtin, reference):
+            problems.append(f"{name}: lccc builtin {builtin!r} != libc {reference!r}")
+        elif name in ZERO_SIGN_CASES or name.endswith("|min") and name[:-4] in ZERO_SIGN_CASES:
+            continue
+        elif not _same(builtin, theirs[name][0]):
+            problems.append(f"{name}: lccc {builtin!r} != gcc {theirs[name][0]!r}")
+    if problems:
+        return False, "\n  ".join(problems)
+    return True, lccc_out.strip()
+
+
+def _same(a: float, b: float) -> bool:
+    """Bit-identical, with NaN == NaN and the sign of zero preserved."""
+    import math
+    import struct
+    if math.isnan(a) and math.isnan(b):
+        return True
+    return struct.pack("<d", a) == struct.pack("<d", b)
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("--lccc", default=str(REPO / "target/fastbuild/lccc"))
+    parser.add_argument("--gcc", default="gcc-16")
+    parser.add_argument("--verbose", action="store_true")
+    args = parser.parse_args(argv)
+
+    lccc = Path(args.lccc)
+    if not lccc.is_file():
+        print(f"check_builtin_float_aliases: no lccc binary at {lccc}", file=sys.stderr)
+        return 2
+    if not BUILTINS_RS.is_file():
+        print(f"check_builtin_float_aliases: missing {BUILTINS_RS}", file=sys.stderr)
+        return 2
+    try:
+        version = subprocess.run([args.gcc, "--version"], capture_output=True, text=True)
+    except FileNotFoundError:
+        print(f"check_builtin_float_aliases: {args.gcc} not on PATH; the class "
+              "cannot be derived without the reference compiler", file=sys.stderr)
+        return 2
+    if version.returncode != 0:
+        print(f"check_builtin_float_aliases: {args.gcc} --version failed", file=sys.stderr)
+        return 2
+
+    # ---- anti-vacuity control ----------------------------------------------
+    control = "__builtin_lccc_not_a_real_builtin_xyz"
+    accepted, stderr, _ = lccc_probe(str(lccc), control, 1)
+    if accepted:
+        print("check_builtin_float_aliases: SELF-CHECK FAILED -- lccc accepted "
+              f"{control}, so an unmapped builtin would not be detected",
+              file=sys.stderr)
+        return 1
+    if "implicit declaration" not in stderr:
+        print("check_builtin_float_aliases: SELF-CHECK FAILED -- the control "
+              f"failed for the wrong reason:\n{stderr.strip()}", file=sys.stderr)
+        return 1
+
+    # ---- derive the class ---------------------------------------------------
+    pairs: list[tuple[str, str, int]] = []
+    for libc in candidate_libc_names(BUILTINS_RS.read_text()):
+        builtin = f"__builtin_{libc}f"
+        arity = gcc_arity(args.gcc, builtin)
+        if arity is not None:
+            pairs.append((builtin, f"{libc}f", arity))
+    if len(pairs) < 10:
+        print(f"check_builtin_float_aliases: derived only {len(pairs)} pairs; the "
+              "table parse or the oracle probe has drifted", file=sys.stderr)
+        return 1
+    if args.verbose:
+        print(f"derived {len(pairs)} __builtin_<fn>f pairs from {args.gcc}")
+
+    # ---- check every derived pair -------------------------------------------
+    failures: list[str] = []
+    inlined = 0
+    for builtin, libc_name, arity in pairs:
+        accepted, stderr, asm = lccc_probe(str(lccc), builtin, arity)
+        if not accepted:
+            detail = stderr.strip().splitlines()
+            failures.append(f"{builtin}: not mapped (implicit declaration)"
+                            + (f"\n    {detail[0]}" if detail else ""))
+            continue
+        if builtin in asm:
+            failures.append(f"{builtin}: the builtin name survived into the "
+                            f"assembly instead of {libc_name}")
+        elif libc_name not in asm:
+            # Inlined to an instruction (`sqrtss` for `sqrtf`) is legitimate and
+            # is reported, not failed: the assertion is about the mapping, not
+            # about how it is lowered.
+            inlined += 1
+            if args.verbose:
+                print(f"note {builtin}: lowered inline, no {libc_name} call")
+
+    # ---- runtime differential for the float spellings ------------------------
+    ok, detail = runtime_differential(str(lccc), args.gcc)
+    if not ok:
+        failures.append(f"runtime differential: {detail}")
+
+    if failures:
+        for failure in failures:
+            print(f"FAIL {failure}")
+        print(f"check_builtin_float_aliases: {len(failures)} failure(s)")
+        return 1
+    print(f"check_builtin_float_aliases: PASS ({len(pairs)} derived pairs, "
+          f"{inlined} lowered inline; every builtin agrees with the libc "
+          f"function it names, and with {args.gcc} on every non-signed-zero "
+          "case)")
+    if args.verbose:
+        print(detail)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tests/regression/check_ci_link_oracle_provisioning.py b/tests/regression/check_ci_link_oracle_provisioning.py
new file mode 100644
index 000000000..735082e59
--- /dev/null
+++ b/tests/regression/check_ci_link_oracle_provisioning.py
@@ -0,0 +1,422 @@
+#!/usr/bin/env python3
+"""Provision the differential linker oracles under PATH stubs: no root, apt or
+network effects.
+
+The step this script replaced was a bare pair of apt lines duplicated six times
+in `.github/workflows/ci.yml`:
+
+    sudo apt-get update
+    sudo apt-get install -y --no-install-recommends mold lld
+
+Hosted mirrors answer 5xx and reset connections under load, transiently, so
+that step failed on a warm mirror and red-failed the job at step 8 of 21,
+skipping the build and the whole test suite with it. A network blip therefore
+presented as a compiler defect. The suite below pins the behaviours that make
+the scripted replacement safe, and the last class pins the workflow itself so
+the six bare copies cannot quietly come back.
+
+The stub models the apt behaviours that decide the design, both observed on
+real runners:
+
+* ``apt-get update`` can exit non-zero on a transient index fetch failure that
+  a retry resolves.
+* a zero exit from ``apt-get update`` does not prove a package is resolvable;
+  apt warns and carries on. Resolution is therefore keyed on
+  ``apt-cache pkgnames``, never on the exit status.
+"""
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[2]
+SCRIPT = ROOT / "scripts/ci_install_link_oracles.sh"
+WORKFLOW = ROOT / ".github/workflows/ci.yml"
+
+ORACLE_PACKAGES = ("mold", "lld")
+# What tests/linker/run_linker_tests.py puts on PATH once both are installed.
+ORACLE_BINARIES = ("mold", "ld.lld")
+
+MOCK = r'''
+import os, pathlib, sys
+
+state = pathlib.Path(os.environ['MOCK_STATE'])
+state.mkdir(parents=True, exist_ok=True)
+name = pathlib.Path(sys.argv[0]).name
+args = sys.argv[1:]
+with open(os.environ['MOCK_LOG'], 'a') as handle:
+    handle.write(__import__('json').dumps([name, *args]) + '\n')
+
+index_names = set(os.environ.get('INDEX_PACKAGES', 'mold lld').split())
+bin_dir = pathlib.Path(os.environ['MOCK_BIN'])
+mock_path = pathlib.Path(os.environ['MOCK'])
+
+
+def path(relative):
+    return state / relative
+
+
+def bump(relative):
+    target = path(relative)
+    count = int(target.read_text()) if target.exists() else 0
+    count += 1
+    target.write_text(str(count))
+    return count
+
+
+def budget(key):
+    value = os.environ.get(key)
+    return int(value) if value else 0
+
+
+def option(arguments, key):
+    prefix = key + '='
+    for position, value in enumerate(arguments):
+        if (value == '-o' and position + 1 < len(arguments)
+                and arguments[position + 1].startswith(prefix)):
+            return arguments[position + 1][len(prefix):]
+        if value.startswith(prefix):
+            return value[len(prefix):]
+    return None
+
+
+def subcommand(arguments):
+    # Options may precede the subcommand (`apt-cache -o KEY=VALUE pkgnames`).
+    position = 0
+    while position < len(arguments):
+        value = arguments[position]
+        if value == '-o':
+            position += 2
+            continue
+        if value.startswith('-'):
+            position += 1
+            continue
+        return value, arguments[position + 1:]
+    return None, []
+
+
+def lists_dir(arguments):
+    return pathlib.Path(option(arguments, 'Dir::State::lists') or (state / 'lists'))
+
+
+def published(arguments):
+    """The names apt would actually resolve from the index this call reads."""
+    marker = lists_dir(arguments) / '.index'
+    return set(marker.read_text().split()) if marker.exists() else set()
+
+
+def publish_index(arguments):
+    lists = lists_dir(arguments)
+    lists.mkdir(parents=True, exist_ok=True)
+    (lists / '.index').write_text(' '.join(sorted(index_names)))
+
+
+def install_binary(binary):
+    target = bin_dir / binary
+    if target.is_symlink() or target.exists():
+        target.unlink()
+    target.symlink_to(mock_path)
+
+
+def attempt_within(limit):
+    return bool(limit) and int(path('.installs').read_text()) <= limit
+
+
+if name == 'sudo':
+    if args and args[0] == '--':
+        args.pop(0)
+    os.execvp(args[0], args)
+elif name == 'uname':
+    print(os.environ.get('MOCK_UNAME', 'Linux'))
+elif name == 'apt-cache':
+    command, rest = subcommand(args)
+    pattern = rest[-1] if rest else ''
+    if command == 'pkgnames':
+        for candidate in sorted(published(args)):
+            if candidate.startswith(pattern):
+                print(candidate)
+elif name == 'apt-get':
+    verb, _ = subcommand(args)
+    if verb == 'update':
+        if bump('.updates') <= budget('UPDATE_FAILURES'):
+            print('E: Failed to fetch http://mirror/InRelease  503  Service Unavailable')
+            sys.exit(100)
+        publish_index(args)
+        sys.exit(0)
+    if verb == 'install':
+        bump('.installs')
+        missing = [package for package in ORACLE_PACKAGES
+                   if package not in published(args)]
+        if missing:
+            for package in missing:
+                print('E: Unable to locate package %s' % package)
+            sys.exit(100)
+        if attempt_within(budget('INSTALL_FAILURES')):
+            print('E: Failed to fetch http://mirror/pool/main/m/mold/mold.deb  '
+                  '503  Service Unavailable')
+            sys.exit(100)
+        if os.environ.get('INSTALL_LEAVES_BINARY_MISSING') != '1':
+            for binary in ORACLE_BINARIES:
+                install_binary(binary)
+        sys.exit(0)
+elif name in ('mold', 'ld.lld', 'lld'):
+    print({'mold': 'mold 2.42.1 (compatible with GNU ld)',
+           'ld.lld': 'LLD 23.1.3 (compatible with GNU linkers)',
+           'lld': 'lld'}[name])
+'''
+
+
+class LinkOracleProvisioningTests(unittest.TestCase):
+    def setUp(self):
+        self.directory = Path(tempfile.mkdtemp(prefix="lccc-link-oracles-"))
+        self.addCleanup(shutil.rmtree, self.directory, ignore_errors=True)
+
+    def invoke(self, oracles_present=False, uid=0, **overrides):
+        """Run the script against the stub. Returns (result, commands)."""
+        mock = self.directory / "mock"
+        mock.write_text(f"#!{sys.executable}\n"
+                        + f"ORACLE_PACKAGES = {list(ORACLE_PACKAGES)!r}\n"
+                        + f"ORACLE_BINARIES = {list(ORACLE_BINARIES)!r}\n"
+                        + MOCK)
+        mock.chmod(0o755)
+
+        bin_dir = self.directory / "bin"
+        bin_dir.mkdir()
+        for command in ("sudo", "uname", "apt-get", "apt-cache"):
+            (bin_dir / command).symlink_to(mock)
+        # The oracles are deliberately ABSENT from PATH unless the case asks
+        # for them: presence is the whole fast-path contract under test.
+        if oracles_present:
+            for binary in ORACLE_BINARIES:
+                (bin_dir / binary).symlink_to(mock)
+
+        # Bash's readonly EUID cannot be assigned. Change exactly the branch
+        # expression in this temporary copy; never add a production switch
+        # that could bypass privilege checks.
+        text = SCRIPT.read_text()
+        self.assertEqual(text.count("(( EUID == 0 ))"), 1)
+        script = self.directory / "helper.sh"
+        script.write_text(text.replace("(( EUID == 0 ))", "(( MOCK_EUID == 0 ))"))
+
+        log = self.directory / "log"
+        env = {**os.environ,
+               "PATH": f"{bin_dir}:{os.defpath}",
+               "MOCK_LOG": str(log),
+               "MOCK_STATE": str(self.directory / "state"),
+               "MOCK_BIN": str(bin_dir),
+               "MOCK": str(mock),
+               "MOCK_EUID": str(uid),
+               "LCCC_CI_APT_RETRY_DELAY": "0",
+               **overrides}
+        result = subprocess.run(["bash", str(script)], env=env, text=True,
+                                capture_output=True, timeout=120)
+        commands = ([json.loads(line) for line in log.read_text().splitlines()]
+                    if log.exists() else [])
+        return result, commands
+
+    @staticmethod
+    def updates(commands):
+        return [c for c in commands if c[:2] == ["apt-get", "update"]]
+
+    @staticmethod
+    def installs(commands):
+        return [c for c in commands if c[:2] == ["apt-get", "install"]]
+
+    def test_clean_install_succeeds(self):
+        result, commands = self.invoke()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(len(self.updates(commands)), 1)
+        self.assertEqual(len(self.installs(commands)), 1)
+        self.assertIn("differential linker oracles ready", result.stdout)
+
+    def test_already_installed_never_touches_the_network(self):
+        """The warm-runner fast path: present oracles must cost no apt call."""
+        result, commands = self.invoke(oracles_present=True)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual([c for c in commands if c[0] in ("apt-get", "apt-cache")],
+                         [], "a warm runner must not re-provision")
+
+    def test_transient_index_503_is_retried_until_it_resolves(self):
+        """The exact failure this script exists to absorb."""
+        result, commands = self.invoke(UPDATE_FAILURES="2")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(len(self.updates(commands)), 3)
+        self.assertEqual(len(self.installs(commands)), 1,
+                         "install must wait for a usable index")
+        self.assertIn("failed (exit 100, attempt 1/3)", result.stderr)
+
+    def test_transient_download_failure_is_retried(self):
+        result, commands = self.invoke(INSTALL_FAILURES="1")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(len(self.installs(commands)), 2)
+
+    def test_retry_budget_is_bounded(self):
+        """A permanently broken mirror must fail, not hang the lane."""
+        result, commands = self.invoke(UPDATE_FAILURES="99")
+        self.assertEqual(result.returncode, 1)
+        self.assertLessEqual(len(self.installs(commands)), 3)
+
+    def test_unresolvable_packages_fail_closed(self):
+        """An index without the oracles must not be papered over."""
+        result, commands = self.invoke(INDEX_PACKAGES="gcc-16 clang-23")
+        self.assertEqual(result.returncode, 1)
+        self.assertIn("cannot resolve 'mold lld'", result.stderr)
+        self.assertEqual(self.installs(commands), [],
+                         "never install against an index that lacks the names")
+
+    def test_apt_success_without_the_binary_fails_closed(self):
+        """run_linker_tests.py skips an absent oracle, so a half install would
+        silently narrow the differential coverage instead of failing."""
+        result, _ = self.invoke(INSTALL_LEAVES_BINARY_MISSING="1")
+        self.assertEqual(result.returncode, 1)
+        self.assertIn("not on PATH", result.stderr)
+
+    def test_non_linux_is_a_usage_error(self):
+        result, commands = self.invoke(MOCK_UNAME="Darwin")
+        self.assertEqual(result.returncode, 2)
+        self.assertEqual(commands[0][0], "uname")
+        self.assertNotIn("apt-get", [c[0] for c in commands])
+
+    def test_bad_retry_delay_is_rejected(self):
+        result, _ = self.invoke(LCCC_CI_APT_RETRY_DELAY="soon")
+        self.assertEqual(result.returncode, 2)
+        self.assertIn("must be a non-negative integer", result.stderr)
+
+    def test_index_options_are_threaded_to_probe_and_install(self):
+        """The resolvability probe must read the same index the install uses,
+        or a cached index reads as 'unresolvable' for a package apt can
+        install offline."""
+        archive = self.directory / "archive"
+        result, commands = self.invoke(LCCC_CI_APT_ARCHIVE_DIR=str(archive))
+        self.assertEqual(result.returncode, 0, result.stderr)
+        expected = f"Dir::State::lists={archive}/lists"
+        probes = [c for c in commands if c[0] == "apt-cache"]
+        self.assertTrue(probes, "the resolvability probe must run")
+        for call in probes + self.installs(commands):
+            self.assertIn("-o", call)
+            self.assertIn(expected, call, f"missing index option in {call}")
+        self.assertTrue((archive / "lists").is_dir())
+
+
+class WorkflowUsesTheScriptTests(unittest.TestCase):
+    """The regression that mattered: six bare copies, any one of which could
+    red-fail a lane and skip every gate below it."""
+
+    @classmethod
+    def setUpClass(cls):
+        cls.text = WORKFLOW.read_text()
+
+    def test_no_bare_apt_install_of_the_linker_oracles_remains(self):
+        offenders = [line.strip() for line in self.text.splitlines()
+                     if "apt-get install" in line
+                     and ("mold" in line or "lld" in line)]
+        self.assertEqual(offenders, [],
+                         "every linker-oracle install must go through "
+                         "scripts/ci_install_link_oracles.sh")
+
+    def test_one_provisioning_entry_point_owns_every_lane(self):
+        """Every lane provisions through ci_provision_toolchain.sh.
+
+        The six per-job copies are gone, so the property worth pinning is no
+        longer "each step calls the retrying script" -- there are no per-job
+        steps left -- but that no lane re-opens a private apt path beside the
+        single entry point. A lane that installs an oracle itself is a lane
+        whose provisioning cannot be cached, retried or verified with the rest.
+        """
+        provisioning = self.text.count("scripts/ci_provision_toolchain.sh")
+        self.assertGreater(provisioning, 0,
+                           "expected at least one lane to provision a toolchain")
+        # Mentions inside a cache key (hashFiles) are provenance, not a step:
+        # only an *executed* line re-creates the per-job path.
+        offenders = [line.strip() for line in self.text.splitlines()
+                     if line.strip().startswith("bash scripts/ci_install_")]
+        self.assertEqual(
+            offenders, [],
+            "these steps bypass ci_provision_toolchain.sh: "
+            f"{offenders} -- the packaged oracle set must have one owner, or no "
+            "lane shares its cache, retries or verification")
+
+    def test_provisioning_delegates_the_linker_oracle_pair(self):
+        """ci_provision_toolchain.sh hands mold+lld to the retrying installer.
+
+        Behavioural, not textual: the provisioning script is run against stubs
+        for every privileged command, and the log says which installer it
+        reached. That way a future refactor that quietly reverts the pair to a
+        bare apt line fails here instead of in a hosted lane at step 8 of 21.
+        """
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            scripts = root / "scripts"
+            scripts.mkdir()
+            shutil.copy2(ROOT / "scripts/ci_provision_toolchain.sh", scripts)
+            log = root / "log"
+            stub = "#!/bin/sh\nprintf '%s\\n' \"$(basename \"$0\") $*\" >> " + str(log) + "\n"
+            for name in ("ci_install_gcc16.sh", "ci_install_link_oracles.sh",
+                         "ci_toolchain_bundle.sh"):
+                (scripts / name).write_text(stub)
+            bin_dir = root / "bin"
+            bin_dir.mkdir()
+            for name in ("apt-get", "apt-cache", "dpkg-query", "sudo"):
+                path = bin_dir / name
+                # `sudo <cmd>` must still be logged under the command it runs.
+                if name == "sudo":
+                    # `sudo -- cmd ...`: the separator is sudo's own syntax,
+                    # not an argument of the command being escalated.
+                    path.write_text(
+                        "#!/bin/sh\n"
+                        "[ \"$1\" = \"--\" ] && shift\n"
+                        "exec \"$@\"\n")
+                else:
+                    path.write_text(stub)
+                path.chmod(0o755)
+
+            def run(extras):
+                log.unlink(missing_ok=True)
+                return subprocess.run(
+                    ["bash", str(scripts / "ci_provision_toolchain.sh"),
+                     "--no-bundle", "--extras", extras],
+                    text=True, capture_output=True,
+                    env={**os.environ, "PATH": f"{bin_dir}:{os.environ['PATH']}",
+                         "LCCC_CI_APT_RETRY_DELAY": "0"}), \
+                    (log.read_text().splitlines() if log.exists() else [])
+
+            # The default lane request: both oracles delegated, the rest apt.
+            result, calls = run("mold lld python3-yaml")
+            self.assertEqual(result.returncode, 0, result.stderr)
+            joined = "\n".join(calls)
+            self.assertIn("ci_install_link_oracles.sh", joined,
+                          "the linker-oracle pair must go through the retrying "
+                          f"installer; calls were:\n{joined}")
+            apt = [c for c in calls if c.startswith("apt-get install")]
+            self.assertTrue(apt, f"the non-oracle extras must still install:\n{joined}")
+            for call in apt:
+                self.assertNotIn("mold", call)
+                self.assertNotIn("lld", call)
+                self.assertIn("python3-yaml", call)
+
+            # A partial request is not the installer's contract (it promises
+            # BOTH binaries), so it stays on apt.
+            result, calls = run("mold")
+            self.assertEqual(result.returncode, 0, result.stderr)
+            joined = "\n".join(calls)
+            self.assertNotIn("ci_install_link_oracles.sh", joined,
+                             "a single-oracle request must not claim the pair "
+                             f"contract; calls were:\n{joined}")
+            self.assertIn("mold", "\n".join(c for c in calls
+                                            if c.startswith("apt-get install")))
+
+    def test_script_is_executable_and_parses(self):
+        self.assertTrue(os.access(SCRIPT, os.X_OK), "the script must be executable")
+        check = subprocess.run(["bash", "-n", str(SCRIPT)], text=True,
+                               capture_output=True)
+        self.assertEqual(check.returncode, 0, check.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
