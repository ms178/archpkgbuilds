+/// implement it directly.
+pub trait HomeMap {
+    /// The home of value `id`, if isel may use it.
+    fn get(&self, id: &u32) -> Option<&PhysReg>;
+
+    fn contains_key(&self, id: &u32) -> bool {
+        self.get(id).is_some()
+    }
