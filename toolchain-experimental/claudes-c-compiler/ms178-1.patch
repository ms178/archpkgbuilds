+        for info in &struct_info {
+            match info {
+                Some((size, align, classes)) => {
+                    struct_arg_sizes.push(Some(*size));
+                    struct_arg_aligns.push(Some(*align));
+                    struct_arg_classes.push(classes.clone());
+                }
+                None => {
