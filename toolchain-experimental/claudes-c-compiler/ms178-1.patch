diff --git a/tests/regression/builtin_llabs_overrides_user.c b/tests/regression/builtin_llabs_overrides_user.c
new file mode 100644
index 0000000..3403c45
--- /dev/null
+++ b/tests/regression/builtin_llabs_overrides_user.c
@@ -0,0 +1,19 @@
+/* gcc.c-torture/execute/20021127-1.c
+ *
+ * With -fbuiltin (LCCC default), calls to llabs use the builtin even when
+ * the user later defines llabs. The user body aborts; the call must not
+ * reach it. */
+long long a = -1;
+long long llabs(long long);
+void abort(void);
+
+int main(void) {
+    if (llabs(a) != 1)
+        abort();
+    return 0;
+}
+
+long long llabs(long long b) {
+    abort();
+    return b;
+}
