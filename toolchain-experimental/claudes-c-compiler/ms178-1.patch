+        // Step 4: retarget the extension and delete the relay copy.
+        let new_inst = format!("    movslq %{}, %{}", src32, relay_dst);
+        replace_line(store, &mut infos[i], i, new_inst);
+        mark_nop(&mut infos[j]);
+        changed = true;
+        i = j + 1;
+    }
+    changed
+}
