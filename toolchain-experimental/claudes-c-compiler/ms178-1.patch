+}
+void two_streams(const uint32_t *restrict a, const uint32_t *restrict b,
+                 uint32_t *restrict d, uint32_t *restrict e) {
+  for (int i = 0; i < 4; i++) { d[i] = a[i] + b[i]; e[i] = a[i] - b[i]; }
