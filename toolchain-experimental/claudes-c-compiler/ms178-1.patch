diff --git a/tests/regression/pclmul_intrinsic_lane.c b/tests/regression/pclmul_intrinsic_lane.c
new file mode 100644
index 0000000000000000000000000000000000000000..80ca56cd4a59563bd33456a67d9bc89783f5b891
--- /dev/null
+++ b/tests/regression/pclmul_intrinsic_lane.c
@@ -0,0 +1,17 @@
+/* Raptor Lake intrinsic regression: validates actual PCLMULQDQ emission and
+   lane selection, not merely preprocessor macro exposure. */
+#include <stdint.h>
+#include <stdio.h>
+#include <x86intrin.h>
+
+int main(void) {
+    __m128i a = _mm_set_epi64x(0x1d9513d7LL, 0x8f352d95LL);
+    __m128i b = _mm_set_epi64x(0x1db710641LL, 0x1f7011641LL);
+    __m128i product = _mm_clmulepi64_si128(a, b, 0x00);
+    uint64_t lanes[2];
+    _mm_storeu_si128((__m128i_u *)lanes, product);
+    printf("%016llx %016llx\n", (unsigned long long)lanes[1],
+           (unsigned long long)lanes[0]);
+    return lanes[1] != UINT64_C(0)
+        || lanes[0] != UINT64_C(0xf1da085658df66d5);
+}
diff --git a/tests/regression/raptorlake_crypto_features.c b/tests/regression/raptorlake_crypto_features.c
new file mode 100644
index 0000000000000000000000000000000000000000..a807e1d6b4afdbc6fc6c6e0ad9e3d8fddfddb426
--- /dev/null
+++ b/tests/regression/raptorlake_crypto_features.c
@@ -0,0 +1,20 @@
+/* Compile this test with -march=raptorlake.  It verifies both macro exposure
+   and target-bound __builtin_cpu_supports folding used by gzip's CRC dispatch. */
+#if !defined(__AVX2__)
+# error "Raptor Lake profile must expose __AVX2__"
+#endif
+#if !defined(__AES__)
+# error "Raptor Lake profile must expose __AES__"
+#endif
+#if !defined(__PCLMUL__)
+# error "Raptor Lake profile must expose __PCLMUL__"
+#endif
+#if defined(__AVX512F__)
+# error "Raptor Lake profile must not assume AVX-512"
+#endif
+
+int main(void) {
+    return !(__builtin_cpu_supports("avx")
+             && __builtin_cpu_supports("aes")
+             && __builtin_cpu_supports("pclmul"));
+}
diff --git a/tests/regression/run_regression.sh b/tests/regression/run_regression.sh
new file mode 100755
index 0000000000000000000000000000000000000000..e8966393e29cdcf1b404c3351b77300be78f1c9f
--- /dev/null
+++ b/tests/regression/run_regression.sh
@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+# Compile+run the CCC regression suite. Each test returns 0 on success.
+# Usage: run_regression.sh [--compare-gcc]
+set -u
+CCC=${CCC:-./target/release/lccc}
+CCCFLAGS=${CCCFLAGS:--O2}
+COMPARE_GCC=0
+[ "${1:-}" = "--compare-gcc" ] && COMPARE_GCC=1
+dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+pass=0; fail=0
+for src in "$dir"/*.c; do
+  name=$(basename "$src" .c)
+  # This source intentionally asserts the explicit Raptor Lake target contract.
+  # Keep all other regressions profile-neutral.
+  extra_flags=""
+  case "$name" in
+    raptorlake_crypto_features|pclmul_intrinsic_lane) extra_flags="-march=raptorlake" ;;
+  esac
+  if $CCC $CCCFLAGS $extra_flags "$src" -o "/tmp/ccc_${name}" 2>/tmp/ccc_err.txt; then
+    /tmp/ccc_${name} >/tmp/ccc_out.txt 2>&1; rc=$?
+    if [ $rc -eq 0 ]; then
+      if [ "$COMPARE_GCC" = 1 ]; then
+        if command -v gcc >/dev/null && gcc -O2 "$src" -o /tmp/gcc_${name} 2>/dev/null \
+           && /tmp/gcc_${name} >/tmp/gcc_out.txt 2>&1 \
+           && diff -q /tmp/ccc_out.txt /tmp/gcc_out.txt >/dev/null; then
+          echo "PASS  $name"; pass=$((pass+1))
+        else echo "MISMATCH $name"; fail=$((fail+1)); fi
+      else echo "PASS  $name"; pass=$((pass+1)); fi
+    else echo "FAIL  $name (run rc=$rc) out=[$(cat /tmp/ccc_out.txt)]"; fail=$((fail+1)); fi
+  else echo "FAIL  $name compile: $(tail -1 /tmp/ccc_err.txt)"; fail=$((fail+1)); fi
+done
+echo "=== Regression: $pass passed, $fail failed ==="
+[ $fail -eq 0 ]
