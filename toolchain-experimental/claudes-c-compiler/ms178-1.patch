+            "mmx" => 1,
+            "sse" => 2,
+            "sse2" => 3,
+            "sse3" => 5,
+            "ssse3" => 6,
+            "sse4a" => 8,
+            "sse4.1" | "sse4_1" => 10,
+            "sse4.2" | "sse4_2" => 11,
+            "popcnt" => 13,
+            "aes" => 15,
