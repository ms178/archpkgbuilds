+    /// The type of subobject `index` of `ty` (see `initializer_slot_count`).
+    fn initializer_slot_type(&self, ty: &CType, index: usize) -> Option<CType> {
+        match ty {
+            CType::Array(elem, _) => Some((**elem).clone()),
