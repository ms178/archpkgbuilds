+        let mut tj: FxHashMap<u32, Operand> = FxHashMap::default();
+        for p in &phis {
+            if p.id == iv_phi.0 {
+                continue;
+            }
+            let threaded = subst_back(&p.back, &vmaps[j - 1], &thread[j - 1]);
+            tj.insert(p.id, threaded);
+        }
+        thread.push(tj);
+    }
