+        if slp_changes > 0 {
+            crate::passes::dce::eliminate_dead_code(func);
+        }
+        return slp_changes;
+    }
+
+    let cfg = CfgAnalysis::build(func);
+    let loop_changes =
+        vectorize_with_analysis_mode(func, &cfg, false, false, fp_reassoc, fp_contract);
+    let changes = preconv + slp_changes + loop_changes;
