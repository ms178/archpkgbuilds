+        assert_eq!(hex("nop.s"), hex("nop"));
+        assert_eq!(hex("adcb.s %dl, (%rax)"), hex("adcb %dl, (%rax)"));
+        assert_eq!(hex("adcl.s (%rax), %ecx"), "13 08");
+        assert_eq!(hex("vpcmpeqb.s %xmm1, %xmm2, %xmm3"), "c5 e9 74 d9");
