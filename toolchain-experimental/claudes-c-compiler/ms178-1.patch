From 2aef49e3763d5d655e679331def751e0fcd0c690 Mon Sep 17 00:00:00 2001
From: lccc-agent <agent@arena.invalid>
Date: Sun, 25 Oct 2026 00:49:38 +0000
Subject: [PATCH 17/66] vectorize: scale predicate mask sums by 255's inverse
 mod 2^64

The predicate byte count sums raw 0xFF lanes and must divide the total
by 255. The sum is an exact multiple of 255 that cannot wrap u64 (at most
255 * 2^56 lanes), so multiplying by 255^-1 mod 2^64 (0xFEFEFEFEFEFEFEFF,
checked at compile time) is exact: one imul instead of the mul-high/shift
sequence a UDiv lowers to, and no %rdx clobber.
---
 src/passes/vectorize.rs                | 15 ++++++++++++---
 src/passes/vectorize_byte_sum_tests.rs | 22 ++++++++++++++++++++++
 2 files changed, 34 insertions(+), 3 deletions(-)

diff --git a/src/passes/vectorize.rs b/src/passes/vectorize.rs
index 49b03902c..8be7c4975 100644
--- a/src/passes/vectorize.rs
+++ b/src/passes/vectorize.rs
@@ -11189,6 +11189,10 @@ fn byte_sum_bottom_test_packed_loop(
     2
 }
 
+/// The inverse of 255 modulo 2^64 (`0xFEFE_FEFE_FEFE_FEFF`).
+const INV_255_MOD_2_64: i64 = 0xFEFE_FEFE_FEFE_FEFFu64 as i64;
+const _: () = assert!(255u64.wrapping_mul(INV_255_MOD_2_64 as u64) == 1);
+
 /// Inputs of the vector-exit block (see `byte_sum_exit_insts`).
 struct ByteSumExit {
     /// The packed partial sum, after any correction.
@@ -11255,7 +11259,12 @@ fn byte_sum_exit_insts(
         },
     });
     if e.mask_sum {
-        // 255 per counted lane: an exact division.
+        // 255 per counted lane, so the division is EXACT: `h_raw` is
+        // 255 * count with no u64 wrap (count < 2^64 / 255), and an exact
+        // division is a multiplication by the divisor's inverse mod 2^64
+        // (255 * 0xFEFE_FEFE_FEFE_FEFF == 1 mod 2^64).  One `imul` by a
+        // `movabs` constant instead of `mulq` + `shrq $7`, which also
+        // clobbered %rdx.
         let counted = if e.complement {
             count_fresh(next_val_id)
         } else {
@@ -11263,9 +11272,9 @@ fn byte_sum_exit_insts(
         };
         insts.push(Instruction::BinOp {
             dest: counted,
-            op: IrBinOp::UDiv,
+            op: IrBinOp::Mul,
             lhs: Operand::Value(h_raw),
-            rhs: Operand::Const(IrConst::I64(255)),
+            rhs: Operand::Const(IrConst::I64(INV_255_MOD_2_64)),
             ty: IrType::I64,
         });
         if e.complement {
diff --git a/src/passes/vectorize_byte_sum_tests.rs b/src/passes/vectorize_byte_sum_tests.rs
index d655ca4b5..9278f36e5 100644
--- a/src/passes/vectorize_byte_sum_tests.rs
+++ b/src/passes/vectorize_byte_sum_tests.rs
@@ -911,6 +911,28 @@ fn predicate_counts_sum_the_raw_mask() {
             assert_eq!(cmps, want_cmps, "{ctx}: compare predicates");
             assert_eq!(ors, want_ors, "{ctx}: mask ORs");
             assert_eq!(ands, 0, "{ctx}: a packed `& 1` survived");
+            // The mask sum is scaled out by an exact division: one multiply
+            // by 255's inverse mod 2^64, never a real division.
+            let insts = || f.blocks.iter().flat_map(|b| &b.instructions);
+            assert!(
+                insts().any(|i| matches!(i, Instruction::BinOp {
+                    op: IrBinOp::Mul, rhs: Operand::Const(IrConst::I64(k)), ..
+                } if *k as u64 == 0xFEFE_FEFE_FEFE_FEFF)),
+                "{ctx}: no exact-division multiply"
+            );
+            // (The signed vector-end `SDiv` by the lane count is the trip
+            // computation, not the mask scaling.)
+            assert!(
+                !insts().any(|i| matches!(
+                    i,
+                    Instruction::BinOp {
+                        op: IrBinOp::UDiv | IrBinOp::SDiv,
+                        rhs: Operand::Const(c),
+                        ..
+                    } if c.to_i64() == Some(255)
+                )),
+                "{ctx}: a division by 255 survived"
+            );
         }
     }
     set_isa(false);
