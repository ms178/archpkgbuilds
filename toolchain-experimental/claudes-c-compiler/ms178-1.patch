+
+    // ── encode_cinv : SP/WSP + FP/SIMD ────────────────────────────────────
+    #[test]
+    fn cinv_rejects_sp_wsp_in_any_position(
+        n in 0u32..=30, pos in 0u32..2u32, vi in 0u32..=1u32,
