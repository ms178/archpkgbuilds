+    /// %r9 and the loop dereferenced garbage.
+    fn slq_relay_lines(pin_copy: bool) -> (LineStore, Vec<LineInfo>) {
+        let asm = concat!(
+            "f:\n",
+            ".cfi_startproc\n",
+            "    movslq %edi, %r9\n",
+            "    movq %r9, %rbx\n",
+            "    shlq $2, %rbx\n",
+            "    leaq array0(%rip), %r9\n",
+            "    movq %rbx, %rax\n",
+            "    ret\n",
+            ".cfi_endproc\n",
+        );
