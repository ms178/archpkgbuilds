+int hook(void);
+#ifdef SHARED_IMPORT_MAIN
+int greet(const char *s);
+int hook(void)
+{
+    return 2;
+}
+int main(void)
+{
+    return greet("world") != 16; /* "hello world 5 N\n" */
+}
+#else
+int hook(void)
+{
+    return 1;
+}
+int greet(const char *s)
+{
+    return printf("hello %s %zu %d\n", s, strlen(s), hook());
