+        assert!(!out.contains("shlq"), "{out}");
+    }
+
+    #[test]
+    fn refuses_to_cross_a_cqto_implicit_read() {
+        let out = run(&[
+            "shlq $3, %rax",
+            "cqto",
+            "addq %rax, %r9",
+            "movq %r9, %rax",
+            "ret",
+        ]);
+        assert!(
+            out.contains("shlq $3, %rax"),
