+/// Forward an adjacent extending reload from the low bytes of a private
+/// frame-slot store. Preserve the store: global dead-store analysis decides
+/// whether it has other readers. Exact adjacency excludes clobbers, joins and
+/// stack movement; pinned/escaped/volatile accesses remain untouched.
+fn forward_adjacent_extending_reload(
+    store: &mut LineStore,
+    infos: &mut [LineInfo],
+    i: usize,
+) -> bool {
+    if i + 1 >= store.len() || infos[i].pinned || infos[i + 1].pinned || infos[i + 1].is_nop() {
+        return false;
+    }
+    let LineKind::StoreRbp { reg, size, .. } = infos[i].kind else {
+        return false;
+    };
+    if !is_valid_gp_reg(reg) || matches!(reg, 4 | 5) {
+        return false;
+    }
+    let load = infos[i + 1].trimmed(store.get(i + 1));
+    let Some((mnemonic, args)) = load.split_once(char::is_whitespace) else {
+        return false;
+    };
+    let (read_size, dest_size) = match mnemonic {
+        "movzbl" | "movsbl" => (MoveSize::B, MoveSize::L),
+        "movzbq" | "movsbq" => (MoveSize::B, MoveSize::Q),
+        "movzwl" | "movswl" => (MoveSize::W, MoveSize::L),
+        "movzwq" | "movswq" => (MoveSize::W, MoveSize::Q),
+        "movslq" => (MoveSize::L, MoveSize::Q),
+        _ => return false,
+    };
+    if !matches!(size, MoveSize::B | MoveSize::W | MoveSize::L | MoveSize::Q)
+        || size.byte_size() < read_size.byte_size()
+    {
+        return false;
+    }
+    let Some((load_mem, dest)) = split_two_operands(args) else {
+        return false;
+    };
+    let dst = register_family_fast(dest);
+    if !is_valid_gp_reg(dst) || matches!(dst, 4 | 5) || dest != reg_id_to_name(dst, dest_size) {
+        return false;
+    }
+    let text = infos[i].trimmed(store.get(i));
+    let Some((_, args)) = text.split_once(char::is_whitespace) else {
+        return false;
+    };
+    let Some((source, store_mem)) = split_two_operands(args) else {
+        return false;
+    };
+    // Compare the complete address, not fast-parsed displacement integers.
+    // High-byte stores (%ah etc.) do not contain the family's low byte.
+    if source != reg_id_to_name(reg, size)
+        || load_mem != store_mem
+        || parse_frame_slot(store_mem, size.byte_size() as i64).is_none()
+    {
+        return false;
+    }
+    // Boolean spill/extension/test chains have a stronger compare-to-branch
+    // fusion later in the pipeline, including a final raw-text pass. Keep
+    // their memory relay visible to that proof instead of hiding its slot
+    // census with a register extension. This is an ordering/profitability
+    // refusal, not permission to erase a signed self-extension.
+    if let Some(next) = ((i + 2)..store.len()).find(|&j| !infos[j].is_nop()) {
+        if matches!(
+            infos[next]
+                .trimmed(store.get(next))
+                .split_whitespace()
+                .next(),
+            Some("testb" | "testw" | "testl" | "testq")
+        ) {
+            return false;
+        }
+    }
+    let replacement = format!(
+        "    {} {}, {}",
+        mnemonic,
+        reg_id_to_name(reg, read_size),
+        dest
+    );
+    replace_line(store, &mut infos[i + 1], i + 1, replacement);
+    true
+}
