+// CHECK-LABEL: define dso_local float @quibble(
+// CHECK-SAME: ) #[[ATTR0]] {
+// CHECK-NEXT:  [[ENTRY:.*:]]
+// CHECK-NEXT:    [[BUFFER:%.*]] = alloca [12 x i8], align 4
+// CHECK-NEXT:    [[T_PTR:%.*]] = alloca ptr, align 8
+// CHECK-NEXT:    [[S_PTR:%.*]] = alloca ptr, align 8
