+    let mut f = fixture(IrType::F64);
+    for n in 10..15 {
+        f.blocks[1].instructions.push(Instruction::Phi {
+            dest: Value(n),
+            ty: IrType::F64,
+            incoming: vec![(number(IrType::F64, 0.0), BlockId(0)), (v(n), BlockId(30))],
+        });
+    }
+    unchanged(f);
+}
