+    if plain_gp_operand(use_src) != Some(dst_fam) {
+        return None;
+    }
+    let read_w = operand_width(use_src)?;
+    let tier = match read_w {
+        64 => 0,
+        32 => 1,
+        16 => 2,
+        8 => 3,
+        _ => return None,
