+        match ty {
+            IrType::I32 if udivisor <= i32::MAX as u64 => {
+                if !gen_map && max_x < udivisor.saturating_mul(2) {
+                    let ge = fresh_value(next_id);
+                    let diff = fresh_value(next_id);
+                    return Some(vec![
+                        Instruction::Cmp {
+                            dest: ge,
+                            op: IrCmpOp::Sge,
