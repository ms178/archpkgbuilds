+/// `flags_are_block_local` for the function containing `n`, computed at most
+/// once per consumer scan and cached in `cache`. Only ever consulted when the
+/// scan is about to stop having already seen a consumer, so straight-line
+/// candidates never pay for it.
+fn flags_block_local_cached(
+    store: &LineStore,
+    infos: &[LineInfo],
+    n: usize,
+    cache: &mut Option<bool>,
+) -> bool {
+    if let Some(v) = *cache {
+        return v;
+    }
+    let v = function_range(store, infos, n)
+        .map(|(fs, fe)| flags_are_block_local(store, infos, fs, fe))
+        .unwrap_or(false);
+    *cache = Some(v);
+    v
+}
