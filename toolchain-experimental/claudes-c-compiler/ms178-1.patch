+    }
+
+    #[test]
+    fn pointer_to_pointer_qualifies_inner_only() {
+        let mut t = ptr(ptr(base()));
+        apply_decl_address_space_to_spec(&mut t, AddressSpace::SegGs);
+        assert_eq!(outer_space(&t), Some(AddressSpace::Default));
