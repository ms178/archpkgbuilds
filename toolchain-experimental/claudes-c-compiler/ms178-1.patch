+        if r.returncode == 0 or want_s not in r.stderr.decode():
+            problems.append(f"section: rc={r.returncode} stderr={r.stderr.decode()[:200]!r}")
+        gnu = sh(["ld", "-pie", "-e", "get_str", "s.o", "-o", "bad2.gnu"], cwd=td)
