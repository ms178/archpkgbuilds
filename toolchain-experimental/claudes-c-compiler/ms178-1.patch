+                self.avx_load_arg_to(&args[1], "ymm1"); // a (src1 = dst)
+                self.avx_load_arg_to(&args[2], "ymm2"); // b (src2)
+                self.state
+                    .emit_fmt(format_args!("    {} %ymm0, %ymm2, %ymm1, %ymm1", inst));
+                self.avx_store_dest(dest_ptr);
