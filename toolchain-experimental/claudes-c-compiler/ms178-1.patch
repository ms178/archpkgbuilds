+/*
+ * SIMD implementation audit reproducers — 2026-11-08, base `b19f76f`
+ * (backlog.md §9c).  One file, one kernel per finding, self-checking where
+ * the arithmetic is exact and differential (candidate -O2 vs scalar
+ * reference build) otherwise.
+ *
+ * These are *failing reproducers for open findings*, not passing tests.
+ * Each kernel documents the backlog item (SA-xx) it reproduces, the flags
+ * it needs, and what "fixed" looks like.  `check_audit_2026-11-08.py` is
+ * the driver; it knows which rows are expected to fail while the finding
+ * is open, so the pack is CI-safe today and a ratchet the day a fix lands.
+ *
+ * Kernels
+ *   sa02_pair_f64 / sa02_pair_f32 / sa02_quad_f64   SA-02 (P0, SLP FMA
+ *       sign flip): store pairs/quad of `x[i]*k - z[i]` lanes (multiply on
+ *       the lhs).  The SLP packed-FMA contraction computes `z - x*k`
+ *       instead.  Inputs are powers of two so fused and unfused evaluation
+ *       are bit-identical — any mismatch is the sign flip, not rounding.
+ *       Flags: -O2 -mfma (default -ffp-contract=fast).  Fixed = PASS.
+ *   sa02_ctl_pair_f64                                control for SA-02:
+ *       the mirrored orientation `z[i] - x[i]*k` (multiply on the rhs) is
+ *       already handled correctly and must stay correct.
+ *   sa05_maddubs512_memfold                          SA-05 (P0, 512-bit
+ *       maddubs memory-fold operand swap): first argument arrives from
+ *       _mm512_loadu_si512 (the memory-foldable side).  Flags:
+ *       -O2 -mavx512bw.  Fixed = PASS.
+ *   sa06_chacha_bypass                               SA-06 (P0-candidate,
+ *       vec_arx exit materialization): array-spelling ChaCha20 double
+ *       round with a preheader-dominated error path that mutates the
+ *       state array and jumps to the common exit.  If vec_arx transforms
+ *       the loop, the exit materialization writes the preheader-time
+ *       lanes over the mutation.  Differential row (needs the -O0
+ *       reference build).  Fixed = candidate == reference.
+ *   sa07_chacha_ret_word                             SA-07 (ICE class,
+ *       arx_vectorize word-phi deletion): phi-spelling ChaCha20 double
+ *       round whose result word leaves the function through `return j;`
+ *       (a terminator use of a word phi).  Differential row.  Fixed =
+ *       compiles and candidate == reference.
+ *   sa01_dot2                                        SA-01 (asm-only row):
+ *       two independent dot-product accumulators.  Compiled with
+ *       `-O2 -mavx2 -mno-fma -ffast-math -S` the assembly must contain no
+ *       `vfmadd` (today it does — the multi-reduction arm skips the FMA
+ *       ISA gate).  The kernel itself is correct at every opt level.
+ *   sa03/sa04/sa13/sa33                              asm/diagnostic rows
+ *       driven entirely from the checker script (they need dedicated
+ *       flag sets or .s input); no runtime kernel here.
+ *
+ * Style: C99, no dependencies beyond the bundled headers, every kernel
+ * noinline, expected values either absolute constants or computed by
+ * de-optimized scalar reference code in the same binary.
+ */
+#include <stdio.h>
+#include <string.h>
+#include <immintrin.h>
+
+typedef unsigned int u32;
+typedef unsigned char u8;
+
+#define ROTL32(v, n) (((v) << (n)) | ((v) >> (32 - (n))))
+
+#define QR(a, b, c, d) \
+  do { \
+    a += b; d ^= a; d = ROTL32(d, 16); \
+    c += d; b ^= c; b = ROTL32(b, 12); \
+    a += b; d ^= a; d = ROTL32(d, 8);  \
+    c += d; b ^= c; b = ROTL32(b, 7);  \
+  } while (0)
+
+/* ------------------------------------------------------------------ */
+/* SA-02 — SLP packed-FMA contraction sign flip                        */
+/* ------------------------------------------------------------------ */
+
+/* Powers of two: 1.5*4-3 = 3, 2.5*4-5 = 5 — exact in binary64, exact in
+ * binary32, and identical fused or unfused.  The buggy contraction
+ * computes 3-6 = -3 and 5-10 = -5. */
+static const double sa02_x_f64[4] = { 1.5, 2.5, 3.5, 4.5 };
+static const double sa02_z_f64[4] = { 3.0, 5.0, 7.0, 9.0 };
+static const float  sa02_x_f32[4] = { 1.5f, 2.5f, 3.5f, 4.5f };
+static const float  sa02_z_f32[4] = { 3.0f, 5.0f, 7.0f, 9.0f };
+static const double sa02_k = 4.0;
+
+__attribute__((noinline))
+static void sa02_pair_f64(double *restrict r, const double *restrict x,
+                          const double *restrict z, double k)
+{
+    r[0] = x[0] * k - z[0];
+    r[1] = x[1] * k - z[1];
+}
+
+__attribute__((noinline))
+static void sa02_pair_f32(float *restrict r, const float *restrict x,
+                          const float *restrict z, float k)
+{
+    r[0] = x[0] * k - z[0];
+    r[1] = x[1] * k - z[1];
+    r[2] = x[2] * k - z[2];
+    r[3] = x[3] * k - z[3];
+}
+
+__attribute__((noinline))
+static void sa02_quad_f64(double *restrict r, const double *restrict x,
+                          const double *restrict z, double k)
+{
+    r[0] = x[0] * k - z[0];
+    r[1] = x[1] * k - z[1];
+    r[2] = x[2] * k - z[2];
+    r[3] = x[3] * k - z[3];
+}
+
+/* Control: the mirrored (multiply-on-the-rhs) orientation is already
+ * handled correctly by the contraction and must remain so. */
+__attribute__((noinline))
+static void sa02_ctl_pair_f64(double *restrict r, const double *restrict x,
+                              const double *restrict z, double k)
+{
+    r[0] = z[0] - x[0] * k;
+    r[1] = z[1] - x[1] * k;
+}
+
+static int sa02_check(void)
+{
+    double d[4];
+    float f[4];
+    int bad = 0;
+
+    sa02_pair_f64(d, sa02_x_f64, sa02_z_f64, sa02_k);
+    if (d[0] != 3.0 || d[1] != 5.0) {
+        printf("sa02_pair_f64 MISMATCH got {%.17g, %.17g} want {3, 5}\n",
+               d[0], d[1]);
+        bad = 1;
+    } else {
+        printf("sa02_pair_f64 ok\n");
+    }
+
+    sa02_pair_f32(f, sa02_x_f32, sa02_z_f32, (float)sa02_k);
+    if (f[0] != 3.0f || f[1] != 5.0f || f[2] != 7.0f || f[3] != 9.0f) {
+        printf("sa02_pair_f32 MISMATCH got {%.9g, %.9g, %.9g, %.9g} "
+               "want {3, 5, 7, 9}\n", (double)f[0], (double)f[1],
+               (double)f[2], (double)f[3]);
+        bad = 1;
+    } else {
+        printf("sa02_pair_f32 ok\n");
+    }
+
+    sa02_quad_f64(d, sa02_x_f64, sa02_z_f64, sa02_k);
+    if (d[0] != 3.0 || d[1] != 5.0 || d[2] != 7.0 || d[3] != 9.0) {
+        printf("sa02_quad_f64 MISMATCH got {%.17g, %.17g, %.17g, %.17g} "
+               "want {3, 5, 7, 9}\n", d[0], d[1], d[2], d[3]);
+        bad = 1;
+    } else {
+        printf("sa02_quad_f64 ok\n");
+    }
+
+    sa02_ctl_pair_f64(d, sa02_x_f64, sa02_z_f64, sa02_k);
+    if (d[0] != -3.0 || d[1] != -5.0) {
+        printf("sa02_ctl_pair_f64 MISMATCH got {%.17g, %.17g} "
+               "want {-3, -5}\n", d[0], d[1]);
+        bad = 1;
+    } else {
+        printf("sa02_ctl_pair_f64 ok\n");
+    }
+    return bad;
+}
+
+/* ------------------------------------------------------------------ */
+/* SA-05 — _mm512_maddubs_epi16 memory-fold operand swap               */
+/* ------------------------------------------------------------------ */
+
+#if defined(__AVX512F__) && defined(__AVX512BW__)
+static void sa05_fill(unsigned char *a, unsigned char *w)
+{
+    int i;
+    for (i = 0; i < 64; i++) {
+        a[i] = 0xFFu; /* unsigned 255 */
+        w[i] = 0x02u; /* signed +2    */
+    }
+}
+
+static short sa05_ref(const unsigned char *a, const signed char *w, int pair)
+{
+    /* C reference with the exact vpmaddubsw semantics: a unsigned, w
+     * signed, saturating to int16. */
+    int p0 = (int)(unsigned char)a[2 * pair] * (int)w[2 * pair]
+           + (int)(unsigned char)a[2 * pair + 1] * (int)w[2 * pair + 1];
+    if (p0 > 32767) p0 = 32767;
+    if (p0 < -32768) p0 = -32768;
+    return (short)p0;
+}
+
+__attribute__((noinline))
+static __m512i sa05_maddubs512_memfold(const void *p, __m512i w)
+{
+    __m512i a = _mm512_loadu_si512(p);
+    return _mm512_maddubs_epi16(a, w);
+}
+
+static int sa05_check(void)
+{
+    unsigned char abuf[64], wbuf[64];
+    short got[32];
+    int i, bad = 0;
+
+    sa05_fill(abuf, wbuf);
+    __m512i w = _mm512_loadu_si512(wbuf);
+    /* The volatile read keeps the first argument's source in memory so the
+     * codegen memory-fold arm (the buggy one) is the path taken. */
+    const unsigned char * volatile pv = abuf;
+    __m512i r = sa05_maddubs512_memfold(pv, w);
+    _mm512_storeu_si512(got, r);
+
+    for (i = 0; i < 32; i++) {
+        short want = sa05_ref(abuf, (const signed char *)wbuf, i);
+        if (got[i] != want) {
+            printf("sa05_maddubs512_memfold MISMATCH lane %d got %d "
+                   "want %d\n", i, (int)got[i], (int)want);
+            bad = 1;
+            break;
+        }
+    }
+    if (!bad) {
+        printf("sa05_maddubs512_memfold ok\n");
+    }
+    return bad;
+}
+#else
+static int sa05_check(void)
+{
+    printf("sa05_maddubs512_memfold skipped (no AVX512F+BW)\n");
+    return 0;
+}
+#endif
+
+/* ------------------------------------------------------------------ */
+/* SA-06 — vec_arx exit materialization vs bypass-path writes          */
+/*                                                                     */
+/* Array-spelling ChaCha20 double round (the memory-form shape vec_arx */
+/* recognizes), with an error path *dominated by the preheader* that   */
+/* mutates one state word and jumps to the common exit.  The exit      */
+/* materialization unconditionally stores the preheader-time lanes,    */
+/* so the mutation is silently reverted.                               */
+/* ------------------------------------------------------------------ */
+
+static const u32 sa06_in[16] = {
+    0x61707865u, 0x3320646eu, 0x79622d32u, 0x6b206574u,
+    0x03020100u, 0x07060504u, 0x0b0a0908u, 0x0f0e0d0cu,
+    0x13121110u, 0x17161514u, 0x1b1a1918u, 0x1f1e1d1cu,
+    0x00000001u, 0x09000000u, 0x4a000000u, 0x00000000u
+};
+
+__attribute__((noinline))
+static u32 sa06_chacha_bypass(int err)
+{
+    u32 x[16];
+    int i, r;
+    u32 acc;
+
+    for (i = 0; i < 16; i++)
+        x[i] = sa06_in[i];
+
+    if (err) {
+        x[3] ^= 0xdeadu;
+        goto out;
+    }
+
+    for (r = 0; r < 10; r++) {
+        /* Column round */
+        QR(x[0], x[4], x[8],  x[12]);
+        QR(x[1], x[5], x[9],  x[13]);
+        QR(x[2], x[6], x[10], x[14]);
+        QR(x[3], x[7], x[11], x[15]);
+        /* Diagonal round */
+        QR(x[0], x[5], x[10], x[15]);
+        QR(x[1], x[6], x[11], x[12]);
+        QR(x[2], x[7], x[8],  x[13]);
+        QR(x[3], x[4], x[9],  x[14]);
+    }
+
+out:
+    /* Feed-forward walk with a variable offset (keeps the array an
+     * alloca — the shape vec_arx is built for) folded into a checksum. */
+    acc = 0;
+    for (i = 0; i < 16; i++)
+        acc = acc * 31u + (x[i] + sa06_in[i]);
+    return acc;
+}
+
+/* ------------------------------------------------------------------ */
+/* SA-07 — arx_vectorize word-phi deletion vs terminator uses          */
+/*                                                                     */
+/* Phi-spelling double round whose 13th word leaves through the        */
+/* function's `return` terminator — the use the pre-scan never scans.  */
+/* ------------------------------------------------------------------ */
+
+__attribute__((noinline))
+static u32 sa07_chacha_ret_word(void)
+{
+    u32 a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p;
+    int t;
+
+    a = sa06_in[0];  b = sa06_in[1];  c = sa06_in[2];  d = sa06_in[3];
+    e = sa06_in[4];  f = sa06_in[5];  g = sa06_in[6];  h = sa06_in[7];
+    i = sa06_in[8];  j = sa06_in[9];  k = sa06_in[10]; l = sa06_in[11];
+    m = sa06_in[12]; n = sa06_in[13]; o = sa06_in[14]; p = sa06_in[15];
+
+    for (t = 0; t < 10; t++) {
+        QR(a, e, i, m); QR(b, f, j, n); QR(c, g, k, o); QR(d, h, l, p);
+        QR(a, f, k, p); QR(b, g, l, m); QR(c, h, i, n); QR(d, e, j, o);
+    }
+
+    return j;
+}
+
+/* ------------------------------------------------------------------ */
+/* SA-01 — multi-accumulator dot product (asm-only check)              */
+/* ------------------------------------------------------------------ */
+
+__attribute__((noinline))
+static void sa01_dot2(int n, const float *restrict a, const float *restrict b,
+                      const float *restrict c, const float *restrict d,
+                      float *restrict r1, float *restrict r2)
+{
+    float s1 = 0.0f, s2 = 0.0f;
+    int i;
+    for (i = 0; i < n; i++) {
+        s1 += a[i] * b[i];
+        s2 += c[i] * d[i];
+    }
+    *r1 = s1;
+    *r2 = s2;
+}
+
+/* ------------------------------------------------------------------ */
+
+int main(int argc, char **argv)
+{
+    int bad = 0;
+
+    if (argc > 1 && strcmp(argv[1], "sa02") == 0) {
+        return sa02_check();
+    }
+    if (argc > 1 && strcmp(argv[1], "sa05") == 0) {
+        return sa05_check();
+    }
+    if (argc > 1 && strcmp(argv[1], "sa01") == 0) {
+        float fa[64], fb[64], fc[64], fd[64], r1, r2;
+        int i;
+        for (i = 0; i < 64; i++) {
+            fa[i] = (float)(i % 7) * 0.25f;
+            fb[i] = (float)(i % 5) * 0.5f;
+            fc[i] = (float)(i % 3) * 0.125f;
+            fd[i] = (float)(i % 11) * 0.75f;
+        }
+        sa01_dot2(64, fa, fb, fc, fd, &r1, &r2);
+        printf("sa01_dot2 %.9g %.9g\n", (double)r1, (double)r2);
+        return 0;
+    }
+    if (argc > 1 && strcmp(argv[1], "sa06") == 0) {
+        printf("sa06_chacha_bypass err0 %08x\n", sa06_chacha_bypass(0));
+        printf("sa06_chacha_bypass err1 %08x\n", sa06_chacha_bypass(1));
+        return 0;
+    }
+    if (argc > 1 && strcmp(argv[1], "sa07") == 0) {
+        printf("sa07_chacha_ret_word %08x\n", sa07_chacha_ret_word());
+        return 0;
+    }
+
+    /* default: everything (the checker script drives the per-kernel entry
+     * points above for its differential rows). */
+    bad |= sa02_check();
+    bad |= sa05_check();
+    printf("sa06_chacha_bypass err0 %08x\n", sa06_chacha_bypass(0));
+    printf("sa06_chacha_bypass err1 %08x\n", sa06_chacha_bypass(1));
+    printf("sa07_chacha_ret_word %08x\n", sa07_chacha_ret_word());
+    return bad;
+}
diff --git a/tests/simd/check_audit_2026-11-08.py b/tests/simd/check_audit_2026-11-08.py
new file mode 100644
index 0000000..c6bfef0
--- /dev/null
+++ b/tests/simd/check_audit_2026-11-08.py
@@ -0,0 +1,340 @@
+#!/usr/bin/env python3
+"""Fail-closed driver for the 2026-11-08 SIMD audit reproducer pack.
+
+Every row is tied to a backlog.md §9c item and carries the status the
+backlog claims for it: rows tagged ``open`` (the finding is unfixed) are
+expected to FAIL today, control rows are expected to PASS.  In default
+mode the exit code is nonzero only for a control row that fails
+(REGRESSION), an ``error`` row (infrastructure: reference compiler
+failure, unusable flag set, unexpected output shape), or a ``STALE-OPEN``
+row (backlog says broken, build says fixed — reconcile the register or
+flip the row's tag).  A failing open row reports ``OPEN-CONFIRMED`` and is
+a report, not a failure.  ``--strict`` inverts the open rows: every one
+must now pass (the post-fix validation mode, and the mode CI should adopt
+once the §9c register is empty — a compiler without the findings, e.g.
+GCC pointed at via ``--lccc``, is strict-green).
+
+    python3 tests/simd/check_audit_2026-11-08.py --lccc target/fastbuild/lccc
+    python3 tests/simd/check_audit_2026-11-08.py --strict
+
+Rows (kernel source: audit_repro_2026-11-08.c unless stated):
+  sa02          runtime self-check, -O2 -mfma                open  SA-02
+  sa05          runtime self-check, -O2 -mavx512bw           open  SA-05
+  sa06          differential candidate -O2 vs gcc -O0        open  SA-06
+  sa07          differential candidate -O2 vs gcc -O0        open  SA-07
+                (an lccc ICE while compiling the candidate is an accepted
+                failure mode for this row — the finding is the ICE class)
+  sa01_asm      asm shape, -O2 -mavx2 -mno-fma -ffast-math   open  SA-01
+  sa03_asm      asm shape, -O2 -mavx (512-bit load/store)    open  SA-03
+  sa04_diag     must-diagnose, -mavx512f without BW         open  SA-04
+  sa13_asm      integrated assembler rejects xmm vinserti128 open  SA-13
+  sa33_asm      vzeroupper before calls after EVEX insert   open  SA-33
+
+A failing ``open`` row reports OPEN-CONFIRMED (the reproducer proves the
+finding on this build); a passing ``open`` row reports STALE-OPEN.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+from pathlib import Path
+import shlex
+import signal
+import subprocess
+import tempfile
+
+from aos_pair_shapes import ProbeError, compiler, run
+
+SOURCE = Path(__file__).with_name('audit_repro_2026-11-08.c').resolve()
+
+SA03_TU = r'''#include <immintrin.h>
+__attribute__((noinline)) __m512i load512(const void *p) {
+    return _mm512_loadu_si512(p);
+}
+__attribute__((noinline)) void store512(void *p, __m512i v) {
+    _mm512_storeu_si512(p, v);
+}
+'''
+
+SA04_TU = r'''#include <immintrin.h>
+__attribute__((noinline)) __m512i shuflo(__m512i v) {
+    return _mm512_shufflelo_epi16(v, 0x4E);
+}
+'''
+
+SA33_TU = r'''#include <immintrin.h>
+void g(void);
+__attribute__((noinline)) __m512i ins(__m512i a, __m128i b) {
+    return _mm512_inserti32x4(a, b, 1);
+}
+__attribute__((noinline)) void f(__m512i a, __m128i b) {
+    g();
+    (void)ins(a, b);
+    g();
+}
+'''
+
+SA13_ASM = '''\
+.text
+.globl sa13_probe
+sa13_probe:
+    vinserti128 $1, %xmm1, %xmm2, %xmm3
+    ret
+'''
+
+# name, kind, candidate flags, expected-while-open, backlog item, ice_ok
+ROWS = [
+    ('sa02', 'runtime', ['-O2', '-mfma'], 'open', 'SA-02', False),
+    ('sa05', 'runtime', ['-O2', '-mavx512bw'], 'open', 'SA-05', False),
+    ('sa06', 'diff', ['-O2'], 'open', 'SA-06', False),
+    ('sa07', 'diff', ['-O2'], 'open', 'SA-07', True),
+]
+
+
+class Result:
+    """pass / fail / skip / error, with a one-line detail."""
+
+    def __init__(self, kind: str, detail: str = '') -> None:
+        self.kind = kind
+        self.detail = detail
+
+    def __str__(self) -> str:
+        return self.kind if not self.detail else f'{self.kind}: {self.detail}'
+
+
+def _trim(text: str, limit: int = 100) -> str:
+    first = text.strip().splitlines()[0] if text.strip() else ''
+    return first[:limit]
+
+
+def _allow_fail(command: list[str], cwd: Path,
+                timeout: float) -> tuple[int, str, str]:
+    """Run a command, tolerating nonzero exit (a probe may legitimately
+    crash); signals are reported through the return code."""
+    p = subprocess.Popen(command, cwd=cwd, stdout=subprocess.PIPE,
+                         stderr=subprocess.PIPE, text=True,
+                         start_new_session=True)
+    try:
+        out, err = p.communicate(timeout=timeout)
+    except subprocess.TimeoutExpired:
+        try:
+            os.killpg(p.pid, signal.SIGKILL)
+        except ProcessLookupError:
+            pass
+        p.communicate()
+        raise ProbeError(f'{shlex.join(command)}: timeout')
+    return p.returncode, out, err
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--lccc', default='target/fastbuild/lccc')
+    parser.add_argument('--reference', default='gcc')
+    parser.add_argument('--strict', action='store_true',
+                        help='open rows must now pass (post-fix validation)')
+    parser.add_argument('--json', type=Path)
+    args = parser.parse_args(argv)
+    try:
+        cand, ref = compiler(args.lccc), compiler(args.reference)
+    except ValueError as exc:
+        parser.error(str(exc))
+    if not Path(cand[0]).exists():
+        parser.error(f'lccc not found: {args.lccc} '
+                     '(build it first: cargo build --profile fastbuild)')
+
+    report: list[dict] = []
+    hard = 0
+    with tempfile.TemporaryDirectory(prefix='lccc-audit-1108-') as work:
+        root = Path(work)
+
+        def probe_runtime(name: str, flags: list[str], ice_ok: bool) -> Result:
+            exe = root / name
+            exe.unlink(missing_ok=True)
+            try:
+                run([*cand, *flags, '-Wall', '-Werror', str(SOURCE),
+                     '-o', str(exe)], root, 120)
+            except ProbeError as exc:
+                if ice_ok:
+                    return Result('fail', f'compile-fail {_trim(str(exc))}')
+                return Result('error', f'compile-fail {_trim(str(exc))}')
+            try:
+                rc, out, _ = _allow_fail([str(exe), name], root, 60)
+            except ProbeError as exc:
+                return Result('fail', f'run-fail {_trim(str(exc))}')
+            if 'skipped' in out:
+                return Result('skip')
+            if rc != 0 and 'MISMATCH' not in out:
+                return Result('fail', f'exit {rc}')
+            if 'MISMATCH' in out:
+                return Result('fail', _trim(out))
+            if 'ok\n' in out:
+                return Result('pass')
+            return Result('error', f'unexpected output {_trim(out)!r}')
+
+        def probe_diff(name: str, flags: list[str], ice_ok: bool) -> Result:
+            exe = root / f'{name}_cand'
+            ref_exe = root / f'{name}_ref'
+            for path in (exe, ref_exe):
+                path.unlink(missing_ok=True)
+            try:
+                run([*ref, '-O0', str(SOURCE), '-o', str(ref_exe)], root, 120)
+            except ProbeError as exc:
+                return Result('error', f'reference-fail {_trim(str(exc))}')
+            try:
+                run([*cand, *flags, '-Wall', '-Werror', str(SOURCE),
+                     '-o', str(exe)], root, 120)
+            except ProbeError as exc:
+                if ice_ok:
+                    return Result('fail', f'compile-fail {_trim(str(exc))}')
+                return Result('error', f'compile-fail {_trim(str(exc))}')
+            try:
+                got_rc, got, _ = _allow_fail([str(exe), name], root, 60)
+                want_rc, want, _ = _allow_fail([str(ref_exe), name], root, 60)
+            except ProbeError as exc:
+                return Result('fail', f'run-fail {_trim(str(exc))}')
+            if want_rc != 0:
+                return Result('error', f'reference rc={want_rc}')
+            if got_rc != 0:
+                return Result('fail', f'candidate exit {got_rc}')
+            return (Result('pass') if got == want
+                    else Result('fail', f'{got!r} != {want!r}'))
+
+        def probe_asm(name: str, source: str, flags: list[str],
+                      must_contain: tuple[str, ...],
+                      must_not_contain: tuple[str, ...],
+                      diag_is_pass: bool = False) -> Result:
+            src = root / f'{name}.c'
+            src.write_text(source)
+            asm = root / f'{name}.s'
+            asm.unlink(missing_ok=True)
+            try:
+                run([*cand, *flags, '-S', str(src), '-o', str(asm)], root, 120)
+            except ProbeError as exc:
+                if diag_is_pass:
+                    # Refusing to compile the TU (with the missing-feature
+                    # diagnostic) is the accepted fixed behavior.
+                    return Result('pass')
+                return Result('error', f'compile-fail {_trim(str(exc))}')
+            text = asm.read_text()
+            for needle in must_contain:
+                if needle not in text:
+                    return Result('fail', f'missing {needle!r}')
+            for needle in must_not_contain:
+                if needle in text:
+                    return Result('fail', f'contains {needle!r}')
+            return Result('pass')
+
+        def probe_diag(name: str, source: str, flags: list[str]) -> Result:
+            src = root / f'{name}.c'
+            src.write_text(source)
+            obj = root / f'{name}.o'
+            obj.unlink(missing_ok=True)
+            try:
+                run([*cand, *flags, '-c', str(src), '-o', str(obj)], root, 120)
+            except ProbeError:
+                return Result('pass')  # refused/diagnosed = expected
+            return Result('fail', 'compiled cleanly, no diagnostic')
+
+        def probe_assembler(name: str, text: str) -> Result:
+            src = root / f'{name}.s'
+            src.write_text(text)
+            obj = root / f'{name}.o'
+            obj.unlink(missing_ok=True)
+            try:
+                run([*cand, '-c', str(src), '-o', str(obj)], root, 120)
+            except ProbeError:
+                return Result('pass')  # rejected = expected
+            return Result('fail', 'assembler accepted an invalid xmm spelling')
+
+        def record(row: str, item: str, kind: str, flags: str,
+                   expected: str, result: Result) -> str:
+            nonlocal hard
+            if result.kind == 'error':
+                label, is_hard = 'ERROR', True
+            elif result.kind == 'skip':
+                label, is_hard = 'SKIP', False
+            elif expected == 'open':
+                if result.kind == 'fail':
+                    # The reproducer proves the finding on this build: a
+                    # report in default mode, a failure in strict mode
+                    # (strict = "every open finding is claimed fixed").
+                    label = 'OPEN-CONFIRMED'
+                    is_hard = args.strict
+                else:
+                    # The build does not exhibit the finding the backlog
+                    # still tags open: reconcile the register (or flip the
+                    # row to expected='pass') — hard in default mode only.
+                    label = 'STALE-OPEN'
+                    is_hard = not args.strict
+            else:
+                if result.kind == 'pass':
+                    label, is_hard = 'PASS', False
+                else:
+                    label, is_hard = 'REGRESSION', True
+            hard += is_hard
+            report.append({'row': row, 'item': item, 'kind': kind,
+                           'flags': flags, 'expected': expected,
+                           'actual': str(result), 'status': label})
+            return label
+
+        # --- runtime / differential rows -------------------------------
+        for name, kind, flags, expected, item, ice_ok in ROWS:
+            result = (probe_runtime(name, flags, ice_ok) if kind == 'runtime'
+                      else probe_diff(name, flags, ice_ok))
+            record(name, item, kind, ' '.join(flags), expected, result)
+
+        # --- SA-01: no vfmadd without -mfma ----------------------------
+        record('sa01_asm', 'SA-01', 'asm',
+               '-O2 -mavx2 -mno-fma -ffast-math', 'open',
+               probe_asm(
+                   'sa01',
+                   '#include <stdio.h>\n'
+                   '__attribute__((noinline)) static void sa01_dot2('
+                   'int n, const float *restrict a, const float *restrict b,'
+                   ' const float *restrict c, const float *restrict d,'
+                   ' float *restrict r1, float *restrict r2) {'
+                   ' float s1 = 0.0f, s2 = 0.0f; int i;'
+                   ' for (i = 0; i < n; i++) { s1 += a[i]*b[i];'
+                   ' s2 += c[i]*d[i]; } *r1 = s1; *r2 = s2; }\n',
+                   ['-O2', '-mavx2', '-mno-fma', '-ffast-math'],
+                   must_contain=(), must_not_contain=('vfmadd',)))
+
+        # --- SA-03: 512-bit load/store under plain -mavx ----------------
+        # Fixed behavior: the TU is diagnosed (compile fails) OR compiles
+        # without emitting any 512-bit instruction.
+        record('sa03_asm', 'SA-03', 'asm', '-O2 -mavx', 'open',
+               probe_asm('sa03', SA03_TU, ['-O2', '-mavx'],
+                         must_contain=(),
+                         must_not_contain=('%zmm', 'vmovdqu64'),
+                         diag_is_pass=True))
+
+        # --- SA-04: shufflelo_epi16 must require BW ---------------------
+        record('sa04_diag', 'SA-04', 'diag', '-O2 -mavx512f', 'open',
+               probe_diag('sa04', SA04_TU, ['-O2', '-mavx512f']))
+
+        # --- SA-13: xmm-wide vinserti128 must be rejected ---------------
+        record('sa13_asm', 'SA-13', 'assembler', '-c file.s', 'open',
+               probe_assembler('sa13', SA13_ASM))
+
+        # --- SA-33: vzeroupper after digit-less EVEX ops -----------------
+        record('sa33_asm', 'SA-33', 'asm', '-O2 -mavx512f', 'open',
+               probe_asm('sa33', SA33_TU, ['-O2', '-mavx512f'],
+                         must_contain=('vzeroupper',), must_not_contain=()))
+
+    for row in report:
+        print(f"{row['status']:<15} {row['row']:<10} [{row['item']}] "
+              f"flags={row['flags']} actual={row['actual']}")
+    if args.json:
+        args.json.write_text(json.dumps(report, indent=2) + '\n')
+    if hard:
+        print(f'{hard} row(s) require action '
+              f'({"strict" if args.strict else "regression/error/stale-open"})')
+        return 1
+    print('audit pack green '
+          f'({"strict" if args.strict else "open rows confirmed, controls green"})')
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
