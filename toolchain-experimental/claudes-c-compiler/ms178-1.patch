+                    }
+                    continue;
+                }
+                if !const_zero_init {
+                    if debug {
+                        eprintln!(
+                            "[VEC] Skip reduction: induction variable does not start at a constant 0 (limit rescale + remainder math assume an element-0 start)"
+                        );
+                    }
+                    continue;
+                }
+            }
+
             // Try reduction pattern vectorization (sum += arr[i], sum += a[i] * b[i], etc.)
