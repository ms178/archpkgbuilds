+
+    // ── Repeated slot load elimination ───────────────────────────────────
+
+    #[test]
+    fn test_repeated_slot_load_same_reg_deleted() {
+        let input = "\
+f:
+    ldr x9, [sp, #392]
+    ldr d28, [x9, #80]
