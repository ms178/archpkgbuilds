+                };
+                if !ok { i += 1; continue 'scan; }
+                k += 1;
+                cnt += 1;
+            }
+            let Some(ci) = found else { i += 1; continue; };
+            triples.push(Triple { li: i, sj: j, ck: ci, sym: sym.to_string(), disp: raw_disp });
+            i = ci + 1;
+        }
+
+        // Phase 2: for each displacement with candidates, require that EVERY
+        // textual reference to that displacement inside the function is a
+        // member (store or call) of some candidate triple. Then all triples
+        // of that displacement fold together: every read of any of the
+        // physical slots those stores wrote is one of the rewritten calls,
+        // so no stale read can remain — under ANY ESP numbering (raw-text
+        // matching over-approximates aliasing; unmatched references merely
+        // block the fold).
+        if !triples.is_empty() {
+            let mut disps: Vec<i32> = triples.iter().map(|t| t.disp).collect();
+            disps.sort_unstable();
+            disps.dedup();
+            for d in disps {
+                let members: Vec<&Triple> = triples.iter().filter(|t| t.disp == d).collect();
+                let mut blocked = false;
+                'refscan: for t in fstart..fend {
+                    if infos[t].is_nop() { continue; }
+                    if members.iter().any(|m| m.sj == t || m.ck == t) { continue; }
+                    if references_esp_slot(trimmed(store, &infos[t], t), d) {
+                        blocked = true;
+                        break 'refscan;
+                    }
+                }
+                if blocked { continue; }
+                for m in members {
+                    infos[m.li].kind = LineKind::Nop;
+                    infos[m.sj].kind = LineKind::Nop;
+                    store.replace(m.ck, format!("    call *{}", m.sym));
+                    infos[m.ck] = classify_line(store.get(m.ck));
+                    changed = true;
+                }
+            }
+        }
+
+        fstart = fend + 1;
+    }
+
+    changed
+}
