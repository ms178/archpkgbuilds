diff --git a/tests/regression/dse_global_alias.c b/tests/regression/dse_global_alias.c
new file mode 100644
index 0000000..a743a59
--- /dev/null
+++ b/tests/regression/dse_global_alias.c
@@ -0,0 +1,17 @@
+/* Different symbol names do not prove different storage. Keep the first
+ * store even when GVN/global-address CSE/forwarding are disabled: DSE's own
+ * correctness cannot depend on another pass canonicalizing the aliases. */
+#include <stdio.h>
+int dse_object;
+extern int dse_alias_object __attribute__((alias("dse_object")));
+__attribute__((noinline)) int dse_read_alias(void) {
+    dse_object = 17;
+    int observed = dse_alias_object;
+    dse_object = 29;
+    return observed;
+}
+int main(void) {
+    int observed = dse_read_alias();
+    printf("dse-alias %d %d\n", observed, dse_object);
+    return observed != 17 || dse_object != 29;
+}
diff --git a/tests/regression/integer_bounds.c b/tests/regression/integer_bounds.c
new file mode 100644
index 0000000..7acbd85
--- /dev/null
+++ b/tests/regression/integer_bounds.c
@@ -0,0 +1,89 @@
+/* Producer ranges, signed/truncated carriers and complete/holey switches.
+ * No ctz/clz zero UB: the defined zero result is handled explicitly. */
+#include <stdint.h>
+#include <stdio.h>
+#define NI __attribute__((noinline))
+static NI long count_delta(uint64_t x, unsigned kind) {
+    if (kind == 0) return x ? (__builtin_ctzll(x) >> 3) : 8;
+    if (kind == 1) return x ? (__builtin_clzll(x) >> 3) : 8;
+    return __builtin_popcountll(x) >> 3;
+}
+static NI long count_reference(uint64_t x, unsigned kind) {
+    unsigned n = 0;
+    if (kind == 0) { while (n < 64 && ((x >> n) & 1) == 0) ++n; }
+    else if (kind == 1) { while (n < 64 && ((x >> (63 - n)) & 1) == 0) ++n; }
+    else { while (x) { n += x & 1; x >>= 1; } }
+    return n / 8;
+}
+static NI long signed_byte(uint64_t x) { return (int8_t)(x & 255) >> 3; }
+static NI long signed_word(uint32_t x) { return (int32_t)(x & UINT32_C(0x8000000f)); }
+
+#define CASES(B) \
+    case 0+(B): return y+3; case 1+(B): return y^7; \
+    case 2+(B): return y*5; case 3+(B): return y|11; \
+    case 4+(B): return y&13; case 5+(B): return y>>1; \
+    case 6+(B): return y<<2; case 7+(B): return ~y; \
+    case 8+(B): return y+256; case 9+(B): return y*17; \
+    case 10+(B): return y^(y>>3); case 11+(B): return y-(y>>1); \
+    case 12+(B): return (y&255)+29; case 13+(B): return y|257; \
+    case 14+(B): return y/7; case 15+(B): return y*39+1;
+#define FALLBACK UINT64_C(0xabcdef0012345678)
+static NI uint64_t dispatch16(uint32_t x, uint64_t y) {
+    switch (x & 15) { CASES(0) default: return FALLBACK; }
+}
+static NI uint64_t dispatch32(uint32_t x, uint64_t y) {
+    switch (x & 31) { CASES(0) default: return FALLBACK; }
+}
+static NI uint64_t dispatch_offset(uint32_t x, uint64_t y) {
+    switch ((x & 31) + 1) { CASES(1) default: return FALLBACK; }
+}
+static NI uint64_t dispatch_holes(uint32_t x, uint64_t y) {
+    switch (x & 15) {
+    case 0: return y+3; case 1: return y^7; case 2: return y*5;
+    case 4: return y&13; case 5: return y>>1; case 6: return y<<2;
+    case 8: return y+256; case 9: return y*17;
+    case 10: return y^(y>>3); case 11: return y-(y>>1);
+    case 12: return (y&255)+29; case 13: return y|257;
+    case 14: return y/7; case 15: return y*39+1;
+    default: return FALLBACK;
+    }
+}
+static NI uint64_t dispatch_reference(volatile unsigned x, uint64_t y) {
+    if(x==0)return y+3; if(x==1)return y^7; if(x==2)return y*5;
+    if(x==3)return y|11; if(x==4)return y&13; if(x==5)return y>>1;
+    if(x==6)return y<<2; if(x==7)return ~y; if(x==8)return y+256;
+    if(x==9)return y*17; if(x==10)return y^(y>>3); if(x==11)return y-(y>>1);
+    if(x==12)return (y&255)+29; if(x==13)return y|257;
+    if(x==14)return y/7; if(x==15)return y*39+1;
+    return FALLBACK;
+}
+int main(void) {
+    uint64_t seed=UINT64_C(0x98123456781234fe), checksum=0;
+    for(unsigned i=0;i<1024;++i) {
+        seed=seed*UINT64_C(6364136223846793005)+1;
+        uint64_t x = i < 64 ? (UINT64_C(1)<<i) : seed;
+        if(i==64)x=0;
+        for(unsigned kind=0;kind<3;++kind) {
+            long a=count_delta(x,kind),b=count_reference(x,kind);
+            if(a!=b)return 1;
+            checksum+=a;
+        }
+        int n=(int)(i&255); if(n>=128)n-=256;
+        long expect=n>=0?n/8:-((-n+7)/8);
+        if(signed_byte(i)!=expect)return 2;
+        uint32_t w=(uint32_t)seed&UINT32_C(0x8000000f);
+        long signed_expect=(long)(w&UINT32_C(0x7fffffff));
+        if(w&UINT32_C(0x80000000))signed_expect=signed_expect-2147483647L-1;
+        if(signed_word((uint32_t)seed)!=signed_expect)return 3;
+        unsigned s=(unsigned)seed;
+        uint64_t a=dispatch16(s,seed), b=dispatch32(s,seed), c=dispatch_offset(s,seed);
+        uint64_t h=dispatch_holes(s,seed);
+        if(a!=dispatch_reference(s&15,seed))return 4;
+        if(b!=dispatch_reference(s&31,seed)||c!=b)return 5;
+        uint64_t expected_h=((s&15)==3||(s&15)==7)?FALLBACK:dispatch_reference(s&15,seed);
+        if(h!=expected_h)return 6;
+        checksum^=a+b+c+h+(uint64_t)signed_expect;
+    }
+    printf("integer-bounds %016llx\n",(unsigned long long)checksum);
+    return 0;
+}
diff --git a/tests/regression/memory_value_forwarding.c b/tests/regression/memory_value_forwarding.c
new file mode 100644
index 0000000..ecefe39
--- /dev/null
+++ b/tests/regression/memory_value_forwarding.c
@@ -0,0 +1,62 @@
+/* Displaced aliases, typed store/load chains, and observable reads.
+ * The volatile reference is deliberately independent of the optimizable path. */
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#define NI __attribute__((noinline))
+
+static NI uint64_t displaced(uint64_t *p, uint64_t *q, uint64_t x) {
+    *p = x;
+    uint64_t observed = q[1];
+    *p = x + 1;
+    return observed;
+}
+static NI uint64_t displaced_ref(volatile uint64_t *p,
+                                 volatile uint64_t *q, uint64_t x) {
+    *p = x;
+    uint64_t observed = q[1];
+    *p = x + 1;
+    return observed;
+}
+struct fields { uint64_t a, b, c; };
+static NI uint64_t fields(struct fields *p, uint64_t x) {
+    p->a += x; p->b ^= p->a; p->a += p->b;
+    p->c += p->a; p->a ^= p->c; p->b += p->a;
+    return p->a ^ p->b ^ p->c;
+}
+static NI uint64_t fields_ref(volatile struct fields *p, uint64_t x) {
+    p->a += x; p->b ^= p->a; p->a += p->b;
+    p->c += p->a; p->a ^= p->c; p->b += p->a;
+    return p->a ^ p->b ^ p->c;
+}
+static NI unsigned narrow(uint8_t *p, uint64_t x) { *p = x; return *p; }
+static NI unsigned narrow_ref(volatile uint8_t *p, uint64_t x) { *p = x; return *p; }
+static NI float round_store(float *p, double x) { *p = x; return *p; }
+static NI float round_ref(volatile float *p, double x) { *p = x; return *p; }
+
+int main(void) {
+    uint64_t a[16], b[16], seed = UINT64_C(0x123456789abcdef0), checksum = 0;
+    for (unsigned round = 0; round < 64; ++round) {
+        seed ^= seed << 13; seed ^= seed >> 7; seed ^= seed << 17;
+        for (unsigned pi = 1; pi < 14; ++pi) {
+            for (unsigned qi = 0; qi < 14; ++qi) {
+                for (unsigned i = 0; i < 16; ++i) a[i] = b[i] = seed + i * 37u;
+                uint64_t x = displaced(a + pi, a + qi, seed ^ UINT64_C(0xdeadbeef));
+                uint64_t y = displaced_ref(b + pi, b + qi, seed ^ UINT64_C(0xdeadbeef));
+                if (x != y || memcmp(a, b, sizeof a)) return 1;
+                checksum ^= x;
+            }
+        }
+        struct fields f = { seed, seed + 1, ~seed }, g = f;
+        uint64_t x = fields(&f, seed), y = fields_ref(&g, seed);
+        if (x != y || memcmp(&f, &g, sizeof f)) return 2;
+        checksum ^= x;
+        uint8_t u, v;
+        if (narrow(&u, seed) != narrow_ref(&v, seed) || u != v) return 3;
+        float p, q;
+        double d = (double)(round * 1234567u) / 7.0;
+        if (round_store(&p, d) != round_ref(&q, d) || p != q) return 4;
+    }
+    printf("memory-value %016llx\n", (unsigned long long)checksum);
+    return 0;
+}
diff --git a/tests/regression/vector_address_folding.c b/tests/regression/vector_address_folding.c
new file mode 100644
index 0000000..de476b8
--- /dev/null
+++ b/tests/regression/vector_address_folding.c
@@ -0,0 +1,65 @@
+/* Packed field addresses: globals, ordinary and runtime-overaligned stack
+ * objects, variable trip counts, tails, and untouched guard fields. The
+ * volatile reference cannot take the vector address paths being tested. */
+#include <stdint.h>
+#include <stdio.h>
+#define NI __attribute__((noinline))
+struct cell { double x, y, vx, vy; uint64_t guard; };
+static struct cell global_cells[18];
+
+static NI void advance(struct cell *p, unsigned n) {
+    for (unsigned i = 0; i < n; ++i) {
+        p[i].x += p[i].vx * 0.5;
+        p[i].y += p[i].vy * 0.5;
+        p[i].vx += 0.25;
+        p[i].vy -= 0.5;
+    }
+}
+static NI void reference(volatile struct cell *p, unsigned n) {
+    for (unsigned i = 0; i < n; ++i) {
+        p[i].x += p[i].vx * 0.5;
+        p[i].y += p[i].vy * 0.5;
+        p[i].vx += 0.25;
+        p[i].vy -= 0.5;
+    }
+}
+static NI int probe(uint64_t seed, unsigned n, uint64_t *checksum) {
+    struct cell ordinary[18];
+    _Alignas(64) struct cell aligned[18];
+    volatile struct cell expected[18];
+    for (unsigned i = 0; i < 18; ++i) {
+        double x = (double)((seed + i) & 255u);
+        double y = (double)((seed >> 8) & 127u) - i;
+        double vx = (double)(i + 1), vy = -(double)(i + 3);
+        uint64_t guard = seed ^ ((uint64_t)i << 40);
+        ordinary[i].x = aligned[i].x = global_cells[i].x = expected[i].x = x;
+        ordinary[i].y = aligned[i].y = global_cells[i].y = expected[i].y = y;
+        ordinary[i].vx = aligned[i].vx = global_cells[i].vx = expected[i].vx = vx;
+        ordinary[i].vy = aligned[i].vy = global_cells[i].vy = expected[i].vy = vy;
+        ordinary[i].guard = aligned[i].guard = global_cells[i].guard = expected[i].guard = guard;
+    }
+    for (unsigned round = 0; round < 17; ++round) {
+        advance(ordinary, n); advance(aligned, n); advance(global_cells, n);
+        reference(expected, n);
+    }
+    for (unsigned i = 0; i < 18; ++i) {
+#define CHECK(field) \
+        if (ordinary[i].field != expected[i].field || \
+            aligned[i].field != expected[i].field || \
+            global_cells[i].field != expected[i].field) return 1;
+        CHECK(x) CHECK(y) CHECK(vx) CHECK(vy) CHECK(guard)
+#undef CHECK
+        *checksum ^= ordinary[i].guard + (uint64_t)(ordinary[i].x + 4096.0);
+    }
+    return 0;
+}
+int main(void) {
+    uint64_t seed = UINT64_C(0x781aab3398761234), checksum = 0;
+    for (unsigned round = 0; round < 32; ++round) {
+        seed = seed * UINT64_C(6364136223846793005) + 1;
+        for (unsigned n = 0; n <= 17; ++n)
+            if (probe(seed, n, &checksum)) return 1;
+    }
+    printf("vector-address %016llx\n", (unsigned long long)checksum);
+    return 0;
+}
