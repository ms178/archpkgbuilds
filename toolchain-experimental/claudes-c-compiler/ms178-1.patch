+++ b/src/passes/set_membership.rs
@@ -0,0 +1,909 @@
+//! Sparse small-set membership: fold chains of `x == C` / range tests into
+//! one bit-mask test — GCC's `subl $45,%edi; cmpb $50,%dil; ja miss;
+//! btq %rdi,MASK` classify idiom (Expat xml_name_continue, SQLite varint).
+//!
+//! Shape recognized (post range_fold + cfg_simplify, the form that actually
+//! reaches this pass — hit blocks are already merged into the join Phi):
+//!
+//! ```text
+//! T_i:  <pure test insts>                 ; Eq or unsigned-bias range test
+//!       CondBranch cond -> JOIN, T_{i+1}  ; hit edge straight to the phi
+//! ...
+//! TAIL: Cmp Eq x, C_n                     ; optional value-block tail
+//!       Branch JOIN                       ; phi uses the Cmp value
+//! JOIN: Phi [(Const(1), T_1), ..., (Value(tail_cmp), TAIL), ...]
+//! ```
+//!
+//! Member kinds:
+//!  * Eq test: exactly `Cmp Eq x, C; CondBranch(cmp)` — one bit.
+//!  * Range test (range_fold output): `[Cast x→I32]; Sub c, lo; Cmp Ule
+//!    sub, span; [Cast cmp→wide]; CondBranch(last)` — a run of bits.
+//!  * Tail value block: `Cmp Eq x, C; Branch(JOIN)` with the Phi consuming
+//!    the Cmp value — one bit, terminates the chain (mode B).
+//!
+//! A chain of >= 3 members over the same root value, whose hit edges all
+//! feed the SAME Phi with Const(1) (tail: with its own Cmp value), and whose
+//! combined constant span is <= 63, collapses into ONE block:
+//!
+//! ```text
+//! c32  = zext x to i32            (skipped when x is 32-bit)
+//! sub  = c32 - lo
+//! inr  = ULe (u32)sub, span       ; unsigned-bias range guard
+//! bit  = BitTest MASK, sub        ; I32 when span<=31 else I64 (zext idx)
+//! and  = bit & zext(inr)
+//! modeA: CondBranch (and != 0) -> JOIN, exit_miss   ; phi += (1, T_1)
+//! modeB: Branch JOIN                                ; phi += (and, T_1)
+//! ```
+//!
+//! Soundness:
+//!  * every member block contains ONLY its test pattern; every def is used
+//!    only inside its own block (tail Cmp: additionally exactly the one
+//!    Phi use, verified against the incoming list);
+//!  * every member except the first has exactly one predecessor (the
+//!    previous member's miss edge), so no other path enters mid-chain;
+//!  * the root is only READ by member tests (no def between them — members
+//!    contain no defs visible outside, and the root dominates the chain
+//!    head by SSA);
+//!  * BT masks its count operand at machine level and the `inr` guard
+//!    zeroes the result for out-of-range values, so a wrapped index never
+//!    changes the outcome. The IR-level And makes this explicit — no
+//!    backend may see an unguarded out-of-range BitTest;
+//!  * absorbed member blocks lose their only entry edge and die in
+//!    cfg_simplify's unreachable sweep; their Phi entries are removed here
+//!    (a stale entry from an unreachable pred would be structurally
+//!    invalid even though semantically dead).
+//!
+//! Pass name for CCC_DISABLE_PASSES: "set_membership".
+
+use crate::common::fx_hash::FxHashMap;
+use crate::common::types::IrType;
+use crate::ir::reexports::{
+    BlockId, Instruction, IrBinOp, IrCmpOp, IrConst, IrFunction, Operand, Terminator, Value,
+};
+
+/// One recognized member of a membership chain.
+struct Member {
+    /// Block index in `func.blocks`.
+    bi: usize,
+    /// Block label (phi incoming key).
+    label: BlockId,
+    /// Inclusive value range this member accepts (single Eq: lo == hi).
+    lo: i64,
+    hi: i64,
+    /// False-edge target (None for the tail value block).
+    miss: Option<BlockId>,
+    /// Tail value block (mode B): the Phi consumes this block's Cmp value.
+    is_tail: bool,
+}
+
+/// Sign-normalize an equality constant into the unsigned domain of the
+/// compare type: U8 compares store `IrConst::I8(-62)` for 0xc2, and the
+/// membership arithmetic runs on the zero-extended value.
+fn norm_const(c: &IrConst, ty: IrType) -> Option<i64> {
+    let raw = c.to_i64()?;
+    Some(match ty {
+        IrType::U8 => raw as u8 as i64,
+        IrType::U16 => raw as u16 as i64,
+        IrType::U32 => raw as u32 as i64,
+        IrType::I32 => raw as i32 as i64,
+        _ => return None,
+    })
+}
+
+/// Root types the fold understands: unsigned narrow (zero-extension domain)
+/// or 32-bit. Signed narrow roots are excluded — their widening cast
+/// sign-extends and the rebase arithmetic would disagree with `norm_const`.
+fn root_ty_ok(ty: IrType) -> bool {
+    matches!(ty, IrType::U8 | IrType::U16 | IrType::I32 | IrType::U32)
+}
+
+/// Parse one member block. `expect_root` pins the compared value after the
+/// first member; `join` pins the hit target. Returns (root_id, root_ty, m).
+fn parse_member(
+    func: &IrFunction,
+    bi: usize,
+    expect_root: Option<(u32, IrType)>,
+    join: Option<BlockId>,
+) -> Option<(u32, IrType, Member)> {
+    let block = &func.blocks[bi];
+    let insts = &block.instructions;
+
+    // Tail value block: `Cmp Eq x, C ; Branch(join)`.
+    if insts.len() == 1 {
+        if let (
+            Instruction::Cmp { op: IrCmpOp::Eq, lhs, rhs, ty, .. },
+            Terminator::Branch(t),
+        ) = (&insts[0], &block.terminator)
+        {
+            if join.is_some_and(|j| j != *t) || !root_ty_ok(*ty) {
+                return None;
+            }
+            let (val, con) = match (lhs, rhs) {
+                (Operand::Value(v), Operand::Const(c)) => (v.0, norm_const(c, *ty)?),
+                (Operand::Const(c), Operand::Value(v)) => (v.0, norm_const(c, *ty)?),
+                _ => return None,
+            };
+            if expect_root.is_some_and(|(r, rt)| r != val || rt != *ty) {
+                return None;
+            }
+            return Some((
+                val,
+                *ty,
+                Member { bi, label: block.label, lo: con, hi: con, miss: None, is_tail: true },
+            ));
+        }
+    }
+
+    let Terminator::CondBranch { cond: Operand::Value(cv), true_label, false_label } =
+        &block.terminator
+    else {
+        return None;
+    };
+    if join.is_some_and(|j| j != *true_label) {
+        return None;
+    }
+
+    // Eq test: exactly one Cmp whose dest is the branch condition.
+    if insts.len() == 1 {
+        let Instruction::Cmp { dest, op: IrCmpOp::Eq, lhs, rhs, ty } = &insts[0] else {
+            return None;
+        };
+        if dest.0 != cv.0 || !root_ty_ok(*ty) {
+            return None;
+        }
+        let (val, con) = match (lhs, rhs) {
+            (Operand::Value(v), Operand::Const(c)) => (v.0, norm_const(c, *ty)?),
+            (Operand::Const(c), Operand::Value(v)) => (v.0, norm_const(c, *ty)?),
+            _ => return None,
+        };
+        if expect_root.is_some_and(|(r, rt)| r != val || rt != *ty) {
+            return None;
+        }
+        return Some((
+            val,
+            *ty,
+            Member {
+                bi,
+                label: block.label,
+                lo: con,
+                hi: con,
+                miss: Some(*false_label),
+                is_tail: false,
+            },
+        ));
+    }
+
+    // Range test (range_fold output), 2-4 instructions:
+    //   [Cast c = zext x] ; Sub s = c - LO ; Cmp b = ULe s, SPAN ;
+    //   [Cast w = widen b] — branch cond is w (or b without the cast).
+    if insts.len() > 4 {
+        return None;
+    }
+    let mut idx = 0usize;
+    let mut cast_dest: Option<u32> = None;
+    let mut root_val: Option<(u32, IrType)> = None;
+    if insts.is_empty() {
+        return None;
+    }
+    if let Instruction::Cast { dest, src: Operand::Value(s), from_ty, to_ty } = &insts[idx] {
+        // Only ZERO-extending widenings keep the unsigned domain aligned
+        // with norm_const; a signed narrow source would sign-extend.
+        if matches!(from_ty, IrType::U8 | IrType::U16)
+            && to_ty.is_integer()
+            && to_ty.size() >= from_ty.size()
+        {
+            cast_dest = Some(dest.0);
+            root_val = Some((s.0, *from_ty));
+            idx += 1;
+        }
+    }
+    let Some(Instruction::BinOp { dest: sub_d, op: IrBinOp::Sub, lhs, rhs, .. }) = insts.get(idx)
+    else {
+        return None;
+    };
+    idx += 1;
+    let lo = match rhs {
+        Operand::Const(c) => c.to_i64()?,
+        _ => return None,
+    };
+    match lhs {
+        Operand::Value(v) => match cast_dest {
+            Some(cd) if cd == v.0 => {}
+            None => {
+                root_val = Some((v.0, IrType::I32));
+            }
+            _ => return None,
+        },
+        _ => return None,
+    }
+    let Some(Instruction::Cmp { dest: cmp_d, op: IrCmpOp::Ule, lhs: cl, rhs: cr, .. }) =
+        insts.get(idx)
+    else {
+        return None;
+    };
+    idx += 1;
+    if !matches!(cl, Operand::Value(v) if v.0 == sub_d.0) {
+        return None;
+    }
+    let span = match cr {
+        Operand::Const(c) => c.to_i64()?,
+        _ => return None,
+    };
+    if span < 0 {
+        return None;
+    }
+    let mut cond_src = cmp_d.0;
+    if let Some(Instruction::Cast { dest, src: Operand::Value(s), .. }) = insts.get(idx) {
+        if s.0 == cmp_d.0 {
+            cond_src = dest.0;
+            idx += 1;
+        }
+    }
+    if idx != insts.len() || cv.0 != cond_src {
+        return None;
+    }
+    let (rv, rt) = root_val?;
+    if !root_ty_ok(rt) {
+        return None;
+    }
+    // Root identity across member kinds: eq tests compare the NARROW value,
+    // range tests go through their own zext of it. Match the value id; the
+    // domain agreement is enforced by root_ty_ok + zext-only casts.
+    if let Some((r, _)) = expect_root {
+        if r != rv {
+            return None;
+        }
+    }
+    Some((
+        rv,
+        rt,
+        Member {
+            bi,
+            label: block.label,
+            lo,
+            hi: lo.checked_add(span)?,
+            miss: Some(*false_label),
+            is_tail: false,
+        },
+    ))
+}
+
+pub(crate) fn run_function(func: &mut IrFunction) -> usize {
+    if func.blocks.len() < 3 {
+        return 0;
+    }
+
+    // Predecessor counts and label → index map.
+    let mut pred_count: FxHashMap<u32, u32> = FxHashMap::default();
+    for block in &func.blocks {
+        let mut bump = |b: BlockId| *pred_count.entry(b.0).or_insert(0) += 1;
+        match &block.terminator {
+            Terminator::Branch(t) => bump(*t),
+            Terminator::CondBranch { true_label, false_label, .. } => {
+                bump(*true_label);
+                bump(*false_label);
+            }
+            Terminator::Switch { cases, default, .. } => {
+                for (_, t) in cases {
+                    bump(*t);
+                }
+                bump(*default);
+            }
+            Terminator::IndirectBranch { possible_targets, .. } => {
+                for t in possible_targets {
+                    bump(*t);
+                }
+            }
+            Terminator::Return(_) | Terminator::Unreachable => {}
+        }
+    }
+    let label_to_idx: FxHashMap<u32, usize> =
+        func.blocks.iter().enumerate().map(|(i, b)| (b.label.0, i)).collect();
+
+    // value id → count of uses OUTSIDE the block that defines it, plus the
+    // set of (using) block indices. Phi operands count as uses in the phi's
+    // block for the "outside" test.
+    let mut use_sites: FxHashMap<u32, Vec<usize>> = FxHashMap::default();
+    for (bi, block) in func.blocks.iter().enumerate() {
+        for inst in &block.instructions {
+            inst.for_each_used_value(|v| use_sites.entry(v).or_default().push(bi));
+        }
+        let mut term_use = |op: &Operand| {
+            if let Operand::Value(v) = op {
+                use_sites.entry(v.0).or_default().push(bi);
+            }
+        };
+        match &block.terminator {
+            Terminator::CondBranch { cond, .. } => term_use(cond),
+            Terminator::Switch { val, .. } => term_use(val),
+            Terminator::Return(Some(op)) => term_use(op),
+            Terminator::IndirectBranch { target, .. } => term_use(target),
+            _ => {}
+        }
+    }
+
+    // Every def of a member block must be used only inside that block; the
+    // tail Cmp may additionally be used exactly once by the join phi.
+    let defs_local = |func: &IrFunction,
+                      bi: usize,
+                      allow: Option<(u32 /*value*/, usize /*join_idx*/)>|
+     -> bool {
+        for inst in &func.blocks[bi].instructions {
+            if let Some(d) = inst.dest() {
+                if let Some(uses) = use_sites.get(&d.0) {
+                    for &ub in uses {
+                        if ub == bi {
+                            continue;
+                        }
+                        match allow {
+                            Some((v, j)) if v == d.0 && ub == j => continue,
+                            _ => return false,
+                        }
+                    }
+                }
+            }
+        }
+        true
+    };
+
+    let mut changes = 0usize;
+    let mut bi = 0usize;
+    while bi < func.blocks.len() {
+        let Some((root, root_ty, first)) = parse_member(func, bi, None, None) else {
+            bi += 1;
+            continue;
+        };
+        if first.is_tail {
+            bi += 1;
+            continue; // a chain cannot START with the tail
+        }
+        let join = match &func.blocks[first.bi].terminator {
+            Terminator::CondBranch { true_label, .. } => *true_label,
+            _ => unreachable!("parse_member guarantees CondBranch"),
+        };
+        let Some(&join_idx) = label_to_idx.get(&join.0) else {
+            bi += 1;
+            continue;
+        };
+        // Exactly one Phi in the join, and it must be the only phi so the
+        // edge retargeting below stays single-writer.
+        let phis: Vec<usize> = func.blocks[join_idx]
+            .instructions
+            .iter()
+            .enumerate()
+            .filter_map(|(i, inst)| matches!(inst, Instruction::Phi { .. }).then_some(i))
+            .collect();
+        if phis.len() != 1 {
+            bi += 1;
+            continue;
+        }
+        let phi_pos = phis[0];
+        let (phi_ty, phi_incoming) = match &func.blocks[join_idx].instructions[phi_pos] {
+            Instruction::Phi { ty, incoming, .. } => (*ty, incoming.clone()),
+            _ => unreachable!(),
+        };
+        if !phi_ty.is_integer() {
+            bi += 1;
+            continue;
+        }
+        let const1_from = |label: BlockId| {
+            phi_incoming
+                .iter()
+                .any(|(op, b)| *b == label && matches!(op, Operand::Const(c) if c.to_i64() == Some(1)))
+        };
+        if !const1_from(first.label) || !defs_local(func, first.bi, None) {
+            bi += 1;
+            continue;
+        }
+
+        let mut chain: Vec<Member> = vec![first];
+        loop {
+            let last = chain.last().unwrap();
+            let Some(miss) = last.miss else { break };
+            let Some(&next_idx) = label_to_idx.get(&miss.0) else { break };
+            if pred_count.get(&miss.0).copied().unwrap_or(0) != 1 {
+                break;
+            }
+            let Some((_, _, m)) = parse_member(func, next_idx, Some((root, root_ty)), Some(join))
+            else {
+                break;
+            };
+            if m.is_tail {
+                let tail_cmp = match &func.blocks[next_idx].instructions[0] {
+                    Instruction::Cmp { dest, .. } => dest.0,
+                    _ => unreachable!(),
+                };
+                let phi_takes_value = phi_incoming.iter().any(|(op, b)| {
+                    *b == m.label && matches!(op, Operand::Value(v) if v.0 == tail_cmp)
+                });
+                if phi_takes_value && defs_local(func, next_idx, Some((tail_cmp, join_idx))) {
+                    chain.push(m);
+                }
+                break;
+            }
+            if !const1_from(m.label) || !defs_local(func, next_idx, None) {
+                break;
+            }
+            chain.push(m);
+        }
+
+        if chain.len() < 3 {
+            bi += 1;
+            continue;
+        }
+
+        // Combined bit span (ranges contribute runs of bits).
+        let lo = chain.iter().map(|m| m.lo).min().unwrap();
+        let hi = chain.iter().map(|m| m.hi).max().unwrap();
+        let Some(span) = hi.checked_sub(lo) else {
+            bi += 1;
+            continue;
+        };
+        if span > 63 {
+            bi += 1;
+            continue;
+        }
+        let mut mask: u64 = 0;
+        for m in &chain {
+            for c in m.lo..=m.hi {
+                mask |= 1u64 << (c - lo);
+            }
+        }
+        let use_32 = span <= 31;
+
+        // ── Rewrite the first block into the combined membership test ──
+        let mut next_id = func.next_value_id;
+        if next_id == 0 {
+            next_id = func.max_value_id() + 1;
+        }
+        let mut fresh = || {
+            let v = Value(next_id);
+            next_id += 1;
+            v
+        };
+
+        let mut insts: Vec<Instruction> = Vec::with_capacity(8);
+        let root32 = if root_ty.size() < 4 {
+            let c = fresh();
+            insts.push(Instruction::Cast {
+                dest: c,
+                src: Operand::Value(Value(root)),
+                from_ty: root_ty,
+                to_ty: IrType::I32,
+            });
+            c
+        } else {
+            Value(root)
+        };
+        let sub_v = fresh();
+        insts.push(Instruction::BinOp {
+            dest: sub_v,
+            op: IrBinOp::Sub,
+            lhs: Operand::Value(root32),
+            rhs: Operand::Const(IrConst::I32(lo as i32)),
+            ty: IrType::I32,
+        });
+        let inr_v = fresh();
+        insts.push(Instruction::Cmp {
+            dest: inr_v,
+            op: IrCmpOp::Ule,
+            lhs: Operand::Value(sub_v),
+            rhs: Operand::Const(IrConst::I32(span as i32)),
+            ty: IrType::U32,
+        });
+        let (bt_ty, mask_const, idx_v) = if use_32 {
+            (IrType::I32, IrConst::I32(mask as u32 as i32), sub_v)
+        } else {
+            let z = fresh();
+            insts.push(Instruction::Cast {
+                dest: z,
+                src: Operand::Value(sub_v),
+                from_ty: IrType::U32,
+                to_ty: IrType::I64,
+            });
+            (IrType::I64, IrConst::I64(mask as i64), z)
+        };
+        let bit_v = fresh();
+        insts.push(Instruction::BinOp {
+            dest: bit_v,
+            op: IrBinOp::BitTest,
+            lhs: Operand::Const(mask_const),
+            rhs: Operand::Value(idx_v),
+            ty: bt_ty,
+        });
+        let inr_w = fresh();
+        insts.push(Instruction::Cast {
+            dest: inr_w,
+            src: Operand::Value(inr_v),
+            from_ty: IrType::U8,
+            to_ty: bt_ty,
+        });
+        let and_v = fresh();
+        insts.push(Instruction::BinOp {
+            dest: and_v,
+            op: IrBinOp::And,
+            lhs: Operand::Value(bit_v),
+            rhs: Operand::Value(inr_w),
+            ty: bt_ty,
+        });
+
+        let is_mode_b = chain.last().unwrap().is_tail;
+        let first_bi = chain[0].bi;
+        let first_label = chain[0].label;
+
+        if is_mode_b {
+            // Result flows through the phi as a value: 0/1 in bt_ty.
+            let result = if bt_ty == phi_ty {
+                and_v
+            } else {
+                let r = fresh();
+                insts.push(Instruction::Cast {
+                    dest: r,
+                    src: Operand::Value(and_v),
+                    from_ty: bt_ty,
+                    to_ty: phi_ty,
+                });
+                r
+            };
+            func.blocks[first_bi].instructions = insts;
+            func.blocks[first_bi].source_spans.clear();
+            func.blocks[first_bi].terminator = Terminator::Branch(join);
+            if let Instruction::Phi { incoming, .. } =
+                &mut func.blocks[join_idx].instructions[phi_pos]
+            {
+                incoming.retain(|(_, b)| !chain.iter().any(|m| m.label == *b));
+                incoming.push((Operand::Value(result), first_label));
+            }
+        } else {
+            let cond_v = fresh();
+            insts.push(Instruction::Cmp {
+                dest: cond_v,
+                op: IrCmpOp::Ne,
+                lhs: Operand::Value(and_v),
+                rhs: Operand::Const(if use_32 { IrConst::I32(0) } else { IrConst::I64(0) }),
+                ty: bt_ty,
+            });
+            let exit_miss = chain.last().unwrap().miss.unwrap();
+            func.blocks[first_bi].instructions = insts;
+            func.blocks[first_bi].source_spans.clear();
+            func.blocks[first_bi].terminator = Terminator::CondBranch {
+                cond: Operand::Value(cond_v),
+                true_label: join,
+                false_label: exit_miss,
+            };
+            if let Instruction::Phi { incoming, .. } =
+                &mut func.blocks[join_idx].instructions[phi_pos]
+            {
+                incoming.retain(|(_, b)| !chain.iter().any(|m| m.label == *b));
+                incoming.push((Operand::Const(IrConst::I64(1)), first_label));
+            }
+        }
+
+        func.next_value_id = next_id;
+        changes += 1;
+        // The absorbed blocks lost their only entry edge; cfg_simplify's
+        // unreachable sweep removes them.
+        bi = chain.last().unwrap().bi + 1;
+    }
+
+    changes
+}
