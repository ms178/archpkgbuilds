diff --git a/tests/regression/check_ipa_ra_interposition.sh b/tests/regression/check_ipa_ra_interposition.sh
new file mode 100755
index 000000000..253bed9e7
--- /dev/null
+++ b/tests/regression/check_ipa_ra_interposition.sh
@@ -0,0 +1,31 @@
+#!/usr/bin/env bash
+# Regression: IPA-RA must not trust the clobber summary of a definition that
+# another TU can replace at link time (#pragma weak, a weak redeclaration
+# after the definition, top-level asm ".weak"). Before the fix the weak
+# bodies were summarized and use_* printed 55 instead of 79 once override.c
+# supplied strong leaves that clobber %r8-%r11. The static control proves the
+# test exercises IPA-RA at all (its caller must carry an LCCC_IPA_KEEP mask).
+set -euo pipefail
+root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
+ccc=${CCC:-$root/target/fastbuild/lccc}
+[ -x "$ccc" ] || { echo "FAIL: $ccc not built" >&2; exit 1; }
+d=$root/tests/regression/ipa_ra_interposition
+tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
+"$ccc" -O2 -S "$d/caller.c" -o "$tmp/caller.s"
+keep=$(awk '/^use_static:/,/\.size use_static/' "$tmp/caller.s")
+grep -c 'LCCC_IPA_KEEP' <<<"$keep" >/dev/null \
+  || { echo "FAIL ipa_ra_interposition: control use_static has no IPA keep mask"; exit 1; }
+for mode in "" -fPIE -fPIC; do
+  for opt in -O1 -O2; do
+    for f in caller override main; do
+      "$ccc" $opt $mode -c "$d/$f.c" -o "$tmp/$f.o"
+    done
+    link=""; [ "$mode" = -fPIE ] && link=-pie
+    [ "$mode" = -fPIC ] && link=-pie
+    "$ccc" $link "$tmp/main.o" "$tmp/caller.o" "$tmp/override.o" -o "$tmp/t"
+    out=$("$tmp/t")
+    [ "$out" = "79 79 79 79" ] \
+      || { echo "FAIL ipa_ra_interposition ($opt ${mode:-no-pic}): $out"; exit 1; }
+  done
+done
+echo "PASS check_ipa_ra_interposition"
diff --git a/tests/regression/ipa_ra_interposition/caller.c b/tests/regression/ipa_ra_interposition/caller.c
new file mode 100644
index 000000000..551639787
--- /dev/null
+++ b/tests/regression/ipa_ra_interposition/caller.c
@@ -0,0 +1,30 @@
+/* IPA-RA interposition regression (driver: check_ipa_ra_interposition.sh).
+ * Each weak leaf below has a strong replacement in override.c with the same
+ * value but a different register footprint (it clobbers %r8-%r11, which the
+ * ABI allows).  A caller that kept a live value in one of those registers on
+ * the strength of the weak body's IPA-RA summary computes a wrong result. */
+__attribute__((noinline)) long leaf_pragma(long x) { return x * 3 + 1; }
+#pragma weak leaf_pragma
+
+__attribute__((noinline)) long leaf_late(long x) { return x * 3 + 1; }
+long leaf_late(long) __attribute__((weak));
+
+__attribute__((noinline)) long leaf_asm(long x) { return x * 3 + 1; }
+__asm__(".weak leaf_asm");
+
+/* Positive control: a static leaf binds locally, so its caller must use
+ * the summary (the driver checks for an LCCC_IPA_KEEP marker). */
+static __attribute__((noinline)) long leaf_static(long x) { return x * 3 + 1; }
+
+#define USE(name, leaf)                                                    \
+    long name(long a, long b, long c, long d) {                            \
+        long s = a * b;                                                    \
+        long t = c ^ d;                                                    \
+        long r = leaf(a);                                                  \
+        long q = leaf(b);                                                  \
+        return s + t + r + q + a + b + c + d;                              \
+    }
+USE(use_pragma, leaf_pragma)
+USE(use_late, leaf_late)
+USE(use_asm, leaf_asm)
+USE(use_static, leaf_static)
diff --git a/tests/regression/ipa_ra_interposition/main.c b/tests/regression/ipa_ra_interposition/main.c
