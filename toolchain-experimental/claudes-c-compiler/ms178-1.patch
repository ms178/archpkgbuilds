+/// Fold a copy/32-bit-update/copy-back round trip:
+///   movq SRC, TMP; <update> TMPd; movl TMPd, SRCd
+/// into:
+///   <update> SRCd
+/// when TMP is provably dead afterwards.  The update is restricted to ordinary
+/// explicit-operand integer ALU operations; one-operand IMUL and partial-width
+/// forms are rejected. 32-bit writes zero-extend on x86-64, so both sequences
+/// have identical SRC and flag semantics.
+/// Replace `shrq %cl, %base; andq $1, %res; cmpq $0, %res; setne %cc`
+/// with a direct `btq %rcx, %base; setc %cc` when `%base` was loaded from a
+/// constant bit mask.  On x86-64, BT stores the selected bit directly in CF and
+/// masks the index modulo 64, so it is equivalent to the shift/AND/compare
+/// sequence for all values of `%cl` and avoids the integer dependency through
+/// the shift result.  Expat's UTF-8 name classifier contains this exact shape
+/// after if-conversion; GCC emits the BT form.
+pub(super) fn fold_variable_bit_test(
+    store: &mut LineStore,
+    infos: &mut [LineInfo],
+) -> bool {
+    let len = store.len();
+    let mut changed = false;
+    let mut i = 0;
+    while i < len {
+        if infos[i].is_nop() { i += 1; continue; }
+        let shift = infos[i].trimmed(store.get(i));
+        let Some((shift_dst, shift_base_ok)) = parse_var_shrq(shift) else { i += 1; continue; };
+        if !shift_base_ok { i += 1; continue; }
+
+        // The shift destination must have been loaded from an immediate mask.
+        // We do not need the mask value for correctness: BT works for every bit,
+        // but this requirement keeps the pattern tied to the bitmap classifier
+        // shape and avoids turning arbitrary shifts into BT.
+        let mut p = i;
+        let mut saw_movabs = false;
+        while p > 0 {
+            p -= 1;
+            if infos[p].is_nop() { continue; }
+            if infos[p].is_barrier() { break; }
+            let prev = infos[p].trimmed(store.get(p));
+            if prev.starts_with("movabsq $") && prev.ends_with(&format!(", {shift_dst}")) {
+                saw_movabs = true;
+            }
+            break;
+        }
+        if !saw_movabs { i += 1; continue; }
+
+        // Find the following AND/compare/set chain without crossing labels,
+        // jumps, calls or other control barriers.
+        let and_idx = next_non_nop(infos, i + 1, len);
+        if and_idx >= len || infos[and_idx].is_barrier() { i += 1; continue; }
+        let and = infos[and_idx].trimmed(store.get(and_idx));
+        let Some(and_res) = parse_and_one(and, shift_dst) else { i += 1; continue; };
+
+        let cmp_idx = next_non_nop(infos, and_idx + 1, len);
+        if cmp_idx >= len || infos[cmp_idx].is_barrier() { i += 1; continue; }
+        let cmp = infos[cmp_idx].trimmed(store.get(cmp_idx));
+        if !is_cmp_zero(cmp, and_res) { i += 1; continue; }
+
+        let set_idx = next_non_nop(infos, cmp_idx + 1, len);
+        if set_idx >= len || infos[set_idx].is_barrier() { i += 1; continue; }
+        let set = infos[set_idx].trimmed(store.get(set_idx)).to_string();
+        let cc_reg = match parse_setcc_nonnegative(&set) {
+            Some(reg) => reg.to_string(),
+            None => { i += 1; continue; }
+        };
+        if register_family_fast(&cc_reg) == 1 { i += 1; continue; }
+
+        // If the result is zero-extended immediately after SETcc, the existing
+        // redundant-extension pass removes the move once SETC is in place.
+        let bt = format!("    btq %rcx, {shift_dst}");
+        let setc = format!("    setc {cc_reg}");
+        replace_line(store, &mut infos[i], i, bt);
+        mark_nop(&mut infos[and_idx]);
+        mark_nop(&mut infos[cmp_idx]);
+        replace_line(store, &mut infos[set_idx], set_idx, setc);
+        changed = true;
+        i = set_idx + 1;
+    }
+    changed
+}
+
+fn parse_var_shrq(line: &str) -> Option<(&str, bool)> {
+    let rest = line.strip_prefix("shrq ")?.trim_start();
+    let (amount, dst) = rest.split_once(',')?;
+    let dst = dst.trim();
+    Some((dst, amount.trim() == "%cl" && dst.starts_with('%')))
+}
+
+fn parse_and_one<'a>(line: &'a str, shift_dst: &str) -> Option<&'a str> {
+    let rest = line.strip_prefix("andq $1,")?;
+    let dst = rest.trim();
+    let same_shift = dst == shift_dst;
+    let preceded = line.contains(shift_dst);
+    (dst.starts_with('%') && (same_shift || preceded)).then_some(dst)
+}
+
+fn is_cmp_zero(line: &str, reg: &str) -> bool {
+    let Some(rest) = line.strip_prefix("cmpq ") else { return false; };
+    let (lhs, rhs) = match rest.split_once(',') { Some(x) => x, None => return false };
+    (lhs.trim() == "$0" && rhs.trim() == reg) || (lhs.trim() == reg && rhs.trim() == "$0")
+}
+
+fn parse_setcc_nonnegative(line: &str) -> Option<&str> {
+    for mnem in ["setne", "setnz", "seta", "setnb", "setae", "setb"] {
+        if let Some(reg) = line.strip_prefix(&format!("{mnem} ")) {
+            let reg = reg.trim();
+            return reg.starts_with('%').then_some(reg);
+        }
+    }
+    None
+}
+
