From fe4a31dece2175eb29607011764d5d3cc04d5f93 Mon Sep 17 00:00:00 2001
From: lccc-v13 <v13@localhost>
Date: Fri, 14 Aug 2026 07:29:40 +0000
Subject: [PATCH 1/3] tests: rename regression suite to descriptive names, drop
 revision markers

All test names that carried patch-revision prefixes are renamed to sound,
descriptive identifiers (a name that says WHAT the test covers, not which
revision added it):

  v8_range_check_fold -> range_check_fold
  v8_fp_die_at_birth -> fp_die_at_birth
  v9_short_circuit_sidefx -> short_circuit_side_effects
  v9_gpr_unary_hints -> gpr_unary_hints
  v9_cast_chain_fold -> cast_chain_fold
  v9_flag_fusion_cast -> flag_fusion_cast
  v11_cmp_narrowing -> cmp_narrowing
  v12_flat_short_circuit -> flat_short_circuit
  v12_range_fold_edges -> range_fold_edges
  v12_alu_peepholes -> alu_peepholes
  v12_bitops -> bitops_builtins
  v12_fp_param -> fp_param_regalloc
  v12_dead_param -> dead_param_store
  v12_alu_chains -> alu_chain_codegen
  v12_reassoc_accum -> accumulator_reassociation
  regr_v1..v11_* -> their descriptive suffixes (volatile_loop, abs_symbol_value,
  loop_alloca_scalar, m64_codegen, memcpy_chain_crossblock, pic_extern_addr,
  reduction_two_sums, state_leak, temp_promotion_window, tls_local_pic,
  cmp_replay, fp_cmp_inf, ivsr_addself, select_direct_cmov, sqlite_vdbe_peephole,
  sqlite_yy_shift, clmul256, set_epi32_order, volatile_inf, cond_reduction,
  pgo_split_label, value_profiling, switch_table, pgo_branchy, pgo_flat,
  costaware_devirt)

Header comments drop the revision tags; the .flags/.env companions move with
their tests; run_pgo_roundtrip.sh and the audit/source cross-references are
updated; the per-test profile paths lose their revision suffixes. Regression
suite 142 passed / 0 failed, PGO roundtrip script verified end-to-end.
