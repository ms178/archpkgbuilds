index 0000000000000000000000000000000000000000..60fb56d04d9913ef3e889431a8146bcedf9cedf0
--- /dev/null
+++ b/tests/regression/caller_save_return_value.c
@@ -0,0 +1,22 @@
+/* Phase-2b regression: a value born at a call must never be restored from a
+   pre-call spill slot, which would overwrite the fresh return value. */
+#include <stdint.h>
+#include <stdio.h>
+
+static uint64_t noinline_mix(uint64_t value, uint64_t salt) {
+    return (value ^ (salt + UINT64_C(0x9e3779b97f4a7c15)))
+           * UINT64_C(0xbf58476d1ce4e5b9);
+}
+
+static uint64_t chain(uint64_t seed) {
+    uint64_t a = noinline_mix(seed, UINT64_C(3));
+    uint64_t b = noinline_mix(seed + UINT64_C(7), a);
+    uint64_t c = noinline_mix(a ^ b, seed + UINT64_C(11));
+    return a ^ b ^ c;
+}
+
+int main(void) {
+    uint64_t got = chain(UINT64_C(0x0123456789abcdef));
+    printf("%016llx\n", (unsigned long long)got);
+    return got != UINT64_C(0x33315747a4df73bf);
+}
diff --git a/tests/regression/cfg_phi_web.c b/tests/regression/cfg_phi_web.c
