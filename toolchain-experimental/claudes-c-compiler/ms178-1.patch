diff --git a/tests/regression/fp_domain_crossing.c b/tests/regression/fp_domain_crossing.c
new file mode 100644
index 0000000..95b05ba
--- /dev/null
+++ b/tests/regression/fp_domain_crossing.c
@@ -0,0 +1,23 @@
+#include <stdio.h>
+#include <math.h>
+#define CHECK(tag, got, expect, tol) do { \
+    double _d = (got) - (expect); if (_d < 0) _d = -_d; \
+    printf("%s: %s\n", tag, _d <= (tol) ? "OK" : "FAIL"); \
+} while(0)
+static double fp_chain(double a, double b, double c) { return (a+b)*c-a/b; }
+static double fp_accum(int n) { double s=0; for(int i=1;i<=n;i++) s+=1.0/(double)i; return s; }
+static double int_to_fp(int a, int b, int c) { return (double)a*(double)b+(double)c; }
+static double fp_across_call(double a, double b, double c) { return sqrt(a*b+c)*a-b; }
+static double fp_select(double a, double b, int c) { return (c?a:b)*2.0; }
+static double fp_cmp(double a, double b) { return a>b?a-b:b-a; }
+int main(void) {
+    CHECK("fp_chain", fp_chain(1.5,2.5,3.0), (1.5+2.5)*3.0-1.5/2.5, 1e-12);
+    CHECK("fp_accum", fp_accum(1000), 7.485470860550345, 1e-10);
+    CHECK("int_to_fp", int_to_fp(3,4,5), 17.0, 1e-12);
+    CHECK("fp_sqrt", fp_across_call(3.0,4.0,5.0), sqrt(17.0)*3.0-4.0, 1e-12);
+    CHECK("sel_t", fp_select(3.0,4.0,1), 6.0, 1e-12);
+    CHECK("sel_f", fp_select(3.0,4.0,0), 8.0, 1e-12);
+    CHECK("cmp_a", fp_cmp(5.0,3.0), 2.0, 1e-12);
+    CHECK("cmp_b", fp_cmp(3.0,5.0), 2.0, 1e-12);
+    return 0;
+}
