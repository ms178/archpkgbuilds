+        let c = ctx(&slots, &types, &uses, &busy, &empty);
+        let insts = vec![MachInst::Mov128 {
+            src: MachOperand::Mem {
+                base: vreg(30),
+                offset: 0,
+            },
+            dst: MachOperand::Mem {
+                base: vreg(31),
+                offset: 0,
+            },
+        }];
