+            nf: false,
+            force_evex: false,
+            vex_hint: None,
+            force_rex2: false,
+            dfv: 0,
+        }
+    }
+
+    fn reg(name: &str) -> Operand {
+        Operand::Register(Register {
+            name: name.to_owned(),
+            mask: None,
+            zeroing: false,
+            broadcast: None,
