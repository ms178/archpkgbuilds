+| `globals.rs` | Global symbol addressing: direct `ADRP`+`ADD`, GOT-indirect `ADRP`+`LDR`, and model-correct TLS LE, IE and TLSDESC dynamic sequences. |
 | `returns.rs` | Return value handling: integer returns in `x0`, F32 in `s0`, F64 in `d0`, F128 in `q0` (with `__extenddftf2` promotion), I128 in `x0:x1`, struct return via `x8` (sret pointer), and second-slot float returns in `d1`/`s1`. |
 | `variadic.rs` | Variadic function support: `va_arg` implementation (GP register save area at offset 24, FP register save area at offset 28), `va_start` initialization of the `va_list` struct (stack pointer, `gr_top`, `vr_top`, `gr_offs`, `vr_offs`), and `va_copy`. |
 | `inline_asm.rs` | Inline assembly template substitution: `%0`/`%[name]` positional and named operand references, `%w`/`%x`/`%s`/`%d`/`%q`/`%c`/`%a` register modifiers, GCC `r0`-`r30` alias normalization, and `%%` literal percent. |
@@ -313,11 +313,31 @@ Regular extern symbols use direct PC-relative ADRP+ADD even in PIC/PIE mode,
 since this is inherently position-independent and works correctly for
 statically-linked executables and early boot code (pre-MMU).
 
-**Thread-Local Storage (TLS):**
+**Thread-Local Storage (TLS):** the selected ELF model is honored rather than
+assuming Local Exec. LE uses `TPIDR_EL0` plus TPREL relocations; IE loads a
+TP-relative offset from the GOT; GD/LD use the AArch64 TLSDESC ABI and retain
+its call-site relocation so a static linker can relax the sequence.
+
 ```asm
-    mrs  x0, tpidr_el0              // read thread pointer
-    add  x0, x0, :tprel_hi12:sym   // add high 12 bits of TLS offset
-    add  x0, x0, :tprel_lo12_nc:sym // add low 12 bits of TLS offset
+    // Local Exec
+    mrs  x0, tpidr_el0
+    add  x0, x0, :tprel_hi12:sym
+    add  x0, x0, :tprel_lo12_nc:sym
+
+    // Initial Exec
+    adrp x0, :gottprel:sym
+    ldr  x0, [x0, :gottprel_lo12:sym]
+    mrs  x1, tpidr_el0
+    add  x0, x1, x0
+
+    // TLSDESC dynamic
+    mrs  x1, tpidr_el0
+    adrp x0, :tlsdesc:sym
+    ldr  x2, [x0, :tlsdesc_lo12:sym]
+    add  x0, x0, :tlsdesc_lo12:sym
+    .tlsdesccall sym
+    blr  x2
+    add  x0, x1, x0
 ```
 
 ### Stack-Relative Addressing
diff --git a/src/backend/arm/codegen/globals.rs b/src/backend/arm/codegen/globals.rs
index 58bcff81a8fba4d35d6188c6b8f2c862c293ac0a..466f12c6d29e460f07e8904d92b0be2fef534906 100644
--- a/src/backend/arm/codegen/globals.rs
+++ b/src/backend/arm/codegen/globals.rs
@@ -1,7 +1,7 @@
 //! ArmCodegen: global address operations.
 
 use super::emit::ArmCodegen;
-use crate::ir::reexports::Value;
+use crate::ir::reexports::{TlsModel, Value};
 
 impl ArmCodegen {
     pub(super) fn emit_global_addr_impl(&mut self, dest: &Value, name: &str) {
@@ -26,11 +26,46 @@ impl ArmCodegen {
     }
 
     pub(super) fn emit_tls_global_addr_impl(&mut self, dest: &Value, name: &str) {
-        self.state.emit("    mrs x0, tpidr_el0");
-        self.state
-            .emit_fmt(format_args!("    add x0, x0, :tprel_hi12:{}", name));
-        self.state
-            .emit_fmt(format_args!("    add x0, x0, :tprel_lo12_nc:{}", name));
+        match self.state.tls_model_for_symbol(name) {
+            TlsModel::LocalExec => {
+                self.state.emit("    mrs x0, tpidr_el0");
+                self.state
+                    .emit_fmt(format_args!("    add x0, x0, :tprel_hi12:{}", name));
+                self.state
+                    .emit_fmt(format_args!("    add x0, x0, :tprel_lo12_nc:{}", name));
+            }
+            TlsModel::InitialExec => {
+                // The GOT entry contains a TP-relative offset. Keep the offset
+                // and thread pointer in the backend's reserved x0/x1 scratch
+                // pair so no allocator home is disturbed.
+                self.state
+                    .emit_fmt(format_args!("    adrp x0, :gottprel:{}", name));
+                self.state
+                    .emit_fmt(format_args!("    ldr x0, [x0, :gottprel_lo12:{}]", name));
+                self.state.emit("    mrs x1, tpidr_el0");
+                self.state.emit("    add x0, x1, x0");
+            }
+            TlsModel::GlobalDynamic | TlsModel::LocalDynamic => {
+                // AArch64's TLSDESC resolver returns a TP-relative offset in
+                // x0 under its special register-preserving ABI. The marker is
+                // required for static-link relaxation; the final two
+                // instructions materialize the address for unrelaxed DSOs.
+                // Read TP before the independent descriptor loads so its
+                // latency overlaps their address generation. The TLSDESC ABI
+                // preserves x1; x2 carries the resolver target.
+                self.state.emit("    mrs x1, tpidr_el0");
+                self.state
+                    .emit_fmt(format_args!("    adrp x0, :tlsdesc:{}", name));
+                self.state
+                    .emit_fmt(format_args!("    ldr x2, [x0, :tlsdesc_lo12:{}]", name));
+                self.state
+                    .emit_fmt(format_args!("    add x0, x0, :tlsdesc_lo12:{}", name));
+                self.state
+                    .emit_fmt(format_args!("    .tlsdesccall {}", name));
+                self.state.emit("    blr x2");
+                self.state.emit("    add x0, x1, x0");
+            }
+        }
         self.store_x0_to(dest);
     }
 }
