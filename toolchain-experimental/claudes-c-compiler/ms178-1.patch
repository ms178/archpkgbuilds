+# gcc_oracle_nopie_wrapper <gcc-binary> -> prints the path of a wrapper that
+# links -m32 executables non-PIE, so the GCC oracle links in the same mode as
+# lccc. Why: lccc's -m32 executables are non-PIE; a PIE GCC reference differs
+# in load address, relocation model and startup code, so output and crash
+# comparisons would not be like-for-like. Measured here (GNU ld 2.47 from the
+# pinned harness, GCC 16.2.0): default-PIE -m32 hello-world also runs, so the
+# -no-pie choice is about comparability, not a host crash. The wrapper adds
+# -no-pie only to -m32 LINKS; compile-only modes (-c -S -E -M -MM -fsyntax-only),
+# relocatable links (-r) and explicit link modes (-pie -no-pie -static
+# -static-pie -shared) pass through unchanged.
+gcc_oracle_nopie_wrapper() {
+    local real=$1 dir w q
+    dir="${XDG_CACHE_HOME:-$HOME/.cache}/lccc/gcc-oracle"
+    w="$dir/gcc-${GCC_ORACLE_MAJOR}-m32-nopie"
+    mkdir -p "$dir" || return 1
+    printf -v q '%q' "$real"
+    {
+        cat <<'WRAP'
+#!/bin/sh
+# Generated by tests/regression/lib/gcc_oracle.sh (see gcc_oracle_nopie_wrapper).
+m32=0; link=1
+for a in "$@"; do
+    case $a in
+        -m32) m32=1 ;;
+        -c|-S|-E|-M|-MM|-fsyntax-only|-r|-pie|-no-pie|-static|-static-pie|-shared) link=0 ;;
+    esac
+done
+if [ "$m32" = 1 ] && [ "$link" = 1 ]; then set -- -no-pie "$@"; fi
+WRAP
+        printf 'exec %s "$@"\n' "$q"
+    } > "$w.tmp.$$" || return 1
+    chmod 755 "$w.tmp.$$" && mv -f "$w.tmp.$$" "$w" || return 1
+    printf '%s\n' "$w"
+}
