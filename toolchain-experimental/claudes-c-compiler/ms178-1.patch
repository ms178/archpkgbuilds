+/// D (double, 64-bit) -> 0b01
+/// H (half, 16-bit)  -> 0b11
+/// ```
+pub(crate) fn fp_ftype_letter(letter: u8, mn: &str) -> Result<u32, String> {
+    match letter {
+        b's' => Ok(0b00),
+        b'd' => Ok(0b01),
+        b'h' => Ok(0b11),
+        _ => Err(format!(
+            "{mn}: this instruction has no `{}`-register form; it takes h, s or d",
+            char::from(letter)
+        )),
+    }
+}
