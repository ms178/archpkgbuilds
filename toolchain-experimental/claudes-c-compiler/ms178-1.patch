+                    let (x, c) = match (lhs, rhs) {
+                        (x, Operand::Const(c)) => (x, c.to_i64()?),
+                        (Operand::Const(c), x) => (x, c.to_i64()?),
+                        _ => return Some(opaque_var(*v)),
