+    fn fuses_when_loaded_register_is_truly_dead() {
+        let asm = "\
+    movslq 40(%rsp), %rax\n\
+    movq %rax, %rbp\n\
+    movslq 8(%rsp), %rax\n\
+    movslq heap_len(%rip), %r10\n\
+";
+        let (changed, out) = run(asm);
+        assert!(changed, "safe relay should fuse");
+        assert!(out[0].contains("%rbp"), "load retargeted to copy dest: {out:?}");
+    }
