+def format_seconds(value: float | None) -> str:
+    if value is None:
+        return "—"
+    if value < 1.0:
+        return f"{value * 1000.0:.2f} ms"
+    return f"{value:.4f} s"
+
+
+def format_ratio(value: float | None) -> str:
+    if value is None:
+        return "—"
+    if value < 1.0:
+        return f"{value:.3f} ({1.0 / value:.2f}× faster)"
+    return f"{value:.3f} ({value:.2f}× slower)"
