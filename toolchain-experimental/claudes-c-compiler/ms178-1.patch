+                                       // expected-note@#f20 {{'f20' declared here}}
+}
+
+// CHECK: fix-it:"{{.*}}":{[[@LINE+1]]:1-[[@LINE+1]]:1}:"{{\[\[}}gnu::format(strfmon, 3, 4)]] "
+void f21(char *out, const size_t len, const char *format, int x, int y) // #f21
+{
