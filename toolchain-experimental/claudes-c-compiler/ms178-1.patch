+#!/usr/bin/env python3
+"""Preparation is content-addressed and never overwrites a changed recipe."""
+import hashlib,os,pathlib,re,subprocess,tempfile
+ROOT=pathlib.Path(__file__).resolve().parents[2]; SCRIPT=ROOT/'scripts/prepare_kernel_tree.sh'
+CANARIES=['Makefile','scripts/Kbuild.include','init/main.c','kernel/workqueue.c','arch/x86/boot/setup.ld','include/generated/autoconf.h','include/generated/utsversion.h','arch/x86/include/generated/asm/rwonce.h','arch/x86/kernel/cpu/capflags.c','arch/x86/boot/zoffset.h','arch/x86/boot/voffset.h','arch/x86/boot/cpustr.h']
+with tempfile.TemporaryDirectory(prefix='lccc-provenance-') as td:
+ t=pathlib.Path(td); pkg=t/'pkg'; k=t/'linux-test'; b=t/'bin'; pkg.mkdir(); b.mkdir()
+ (pkg/'PKGBUILD').write_text("_major=6\n_minor=18\npkgrel=1\nsha256sums=('"+'0'*64+"')\nsource=(test.patch)\n"); (pkg/'config').write_text('CONFIG_TEST=y\n'); (pkg/'test.patch').write_text('patch payload\n')
+ cc=t/'lccc'; cc.write_text('#!/bin/sh\necho "lccc test 1.0"\n'); cc.chmod(0o755)
+ make=b/'make'; make.write_text('#!/bin/sh\nprintf "%s\\n" "$*" >> "$TEST_MAKE_LOG"\n'); make.chmod(0o755)
+ for name in CANARIES:
+  f=k/name; f.parent.mkdir(parents=True,exist_ok=True); f.write_text('canary\n')
+ env=dict(os.environ,PATH=str(b)+':'+os.environ['PATH'],PKGDIR=str(pkg),KERNEL_WORK=str(t),LCCC=str(cc),TEST_MAKE_LOG=str(t/'make.log'),LCCC_KERNEL_SOURCE_MODE='tarball')
+ def run(): return subprocess.run(['bash',str(SCRIPT),str(k)],env=env,capture_output=True,text=True)
+ (k/'.lccc-prepared').write_text('legacy stamp\n'); r=run(); assert r.returncode==3 and 'recipe mismatch/legacy stamp' in r.stderr,r.stderr
+ recipe=re.search(r'expected recipe=([0-9a-f]{64})',r.stderr).group(1); assert not (t/'make.log').exists()
+ compiler=subprocess.check_output([str(cc),'--version'],text=True).splitlines()[0]; first=f'compiler={cc} version={compiler} sha256={hashlib.sha256(cc.read_bytes()).hexdigest()}'
+ stamp=first+f'\nformat=2\nrecipe-sha256={recipe}\nsource=tarball\nconfig-input-sha256=original\n'; (k/'.lccc-prepared').write_text(stamp)
+ r=run(); assert r.returncode==0 and 'already prepared' in r.stdout,(r.stdout,r.stderr); assert not (t/'make.log').exists()
+ (pkg/'config').write_text('CONFIG_TEST=n\n'); r=run(); assert r.returncode==3 and 'recipe mismatch' in r.stderr; assert (k/'.lccc-prepared').read_text()==stamp
+ (pkg/'config').write_text('CONFIG_TEST=y\n'); cc.write_text('#!/bin/sh\necho "lccc test 1.0"\n# changed content\n'); r=run(); assert r.returncode==0 and 'compiler content changed' in r.stdout,(r.stdout,r.stderr)
+ log=(t/'make.log').read_text(); assert 'olddefconfig' in log and 'prepare' in log
+ new=(k/'.lccc-prepared').read_text(); assert f'recipe-sha256={recipe}' in new and 'config-input-sha256=original' in new and not new.startswith(first+'\n')
+ r=run(); assert r.returncode==0 and 'already prepared' in r.stdout
+ print('PASS kernel provenance: mismatch refusal, no-op, config identity, compiler invalidation, metadata preservation')
