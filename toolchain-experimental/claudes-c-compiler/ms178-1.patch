+    /// Encode EVEX vmovdqa64/vmovdqa32 reg<->mem (AVX-512, glibc dl-trampoline).
+    pub(crate) fn encode_evex_vmovdqa(&mut self, ops: &[Operand], is_64: bool) -> Result<(), String> {
