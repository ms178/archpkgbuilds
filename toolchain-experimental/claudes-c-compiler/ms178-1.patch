+  q=b.invoke(commands[arm],timeout_s=90,env=env);assert q['ok'] and q['stdout']==reference['stdout'];runs[arm]=q
+ report['rounds'].append({'round':n,'order':order,'runs':runs});publication.atomic_bytes(R/'mask-throughput.json',(json.dumps(report,indent=2)+'\n').encode())
+report['ratios']={ref:{metric:b.summarize([x['runs']['candidate'][metric]/x['runs'][ref][metric] for x in report['rounds']],107178) for metric in ['wall_s','child_cpu_s']} for ref in cc if ref!='candidate'};report['complete']=True;publication.atomic_bytes(R/'mask-throughput.json',(json.dumps(report,indent=2)+'\n').encode());print({ref:{k:(v['median'],v['median_ci95_bootstrap']) for k,v in m.items()} for ref,m in report['ratios'].items()},flush=True)
diff --git a/engineering/evidence/redteam106/mask_throughput.c b/engineering/evidence/redteam106/mask_throughput.c
new file mode 100644
index 00000000..ca4ddfab
--- /dev/null
+++ b/engineering/evidence/redteam106/mask_throughput.c
@@ -0,0 +1,19 @@
+/* Focused outlined-helper benchmark, NOT a replacement for the 45-workload
+ * corpus or the full zstd matrix. The 40-million-iteration workload is fixed.
+ * Unsigned recurrences and low-byte BZHI semantics are defined for every input. */
+#include <immintrin.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+__attribute__((noinline)) static uint64_t mask64(uint64_t x, unsigned n) { return _bzhi_u64(x,n); }
+__attribute__((noinline)) static uint32_t mask32(uint32_t x, unsigned n) { return _bzhi_u32(x,n); }
+int main(int argc,char **argv) {
+ uint64_t state=argc>1?strtoull(argv[1],0,10):1234567, sum=0;
+ for(unsigned i=0;i<40000000u;i++) {
+  state=state*UINT64_C(6364136223846793005)+1;
+  unsigned n=(unsigned)(state>>32);
+  sum+=mask64(state,n) ^ mask32((uint32_t)state,n);
+ }
+ printf("%llu\n",(unsigned long long)sum);
+ return 0;
+}
