diff --git a/tests/regression/shift_count_demand.c b/tests/regression/shift_count_demand.c
new file mode 100644
index 000000000..8ba287ffc
--- /dev/null
+++ b/tests/regression/shift_count_demand.c
@@ -0,0 +1,65 @@
+/* x86 shifts mask their counts in hardware, so C-level masks that only feed
+ * shift counts are redundant on x86-64 (zstd's BIT_lookBits spells them out
+ * for portability). The rewrite must drop exactly those masks and keep every
+ * mask whose bits are observable. All shifts here are defined for any count. */
+#include <stdio.h>
+
+typedef unsigned long long u64;
+typedef long long i64;
+
+/* zstd BIT_lookBits: both masks go, 63 - nb becomes ~nb. */
+__attribute__((noinline)) u64 look_bits(u64 c, unsigned consumed, unsigned nb) {
+  return (c << (consumed & 63)) >> 1 >> ((63 - nb) & 63);
+}
+/* 64 - n is -n modulo 64. */
+__attribute__((noinline)) u64 high_bits(u64 x, unsigned n) { return x >> ((64 - n) & 63); }
+/* A wider mask covers the six demanded bits; arithmetic shift. */
+__attribute__((noinline)) i64 sar_wide_mask(i64 x, unsigned n) { return x >> (n & 127); }
+/* 32-bit shifts read five bits. */
+__attribute__((noinline)) unsigned shl32(unsigned x, unsigned n) {
+  return (x << (n & 31)) + (x >> ((31 - n) & 31));
+}
+/* 60 - n is neither -n nor ~n modulo 64: the subtract stays, the mask goes. */
+__attribute__((noinline)) u64 non_congruent(u64 x, unsigned n) { return x << ((60 - n) & 63); }
+
+/* Must keep: a 64-bit shift reads bit 5, which `& 31` clears. */
+__attribute__((noinline)) u64 keep_narrow_mask(u64 x, unsigned n) { return x << (n & 31); }
+/* Must keep: the masked count is also stored. */
+__attribute__((noinline)) u64 keep_escaping(u64 x, unsigned n, unsigned *out) {
+  unsigned m = n & 63;
+  *out = m;
+  return x >> m;
+}
+/* Must keep: the masked count is also an ordinary operand. */
+__attribute__((noinline)) u64 keep_arith(u64 x, unsigned n) {
+  unsigned m = n & 63;
+  return (x >> m) + m;
+}
+
+static u64 mix(u64 h, u64 v) { return (h ^ v) * 0x100000001b3ULL; }
+
+int main(void) {
+  static const u64 xs[] = {0, 1, 0x8000000000000001ULL, 0xdeadbeefcafef00dULL, ~0ULL,
+                           0x0123456789abcdefULL};
+  static const unsigned big[] = {0xffffffffu, 0x80000000u, 0x7fffffc0u, 0xffffffe1u};
+  u64 h = 0xcbf29ce484222325ULL;
+  unsigned sink = 0;
+  for (unsigned i = 0; i < sizeof xs / sizeof xs[0]; i++) {
+    u64 x = xs[i];
+    for (unsigned n = 0; n < 300 + sizeof big / sizeof big[0]; n++) {
+      unsigned k = n < 300 ? n : big[n - 300];
+      unsigned out = 0;
+      h = mix(h, look_bits(x, k, k * 7 + 3));
+      h = mix(h, high_bits(x, k));
+      h = mix(h, (u64)sar_wide_mask((i64)x, k));
+      h = mix(h, shl32((unsigned)x, k));
+      h = mix(h, non_congruent(x, k));
+      h = mix(h, keep_narrow_mask(x, k));
+      h = mix(h, keep_escaping(x, k, &out));
+      sink += out;
+      h = mix(h, keep_arith(x, k));
+    }
+  }
+  printf("%llu %u\n", h, sink);
+  return 0;
+}
diff --git a/tests/regression/sizeof_value_conversion.c b/tests/regression/sizeof_value_conversion.c
new file mode 100644
index 000000000..51683f406
--- /dev/null
+++ b/tests/regression/sizeof_value_conversion.c
@@ -0,0 +1,99 @@
+/* sizeof / _Alignof of value expressions: C11 6.3.2.1p2-p4 (lvalue, array
+ * and function conversions) apply to the operands of the comma and
+ * conditional operators, so `sizeof((0, arr))` is the size of a pointer.
+ * sizeof's "not converted" exception (6.5.3.4p4) covers only the operand as
+ * written.  GNU extensions: sizeof(void) == sizeof of a void-typed value ==
+ * sizeof(function designator) == 1.  Zero-length arrays keep size 0.
+ * Every value is compared against GCC by the regression runner; the
+ * constant-expression rows also pin that sema and lowering agree (an array
+ * bound or _Static_assert that disagreed would fail to compile). */
+#include <stdio.h>
+#include <stddef.h>
+
+int arr[4];
+char str17[17];
+struct holder { char c[17]; double d; } hold;
+struct zla { int n; char tail[0]; } zl;
+char (*pz)[0];
+void vfn(void) {}
+int ifn(int x) { return x; }
+void *vp;
+
+/* Constant-expression contexts: sema's evaluator must agree with lowering. */
+_Static_assert(sizeof((0, arr)) == sizeof(int *), "comma decays");
+_Static_assert(sizeof(1 ? arr : arr) == sizeof(int *), "conditional decays");
+_Static_assert(sizeof(arr) == 4 * sizeof(int), "operand itself not converted");
+_Static_assert(sizeof((0, ifn)) == sizeof(int (*)(int)), "function decays");
+_Static_assert(sizeof((0, "abc")) == sizeof(char *), "string literal decays");
+_Static_assert(sizeof("abc") == 4, "string literal operand not converted");
+_Static_assert(sizeof((0, (void)0)) == 1, "void value (GNU)");
+_Static_assert(sizeof(1 ? (void)0 : (void)0) == 1, "void conditional (GNU)");
+int autoconf_shape[sizeof((0, arr)) == sizeof(int *) ? 1 : -1];
+size_t g_comma = sizeof((0, arr));
+size_t g_cond = sizeof(0 ? arr : (int *)0);
+size_t g_void = sizeof((0, (void)0));
+size_t g_zla = sizeof(zl.tail);
+
+static struct holder mk(void) { return hold; }
+
+#define P(e) printf("%-34s %zu\n", #e, (size_t)(e))
+
+int main(void)
+{
+    int local[3];
+    __typeof__((0, arr)) t_comma = 0;   /* int * */
+    __typeof__(1 ? arr : arr) t_cond = 0; /* int * */
+
+    P(sizeof(arr));
+    P(sizeof((arr)));
+    P(sizeof((0, arr)));
+    P(sizeof(1 ? arr : arr));
+    P(sizeof(0 ? arr : (int *)0));
+    P(sizeof(1 ? (int *)0 : arr));
+    P(sizeof((0, local)));
+    P(sizeof(1 ? local : arr));
+    P(sizeof((0, str17)));
+    P(sizeof((0, hold.c)));
+    P(sizeof((0, mk().c)));
+    P(sizeof(hold.c));
+    P(sizeof((0, "abc")));
+    P(sizeof(1 ? "abc" : "de"));
+    P(sizeof("abc"));
+    P(sizeof((0, ifn)));
+    P(sizeof(1 ? ifn : ifn));
+    P(sizeof(ifn));
+    P(sizeof(&arr));
+    P(sizeof(*&arr));
+    P(sizeof(arr + 0));
+    P(sizeof((0, 0, arr)));
+    P(sizeof(((void)0, arr)));
+    P(sizeof(void));
+    P(sizeof((void)0));
+    P(sizeof(*vp));
+    P(sizeof(vfn()));
+    P(sizeof((0, (void)0)));
+    P(sizeof((0, vfn())));
+    P(sizeof(1 ? (void)0 : (void)0));
+    P(sizeof(1 ? vfn() : vfn()));
+    P(sizeof(zl.tail));
+    P(sizeof(zl));
+    P(sizeof(*pz));
+    P(sizeof((0, *pz)));
+    P(sizeof((0, zl.tail)));
+    P(sizeof(t_comma));
+    P(sizeof(t_cond));
+    P(_Generic((0, arr), int *: 1, default: 0));
+    P(_Generic(1 ? arr : arr, int *: 1, default: 0));
+    P(_Alignof(void));
+    P(__alignof__((0, arr)));
+    P(__alignof__(arr));
+    P(__alignof__((0, str17)));
+    P(__alignof__((0, (void)0)));
+    P(sizeof(autoconf_shape));
+    P(g_comma);
+    P(g_cond);
+    P(g_void);
+    P(g_zla);
+    (void)t_comma; (void)t_cond;
+    return 0;
+}
diff --git a/tests/regression/static_assert_sema.c b/tests/regression/static_assert_sema.c
new file mode 100644
index 000000000..d896a375e
--- /dev/null
+++ b/tests/regression/static_assert_sema.c
@@ -0,0 +1,31 @@
+/*
+ * _Static_assert conditions that need type information (sizeof, offsetof,
+ * _Alignof, _Generic, enumerator types, builtins) are decided by sema at
+ * their lexical position. All of these hold on x86-64, i686 and AArch64; the
+ * failing counterparts are generated by check_static_assert_sema.sh.
+ */
+#include <stddef.h>
+
+#define TY(x) _Generic((x), int: 1, unsigned: 2, default: 0)
+enum Small { SA };
+enum Wide { WA, WB = 0x80000000u };
+struct S { int a; _Static_assert(sizeof(int) == 4, "member"); char b; };
+_Static_assert(sizeof(struct S) == 8 && offsetof(struct S, b) == 4, "layout");
+_Static_assert(_Alignof(int) == 4, "alignof");
+_Static_assert(__builtin_types_compatible_p(int, signed), "builtin");
+_Static_assert(TY(SA) == 1 && TY(WA) == 2 && sizeof(WA) == 4, "enum types");
+_Static_assert(sizeof(char[3][5]) == 15);
+
+int main(void)
+{
+    enum { L = 0x80000000u };
+    _Static_assert(TY(L) == 2, "block enumerator");
+    {
+        enum Small { SV = -5 };
+        _Static_assert(TY(SV) == 1, "shadowing enumerator");
+        struct T { _Static_assert(sizeof(enum Small) == 4, "nested member"); int x; } t = { 0 };
+        (void)t;
+    }
+    _Static_assert(TY(SA) == 1, "outer enumerator");
+    return 0;
+}
diff --git a/tests/regression/static_init_string_constants.c b/tests/regression/static_init_string_constants.c
new file mode 100644
index 000000000..70bd62ad2
--- /dev/null
+++ b/tests/regression/static_init_string_constants.c
@@ -0,0 +1,54 @@
+/* String and function-name address constants in static initializers, and
+ * __builtin_constant_p on them; every value is GCC 16.2's (-O0 and -O2).
+ *
+ * lccc stored `.f = 1 ? "x" : "y"` in a struct field, and `0 ? "c" : "d"` in a
+ * pointer array, as a NULL pointer without a diagnostic: the initializer
+ * classifiers did not look inside `?:` and the byte-buffer path wrote 0 for
+ * any element it could not evaluate. The kernel's dynamic-debug descriptors
+ * (`.format = __builtin_constant_p(MOD ": ...") ? MOD ": ..." : ...`) and
+ * tracepoint strings (`static const char *s = __func__;`) are the shapes.
+ */
+#include <stdio.h>
+
+struct t { const char *f; unsigned n; };
+struct u { const char *f; };
+static const struct t s1 = { .f = 1 ? "s1" : "no", .n = 1 };
+static const struct t s2 = { 0 ? "no" : "s2", 2 };
+static const struct u s3 = { (1 ? "s3" : "no") };
+static const char *arr[] = { 1 ? "a0" : "no", 0 ? "no" : "a1" };
+static const char *p1 = 1 ? "p1" : "no";
+static const struct t dd = {
+    .f = __builtin_constant_p("bm" ": register: ") ? "bm" ": register: " : "bm",
+    .n = 4,
+};
+
+int gv;
+int ga[4];
+void fn(void) {}
+
+/* GCC's fold_builtin_constant_p: 1 for a string literal's address through
+ * no-op conversions (pointer casts, pointer-width integers), `&"x"`, and a
+ * constant-condition `?:`; 0 for pointer arithmetic, dereferences, objects,
+ * functions, __func__ and the comma operator. */
+#define LIST                                                                   \
+    X("x") X(("x")) X("x" + 1) X((const char *)"x") X((void *)"x") X(&"x")     \
+    X((long)"x") X(&gv) X(ga) X(fn) X(&ga[1]) X(sizeof "x") X(1 ? "a" : "b")   \
+    X(("a", "b")) X((char)(long)"x")
+#define X(e) __builtin_constant_p(e),
+static const int in_init[] = { LIST };
+
+static const char *name(void) { static const char *s = __func__; return s; }
+static const char *name_tail(void) { static const char *s = __func__ + 4; return s; }
+static const char *pretty(void) { static const char *s = __PRETTY_FUNCTION__; return s; }
+static int same_object(void) { static const char *s = __func__; return s == __func__; }
+
+int main(void)
+{
+    const int in_code[] = { LIST };
+    printf("%s %s %s %s %s %s %u\n", s1.f, s2.f, s3.f, arr[0], arr[1], p1, s1.n + s2.n);
+    printf("%s %u\n", dd.f, dd.n);
+    for (unsigned i = 0; i < sizeof in_init / sizeof *in_init; i++)
+        printf("%d%d ", in_init[i], in_code[i]);
+    printf("\n%s [%s] %s %d\n", name(), name_tail(), pretty(), same_object());
+    return 0;
+}
