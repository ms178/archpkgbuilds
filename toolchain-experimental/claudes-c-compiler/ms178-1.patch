+                } else if fv < -170141183460469231731687303715884105728.0 {
+                    Some(IrConst::I128(i128::MIN))
+                } else {
+                    Some(IrConst::I128(fv as i128))
+                }
+            }
+            IrType::U128 => {
+                if fv >= 340282366920938463463374607431768211456.0 {
