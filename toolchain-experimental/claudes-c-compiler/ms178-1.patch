+const INSN_PREFIXES: &[&str] = &[
+    "lock", "rep", "repe", "repz", "repne", "repnz", "notrack", "bnd", "xacquire", "xrelease",
+    "cs", "ds", "es", "fs", "gs", "ss", "data16", "data32", "addr16", "addr32", "rex32", "rex64",
+];
