         CCC_VALIDATE_SSA=1 CCC_VERIFY_IR=abort "$CCC" -O"$opt" -march="$arch" \
             -ffp-contract=off "$oracle" -o "$work/oracle"
diff --git a/tests/regression/check_frame_gep_direct.py b/tests/regression/check_frame_gep_direct.py
new file mode 100755
index 000000000..8057c7d79
--- /dev/null
+++ b/tests/regression/check_frame_gep_direct.py
@@ -0,0 +1,104 @@
+#!/usr/bin/env python3
+"""Constant-offset frame addresses must address memory directly.
+
+`tests/regression/frame_gep_direct.c` keeps eight escaped FSE-like states in
+one local struct under high register pressure (zstd's sequence decoder shape).
+A compiler that spills `&q.s[k]` and reloads that pointer before every field
+access pays an extra dependent load per access. Fail on any reloaded spilled
+frame address that is then dereferenced, and require the exact GCC output.
+The pre-fix compiler emitted eight such reload/dereference pairs here.
+"""
+import argparse
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+SOURCE = ROOT / 'tests/regression/frame_gep_direct.c'
+
+
+def reloaded_frame_derefs(lines):
+    frame_regs, spills, found = {}, {}, []
+    for index, line in enumerate(lines):
+        text = line.strip()
+        lea = re.fullmatch(r'leaq (-?\d+)\(%r[sb]p\), %(r\w+)', text)
+        if lea:
+            frame_regs[lea.group(2)] = lea.group(1)
+            continue
+        store = re.fullmatch(r'movq %(r\w+), (-?\d+\(%r[sb]p\))', text)
+        if store and store.group(1) in frame_regs:
+            spills[store.group(2)] = frame_regs[store.group(1)]
+            continue
+        reload = re.fullmatch(r'movq (-?\d+\(%r[sb]p\)), %(r\w+)', text)
+        if reload and reload.group(1) in spills:
+            reg = reload.group(2)
+            for later in lines[index + 1:index + 4]:
+                if re.search(r'\(%' + reg + r'\)', later):
+                    found.append((index + 1, text, later.strip()))
+        written = re.fullmatch(r'\S+ .*, %(r\w+)', text)
+        if written and written.group(1) in frame_regs:
+            frame_regs.pop(written.group(1))
+    return found
+
+
+def selftest():
+    bad = ['leaq 64(%rsp), %rax', 'movq %rax, 144(%rsp)', 'movq 144(%rsp), %rcx', 'movq (%rcx), %rdi']
+    good = ['leaq 64(%rsp), %rax', 'movq %rax, 144(%rsp)', 'movq 64(%rsp), %rdi']
+    clobbered = ['leaq 64(%rsp), %rax', 'addq $8, %rax', 'movq %rax, 144(%rsp)',
+                 'movq 144(%rsp), %rcx', 'movq (%rcx), %rdi']
+    assert len(reloaded_frame_derefs(bad)) == 1
+    assert not reloaded_frame_derefs(good)
+    assert not reloaded_frame_derefs(clobbered)
+
+
+def switched(disabled):
+    env = {k: v for k, v in os.environ.items() if k != 'CCC_NO_FRAME_GEP_DIRECT'}
+    if disabled:
+        env['CCC_NO_FRAME_GEP_DIRECT'] = '1'
+    return env
+
+
+def run(cmd, env=None):
+    result = subprocess.run(cmd, capture_output=True, text=True, env=env)
+    if result.returncode:
+        sys.exit(f'command failed: {" ".join(map(str, cmd))}\n{result.stderr}')
+    return result.stdout
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--lccc', default=os.environ.get('CCC', str(ROOT / 'target/fastbuild/lccc')))
+    parser.add_argument('--gcc', default=os.environ.get('GCC', 'gcc'))
+    args = parser.parse_args()
+    selftest()
+    with tempfile.TemporaryDirectory() as work:
+        work = Path(work)
+        asm = work / 'frame.s'
+        run([args.lccc, '-O2', '-march=x86-64-v3', '-S', SOURCE, '-o', asm], env=switched(False))
+        found = reloaded_frame_derefs(asm.read_text().splitlines())
+        if found:
+            sys.exit('FAIL: reloaded frame-address dereferences:\n' + '\n'.join(map(str, found)))
+        # Negative control: the kill switch restores the pre-fix code, so the
+        # detector demonstrably sees the defect and the switch reaches it.
+        control = work / 'frame-off.s'
+        run([args.lccc, '-O2', '-march=x86-64-v3', '-S', SOURCE, '-o', control], env=switched(True))
+        if not reloaded_frame_derefs(control.read_text().splitlines()):
+            sys.exit('FAIL: negative control: CCC_NO_FRAME_GEP_DIRECT=1 shows no reloaded '
+                     'frame-address dereference, so this fixture no longer exercises the fix')
+        run([args.gcc, '-O2', SOURCE, '-o', work / 'gcc'])
+        reference = run([work / 'gcc'])
+        for disabled in (False, True):
+            exe = work / f'lccc-{int(disabled)}'
+            run([args.lccc, '-O2', '-march=x86-64-v3', SOURCE, '-o', exe], env=switched(disabled))
+            mine = run([exe])
+            if mine != reference:
+                sys.exit(f'FAIL: output (CCC_NO_FRAME_GEP_DIRECT={int(disabled)}) {mine!r} != GCC {reference!r}')
+    print('check_frame_gep_direct: PASS (no reloaded frame addresses; negative control fires; '
+          'GCC output matches with and without the fix)')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tests/regression/check_inline_devirt_hot_leaf.py b/tests/regression/check_inline_devirt_hot_leaf.py
new file mode 100755
index 000000000..c85663091
--- /dev/null
+++ b/tests/regression/check_inline_devirt_hot_leaf.py
@@ -0,0 +1,125 @@
+#!/usr/bin/env python3
+"""Inliner contract for devirtualized per-iteration predicates.
+
+See `tests/regression/inline_devirt_hot_leaf.c`. The pre-change compiler left
+`call pred_a`/`call pred_b` in count_a/count_b: the template parameter had
+been constant-folded, but the IR still held an indirect call the inliner could
+not see. sum_a/sum_b carry the same shape in callers already past the
+caller-size cap, with scorers above the ordinary static limit; only the
+devirtualized hot-leaf budget inlines those. sum_i/sum_s repeat it with
+direct calls: the declared-inline scorer is admitted (hot-leaf direct
+extension), the plain-static one keeps the historical caps. matches_i/matches_s
+call a match-length scan WITH its own loop (zstd's ZSTD_count) on the match
+path of a capped caller's loop: the declared-inline scan is admitted (hot loop
+helper), the plain-static twin keeps the call.
+
+Gates:
+  * default build: no calls survive in count_a, count_b, sum_a or sum_b;
+  * default build: no call survives in sum_i or matches_i;
+  * default build: sum_s and matches_s keep their calls (direct plain-static
+    callees are deliberately not hot-leaf or hot-loop-helper candidates);
+  * negative controls: CCC_NO_INLINE_DEVIRT=1 must leave the predicate calls
+    in count_a/count_b, CCC_NO_INLINE_HOT_LEAF=1 must leave the scorer
+    calls in sum_a/sum_b while count_a/count_b stay inlined,
+    and CCC_NO_INLINE_HOT_DIRECT=1 must leave the calls in sum_i and
+    matches_i -- so the
+    check demonstrably detects each defect and each switch reaches its
+    extension;
+  * the program output matches GCC in the default build and with every
+    inliner extension switch set (a kill switch must stay correct).
+"""
+import argparse
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+SOURCE = ROOT / 'tests/regression/inline_devirt_hot_leaf.c'
+DEVIRT = ('count_a', 'count_b')
+HOT_LEAF = ('sum_a', 'sum_b')
+HOT_DIRECT = ('sum_i', 'matches_i')
+PLAIN_STATIC = ('sum_s', 'matches_s')
+SWITCHES = (
+    'CCC_NO_INLINE_DEVIRT',
+    'CCC_NO_INLINE_HOT_LEAF',
+    'CCC_NO_INLINE_JOINT_FIXPOINT',
+    'CCC_NO_INLINE_SNAPSHOT_REFRESH',
+    'CCC_NO_INLINE_SNAPSHOT_CLEANUP',
+    'CCC_NO_INLINE_CALLER_CLEANUP',
+    'CCC_NO_INLINE_HOT_DIRECT',
+)
+
+
+def calls_in(asm, name):
+    body = re.search(rf'^{name}:\n(.*?)^\.size {name},', asm, re.S | re.M)
+    if not body:
+        sys.exit(f'FAIL: function {name} not found')
+    return re.findall(r'^\s*call\s+(\S+)', body.group(1), re.M)
+
+
+def run(cmd, env=None):
+    result = subprocess.run(cmd, capture_output=True, text=True, env=env)
+    if result.returncode:
+        sys.exit(f'command failed: {" ".join(map(str, cmd))}\n{result.stderr}')
+    return result.stdout
+
+
+def switch_env(switch):
+    env = {k: v for k, v in os.environ.items() if k not in SWITCHES}
+    if switch:
+        env[switch] = '1'
+    return env
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--lccc', default=os.environ.get('CCC', str(ROOT / 'target/fastbuild/lccc')))
+    parser.add_argument('--gcc', default=os.environ.get('GCC', 'gcc'))
+    args = parser.parse_args()
+    with tempfile.TemporaryDirectory() as work:
+        work = Path(work)
+
+        def calls(switch, names):
+            asm = work / f'inline-{switch or "default"}.s'
+            run([args.lccc, '-O2', '-march=x86-64-v3', '-S', SOURCE, '-o', asm], switch_env(switch))
+            text = asm.read_text()
+            return {name: calls_in(text, name) for name in names}
+
+        default = calls(None, DEVIRT + HOT_LEAF + HOT_DIRECT + PLAIN_STATIC)
+        leftovers = {k: v for k, v in default.items() if v and k not in PLAIN_STATIC}
+        if leftovers:
+            sys.exit(f'FAIL: calls survived: {leftovers}')
+        kept = [name for name in PLAIN_STATIC if not default[name]]
+        if kept:
+            sys.exit(f'FAIL: the plain-static direct callee was inlined into the capped {kept}; '
+                     'direct plain-static calls must keep the historical caps')
+        direct = calls('CCC_NO_INLINE_HOT_DIRECT', DEVIRT + HOT_LEAF + HOT_DIRECT)
+        if not all(direct[name] for name in HOT_DIRECT) or any(direct[name] for name in DEVIRT + HOT_LEAF):
+            sys.exit(f'FAIL: negative control: CCC_NO_INLINE_HOT_DIRECT=1 must leave exactly the '
+                     f'sum_i and matches_i calls, got {direct}')
+        if not all(calls('CCC_NO_INLINE_DEVIRT', DEVIRT).values()):
+            sys.exit('FAIL: negative control: CCC_NO_INLINE_DEVIRT=1 no longer leaves the '
+                     'predicate calls, so this fixture no longer exercises devirtualization')
+        hot = calls('CCC_NO_INLINE_HOT_LEAF', DEVIRT + HOT_LEAF)
+        if not all(hot[name] for name in HOT_LEAF) or any(hot[name] for name in DEVIRT):
+            sys.exit(f'FAIL: negative control: CCC_NO_INLINE_HOT_LEAF=1 must leave exactly the '
+                     f'sum_a/sum_b scorer calls, got {hot}')
+
+        run([args.gcc, '-O2', SOURCE, '-o', work / 'gcc'])
+        reference = run([work / 'gcc'])
+        for switch in (None,) + SWITCHES:
+            exe = work / f'lccc-{switch or "default"}'
+            run([args.lccc, '-O2', '-march=x86-64-v3', SOURCE, '-o', exe], switch_env(switch))
+            mine = run([exe])
+            if mine != reference:
+                sys.exit(f'FAIL: output with {switch or "default build"} {mine!r} != GCC {reference!r}')
+    print('check_inline_devirt_hot_leaf: PASS (devirtualized predicates, hot leaves, the '
+          'declared-inline direct leaf and loop helper inlined; the plain-static direct twins '
+          'kept; all three negative controls fire; GCC output matches under every inliner switch)')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tests/regression/check_ivsr_domains.sh b/tests/regression/check_ivsr_domains.sh
index 86711a9ce..c4e1695c2 100644
--- a/tests/regression/check_ivsr_domains.sh
+++ b/tests/regression/check_ivsr_domains.sh
@@ -72,3 +72,31 @@ for opt in -O0 -O1 -O2 -O3 -Os -Oz; do
         done
     done
 done
+
+# A nonnegative signed mask carries a real [0, mask] range under -fwrapv.
+# Keep the TLS store-forwarding opportunity without reinstating signed UB.
+for lanes in 2 8 64 257; do
+    flags=(-O2 -fwrapv -ffp-contract=off -DPASSES=129 -DLANES="$lanes")
+    source=tests/benchmark/programs/tls_seg_access.c
+    gcc "${flags[@]}" "$source" -o "$td/tls-ref"
+    "$ccc" "${flags[@]}" "$source" -o "$td/tls"
+    CCC_NO_IV_WIDEN=1 "$ccc" "${flags[@]}" "$source" -o "$td/tls-off"
+    "$td/tls-ref" > "$td/tls-ref.out"
+    for arm in tls tls-off; do
+        "$td/$arm" > "$td/$arm.out"
+        cmp "$td/tls-ref.out" "$td/$arm.out"
+        if [[ ${LCCC_VERIFY_MEMCHECK:-0} == 1 ]]; then
+            valgrind --quiet --error-exitcode=97 "$td/$arm" > "$td/$arm.vg"
+            cmp "$td/tls-ref.out" "$td/$arm.vg"
+        fi
+    done
+    if [[ $lanes == 64 ]]; then
+        "$ccc" "${flags[@]}" -S "$source" -o "$td/tls.s"
+        awk '/^tls_pass:/{on=1} on{print} /^[[:space:]]*\.size[[:space:]]+tls_pass/{exit}' "$td/tls.s" > "$td/tls-pass.s"
+        [[ -s "$td/tls-pass.s" ]] || { echo 'FAIL: missing tls_pass assembly'; exit 1; }
+        if grep -q 'movslq' "$td/tls-pass.s"; then
+            echo 'FAIL: bounded masked IV still requires repeated sign extension'; exit 1
+        fi
+    fi
+    echo "wrapping signed masked TLS: lanes=$lanes PASS"
+done
diff --git a/tests/regression/check_nobits_org_parity.py b/tests/regression/check_nobits_org_parity.py
new file mode 100755
index 000000000..814069861
--- /dev/null
+++ b/tests/regression/check_nobits_org_parity.py
@@ -0,0 +1,231 @@
+#!/usr/bin/env python3
+"""Cross-target NOBITS and `.org` parity with GNU as, pinned.
+
+Every row is assembled by lccc for x86-64, i686, AArch64 and RISC-V and its
+outcome compared with the GAS verdict recorded below: the `.bss` sh_size (or
+an error) for the NOBITS rows, the section bytes (or an error) for the `.org`
+rows. The expectations were measured with GNU as 2.47 (x86-64, i686 via
+`--32`, AArch64) and Debian's GNU as 2.44 for RISC-V (`-march=rv64gc
+-mno-relax`); re-measure with `--oracle` (see below) instead of editing them.
+
+Why this gate exists: PR #844 made zero runs in x86 `.bss` a size but left
+AArch64/RISC-V refusing `char big[1 << 30];` ("fill directive ... exceeds
+the 268435456-byte limit"), kept three parse-time `.fill` caps that refused
+the very NOBITS case its writer accepted, and turned `.bss; .zero 16; .skip
+2f-1f` into an internal error. Separately, RISC-V dropped every `.org`
+(`.byte 1; .org 8; .byte 2` assembled to `01 02`) and AArch64 refused the
+kernel's ALTERNATIVE length check. Its x86-only sibling gate
+(check_sparse_bss_nobits.sh) could see none of that.
+
+DIVERGENCES are deliberate, each with its reason; every other row must match.
+
+Usage:
+  check_nobits_org_parity.py --lccc target/fastbuild/lccc
+      (lccc-i686, lccc-arm and lccc-riscv are taken from the same directory)
+  check_nobits_org_parity.py --lccc ... --oracle x86_64=AS aarch64=AS riscv64=AS
+      re-measure the pinned table against real assemblers and report drift.
+"""
+
+import argparse
+import os
+import subprocess
+import sys
+import tempfile
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from elf_probe import Elf  # noqa: E402
+
+G = 1 << 30
+
+# NOBITS rows: `.bss; .byte 0; FORM; after: .long 0`.
+NOBITS_FORMS = [
+    ".long 0", ".quad 0", ".zero 5", ".skip 3,1", ".space 5,9", ".fill 3,4,0",
+    ".fill 3,4,1", ".p2align 3", ".p2align 4,0x90", ".balign 8", ".org 64", ".org 64,7",
+    ".uleb128 0", ".sleb128 0", ".uleb128 1", ".byte 1", '.ascii ""', '.ascii "a"',
+    f".zero {G}", f".skip {G}", f".fill {G},1,0", f".space {G}", f".org {G}",
+    f".zero {16 * G}", f".fill {4 * G},4,0", ".p2align 30",
+    ".subsection 1\n.zero 8\n.subsection 0\n.zero 4",
+    "a1: .long b1 - a1\nb1:", "a2: .long b2 - a2 - 4\nb2:",
+    ".zero 16\n.skip 2f-1f\n1: .zero 4\n2:",
+]
+
+# GAS verdict per form: the .bss size, or None for an error. One column per
+# target where they differ (i686 wraps 16 GiB; LEB is fail-closed on arm/rv).
+ALL = ("x86_64", "i686", "aarch64", "riscv64")
+NOBITS_EXPECT = {
+    ".long 0": 9, ".quad 0": 13, ".zero 5": 10, ".skip 3,1": 8, ".space 5,9": 10,
+    ".fill 3,4,0": 17, ".fill 3,4,1": None, ".p2align 3": 12, ".p2align 4,0x90": 20,
+    ".balign 8": 12, ".org 64": 0x44, ".org 64,7": 0x44, ".uleb128 0": 6,
+    ".sleb128 0": 6, ".uleb128 1": None, ".byte 1": None, '.ascii ""': 5,
+    '.ascii "a"': None, f".zero {G}": G + 5, f".skip {G}": G + 5,
+    f".fill {G},1,0": G + 5, f".space {G}": G + 5, f".org {G}": G + 4,
+    f".zero {16 * G}": 16 * G + 5, f".fill {4 * G},4,0": 16 * G + 5,
+    ".p2align 30": G + 4,
+    ".subsection 1\n.zero 8\n.subsection 0\n.zero 4": 17,
+    # A label difference resolved after the store is a fixup, and GAS
+    # refuses any fixup in NOBITS -- even one that evaluates to zero.
+    "a1: .long b1 - a1\nb1:": None, "a2: .long b2 - a2 - 4\nb2:": None,
+    ".zero 16\n.skip 2f-1f\n1: .zero 4\n2:": 29,
+}
+
+# (target, form) -> (lccc's verdict, reason). None = error expected.
+DIVERGENCES = {
+    ("i686", f".zero {16 * G}"): (None, "GAS wraps the ELF32 size mod 2^32 to a 5-byte .bss; "
+                                       "lccc refuses (\"exceeds the ELF32 size limit\") instead of truncating"),
+    ("i686", f".fill {4 * G},4,0"): (None, "same ELF32 wrap"),
+    ("aarch64", ".uleb128 0"): (None, "LEB128 is fail-closed on AArch64/RISC-V: real inputs are "
+                                     "forward label differences that need GAS's relaxation (FOLLOWUP)"),
+    ("aarch64", ".sleb128 0"): (None, "same LEB128 gap"),
+    ("riscv64", ".uleb128 0"): (None, "same LEB128 gap"),
+    ("riscv64", ".sleb128 0"): (None, "same LEB128 gap"),
+    ("aarch64", ".uleb128 1"): (None, "fail-closed LEB128 (GAS also errors here)"),
+    ("riscv64", ".uleb128 1"): (None, "fail-closed LEB128 (GAS also errors here)"),
+    ("aarch64", ".zero 16\n.skip 2f-1f\n1: .zero 4\n2:"): (
+        None, "a forward-referenced .skip size is refused on AArch64/RISC-V (immediate "
+              "evaluation; x86 defers it) -- same forward-reference gap as LEB128"),
+    ("riscv64", ".zero 16\n.skip 2f-1f\n1: .zero 4\n2:"): (None, "same forward .skip gap"),
+    ("x86_64", ".subsection 1\n.zero 8\n.subsection 0\n.zero 4"): (
+        None, "x86 refuses .subsection: it used to be silently ignored, which is right for a "
+              ".bss size but places subsection-1 code inline in .text/.data; ordering it needs "
+              "cross-subsection jump relaxation, and no x86 producer emits it (FOLLOWUP)"),
+    ("i686", ".subsection 1\n.zero 8\n.subsection 0\n.zero 4"): (None, "same x86 .subsection refusal"),
+}
+
+# i686 rows whose GAS verdict is the ELF32 wrap of the x86-64 size, so the
+# x86-64 pin does not describe GAS --32 there.
+ELF32_WRAP_ROWS = {("i686", f".zero {16 * G}"), ("i686", f".fill {4 * G},4,0")}
+
+
+def alternative(orig, repl):
+    """The kernel ALTERNATIVE length check (arm64/riscv alternative-macros.h)."""
+    return (".text\n661:\n" + "\t.word 0x11111111\n" * orig + "662:\n"
+            ".pushsection .altinstr_replacement,\"a\"\n663:\n" + "\t.word 0x22222222\n" * repl +
+            "664:\n.popsection\n.org . - (664b-663b) + (662b-661b)\n"
+            ".org . - (662b-661b) + (664b-663b)\n\t.word 0x33333333\n")
+
+
+# `.org` rows (AArch64 and RISC-V): name -> (source, {section: hex} or None).
+ORG_ROWS = {
+    "data_abs": (".data\n.byte 1\n.org 8\n.byte 2\n", {".data": "010000000000000002"}),
+    "data_fill": (".data\n.byte 1\n.org 8, 0xaa\n.byte 2\n", {".data": "01aaaaaaaaaaaaaa02"}),
+    "dot_rel": (".data\n.byte 1\n.org . + 5\n.byte 2\n", {".data": "01000000000002"}),
+    "label_rel": (".data\nL0:\t.byte 1\n.org L0 + 16\n.byte 2\n",
+                  {".data": "01" + "00" * 15 + "02"}),
+    "set_sym": (".set N, 12\n.data\n.byte 1\n.org N\n.byte 2\n", {".data": "01" + "00" * 11 + "02"}),
+    "lead_org": (".org 4\n.word 0x12345678\n", {".text": "0000000078563412"}),
+    "text": (".text\n.word 0x01020304\n.org 12\n.word 0x05060708\n",
+             {".text": "04030201000000000000000008070605"}),
+    "two_x": (".data\nL1:\t.byte 1\n.org L1 * 2 + 4\n", {".data": "01000000"}),
+    "back": (".data\n.quad 1\n.org 4\n", None),
+    "fwd": (".data\n.org L9\n.byte 1\nL9:\t.byte 2\n", None),
+    "other_sec": (".text\nT0:\t.word 1\n.data\n.org T0 + 4\n", None),
+    "alt_equal": (alternative(2, 2), {".text": "111111111111111133333333",
+                                      ".altinstr_replacement": "2222222222222222"}),
+    "alt_short": (alternative(3, 1), None),
+    "alt_long": (alternative(1, 3), None),
+}
+
+
+def sections(path):
+    """name -> (sh_type, bytes or None for NOBITS, sh_size)."""
+    return {name: sec[:3] for name, sec in Elf(path).sections.items()}
+
+
+def assemble(cmd, src, workdir, tag):
+    s = os.path.join(workdir, tag + ".s")
+    o = os.path.join(workdir, tag + ".o")
+    with open(s, "w") as f:
+        f.write(src)
+    try:
+        r = subprocess.run(cmd + [s, "-o", o], capture_output=True, text=True, timeout=120)
+    except subprocess.TimeoutExpired:
+        return "timeout", None
+    if r.returncode != 0:
+        if r.returncode < 0 or "internal error" in r.stderr or "panicked" in r.stderr:
+            return "crash", r.stderr.strip()[-200:]
+        return "error", None
+    return "ok", sections(o)
+
+
+def nobits_outcome(cmd, form, workdir, tag):
+    status, secs = assemble(cmd, f"\t.bss\n\t.byte 0\n{form}\nafter:\n\t.long 0\n", workdir, tag)
+    if status != "ok":
+        return status if status != "error" else None
+    return secs[".bss"][2] if ".bss" in secs else 0
+
+
+def org_outcome(cmd, src, workdir, tag):
+    status, secs = assemble(cmd, src, workdir, tag)
+    if status != "ok":
+        return status if status != "error" else None
+    return {k: (v[1] or b"").hex() for k, v in secs.items()
+            if k in (".text", ".data", ".altinstr_replacement") and v[2]}
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--lccc", required=True)
+    ap.add_argument("--oracle", nargs="*", default=None,
+                    help="TARGET=ASSEMBLER pairs; re-measure the pinned table")
+    args = ap.parse_args()
+    bindir = os.path.dirname(os.path.abspath(args.lccc))
+    lccc = {"x86_64": [args.lccc, "-c"], "i686": [os.path.join(bindir, "lccc-i686"), "-c"],
+            "aarch64": [os.path.join(bindir, "lccc-arm"), "-c"],
+            "riscv64": [os.path.join(bindir, "lccc-riscv"), "-c"]}
+    for tgt, cmd in lccc.items():
+        if not os.access(cmd[0], os.X_OK):
+            print(f"FAIL: missing {tgt} compiler {cmd[0]}")
+            return 1
+    failures = 0
+    rows = 0
+    with tempfile.TemporaryDirectory() as td:
+        if args.oracle is not None:
+            gas = {}
+            for pair in args.oracle:
+                tgt, path = pair.split("=", 1)
+                gas[tgt] = {"x86_64": [path, "--64"], "aarch64": [path],
+                            "riscv64": [path, "-march=rv64gc", "-mno-relax"]}[tgt]
+            if "x86_64" in gas:
+                gas["i686"] = [gas["x86_64"][0], "--32"]
+            drift = 0
+            for tgt, cmd in gas.items():
+                for form in NOBITS_FORMS:
+                    got = nobits_outcome(cmd, form, td, "g")
+                    # The pinned GAS verdict must be what GAS says; a
+                    # divergence row pins lccc's verdict separately, so the
+                    # GAS column is checked for those rows too -- except the
+                    # i686 wrap rows, whose GAS column is the x86-64 value.
+                    want = NOBITS_EXPECT[form]
+                    if got != want and (tgt, form) not in ELF32_WRAP_ROWS:
+                        print(f"ORACLE {tgt} {form!r}: GAS {got}, pinned {want}")
+                        drift += 1
+                if tgt in ("aarch64", "riscv64"):
+                    for name, (src, want) in ORG_ROWS.items():
+                        got = org_outcome(cmd, src, td, "g")
+                        if got != want:
+                            print(f"ORACLE {tgt} .org {name}: GAS {got}, pinned {want}")
+                            drift += 1
+            print(f"oracle: {drift} unexplained difference(s)")
+        for tgt in ALL:
+            for form in NOBITS_FORMS:
+                want, why = DIVERGENCES.get((tgt, form), (NOBITS_EXPECT[form], None))
+                got = nobits_outcome(lccc[tgt], form, td, "l")
+                rows += 1
+                if got != want:
+                    failures += 1
+                    print(f"FAIL {tgt} nobits {form!r}: lccc {got}, want {want}"
+                          + (f" [divergence: {why}]" if why else ""))
+        for tgt in ("aarch64", "riscv64"):
+            for name, (src, want) in ORG_ROWS.items():
+                got = org_outcome(lccc[tgt], src, td, "l")
+                rows += 1
+                if got != want:
+                    failures += 1
+                    print(f"FAIL {tgt} .org {name}: lccc {got}, want {want}")
+    print(f"nobits/org parity: {rows - failures}/{rows} rows hold "
+          f"({len(DIVERGENCES)} pinned divergences)")
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tests/regression/check_rmw_index_zext_codegen.sh b/tests/regression/check_rmw_index_zext_codegen.sh
new file mode 100755
index 000000000..dd5fe5383
--- /dev/null
+++ b/tests/regression/check_rmw_index_zext_codegen.sh
@@ -0,0 +1,152 @@
+#!/usr/bin/env bash
+# ============================================================================
+# check_rmw_index_zext_codegen.sh -- `C[idx]++` on a 32-bit-indexed table is
+# ONE memory read-modify-write.
+#
+# The x86-64 emitter spells the shapes in rmw_index_zext.c as
+#
+#     movl %esi, %esi                 <- index zero-extension
+#     movl (%rdi, %rsi, 4), %r9d      <- load
+#     leal 1(%r9), %eax               <- 32-bit increment, ADDRESS-width base
+#     movl %esi, %esi                 <- redundant re-zero-extension
+#     movl %eax, (%rdi, %rsi, 4)      <- store
+#
+# and GCC 16.2 / Clang 23.1 emit one `addl $1, (%rdi, %rsi, 4)`.  Two defects
+# kept the trio alive: `memory_fold::parse_const_increment` compared the LEA
+# base `%r9` to the loaded `%r9d` textually, and the redundant self-zext that
+# separates increment and store is only deleted by the global phase, after
+# Phase 1's last `mem_rmw` run.
+#
+# Contracts:
+#   1. SEMANTICS.  The fixture's stdout equals the GCC oracle's at -O0..-O3,
+#      with the fold enabled and with `CCC_PEEPHOLE_SKIP=mem_rmw`.  The skip
+#      name is passed to the COMPILER (it is a compile-time knob; exporting it
+#      to the compiled program would test the default build twice).
+#   2. THE FOLD FIRES.  At -O2 every positive function holds exactly the
+#      expected fused instruction and no load/increment/store relay.
+#   3. NEGATIVE CONTROL.  inc_and_return returns the new value: it keeps its
+#      load and must not be fused.
+#   4. NARROW IMMEDIATES are in range for the operand width (`addb $44`, not
+#      a `addb $300` the assembler has to truncate).
+#   5. inc_alias: the index's zero-extension survives a memory-destination
+#      add, so exactly one `movl %edx, %edx` remains.
+#   6. MUTATION.  With `CCC_PEEPHOLE_SKIP=mem_rmw` contract 2's checker must
+#      FAIL; otherwise it would pass on a tree where the fold never runs.
+# ============================================================================
+set -euo pipefail
+
+here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+root=$(CDPATH= cd -- "$here/../.." && pwd)
+CCC=${CCC:-$root/target/fastbuild/lccc}
+GCC=${GCC:-gcc}
+[[ -x $CCC ]] || { echo "check_rmw_index_zext_codegen: lccc not found at $CCC" >&2; exit 1; }
+command -v "$GCC" >/dev/null 2>&1 || { echo "check_rmw_index_zext_codegen: no gcc oracle" >&2; exit 1; }
+
+src=$here/rmw_index_zext.c
+work=$(mktemp -d "${TMPDIR:-/tmp}/lccc-rmw-zext.XXXXXX")
+trap 'rm -rf "$work"' EXIT
+fail=0
+bad() { printf '  FAIL: %s\n' "$*" >&2; fail=1; }
+
+echo "  contract 1: oracle parity, -O0..-O3 x {default, CCC_PEEPHOLE_SKIP=mem_rmw}"
+"$GCC" -O2 -w "$src" -o "$work/ref"
+expected=$("$work/ref")
+for opt in -O0 -O1 -O2 -O3; do
+    for skip in "" mem_rmw; do
+        exe="$work/t${opt}${skip:+-$skip}"
+        if ! env ${skip:+CCC_PEEPHOLE_SKIP=$skip} "$CCC" "$opt" "$src" -o "$exe" >"$exe.log" 2>&1; then
+            bad "$opt [${skip:-default}]: lccc failed to build"; continue
+        fi
+        got=$("$exe") || { bad "$opt [${skip:-default}]: non-zero exit"; continue; }
+        [[ $got == "$expected" ]] || bad "$opt [${skip:-default}]: stdout differs from the GCC oracle"
+    done
+done
+
+"$CCC" -O2 -S "$src" -o "$work/on.s"
+CCC_PEEPHOLE_SKIP=mem_rmw "$CCC" -O2 -S "$src" -o "$work/off.s"
+
+# Contracts 2-5 on one assembly file; exit status 0 iff all hold.
+check() {
+    python3 - "$1" <<'PY'
+import re
+import sys
+
+text = open(sys.argv[1], encoding="utf-8").read()
+
+
+def body(name):
+    m = re.search(rf"(?ms)^{re.escape(name)}:\n(.*?)^\s*\.size\s+{re.escape(name)},", text)
+    if not m:
+        raise SystemExit(f"  FAIL: no assembly body for {name}")
+    return [
+        line.strip()
+        for line in m.group(1).splitlines()
+        if line.strip() and not line.strip().startswith((".", "#"))
+    ]
+
+
+failures = []
+MEM = r"\(%rdi, %r[a-z0-9]+, \d\)"
+positive = {
+    "inc_shr24": "addl $1,",
+    "inc_byte": "addl $1,",
+    "inc_shr8": "addl $1,",
+    "inc_mask": "addl $1,",
+    "inc_param": "addl $1,",
+    "add_param": "addl $7,",
+    "sub_param": "subl $3,",
+}
+for fn, want in positive.items():
+    lines = body(fn)
+    fused = [l for l in lines if re.fullmatch(rf"{re.escape(want)} {MEM}", l)]
+    loads = [l for l in lines if re.fullmatch(rf"movl {MEM}, %\w+", l)]
+    stores = [l for l in lines if re.fullmatch(rf"movl %\w+, {MEM}", l)]
+    if len(fused) != 1 or loads or stores:
+        failures.append(f"{fn}: want one `{want} (mem)` and no load/store relay; got {lines}")
+
+# Contract 3: the returned new value keeps its load.
+lines = body("inc_and_return")
+if not any(re.fullmatch(rf"movl {MEM}, %\w+", l) for l in lines):
+    failures.append(f"inc_and_return: the load is gone -- a live value was fused away: {lines}")
+
+# Contract 4: narrow immediates within the operand width.
+for fn, want in {
+    "add_byte_300": r"addb \$44, ",
+    "sub_byte_200": r"subb \$200, ",
+    "add_word_70000": r"addw \$4464, ",
+}.items():
+    lines = body(fn)
+    if not any(re.match(want, l) for l in lines):
+        failures.append(f"{fn}: want `{want.replace(chr(92), '')}(mem)`: {lines}")
+for l in re.findall(r"(?m)^\s*(?:add|sub)([bw]) \$(-?\d+),", text):
+    width, imm = l[0], int(l[1])
+    bits = 8 if width == "b" else 16
+    if not -(1 << (bits - 1)) <= imm < (1 << bits):
+        failures.append(f"out-of-range {bits}-bit immediate ${imm}")
+
+# Contract 5: one zero-extension of the shared index.
+lines = body("inc_alias")
+n = sum(1 for l in lines if l == "movl %edx, %edx")
+adds = sum(1 for l in lines if re.fullmatch(r"addl \$1, \(%r[a-z0-9]+, %rdx, 4\)", l))
+if n != 1 or adds != 2:
+    failures.append(f"inc_alias: want 2 memory adds and 1 `movl %edx, %edx`; got {lines}")
+
+for f in failures:
+    print("  FAIL:", f, file=sys.stderr)
+sys.exit(1 if failures else 0)
+PY
+}
+
+echo "  contracts 2-5: fused RMW per shape, live-value control, narrow immediates, one zext"
+check "$work/on.s" || bad "codegen contracts (see above)"
+
+echo "  contract 6: the same checker fails with the fold skipped"
+if check "$work/off.s" 2>/dev/null; then
+    bad "CCC_PEEPHOLE_SKIP=mem_rmw still satisfies contract 2: the checker or the knob is inert"
+fi
+
+if [[ $fail -ne 0 ]]; then
+    echo "check_rmw_index_zext_codegen: FAILED" >&2
+    exit 1
+fi
+echo "check_rmw_index_zext_codegen: PASS (oracle parity -O0..-O3 x skip, fused RMW on 7 shapes, live-value control, narrow immediates, mutation arm)"
