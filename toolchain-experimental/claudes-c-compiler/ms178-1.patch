+            echo "FAIL  $name (A/B Tier-2 sharing differential)"
+            echo "      default  : $(echo "$res" | head -2)"
+            echo "      notier2  : $(echo "$res_t2" | head -2)"
+            fail=$((fail+1)); ab_fail=$((ab_fail+1)); FAILED+=("$name:ab-tier2"); continue
+        fi
     fi
 
     pass=$((pass+1))
