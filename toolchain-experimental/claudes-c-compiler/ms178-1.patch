+    // byte_iv starts at iv_start*elem (the first scalar iteration's byte
+    // offset from the GEP bases) and advances width*elem per iteration.
+    let byte_iv = Value(next_val_id);
+    next_val_id += 1;
+    let byte_iv_next = Value(next_val_id);
+    next_val_id += 1;
