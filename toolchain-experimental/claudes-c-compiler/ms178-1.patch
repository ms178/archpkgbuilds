+    fn forwarded_switch(cycle: bool) -> IrFunction {
+        let mut func = IrFunction::new("forwarded_switch".into(), IrType::I32, vec![], false);
+        func.blocks = vec![
+            BasicBlock {
+                label: BlockId(0),
+                instructions: vec![Instruction::Copy {
+                    dest: Value(0),
