+        per_cc = {}
+        ok = True
+        for name, cc, env in compilers:
+            asm = compile_to_asm(cc, src, flags, env)
+            if asm is None:
+                skipped.append(f"{src.name}({name})")
+                ok = False
+                break
+            per_cc[name] = census(asm)
+        if not ok:
+            continue
+        fns = sorted(set(per_cc["A"]) & set(per_cc["B"]))
+        if args.kernels:
