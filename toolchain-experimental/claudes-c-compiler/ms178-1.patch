+def elf_e_type(path):
+    """Return the ELF e_type of `path` as "EXEC"/"DYN"/"REL"/..., or None.
+
+    Parsed from the header directly rather than from `readelf` text: readelf's
+    section-table columns shift when a name is long enough to wrap.
