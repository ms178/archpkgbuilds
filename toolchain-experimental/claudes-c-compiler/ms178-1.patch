+                        gep_base_is_loop_invariant(func, loop_blocks, *v, iv, iv_derived)
+                    }
+                    // GEP/BinOp/Cast/Load/Phi defined IN the loop: treat as
+                    // variant (fail closed).
+                    _ => false,
+                };
+            }
+        }
+    }
+    // Not defined in any loop block: defined before the loop — invariant.
+    true
+}
