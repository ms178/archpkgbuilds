+fn dominators(nodes: &[u32], edges: &[Edge], entry: u32) -> FxHashMap<u32, FxHashSet<u32>> {
+    let mut preds: FxHashMap<u32, Vec<u32>> = FxHashMap::default();
+    for e in edges {
+        preds.entry(e.dst).or_default().push(e.src);
+    }
