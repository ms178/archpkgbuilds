+def _build(root, extra):
+    """tar.gz bytes: one dir member for `root`, then `extra`."""
+    buf = io.BytesIO()
+    with tarfile.open(fileobj=buf, mode='w:gz') as t:
+        head = tarfile.TarInfo(root)
+        head.type = tarfile.DIRTYPE
+        head.mode = 0o755
+        t.addfile(head)
+        for member in extra:
