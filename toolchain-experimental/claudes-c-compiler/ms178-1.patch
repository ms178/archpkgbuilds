+    /// Pointer value `v` spilled in a frame slot (`Indirect`).
+    fn ptr_in_slot(cg: &mut I686Codegen, v: u32, slot: i64) {
+        cg.state.value_locations.insert(v, StackSlot(slot));
+    }
