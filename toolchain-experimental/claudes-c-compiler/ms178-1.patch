+        parts.push(nullpart());
+        let mut symbols = vec![sym("", 0, 0, false)];
+        for i in 0..NLINK {
+            parts.push((
+                sec(&format!(".text.f{i}"), CALL_RET, 16),
+                CALL_RET.to_vec(),
+                vec![rela(1, 1 + ((i + 1) % NLINK) as u32, R_X86_64_PC32, -4)],
