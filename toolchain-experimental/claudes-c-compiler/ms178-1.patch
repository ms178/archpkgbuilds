+                    [CC, "-c", "h.s", "-o", "h.o"],
+                    [CC, "-O1", "-fno-pic", "-c", "m.c", "-o", "m.o"],
+                    [CC, "-O1", "-fPIE", "-c", "m.c", "-o", "mpie.o"],
+                    [CC, "-c", "abs.s", "-o", "abs.o"],
