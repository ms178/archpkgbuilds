+        // from_ty that matches the width its source operand now holds.
+        if n > 0 {
+            for b in &func.blocks {
+                for inst in &b.instructions {
+                    if let Instruction::Cast {
+                        src: Operand::Value(v),
+                        from_ty,
+                        ..
+                    } = inst
+                    {
+                        if *v == Value(1) {
+                            assert_eq!(
+                                *from_ty,
+                                IrType::U64,
+                                "retained cast of the widened phi still declares {from_ty:?}"
+                            );
+                        }
+                    }
+                }
+            }
+        }
+    }
 }
