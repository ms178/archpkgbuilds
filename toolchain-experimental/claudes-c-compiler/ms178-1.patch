+  typeof(const int) aci = 0;
+  const typeof (*pi) aConstInt = 0;
+  int xx;
+  int *i;
+}
+
+void test2(void) {
+    int a;
+    short b;
+    __typeof__(a) (*f)(__typeof__(b));    
+}
