+        if ! diff -q "$work/stg.lccc" "$work/stg.oracle" >/dev/null; then
+            stg_ok=0; bad "staging output differs from $ORACLE at $cf:"; diff "$work/stg.lccc" "$work/stg.oracle" | head -8 | note
+        fi
