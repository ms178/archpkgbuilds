diff --git a/scripts/zstd_eval/asm_fn.py b/scripts/zstd_eval/asm_fn.py
new file mode 100755
index 000000000..226004f12
--- /dev/null
+++ b/scripts/zstd_eval/asm_fn.py
@@ -0,0 +1,29 @@
+#!/usr/bin/env python3
+"""Print one function's instructions from a .s file (no directives/comments).
+Handles GAS output from LCCC, GCC, Clang and ICX: a function label may carry a
+trailing `# @name` comment (Clang/ICX), operands may be tab-separated, and
+local `.L*` labels inside the body do not end it.
+usage: asmfn.py FILE.s FUNC [FUNC...]"""
+import re, sys
+
+LABEL = re.compile(r'^([A-Za-z_.$][\w.$]*):\s*(#.*)?$')
+text = open(sys.argv[1]).read().splitlines()
+for fn in sys.argv[2:]:
+    out, on = [], False
+    for line in text:
+        s = line.strip()
+        m = LABEL.match(s)
+        if not on:
+            on = bool(m and m.group(1) == fn)
+            continue
+        if m and not m.group(1).startswith('.L'):
+            break
+        if s.startswith('.size') or s == '.cfi_endproc':
+            break
+        if not s or m or s.startswith(('.', '#')):
+            continue
+        s = s.split('#', 1)[0].strip()  # trailing comment (`# kill:` etc.)
+        s = ' '.join(s.replace('\t', ' ').split())
+        out.append('    ' + s)
+    print(f'{fn}: {len(out)} insns')
+    print('\n'.join(out))
diff --git a/scripts/zstd_eval/asm_fn_counts.py b/scripts/zstd_eval/asm_fn_counts.py
new file mode 100755
index 000000000..c248506e8
--- /dev/null
+++ b/scripts/zstd_eval/asm_fn_counts.py
@@ -0,0 +1,51 @@
+#!/usr/bin/env python3
+"""Per-function instruction and stack-reference counts of a GAS .s file.
+
+usage: asm_fn_counts.py A.s [B.s]
+With one file, prints `name insns stackrefs` per function; with two, prints
+the functions that differ and the totals. Stack references are operands
+addressed off %rsp or %rbp.
+
+Every non-blank line inside a function that is not a label, a directive or a
+comment is an instruction, whatever its indentation: LCCC emits some
+instructions (conditional jumps among them) at column 0, and counting only
+indented lines would silently drop them from one compiler's side.
+"""
+import re
+import sys
+
+LABEL = re.compile(r'^[A-Za-z_.$][\w.$]*:\s*(#.*)?$')
+
+
+def load(path):
+    text = open(path).read()
+    out = {}
+    for m in re.finditer(r'^([A-Za-z_][\w.$]*):[^\n]*\n(.*?)\n\s*\.size\s+\1\b', text, re.S | re.M):
+        ins = []
+        for line in m.group(2).splitlines():
+            s = line.split('#', 1)[0].strip()
+            if s and not s.startswith('.') and not LABEL.match(s):
+                ins.append(s)
+        out[m.group(1)] = (len(ins), sum(('(%rsp)' in l) or ('(%rbp)' in l) for l in ins))
+    return out
+
+
+def main():
+    a = load(sys.argv[1])
+    if len(sys.argv) == 2:
+        for f, (n, s) in sorted(a.items()):
+            print(f'{f} {n} {s}')
+        return
+    b = load(sys.argv[2])
+    ta = [0, 0]
+    tb = [0, 0]
+    common = sorted(set(a) & set(b))
+    for f in common:
+        ta[0] += a[f][0]; ta[1] += a[f][1]; tb[0] += b[f][0]; tb[1] += b[f][1]
+        if a[f] != b[f]:
+            print(f'{f}: {a[f][0]}/{a[f][1]} -> {b[f][0]}/{b[f][1]}')
+    print(f'TOTAL insns {ta[0]} -> {tb[0]}  stackrefs {ta[1]} -> {tb[1]}  ({len(common)} functions)')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/scripts/zstd_eval/callgrind_ab.sh b/scripts/zstd_eval/callgrind_ab.sh
new file mode 100755
index 000000000..56e5667bc
--- /dev/null
+++ b/scripts/zstd_eval/callgrind_ab.sh
@@ -0,0 +1,17 @@
+#!/bin/sh
+# Callgrind Ir A/B of zstd CLI binaries on one input at levels 1/3/19
+# (compression: the cache model of scripts/benchmark_zstd.py). Every
+# decompression is checked byte-exact against the input.
+# usage: callgrind_ab.sh <input> <name=zstd-binary>...
+in=$1; shift; T=${TMPDIR:-/tmp}/zcg.$$; mkdir -p "$T"
+total() { callgrind_annotate "$1" 2>/dev/null | awk '/PROGRAM TOTALS/{gsub(",","",$1); print $1}'; }
+for l in 1 3 19; do for nb in "$@"; do n=${nb%%=*}; b=${nb#*=}
+  "$b" -q -f -$l "$in" -o "$T/ref$l.zst" 2>/dev/null
+  valgrind --tool=callgrind --I1=32768,8,64 --D1=32768,8,64 --LL=33554432,16,64 \
+      --callgrind-out-file="$T/c$l.$n" "$b" -q -f -$l "$in" -o "$T/o.zst" 2>/dev/null
+  valgrind --tool=callgrind --callgrind-out-file="$T/d$l.$n" "$b" -q -f -d "$T/ref$l.zst" -o "$T/o.raw" 2>/dev/null
+  cmp -s "$in" "$T/o.raw" || echo "ROUNDTRIP FAIL $n -$l"
+  printf "c-%s %-6s %s\n" $l "$n" "$(total "$T/c$l.$n")"
+  printf "d-%s %-6s %s\n" $l "$n" "$(total "$T/d$l.$n")"
+done; done
+echo "profiles: $T"
