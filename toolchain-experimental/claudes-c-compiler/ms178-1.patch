+                self.operand_to_t0(&args[1]);
+                self.state.emit("    fmv.d.x ft1, t0");
+                self.operand_to_t0(&args[2]);
+                self.state.emit("    fmv.d.x ft2, t0");
+                self.state.emit("    fmadd.d ft0, ft0, ft1, ft2");
+                self.state.emit("    fmv.x.d t0, ft0");
+                if let Some(d) = dest {
