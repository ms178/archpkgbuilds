From 78c2bb235143d9edb7a1918b0fb6f9b96fe02f02 Mon Sep 17 00:00:00 2001
From: Arena Agent <agent@arena.ai>
Date: Fri, 14 Aug 2026 22:32:36 +0000
Subject: [PATCH 5/5] linker: single-pass .gnu.hash end-of-chain marking (5x on
 20k-export .so)

The per-bucket end-of-chain rescan was O(buckets x symbols): for every
bucket the FULL hashed-symbol array was scanned to find its last member.
With glibc-sized export tables (nbuckets ~= symbol count rounded to a
power of two) this dominated shared-library emission time.

Since the dynsym tail is already bucket-sorted, one linear pass marks
entry i as end-of-chain iff entry i+1 hashes into a different bucket
(or i is last). Applied to both emit_exec and emit_shared.

Measured on a 20,000-export shared library (-fpic -O0):
  lccc before: 357 ms   after: 71 ms   (5.0x; GNU bfd: 56 ms)
Output byte-identical to the pre-fix binary (cmp) and dlopen/dlsym
lookups through the emitted .gnu.hash resolve first and last symbol
correctly. 82/82 linker tests, 149/149 regressions, 604/604 unit tests.
---
 src/backend/x86/linker/emit_exec.rs   | 20 ++++++++++----------
 src/backend/x86/linker/emit_shared.rs | 16 +++++++---------
 2 files changed, 17 insertions(+), 19 deletions(-)

diff --git a/src/backend/x86/linker/emit_exec.rs b/src/backend/x86/linker/emit_exec.rs
index 756d16f..1b2d4f2 100644
--- a/src/backend/x86/linker/emit_exec.rs
+++ b/src/backend/x86/linker/emit_exec.rs
@@ -286,16 +286,16 @@ pub(super) fn emit_executable(
         // Chain value = hash with bit 0 indicating end of chain
         gnu_hash_chains[i] = h & !1; // clear bit 0 (will set later for last in chain)
     }
-    // Mark the last symbol in each bucket chain with bit 0 set
-    for bucket_idx in 0..gnu_hash_nbuckets as usize {
-        if gnu_hash_buckets[bucket_idx] == 0 { continue; }
-        let mut last_in_bucket = 0;
-        for (i, &h) in hashed_sym_hashes.iter().enumerate() {
-            if (h % gnu_hash_nbuckets) as usize == bucket_idx {
-                last_in_bucket = i;
-            }
-        }
-        gnu_hash_chains[last_in_bucket] |= 1; // set end-of-chain bit
+    // Mark the last symbol of each bucket chain (bit 0). Symbols are already
+    // bucket-sorted, so a single linear pass suffices: entry i ends its chain
+    // when the next entry hashes into a different bucket. The previous
+    // per-bucket rescan was O(buckets * symbols) - quadratic for large
+    // export tables (glibc-sized .so builds).
+    for i in 0..hashed_sym_hashes.len() {
+        let last = i + 1 == hashed_sym_hashes.len()
+            || (hashed_sym_hashes[i + 1] % gnu_hash_nbuckets)
+                != (hashed_sym_hashes[i] % gnu_hash_nbuckets);
+        if last { gnu_hash_chains[i] |= 1; }
     }
 
