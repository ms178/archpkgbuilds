diff --git a/tests/regression/builtin_cpu_supports_raptor.c b/tests/regression/builtin_cpu_supports_raptor.c
new file mode 100644
index 0000000..c2762ad
--- /dev/null
+++ b/tests/regression/builtin_cpu_supports_raptor.c
@@ -0,0 +1,14 @@
+/* Compile-time __builtin_cpu_supports must match Raptor Lake / x86-64-v3. */
+int main(void) {
+    if (!__builtin_cpu_supports("sse2")) return 1;
+    if (!__builtin_cpu_supports("avx2")) return 2;
+    if (!__builtin_cpu_supports("bmi2")) return 3;
+    if (!__builtin_cpu_supports("fma"))  return 4;
+    if (!__builtin_cpu_supports("aes"))  return 5;
+    if (__builtin_cpu_supports("avx512f")) return 6;
+    if (__builtin_cpu_supports("avx512bw")) return 7;
+    if (__builtin_cpu_supports("amx-tile")) return 8;
+    if (__builtin_cpu_supports("sse4a")) return 9;
+    if (__builtin_cpu_supports("xop")) return 10;
+    return 0;
+}
diff --git a/tests/regression/builtin_object_size_string.c b/tests/regression/builtin_object_size_string.c
new file mode 100644
index 0000000..d8902ff
--- /dev/null
+++ b/tests/regression/builtin_object_size_string.c
@@ -0,0 +1,17 @@
+/* Verify __builtin_object_size folds string literals (fortify high-ROI path). */
+#include <stddef.h>
+
+int main(void) {
+    if (__builtin_object_size("hello", 0) != 6) return 1;
+    if (__builtin_object_size("hello", 1) != 6) return 2;
+    if (__builtin_object_size("hello", 2) != 6) return 3;
+    if (__builtin_object_size("hello", 3) != 6) return 4;
+    if (__builtin_object_size("", 0) != 1) return 5;
+    if (__builtin_object_size("x", 0) != 2) return 6;
+    if (__builtin_object_size("abcdef", 0) != (long)sizeof("abcdef")) return 7;
+
+    char *p = (char *)0;
+    if (__builtin_object_size(p, 0) != (size_t)-1) return 9;
+    if (__builtin_object_size(p, 2) != 0) return 10;
+    return 0;
+}
diff --git a/tests/regression/builtin_trap_unreachable.c b/tests/regression/builtin_trap_unreachable.c
