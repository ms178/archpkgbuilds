+    pub(crate) fn encode_user_msr(
+        &mut self,
+        ops: &[Operand],
+        mnemonic: &str,
+    ) -> Result<(), String> {
+        let check_imm_u32 = |v: &i64| -> Result<(), String> {
+            if !(0..=0xFFFF_FFFFu64 as i64).contains(v) {
