+                .iter()
+                .filter_map(|inst| {
+                    if let Instruction::Phi { dest, incoming, .. } = inst {
+                        let op = incoming
+                            .iter()
+                            .find(|(_, label)| *label == previous)
+                            .unwrap()
+                            .0;
