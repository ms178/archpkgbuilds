 src/backend/x86/codegen/calls.rs | 60 +++++++++++++++++++++++++-------
 1 file changed, 48 insertions(+), 12 deletions(-)

diff --git a/src/backend/x86/codegen/calls.rs b/src/backend/x86/codegen/calls.rs
index f0018490..31f0745c 100644
