+                | IrBinOp::And
+                | IrBinOp::Or
+                | IrBinOp::Xor
+                | IrBinOp::Shl
+                | IrBinOp::LShr
+                | IrBinOp::AShr
+                | IrBinOp::RotateLeft
+                | IrBinOp::RotateRight
+        ),
+        Some(Instruction::UnaryOp { op, .. }) => matches!(op, IrUnaryOp::Not | IrUnaryOp::Neg),
+        Some(Instruction::Select { .. }) => true,
+        _ => false,
+    }
+}
