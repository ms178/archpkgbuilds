+        // the coalescer renames the register, not one occurrence of it.
+        assert_eq!(
+            replace_vec_reg("vaddpd %zmm2, %zmm1, %zmm2{%k1}", 2, 5),
+            "vaddpd %zmm5, %zmm1, %zmm5{%k1}"
