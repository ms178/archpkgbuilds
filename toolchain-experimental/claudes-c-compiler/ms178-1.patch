+        ));
+        assert!(!c, "{out}");
+    }
+
+    #[test]
+    fn register_masks_narrow_to_the_memory_byte() {
+        // (L & 0x100000000) != 0: GCC 16.2 `movzbl L+4(%rip)`; one byte test.
+        let (_, out) = run(&func(
+            "    movabsq $4294967296, %rax\n    andq L(%rip), %rax\n    jne .LBB2\n",
+        ));
+        assert!(out.contains("testb $1, L+4(%rip)"), "{out}");
