+
+    // ── encode_csel / csinc / csinv / csneg : mixed W/X widths ───────────
+    #[test]
+    fn csel_rejects_mixed_widths(
+        rd in 0u32..=30, rn in 0u32..=30, rm in 0u32..=30,
+        rd64 in any::<bool>(), rn64 in any::<bool>(), rm64 in any::<bool>(),
