+	t_srai_pi16();
+	t_srai_pi16_k();
+	t_srai_pi32();
+	t_srai_pi32_k();
+	t_cvtpi16_ps();
+	t_cvtpu16_ps();
+	t_cvtpi8_ps();
+	t_cvtpu8_ps();
+	t_cvtps_pi32();
+	t_cvttps_pi32();
+	t_cvtps_pi16();
+	t_cvtps_pi8();
+	t_misc();
+	t_lanes();
+	t_cvtpi32_ps();
+	t_memory();
+	return 0;
+}
