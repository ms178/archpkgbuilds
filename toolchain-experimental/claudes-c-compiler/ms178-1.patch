+fn report_panics(panics: &[String], checked: usize, floor: usize, shown: usize) {
+    assert!(
+        panics.is_empty(),
+        "{} of {checked} operand spellings panicked the pipeline. First {shown}:\n{}",
+        panics.len(),
+        panics
+            .iter()
+            .take(shown)
+            .map(String::as_str)
+            .collect::<Vec<_>>()
+            .join("\n")
+    );
+    assert!(
+        checked >= floor,
+        "corpus too small to be evidence: {checked} (expected at least {floor})"
+    );
