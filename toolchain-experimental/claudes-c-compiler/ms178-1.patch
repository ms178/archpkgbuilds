+            }
+            Some(TypedCallSrc::Slot(off)) => Some(CallRetMove {
+                dst: MachOperand::StackSlot(off),
+                size,
+            }),
+        },
+    };
+
+    Ok(TypedCallPlan {
+        args: ordered,
+        ret: ret_move,
+    })
