# Maintainer: Marcus Seyfarth (ms178)
# Contributor: FlowerCA77
#
# The original hybrid-perf and i686 linker work is already in LCCC upstream.
# The small local patch below contains ONLY the subsequent PMU/data-quality fixes.
# Update the pinned commit and rebase/remove that patch when upstream changes.
#
# The optional full P/E benchmark is OFF by default. To run it:
#   env LCCC_RUN_BENCHMARKS=1 makepkg -s
# Do not use --nocheck. Results stay in a fresh directory next to this file;
# they are not installed in the package. Never run makepkg as root.

pkgbase=lccc
pkgname=(lccc)
pkgver=0.1.0.r6578.g2d95c4e
pkgrel=1
pkgdesc="LCCC (Lightning Fast Claude's C Compiler) — GCC-compatible compiler for x86-64, i686, ARM64 and RISC-V"
arch=(x86_64)
url='https://github.com/ms178/lccc'
license=('CC0-1.0' 'MIT' 'Apache-2.0' 'BSD-2-Clause')

_build_doc=0
_build_src=0
_run_benchmarks=${LCCC_RUN_BENCHMARKS:-${LCCC_RUN_PERF_BENCH:-1}}
case $_run_benchmarks in
  0|1) ;;
  *) echo 'error: LCCC_RUN_BENCHMARKS must be 0 or 1' >&2; return 1 ;;
esac
(( _build_doc )) && pkgname+=(lccc-doc)
(( _build_src )) && pkgname+=(lccc-src)

makedepends=(cargo git gcc python util-linux)
(( _run_benchmarks )) && checkdepends=(perf)
options=(!emptydirs !lto)

# Pinned to the current upstream main, which contains the earlier merged work.
# The new quality patch is based on this exact commit; never reapply ms178-1.patch.
_lccc_commit=2d95c4e394d94664c216d2fef7e20a383d9b5b06
source=("lccc::git+$url.git#commit=$_lccc_commit" 'lccc-benchmark-quality.patch')
sha256sums=('SKIP' '0528d3026ee27f1a99cd3cd777174813d911ecc8d102f6c996e70c336f845960')

pkgver() {
  cd "$srcdir/lccc"
  local ver
  ver=$(awk '
    /^\[(workspace\.)?package\]/ { in_pkg = 1; next }
    /^\[/ { in_pkg = 0 }
    in_pkg && $1 == "version" { gsub(/["\r]/, "", $3); print $3; exit }
  ' Cargo.toml)
  if [[ -z $ver ]]; then
    ver=$(sed -nE 's/^version[[:space:]]*=[[:space:]]*"([^"]+)".*/\1/p' Cargo.toml | head -n1)
  fi
  : "${ver:=0.0.0}"
  printf '%s.r%s.g%s' "$ver" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

_cargo_env() {
  export RUSTUP_TOOLCHAIN="${RUSTUP_TOOLCHAIN:-stable}"
  export CARGO_HOME="${CARGO_HOME:-$srcdir/cargo-home}"
  export CARGO_TARGET_DIR="$srcdir/lccc/target"
  export CARGO_PROFILE_FASTBUILD_OPT_LEVEL=1
  export CARGO_BUILD_JOBS=2
}

_host_target() { rustc -vV | sed -n 's/^host: //p'; }

_install_licenses() {
  local dest=$1 f
  for f in LICENSE LICENSE-APACHE LICENSE-BSD LICENSE-MIT LICENSING.md; do
    [[ -f $f ]] && install -Dm644 "$f" "$dest/$f"
  done
}

prepare() {
  cd "$srcdir/lccc"
  _cargo_env
  # Idempotent for an already-prepared tree; a partial/conflicting patch fails.
  if git apply --reverse --check "$srcdir/lccc-benchmark-quality.patch" 2>/dev/null; then
    echo 'benchmark-quality patch already applied'
  elif git apply --check "$srcdir/lccc-benchmark-quality.patch" 2>/dev/null; then
    git apply "$srcdir/lccc-benchmark-quality.patch"
  else
    echo 'error: benchmark-quality patch does not match pinned LCCC source' >&2
    git apply --check "$srcdir/lccc-benchmark-quality.patch" || :
    return 1
  fi
  if [[ -f Cargo.lock ]]; then
    cargo fetch --locked --target "$(_host_target)"
  else
    cargo generate-lockfile
    cargo fetch --target "$(_host_target)"
  fi
}

build() {
  cd "$srcdir/lccc"
  _cargo_env
  cargo build --profile fastbuild --frozen -j 2
  if (( _build_doc )); then
    cargo doc --no-deps --frozen
  fi
}

check() {
  cd "$srcdir/lccc"
  _cargo_env
  local lccc_bin="$CARGO_TARGET_DIR/fastbuild/lccc"
  local ld_bin="$CARGO_TARGET_DIR/fastbuild/lccc-ld"
  [[ -x $lccc_bin && -x $ld_bin ]] || { echo 'error: missing lccc/lccc-ld binary' >&2; return 1; }
  "$lccc_bin" -v 2>&1 | grep -q 'gcc version' || return 1
  local banner resolved
  banner=$("$ld_bin" -v) || return 1
  grep -Eq '^GNU ld \(.*\) [0-9]+(\.[0-9]+)+' <<< "$banner" || return 1
  "$ld_bin" -V >/dev/null && "$ld_bin" --version >/dev/null || return 1
  resolved=$("$lccc_bin" -print-prog-name=ld) || return 1
  [[ $resolved == *lccc-ld ]] || { echo "error: wrong linker sibling: $resolved" >&2; return 1; }
  local smoke_src="$srcdir/lccc-smoke.c" smoke_bin="$srcdir/lccc-smoke" smoke_rc=0
  printf '%s\n' '#include <stdio.h>' 'int main(void) { puts("lccc package smoke test"); return 42; }' > "$smoke_src"
  "$lccc_bin" -O1 "$smoke_src" -o "$smoke_bin" || return 1
  "$smoke_bin" >/dev/null || smoke_rc=$?
  (( smoke_rc == 42 )) || { echo "error: smoke program returned $smoke_rc, expected 42" >&2; return 1; }
  echo "smoke: lccc and $banner; compile/link/run passed"
  (( _run_benchmarks )) || return 0

  local results
  results=$(mktemp -d "$startdir/lccc-benchmark.XXXXXXXX") || return 1
  local -a args=(
    --lccc "$lccc_bin"
    --gcc "${LCCC_BENCH_GCC:-$(command -v gcc)}"
    --output "$results/report.txt"
    --artifacts "$results/evidence"
    --reps "${LCCC_BENCH_REPS:-9}"
    --perf-reps "${LCCC_BENCH_PERF_REPS:-9}"
    --warmup "${LCCC_BENCH_WARMUP:-2}"
  )
  [[ -z ${LCCC_BENCH_P_CPU:-} ]] || args+=(--p-cpu "$LCCC_BENCH_P_CPU")
  [[ -z ${LCCC_BENCH_E_CPU:-} ]] || args+=(--e-cpu "$LCCC_BENCH_E_CPU")
  printf 'LCCC report: %s/report.txt\nEvidence: %s/evidence\n' "$results" "$results"
  python3 scripts/benchmark_hybrid_perf.py "${args[@]}"
}

package_lccc() {
  depends=(glibc gcc-libs binutils)
  optdepends=(
    'gcc: host CRT/libgcc and GCC benchmark reference'
    'python: standalone lccc-perf-bench'
    'util-linux: taskset CPU affinity for lccc-perf-bench'
    'perf: hardware counters for lccc-perf-bench'
    'aarch64-linux-gnu-gcc: GNU AArch64 cross toolchain'
    'riscv64-linux-gnu-gcc: GNU RISC-V cross toolchain'
    'i686-linux-gnu-gcc: GNU i686 cross toolchain'
    'qemu-user: run cross-compiled binaries'
  )
  options=(!emptydirs !lto)
  cd "$srcdir/lccc"
  local bin
  for bin in lccc lccc-ld lccc-x86 lccc-arm lccc-riscv lccc-i686; do
    [[ ! -x target/fastbuild/$bin ]] || install -Dm755 "target/fastbuild/$bin" "$pkgdir/usr/bin/$bin"
  done
  for bin in lccc lccc-ld; do
    [[ -x $pkgdir/usr/bin/$bin ]] || { echo "error: missing target/fastbuild/$bin" >&2; return 1; }
  done
  if [[ -d include ]]; then
    install -d "$pkgdir/usr/lib/lccc"
    cp -a include "$pkgdir/usr/lib/lccc/include"
  fi

  # Preserve the upstream runner's relative layout; do not embed a second registry.
  local benchroot="$pkgdir/usr/share/lccc/benchmarks"
  install -Dm644 scripts/benchmark_hybrid_perf.py "$benchroot/scripts/benchmark_hybrid_perf.py"
  install -Dm644 tests/benchmark/run_benchmarks.py "$benchroot/tests/benchmark/run_benchmarks.py"
  install -Dm644 tests/benchmark/WORKLOAD_PROVENANCE.md "$benchroot/tests/benchmark/WORKLOAD_PROVENANCE.md"
  cp -a tests/benchmark/programs "$benchroot/tests/benchmark/programs"
  install -d "$benchroot/tools"
  cp -a tools/corpus "$benchroot/tools/corpus"
  find "$benchroot" -type d -name __pycache__ -prune -exec rm -rf {} +
  install -Dm644 docs/hybrid-perf-benchmark.md "$pkgdir/usr/share/doc/lccc/hybrid-perf-benchmark.md"
  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/lccc-perf-bench" <<'EOF_BENCH_WRAPPER'
#!/usr/bin/env bash
set -euo pipefail
bindir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
benchroot=$(CDPATH= cd -- "$bindir/../share/lccc/benchmarks" && pwd -P)
exec python3 "$benchroot/scripts/benchmark_hybrid_perf.py" \
  --lccc "${LCCC_BENCH_LCCC:-$bindir/lccc}" --gcc "${LCCC_BENCH_GCC:-gcc}" "$@"
EOF_BENCH_WRAPPER
  chmod 755 "$pkgdir/usr/bin/lccc-perf-bench"
  _install_licenses "$pkgdir/usr/share/licenses/$pkgname"
  [[ ! -f README.md ]] || install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}

package_lccc-doc() {
  pkgdesc='Documentation for LCCC'
  arch=(any)
  depends=()
  options=(!emptydirs)
  cd "$srcdir/lccc"
  install -d "$pkgdir/usr/share/doc/lccc"
  [[ ! -d target/doc ]] || cp -a target/doc/. "$pkgdir/usr/share/doc/lccc/"
  [[ ! -f README.md ]] || install -Dm644 README.md "$pkgdir/usr/share/doc/lccc/README.md"
  _install_licenses "$pkgdir/usr/share/licenses/$pkgname"
}

package_lccc-src() {
  pkgdesc='Source tree of LCCC'
  arch=(any)
  depends=()
  options=(!strip !emptydirs)
  install -d "$pkgdir/usr/src"
  cp -a "$srcdir/lccc" "$pkgdir/usr/src/lccc-$pkgver"
  rm -rf "$pkgdir/usr/src/lccc-$pkgver"/{.git,target}
  cd "$srcdir/lccc"
  _install_licenses "$pkgdir/usr/share/licenses/$pkgname"
}
