# Contributor: FlowerCA77 <ca538468142@outlook.com>

pkgbase=lccc
pkgname=(lccc)
pkgver=0.1.0.r4328.gaba4c5a
pkgrel=1
pkgdesc="LCCC (Lightning Fast Claude's C Compiler) — high-performance, GCC-compatible C compiler targeting x86-64, i686, ARM64, and RISC-V"
arch=(x86_64)
url='https://github.com/ms178/lccc'
license=('CC0-1.0' 'MIT' 'Apache-2.0' 'BSD-2-Clause')

# Flip to 1 to emit the optional split packages.
_build_doc=0
_build_src=0
(( _build_doc )) && pkgname+=(lccc-doc)
(( _build_src )) && pkgname+=(lccc-src)

makedepends=(
  cargo
  git
)
options=(!emptydirs !lto)

source=("git+$url.git")
sha256sums=('SKIP')

#######################################################################
# pkgver                                                              #
#######################################################################
pkgver() {
  cd "$srcdir/lccc"

  local ver
  ver=$(awk '
    /^\[(workspace\.)?package\]/ { in_pkg = 1; next }
    /^\[/ { in_pkg = 0 }
    in_pkg && $1 == "version" {
      gsub(/["\r]/, "", $3)
      print $3
      exit
    }
  ' Cargo.toml)

  if [[ -z $ver ]]; then
    ver=$(sed -nE 's/^version[[:space:]]*=[[:space:]]*"([^"]+)".*/\1/p' Cargo.toml | head -n1)
  fi
  : "${ver:=0.0.0}"

  printf '%s.r%s.g%s' "$ver" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

#######################################################################
# helpers                                                             #
#######################################################################
_cargo_env() {
  export RUSTUP_TOOLCHAIN="${RUSTUP_TOOLCHAIN:-stable}"
  export CARGO_HOME="${CARGO_HOME:-$srcdir/cargo-home}"
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target}"
  export CARGO_PROFILE_RELEASE_LTO=fat
  export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
  export CARGO_PROFILE_RELEASE_OPT_LEVEL=3
}

_host_target() {
  rustc -vV | sed -n 's/^host: //p'
}

_install_licenses() {
  local dest=$1 f
  for f in LICENSE LICENSE-APACHE LICENSE-BSD LICENSE-MIT LICENSING.md; do
    [[ -f $f ]] && install -Dm644 "$f" "$dest/$f"
  done
}

#######################################################################
# prepare                                                             #
#######################################################################
prepare() {
  cd "$srcdir/lccc"
  _cargo_env

  if [[ -f Cargo.lock ]]; then
    cargo fetch --locked --target "$(_host_target)"
  else
    cargo generate-lockfile
    cargo fetch --target "$(_host_target)"
  fi
}

#######################################################################
# build                                                               #
#######################################################################
build() {
  cd "$srcdir/lccc"
  _cargo_env

  cargo build --release --frozen

  if (( _build_doc )); then
    cargo doc --no-deps --frozen
  fi
}

#######################################################################
# packages                                                            #
#######################################################################
package_lccc() {
  depends=(glibc gcc-libs binutils)
  optdepends=(
    'gcc: host CRT/libgcc objects and optional gcc assembler/linker integration'
    'aarch64-linux-gnu-gcc: GNU cross toolchain used together with lccc-arm'
    'riscv64-linux-gnu-gcc: GNU cross toolchain used together with lccc-riscv'
    'i686-linux-gnu-gcc: GNU cross toolchain used together with lccc-i686'
    'qemu-user: run cross-compiled binaries'
  )
  options=(!emptydirs !lto)

  cd "$srcdir/lccc"

  local bin
  for bin in lccc lccc-x86 lccc-arm lccc-riscv lccc-i686; do
    if [[ -x target/release/$bin ]]; then
      install -Dm755 "target/release/$bin" "$pkgdir/usr/bin/$bin"
    fi
  done

  if [[ ! -x $pkgdir/usr/bin/lccc ]]; then
    echo 'error: release binary target/release/lccc was not produced' >&2
    return 1
  fi

  if [[ -d include ]]; then
    install -d "$pkgdir/usr/lib/lccc"
    cp -a include "$pkgdir/usr/lib/lccc/include"
  fi

  _install_licenses "$pkgdir/usr/share/licenses/$pkgname"

  [[ -f README.md ]] && install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}

package_lccc-doc() {
  pkgdesc='Documentation for LCCC'
  arch=(any)
  depends=()
  options=(!emptydirs)

  cd "$srcdir/lccc"
  install -d "$pkgdir/usr/share/doc/lccc"

  if [[ -d target/doc ]]; then
    cp -a target/doc/. "$pkgdir/usr/share/doc/lccc/"
  fi

  local doc
  for doc in \
    README.md \
    DESIGN_DOC.md \
    BENCHMARK_ANALYSIS.md \
    FINAL_RESULTS.md \
    NEXT_STEPS.md \
    NEXT_STEPS_ASSESSMENT.md \
    PHASE_7A_COMPLETE.md \
    PHASE_7B_SUMMARY.md \
    PHASE_9_SUMMARY.md \
    STATE_ASSESSMENT.md \
    VECTORIZATION_COMPLETE.md \
    VECTORIZATION_SUCCESS.md \
    BUILDING_LINUX.txt
  do
    [[ -f $doc ]] && install -Dm644 "$doc" "$pkgdir/usr/share/doc/lccc/$doc"
  done

  _install_licenses "$pkgdir/usr/share/licenses/$pkgname"
}

package_lccc-src() {
  pkgdesc='Source tree of LCCC'
  arch=(any)
  depends=()
  options=(!strip !emptydirs)

  install -d "$pkgdir/usr/src"
  cp -a "$srcdir/lccc" "$pkgdir/usr/src/lccc-$pkgver"
  rm -rf "$pkgdir/usr/src/lccc-$pkgver"/{.git,target}
  rm -rf "$pkgdir/usr/src/lccc-$pkgver"/cargo-home

  cd "$srcdir/lccc"
  _install_licenses "$pkgdir/usr/share/licenses/$pkgname"
  [[ -f README.md ]] && install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
