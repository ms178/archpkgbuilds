# Contributor: FlowerCA77
#
# lccc — Lightning Fast Claude's C Compiler (git master).
#
# Package-specific notes
# ----------------------
# 1) lccc-ld is installed into /usr/bin next to lccc.  The driver resolves
#    `lccc -print-prog-name=ld` to its *sibling* lccc-ld, kernel-style builds
#    invoke it directly (`make LD=lccc-ld`), and `lccc-ld -v` / `-V` /
#    `--version` must answer from any shell (fish/bash/zsh) with the GNU-ld
#    shaped banner — exactly like `lccc -v` answers for the compiler.  check()
#    smoke-asserts all of this on every build.
# 2) Integrated perf benchmark run (toggle, default OFF):
#      _run_benchmarks=1  in this file, or:  LCCC_RUN_BENCHMARKS=1 makepkg
#    When enabled, check() drives the FULL integrated benchmark corpus
#    (tests/benchmark registry: synthetic + gzip/zlib-ng/expat/SQLite/Linux/
#    glibc-derived kernels) through `perf stat` — lccc vs the installed gcc,
#    separately pinned to a P-core and an E-core of the hybrid CPU (Raptor
#    Lake: SMT-sibling topology detection) — and writes an AI-agent-ready
#    evidence report:
#      $SRCDEST/../lccc-perf-report.txt   (plus .json)  → copied next to the
#      PKGBUILD ($startdir) and installed as
#      /usr/share/lccc/benchmarks/results/.
#    Requires the 'perf' package (auto-added to checkdepends when enabled).
#    A full run is ~15-40 min on an i7-14700KF; disable via --nocheck or the
#    toggle for iteration builds.
# 3) The corpus + runner are also installed standalone, so the benchmark can
#    be re-run any time against the *installed* lccc:  lccc-perf-bench --out
#    report.txt   (see `lccc-perf-bench --list` / --help).
pkgbase=lccc
pkgname=(lccc)
pkgver=0.1.0.r6573.ged92857
pkgrel=1
pkgdesc="LCCC (Lightning Fast Claude's C Compiler) — high-performance, GCC-compatible C compiler targeting x86-64, i686, ARM64, and RISC-V"
arch=(x86_64)
url='https://github.com/ms178/lccc'
license=('CC0-1.0' 'MIT' 'Apache-2.0' 'BSD-2-Clause')
# Flip to 1 to emit the optional split packages.
_build_doc=0
_build_src=0
# Perf benchmark corpus run in check() (see header note 2).  Can also be set
# from the environment:  LCCC_RUN_BENCHMARKS=1 makepkg
_run_benchmarks=${LCCC_RUN_BENCHMARKS:-1}
(( _build_doc )) && pkgname+=(lccc-doc)
(( _build_src )) && pkgname+=(lccc-src)
if (( _run_benchmarks )); then
  # gcc comes from base-devel (makepkg's own requirement) — not listed here.
  checkdepends=(perf python)
fi
makedepends=(
cargo
git
)
options=(!emptydirs !lto)
source=("git+$url.git")
sha256sums=('SKIP')
#######################################################################
# pkgver                                                              #
#######################################################################
pkgver() {
cd "$srcdir/lccc"
local ver
ver=$(awk '
/^\[(workspace\.)?package\]/ { in_pkg = 1; next }
/^\[/ { in_pkg = 0 }
in_pkg && $1 == "version" {
gsub(/["\r]/, "", $3)
print $3
exit
}
' Cargo.toml)
if [[ -z $ver ]]; then
ver=$(sed -nE 's/^version[[:space:]]*=[[:space:]]*"([^"]+)".*/\1/p' Cargo.toml | head -n1)
fi
: "${ver:=0.0.0}"
printf '%s.r%s.g%s' "$ver" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}
