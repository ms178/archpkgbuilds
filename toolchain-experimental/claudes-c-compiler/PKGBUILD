_cargo_env() {
export RUSTUP_TOOLCHAIN="${RUSTUP_TOOLCHAIN:-stable}"
export CARGO_HOME="${CARGO_HOME:-$srcdir/cargo-home}"
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target}"
export CARGO_PROFILE_RELEASE_LTO=fat
export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
export CARGO_PROFILE_RELEASE_OPT_LEVEL=3
}
_host_target() {
rustc -vV | sed -n 's/^host: //p'
}
_install_licenses() {
local dest=$1 f
for f in LICENSE LICENSE-APACHE LICENSE-BSD LICENSE-MIT LICENSING.md; do
[[ -f $f ]] && install -Dm644 "$f" "$dest/$f"
done
}

_write_lccc_perf_bench() {
  # Materialises the perf-counter benchmark runner at
  #   $srcdir/lccc_perf_bench.py
  # Called by check() (execute) and package_lccc() (install), so it stays
  # correct for `makepkg -R` repackaging and repeated invocations.  The
  # embedded copy is the canonical, unit-tested runner; keep it in sync with
  # the standalone copy in the archpkgbuilds repo.
  cat > "$srcdir/lccc_perf_bench.py" <<'EOF_LCCC_PERF_BENCH'
#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""lccc-perf-bench — hardware-counter benchmark corpus runner: LCCC vs GCC.

Purpose
=======
Drive the full integrated LCCC benchmark corpus (the same registry that
``tests/benchmark/run_benchmarks.py`` defines: synthetic kernels plus
workload-derived kernels from gzip, zlib-ng, expat, SQLite, Linux and glibc)
through ``perf stat`` on real hardware, once per core class of a hybrid CPU
(Intel Raptor Lake: P-cores vs E-cores), once per compiler (LCCC and the
installed GCC), and emit a single self-contained .txt report designed to be
fed to AI tuning agents, plus a raw .json evidence file.

Evidence policy (mirrors the upstream harness philosophy)
=========================================================
* Every counter claim comes from ``perf``; nothing is fabricated.  When perf
  is unavailable (not installed, or kernel.perf_event_paranoid forbids it)
  the runner degrades to pinned wall-clock timing and labels the measurement
  class accordingly — it never presents wall-clock numbers as PMU evidence.
* Compiler outputs are cross-checked (stdout sha256, LCCC vs GCC): a faster
  binary that computes something different is reported as a correctness
  failure, never as a speed win.
* perf invocations are pinned with ``taskset`` so counters are attributed to
  exactly one core class; P/E classification is derived from SMT topology
  (thread siblings) and corroborated by cpu_capacity and max frequency, with
  the raw evidence recorded in the report header.
* Counter groups are kept small (core group fits the fixed+GP counters of a
  P-core without multiplexing) and any event that perf reports as scaled
  (time-running < time-enabled) is labelled "multiplexed" in the report.

Usage
=====
    lccc-perf-bench --lccc ./target/release/lccc --gcc gcc \
        --corpus-root /path/to/lccc --out report.txt --json report.json

Standalone (after the lccc package installed the corpus):
    lccc-perf-bench --out report.txt

Environment overrides: LCCC_BENCH_REPS, LCCC_BENCH_WARMUP, LCCC_BENCH_OPT,
LCCC_BENCH_ALL_USER, LCCC_BENCH_TOPDOWN, LCCC_BENCH_ONLY, LCCC_BENCH_CPUS.
"""

import argparse
import csv
import hashlib
import importlib.util
import json
import math
import os
import platform
import re
import shutil
import statistics
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path

VERSION = "1.0.1"

# --------------------------------------------------------------------------- #
# Defaults (environment-overridable)                                          #
# --------------------------------------------------------------------------- #


def _env_flag(name: str, default: str = "1") -> bool:
    return os.environ.get(name, default).strip().lower() not in ("0", "false", "no", "off")


DEFAULT_REPS = max(1, int(os.environ.get("LCCC_BENCH_REPS", "5")))
DEFAULT_WARMUP = max(0, int(os.environ.get("LCCC_BENCH_WARMUP", "1")))
DEFAULT_OPT = os.environ.get("LCCC_BENCH_OPT", "-O2")
DEFAULT_ALL_USER = _env_flag("LCCC_BENCH_ALL_USER", "1")
DEFAULT_TOPDOWN = _env_flag("LCCC_BENCH_TOPDOWN", "1")

# Counter groups.  The "core" group fits a P-core PMU (2 fixed + 2 GP) with
# zero multiplexing; the "memory" group fits a P-core (<= 8 GP) and may
# multiplex on the 4-GP E-core PMU — which the report labels honestly.
GROUP_CORE = ("cycles", "instructions", "branches", "branch-misses", "task-clock")
GROUP_MEM = (
    "L1-dcache-loads",
    "L1-dcache-load-misses",
    "LLC-loads",
    "LLC-load-misses",
    "cache-references",
    "cache-misses",
    "dTLB-load-misses",
)
ALL_PROBE_EVENTS = GROUP_CORE + GROUP_MEM

# The PMU availability probe must measure *something*.  `perf stat` without a
# workload after the "--" separator silently defaults to SYSTEM-WIDE collection
# (perf-stat(1): -a/--all-cpus is "the default if no target is specified"),
# which unprivileged users are denied at the stock perf_event_paranoid=2 — so
# the probe would fail on every healthy, default-configured machine and the
# whole run would silently degrade to wall-clock.  Pinning a trivial workload
# makes the probe per-process, exactly like the real measurements.
NULL_WORKLOAD = shutil.which("true") or "/usr/bin/true"

# Verdict thresholds on the median cycle-count ratio (lccc/gcc).
FASTER_MAX = 0.985
SLOWER_MIN = 1.015

COMPILE_TIMEOUT_S = 180
NOT_COUNTED = ("<not counted>", "<not supported>", "", "<unknown>")


# --------------------------------------------------------------------------- #
# Small utilities                                                             #
# --------------------------------------------------------------------------- #


def read_first(path) -> str | None:
    try:
        return Path(path).read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        return None


def read_int(path) -> int | None:
    text = read_first(path)
    if text is None:
        return None
    try:
        return int(text)
    except ValueError:
        return None


def parse_cpu_list(spec: str | None) -> list[int]:
    """Expand '0-3,8,10-11' into [0,1,2,3,8,10,11].  Returns [] on garbage."""
    if not spec:
        return []
    cpus: list[int] = []
    for part in spec.split(","):
        part = part.strip()
        if not part:
            continue
        if "-" in part:
            lo, sep, hi = part.partition("-")
            try:
                cpus.extend(range(int(lo), int(hi) + 1))
            except ValueError:
                continue
        else:
            try:
                cpus.append(int(part))
            except ValueError:
                continue
    return sorted(set(cpus))


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def first_line(text: str) -> str:
    for line in text.splitlines():
        if line.strip():
            return line.strip()
    return ""


def clip(text: str, limit: int = 2048) -> str:
    text = text or ""
    return text if len(text) <= limit else text[:limit] + f"... [{len(text)} bytes total]"


def summarize_perf_failure(result: dict, paranoid: str | None) -> str:
    """Render a perf probe failure so the actual cause survives.

    perf prints permission errors as a multi-line message whose first line
    is literally ``Error:`` — collapsing that to first_line() produced the
    useless ``perf: usable=False (Error:)`` seen in the wild.  Keep the first
    few stderr lines plus the exit status and paranoia level, on one line.
    """
    lines = [ln.strip() for ln in (result.get("stderr") or "").splitlines()
             if ln.strip()]
    detail = " | ".join(lines[:4])
    if len(lines) > 4:
        detail += " | ..."
    if len(detail) > 600:
        detail = detail[:600] + "..."
    outcome = result.get("failure") or f"exit={result.get('returncode')}"
    paranoid_note = f"perf_event_paranoid={paranoid or 'unknown'}"
    if detail:
        return f"{detail} ({outcome}, {paranoid_note})"
    return f"perf probe failed ({outcome}, {paranoid_note})"


def fmt_count(value) -> str:
    if value is None:
        return "-"
    return f"{value:,.0f}"


def fmt_ratio(value) -> str:
    if value is None:
        return "-"
    return f"{value:.4f}"


def fmt_pct(value) -> str:
    if value is None:
        return "-"
    return f"{value * 100:.2f}%"


def geomean(values: list[float]) -> float | None:
    if not values:
        return None
    try:
        return math.exp(sum(math.log(v) for v in values) / len(values))
    except ValueError:
        return None


def run_cmd(cmd, timeout_s: float, cwd=None, env=None):
    """subprocess.run with never-raise semantics. Returns a result dict."""
    try:
        proc = subprocess.run(
            cmd, capture_output=True, timeout=timeout_s, cwd=cwd, env=env
        )
        return {
            "returncode": proc.returncode,
            "stdout": proc.stdout.decode("utf-8", errors="backslashreplace"),
            "stderr": proc.stderr.decode("utf-8", errors="backslashreplace"),
            "failure": None,
        }
    except subprocess.TimeoutExpired:
        return {"returncode": None, "stdout": "", "stderr": "", "failure": "timeout"}
    except OSError as exc:
        return {"returncode": None, "stdout": "", "stderr": "", "failure": str(exc)}


def controlled_environment() -> dict[str, str]:
    """Match the upstream harness run environment (locale/thread pinning)."""
    environment = dict(os.environ)
    environment.update(
        {
            "LC_ALL": "C",
            "LANG": "C",
            "TZ": "UTC",
            "OMP_NUM_THREADS": "1",
            "OPENBLAS_NUM_THREADS": "1",
            "MKL_NUM_THREADS": "1",
            "VECLIB_MAXIMUM_THREADS": "1",
        }
    )
    return environment


# --------------------------------------------------------------------------- #
# Topology: P-core / E-core classification (hybrid-aware)                     #
# --------------------------------------------------------------------------- #


def detect_topology(allowed: list[int]) -> dict:
    """Classify logical CPUs into core classes.

    Primary signal: SMT thread siblings.  On every shipping hybrid Intel part
    (Alder/Raptor/Meteor Lake) P-cores carry 2 SMT siblings and E-cores carry
    1, so "shares a core with another logical CPU" is a robust P-core test.
    Corroboration (recorded, not trusted blindly): cpu_capacity and
    cpuinfo_max_freq are strictly higher on P-cores.

    Non-hybrid machines degrade to a single class and the report says so.
    """
    infos: dict[int, dict] = {}
    for cpu in sorted(allowed):
        base = Path(f"/sys/devices/system/cpu/cpu{cpu}")
        siblings = parse_cpu_list(read_first(base / "topology/thread_siblings_list"))
        if not siblings:
            siblings = [cpu]
        infos[cpu] = {
            "cpu": cpu,
            "siblings": siblings,
            "smt": len(siblings) > 1,
            "capacity": read_int(base / "cpu_capacity"),
            "max_freq_khz": read_int(base / "cpufreq/cpuinfo_max_freq"),
            "governor": read_first(base / "cpufreq/scaling_governor"),
        }

    smt_cpus = {c for c, i in infos.items() if i["smt"]}
    plain_cpus = set(infos) - smt_cpus
    notes: list[str] = []

    if smt_cpus and plain_cpus:
        classes = [("P", sorted(smt_cpus)), ("E", sorted(plain_cpus))]
        hybrid = True
        # Corroborate; if capacity/freq disagree with the SMT split, say so.
        cap_p = {infos[c]["capacity"] for c in smt_cpus if infos[c]["capacity"]}
        cap_e = {infos[c]["capacity"] for c in plain_cpus if infos[c]["capacity"]}
        if cap_p and cap_e and max(cap_e) >= min(cap_p):
            notes.append(
                "cpu_capacity does not corroborate the SMT-based P/E split; "
                "classification below follows SMT topology (Intel hybrid invariant)."
            )
    elif smt_cpus and not plain_cpus:
        classes = [("UNIFORM-SMT", sorted(smt_cpus))]
        hybrid = False
        notes.append("All cores expose SMT siblings: non-hybrid CPU; single class.")
    elif plain_cpus and not smt_cpus:
        classes = [("UNIFORM", sorted(plain_cpus))]
        hybrid = False
        notes.append("No SMT siblings anywhere: single core class (no P/E distinction).")
    else:
        classes = []
        hybrid = False
        notes.append("No online CPUs discovered.")

    return {"cpus": infos, "classes": classes, "hybrid": hybrid, "notes": notes}


def choose_class_cpus(topology: dict, override: str | None) -> list[tuple[str, int]]:
    """Pick one representative logical CPU per class, or parse --cpus 'P:E'."""
    if override:
        chosen = []
        parts = [p.strip() for p in override.split(":") if p.strip()]
        if not parts or len(parts) > len(topology["classes"]):
            raise ValueError(f"--cpus expects one CPU per class, e.g. '0:16', got: {override!r}")
        for label, raw in zip([name for name, _ in topology["classes"]], parts):
            try:
                cpu = int(raw)
            except ValueError as exc:
                raise ValueError(f"--cpus: not a CPU number: {raw!r}") from exc
            if cpu not in topology["cpus"]:
                raise ValueError(f"--cpus: CPU {cpu} is not among the allowed CPUs")
            chosen.append((label, cpu))
        return chosen

    chosen = []
    for label, cpus in topology["classes"]:
        # Prefer the lowest-numbered CPU that owns its core's sibling pair.
        representative = min(
            cpus, key=lambda c: (topology["cpus"][c]["siblings"].index(c), c)
        )
        chosen.append((label, representative))
    return chosen


# --------------------------------------------------------------------------- #
# perf plumbing                                                               #
# --------------------------------------------------------------------------- #


def parse_perf_csv(text: str) -> dict[str, dict]:
    """Parse `perf stat -x ,` CSV output (stderr) into {event: {...}}.

    Robust across perf versions: the event name is the first field that names
    a requested event after stripping the ':u'/'k' modifier; the value is the
    leading numeric field.  Multiplex evidence is captured when present.
    """
    events: dict[str, dict] = {}
    for row in csv.reader(text.splitlines()):
        if len(row) < 3:
            continue
        cells = [cell.strip() for cell in row]
        value_text = cells[0]
        event_text = cells[2]
        if not event_text:
            continue
        event = event_text.split(":", 1)[0]
        if event in ("duration_time", "seconds", "user_time", "system_time"):
            continue
        if value_text in NOT_COUNTED or value_text.startswith("<"):
            continue
        try:
            value = float(value_text)
        except ValueError:
            continue
        if not math.isfinite(value):
            continue
        entry = {"value": value, "unit": cells[1] if len(cells) > 1 else ""}
        # Multiplex evidence: perf -x prints a "time enabled/running" percent
        # either with a % suffix or bare in the 4th column (e.g.
        # "value,unit,event,100.00").  Take the first percent-looking cell;
        # non-percent numerics (ns runtimes, metric values) are ignored.
        pct = None
        for cell in cells[3:]:
            if cell.endswith("%"):
                try:
                    pct = float(cell[:-1])
                    break
                except ValueError:
                    continue
            try:
                candidate = float(cell)
            except ValueError:
                continue
            if 0.0 <= candidate <= 100.0:
                pct = candidate
            break
        if pct is not None:
            entry["enabled_pct"] = pct
        events[event] = entry
    return events


class PerfContext:
    """Locates perf/taskset and probes which events each core class can use."""

    def __init__(self, perf: str | None, taskset: str | None, all_user: bool):
        self.perf = perf
        self.taskset = taskset
        self.all_user = all_user
        self.paranoid = read_first("/proc/sys/kernel/perf_event_paranoid")
        self.usable = perf is not None
        self.probe_reason = ""
        self.probes: dict[str, dict] = {}

    def base_cmd(self, cpu: int, events, topdown: bool = False) -> list[str]:
        cmd = [self.taskset, "-c", str(cpu), self.perf, "stat", "--no-big-num"]
        if not topdown:
            cmd += ["-x", ","]
            cmd += ["-e", ",".join(events)]
            if self.all_user:
                cmd.append("--all-user")
        else:
            cmd += ["-M", "TopdownL1"]
        cmd += ["--"]
        return cmd

    def verify(self) -> list[str]:
        """One availability probe (upstream-style): cycles+instructions on a
        representative CPU.  Returns warnings for the report."""
        warnings: list[str] = []
        if self.perf is None:
            self.usable = False
            self.probe_reason = "perf is not installed (install the 'perf' package)"
            warnings.append(self.probe_reason)
            return warnings
        if self.taskset is None:
            self.usable = False
            self.probe_reason = "taskset is not installed (util-linux)"
            warnings.append(self.probe_reason)
            return warnings
        cpu = 0
        try:
            cpu = sorted(os.sched_getaffinity(0))[0]
        except (AttributeError, OSError, IndexError):
            pass
        command = self.base_cmd(cpu, ["cycles", "instructions"])
        command.append(NULL_WORKLOAD)  # per-process probe; never system-wide
        result = run_cmd(command, timeout_s=20)
        counts = parse_perf_csv(result["stderr"])
        if result["returncode"] == 0 and "cycles" in counts and "instructions" in counts:
            self.usable = True
            self.probe_reason = (
                "perf returned usable cycles+instructions counters "
                f"(perf_event_paranoid={self.paranoid})"
            )
        else:
            self.usable = False
            self.probe_reason = summarize_perf_failure(result, self.paranoid)
            warnings.append(
                "PMU counters unavailable: " + self.probe_reason
            )
            hint = (
                "Remedies: install perf; if the reason above is a permission "
                "error, keep kernel.perf_event_paranoid <= 2 (2 = user-space-only "
                "counting, which is all this harness needs; >=3 = off without "
                "CAP_PERFMON: `sudo sysctl kernel.perf_event_paranoid=2`)."
            )
            warnings.append(hint)
        return warnings

    def probe_events(self, label: str, cpu: int) -> dict:
        """Probe every candidate event individually on one CPU of the class."""
        probe = {"class": label, "cpu": cpu, "ok": [], "dropped": [], "raw": []}
        for event in ALL_PROBE_EVENTS:
            command = self.base_cmd(cpu, [event])
            command.append(NULL_WORKLOAD)
            result = run_cmd(command, timeout_s=20)
            counts = parse_perf_csv(result["stderr"])
            if result["returncode"] == 0 and event in counts:
                probe["ok"].append(event)
            else:
                probe["dropped"].append(
                    {"event": event, "reason": first_line(result["stderr"]) or "no count"}
                )
            probe["raw"].append(
                {"event": event, "rc": result["returncode"], "stderr": clip(result["stderr"], 400)}
            )
        self.probes[label] = probe
        return probe

    def groups_for(self, label: str):
        probe = self.probes.get(label, {})
        ok = set(probe.get("ok", []))
        core = [e for e in GROUP_CORE if e in ok]
        mem = [e for e in GROUP_MEM if e in ok]
        return core, mem


# --------------------------------------------------------------------------- #
# Corpus registry (exact fidelity with the upstream integrated suite)         #
# --------------------------------------------------------------------------- #


class BenchCase:
    """Registry entry or fallback glob entry, normalised."""

    def __init__(self, name, description, source, tags, timeout_s, extra_flags, registry):
        self.name = name
        self.description = description
        self.source = source
        self.tags = tags
        self.timeout_s = timeout_s
        self.extra_flags = extra_flags
        self.registry = registry

    def as_dict(self):
        return {
            "name": self.name,
            "description": self.description,
            "source": str(self.source),
            "tags": list(self.tags),
            "timeout_s": self.timeout_s,
            "extra_flags": list(self.extra_flags),
            "registry": self.registry,
        }


def load_corpus(corpus_root: Path):
    """Import the upstream BENCHMARKS registry when possible; else glob."""
    programs = corpus_root / "tests" / "benchmark" / "programs"
    registry_path = corpus_root / "tests" / "benchmark" / "run_benchmarks.py"
    cases: list[BenchCase] = []
    origin = "fallback-glob"
    notes: list[str] = []

    if registry_path.is_file() and programs.is_dir():
        try:
            if str(corpus_root) not in sys.path:
                sys.path.insert(0, str(corpus_root))
            spec = importlib.util.spec_from_file_location(
                "lccc_run_benchmarks", registry_path
            )
            module = importlib.util.module_from_spec(spec)
            sys.modules["lccc_run_benchmarks"] = module
            spec.loader.exec_module(module)
            for bench in module.BENCHMARKS:
                source = programs / bench.sources[0]
                if not source.is_file():
                    notes.append(f"registry entry {bench.name}: source missing, skipped")
                    continue
                cases.append(
                    BenchCase(
                        bench.name,
                        bench.description,
                        source,
                        bench.tags,
                        bench.timeout_s,
                        bench.extra_flags,
                        "registry",
                    )
                )
            origin = f"registry ({len(cases)} entries from {registry_path})"
        except Exception as exc:  # noqa: BLE001 — any import failure falls back
            notes.append(f"registry import failed ({exc}); falling back to glob")
            cases = []
    if not cases and programs.is_dir():
        for source in sorted(programs.glob("*.c")):
            cases.append(
                BenchCase(
                    source.stem,
                    f"(fallback glob) {source.name}",
                    source,
                    (),
                    90,
                    (),
                    "fallback-glob",
                )
            )
        origin = f"fallback-glob ({len(cases)} sources in {programs})"
    return cases, origin, notes


# --------------------------------------------------------------------------- #
# Compilation                                                                 #
# --------------------------------------------------------------------------- #


def compiler_version(executable: str) -> str:
    """`<exe> -v`, preferring the first line that actually carries a version.

    lccc -v prints its banner to stdout (first line wins); gcc -v prints to
    stderr, where the "gcc version ..." line is selected.
    """
    result = run_cmd([executable, "-v"], timeout_s=15)
    stdout_lines = [line.strip() for line in result["stdout"].splitlines() if line.strip()]
    if stdout_lines and re.search(r"\d+\.\d+", stdout_lines[0]):
        return stdout_lines[0]
    text = result["stdout"] + "\n" + result["stderr"]
    versionish = [
        line.strip()
        for line in text.splitlines()
        if re.search(r"\d+\.\d+", line)
        and line.strip()
        and "configure" not in line.lower()
    ]
    preferred = [line for line in versionish if "version" in line.lower()]
    pick = preferred or versionish
    if pick:
        return pick[0]
    return first_line(result["stdout"]) or first_line(result["stderr"]) or (
        f"exit={result['returncode']}"
    )


def linker_version(executable: str) -> str:
    """`<exe> -print-prog-name=ld` then query that linker's -v, best effort."""
    result = run_cmd([executable, "-print-prog-name=ld"], timeout_s=15)
    ld = result["stdout"].strip().splitlines()[0].strip() if result["stdout"] else ""
    if not ld or "/" not in ld:
        return "n/a"
    ld_result = run_cmd([ld, "-v"], timeout_s=15)
    return first_line(ld_result["stdout"]) or first_line(ld_result["stderr"]) or "n/a"


def gcc_builtin_include(executable: str) -> str | None:
    """GCC-compatible drivers answer -print-file-name=include; LCCC reads GCC's."""
    result = run_cmd([executable, "-print-file-name=include"], timeout_s=15)
    candidate = result["stdout"].strip().splitlines()[0].strip() if result["stdout"] else ""
    if result["returncode"] == 0 and candidate:
        path = Path(candidate)
        if path.is_dir():
            return str(path)
    return None


def text_size(binary: Path) -> int | None:
    size_tool = shutil.which("size")
    if not size_tool:
        return None
    result = run_cmd([size_tool, str(binary)], timeout_s=15)
    lines = result["stdout"].splitlines()
    if len(lines) >= 2:
        try:
            return int(lines[1].split()[0])
        except (IndexError, ValueError):
            return None
    return None


def compile_case(executable: str, base_flags: list[str], case: BenchCase, out: Path):
    out.parent.mkdir(parents=True, exist_ok=True)
    out.unlink(missing_ok=True)
    command = [executable, *base_flags, "-o", str(out), str(case.source), *case.extra_flags]
    start = time.perf_counter()
    result = run_cmd(command, timeout_s=COMPILE_TIMEOUT_S)
    elapsed = time.perf_counter() - start
    ok = result["returncode"] == 0 and out.is_file() and os.access(out, os.X_OK)
    return {
        "ok": ok,
        "command": command,
        "compile_s": round(elapsed, 3),
        "returncode": result["returncode"],
        "stderr": clip(result["stderr"]),
        "binary_bytes": out.stat().st_size if out.is_file() else 0,
        "text_bytes": text_size(out) if ok else None,
    }


# --------------------------------------------------------------------------- #
# Measurement                                                                 #
# --------------------------------------------------------------------------- #


def measure_run(ctx: PerfContext, cpu: int, events, binary: Path, timeout_s: int,
                env: dict[str, str]):
    """One pinned perf-stat invocation around the benchmark binary.

    An empty event list (warmup/verification runs) always takes the plain
    pinned-run path — never `perf stat -e ""`.
    """
    if ctx.usable and events:
        command = ctx.base_cmd(cpu, events)
        command.append(str(binary))
        start = time.perf_counter()
        result = run_cmd(command, timeout_s=timeout_s, env=env)
        wall_s = time.perf_counter() - start
        counts = parse_perf_csv(result["stderr"]) if result["returncode"] == 0 else {}
        return {
            "mode": "perf",
            "ok": result["returncode"] == 0,
            "returncode": result["returncode"],
            "counts": counts,
            "wall_s": wall_s,
            "stdout": result["stdout"],
            "stderr": clip(result["stderr"]),
        }
    # Wall-clock fallback: honest, labelled, never presented as PMU evidence.
    command = [ctx.taskset, "-c", str(cpu), str(binary)] if ctx.taskset else [str(binary)]
    start = time.perf_counter()
    result = run_cmd(command, timeout_s=timeout_s, env=env)
    wall_s = time.perf_counter() - start
    return {
        "mode": "wall-clock",
        "ok": result["returncode"] == 0,
        "returncode": result["returncode"],
        "counts": {},
        "wall_s": wall_s,
        "stdout": result["stdout"],
        "stderr": clip(result["stderr"]),
    }


def topdown_run(ctx: PerfContext, cpu: int, binary: Path, timeout_s: int,
                env: dict[str, str]):
    command = ctx.base_cmd(cpu, None, topdown=True)
    command.append(str(binary))
    result = run_cmd(command, timeout_s=timeout_s, env=env)
    return {
        "ok": result["returncode"] == 0,
        "raw": result["stderr"],
        "stdout": result["stdout"],
    }


TOPDOWN_NAMES = ("retiring", "frontend_bound", "front_end_bound", "bad_speculation",
                 "backend_bound")


def parse_topdown(raw: str) -> dict[str, float]:
    """Best-effort extraction of the four TMA L1 percentages.

    perf's -M TopdownL1 output shape varies by version:
      * metric lines:        "    34.05  retiring"
      * comment style:       "  519,942  topdown-retiring   #   42.1%  retiring"
      * leading-name style:  "retiring  34.05%"
    All three are recognised; anything unparsed stays in the raw evidence.
    """
    found: dict[str, float] = {}
    for line in raw.splitlines():
        line = line.strip()
        if not line or not re.search(r"\d", line):
            continue
        # Comment style: "#   42.1%  retiring"
        match = re.search(r"#\s*([\d.]+)\s*%\s*([a-zA-Z_]+)", line)
        if match:
            match = (match.group(1), match.group(2))
        else:
            # Metric line style: "34.05  retiring" / "34.05% retiring"
            match = re.match(r"^[\d.,]+\s*%?\s+([a-zA-Z_]+)", line)
            if match:
                value_text = re.match(r"^([\d.,]+)", line).group(1)
                match = (value_text, match.group(1))
            else:
                # Leading-name style: "retiring  34.05%"
                lead = re.match(r"^([a-zA-Z_]+)[\s.]*([\d.]+)\s*%?$", line)
                if lead:
                    match = (lead.group(2), lead.group(1))
        if match:
            value_text, name = match[0], match[1]
            if name in TOPDOWN_NAMES:
                try:
                    found[name] = float(value_text.replace(",", ""))
                except ValueError:
                    continue
    return found


def derive_metrics(counts: dict[str, dict]) -> dict[str, float]:
    """Per-run derived metrics (rates and IPC) from raw counters."""
    def val(name):
        entry = counts.get(name)
        return entry["value"] if entry else None

    derived: dict[str, float] = {}
    cycles, instructions = val("cycles"), val("instructions")
    branches, branch_misses = val("branches"), val("branch-misses")
    if cycles and instructions:
        derived["IPC"] = instructions / cycles
    if branches:
        if branch_misses is not None:
            derived["branch-miss-rate"] = branch_misses / branches
    l1_loads, l1_misses = val("L1-dcache-loads"), val("L1-dcache-load-misses")
    if l1_loads:
        derived["L1-miss-rate"] = (l1_misses or 0.0) / l1_loads
    llc_loads, llc_misses = val("LLC-loads"), val("LLC-load-misses")
    if llc_loads:
        derived["LLC-miss-rate"] = (llc_misses or 0.0) / llc_loads
    return derived


RAW_METRICS = (
    "cycles",
    "instructions",
    "branches",
    "branch-misses",
    "task-clock",
    "L1-dcache-loads",
    "L1-dcache-load-misses",
    "LLC-loads",
    "LLC-load-misses",
    "cache-references",
    "cache-misses",
    "dTLB-load-misses",
)
DERIVED_METRICS = ("IPC", "branch-miss-rate", "L1-miss-rate", "LLC-miss-rate")


def aggregate(runs: list[dict]) -> dict[str, dict]:
    """Median/min/max/mean/stdev/CV for every raw+derived metric."""
    series: dict[str, list[float]] = {}
    multiplexed: set[str] = set()
    for run in runs:
        if not run.get("ok"):
            continue
        counts = run.get("counts", {})
        for name in RAW_METRICS:
            entry = counts.get(name)
            if entry and entry["value"] is not None:
                series.setdefault(name, []).append(entry["value"])
                if entry.get("enabled_pct") is not None and entry["enabled_pct"] < 99.5:
                    multiplexed.add(name)
        for name, value in derive_metrics(counts).items():
            series.setdefault(name, []).append(value)
        if run.get("mode") == "wall-clock":
            series.setdefault("task-clock", []).append(run["wall_s"] * 1000.0)
    stats: dict[str, dict] = {}
    for name, values in series.items():
        mean = statistics.fmean(values)
        stdev = statistics.stdev(values) if len(values) > 1 else 0.0
        stats[name] = {
            "n": len(values),
            "median": statistics.median(values),
            "min": min(values),
            "max": max(values),
            "mean": mean,
            "stdev": stdev,
            "cv": (stdev / mean) if mean else 0.0,
            "multiplexed": name in multiplexed,
        }
    return stats


def verdict(cycles_ratio: float | None) -> str:
    if cycles_ratio is None:
        return "INCONCLUSIVE"
    if cycles_ratio <= FASTER_MAX:
        return "LCCC-FASTER"
    if cycles_ratio >= SLOWER_MIN:
        return "GCC-FASTER"
    return "TIE"


# --------------------------------------------------------------------------- #
# Report rendering                                                            #
# --------------------------------------------------------------------------- #

RULE = "=" * 100
THIN = "-" * 100


def render_header(state) -> list[str]:
    lines = [
        RULE,
        "LCCC GENERATED-CODE PERFORMANCE REPORT (perf hardware counters)",
        RULE,
        f"Generated (UTC)   : {state['timestamp']}",
        f"Runner            : lccc-perf-bench v{VERSION}  (python {platform.python_version()})",
        f"Invocation        : {' '.join(state['argv'])}",
        f"Host              : {state['uname'].nodename}  kernel {state['uname'].release}"
        f"  {state['uname'].machine}",
    ]
    if state["microcode"]:
        lines.append(f"CPU microcode     : {state['microcode']}")
    hybrid_text = (
        "yes" if state["topology"]["hybrid"]
        else "no (single core class; P/E distinction not applicable)"
    )
    lines += [
        f"CPU model         : {state['cpu_model'] or 'unknown'}",
        f"Hybrid CPU        : {hybrid_text}",
    ]
    for label, cpus in state["topology"]["classes"]:
        member = state["topology"]["cpus"]
        freqs = sorted({member[c]["max_freq_khz"] for c in cpus if member[c]["max_freq_khz"]})
        caps = sorted({member[c]["capacity"] for c in cpus if member[c]["capacity"]})
        govs = sorted({member[c]["governor"] for c in cpus if member[c]["governor"]})
        lines.append(
            f"  {label:>13}-cores : CPUs {','.join(str(c) for c in cpus)}"
            f" | max_freq {', '.join(f'{f/1e6:.2f} GHz' for f in freqs) or 'n/a'}"
            f" | capacity {','.join(str(c) for c in caps) or 'n/a'}"
            f" | governor {','.join(govs) or 'n/a'}"
        )
    for note in state["topology"]["notes"]:
        lines.append(f"  topology note   : {note}")
    lines += [
        f"P/E classification evidence : SMT thread siblings"
        f" (P-core = shares core with sibling logical CPU), corroborated by"
        f" cpu_capacity/cpuinfo_max_freq above.",
    ]
    if state["governor_warning"]:
        lines.append(f"  WARNING         : {state['governor_warning']}")
    lines += [
        "",
        "MEASUREMENT CLASS : "
        + (
            "BARE-METAL-PMU (perf hardware counters)"
            if state["perf"]["usable"]
            else f"WALL-CLOCK-FALLBACK — {state['perf']['probe_reason']}. "
            "Timing numbers below carry NO microarchitectural attribution."
        ),
        f"perf binary       : {state['perf']['perf'] or 'not found'}"
        f" | taskset: {state['perf']['taskset'] or 'not found'}"
        f" | perf_event_paranoid: {state['perf']['paranoid'] or 'unknown'}",
    ]
    if state["perf"]["usable"]:
        lines.append("perf command shape:")
        lines.append(
            "  core counters : taskset -c <cpu> perf stat --no-big-num -x , "
            "-e cycles,instructions,branches,branch-misses,task-clock "
            f"{'--all-user ' if state['perf']['all_user'] else ''}-- <binary>"
        )
        lines.append(
            "  mem  counters : taskset -c <cpu> perf stat --no-big-num -x , "
            "-e <memory-group events> "
            f"{'--all-user ' if state['perf']['all_user'] else ''}-- <binary>"
        )
        if state["settings"]["topdown"]:
            lines.append(
                "  topdown L1    : taskset -c <cpu> perf stat --no-big-num "
                "-M TopdownL1 -- <binary>"
            )
        lines.append(
            "  --all-user excludes kernel/hypervisor counts: codegen-focused "
            "attribution; at paranoid>=2 the kernel forces this anyway."
            if state["perf"]["all_user"]
            else "  (kernel-inclusive counting enabled via --no-all-user)"
        )
        for label, probe in state["perf"]["probes"].items():
            dropped = ", ".join(d["event"] for d in probe["dropped"]) or "none"
            lines.append(
                f"  event probe [{label}-class cpu {probe['cpu']}] : "
                f"{len(probe['ok'])}/{len(ALL_PROBE_EVENTS)} usable; dropped: {dropped}"
            )
    lines += [
        "",
        "COMPILERS",
        f"  lccc            : {state['compilers']['lccc']['path']}",
        f"    `lccc -v`     : {state['compilers']['lccc']['version']}",
        f"    `lccc-ld -v`  : {state['compilers']['lccc']['linker']}",
        f"    include dir   : {state['compilers']['lccc']['include'] or 'NOT FOUND'}",
        f"  gcc             : {state['compilers']['gcc']['path']}",
        f"    `gcc -v`      : {state['compilers']['gcc']['version']}",
        f"    include dir   : {state['compilers']['gcc']['include'] or 'NOT FOUND'}",
        "",
        "SETTINGS",
        f"  corpus          : {state['corpus']['origin']}",
        f"  benchmarks      : {len(state['cases'])} selected"
        f" ({state['settings']['filter'] or 'all'})",
        f"  opt flag        : {state['settings']['opt']}"
        f" | extra cflags: {state['settings']['cflags'] or '(none)'}",
        f"  reps/warmup     : {state['settings']['reps']} timed reps"
        f" ({state['settings']['mem_reps']} reps for the memory-counter group)"
        f", {state['settings']['warmup']} warmup",
        f"  interleave      : compilers alternate per rep (thermal/drift fairness)",
        f"  core classes    : "
        + ", ".join(f"{label}=cpu{cpu}" for label, cpu in state["chosen"]),
        f"  verdict rule    : median-cycles ratio lccc/gcc <= {FASTER_MAX} LCCC-FASTER,"
        f" >= {SLOWER_MIN} GCC-FASTER, else TIE",
        f"  correctness     : lccc stdout must match gcc stdout (sha256);"
        f" mismatches are correctness evidence, never speed wins",
    ]
    if state["corpus"]["notes"]:
        for note in state["corpus"]["notes"]:
            lines.append(f"  corpus note     : {note}")
    lines += [
        "",
        "SCOPE: this corpus is the integrated kernel suite (synthetic + "
        "gzip/zlib-ng/expat/sqlite/linux/glibc-derived kernels).  The pinned "
        "end-to-end project workloads (tests/workloads: full gzip, zlib-ng, "
        "expat, sqlite, glibc builds) are separate and not part of this run.",
    ]
    return lines


METRIC_ROWS = (
    ("cycles", "cycles", "count", False),
    ("instructions", "instructions", "count", False),
    ("IPC", "IPC", "ratio", True),
    ("task-clock", "task-clock (msec)", "msec", False),
    ("branches", "branches", "count", False),
    ("branch-misses", "branch-misses", "count", False),
    ("branch-miss-rate", "branch-miss-rate", "pct", False),
    ("L1-dcache-loads", "L1-dcache-loads", "count", False),
    ("L1-dcache-load-misses", "L1-load-misses", "count", False),
    ("L1-miss-rate", "L1-miss-rate", "pct", False),
    ("LLC-loads", "LLC-loads", "count", False),
    ("LLC-load-misses", "LLC-load-misses", "count", False),
    ("LLC-miss-rate", "LLC-miss-rate", "pct", False),
    ("cache-references", "cache-references", "count", False),
    ("cache-misses", "cache-misses", "count", False),
    ("dTLB-load-misses", "dTLB-load-misses", "count", False),
)


def render_metric_cell(stats: dict, name: str, kind: str):
    entry = stats.get(name)
    if not entry:
        return None
    value = entry["median"]
    if kind == "count":
        return fmt_count(value)
    if kind == "pct":
        return fmt_pct(value)
    if kind == "msec":
        return f"{value:,.1f}"
    return f"{value:.3f}"


def render_benchmark_block(entry: dict) -> list[str]:
    lines = [THIN, f"[{entry['index']:03d}] {entry['name']}  —  {entry['description']}"]
    lines.append(f"      tags={','.join(entry['tags']) or '-'}  src={entry['source']}")
    for key, label in (("lccc", "lccc"), ("gcc", "gcc")):
        compile_info = entry["compile"][key]
        if compile_info["ok"]:
            lines.append(
                f"      compile {label:4s}: OK in {compile_info['compile_s']:.2f}s"
                f" | bin {fmt_count(compile_info['binary_bytes'])} B"
                f" | text {fmt_count(compile_info['text_bytes']) or '-'} B"
            )
        else:
            lines.append(
                f"      compile {label:4s}: FAILED (rc={compile_info['returncode']}) "
                f"{first_line(compile_info['stderr'])}"
            )
    if entry["correctness"]["match"] is True:
        lines.append("      output match : MATCH (lccc stdout == gcc stdout)")
    elif entry["correctness"]["match"] is False:
        lines.append(
            "      output match : *** MISMATCH *** lccc sha "
            f"{entry['correctness']['lccc_sha'][:12]} vs gcc sha "
            f"{entry['correctness']['gcc_sha'][:12]} — correctness evidence,"
            " investigate before trusting any speed number"
        )
    else:
        lines.append("      output match : n/a (a compiler failed to build/run)")
    for run_failure in entry["failures"][:6]:
        lines.append(f"      run failure  : {run_failure}")
    for label, cpu in entry["classes"]:
        stats_l, stats_g = entry["stats"][label]["lccc"], entry["stats"][label]["gcc"]
        lines.append(f"      {label}-CORE (pinned to cpu {cpu}):")
        lines.append(
            "          metric                 lccc (median)      gcc (median)"
            "       lccc/gcc       cv lccc"
        )
        for name, pretty, kind, _higher_better in METRIC_ROWS:
            cell_l = render_metric_cell(stats_l, name, kind)
            cell_g = render_metric_cell(stats_g, name, kind)
            if cell_l is None and cell_g is None:
                continue
            ratio = None
            if stats_l.get(name) and stats_g.get(name) and stats_g[name]["median"]:
                ratio = stats_l[name]["median"] / stats_g[name]["median"]
            cv_l = stats_l.get(name, {}).get("cv")
            mpx = " (multiplexed!)" if stats_l.get(name, {}).get("multiplexed") else ""
            lines.append(
                f"          {pretty:<20s} {cell_l or '-':>18s} {cell_g or '-':>18s}"
                f" {fmt_ratio(ratio):>12s}   "
                f"{(f'{cv_l*100:.1f}%' if cv_l is not None else '-')}{mpx}"
            )
        top = entry["stats"][label].get("topdown")
        if top:
            for who in ("lccc", "gcc"):
                parsed = top[who]["parsed"]
                if top[who]["ok"] and parsed:
                    rendered = " | ".join(
                        f"{k} {v:.1f}%" for k, v in sorted(parsed.items())
                    )
                    lines.append(f"          topdownL1 {who:4s}: {rendered}")
                elif top[who]["ok"]:
                    lines.append(
                        f"          topdownL1 {who:4s}: (ran; unparsed — see JSON"
                        " for raw perf output)"
                    )
                else:
                    lines.append(
                        f"          topdownL1 {who:4s}: unavailable "
                        f"({first_line(top[who]['raw'])})"
                    )
        verdict_line = entry["stats"][label]["verdict"]
        lines.append(f"          VERDICT[{label}]: {verdict_line}")
    return lines


def render_summary(state, entries) -> list[str]:
    lines = [RULE, "SUMMARY", RULE]
    if not entries:
        lines.append("No benchmark produced results.")
        return lines
    for label in state["class_labels"]:
        ratios = [
            e["stats"][label]["cycles_ratio"]
            for e in entries
            if e["stats"].get(label, {}).get("cycles_ratio") is not None
        ]
        metric_names = {
            e["stats"][label].get("metric", "cycles")
            for e in entries
            if label in e["stats"]
        }
        if metric_names == {"cycles"}:
            metric_label = "cycles"
        elif len(metric_names) == 1:
            metric_label = metric_names.pop() + " (wall-clock fallback)"
        else:
            metric_label = "cycles/task-clock (mixed)"
        wins = [e for e in entries if e["stats"][label]["verdict"] == "LCCC-FASTER"]
        losses = [e for e in entries if e["stats"][label]["verdict"] == "GCC-FASTER"]
        ties = [e for e in entries if e["stats"][label]["verdict"] == "TIE"]
        gm = geomean(ratios)
        lines += [
            f"{label}-CORE class ({metric_label}, median, lccc/gcc — lower is better for lccc):",
            f"  benchmarks measured : {len(ratios)}",
            f"  geometric mean      : {fmt_ratio(gm)}",
            f"  wins/losses/ties    : {len(wins)} / {len(losses)} / {len(ties)}",
        ]
        ranked_wins = sorted(
            (e for e in wins if e["stats"][label]["cycles_ratio"] is not None),
            key=lambda e: e["stats"][label]["cycles_ratio"],
        )
        ranked_losses = sorted(
            (e for e in losses if e["stats"][label]["cycles_ratio"] is not None),
            key=lambda e: e["stats"][label]["cycles_ratio"],
            reverse=True,
        )
        for title, group, hint in (
            ("largest LCCC wins", ranked_wins, "protect/extend"),
            ("largest LCCC losses", ranked_losses, "attack first"),
        ):
            lines.append(f"  {title} ({hint}):")
            for e in group[:10]:
                lines.append(
                    f"    {e['stats'][label]['cycles_ratio']:.4f}  {e['name']}"
                )
            if not group:
                lines.append("    (none)")
    mismatches = [e["name"] for e in entries if e["correctness"]["match"] is False]
    compile_fails = [
        f"{e['name']}:{k}" for e in entries for k in ("lccc", "gcc")
        if not e["compile"][k]["ok"]
    ]
    run_fails = [e["name"] for e in entries if e["failures"]]
    noisy = [
        e["name"] for e in entries
        for label in state["class_labels"]
        if e["stats"].get(label, {}).get("lccc_cycles_cv") is not None
        and e["stats"][label]["lccc_cycles_cv"] > 0.05
    ]
    lines += [
        "",
        f"correctness mismatches (lccc vs gcc stdout): {len(mismatches)}"
        + (f" -> {', '.join(mismatches)}" if mismatches else ""),
        f"compile failures: {len(compile_fails)}"
        + (f" -> {', '.join(compile_fails)}" if compile_fails else ""),
        f"run failures (timeouts/crashes): {len(run_fails)}"
        + (f" -> {', '.join(sorted(set(run_fails)))}" if run_fails else ""),
        f"noisy benchmarks (lccc cycles cv > 5%): {len(set(noisy))}"
        + (f" -> {', '.join(sorted(set(noisy)))}" if noisy else ""),
        "",
        "Policy: performance numbers never override correctness.  A mismatch"
        " above is the first thing to fix; a noisy entry needs more reps"
        " (LCCC_BENCH_REPS) or a performance governor.",
    ]
    return lines


# --------------------------------------------------------------------------- #
# Main                                                                        #
# --------------------------------------------------------------------------- #


def parse_selection(raw) -> set[str]:
    selected: set[str] = set()
    for group in raw or []:
        selected.update(item.strip() for item in group.split(",") if item.strip())
    return selected


def resolve_lccc_default(corpus_root: Path) -> str | None:
    candidates = [
        os.environ.get("LCCC_BENCH_LCCC"),
        shutil.which("lccc"),
        str(corpus_root / "target" / "release" / "lccc"),
        str(corpus_root / "target" / "fastbuild" / "lccc"),
    ]
    for candidate in candidates:
        if not candidate:
            continue
        path = Path(candidate)
        if path.is_file() and os.access(path, os.X_OK):
            return str(path.resolve())
    return None


def resolve_corpus_root(explicit: str | None) -> Path:
    candidates = []
    if explicit:
        candidates.append(Path(explicit))
    env = os.environ.get("LCCC_PERF_BENCH_CORPUS")
    if env:
        candidates.append(Path(env))
    candidates.extend(
        [
            Path.cwd(),
            Path("/usr/share/lccc/benchmarks"),
        ]
    )
    for candidate in candidates:
        if (candidate / "tests" / "benchmark" / "programs").is_dir():
            return candidate.resolve()
    if explicit:
        raise SystemExit(f"error: --corpus-root {explicit} has no tests/benchmark/programs")
    raise SystemExit(
        "error: benchmark corpus not found; pass --corpus-root /path/to/lccc "
        "(source tree or /usr/share/lccc/benchmarks from the lccc package)"
    )


def build_state(args, cases, origin, notes, topology, chosen, perf_ctx, compilers):
    try:
        allowed = sorted(os.sched_getaffinity(0))
    except (AttributeError, OSError):
        allowed = []
    govs = {
        topology["cpus"][cpu]["governor"]
        for _, cpu in chosen
        if topology["cpus"][cpu]["governor"]
    }
    governor_warning = ""
    if any(g and g != "performance" for g in govs):
        governor_warning = (
            "cpufreq governor is not 'performance' ("
            + ",".join(sorted(g for g in govs if g))
            + "); frequencies will drift. For tuning-grade data run: "
            "sudo cpupower frequency-set -g performance"
        )
    microcode = ""
    try:
        for line in Path("/proc/cpuinfo").read_text(errors="replace").splitlines():
            if line.startswith("microcode"):
                microcode = line.split(":", 1)[1].strip()
                break
    except OSError:
        pass
    return {
        "timestamp": datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S"),
        "argv": sys.argv,
        "uname": os.uname(),
        "cpu_model": next(
            (
                line.split(":", 1)[1].strip()
                for line in Path("/proc/cpuinfo").read_text(errors="replace").splitlines()
                if line.startswith("model name")
            ),
            "",
        ),
        "microcode": microcode,
        "topology": topology,
        "governor_warning": governor_warning,
        "perf": {
            "perf": perf_ctx.perf,
            "taskset": perf_ctx.taskset,
            "paranoid": perf_ctx.paranoid,
            "usable": perf_ctx.usable,
            "probe_reason": perf_ctx.probe_reason,
            "probes": perf_ctx.probes,
            "all_user": perf_ctx.all_user,
        },
        "compilers": compilers,
        "corpus": {"origin": origin, "notes": notes},
        "cases": cases,
        "chosen": chosen,
        "class_labels": [label for label, _ in chosen],
        "settings": {
            "reps": args.reps,
            "mem_reps": min(2, args.reps),
            "warmup": args.warmup,
            "opt": args.opt,
            "cflags": list(args.cflag),
            "topdown": args.topdown,
            "filter": args.only or None,
            "timeout_scale": args.timeout_scale,
        },
    }


def run_benchmark_case(index, case, args, ctx, chosen, env, work, state):
    entry = {
        "index": index,
        "name": case.name,
        "description": case.description,
        "tags": list(case.tags),
        "source": str(case.source),
        "source_sha256": sha256_bytes(Path(case.source).read_bytes())[:16],
        "compile": {},
        "correctness": {"match": None, "lccc_sha": None, "gcc_sha": None},
        "failures": [],
        "classes": list(chosen),
        "stats": {},
        "raw": {},
    }
    timeout_s = max(5, int(case.timeout_s * args.timeout_scale))

    binaries = {}
    base_flags = {
        "lccc": (
            (["-I" + state["compilers"]["lccc"]["include"]]
             if state["compilers"]["lccc"]["include"] else [])
            + [args.opt, *args.cflag]
        ),
        "gcc": [args.opt, *args.cflag],
    }
    for key in ("lccc", "gcc"):
        result = compile_case(
            state["compilers"][key]["path"], base_flags[key], case,
            work / f"{case.name}.{key}",
        )
        entry["compile"][key] = result
        if result["ok"]:
            binaries[key] = work / f"{case.name}.{key}"
        else:
            entry["failures"].append(
                f"{key} compile failed: {first_line(result['stderr'])}"
            )
    if not binaries:
        return entry

    # Warmup + correctness (plain runs, one per compiler per class).
    shas = {"lccc": None, "gcc": None}
    for label, cpu in chosen:
        for key in ("lccc", "gcc") if index % 2 == 0 else ("gcc", "lccc"):
            if key not in binaries:
                continue
            result = measure_run(ctx, cpu, [], binaries[key], timeout_s, env)
            if result["ok"]:
                shas[key] = shas[key] or sha256_bytes(result["stdout"].encode())
            else:
                entry["failures"].append(
                    f"{key} warmup/verification run failed on {label} "
                    f"(rc={result['returncode']})"
                )
    if shas["lccc"] and shas["gcc"]:
        entry["correctness"] = {
            "match": shas["lccc"] == shas["gcc"],
            "lccc_sha": shas["lccc"],
            "gcc_sha": shas["gcc"],
        }
    elif shas["lccc"] or shas["gcc"]:
        entry["correctness"]["match"] = None

    # Timed runs, interleaved per rep for thermal/drift fairness.  Extra
    # warmups beyond the verification run are plain pinned runs.
    for extra in range(max(0, args.warmup - 1)):
        for label, cpu in chosen:
            for key in ("lccc", "gcc"):
                if key in binaries:
                    measure_run(ctx, cpu, [], binaries[key], timeout_s, env)
    for label, cpu in chosen:
        core_events, mem_events = ctx.groups_for(label)
        for key in ("lccc", "gcc"):
            entry["raw"].setdefault(label, {}).setdefault(key, [])
        for rep in range(args.reps):
            order = (
                ("lccc", "gcc") if rep % 2 == 0 else ("gcc", "lccc")
            )
            for key in order:
                if key not in binaries:
                    continue
                result = measure_run(
                    ctx, cpu, core_events, binaries[key], timeout_s, env
                )
                result["stdout_sha256"] = sha256_bytes(result["stdout"].encode())
                result["stdout"] = clip(result["stdout"], 2048)
                entry["raw"][label][key].append(result)
                if not result["ok"]:
                    entry["failures"].append(
                        f"{key} timed run failed on {label} rep {rep} "
                        f"(rc={result['returncode']})"
                    )
        mem_reps = min(2, args.reps)
        if ctx.usable and mem_events:
            for rep in range(mem_reps):
                order = (
                    ("lccc", "gcc") if rep % 2 == 0 else ("gcc", "lccc")
                )
                for key in order:
                    if key not in binaries:
                        continue
                    result = measure_run(
                        ctx, cpu, mem_events, binaries[key], timeout_s, env
                    )
                    result["group"] = "memory"
                    entry["raw"][label][key].append(result)

    # Aggregate per class; verdict on cycles (or task-clock in fallback mode).
    for label, _cpu in chosen:
        stats = {
            key: aggregate(entry["raw"].get(label, {}).get(key, []))
            for key in ("lccc", "gcc")
        }
        metric = "cycles"
        if not stats["lccc"].get("cycles") or not stats["gcc"].get("cycles"):
            metric = "task-clock"
        ratio = None
        if (
            stats["lccc"].get(metric)
            and stats["gcc"].get(metric)
            and stats["gcc"][metric]["median"]
        ):
            ratio = stats["lccc"][metric]["median"] / stats["gcc"][metric]["median"]
        cv_key = stats["lccc"].get(metric, {}).get("cv")
        entry["stats"][label] = {
            "lccc": stats["lccc"],
            "gcc": stats["gcc"],
            "metric": metric,
            "cycles_ratio": ratio,
            "lccc_cycles_cv": cv_key,
            "verdict": verdict(ratio),
            "topdown": {},
        }
        if args.topdown and ctx.usable:
            for key in ("lccc", "gcc"):
                if key not in binaries:
                    continue
                result = topdown_run(ctx, _cpu, binaries[key], timeout_s, env)
                entry["stats"][label]["topdown"][key] = {
                    "ok": result["ok"],
                    "raw": clip(result["raw"], 4000),
                    "parsed": parse_topdown(result["raw"]) if result["ok"] else {},
                }
    return entry


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(
        description="perf-counter benchmark corpus runner: LCCC vs GCC, per "
                    "hybrid core class (P/E), txt+json evidence output",
        prog="lccc-perf-bench",
    )
    parser.add_argument("--lccc", help="LCCC executable (default: lccc on PATH, "
                        "then <corpus>/target/{release,fastbuild}/lccc)")
    parser.add_argument("--gcc", default=os.environ.get("LCCC_BENCH_GCC", "gcc"),
                        help="GCC executable (default: gcc)")
    parser.add_argument("--corpus-root", help="lccc source tree (or the installed "
                        "/usr/share/lccc/benchmarks copy)")
    parser.add_argument("--out", type=Path, help="txt report path")
    parser.add_argument("--json", type=Path, help="json evidence path")
    parser.add_argument("--tag", default="manual", help="report tag (e.g. pkgver)")
    parser.add_argument("--only", action="append", default=[],
                        help="comma-separated benchmark names; repeatable")
    parser.add_argument("--exclude", action="append", default=[],
                        help="comma-separated benchmark names to skip; repeatable")
    parser.add_argument("--reps", type=int, default=DEFAULT_REPS,
                        help="timed reps per compiler/core-class (default %(default)s)")
    parser.add_argument("--warmup", type=int, default=DEFAULT_WARMUP,
                        help="warmup runs (default %(default)s; the verification "
                        "run already warms the binary)")
    parser.add_argument("--opt", default=DEFAULT_OPT,
                        help="optimization flag for both compilers (default %(default)s)")
    parser.add_argument("--cflag", action="append", default=[],
                        help="extra common cflag; repeatable")
    parser.add_argument("--cpus", default=os.environ.get("LCCC_BENCH_CPUS"),
                        help="one pinned CPU per core class, e.g. '0:16' for "
                        "P:E on Raptor Lake (default: auto-detect)")
    parser.add_argument("--timeout-scale", type=float, default=1.0,
                        help="scale registry per-benchmark timeouts (default 1.0)")
    parser.add_argument("--topdown", action="store_true", default=DEFAULT_TOPDOWN,
                        help="collect perf -M TopdownL1 (default on when perf is usable)")
    parser.add_argument("--no-topdown", dest="topdown", action="store_false")
    parser.add_argument("--all-user", dest="all_user", action="store_true",
                        default=DEFAULT_ALL_USER,
                        help="pass --all-user to perf (default on)")
    parser.add_argument("--no-all-user", dest="all_user", action="store_false")
    parser.add_argument("--work-dir", type=Path, help="compile/run directory "
                        "(default: private temp dir, kept, path in report)")
    parser.add_argument("--list", action="store_true",
                        help="list corpus, topology and perf probe results, then exit")
    args = parser.parse_args(argv)

    corpus_root = resolve_corpus_root(args.corpus_root)
    cases, origin, notes = load_corpus(corpus_root)

    selection_groups = list(args.only or [])
    env_only = os.environ.get("LCCC_BENCH_ONLY", "")
    if env_only:
        selection_groups.append(env_only)
    selected_names = parse_selection(selection_groups)
    excluded = parse_selection(args.exclude)
    if selected_names:
        cases = [c for c in cases if c.name in selected_names]
    if excluded:
        cases = [c for c in cases if c.name not in excluded]

    try:
        allowed = sorted(os.sched_getaffinity(0))
    except (AttributeError, OSError):
        allowed = parse_cpu_list(read_first("/sys/devices/system/cpu/online"))
    topology = detect_topology(allowed or parse_cpu_list("0-4095"))
    if not topology["classes"]:
        print("error: no usable CPUs", file=sys.stderr)
        return 2
    try:
        chosen = choose_class_cpus(topology, args.cpus)
    except ValueError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    ctx = PerfContext(shutil.which("perf"), shutil.which("taskset"), args.all_user)
    warnings = ctx.verify()
    if ctx.usable:
        for label, cpu in chosen:
            ctx.probe_events(label, cpu)

    lccc_path = args.lccc or resolve_lccc_default(corpus_root)
    if not lccc_path:
        print(
            "error: no LCCC executable found; pass --lccc (e.g. "
            "--lccc ./target/release/lccc)", file=sys.stderr,
        )
        return 2
    gcc_path = shutil.which(args.gcc) or (
        args.gcc if Path(args.gcc).is_file() else None
    )
    if not gcc_path:
        print(f"error: gcc executable not found: {args.gcc}", file=sys.stderr)
        return 2

    gcc_include = gcc_builtin_include(gcc_path)
    lccc_include = gcc_include or gcc_builtin_include(lccc_path)
    compilers = {
        "lccc": {
            "path": str(Path(lccc_path).resolve()),
            "version": compiler_version(lccc_path),
            "linker": linker_version(lccc_path),
            "include": lccc_include,
        },
        "gcc": {
            "path": str(Path(gcc_path).resolve()),
            "version": compiler_version(gcc_path),
            "linker": linker_version(gcc_path),
            "include": gcc_include,
        },
    }
    if not lccc_include:
        warnings.append(
            "GCC builtin include dir not found; LCCC compiles will likely fail "
            "(lccc reads GCC's headers via -print-file-name=include)"
        )

    state = build_state(
        args, cases, origin, notes, topology, chosen, ctx, compilers
    )

    if args.list:
        print(RULE)
        print("CORPUS")
        for case in cases:
            print(f"  {case.name:<32s} {','.join(case.tags) or '-'}")
        print(f"\nORIGIN: {origin}")
        print(f"\nTOPOLOGY ({'hybrid' if topology['hybrid'] else 'non-hybrid'})")
        for label, cpus in topology["classes"]:
            print(f"  {label}: CPUs {','.join(str(c) for c in cpus)}")
        print("\nCHOSEN REPRESENTATIVES")
        for label, cpu in chosen:
            print(f"  {label}: cpu {cpu}")
        print(f"\nPERF: usable={ctx.usable} reason={ctx.probe_reason}")
        for probe_label, probe in ctx.probes.items():
            dropped = ", ".join(d["event"] for d in probe["dropped"]) or "none"
            print(f"  events[{probe_label}]: ok={len(probe['ok'])} dropped={dropped}")
        for warning in warnings:
            print(f"WARNING: {warning}")
        print(f"\nCOMPILERS: lccc={lccc_path} gcc={gcc_path}")
        return 0

    if not cases:
        print("error: benchmark selection is empty", file=sys.stderr)
        return 2

    work = args.work_dir or Path(
        tempfile.mkdtemp(prefix="lccc-perf-bench-")
    )
    work.mkdir(parents=True, exist_ok=True)
    env = controlled_environment()
    state["settings"]["work_dir"] = str(work)

    print(f"corpus : {origin}")
    print(f"cpus   : " + ", ".join(f"{label}=cpu{cpu}" for label, cpu in chosen))
    print(f"perf   : usable={ctx.usable} ({ctx.probe_reason})")
    print(f"work   : {work}")
    print(f"running {len(cases)} benchmarks x 2 compilers x {len(chosen)} core "
          f"classes x {args.reps} reps ...", flush=True)

    entries = []
    started = time.perf_counter()
    for index, case in enumerate(cases, start=1):
        entry = run_benchmark_case(
            index, case, args, ctx, chosen, env, work, state
        )
        entries.append(entry)
        verdicts = " ".join(
            f"{label}:{entry['stats'][label]['verdict']}"
            for label in state["class_labels"]
            if label in entry["stats"]
        )
        match = entry["correctness"]["match"]
        match_text = "OK" if match else ("MISMATCH" if match is False else "n/a")
        print(
            f"  [{index:3d}/{len(cases)}] {case.name:<32s} {verdicts:<40s}"
            f" out={match_text}",
            flush=True,
        )
    elapsed = time.perf_counter() - started
    state["settings"]["elapsed_s"] = round(elapsed, 1)

    lines = []
    lines += render_header(state)
    lines.append("")
    lines += render_summary(state, entries)
    lines += ["", RULE, "PER-BENCHMARK DETAIL", RULE]
    for entry in entries:
        lines += render_benchmark_block(entry)
    lines += [
        "",
        RULE,
        "REPRODUCE",
        RULE,
        f"  {' '.join(sys.argv)}",
        "",
        f"  work dir (binaries kept): {work}",
        f"  raw evidence JSON       : {args.json or '(not written)'}",
        "",
        "Interpretation notes for tuning agents:",
        f"  * lccc/gcc < 1.000 on cycles (or task-clock in wall-clock mode)"
        " means LCCC generated faster code; IPC ratio > 1 favours lccc.",
        "  * P-core and E-core verdicts can legitimately disagree (different"
        " ports, predictors, cache geometry) — tune per class.",
        "  * 'multiplexed!' rows had counter time-sharing; treat exact counts"
        " as approximate (medians of >=2 reps still rank reliably).",
        "  * Correctness mismatches void performance claims for that kernel.",
        RULE,
    ]
    report_text = "\n".join(lines) + "\n"

    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    out_txt = args.out or Path(f"lccc-perf-report_{args.tag}_{stamp}.txt")
    out_json = args.json or out_txt.with_suffix(".json")
    out_txt.parent.mkdir(parents=True, exist_ok=True)
    out_txt.write_text(report_text, encoding="utf-8")
    payload = {
        "meta": {
            "version": VERSION,
            "timestamp_utc": state["timestamp"],
            "tag": args.tag,
            "argv": sys.argv,
        },
        "settings": state["settings"],
        "topology": {
            "hybrid": topology["hybrid"],
            "classes": topology["classes"],
            "cpus": {str(c): i for c, i in topology["cpus"].items()},
            "notes": topology["notes"],
            "chosen": [[label, cpu] for label, cpu in chosen],
        },
        "perf": {
            "usable": ctx.usable,
            "reason": ctx.probe_reason,
            "paranoid": ctx.paranoid,
            "all_user": ctx.all_user,
            "probes": ctx.probes,
        },
        "compilers": compilers,
        "corpus": {"origin": origin, "notes": notes},
        "warnings": warnings,
        "benchmarks": entries,
    }
    out_json.write_text(json.dumps(payload, indent=1), encoding="utf-8")

    print(f"\ndone in {elapsed:.0f}s")
    for warning in warnings:
        print(f"WARNING: {warning}")
    print(f"report : {out_txt}")
    print(f"json   : {out_json}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
EOF_LCCC_PERF_BENCH
}

_write_lccc_perf_bench_wrapper() {
  # Thin user-facing entry point: /usr/bin/lccc-perf-bench.
  cat > "$srcdir/lccc-perf-bench" <<'EOF_LCCC_PERF_WRAPPER'
#!/bin/bash
# lccc-perf-bench — perf-counter benchmark corpus run: lccc vs the installed
# gcc, pinned per hybrid core class (P/E).  Writes lccc-perf-report_*.txt
# (+ .json) into the current directory unless --out/--json are given.
#
# Corpus: /usr/share/lccc/benchmarks (shipped by this package).
# Useful flags: --list, --only <names>, --reps N, --opt -O3, --cpus 0:16,
#   LCCC_BENCH_REPS / LCCC_BENCH_ONLY / LCCC_BENCH_OPT (environment).
# The runner also auto-detects an lccc git checkout in the current directory,
# so development trees can be benchmarked without installing them.
exec python3 /usr/lib/lccc/benchmark/lccc_perf_bench.py "$@"
EOF_LCCC_PERF_WRAPPER
}
#######################################################################
# prepare                                                             #
#######################################################################
prepare() {
cd "$srcdir/lccc"
_cargo_env
if [[ -f Cargo.lock ]]; then
cargo fetch --locked --target "$(_host_target)"
else
cargo generate-lockfile
cargo fetch --target "$(_host_target)"
fi
}
#######################################################################
# build                                                               #
#######################################################################
build() {
cd "$srcdir/lccc"
_cargo_env
cargo build --release --frozen
if (( _build_doc )); then
cargo doc --no-deps --frozen
fi
}
#######################################################################
# check                                                               #
#######################################################################
check() {
cd "$srcdir/lccc"

local lccc_bin="$PWD/target/release/lccc"
local lccc_ld_bin="$PWD/target/release/lccc-ld"
if [[ ! -x $lccc_bin ]]; then
echo "error: release binary target/release/lccc was not built" >&2
return 1
fi
if [[ ! -x $lccc_ld_bin ]]; then
echo "error: release binary target/release/lccc-ld was not built" >&2
return 1
fi

# --- smoke 1: `lccc -v` answers with the GCC-compatible banner -----------
if ! "$lccc_bin" -v | grep -q 'gcc version'; then
echo "error: 'lccc -v' did not print the GCC-compatible banner" >&2
return 1
fi

# --- smoke 2: `lccc-ld -v` is honored like `lccc -v` ---------------------
# The banner must keep the GNU-ld shape (first two fields "GNU ld", final
# field numeric) because scripts/ld-version.sh and kernel/Meson probes
# reject anything else.  -V and --version are the same query in GNU ld.
local ld_banner
if ! ld_banner=$("$lccc_ld_bin" -v); then
echo "error: 'lccc-ld -v' exited non-zero" >&2
return 1
fi
if ! grep -Eq '^GNU ld \(.*\) [0-9]+(\.[0-9]+)+' <<< "$ld_banner"; then
echo "error: 'lccc-ld -v' banner is not GNU-ld shaped: $ld_banner" >&2
return 1
fi
"$lccc_ld_bin" --version > /dev/null
"$lccc_ld_bin" -V > /dev/null
echo "smoke: lccc-ld -v -> $ld_banner"

# --- smoke 3: driver resolves its lccc-ld sibling ------------------------
local prog_ld
if ! prog_ld=$("$lccc_bin" -print-prog-name=ld); then
echo "error: 'lccc -print-prog-name=ld' exited non-zero" >&2
return 1
fi
if [[ $prog_ld != *lccc-ld ]]; then
echo "error: 'lccc -print-prog-name=ld' did not resolve to the lccc-ld sibling: $prog_ld" >&2
return 1
fi

# --- smoke 4: compile + link + run through the default pipeline ----------
local smoke_src="$srcdir/lccc-smoke.c"
local smoke_bin="$srcdir/lccc-smoke"
printf '%s\n' \
'#include <stdio.h>' \
'int main(void) { puts("lccc package smoke test"); return 42; }' \
> "$smoke_src"
"$lccc_bin" -O1 "$smoke_src" -o "$smoke_bin"
local smoke_rc=0
"$smoke_bin" > /dev/null || smoke_rc=$?
if (( smoke_rc != 42 )); then
echo "error: smoke program returned $smoke_rc, expected 42" >&2
return 1
fi
echo "smoke: compile/link/run via lccc driver OK"

# --- optional: full perf-counter corpus benchmark ------------------------
if (( ! _run_benchmarks )); then
echo ">>> perf benchmark corpus run is DISABLED for this build."
echo ">>> Enable via _run_benchmarks=1 in the PKGBUILD, or:"
echo ">>>   LCCC_RUN_BENCHMARKS=1 makepkg"
echo ">>> (needs the 'perf' package; ~15-40 min on Raptor Lake)"
return 0
fi

_write_lccc_perf_bench
local report="$srcdir/lccc-perf-report.txt"
local report_json="$srcdir/lccc-perf-report.json"
python3 "$srcdir/lccc_perf_bench.py" \
--lccc "$lccc_bin" \
--gcc "${LCCC_BENCH_GCC:-gcc}" \
--corpus-root "$PWD" \
--tag "$pkgbase-$pkgver" \
--out "$report" \
--json "$report_json"

# Surface the report next to the PKGBUILD for immediate consumption; the
# package() step additionally installs it below /usr/share/lccc/benchmarks.
if [[ -w $startdir ]]; then
cp -f "$report" "$startdir/"
cp -f "$report_json" "$startdir/"
echo ">>> benchmark report copied to $startdir"
fi
echo ">>> benchmark report: $report"
}
#######################################################################
# packages                                                            #
#######################################################################
package_lccc() {
depends=(glibc gcc-libs binutils)
optdepends=(
'gcc: host CRT/libgcc objects and optional gcc assembler/linker integration'
'aarch64-linux-gnu-gcc: GNU cross toolchain used together with lccc-arm'
'riscv64-linux-gnu-gcc: GNU cross toolchain used together with lccc-riscv'
'i686-linux-gnu-gcc: GNU cross toolchain used together with lccc-i686'
'qemu-user: run cross-compiled binaries'
'perf: hardware PMU counters for lccc-perf-bench (benchmark corpus runner)'
)
options=(!emptydirs !lto)
cd "$srcdir/lccc"

# lccc-ld MUST be installed next to lccc: the driver resolves
# `-print-prog-name=ld` to its sibling lccc-ld, build systems call it
# directly (`make LD=lccc-ld`), and `lccc-ld -v` must answer from any shell
# exactly like `lccc -v` does.
local bin
for bin in lccc lccc-ld lccc-x86 lccc-arm lccc-riscv lccc-i686; do
if [[ -x target/release/$bin ]]; then
install -Dm755 "target/release/$bin" "$pkgdir/usr/bin/$bin"
fi
done
if [[ ! -x $pkgdir/usr/bin/lccc ]]; then
echo 'error: release binary target/release/lccc was not produced' >&2
return 1
fi
if [[ ! -x $pkgdir/usr/bin/lccc-ld ]]; then
echo 'error: release binary target/release/lccc-ld was not produced' >&2
return 1
fi
if [[ -d include ]]; then
install -d "$pkgdir/usr/lib/lccc"
cp -a include "$pkgdir/usr/lib/lccc/include"
fi

# --- benchmark corpus + perf runner (standalone: lccc-perf-bench) --------
# The install tree mirrors the source layout (tests/benchmark/..., tools/)
# so the upstream registry module run_benchmarks.py — imported by the runner
# for exact corpus fidelity — resolves its own paths unchanged.
_write_lccc_perf_bench
_write_lccc_perf_bench_wrapper
install -Dm755 "$srcdir/lccc_perf_bench.py" \
"$pkgdir/usr/lib/lccc/benchmark/lccc_perf_bench.py"
install -Dm755 "$srcdir/lccc-perf-bench" \
"$pkgdir/usr/bin/lccc-perf-bench"
install -d "$pkgdir/usr/share/lccc/benchmarks/tests/benchmark" \
"$pkgdir/usr/share/lccc/benchmarks/tools"
cp -a tests/benchmark/programs \
"$pkgdir/usr/share/lccc/benchmarks/tests/benchmark/programs"
install -Dm644 tests/benchmark/run_benchmarks.py \
"$pkgdir/usr/share/lccc/benchmarks/tests/benchmark/run_benchmarks.py"
if [[ -f tests/benchmark/WORKLOAD_PROVENANCE.md ]]; then
install -Dm644 tests/benchmark/WORKLOAD_PROVENANCE.md \
"$pkgdir/usr/share/lccc/benchmarks/tests/benchmark/WORKLOAD_PROVENANCE.md"
fi
cp -a tools/corpus "$pkgdir/usr/share/lccc/benchmarks/tools/corpus"

# Benchmark report from check() (present only when _run_benchmarks=1).
# NOTE: this makes the package content build-input-dependent (timestamped
# evidence) — intentional for this experimental toolchain package.
if [[ -f $srcdir/lccc-perf-report.txt ]]; then
install -Dm644 "$srcdir/lccc-perf-report.txt" \
"$pkgdir/usr/share/lccc/benchmarks/results/lccc-perf-report.txt"
if [[ -f $srcdir/lccc-perf-report.json ]]; then
install -Dm644 "$srcdir/lccc-perf-report.json" \
"$pkgdir/usr/share/lccc/benchmarks/results/lccc-perf-report.json"
fi
fi

_install_licenses "$pkgdir/usr/share/licenses/$pkgname"
[[ -f README.md ]] && install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
package_lccc-doc() {
pkgdesc='Documentation for LCCC'
arch=(any)
depends=()
options=(!emptydirs)
cd "$srcdir/lccc"
install -d "$pkgdir/usr/share/doc/lccc"
if [[ -d target/doc ]]; then
cp -a target/doc/. "$pkgdir/usr/share/doc/lccc/"
fi
local doc
for doc in \
README.md \
DESIGN_DOC.md \
BENCHMARK_ANALYSIS.md \
FINAL_RESULTS.md \
NEXT_STEPS.md \
NEXT_STEPS_ASSESSMENT.md \
PHASE_7A_COMPLETE.md \
PHASE_7B_SUMMARY.md \
PHASE_9_SUMMARY.md \
STATE_ASSESSMENT.md \
VECTORIZATION_COMPLETE.md \
VECTORIZATION_SUCCESS.md \
BUILDING_LINUX.txt
do
[[ -f $doc ]] && install -Dm644 "$doc" "$pkgdir/usr/share/doc/lccc/$doc"
done
_install_licenses "$pkgdir/usr/share/licenses/$pkgname"
}
package_lccc-src() {
pkgdesc='Source tree of LCCC'
arch=(any)
depends=()
options=(!strip !emptydirs)
install -d "$pkgdir/usr/src"
cp -a "$srcdir/lccc" "$pkgdir/usr/src/lccc-$pkgver"
rm -rf "$pkgdir/usr/src/lccc-$pkgver"/{.git,target}
rm -rf "$pkgdir/usr/src/lccc-$pkgver"/cargo-home
cd "$srcdir/lccc"
_install_licenses "$pkgdir/usr/share/licenses/$pkgname"
[[ -f README.md ]] && install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
