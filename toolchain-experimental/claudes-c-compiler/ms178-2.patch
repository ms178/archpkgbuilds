+        if p.returncode:
+            print(f"gcc -m32 -O0 failed on {cf.name}:\n" + p.stderr)
+            return 2
+        h0 = parse_hashes(run([str(b0)]).stdout)
+        p = run([args.gcc, "-m32", "-O2", "-w", "-o", str(b2), str(cf)])
+        if p.returncode == 0:
+            h2 = parse_hashes(run([str(b2)]).stdout)
