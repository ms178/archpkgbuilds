index 0000000000..f6aa74e9ac
--- /dev/null
+++ b/llvm/test/CodeGen/X86/ms178-or-not-andn.ll
@@ -0,0 +1,21 @@
+; RUN: llc -mtriple=x86_64 -mcpu=raptorlake -verify-machineinstrs < %s | FileCheck %s
+;
+; An OR must not be passed to the AND-only i8 ANDN combine. Besides asserting
+; with assertions enabled, doing so can replace (~a | b) with (~a & b).
+
+; CHECK-LABEL: or_not_i8:
+; CHECK-NOT: andn
+; CHECK: retq
+ define i8 @or_not_i8(i8 %a, i8 %b) {
+  %n = xor i8 %a, -1
+  %r = or i8 %n, %b
+  ret i8 %r
+}
+
+; CHECK-LABEL: or_i8:
+; CHECK-NOT: andn
+; CHECK: retq
+ define i8 @or_i8(i8 %a, i8 %b) {
+  %r = or i8 %a, %b
+  ret i8 %r
+}
