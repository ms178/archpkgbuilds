 /* This is another arbitrary limit, which tunables can change.  Each
-   tcache bin will hold at most this number of chunks.  */
-# define TCACHE_FILL_COUNT 16
+   tcache bin will hold at most this number of chunks.
+
+   ms178: raised from the upstream 16 to 32.
+
+   A larger per-thread cache keeps freed chunks out of the arena, avoiding
+   the lock + unsorted-bin + consolidation path.  But it is NOT free: on a
+   cross-thread producer/consumer pattern (job system frees what another
+   thread allocated) a big tcache holds chunks the freeing thread cannot
+   reuse, so they must still round-trip through the arena while the cache
+   itself grows the working set.
+
+   Instruction counts alone are misleading here -- they favour ever-larger
+   values -- so this was chosen on wall clock (median of 11 interleaved
+   runs per point):
+
+     count   churn(ms)   teardown(ms)   xthread(ms)
+       16      10.20        26.74         119.76
+       32       9.87        27.38         131.59
+       64       9.76        27.03         156.95
+      128       9.71        26.32         207.06
+      256       9.96        26.87         237.97
+
+   32 captures most of the small-alloc gain (churn -3.2%) while limiting
+   the cross-thread penalty to ~10%; 64 and above degrade xthread sharply
+   (+31% and worse) for no further churn benefit.
+
+   Bound: worst-case small-bin retention is
+   sum(tidx2csize(0..63)) * count = 34,304 * 32 = 1.05 MiB per thread.
+   num_slots[] is uint16_t and do_set_tcache_count() enforces
+   MAX_TCACHE_COUNT == UINT16_MAX, so this is well inside the safe range.
+
+   NOTE: deliberately NOT raising tcache_max.  Measured: raising it
+   1040 -> 4096 regressed teardown by 15.7% because large chunks displace
+   the hot small-size classes.  */
+# define TCACHE_FILL_COUNT 32
 
 /* Maximum chunks in tcache bins for tunables.  This value must fit the range
    of tcache->num_slots[] entries, else they may overflow.  */
@@ -746,7 +779,24 @@ libc_hidden_proto (__libc_mallopt)
