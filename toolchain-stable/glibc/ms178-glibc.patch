diff --git a/elf/dl-cache.c b/elf/dl-cache.c
index c6820a9f..ad15ba22 100644
--- a/elf/dl-cache.c
+++ b/elf/dl-cache.c
@@ -355,17 +355,27 @@ _dl_cache_libcmp (const char *p1, const char *p2)
           if (*p2 >= '0' && *p2 <= '9')
             {
 	      /* Must compare this numerically.  */
-	      int val1;
-	      int val2;
-
-	      val1 = *p1++ - '0';
-	      val2 = *p2++ - '0';
+	      const char *digits1 = p1;
+	      const char *digits2 = p2;
 	      while (*p1 >= '0' && *p1 <= '9')
-	        val1 = val1 * 10 + *p1++ - '0';
+		++p1;
 	      while (*p2 >= '0' && *p2 <= '9')
-	        val2 = val2 * 10 + *p2++ - '0';
-	      if (val1 != val2)
-		return val1 - val2;
+		++p2;
+
+	      /* Compare without converting to int: arbitrarily long numeric
+		 components must not trigger signed overflow.  Leading zeroes do
+		 not affect the numeric value, matching the previous behavior.  */
+	      while (digits1 < p1 && *digits1 == '0')
+		++digits1;
+	      while (digits2 < p2 && *digits2 == '0')
+		++digits2;
+	      size_t length1 = p1 - digits1;
+	      size_t length2 = p2 - digits2;
+	      if (length1 != length2)
+		return length1 < length2 ? -1 : 1;
+	      int result = memcmp (digits1, digits2, length1);
+	      if (result != 0)
+		return result;
 	    }
 	  else
             return 1;
