+/* When the translation unit is compiled with -mfma (i.e. __FMA__ is
+   defined), the compiler lowers __builtin_fma / __builtin_fmaf to a single
+   vfmadd* instruction.  In that case the software implementation in
+   sysdeps/ieee754/dbl-64/s_fma.c is dead code: collapse it to a six-byte
+   vfmadd-plus-return leaf.
+
+   The condition is per-translation-unit safe.  The multiarch wrappers keep
+   the software fallback and IFUNC resolver in a baseline build.  In an
+   x86-64-v3-or-higher build, FMA is part of the minimum ISA, so the wrappers
+   below omit that unreachable fallback and use this builtin implementation.
+
+   Pattern modelled on the existing
+   sysdeps/x86_64/fpu/math-use-builtins-trunc.h header which gates
+   USE_TRUNC_BUILTIN on __SSE4_1__ in the same per-TU manner.  */
+
+#ifdef __FMA__
+# define USE_FMA_BUILTIN  1
+# define USE_FMAF_BUILTIN 1
+#else
+# define USE_FMA_BUILTIN  0
+# define USE_FMAF_BUILTIN 0
+#endif
+
+#define USE_FMAL_BUILTIN     0
+#define USE_FMAF128_BUILTIN  0
