+large_csize2tidx (size_t nb)
 {
+  /* NOTE(ms178): deliberately UNCLAMPED.  do_set_tcache_max() relies on this
+     returning an out-of-range index for oversized values so that it can
+     reject them.  Clamping here would make the tunable accept e.g. 4M and
+     set tcache_max_bytes far beyond the last bin, causing many distinct
+     size classes to alias onto entries[TCACHE_MAX_BINS-1].  Bounds are
+     enforced at the allocation call sites instead (tcache_idx_valid).  */
   size_t idx = stdc_bit_width (nb) - stdc_bit_width (MAX_TCACHE_SMALL_SIZE);
   return idx + TCACHE_SMALL_BINS;
 }
 
+/* Defense-in-depth bound check for the large-tcache index.  */
+static __always_inline bool
+tcache_idx_valid (size_t tc_idx)
+{
+  return tc_idx < TCACHE_MAX_BINS;
+}
+
