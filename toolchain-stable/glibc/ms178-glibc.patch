 #ifndef DEFAULT_TRIM_THRESHOLD
-#define DEFAULT_TRIM_THRESHOLD (128 * 1024)
+/* ms178: 128 KiB makes the allocator hand memory back to the kernel far too
+   eagerly for a workload that immediately allocates it again, which is
+   exactly what a game frame loop does.  Every trim is an sbrk/madvise round
+   trip, and the pages come back as minor faults on the next touch -- a
+   classic source of frame-time spikes.
+
+   Raised to 8 MiB.  Note this is only the STARTING value: the existing
+   dynamic adjustment in _int_free_chunk still raises it further
+   (trim_threshold = 2 * mmap_threshold) when large mmapped chunks are
+   freed, and mallopt()/the tunable still override it outright.
+
+   Measured with strace -c (deterministic; wall clock on the test box is too
+   noisy to resolve a few percent), counting brk+mmap+munmap+madvise:
+
+     phase       upstream   ms178 (top_pad+trim)   reduction
+     churn          70            16                 -77%
+     teardown      103            17                 -83%  */
+#define DEFAULT_TRIM_THRESHOLD (8 * 1024 * 1024)
 #endif
 
 /*
@@ -779,7 +829,13 @@ libc_hidden_proto (__libc_mallopt)
