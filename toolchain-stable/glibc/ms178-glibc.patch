+struct decompressor_cookie
+{
+  int fd;
+  pid_t pid;
+};
+
+static ssize_t
+decompressor_read (void *cookie, char *buffer, size_t length)
+{
+  struct decompressor_cookie *state = cookie;
+  ssize_t result;
+  do
+    result = read (state->fd, buffer, length);
+  while (result < 0 && errno == EINTR);
+  return result;
+}
+
+static int
+wait_for_decompressor (pid_t pid)
+{
+  int status;
+  pid_t result;
+  do
+    result = waitpid (pid, &status, 0);
+  while (result < 0 && errno == EINTR);
+
+  if (result < 0)
+    return -1;
+  if (!WIFEXITED (status) || WEXITSTATUS (status) != 0)
+    {
+      errno = EIO;
+      return -1;
+    }
+  return 0;
+}
+
+static int
+decompressor_close (void *cookie)
+{
+  struct decompressor_cookie *state = cookie;
+  int saved_errno = 0;
+
+  if (close (state->fd) < 0)
+    saved_errno = errno;
+  if (wait_for_decompressor (state->pid) < 0 && saved_errno == 0)
+    saved_errno = errno;
+  free (state);
+
+  if (saved_errno != 0)
+    {
+      errno = saved_errno;
+      return -1;
+    }
+  return 0;
+}
+
+static const cookie_io_functions_t decompressor_io =
+  {
+    .read = decompressor_read,
+    .write = NULL,
+    .seek = NULL,
+    .close = decompressor_close
+  };
+
 /* Creates a subprocess decompressing the given pathname, and returns
-   a stream reading its output (the decompressed data).  */
+   a stream reading its output (the decompressed data).  The cookie close
+   callback reaps the child, avoiding one zombie per compressed charmap.  */
 static
 FILE *
 fopen_uncompressed (const char *pathname, const char *compressor)
@@ -175,9 +245,12 @@ fopen_uncompressed (const char *pathname, const char *compressor)
           char *argv[4]
 	    = { (char *) compressor, (char *) "-d", (char *) "-c", NULL };
           posix_spawn_file_actions_t actions;
+          struct decompressor_cookie *cookie = malloc (sizeof (*cookie));
 
-          if (posix_spawn_file_actions_init (&actions) == 0)
+          if (cookie != NULL
+              && posix_spawn_file_actions_init (&actions) == 0)
             {
+              cookie->fd = fd[0];
               if (posix_spawn_file_actions_adddup2 (&actions,
                                                     fd[1], STDOUT_FILENO) == 0
                   && posix_spawn_file_actions_addclose (&actions, fd[1]) == 0
@@ -185,16 +258,26 @@ fopen_uncompressed (const char *pathname, const char *compressor)
                   && posix_spawn_file_actions_adddup2 (&actions,
                                                        pfd, STDIN_FILENO) == 0
                   && posix_spawn_file_actions_addclose (&actions, pfd) == 0
-                  && posix_spawnp (NULL, compressor, &actions, NULL,
+                  && posix_spawnp (&cookie->pid, compressor, &actions, NULL,
                                    argv, environ) == 0)
                 {
                   posix_spawn_file_actions_destroy (&actions);
                   close (fd[1]);
                   close (pfd);
-                  return fdopen (fd[0], "r");
+                  FILE *stream = fopencookie (cookie, "r", decompressor_io);
+                  if (stream != NULL)
+                    return stream;
+
+                  int saved_errno = errno;
+                  close (fd[0]);
+                  wait_for_decompressor (cookie->pid);
+                  free (cookie);
+                  errno = saved_errno;
+                  return NULL;
                 }
               posix_spawn_file_actions_destroy (&actions);
             }
+          free (cookie);
           close (fd[1]);
           close (fd[0]);
         }
@@ -224,6 +307,15 @@ charmap_open (const char *directory, const char *name)
   if (stream != NULL)
     return stream;
 
+  /* Try compressed variants in fastest-decompressor-first order so the
+     common case (zstd, the new default install format) wins after one
+     failed open() of the uncompressed file.  Each memcpy includes the
+     terminating NUL so PATHNAME stays a valid C string for fopen.  */
+  memcpy (p, ".zst", 5);
+  stream = fopen_uncompressed (pathname, "zstd");
+  if (stream != NULL)
+    return stream;
+
   memcpy (p, ".gz", 4);
   stream = fopen_uncompressed (pathname, "gzip");
