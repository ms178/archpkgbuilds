+/* Verify geometric spawn file-action growth.  */
+#include <spawn.h>
+#include <support/check.h>
+static int
+do_test (void)
+{
+  posix_spawn_file_actions_t actions;
+  TEST_COMPARE (posix_spawn_file_actions_init (&actions), 0);
+  for (int i = 0; i < 17; ++i)
+    TEST_COMPARE (posix_spawn_file_actions_addclose (&actions, 0), 0);
+  TEST_COMPARE (actions.__used, 17);
+  TEST_VERIFY (actions.__allocated >= 32);
+  TEST_COMPARE (posix_spawn_file_actions_destroy (&actions), 0);
+  return 0;
+}
+#include <support/test-driver.c>
