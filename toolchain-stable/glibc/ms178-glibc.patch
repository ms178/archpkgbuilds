 #ifndef DEFAULT_TOP_PAD
-#define DEFAULT_TOP_PAD        (0)
+/* ms178: ask sbrk for 8 MiB of slack whenever the top chunk has to grow.
+   With top_pad 0 the arena grows in minimum increments, so a frame that
+   ramps its heap issues a long series of brk() calls.  Paired with the
+   raised trim threshold above this collapses the grow/shrink syscall
+   traffic (see the strace numbers on DEFAULT_TRIM_THRESHOLD).  The pad is
+   address space that is only faulted in when actually touched.  */
+#define DEFAULT_TOP_PAD        (8 * 1024 * 1024)
 #endif
 
 /*
@@ -898,7 +954,37 @@ libc_hidden_proto (__libc_mallopt)
 #define M_MMAP_THRESHOLD      -3
 
 #ifndef DEFAULT_MMAP_THRESHOLD
-#define DEFAULT_MMAP_THRESHOLD DEFAULT_MMAP_THRESHOLD_MIN
+/* ms178: start the dynamic mmap threshold at 1 MiB instead of the 128 KiB
+   minimum.
+
+   The threshold IS adaptive, but it only grows when an mmapped chunk is
+   freed (see _int_free_chunk).  Until that happens every allocation above
+   the current threshold pays a full mmap + first-touch page faults +
+   munmap, and munmap also returns the pages to the kernel so the next
+   allocation of the same size faults them in all over again.  Starting
+   higher removes that warm-up penalty for the medium-large buffers a game
+   cycles every frame (texture staging, audio blocks, mesh scratch).
+
