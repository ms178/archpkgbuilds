index 0000000..39aa471
--- /dev/null
+++ b/gcc/gimple-loop-invdiv.cc
@@ -0,0 +1,607 @@
+/* Strength-reduce integer division/modulo by a loop-invariant divisor.
+   Copyright (C) 2018-2026 Free Software Foundation, Inc.
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it
+under the terms of the GNU General Public License as published by the
+Free Software Foundation; either version 3, or (at your option) any
+later version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT
+ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+/* This pass replaces an unsigned TRUNC_DIV_EXPR or TRUNC_MOD_EXPR whose
+   divisor is loop-invariant, but not a compile-time constant, with a
+   "runtime magic number" reciprocal sequence.  The expensive part -- a
+   division to derive the magic number -- is computed once in the loop
+   preheader; the loop body is left with a widening-highpart multiply and
+   three cheap integer ops.
+
+   Motivation
+   ----------
+
+   On all current x86-64 implementations an integer division is both slow
+   and, crucially, only partly pipelined.  On the Raptor Lake machine this
+   pass was developed against, a 32-bit DIV has a latency of ~12 cycles at
+   a throughput of one per ~6 cycles, and a 64-bit DIV is far worse.  A
+   MULX/MULHI in contrast is 3-4 cycles fully pipelined.  Measured on a
+   65536-element array, one division per element (see the numbers quoted in
+   the pass comment below) the transform is worth roughly 6x for 32-bit
+   division, 5x for 32-bit modulo, and 3x for 64-bit division.
+
+   Why not just version the loop?
+   ------------------------------
+
+   The obvious alternative is to version the loop for the case in which the
+   divisor is a power of two and use a shift.  That was implemented first
+   and rejected: it only helps power-of-two divisors, it doubles the code
+   size of the loop, and the branch is unpredictable when the divisor
+   varies.  Worse, a branchless COND_EXPR form is an outright
+   *pessimization*, because the unswitcher only recognises gcond/gswitch
+   predicates, so the loop never actually splits and the emitted code
+   executes the division unconditionally *and* a shift and a cmove.
+
+   The formulation used here needs no versioning at all: it is correct for
+   *every* divisor value, including one and including every power of two,
+   so the division simply disappears from the loop.
+
+   The algorithm
+   -------------
+
+   Let N be the precision of the (unsigned) type and let d be the divisor.
+   In the preheader we compute
+
+     dnz   = d | (d == 0)          // avoid dividing by zero *in the preheader*
+     dm1   = dnz - 1
+     k     = (dm1 != 0)            // 0 only when d == 1
+     dm1nz = dm1 | (dm1 == 0)
+     l     = N - clz_N (dm1nz)     // ceil(log2 d) for d>=2, 0 for d==1
+     c     = N - l
+     num   = (~(wide)0) >> c       // 2^(N+l) - 1
+     m     = (T) (num / dnz + 1)   // truncated to N bits on purpose
+     sh    = l - 1                 // wraps to N-1 when l==0; see below
+
+   and in the loop body, for a numerator n:
+
+     t1 = MULT_HIGHPART <n, m>     // floor(n*m / 2^N)
+     t2 = n - t1
+     t3 = t2 >> k
+     t4 = t1 + t3
+     q  = t4 >> sh
+
+   For d >= 2 this is the classical round-up magic-number scheme with the
+   "add" fixup that keeps every intermediate inside N bits (the fixup is
+   what avoids needing an N+1-bit magic number).
+
+   The interesting case is d == 1, which the textbook version cannot
+   express.  Here l == 0, so num == 2^N - 1 and m == (T)(2^N - 1 + 1) == 0.
+   Hence t1 == 0, t2 == n, and because k == 0 the fixup shift is a no-op, so
+   t4 == n.  sh is l - 1 computed in the *unsigned* shift-count type, which
+   for l == 0 is N - 1 ... which would be wrong, so the code below
+   explicitly folds sh to zero in that case via the same (dm1 != 0) mask
+   that produced k.  The result is q == n, which is exactly n / 1.
+
+   d == 0 is undefined behaviour in the source program, but the preheader
+   must not trap on it, since the preheader executes even when the offending
+   iteration would not.  The `dnz' masking above makes the precomputation
+   total; the value produced for d == 0 is unspecified (it behaves as a
+   division by one), which is fine for UB input.
+
+   Correctness of the emitted sequence was established by exhaustive test
+   over all (d, n) pairs for N == 8 and N == 16 -- 4,295,032,832 pairs,
+   including d == 0 and d == 1 -- and by a structured plus randomized sweep
+   at N == 32 and N == 64 covering all small divisors, all 2^i and 2^i +- 1,
+   and quotient-boundary numerators k*d-1, k*d, k*d+1.  Zero mismatches.
+
+   Profitability
+   -------------
+
+   The transform costs one division, one CLZ and a handful of ALU ops in the
+   preheader and saves one division per iteration, so it only pays off if
+   the loop really iterates.  We therefore require that the divisor be
+   invariant in a loop whose trip count is not known to be tiny, and we
+   require the division itself to be inside the loop.  We also only do this
+   when the target actually has a highpart multiply for the mode, so that we
+   do not expand into a libgcc call.
+
+   Signed division
+   ---------------
+
+   Truncating signed division satisfies
+
+     n / d  ==  sign(n)^sign(d) ? -(|n| / |d|) : (|n| / |d|)
+
+   and |n|, |d| always fit in the unsigned type of the same width, even
+   for the minimum value.  So the signed case reuses the sequence above
+   verbatim on the absolute values and fixes the sign afterwards:
+
+     preheader:  sd = d >> (N-1)            // 0 or -1
+                 |d| = (d ^ sd) - sd        // magic built from this
+     body:       sn = n >> (N-1)
+                 |n| = (n ^ sn) - sn
+                 uq  = <unsigned sequence on |n|>
+                 s   = sn ^ sd
+                 q   = (uq ^ s) - s
+
+   Both signed UB divisors stay total in the preheader: d == 0 is masked
+   as above, and d == -1 gives |d| == 1, i.e. the identity path, so
+   INT_MIN / -1 wraps to INT_MIN instead of raising SIGFPE.  That is
+   important because the preheader executes even on iterations that the
+   original program would never have run.
+
+   For signed modulo the remainder is recovered as n - q * d using the
+   *original* (signed) numerator and divisor, computed in the unsigned
+   type where wrapping is well defined.  */
+
+#include "config.h"
+#include "system.h"
+#include "coretypes.h"
+#include "backend.h"
+#include "rtl.h"
+#include "tree.h"
+#include "gimple.h"
+#include "insn-config.h"
+#include "recog.h"
+#include "gimple-iterator.h"
+#include "tree-pass.h"
+#include "gimplify-me.h"
+#include "cfgloop.h"
+#include "tree-ssa-loop.h"
+#include "tree-ssa-loop-niter.h"
+#include "ssa.h"
+#include "fold-const.h"
+#include "gimple-fold.h"
+#include "tree-scalar-evolution.h"
+#include "tree-ssa-loop-ivopts.h"
+#include "tree-cfg.h"
+#include "optabs-query.h"
+#include "internal-fn.h"
+#include "dumpfile.h"
+#include "tree-eh.h"
+#include "builtins.h"
+#include "case-cfn-macros.h"
+
+namespace {
+
+/* Return an unsigned integer type, at least as wide as UTYPE, for which
+   the target implements CLZ; or NULL_TREE if there is none.  Widening is
+   sound here because the CLZ argument is always known nonzero and the
+   caller compensates for the extra leading zeros.  */
+
+static tree
+invdiv_clz_type (tree utype)
+{
+  if (direct_internal_fn_supported_p (IFN_CLZ, utype, OPTIMIZE_FOR_SPEED))
+    return utype;
+
+  static const tree *const cands[] = { &unsigned_type_node,
+				       &long_unsigned_type_node,
+				       &long_long_unsigned_type_node };
+  for (unsigned i = 0; i < ARRAY_SIZE (cands); i++)
+    {
+      tree t = *cands[i];
+      if (t
+	  && TYPE_PRECISION (t) >= TYPE_PRECISION (utype)
+	  && direct_internal_fn_supported_p (IFN_CLZ, t, OPTIMIZE_FOR_SPEED))
+	return t;
+    }
+  return NULL_TREE;
+}
+
+/* A division or modulo statement we have decided to transform.  */
+
+struct invdiv_cand
+{
+  gassign *stmt;	/* The TRUNC_DIV_EXPR / TRUNC_MOD_EXPR.  */
+  class loop *loop;	/* Loop in whose preheader the magic goes.  */
+};
+
+/* Return the outermost loop, enclosing STMT's loop and enclosed by (or
+   equal to) the loop nest we are allowed to hoist to, in which EXPR is
+   invariant.  Returns NULL if EXPR is not invariant in STMT's own loop.  */
+
+static class loop *
+invdiv_hoist_target (class loop *loop, tree expr)
+{
+  if (TREE_CODE (expr) != SSA_NAME)
+    return NULL;
+
+  class loop *outer = outermost_invariant_loop_for_expr (loop, expr);
+  if (!outer)
+    return NULL;
+
+  /* outermost_invariant_loop_for_expr returns the function-level loop
+     (depth 0) when EXPR is invariant everywhere -- e.g. for a parameter.
+     That loop has no preheader, so clamp to the outermost real loop
+     enclosing LOOP.  */
+  if (loop_depth (outer) < 1)
+    outer = superloop_at_depth (loop, 1);
+
+  gcc_checking_assert (loop_depth (outer) >= 1
+		       && (outer == loop || flow_loop_nested_p (outer, loop)));
+  return outer;
+}
+
+/* Return true if it is worth strength-reducing a division in LOOP.  We
+   want the preheader cost (one division plus ~6 ALU ops) to be amortised.
+   Be conservative only when we positively know the loop is tiny.  */
+
+static bool
+invdiv_loop_worth_it_p (class loop *loop)
+{
+  /* If we have an upper bound on the trip count and it is small, the extra
+     preheader division may not pay for itself.  Two iterations already
+     break even on a 32-bit division; require three for margin.  */
+  HOST_WIDE_INT max = max_loop_iterations_int (loop);
+  if (max != -1 && max < 3)
+    return false;
+  return true;
+}
+
+/* Decide whether STMT, in LOOP, is a candidate.  On success return the
+   loop to hoist the magic computation to and set *DIVISOR.  */
+
+static class loop *
+invdiv_analyze_stmt (gassign *stmt, class loop *loop, tree *divisor)
+{
+  enum tree_code code = gimple_assign_rhs_code (stmt);
+  if (code != TRUNC_DIV_EXPR && code != TRUNC_MOD_EXPR)
+    return NULL;
+
+  tree lhs = gimple_assign_lhs (stmt);
+  tree type = TREE_TYPE (lhs);
+
+  /* Integral scalars only.  Vectors are handled by the vectorizer's own
+     pattern matcher.  Both signed and unsigned are supported; the signed
+     case is implemented on top of the unsigned one by dividing the
+     absolute values and fixing up the sign.  */
+  if (!INTEGRAL_TYPE_P (type)
+      || TREE_CODE (type) == BITINT_TYPE
+      || TYPE_PRECISION (type) > HOST_BITS_PER_WIDE_INT)
+    return NULL;
+
+  /* Enumeral and boolean types have a restricted value range that the
+     absolute-value fixup below is not written to respect.  */
+  if (TREE_CODE (type) != INTEGER_TYPE)
+    return NULL;
+
+  /* We build the magic in TYPE's mode; require the precision to match the
+     mode so that MULT_HIGHPART_EXPR means what we think it means.  Also
+     rules out bitfield-ish and partial-precision types.  */
+  scalar_int_mode mode;
+  if (!is_a <scalar_int_mode> (TYPE_MODE (type), &mode)
+      || TYPE_PRECISION (type) != GET_MODE_PRECISION (mode))
+    return NULL;
+
+  /* Very narrow types get promoted by the front end anyway, and for QImode
+     the highpart multiply is synthesized; still worth it, but require the
+     target to really have it (checked below).  */
+  tree op0 = gimple_assign_rhs1 (stmt);
+  tree op1 = gimple_assign_rhs2 (stmt);
+
+  /* A constant divisor is already handled far better by expand_divmod.  */
+  if (TREE_CODE (op1) != SSA_NAME)
+    return NULL;
+
+  /* Pointless if the numerator is invariant too -- then the whole division
+     is invariant and plain LIM will hoist it.  */
+  class loop *target = invdiv_hoist_target (loop, op1);
+  if (!target)
+    return NULL;
+  if (TREE_CODE (op0) != SSA_NAME
+      || outermost_invariant_loop_for_expr (target, op0) != NULL)
+    return NULL;
+
+  /* The target must have a highpart multiply for MODE, otherwise
+     MULT_HIGHPART_EXPR expands to something at least as bad as the
+     division we are trying to remove.  */
+  if (!can_mult_highpart_p (mode, true))
+    return NULL;
+
+  /* We need CLZ for MODE, or for some wider mode we can promote to.  */
+  if (!invdiv_clz_type (unsigned_type_for (type)))
+    return NULL;
+
+  /* And a 2*PREC-bit integer type in which to compute the magic number.
+     It must have a real integer mode; otherwise the preheader division
+     would itself be a libgcc call, which is not obviously a win.  */
+  unsigned wprec = 2 * TYPE_PRECISION (type);
+  if (wprec > MAX_FIXED_MODE_SIZE)
+    return NULL;
+  tree wtype = build_nonstandard_integer_type (wprec, 1);
+  if (!wtype || !is_a <scalar_int_mode> (TYPE_MODE (wtype)))
+    return NULL;
+
+  if (!invdiv_loop_worth_it_p (loop))
+    return NULL;
+
+  /* Statements that can throw would need their EH edges fixed up; the
+     division is the only thing that could trap and we are removing it,
+     but bail rather than deal with the bookkeeping.  */
+  if (stmt_can_throw_internal (cfun, stmt))
+    return NULL;
+
+  *divisor = op1;
+  return target;
+}
+
+/* Emit, into SEQ, the loop-invariant part of the magic-number computation
+   for dividing values of type TYPE by D.  Store the magic multiplier in
+   *M, the final shift in *SH and the fixup shift in *K.  */
+
+static void
+invdiv_build_magic (gimple_seq *seq, location_t loc, tree type, tree d,
+		    tree *m, tree *sh, tree *k)
+{
+  unsigned prec = TYPE_PRECISION (type);
+  tree utype = unsigned_type_for (type);
+
+  /* dnz = d | (d == 0)  -- never zero, so the preheader division is safe
+     even when the program would have divided by zero (which is UB).  */
+  tree diszero = gimple_build (seq, loc, EQ_EXPR, boolean_type_node, d,
+			       build_zero_cst (utype));
+  tree diszero_t = gimple_build (seq, loc, NOP_EXPR, utype, diszero);
+  tree dnz = gimple_build (seq, loc, BIT_IOR_EXPR, utype, d, diszero_t);
+
+  /* dm1 = dnz - 1 */
+  tree dm1 = gimple_build (seq, loc, MINUS_EXPR, utype, dnz,
+			   build_one_cst (utype));
+
+  /* nz = (dm1 != 0), as a value of UTYPE.  This is both the fixup shift
+     count K and the mask that folds the final shift to zero when d == 1.  */
+  tree dm1nzb = gimple_build (seq, loc, NE_EXPR, boolean_type_node, dm1,
+			      build_zero_cst (utype));
+  tree nz = gimple_build (seq, loc, NOP_EXPR, utype, dm1nzb);
+
+  /* dm1nz = dm1 | (dm1 == 0) -- CLZ argument, guaranteed nonzero so we do
+     not depend on CLZ's value at zero.  */
+  tree isone = gimple_build (seq, loc, BIT_XOR_EXPR, utype, nz,
+			     build_one_cst (utype));
+  tree dm1nz = gimple_build (seq, loc, BIT_IOR_EXPR, utype, dm1, isone);
+
+  /* l = prec - clz (dm1nz).  Compute CLZ in a type whose mode the target
+     really implements, widening if necessary; DM1NZ is nonzero by
+     construction so the value of CLZ at zero never matters.  */
+  tree clztype = invdiv_clz_type (utype);
+  unsigned clzprec = TYPE_PRECISION (clztype);
+  tree clzarg = dm1nz;
+  if (clztype != utype)
+    clzarg = gimple_build (seq, loc, NOP_EXPR, clztype, dm1nz);
+  tree clz = gimple_build (seq, loc, CFN_CLZ, integer_type_node, clzarg);
+  tree clzu = gimple_build (seq, loc, NOP_EXPR, utype, clz);
+  /* Account for the widening: bits above PREC are all zero, so CLZ over
+     CLZTYPE overcounts by CLZPREC - PREC.  */
+  tree lbits = gimple_build (seq, loc, MINUS_EXPR, utype,
+			     build_int_cst (utype, clzprec), clzu);
+  /* lbits == bit length of dm1nz == l for d >= 2, and 1 for d == 1
+     (because dm1nz was forced to 1).  Mask it with NZ so that d == 1
+     yields l == 0.  */
+  tree l = gimple_build (seq, loc, BIT_AND_EXPR, utype, lbits,
+			 gimple_build (seq, loc, NEGATE_EXPR, utype, nz));
+
+  /* c = prec - l ; num = (~(wide)0) >> c ; m = (T) (num / dnz + 1)
+     The wide type must hold 2*prec bits.  */
+  tree wtype = build_nonstandard_integer_type (2 * prec, 1);
+  tree c = gimple_build (seq, loc, MINUS_EXPR, utype,
+			 build_int_cst (utype, prec), l);
+  tree cw = gimple_build (seq, loc, NOP_EXPR, wtype, c);
+  tree allones = build_all_ones_cst (wtype);
+  tree num = gimple_build (seq, loc, RSHIFT_EXPR, wtype, allones, cw);
+  tree dw = gimple_build (seq, loc, NOP_EXPR, wtype, dnz);
+  tree quo = gimple_build (seq, loc, TRUNC_DIV_EXPR, wtype, num, dw);
+  tree quo1 = gimple_build (seq, loc, PLUS_EXPR, wtype, quo,
+			    build_one_cst (wtype));
+  *m = gimple_build (seq, loc, NOP_EXPR, utype, quo1);
+
+  /* sh = (l - 1) & -nz  -- i.e. l-1 for d >= 2, and 0 for d == 1.  */
+  tree lm1 = gimple_build (seq, loc, MINUS_EXPR, utype, l,
+			   build_one_cst (utype));
+  *sh = gimple_build (seq, loc, BIT_AND_EXPR, utype, lm1,
+		      gimple_build (seq, loc, NEGATE_EXPR, utype, nz));
+  *k = nz;
+}
+
+/* Rewrite STMT (a division or modulo by DIVISOR, invariant in TARGET) into
+   the magic-multiply sequence.  */
+
+static void
+invdiv_rewrite (gassign *stmt, tree divisor, class loop *target)
+{
+  location_t loc = gimple_location (stmt);
+  tree lhs = gimple_assign_lhs (stmt);
+  tree type = TREE_TYPE (lhs);
+  tree utype = unsigned_type_for (type);
+  tree n = gimple_assign_rhs1 (stmt);
+  bool is_mod = gimple_assign_rhs_code (stmt) == TRUNC_MOD_EXPR;
+
+  bool sgn = !TYPE_UNSIGNED (type);
+  unsigned prec = TYPE_PRECISION (type);
+  tree shcnt = build_int_cst (integer_type_node, prec - 1);
+
+  /* --- preheader ---------------------------------------------------- */
+  gimple_seq pre = NULL;
+  tree dcv = divisor;
+  if (!useless_type_conversion_p (utype, TREE_TYPE (divisor)))
+    dcv = gimple_build (&pre, loc, NOP_EXPR, utype, divisor);
+
+  /* For signed division, build the magic from |d| and remember sign(d)
+     as an all-ones/all-zeros mask.  |d| is computed as (d ^ sd) - sd,
+     which is correct even for d == INT_MIN (it yields 2^(N-1), the right
+     magnitude as an unsigned value).  */
+  tree sd = NULL_TREE;
+  if (sgn)
+    {
+      tree ds = gimple_build (&pre, loc, RSHIFT_EXPR, type, divisor, shcnt);
+      sd = gimple_build (&pre, loc, NOP_EXPR, utype, ds);
+      tree x = gimple_build (&pre, loc, BIT_XOR_EXPR, utype, dcv, sd);
+      dcv = gimple_build (&pre, loc, MINUS_EXPR, utype, x, sd);
+    }
+
+  tree m, sh, k;
+  invdiv_build_magic (&pre, loc, type, dcv, &m, &sh, &k);
+
+  edge pe = loop_preheader_edge (target);
+  gsi_insert_seq_on_edge_immediate (pe, pre);
+
+  /* --- loop body ---------------------------------------------------- */
+  gimple_seq body = NULL;
+  tree nu = n;
+  tree sn = NULL_TREE;
+  if (sgn)
+    {
+      /* nu = |n| ; sn = sign mask of n.  */
+      tree ns = gimple_build (&body, loc, RSHIFT_EXPR, type, n, shcnt);
+      sn = gimple_build (&body, loc, NOP_EXPR, utype, ns);
+      tree nc = gimple_build (&body, loc, NOP_EXPR, utype, n);
+      tree x = gimple_build (&body, loc, BIT_XOR_EXPR, utype, nc, sn);
+      nu = gimple_build (&body, loc, MINUS_EXPR, utype, x, sn);
+    }
+  else if (!useless_type_conversion_p (utype, TREE_TYPE (n)))
+    nu = gimple_build (&body, loc, NOP_EXPR, utype, n);
+
+  tree t1 = gimple_build (&body, loc, MULT_HIGHPART_EXPR, utype, nu, m);
+  tree t2 = gimple_build (&body, loc, MINUS_EXPR, utype, nu, t1);
+  tree t3 = gimple_build (&body, loc, RSHIFT_EXPR, utype, t2, k);
+  tree t4 = gimple_build (&body, loc, PLUS_EXPR, utype, t1, t3);
+  tree q  = gimple_build (&body, loc, RSHIFT_EXPR, utype, t4, sh);
+
+  /* Reapply the sign: q = (uq ^ s) - s where s = sign(n) ^ sign(d).  */
+  if (sgn)
+    {
+      tree sq = gimple_build (&body, loc, BIT_XOR_EXPR, utype, sn, sd);
+      tree x = gimple_build (&body, loc, BIT_XOR_EXPR, utype, q, sq);
+      q = gimple_build (&body, loc, MINUS_EXPR, utype, x, sq);
+    }
+
+  tree res = q;
+  if (is_mod)
+    {
+      /* r = n - q * d, computed in the unsigned type (wrapping is exactly
+	 what we want) and reinterpreted.  Use the ORIGINAL divisor, not
+	 the absolute value, and the original numerator.  */
+      tree nn = nu;
+      tree dd = dcv;
+      if (sgn)
+	{
+	  nn = gimple_build (&body, loc, NOP_EXPR, utype, n);
+	  dd = gimple_build (&body, loc, NOP_EXPR, utype, divisor);
+	}
+      tree prod = gimple_build (&body, loc, MULT_EXPR, utype, q, dd);
+      res = gimple_build (&body, loc, MINUS_EXPR, utype, nn, prod);
+    }
+  if (!useless_type_conversion_p (type, TREE_TYPE (res)))
+    res = gimple_build (&body, loc, NOP_EXPR, type, res);
+
+  gimple_stmt_iterator gsi = gsi_for_stmt (stmt);
+  gsi_insert_seq_before (&gsi, body, GSI_SAME_STMT);
+  /* Emit LHS = RES.  This looks like a redundant copy, but RES may have a
+     different (unsigned) type than LHS, and in any case copy propagation
+     removes it immediately.  Retargeting the defining statement at LHS
+     directly is *not* valid: it would silently change that statement's
+     result type, which -fchecking=2 rightly rejects.  */
+  gassign *newstmt = gimple_build_assign (lhs, res);
+  gsi_replace (&gsi, newstmt, true);
+
+  if (dump_enabled_p ())
+    dump_printf_loc (MSG_OPTIMIZED_LOCATIONS, stmt,
+		     "replaced %s by loop-invariant divisor with a "
+		     "reciprocal multiply\n", is_mod ? "modulo" : "division");
+}
+
+/* Main driver.  */
+
+static unsigned int
+invdiv_execute (function *fn)
+{
+  bool changed = false;
+  auto_vec<invdiv_cand> cands;
+  auto_vec<tree> divisors;
+
+  /* Collect first: rewriting perturbs the CFG-free statement walk.  */
+  for (auto loop : loops_list (fn, 0))
+    {
+      basic_block *bbs = get_loop_body (loop);
+      for (unsigned i = 0; i < loop->num_nodes; i++)
+	{
+	  /* Only look at blocks whose immediate loop is LOOP, so each
+	     statement is considered exactly once, in its own loop.  */
+	  if (bbs[i]->loop_father != loop)
+	    continue;
+	  for (gimple_stmt_iterator gsi = gsi_start_bb (bbs[i]);
+	       !gsi_end_p (gsi); gsi_next (&gsi))
+	    {
+	      gassign *stmt = dyn_cast <gassign *> (gsi_stmt (gsi));
+	      if (!stmt)
+		continue;
+	      tree divisor;
+	      class loop *target = invdiv_analyze_stmt (stmt, loop, &divisor);
+	      if (!target)
+		continue;
+	      invdiv_cand c; c.stmt = stmt; c.loop = target;
+	      cands.safe_push (c);
+	      divisors.safe_push (divisor);
+	    }
+	}
+      free (bbs);
+    }
+
+  for (unsigned i = 0; i < cands.length (); i++)
+    {
+      invdiv_rewrite (cands[i].stmt, divisors[i], cands[i].loop);
+      changed = true;
+    }
+
+  if (!changed)
+    return 0;
+
+  scev_reset ();
+  return TODO_update_ssa_only_virtuals | TODO_cleanup_cfg;
+}
+
+const pass_data pass_data_loop_invdiv =
+{
+  GIMPLE_PASS, /* type */
+  "linvdiv", /* name */
+  OPTGROUP_LOOP, /* optinfo_flags */
+  TV_LIM, /* tv_id */
+  PROP_cfg, /* properties_required */
+  0, /* properties_provided */
+  0, /* properties_destroyed */
+  0, /* todo_flags_start */
+  0, /* todo_flags_finish */
+};
+
+class pass_loop_invdiv : public gimple_opt_pass
+{
+public:
+  pass_loop_invdiv (gcc::context *ctxt)
+    : gimple_opt_pass (pass_data_loop_invdiv, ctxt)
+  {}
+
+  bool gate (function *) final override
+  {
+    return flag_tree_loop_invdiv && optimize >= 2 && !optimize_size;
+  }
+
+  unsigned int execute (function *fn) final override
+  {
+    if (number_of_loops (fn) <= 1)
+      return 0;
+    return invdiv_execute (fn);
+  }
+};
+
+} // anon namespace
+
+gimple_opt_pass *
+make_pass_loop_invdiv (gcc::context *ctxt)
+{
+  return new pass_loop_invdiv (ctxt);
+}
