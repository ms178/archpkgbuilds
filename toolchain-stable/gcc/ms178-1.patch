     }
+  /* ms178: also match the BIT_FIELD_REF assignment on its own.
+     Previously this recogniser only fired when the bitfield feeds a
+     CONVERT or a gcond.  Any other consumer -- BIT_AND_EXPR and a
+     comparison against a non-constant being the common ones -- left the
+     BIT_FIELD_REF in the IL, where SLP build rejects it outright
+     ("BIT_FIELD_REF not supported", because the base is a loaded scalar
+     rather than an SSA vector) and the whole loop stayed scalar.
