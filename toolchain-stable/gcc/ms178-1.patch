diff --git a/gcc/tree-vect-patterns.cc b/gcc/tree-vect-patterns.cc
--- a/gcc/tree-vect-patterns.cc
+++ b/gcc/tree-vect-patterns.cc
@@ -2676,6 +2676,33 @@
       lhs = gimple_assign_lhs (stmt);
