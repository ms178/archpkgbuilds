diff --git a/gcc/Makefile.in b/gcc/Makefile.in
index 8ecef4ccd..30da61031 100644
--- a/gcc/Makefile.in
+++ b/gcc/Makefile.in
@@ -246,8 +246,15 @@ INSNRECOG_SEQ_O = $(patsubst %, insn-recog-%.o, $(INSNRECOG_SPLITS_SEQ))
