 # flex output may yield harmless "no previous prototype" warnings
-build/gengtype-lex.o-warn = -Wno-error
-gengtype-lex.o-warn = -Wno-error
+build/gengtype-lex.o-warn = -Wno-error -Wno-implicit-fallthrough
