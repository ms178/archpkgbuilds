+# -Wmaybe-uninitialized false positives from inlined int_range_max
+# temporaries: irange_bitmask's default constructor is intentionally
+# uninitialized for performance (value-range.h), and at -O2+ the
+# analyzer flags the wide_int_storage union member of dead copies.
+# Suppress per-object rather than pessimizing every range operation.
+gimple-ssa-warn-access.o-warn = -Wno-maybe-uninitialized
+tree-ssa-loop-niter.o-warn = -Wno-maybe-uninitialized
