diff --git a/libgomp/config/linux/wait.h b/libgomp/config/linux/wait.h
index f9141408c..cb0cec6f3 100644
--- a/libgomp/config/linux/wait.h
+++ b/libgomp/config/linux/wait.h
@@ -57,7 +57,16 @@ static inline int do_spin (int *addr, int val)
     if (__builtin_expect (__atomic_load_n (addr, MEMMODEL_RELAXED) != val, 0))
       return 0;
     else
-      cpu_relax ();
+      {
+	/* Two-phase back-off: plain NOPs during the first half of the
+	   spin window keep wakeup latency minimal, PAUSE afterwards
+	   yields pipeline resources to the sibling hyper-thread and
+	   reduces power (PAUSE costs ~30-40 cycles on modern cores).  */
+	if (i < count / 2)
+	  __asm__ __volatile__ ("nop\n\tnop\n\tnop" : : : "memory");
+	else
+	  cpu_relax ();
+      }
   return 1;
 }
 
