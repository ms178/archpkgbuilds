+	  if (TREE_CODE (arg) == SSA_NAME
+	      && !SSA_NAME_IS_DEFAULT_DEF (arg)
+	      && flow_bb_inside_loop_p (father,
+					gimple_bb (SSA_NAME_DEF_STMT (arg))))
+	    return true;
+	}
+    }
+
+  return false;
