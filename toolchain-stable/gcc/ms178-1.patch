diff --git a/gcc/testsuite/gcc.dg/graphite/ms178-isl-error-reset.c b/gcc/testsuite/gcc.dg/graphite/ms178-isl-error-reset.c
new file mode 100644
index 0000000..dbb8e3a
--- /dev/null
+++ b/gcc/testsuite/gcc.dg/graphite/ms178-isl-error-reset.c
@@ -0,0 +1,36 @@
+/* The isl_ctx is shared by every SCoP in a function, and
+   isl_ctx_last_error is sticky until explicitly reset.  optimize_isl ()
+   and scop_to_isl_ast () tested the error but never cleared it, so once
+   one loop nest hit the operation quota every *later* nest in the same
+   function saw the stale error and bailed out without being analysed --
+   one hard nest silently disabled Graphite for the rest of the function.
+
+   Here the first nest is expensive enough to consume a large share of a
+   restricted budget; the second is trivial and must still be optimized.  */
+/* { dg-do compile } */
+/* { dg-options "-O2 -floop-nest-optimize --param max-isl-operations=20000 -fdump-tree-graphite-details" } */
+
+#define N 64
+double A[N][N], B[N][N], C[N][N], X[N][N], Y[N][N];
+
+/* Keep the two nests in separate SCoPs.  */
+extern void barrier (void);
+
+void
+f (void)
+{
+  for (int i = 0; i < N; i++)
+    for (int j = 0; j < N; j++)
+      for (int k = 0; k < N; k++)
+	A[i][j] += B[i][k] * C[k][j];
+
+  barrier ();
+
+  for (int i = 0; i < N; i++)
+    for (int j = 0; j < N; j++)
+      X[i][j] = Y[j][i] + 1.0;
+}
+
+/* The second nest must be reached and optimized.  Before the fix the
+   stale error made Graphite abandon it, producing no such message.  */
+/* { dg-final { scan-tree-dump "loop nest optimized" "graphite" } } */
diff --git a/gcc/testsuite/gcc.dg/pr102202-fold.c b/gcc/testsuite/gcc.dg/pr102202-fold.c
new file mode 100644
index 0000000..5e2e581
--- /dev/null
+++ b/gcc/testsuite/gcc.dg/pr102202-fold.c
@@ -0,0 +1,35 @@
+/* PR tree-optimization/102202 */
+/* { dg-do compile } */
+/* { dg-options "-O2 -fdump-tree-optimized" } */
+
+/* A constant-length-one memset is folded to a single byte store, even for a
+   store through an arbitrary pointer.  */
+
+void *
+g1 (char *d, int c)
+{
+  return __builtin_memset (d, c, 1);
+}
+
+void
+g2 (char *d, int c)
+{
+  __builtin_memset (d, c, 1);
+}
+
+void *
+g3 (int *p, int c)
+{
+  return __builtin_memset (p, c, 1);
+}
+
+void *
+g4 (char *d)
+{
+  return __builtin_memset (d, 7, 1);
+}
+
+/* { dg-final { scan-tree-dump-not "__builtin_memset" "optimized" } } */
+/* { dg-final { scan-tree-dump-times {\(unsigned char\) c_[0-9]+\(D\)} 3 "optimized" } } */
+/* { dg-final { scan-tree-dump-times {MEM[^;\n\r]*= _[0-9]+;} 3 "optimized" } } */
+/* { dg-final { scan-tree-dump-times {MEM[^;\n\r]*= 7;} 1 "optimized" } } */
diff --git a/gcc/testsuite/gcc.dg/tree-ssa/ms178-invdiv-1.c b/gcc/testsuite/gcc.dg/tree-ssa/ms178-invdiv-1.c
new file mode 100644
index 0000000..fc41f80
--- /dev/null
+++ b/gcc/testsuite/gcc.dg/tree-ssa/ms178-invdiv-1.c
@@ -0,0 +1,63 @@
+/* Division/modulo by a loop-invariant (non-constant) divisor should be
+   strength-reduced to a reciprocal multiply, with the magic-number
+   computation hoisted into the loop preheader.  */
+/* { dg-do compile } */
+/* { dg-options "-O2 -fdump-tree-linvdiv-details" } */
+
+void
+d32 (unsigned *o, const unsigned *a, unsigned n, unsigned d)
+{
+  for (unsigned i = 0; i < n; i++)
+    o[i] = a[i] / d;
+}
+
+void
+m32 (unsigned *o, const unsigned *a, unsigned n, unsigned d)
+{
+  for (unsigned i = 0; i < n; i++)
+    o[i] = a[i] % d;
+}
+
+void
+d64 (unsigned long long *o, const unsigned long long *a, unsigned n,
+     unsigned long long d)
+{
+  for (unsigned i = 0; i < n; i++)
+    o[i] = a[i] / d;
+}
+
+/* Signed division is handled too, via |n| / |d| plus a sign fixup.  */
+void
+dsigned (int *o, const int *a, unsigned n, int d)
+{
+  for (unsigned i = 0; i < n; i++)
+    o[i] = a[i] / d;
+}
+
+void
+msigned (int *o, const int *a, unsigned n, int d)
+{
+  for (unsigned i = 0; i < n; i++)
+    o[i] = a[i] % d;
+}
+
+/* A constant divisor is already handled better by expand_divmod.  */
+void
+dconst (unsigned *o, const unsigned *a, unsigned n)
+{
+  for (unsigned i = 0; i < n; i++)
+    o[i] = a[i] / 7u;
+}
+
+/* A loop that is known to run at most twice does not amortise the extra
+   preheader division.  */
+void
+dtiny (unsigned *o, const unsigned *a, unsigned d)
+{
+  for (unsigned i = 0; i < 2; i++)
+    o[i] = a[i] / d;
+}
+
+/* { dg-final { scan-tree-dump-times "replaced division by loop-invariant divisor" 3 "linvdiv" } } */
+/* { dg-final { scan-tree-dump-times "replaced modulo by loop-invariant divisor" 2 "linvdiv" } } */
+/* { dg-final { scan-tree-dump-times " h\\* " 5 "linvdiv" } } */
diff --git a/gcc/testsuite/gcc.dg/tree-ssa/ms178-invdiv-2.c b/gcc/testsuite/gcc.dg/tree-ssa/ms178-invdiv-2.c
new file mode 100644
index 0000000..2d1fc4c
--- /dev/null
+++ b/gcc/testsuite/gcc.dg/tree-ssa/ms178-invdiv-2.c
@@ -0,0 +1,180 @@
+/* Runtime correctness of the loop-invariant division strength reduction.
+   Exercises the two values the textbook magic-number scheme cannot
+   express -- d == 1 and powers of two -- as well as a divisor of zero on
+   a path where the division never actually executes (which must not make
+   the hoisted precomputation trap).  */
+/* { dg-do run } */
+/* { dg-options "-O2" } */
+
+extern void abort (void);
+
+#define N 64
+
+static unsigned ua[N], uo[N];
+static unsigned long long qa[N], qo[N];
+
+__attribute__((noinline)) static void
+d32 (unsigned *o, const unsigned *a, unsigned n, unsigned d)
+{
+  for (unsigned i = 0; i < n; i++)
+    o[i] = a[i] / d;
+}
+
+__attribute__((noinline)) static void
+m32 (unsigned *o, const unsigned *a, unsigned n, unsigned d)
+{
+  for (unsigned i = 0; i < n; i++)
+    o[i] = a[i] % d;
+}
+
+__attribute__((noinline)) static void
+d64 (unsigned long long *o, const unsigned long long *a, unsigned n,
+     unsigned long long d)
+{
+  for (unsigned i = 0; i < n; i++)
+    o[i] = a[i] / d;
+}
+
+__attribute__((noinline)) static void
+sd32 (int *o, const int *a, unsigned n, int d)
+{
+  for (unsigned i = 0; i < n; i++)
+    o[i] = a[i] / d;
+}
+
+__attribute__((noinline)) static void
+sm32 (int *o, const int *a, unsigned n, int d)
+{
+  for (unsigned i = 0; i < n; i++)
+    o[i] = a[i] % d;
+}
+
+__attribute__((noinline)) static long long
+sd64 (long long x, long long d)
+{
+  long long s = 0;
+  for (unsigned i = 0; i < 4; i++)
+    s += (x + i) / d;
+  return s;
+}
+
+/* The division is guarded and never runs; D is zero.  The program is
+   well defined, so neither must the transformed one trap.  */
+__attribute__((noinline)) static unsigned
+guarded (const unsigned *a, unsigned n, unsigned d)
+{
+  unsigned s = 0;
+  for (unsigned i = 0; i < n; i++)
+    if (a[i] & 1)
+      s += a[i] / d;
+  return s;
+}
+
+int
+main (void)
+{
+  static const unsigned ds[] = { 1, 2, 3, 4, 7, 8, 255, 256, 65535, 65536,
+				 0x7fffffffu, 0x80000000u, 0xfffffffbu,
+				 0xffffffffu };
+  unsigned seed = 12345;
+
+  for (unsigned i = 0; i < N; i++)
+    {
+      seed = seed * 1103515245u + 12345u;
+      ua[i] = seed;
+      qa[i] = (unsigned long long) seed * 0x9E3779B97F4A7C15ull;
+    }
+
+  for (unsigned j = 0; j < sizeof (ds) / sizeof (ds[0]); j++)
+    {
+      volatile unsigned vd = ds[j];
+      unsigned d = vd;
+      volatile unsigned long long vq = ds[j];
+      unsigned long long q = vq;
+
+      d32 (uo, ua, N, d);
+      for (unsigned i = 0; i < N; i++)
+	if (uo[i] != ua[i] / d)
+	  abort ();
+
+      m32 (uo, ua, N, d);
+      for (unsigned i = 0; i < N; i++)
+	if (uo[i] != ua[i] % d)
+	  abort ();
+
+      d64 (qo, qa, N, q);
+      for (unsigned i = 0; i < N; i++)
+	if (qo[i] != qa[i] / q)
+	  abort ();
+    }
+
+  /* Signed: exercise both signs, 1, -1, powers of two and the extremes.
+     -1 is combined only with numerators that are not the minimum value,
+     since INT_MIN / -1 is undefined.  */
+  {
+    static const int sds[] = { 1, -1, 2, -2, 3, -3, 8, -8, 1000, -1000,
+			       0x40000000, (-0x7fffffff - 1), 0x7fffffff };
+    static int sa[N], so[N];
+
+    for (unsigned j = 0; j < sizeof (sds) / sizeof (sds[0]); j++)
+      {
+	volatile int vd = sds[j];
+	int d = vd;
+
+	for (unsigned i = 0; i < N; i++)
+	  {
+	    seed = seed * 1103515245u + 12345u;
+	    sa[i] = (int) seed;
+	    if (d == -1 && sa[i] == (-0x7fffffff - 1))
+	      sa[i] = 0;
+	  }
+	sa[0] = 0;
+	sa[1] = d;
+	sa[2] = -d;
+	sa[3] = 0x7fffffff;
+	if (d != -1)
+	  sa[4] = (-0x7fffffff - 1);
+
+	sd32 (so, sa, N, d);
+	for (unsigned i = 0; i < N; i++)
+	  if (so[i] != sa[i] / d)
+	    abort ();
+
+	sm32 (so, sa, N, d);
+	for (unsigned i = 0; i < N; i++)
+	  if (so[i] != sa[i] % d)
+	    abort ();
+
+	{
+	  volatile long long vq = sds[j];
+	  long long q = vq;
+	  long long want = 0;
+	  for (unsigned i = 0; i < 4; i++)
+	    want += (1234567LL + i) / q;
+	  if (sd64 (1234567LL, q) != want)
+	    abort ();
+	}
+      }
+
+    /* Signed divide-by-zero and by -1 on a path that never executes.  */
+    {
+      volatile int z = 0, m1 = -1;
+      for (unsigned i = 0; i < N; i++)
+	sa[i] = 2 * i;                  /* all even */
+      if (guarded ((unsigned *) sa, 0, z) != 0)
+	abort ();
+      (void) m1;
+    }
+  }
+
+  /* All entries even, so the guarded division never executes.  */
+  for (unsigned i = 0; i < N; i++)
+    ua[i] = 2 * i;
+  {
+    volatile unsigned zero = 0;
+    if (guarded (ua, N, zero) != 0)
+      abort ();
+  }
+
+  return 0;
+}
diff --git a/gcc/testsuite/gcc.dg/vect/ms178-cost-overflow-1.c b/gcc/testsuite/gcc.dg/vect/ms178-cost-overflow-1.c
new file mode 100644
index 0000000..f2b6b0b
--- /dev/null
+++ b/gcc/testsuite/gcc.dg/vect/ms178-cost-overflow-1.c
@@ -0,0 +1,34 @@
+/* The loop cost model accumulates per-statement costs into unsigned
+   counters that are scaled by --param=vect-inner-loop-cost-factor (which
+   may be as large as 10000).  Before the ms178 fix several expressions in
+   vect_estimate_min_profitable_iters mixed those unsigned values with int
+   arithmetic, so a large body cost could wrap and turn an unprofitable
+   loop into an apparently profitable one (or vice versa).
+
+   This test just makes sure the compiler still behaves sanely - it must
+   not ICE and must still vectorize the trivially profitable loop - when
+   the cost factor is pushed to its maximum.  */
+/* { dg-do compile } */
+/* { dg-additional-options "--param=vect-inner-loop-cost-factor=10000" } */
+
+#define N 1024
+float a[N], b[N], c[N];
+
+void
+simple (void)
+{
+  for (int i = 0; i < N; i++)
+    c[i] = a[i] + b[i];
+}
+
+double x[N][N], y[N][N], z[N][N];
+
+void
+nested (void)
+{
+  for (int i = 0; i < N; i++)
+    for (int j = 0; j < N; j++)
+      z[i][j] = x[i][j] * y[i][j] + z[i][j];
+}
+
+/* { dg-final { scan-tree-dump "vectorized 1 loops" "vect" } } */
diff --git a/gcc/testsuite/gcc.dg/vect/ms178-peel-sentinel-1.c b/gcc/testsuite/gcc.dg/vect/ms178-peel-sentinel-1.c
new file mode 100644
index 0000000..4d5a2ab
--- /dev/null
+++ b/gcc/testsuite/gcc.dg/vect/ms178-peel-sentinel-1.c
@@ -0,0 +1,34 @@
+/* vect_peeling_hash_choose_best_peeling() stores candidate costs in
+   unsigned int fields but seeded the running minimum with INT_MAX.  Any
+   peeling candidate costing more than 2^31-1 therefore lost the
+   "cost < min->cost" comparison unconditionally, so no candidate was
+   recorded and peel_info.dr_info stayed NULL - the caller then behaved as
+   if no peeling option existed at all.
+
+   Separately, vect_peeling_supportable() kept DR_STEP in an unsigned int
+   while comparing it against tree_to_shwi (), so two references with the
+   same negative step compared unequal and peeling was rejected.
+
+   This test only checks that the compiler still vectorizes these loops
+   and does not ICE; the fixes are validated numerically elsewhere.  */
+/* { dg-do compile } */
+/* { dg-additional-options "--param=vect-inner-loop-cost-factor=10000" } */
+
+void
+descending (float *__restrict x, float *__restrict y,
+	    float *__restrict z, int n)
+{
+  for (int i = n - 1; i >= 0; i--)
+    z[i] = x[i] * y[i] + z[i];
+}
+
+struct three { int a, b, c; };
+
+void
+strided_descending (struct three *s, int n)
+{
+  for (int i = n - 1; i >= 0; i--)
+    s[i].a = s[i].b + s[i].c;
+}
+
+/* { dg-final { scan-tree-dump "vectorized 1 loops" "vect" } } */
diff --git a/gcc/testsuite/gcc.dg/vect/ms178-scev-rshift-1.c b/gcc/testsuite/gcc.dg/vect/ms178-scev-rshift-1.c
new file mode 100644
index 0000000..7b3ee1b
--- /dev/null
+++ b/gcc/testsuite/gcc.dg/vect/ms178-scev-rshift-1.c
@@ -0,0 +1,83 @@
+/* An induction variable stepped by a multiple of 2^C and then shifted
+   right by C is still an affine index, so SCEV must model it.
+
+   SCEV modelled A << B as A * (1 << B) but had no RSHIFT_EXPR case at
+   all, so any right shift of an IV produced chrec_dont_know and poisoned
+   every analysis downstream.  That is unfortunate because "advance a byte
+   cursor, then scale it back down to an element index" is a standard
+   iterator idiom: Mesa's mesa_bytes_to_hex (src/util/hex.h) steps i by 2
+   and subscripts binary[i >> 1], and ACO's PhysRegIterator steps reg_b by
+   4 and subscripts regs[reg_b >> 2].
+
+   The transform is only valid when the step is a multiple of 2^C (else the
+   discarded low bits accumulate and the sequence is a staircase) and when
+   the accumulation cannot wrap.  Both guards are exercised here.  */
+/* { dg-require-effective-target vect_int } */
+/* { dg-additional-options "-fdump-tree-vect-details" } */
+
+#include <stdarg.h>
+#include "tree-vect.h"
+
+#define N 256
+unsigned char bin[N];
+char buf[N * 2 + 2];
+
+/* Exactly Mesa's mesa_bytes_to_hex loop.  */
+__attribute__((noipa)) void
+to_hex (char *b, const unsigned char *s, unsigned len)
+{
+  static const char hd[] = "0123456789abcdef";
+  unsigned i;
+  for (i = 0; i < len * 2; i += 2)
+    {
+      b[i] = hd[s[i >> 1] >> 4];
+      b[i + 1] = hd[s[i >> 1] & 0x0f];
+    }
+  b[i] = '\0';
+}
+
+/* A step that is NOT a multiple of 2^C must not be miscompiled; the guard
+   rejects it and the loop simply stays as it was.  */
+__attribute__((noipa)) unsigned
+unaligned_step (const unsigned char *s, unsigned lo, unsigned hi)
+{
+  unsigned r = 0;
+  for (unsigned i = lo; i < hi; i += 3)
+    r += s[i >> 2];
+  return r;
+}
+
+int main (void)
+{
+  static const char hd[] = "0123456789abcdef";
+
+  check_vect ();
+
+  for (int i = 0; i < N; i++)
+    bin[i] = (unsigned char) (i * 7 + 3);
+
+  for (unsigned len = 0; len <= 64; len++)
+    {
+      char ref[N * 2 + 2];
+      unsigned i;
+      for (i = 0; i < len * 2; i += 2)
+	{
+	  ref[i] = hd[bin[i >> 1] >> 4];
+	  ref[i + 1] = hd[bin[i >> 1] & 0x0f];
+	}
+      ref[i] = '\0';
+
+      to_hex (buf, bin, len);
+      for (unsigned j = 0; j <= len * 2; j++)
+	if (buf[j] != ref[j])
+	  abort ();
+    }
+
+  unsigned ref2 = 0;
+  for (unsigned i = 0; i < 64; i += 3)
+    ref2 += bin[i >> 2];
+  if (unaligned_step (bin, 0, 64) != ref2)
+    abort ();
+
+  return 0;
+}
diff --git a/gcc/testsuite/gcc.dg/vect/ms178-vect-bitfield-op-1.c b/gcc/testsuite/gcc.dg/vect/ms178-vect-bitfield-op-1.c
new file mode 100644
index 0000000..e0d2c99
--- /dev/null
+++ b/gcc/testsuite/gcc.dg/vect/ms178-vect-bitfield-op-1.c
@@ -0,0 +1,59 @@
+/* A loop that does arithmetic on a bit-field must vectorize.
+
+   vect_recog_bitfield_ref_pattern only fired when the BIT_FIELD_REF fed a
+   CONVERT or a gcond.  Any other consumer left the BIT_FIELD_REF in the
+   IL, and SLP build then rejects it ("BIT_FIELD_REF not supported"),
+   leaving the whole loop scalar.
+
+   This is the shape Mesa's bit-packed IR nodes produce (ACO's
+   Temp { id:24; reg_class:8 }, nir_instr's flag bit-fields).  */
+/* { dg-require-effective-target vect_int } */
+/* { dg-additional-options "-fdump-tree-vect-details" } */
+
+#include <stdarg.h>
+#include "tree-vect.h"
+
+struct s { unsigned rc : 8; unsigned id : 24; };
+
+#define N 64
+struct s a[N];
+
+__attribute__((noipa)) unsigned
+f_and (struct s *p, unsigned n)
+{
+  unsigned s = 0;
+  for (unsigned i = 0; i < n; i++)
+    s += p[i].rc & 32;
+  return s;
+}
+
+__attribute__((noipa)) unsigned
+f_cmp (struct s *p, unsigned n)
+{
+  unsigned s = 0;
+  for (unsigned i = 0; i < n; i++)
+    s += p[i].rc > 3;
+  return s;
+}
+
+int main (void)
+{
+  check_vect ();
+
+  unsigned ref_and = 0, ref_cmp = 0;
+  for (unsigned i = 0; i < N; i++)
+    {
+      a[i].rc = (i * 7) & 0xff;
+      a[i].id = i;
+      ref_and += a[i].rc & 32;
+      ref_cmp += a[i].rc > 3;
+    }
+
+  if (f_and (a, N) != ref_and)
+    abort ();
+  if (f_cmp (a, N) != ref_cmp)
+    abort ();
+  return 0;
+}
+
+/* { dg-final { scan-tree-dump-times "vectorized 1 loops" 2 "vect" } } */
diff --git a/gcc/testsuite/gcc.target/i386/ms178-fp-clamp-1.c b/gcc/testsuite/gcc.target/i386/ms178-fp-clamp-1.c
new file mode 100644
index 0000000..18c7cf7
--- /dev/null
+++ b/gcc/testsuite/gcc.target/i386/ms178-fp-clamp-1.c
@@ -0,0 +1,31 @@
+/* A scalar float clamp written with the comparison the "other way round"
+   must still select minss/maxss.
+
+   Inverting an ordered FP compare while NaNs are honoured has to produce
+   the UNORDERED complement (x < c  =>  x UNGE c).  phiopt's non-IEEE
+   MIN/MAX fallback only accepted the four ordered codes, so the inverted
+   spelling kept a real branch in the IL and RTL if-conversion then turned
+   it into a GPR round-trip: vucomiss + vmovd + cmova + vmovd.
+
+   -fno-trapping-math is what exposes it: with trapping math the compare
+   cannot be speculated and a branch survives for other reasons, so this
+   test would pass vacuously without it.
+
+   This is Mesa's CLAMP()/SATURATE() shape.  */
+/* { dg-do compile } */
+/* { dg-options "-O2 -mavx -mfpmath=sse -fno-trapping-math -fno-math-errno" } */
+
+#define CLAMP(X, MIN, MAX)  ((X) > (MIN) ? ((X) > (MAX) ? (MAX) : (X)) : (MIN))
+
+float  hi_con  (float x)          { return x > 1.0f ? 1.0f : x; }
+float  hi_reg  (float x, float b) { return x > b ? b : x; }
+float  lo_reg  (float x, float b) { return x < b ? b : x; }
+double hi_cond (double x)         { return x > 1.0 ? 1.0 : x; }
+
+/* Every one of these is a single min/max; none may fall back to moving the
+   value through a general register to use cmov.  */
+/* { dg-final { scan-assembler-times "vminss" 2 } } */
+/* { dg-final { scan-assembler-times "vmaxss" 1 } } */
+/* { dg-final { scan-assembler-times "vminsd" 1 } } */
+/* { dg-final { scan-assembler-not "cmova" } } */
+/* { dg-final { scan-assembler-not "cmovb" } } */
diff --git a/gcc/testsuite/gcc.target/i386/ms178-mulx-highpart-1.c b/gcc/testsuite/gcc.target/i386/ms178-mulx-highpart-1.c
new file mode 100644
index 0000000..05d5874
--- /dev/null
+++ b/gcc/testsuite/gcc.target/i386/ms178-mulx-highpart-1.c
@@ -0,0 +1,23 @@
+/* An unsigned highpart-only multiply must use BMI2 MULX with both
+   destinations equal, which needs no scratch register and no move of the
+   result out of %rdx.  The signed case has no MULX form and must keep
+   using IMUL.  */
+/* { dg-do compile { target { ! ia32 } } } */
+/* { dg-options "-O2 -mbmi2" } */
+
+typedef unsigned long long u64;
+
+u64 hi64 (u64 a, u64 b)
+{ return (unsigned __int128) a * b >> 64; }
+
+u64 hi64m (u64 a, const u64 *p)
+{ return (unsigned __int128) a * *p >> 64; }
+
+long long shi64 (long long a, long long b)
+{ return (__int128) a * b >> 64; }
+
+/* Two MULX, one for each unsigned highpart.  */
+/* { dg-final { scan-assembler-times "mulx\[ \t\]" 2 } } */
+/* The unsigned MUL form must be gone; only the signed IMUL remains.  */
+/* { dg-final { scan-assembler-not "\[ \t\]mulq" } } */
+/* { dg-final { scan-assembler-times "imulq" 1 } } */
diff --git a/gcc/testsuite/gcc.target/i386/ms178-subvec-insert-1.c b/gcc/testsuite/gcc.target/i386/ms178-subvec-insert-1.c
new file mode 100644
index 0000000..b8388a1
--- /dev/null
+++ b/gcc/testsuite/gcc.target/i386/ms178-subvec-insert-1.c
@@ -0,0 +1,31 @@
+/* Inserting a 128-bit sub-vector into a 256-bit vector, or a 256-bit one
+   into a 512-bit vector, must use a single vinsert[fi]128 / vinsert*x4 /
+   vinsert*x8 rather than spilling the whole vector to the stack.  */
+/* { dg-do compile { target { ! ia32 } } } */
+/* { dg-options "-O2 -mavx2" } */
+
+#include <string.h>
+
+typedef int v4si __attribute__((vector_size(16)));
+typedef int v8si __attribute__((vector_size(32)));
+typedef float v4sf __attribute__((vector_size(16)));
+typedef float v8sf __attribute__((vector_size(32)));
+typedef double v2df __attribute__((vector_size(16)));
+typedef double v4df __attribute__((vector_size(32)));
+
+v8si set_hi (v8si r, v4si hi)
+{ memcpy ((char *) &r + 16, &hi, 16); return r; }
+
+v8si set_lo (v8si r, v4si lo)
+{ memcpy (&r, &lo, 16); return r; }
+
+v8sf set_hif (v8sf r, v4sf hi)
+{ memcpy ((char *) &r + 16, &hi, 16); return r; }
+
+v4df set_hid (v4df r, v2df hi)
+{ memcpy ((char *) &r + 16, &hi, 16); return r; }
+
+/* No stack frame and no spill of the vector may remain.  */
+/* { dg-final { scan-assembler-not "and\[lq\]?\[ \t\]*\\\$-32" } } */
+/* { dg-final { scan-assembler-not "%rbp" } } */
+/* { dg-final { scan-assembler-times "vinsert" 4 } } */
diff --git a/gcc/testsuite/gcc.target/i386/ms178-vec-merge-fuse-1.c b/gcc/testsuite/gcc.target/i386/ms178-vec-merge-fuse-1.c
new file mode 100644
index 0000000..5b1edf5
--- /dev/null
+++ b/gcc/testsuite/gcc.target/i386/ms178-vec-merge-fuse-1.c
@@ -0,0 +1,41 @@
+/* Zeroing several lanes of a 128-bit vector one lane at a time must
+   collapse into a single insertps, not one insn per lane.  This relies
+   on the nested VEC_MERGE fusion in simplify_ternary_operation:
+     (vec_merge (vec_merge A B sel0) B sel)
+       -> (vec_merge A B (sel0 & sel))
+   where B is the all-zeros vector supplied by
+   sse4_1_insertps_<mode>_zero.  */
+/* { dg-do compile } */
+/* { dg-options "-O2 -msse4.1" } */
+
+typedef int v4si __attribute__ ((vector_size (16)));
+typedef float v4sf __attribute__ ((vector_size (16)));
+
+v4sf
+zero_two_lanes_f (v4sf v)
+{
+  v[0] = 0.0f;
+  v[2] = 0.0f;
+  return v;
+}
+
+v4sf
+zero_three_lanes_f (v4sf v)
+{
+  v[0] = 0.0f;
+  v[1] = 0.0f;
+  v[3] = 0.0f;
+  return v;
+}
+
+v4si
+zero_two_lanes_i (v4si v)
+{
+  v[1] = 0;
+  v[3] = 0;
+  return v;
+}
+
+/* Each function must need exactly one insertps.  Before the fusion rule
+   these emitted one insertps per zeroed lane.  */
+/* { dg-final { scan-assembler-times "insertps" 3 } } */
diff --git a/gcc/testsuite/gcc.target/i386/ms178-vecset-retype-1.c b/gcc/testsuite/gcc.target/i386/ms178-vecset-retype-1.c
new file mode 100644
index 0000000..e514148
--- /dev/null
+++ b/gcc/testsuite/gcc.target/i386/ms178-vecset-retype-1.c
@@ -0,0 +1,28 @@
+/* Storing through a pointer whose element type differs from the vector's
+   element type must still use vec_set instead of spilling the whole
+   vector to the stack.  __m256i/__m512i are vectors of long long, so the
+   common intrinsic idiom ((int *) &v)[i] = x has SImode fields in a
+   V4DI/V8DI vector.  */
+/* { dg-do compile } */
+/* { dg-options "-O2 -mavx2" } */
+
+#include <immintrin.h>
+
+__m256i
+zero_lane1 (__m256i v)
+{
+  ((int *) &v)[1] = 0;
+  return v;
+}
+
+__m256i
+set_lane2 (__m256i v, int x)
+{
+  ((int *) &v)[2] = x;
+  return v;
+}
+
+/* Neither function may build a stack frame; before this fix both spilled
+   the vector to an aligned stack slot and read it back.  */
+/* { dg-final { scan-assembler-not "andq\t\\\$-32, %rsp" } } */
+/* { dg-final { scan-assembler-not "vmovdqa\t%ymm\[0-9\]+, -\[0-9\]+\\(%rsp\\)" } } */
diff --git a/gcc/testsuite/gcc.target/i386/ms178-vecset-zero-2di-1.c b/gcc/testsuite/gcc.target/i386/ms178-vecset-zero-2di-1.c
new file mode 100644
index 0000000..71d7da2
--- /dev/null
+++ b/gcc/testsuite/gcc.target/i386/ms178-vecset-zero-2di-1.c
@@ -0,0 +1,25 @@
+/* Zeroing one 64-bit lane of a V2DI/V2DF covers exactly two 32-bit lanes,
+   so it can be done with a single insertps rather than materialising a
+   zero in a GPR and using vpinsrq.  */
+/* { dg-do compile } */
+/* { dg-options "-O2 -msse4.1" } */
+
+typedef long long v2di __attribute__ ((vector_size (16)));
+typedef double v2df __attribute__ ((vector_size (16)));
+
+v2di
+zq0 (v2di v)
+{
+  v[0] = 0;
+  return v;
+}
+
+v2df
+zd0 (v2df v)
+{
+  v[0] = 0.0;
+  return v;
+}
+
+/* { dg-final { scan-assembler-not "pinsrq" } } */
+/* { dg-final { scan-assembler-times "insertps" 2 } } */
