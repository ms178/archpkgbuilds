diff --git a/gcc/testsuite/gcc.target/i386/zext-avx512f-1.c b/gcc/testsuite/gcc.target/i386/zext-avx512f-1.c
new file mode 100644
index 0000000..deae5e4
--- /dev/null
+++ b/gcc/testsuite/gcc.target/i386/zext-avx512f-1.c
@@ -0,0 +1,241 @@
+/* PR target/126231  */
+/* { dg-do compile { target { *-*-linux* && lp64 } } } */
+/* { dg-options "-O2 -march=x86-64-v4" } */
+/* Keep labels and directives ('.cfi_startproc', '.cfi_endproc').  */
+/* { dg-final { check-function-bodies "**" "" "" { target "*-*-*" } {^\t?\.}  } } */
+
+#include <x86intrin.h>
+
+/*
+**func1:
+**.LFB[0-9]+:
+**	.cfi_startproc
+**	vcvttss2sil	%xmm0, %eax
+**	ret
+**	.cfi_endproc
+**...
+*/
+
+unsigned long long
