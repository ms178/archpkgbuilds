diff --git a/gcc/tree-scalar-evolution.cc b/gcc/tree-scalar-evolution.cc
index dcbec9c..6f7eb58 100644
--- a/gcc/tree-scalar-evolution.cc
+++ b/gcc/tree-scalar-evolution.cc
@@ -1891,6 +1891,104 @@ interpret_rhs_expr (class loop *loop, gimple *at_stmt,
 	res = chrec_convert (type, res, at_stmt);
       break;
 
+    case RSHIFT_EXPR:
+      {
+	/* ms178: handle A >> C for a constant C when the low C bits of A
+	   are loop-invariant, i.e. when the chrec's step is a multiple of
+	   2^C.  Then no carry ever crosses the shift boundary and
+
+	       ({base, +, step} >> C)  ==  {base >> C, +, step >> C}
+
+	   holds at every iteration.
+
+	   SCEV already models A << B as A * (1 << B) but had no case at
+	   all for the opposite direction, so any right shift of an
+	   induction variable produced chrec_dont_know and poisoned every
+	   analysis downstream of it.  That is unfortunate because
+	   "advance a byte cursor, then scale it back down to an element
+	   index" is a standard way to write an iterator class: ACO's
+	   PhysRegIterator steps reg_b by 4 and subscripts regs[reg_b >> 2],
+	   and Mesa's mesa_bytes_to_hex steps i by 2 and subscripts
+	   binary[i >> 1].
+
+	   Correctness needs BOTH of:
+
+	     (a) STEP is a multiple of 2^C.  Otherwise the discarded low
+		 bits accumulate across iterations and the sequence is a
+		 staircase, not an affine function.  Brute force over
+		 355636352 (base, step, k, C) combinations finds the claim
+		 violated 221520100 times when this guard is dropped.
+
+	     (b) the accumulation does not wrap.  If {base, +, step} wraps
+		 modulo 2^N then the shifted sequence wraps modulo 2^(N-C),
+		 which is NOT what {base >> C, +, step >> C} evaluates to
+		 in the original N-bit type.  The same brute force finds
+		 the same-width claim wrong 19347472 times, every one of
+		 them a wrap.
+
+	   (b) is discharged two ways.  A type whose overflow is undefined
+	   cannot wrap in a valid program, which nowrap_type_p () answers
+	   directly.  Otherwise -- and this is the ubiquitous case,
+	   because iterator classes count in unsigned -- ask the loop
+	   itself via scev_probably_wraps_p (), which uses the number of
+	   iterations to decide whether base + step*niter can leave the
+	   range.  Being conservative costs nothing: the fallback is
+	   chrec_dont_know, exactly the behaviour before this change.  */
+	tree cst = rhs2;
+	chrec1 = analyze_scalar_evolution (loop, rhs1);
+	chrec1 = instantiate_parameters (loop, chrec1);
+
+	if (TREE_CODE (cst) != INTEGER_CST
+	    || tree_int_cst_sign_bit (cst)
+	    || !INTEGRAL_TYPE_P (type)
+	    || TYPE_UNSIGNED (TREE_TYPE (rhs1)) != TYPE_UNSIGNED (type)
+	    || TREE_CODE (chrec1) != POLYNOMIAL_CHREC
+	    || !evolution_function_is_affine_p (chrec1))
+	  {
+	    res = chrec_dont_know;
+	    break;
+	  }
+
+	unsigned HOST_WIDE_INT shift = tree_to_uhwi (cst);
+	unsigned prec = TYPE_PRECISION (type);
+	if (shift == 0 || shift >= prec)
+	  {
+	    res = chrec_dont_know;
+	    break;
+	  }
+
+	/* (a) the step must be a multiple of 2^shift.  */
+	tree step = CHREC_RIGHT (chrec1);
+	tree base = CHREC_LEFT (chrec1);
+	if (TREE_CODE (step) != INTEGER_CST
+	    || !integer_zerop (int_const_binop (BIT_AND_EXPR, step,
+						build_int_cst (TREE_TYPE (step),
+							       (HOST_WIDE_INT_1U
+								<< shift) - 1))))
+	  {
+	    res = chrec_dont_know;
+	    break;
+	  }
+
+	/* (b) the accumulation must not wrap.  */
+	if (!nowrap_type_p (type)
+	    && scev_probably_wraps_p (rhs1, base, step, at_stmt,
+				      get_loop (cfun, CHREC_VARIABLE (chrec1)),
+				      /*use_overflow_semantics=*/false))
+	  {
+	    res = chrec_dont_know;
+	    break;
+	  }
+
+	res = build_polynomial_chrec
+		(CHREC_VARIABLE (chrec1),
+		 fold_build2 (RSHIFT_EXPR, type,
+			      chrec_convert (type, base, at_stmt), cst),
+		 fold_build2 (RSHIFT_EXPR, type,
+			      chrec_convert (type, step, at_stmt), cst));
+      }
+      break;
+
     case LSHIFT_EXPR:
       {
 	/* Handle A<<B as A * (1<<B).  */
