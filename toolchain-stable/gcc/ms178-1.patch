diff --git a/gcc/testsuite/gcc.dg/vect/ms178-cost-overflow-1.c b/gcc/testsuite/gcc.dg/vect/ms178-cost-overflow-1.c
new file mode 100644
--- /dev/null
+++ b/gcc/testsuite/gcc.dg/vect/ms178-cost-overflow-1.c
@@ -0,0 +1,34 @@
+/* The loop cost model accumulates per-statement costs into unsigned
+   counters that are scaled by --param=vect-inner-loop-cost-factor (which
+   may be as large as 10000).  Before the ms178 fix several expressions in
+   vect_estimate_min_profitable_iters mixed those unsigned values with int
+   arithmetic, so a large body cost could wrap and turn an unprofitable
+   loop into an apparently profitable one (or vice versa).
+
+   This test just makes sure the compiler still behaves sanely - it must
+   not ICE and must still vectorize the trivially profitable loop - when
+   the cost factor is pushed to its maximum.  */
+/* { dg-do compile } */
+/* { dg-additional-options "--param=vect-inner-loop-cost-factor=10000" } */
+
+#define N 1024
+float a[N], b[N], c[N];
+
+void
+simple (void)
+{
+  for (int i = 0; i < N; i++)
+    c[i] = a[i] + b[i];
+}
+
+double x[N][N], y[N][N], z[N][N];
+
+void
+nested (void)
+{
+  for (int i = 0; i < N; i++)
+    for (int j = 0; j < N; j++)
