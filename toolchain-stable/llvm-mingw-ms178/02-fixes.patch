+# Reading bitmap byte counts must not wrap a uint8_t loop index at 256.
+# Regression for llvm-project PR #220620; added by the downstream audit.
+# RUN: %python -c 'print("large\n1\n1\n5\n$256\n" + "1\n" * 256)' > %t
+# RUN: llvm-profdata merge -text %t -o %t.out
+# RUN: FileCheck %s < %t.out
+
+# CHECK: large
+# CHECK: # Num Bitmap Bytes:
+# CHECK-NEXT: $256
+# CHECK-NEXT: # Bitmap Byte Values:
+# CHECK-COUNT-256: 0x1
+# CHECK-NOT: 0x1
