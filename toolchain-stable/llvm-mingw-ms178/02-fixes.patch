+unsigned X86RegisterInfo::getCSRFirstUseCost(const MachineFunction &MF) const {
+  const X86Subtarget &ST = MF.getSubtarget<X86Subtarget>();
+
+  // APX PPX (Push-Pop-acceleratorX) fuses push/pop pairs so the prologue
+  // overhead becomes negligible. Only available on 64-bit APX-enabled cores.
+  if (ST.is64Bit() && ST.hasPPX())
+    return 0;
+
+  // Default: 1x push at function entry + 1x pop at every return = 2 memory ops
+  // weighted by the entry-block frequency. This matches the cost model used in
+  // the SPEC CPU2017 measurements reported in PR #202007 and is symmetric with
+  // the AArch64/RISCV save/restore-pair cost.
+  return 2;
+}
