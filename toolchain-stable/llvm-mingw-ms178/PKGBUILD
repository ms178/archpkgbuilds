# Capture the recipe directory when sourced: makepkg later changes cwd to srcdir.
# A local llvm.profdata is an optional host-build input, not a shipped package file.
_recipe_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)

pkgname=llvm-mingw-ms178
pkgver=24.99.0
pkgrel=3
_llvmref=20b53106931742d2e5e64132f06994980fe94d7d
_mingwref=84eeb47960d4dfc7e1972fc2f682df8ba8049322
pkgdesc='Pinned LLVM MinGW-w64 snapshot: UCRT/Win10, i686+x86_64, ThinLTO and Polly'
arch=('x86_64')
url='https://github.com/ms178/archpkgbuilds/tree/main/toolchain-stable/llvm-mingw-ms178'
license=('Apache-2.0 WITH LLVM-exception' 'MIT' 'ZPL-2.1' 'BSD-3-Clause' 'LicenseRef-Public-Domain' 'GPL-3.0-or-later' 'LGPL-2.1-or-later')
depends=('glibc' 'gcc-libs' 'zlib' 'zstd' 'libxml2' 'bash')
makedepends=('git' 'cmake' 'ninja' 'python' 'autoconf' 'automake' 'libtool'
             'texinfo' 'pkgconf' 'clang' 'lld' 'llvm')
conflicts=('llvm-mingw' 'llvm-mingw-git' 'llvm-mingw-bin')
provides=("llvm-mingw=$pkgver")
options=('!strip' '!debug' '!lto' '!buildflags')
_llvmtools=(llvm-ar llvm-ranlib llvm-objdump llvm-rc llvm-cvtres llvm-nm llvm-strings llvm-readobj llvm-dlltool llvm-pdbutil llvm-objcopy llvm-strip llvm-cov llvm-profdata llvm-addr2line llvm-symbolizer llvm-windres llvm-ml llvm-readelf llvm-size llvm-cxxfilt llvm-lib)
_patches=(01-corecount.patch 02-fixes.patch 04-polly.patch
          05-raptorlake.patch 06-x86isellowcpp.patch 03-optimizations.patch)
source=("llvm-project::git+https://github.com/llvm/llvm-project.git#commit=$_llvmref"
        "mingw-w64::git+https://github.com/mingw-w64/mingw-w64.git#commit=$_mingwref"
        "${_patches[@]}")
sha256sums=('SKIP' 'SKIP'
    'ad2e931469a42baf5459ffece19acac2e4031880d2ff26c6b3e3d0efa7150d09'
    '9b6345539d951e33702dee3306a8c453d8e23b0c6d50e3fc095419c2caec7488'
