_die() { printf 'ERROR: %s\n' "$*" >&2; return 1; }
_note() { printf '==> %s\n' "$*"; }
_bool() { [[ $2 == 0 || $2 == 1 ]] || _die "$1 must be 0 or 1"; }
_positive() { [[ $2 =~ ^[1-9][0-9]*$ ]] || _die "$1 must be a positive integer"; }

# makepkg owns source retrieval and checkout. Never trust a .git directory or
# an old date-only stamp as evidence that the requested checkout is complete.
_verify_checkout() {
    local dir=$1 ref=$2 required=$3
    [[ -d $dir ]] || { _die "Missing source checkout: $dir (run makepkg normally, not --noextract)"; return 1; }
    [[ $(git -C "$dir" rev-parse --show-toplevel) == "$(realpath "$dir")" ]] || return 1
    [[ $(git -C "$dir" rev-parse HEAD) == "$ref" ]] || { _die "Wrong or incomplete checkout: $dir; expected $ref"; return 1; }
    [[ -f $dir/$required ]] || { _die "Checkout is incomplete/sparse: $dir/$required is missing. Re-extract with makepkg --cleanbuild."; return 1; }
    [[ $(git -C "$dir" config --bool core.sparseCheckout) != true ]] || { _die "Sparse checkout unsupported: $dir"; return 1; }
    [[ -z $(git -C "$dir" ls-files --deleted) ]] || { _die "Tracked files missing in $dir; re-extract sources"; return 1; }
}

prepare() {
    _verify_checkout "$srcdir/llvm-project" "$_llvmref" llvm/lib/Support/Unix/Threading.inc || return
    _verify_checkout "$srcdir/mingw-w64" "$_mingwref" mingw-w64-crt/configure || return
    git -C "$srcdir/mingw-w64" diff --quiet HEAD || { _die 'Modified mingw-w64 sources; preserve your changes and re-extract'; return 1; }
    # Preflight ALL patches on an isolated touched-file tree. No source mutation
    # occurs until all hunks have passed with zero offsets/fuzz. The six patches
    # have disjoint ownership, so one git apply --index transaction is sufficient.
    python - "$srcdir" "$_llvmref" "${_patches[@]}" <<'PY'
import hashlib,json,os,pathlib,re,shutil,subprocess,sys,tempfile
root=pathlib.Path(sys.argv[1]).resolve(); tree=root/'llvm-project'; patches=[root/n for n in sys.argv[3:]]
def git(*args): return subprocess.check_output(['git','-C',str(tree),*args])
paths=[]
for p in patches:
    for a,b in re.findall(r'^diff --git a/(\S+) b/(\S+)$',p.read_text(),re.M):
        if a!=b or pathlib.PurePosixPath(a).is_absolute() or '..' in pathlib.PurePosixPath(a).parts: raise SystemExit('Unsupported/unsafe patch path')
        paths.append(a)
if not paths or len(paths)!=len(set(paths)): raise SystemExit('Patch paths overlap or are missing')
key=hashlib.sha256(sys.argv[2].encode()+b''.join(p.read_bytes() for p in patches)).hexdigest()
receipt=root/'.llvm-mingw-patches.json'
def state():
    return {'diff':hashlib.sha256(git('diff','HEAD','--binary')).hexdigest(), 'files':{f:hashlib.sha256((tree/f).read_bytes()).hexdigest() for f in paths if (tree/f).is_file()}}
if git('status','--porcelain','--untracked-files=all').strip():
    if receipt.exists():
        saved=json.loads(receipt.read_text())
        if saved.get('key')==key and saved.get('state')==state():
            untracked=git('ls-files','--others','--exclude-standard').strip()
            if not untracked: print('Verified already-prepared patch tree'); sys.exit(0)
    raise SystemExit('Dirty/partially patched source tree; refusing destructive reset. Use makepkg --cleanbuild after preserving local work.')
with tempfile.TemporaryDirectory(prefix='llvm-patch-preflight-',dir=root) as tmp:
    scratch=pathlib.Path(tmp)
    for f in paths:
        p=tree/f
        if p.is_file():
            q=scratch/f;q.parent.mkdir(parents=True,exist_ok=True);shutil.copy2(p,q)
    for p in patches:
        for dry in [True,False]:
            cmd=['patch','--batch','--forward','--fuzz=0','--no-backup-if-mismatch','-p1','-i',str(p)]
            if dry: cmd.append('--dry-run')
            q=subprocess.run(cmd,cwd=scratch,env={**os.environ,"LC_ALL":"C"},text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
            print(q.stdout,end='')
            if q.returncode or re.search(r'offset|fuzz|FAILED|reject|Reversed|malformed',q.stdout,re.I): raise SystemExit('Non-exact patch: '+p.name)
    expected={f:hashlib.sha256((scratch/f).read_bytes()).hexdigest() for f in paths if (scratch/f).is_file()}
    subprocess.run(['git','-C',str(tree),'apply','--index','--check','--whitespace=error',*map(str,patches)],check=True)
    subprocess.run(['git','-C',str(tree),'apply','--index','--whitespace=error',*map(str,patches)],check=True)
    current=state()
    if current['files']!=expected: raise SystemExit('Postimage mismatch')
    receipt.write_text(json.dumps({'key':key,'base':sys.argv[2],'state':current},indent=2)+'\n')
print('Exact patch transaction verified:',len(paths),'paths')
PY
}

_paths() {
    _llvm="$srcdir/llvm-project"; _mingw="$srcdir/mingw-w64"
    _root=$(realpath -m "${LLVM_MINGW_WORKROOT:-$srcdir/.llvm-mingw-build}")
    [[ $_root != / && $_root != "$srcdir" && $_root != "$_llvm" && $_root != "$_mingw" ]] || return 1
    local owner
    owner=$(realpath "$srcdir")
    if [[ -d $_root && ! -f $_root/.llvm-mingw-owner ]]; then
        [[ -z $(find "$_root" -mindepth 1 -maxdepth 1 -print -quit) ]] || { _die "Refusing nonempty unowned workroot: $_root"; return 1; }
    fi
    mkdir -p "$_root"
    if [[ -f $_root/.llvm-mingw-owner ]]; then
        [[ $(<"$_root/.llvm-mingw-owner") == "$owner" ]] || { _die 'Workroot belongs to another source directory'; return 1; }
    else
        printf '%s\n' "$owner" > "$_root/.llvm-mingw-owner"
    fi
    _prefix="$_root/prefix"; _b="$_root/build"
    [[ ! -L $_prefix && ! -L $_b ]] || { _die "Refusing symlinked build/prefix directories"; return 1; }
    _arches=(i686 x86_64)
}

# Automatically select only the profile beside this PKGBUILD. Never silently
# ignore a supplied but unusable file, and never depend on the build-time cwd.
_select_local_profile() {
    local candidate="$_recipe_dir/llvm.profdata"
    _profile=
    if [[ ! -e $candidate && ! -L $candidate ]]; then
        _note "Host PGO disabled: no llvm.profdata beside the PKGBUILD"
        return 0
    fi
    [[ -f $candidate && -r $candidate && -s $candidate ]] || {
        _die "Local profile is not a readable, nonempty regular file: $candidate"
        return 1
    }
    _profile=$(realpath -- "$candidate") || return
    "$_host_bin/llvm-profdata" show "$_profile" >/dev/null || {
        _die "Cannot read local profile with $_host_bin/llvm-profdata: $_profile"
        return 1
    }
    _note "Host PGO enabled: $_profile"
}

_host_setup() {
    local flags=${MAKEFLAGS_ORIG:-${MAKEFLAGS:-}} token next=0 parsed=
    local -a words; read -r -a words <<< "$flags"
    for token in "${words[@]}"; do
        if ((next)); then [[ $token =~ ^[1-9][0-9]*$ ]] && parsed=$token; next=0; fi
        case $token in -j|--jobs) next=1;; -j[0-9]*) parsed=${token#-j};; --jobs=*) parsed=${token#--jobs=};; esac
    done
    _jobs=${JOBS:-${parsed:-$(nproc)}}; _positive JOBS "$_jobs" || return
    local memory links
    memory=$(awk '/MemAvailable:/ {print int($2/6291456)}' /proc/meminfo)
    links=${memory:-1}; ((links>=1)) || links=1; ((links<=8)) || links=8
    _links=${LINK_JOBS:-$links}; _positive LINK_JOBS "$_links" || return
    ((_links<=_jobs)) || _links=$_jobs
    _mode=${LLVM_MINGW_BUILD_MODE:-full}
    [[ $_mode == full || $_mode == smoke ]] || { _die 'LLVM_MINGW_BUILD_MODE must be full or smoke'; return 1; }
    _bool NO_NATIVE "${NO_NATIVE:-0}" || return
    _bool NO_LTO "${NO_LTO:-0}" || return
    _native=native; _i686=native
    [[ ${NO_NATIVE:-0} == 0 ]] || { _native=x86-64-v3; _i686=prescott; }
    _lto=Thin; [[ ${NO_LTO:-0} == 0 ]] || _lto=OFF
    _opt=-O3
    if [[ $_mode == smoke ]]; then _opt=-O1; _lto=OFF; fi
    _host_bin=$(realpath "${HOST_LLVM_BIN:-$(dirname "$(realpath "$(command -v clang)")")}")
    local tool
    for tool in clang clang++ ld.lld llvm-ar llvm-ranlib llvm-nm llvm-objcopy llvm-strip llvm-readelf llvm-profdata; do
        [[ -x $_host_bin/$tool ]] || { _die "Missing host tool: $_host_bin/$tool"; return 1; }
    done
    "$_host_bin/ld.lld" --version >/dev/null || return
    _host_version=$("$_host_bin/clang" -dumpversion)
    [[ ${_host_version%%.*} =~ ^[0-9]+$ && ${_host_version%%.*} -ge 19 ]] || { _die 'LLVM 24 source build needs a sufficiently recent bootstrap (Clang 19+ for this recipe)'; return 1; }
    if [[ $_mode == smoke && ${_host_version%%.*} -lt 23 ]]; then
        _die 'Smoke mode needs Clang 23+ for the LLVM 24 libc++ ABI-annotation pragmas. Full mode builds its own Clang first.'; return 1
    fi
    _select_local_profile || return
    unset CC CXX LD AR AS NM RANLIB STRIP OBJCOPY OBJDUMP READELF HOSTCC HOSTCXX HOSTAR
    unset CPATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH OBJC_INCLUDE_PATH LIBRARY_PATH COMPILER_PATH GCC_EXEC_PREFIX
    unset PKG_CONFIG_PATH PKG_CONFIG_LIBDIR PKG_CONFIG_SYSROOT_DIR CMAKE_PREFIX_PATH SDKROOT
    unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS CCLDFLAGS CXXLDFLAGS ASFLAGS LTOFLAGS MAKEFLAGS LLVM_PROFILE_FILE
    export PATH="$_host_bin:$PATH"
}

_cmake_build() { cmake --build "$1" --parallel "$_jobs"; }
_cmake_install() { cmake --install "$1"; }

_build_host() {
    local z zstd p tools components
    printf -v tools '%s;' "${_llvmtools[@]}"; tools=${tools%;}
    components="clang;clang-resource-headers;clang-scan-deps;clang-format;lld;$tools"
    for p in /usr/lib /usr/lib64 /usr/lib/x86_64-linux-gnu; do
        [[ -f $p/libz.so ]] && z="$p/libz.so"
        [[ -f $p/libzstd.so ]] && zstd="$p/libzstd.so"
    done
    [[ -n ${z:-} && -n ${zstd:-} ]] || { _die 'Shared zlib/zstd development libraries required'; return 1; }
    local -a extra=()
    [[ -z $_profile ]] || extra+=("-DLLVM_PROFDATA_FILE=$_profile")
    cmake -S "$_llvm/llvm" -B "$_b/host" -G Ninja -Wno-dev \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_FLAGS_RELEASE=-DNDEBUG -DCMAKE_CXX_FLAGS_RELEASE=-DNDEBUG -DCMAKE_INSTALL_PREFIX="$_prefix" \
        -DCMAKE_C_COMPILER="$_host_bin/clang" -DCMAKE_CXX_COMPILER="$_host_bin/clang++" \
        -DCMAKE_AR="$_host_bin/llvm-ar" -DCMAKE_RANLIB="$_host_bin/llvm-ranlib" \
        -DCMAKE_C_FLAGS="$_opt -march=$_native -fPIC" \
        -DCMAKE_CXX_FLAGS="$_opt -march=$_native -fPIC" \
        -DCMAKE_POSITION_INDEPENDENT_CODE=ON -DLLVM_ENABLE_PIC=ON \
        -DBUILD_SHARED_LIBS=OFF -DLLVM_BUILD_LLVM_DYLIB=OFF -DLLVM_LINK_LLVM_DYLIB=OFF \
        -DCLANG_LINK_CLANG_DYLIB=OFF -DLLVM_USE_LINKER="$_host_bin/ld.lld" \
        -DLLVM_ENABLE_PROJECTS='clang;lld;polly' -DLLVM_TARGETS_TO_BUILD=X86 \
        -DLLVM_ENABLE_LTO="$_lto" -DLLVM_PARALLEL_LINK_JOBS="$_links" \
        -DLLVM_PARALLEL_TABLEGEN_JOBS=1 -DLLVM_ENABLE_ZLIB=FORCE_ON \
        -DZLIB_LIBRARY="$z" -DZLIB_USE_STATIC_LIBS=OFF \
        -DLLVM_ENABLE_ZSTD=FORCE_ON -Dzstd_LIBRARY="$zstd" -DLLVM_USE_STATIC_ZSTD=OFF \
        -DLLVM_ENABLE_LIBXML2=FORCE_ON -DLLVM_ENABLE_LIBEDIT=OFF \
        -DLLVM_INCLUDE_TESTS=OFF -DLLVM_INCLUDE_EXAMPLES=OFF -DLLVM_INCLUDE_BENCHMARKS=OFF \
        -DLLVM_ENABLE_ASSERTIONS=OFF -DLLVM_ENABLE_RTTI=OFF \
        -DCLANG_INCLUDE_TESTS=OFF -DCLANG_ENABLE_STATIC_ANALYZER=OFF \
        -DCLANG_ENABLE_OBJC_REWRITER=OFF -DLLVM_INSTALL_TOOLCHAIN_ONLY=ON \
        "-DLLVM_TOOLCHAIN_TOOLS=$tools" \
        "-DLLVM_DISTRIBUTION_COMPONENTS=$components" \
        "${extra[@]}" || return
    if [[ $_mode == smoke ]]; then
        # Real patched source compilation, but not a claim of rebuilding Clang.
        cmake --build "$_b/host" --target llvm-tblgen --parallel "$_jobs" || return
        mkdir -p "$_prefix/bin" "$_prefix/lib/clang"
        local tool resource
        for tool in ld.lld lld-link llvm-ar llvm-ranlib llvm-nm llvm-objcopy llvm-strip llvm-readelf llvm-profdata llvm-objdump llvm-readobj llvm-rc llvm-cvtres llvm-dlltool llvm-windres llvm-ml; do
            [[ ! -x $_host_bin/$tool ]] || ln -sfn "$_host_bin/$tool" "$_prefix/bin/$tool"
        done
        resource=$("$_host_bin/clang" -print-resource-dir)
        mkdir -p "$_prefix/lib/clang/$(basename "$resource")"
        cp -a "$resource/include" "$_prefix/lib/clang/$(basename "$resource")/"
        local driver
        for driver in clang clang++; do
            rm -f "$_prefix/bin/$driver"
            cat > "$_prefix/bin/$driver" <<SH
#!/bin/bash
_self=\$(readlink -f -- "\$0")
bin=\${_self%/*}
exec "$_host_bin/$driver" -resource-dir="\$bin/../lib/clang/$(basename "$resource")" "\$@"
SH
            chmod 755 "$_prefix/bin/$driver"
        done
    else
        cmake --build "$_b/host" --target distribution --parallel "$_jobs" || return
        cmake --build "$_b/host" --target install-distribution-stripped --parallel "$_links" || return
    fi
    install -m644 "$_llvm/LICENSE.TXT" "$_prefix/LICENSE.TXT"
}

_write_wrappers() {
    local a t march p
    mkdir -p "$_prefix/bin"
    cat > "$_prefix/bin/clang-target-wrapper" <<'SH'
#!/bin/bash
# Derived from Martin Storsjo / Alec Ari wrappers; see share/licenses/wrappers.txt.
set -euo pipefail
_self=$(readlink -f -- "$0")
bin=${_self%/*}
name=${0##*/}; target=${name%-*}; tool=${name##*-}
[[ $target != "$name" ]] || target=x86_64-w64-mingw32
arch=${target%%-*}
case $target in i686-w64-mingw32|x86_64-w64-mingw32) ;; *) echo "Invalid target wrapper: $name" >&2; exit 2;; esac
last=
for arg in "$@"; do
    if [[ $last == -x && $arg == ada* ]]; then echo 'Ada is not supported' >&2; exit 1; fi
    [[ $arg != -xada* ]] || { echo 'Ada is not supported' >&2; exit 1; }; last=$arg
done
args=(--no-default-config "--config=$bin/$arch-w64-windows-gnu.cfg" "--sysroot=$bin/../$target")
case $tool in clang++|g++|c++) args+=(--driver-mode=g++);; c99) args+=(-std=c99);; c11) args+=(-std=c11);; as) args+=(-c -x assembler);; esac
exec "$bin/clang" "${args[@]}" "$@"
SH
    cat > "$_prefix/bin/ld-wrapper" <<'SH'
#!/bin/bash
set -euo pipefail
_self=$(readlink -f -- "$0")
bin=${_self%/*}; name=${0##*/}
case $name in i686-*) emulation=i386pe;; x86_64-*) emulation=i386pep;; *) exit 2;; esac
exec "$bin/ld.lld" -m "$emulation" "$@"
SH
    cat > "$_prefix/bin/objdump-wrapper" <<'SH'
#!/bin/bash
set -euo pipefail
_self=$(readlink -f -- "$0")
bin=${_self%/*}
for arg in "$@"; do
    if [[ $arg == -f || $arg == --file-headers ]]; then
        out=$("$bin/llvm-objdump" "$@")
        out=${out//file format coff-i386/file format pe-i386}
        out=${out//file format coff-x86-64/file format pe-x86-64}
        printf '%s\n' "$out"; exit 0
    fi
done
exec "$bin/llvm-objdump" "$@"
SH
    chmod 755 "$_prefix/bin/"{clang-target-wrapper,ld-wrapper,objdump-wrapper}
    for a in "${_arches[@]}"; do
        t=$a-w64-mingw32; march=$_native; [[ $a != i686 ]] || march=$_i686
        printf '%s\n' "--target=$t" -rtlib=compiler-rt -unwindlib=libunwind -stdlib=libc++ -fuse-ld=lld -O3 "-march=$march" > "$_prefix/bin/$a-w64-windows-gnu.cfg"
        [[ $a != i686 ]] || printf '%s\n' -mfpmath=sse >> "$_prefix/bin/$a-w64-windows-gnu.cfg"
        [[ $_mode != full ]] || printf '%s\n' -mllvm -polly >> "$_prefix/bin/$a-w64-windows-gnu.cfg"
        for p in gcc g++ cc c++ clang clang++ as; do ln -sfn clang-target-wrapper "$_prefix/bin/$t-$p"; done
        ln -sfn llvm-ar "$_prefix/bin/$t-llvm-ar"
        ln -sfn llvm-ranlib "$_prefix/bin/$t-llvm-ranlib"
        [[ ! -x $_prefix/bin/clang-scan-deps ]] || ln -sfn clang-scan-deps "$_prefix/bin/$t-clang-scan-deps"
        ln -sfn ld-wrapper "$_prefix/bin/$t-ld"
        ln -sfn objdump-wrapper "$_prefix/bin/$t-objdump"
        for p in ar ranlib nm objcopy readelf size strings strip windres dlltool addr2line; do
            [[ ! -x $_prefix/bin/llvm-$p ]] || ln -sfn "llvm-$p" "$_prefix/bin/$t-$p"
        done
    done
}

_target_flags() {
    local march=$_native
    [[ $1 != i686 ]] || march=$_i686
    _tflags="--no-default-config $_opt -march=$march"
    [[ $1 != i686 ]] || _tflags+=' -mfpmath=sse'
    [[ $_mode != full ]] || _tflags+=' -mllvm -polly'
}

_target_env() {
    local t=$1; shift
    _target_flags "${t%%-*}"
    env CC="$_prefix/bin/clang --no-default-config --target=$t --sysroot=$_prefix/$t --start-no-unused-arguments -rtlib=compiler-rt -unwindlib=none --end-no-unused-arguments" \
        CXX="$_prefix/bin/clang++ --no-default-config --target=$t --sysroot=$_prefix/$t --start-no-unused-arguments -rtlib=compiler-rt -unwindlib=none --end-no-unused-arguments" \
        AR="$_prefix/bin/llvm-ar" RANLIB="$_prefix/bin/llvm-ranlib" \
        NM="$_prefix/bin/llvm-nm" STRIP="$_prefix/bin/llvm-strip" \
        DLLTOOL="$_prefix/bin/llvm-dlltool" WINDRES="$_prefix/bin/$t-windres" \
        OBJDUMP="$_prefix/bin/$t-objdump" CFLAGS="$_tflags" CXXFLAGS="$_tflags" LDFLAGS=-fuse-ld=lld "$@"
}

_build_headers_crt() {
    mkdir -p "$_b/headers"
    (cd "$_b/headers" || exit; CC="$_host_bin/clang" "$_mingw/mingw-w64-headers/configure" --prefix="$_prefix/generic-w64-mingw32" --enable-idl --with-default-win32-winnt=0x0A00 --with-default-msvcrt=ucrt INSTALL="install -C" || exit; make install INSTALL="install -C") || return
    local a t header
    for a in "${_arches[@]}"; do
        t=$a-w64-mingw32
        mkdir -p "$_prefix/$t/include" "$_b/crt-$a"
        [[ ! -L $_prefix/$t/include ]] || { _die 'Old shared include layout: use a clean prefix'; return 1; }
        # Shared Windows headers, but independent C++/OpenMP configuration headers.
        for header in "$_prefix/generic-w64-mingw32/include/"*; do
            # winpthreads replaces several CRT stub headers with real files.
            # Recreating their symlinks here would force needless C++/OpenMP
            # recompilation on every invocation, despite identical final data.
            if [[ ! -e $_prefix/$t/include/${header##*/} && ! -L $_prefix/$t/include/${header##*/} ]]; then
                ln -s "../../generic-w64-mingw32/include/${header##*/}" "$_prefix/$t/include/${header##*/}"
            fi
        done
        local -a flags=(--enable-lib32 --disable-lib64)
        [[ $a != x86_64 ]] || flags=(--disable-lib32 --enable-lib64)
        (set -e; cd "$_b/crt-$a" || exit
         _target_env "$t" "$_mingw/mingw-w64-crt/configure" --host="$t" --prefix="$_prefix/$t" --with-default-msvcrt=ucrt --enable-silent-rules "${flags[@]}" || exit
         make -j"$_jobs" || exit; make install INSTALL="install -C") || return
        # mingw-w64 supplies SSP in libmingwex; these are compatibility names,
        # not fake implementations. Verify the implementation before providing them.
        "$_prefix/bin/llvm-nm" --defined-only "$_prefix/$t/lib/libmingwex.a" > "$_b/ssp-$a.log" || return
        grep -q '__stack_chk_fail' "$_b/ssp-$a.log" || return
        "$_prefix/bin/llvm-ar" rcs "$_prefix/$t/lib/libssp.a" || return
        "$_prefix/bin/llvm-ar" rcs "$_prefix/$t/lib/libssp_nonshared.a" || return
        mkdir -p "$_prefix/$t/share/mingw32"
        install -m644 "$_mingw/COPYING" "$_mingw/COPYING.MinGW-w64/COPYING.MinGW-w64.txt" "$_mingw/COPYING.MinGW-w64-runtime/COPYING.MinGW-w64-runtime.txt" "$_prefix/$t/share/mingw32/"
    done
}

_cross_options() {
    local a=$1 t=$1-w64-mingw32
    _target_flags "$a"
    _cross=(-G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_FLAGS_RELEASE=-DNDEBUG -DCMAKE_CXX_FLAGS_RELEASE=-DNDEBUG -DCMAKE_SYSTEM_NAME=Windows
        "-DCMAKE_C_COMPILER=$_prefix/bin/clang" "-DCMAKE_CXX_COMPILER=$_prefix/bin/clang++"
        "-DCMAKE_ASM_COMPILER=$_prefix/bin/clang" "-DCMAKE_C_COMPILER_TARGET=$t"
        "-DCMAKE_CXX_COMPILER_TARGET=$t" "-DCMAKE_ASM_COMPILER_TARGET=$t"
        "-DCMAKE_SYSROOT=$_prefix/$t" "-DCMAKE_AR=$_prefix/bin/llvm-ar"
        "-DCMAKE_RANLIB=$_prefix/bin/llvm-ranlib" "-DCMAKE_INSTALL_PREFIX=$_prefix/$t"
        "-DCMAKE_C_FLAGS=$_tflags" "-DCMAKE_CXX_FLAGS=$_tflags -stdlib=libc++"
        "-DCMAKE_FIND_ROOT_PATH=$_prefix/$t" -DCMAKE_FIND_ROOT_PATH_MODE_PROGRAM=NEVER
        -DCMAKE_FIND_ROOT_PATH_MODE_INCLUDE=ONLY -DCMAKE_FIND_ROOT_PATH_MODE_LIBRARY=ONLY
        -DCMAKE_FIND_ROOT_PATH_MODE_PACKAGE=ONLY -DCMAKE_TRY_COMPILE_TARGET_TYPE=STATIC_LIBRARY)
    # STATIC_LIBRARY is legitimate during runtime bootstrapping; check() performs
    # real executable links afterward. Never force CMAKE_*_COMPILER_WORKS.
}

_build_builtins() {
    local a resource
    resource=$("$_prefix/bin/clang" -print-resource-dir)
    # A smoke build must never install into the system/bootstrap resource dir.
    if [[ $_mode == smoke ]]; then resource="$_prefix/lib/clang/$(basename "$resource")"; fi
    for a in "${_arches[@]}"; do
        _cross_options "$a"
        cmake -S "$_llvm/compiler-rt/lib/builtins" -B "$_b/builtins-$a" "${_cross[@]}" \
            -DCMAKE_INSTALL_PREFIX="$resource" -DCOMPILER_RT_DEFAULT_TARGET_ONLY=ON \
            -DCOMPILER_RT_EXCLUDE_ATOMIC_BUILTIN=OFF -DCOMPILER_RT_INCLUDE_TESTS=OFF || return
        _cmake_build "$_b/builtins-$a" || return
        _cmake_install "$_b/builtins-$a" || return
    done
}

_build_pthreads() {
    local a t
    for a in "${_arches[@]}"; do
        t=$a-w64-mingw32; mkdir -p "$_b/pthreads-$a"
        (set -e; cd "$_b/pthreads-$a" || exit
         _target_env "$t" "$_mingw/mingw-w64-libraries/winpthreads/configure" --host="$t" --prefix="$_prefix/$t" --enable-shared --enable-static --enable-silent-rules || exit
         make -j"$_jobs" || exit; make install INSTALL="install -C") || return
        install -Dm644 "$_mingw/mingw-w64-libraries/winpthreads/COPYING" "$_prefix/$t/share/mingw32/COPYING.winpthreads.txt"
    done
}

_build_cxx() {
    local a
    for a in "${_arches[@]}"; do
        _cross_options "$a"
        cmake -S "$_llvm/runtimes" -B "$_b/cxx-$a" "${_cross[@]}" \
            '-DLLVM_ENABLE_RUNTIMES=libunwind;libcxxabi;libcxx' \
            -DBUILD_SHARED_LIBS=OFF -DLIBUNWIND_USE_COMPILER_RT=ON -DLIBUNWIND_ENABLE_SHARED=OFF -DLIBUNWIND_ENABLE_STATIC=ON \
            -DLIBCXX_USE_COMPILER_RT=ON -DLIBCXX_ENABLE_SHARED=OFF -DLIBCXX_ENABLE_STATIC=ON \
            -DLIBCXX_ENABLE_STATIC_ABI_LIBRARY=ON -DLIBCXX_CXX_ABI=libcxxabi -DLIBCXX_INCLUDE_TESTS=OFF \
            -DLIBCXX_INSTALL_MODULES=ON "-DLIBCXX_INSTALL_MODULES_DIR=$_prefix/share/libc++/v1" \
            -DLIBCXX_ENABLE_ABI_LINKER_SCRIPT=OFF -DLIBCXXABI_USE_COMPILER_RT=ON \
            -DLIBCXXABI_USE_LLVM_UNWINDER=ON -DLIBCXXABI_ENABLE_SHARED=OFF -DLIBCXXABI_ENABLE_STATIC=ON \
            "-DCMAKE_C_FLAGS=$_tflags -D__USE_MINGW_ANSI_STDIO=1" \
            "-DCMAKE_CXX_FLAGS=$_tflags -stdlib=libc++ -D__USE_MINGW_ANSI_STDIO=1" || return
        _cmake_build "$_b/cxx-$a" || return
        _cmake_install "$_b/cxx-$a" || return
    done
}

_build_tools() {
    local a d
    mkdir -p "$_b/gendef"
    (set -e; cd "$_b/gendef" || exit
     CC="$_host_bin/clang" CFLAGS="-O3 -march=$_native" LDFLAGS=-fuse-ld=lld "$_mingw/mingw-w64-tools/gendef/configure" --prefix="$_prefix" || exit
     make -j"$_jobs" || exit; make install-strip) || return
    # WIDL selects its target from argv[0], not the native executable's ELF
    # architecture. One build suffices; preserve argv[0] through the wrapper.
    a=${_arches[0]}; d="$_b/widl-$a"; mkdir -p "$d"
    (set -e; cd "$d" || exit
     CC="$_host_bin/clang" CFLAGS="-O3 -march=$_native" LDFLAGS=-fuse-ld=lld "$_mingw/mingw-w64-tools/widl/configure" --prefix="$_prefix" --target="$a-w64-mingw32" --with-widl-includedir=/opt/llvm-mingw/generic-w64-mingw32/include --enable-silent-rules || exit
     make -j"$_jobs" || exit
     rm -f "$_prefix/bin/$a-w64-mingw32-widl" || exit
     make install-strip) || return
    mv -f "$_prefix/bin/$a-w64-mingw32-widl" "$_prefix/bin/widl-real"
    cat > "$_prefix/bin/widl-wrapper" <<'SH'
#!/bin/bash
set -euo pipefail
_self=$(readlink -f -- "$0")
bin=${_self%/*}
exec -a "$bin/${0##*/}" "$bin/widl-real" -I "$bin/../generic-w64-mingw32/include" "$@"
SH
    chmod 755 "$_prefix/bin/widl-wrapper"
    for a in "${_arches[@]}"; do ln -sfn widl-wrapper "$_prefix/bin/$a-w64-mingw32-widl"; done
    ln -sfn widl-wrapper "$_prefix/bin/widl"
}

_build_openmp() {
    local a
    for a in "${_arches[@]}"; do
        _cross_options "$a"
        cmake -S "$_llvm/runtimes" -B "$_b/openmp-$a" "${_cross[@]}" \
            -DLLVM_ENABLE_RUNTIMES=openmp -DLIBOMP_ENABLE_SHARED=ON -DLIBOMP_INSTALL_ALIASES=OFF \
            -DCMAKE_TRY_COMPILE_TARGET_TYPE=EXECUTABLE \
            "-DCMAKE_RC_COMPILER=$_prefix/bin/$a-w64-mingw32-windres" \
            "-DCMAKE_ASM_MASM_COMPILER=$_prefix/bin/llvm-ml" "-DLIBOMP_ASMFLAGS=-m$([[ $a == i686 ]] && echo 32 || echo 64)" \
            '-DCMAKE_EXE_LINKER_FLAGS=-rtlib=compiler-rt -unwindlib=libunwind -stdlib=libc++ -fuse-ld=lld' \
            '-DCMAKE_SHARED_LINKER_FLAGS=-rtlib=compiler-rt -unwindlib=libunwind -stdlib=libc++ -fuse-ld=lld' || return
        _cmake_build "$_b/openmp-$a" || return
        _cmake_install "$_b/openmp-$a" || return
        # The Windows install branch ignores LIBOMP_INSTALL_ALIASES and copies
        # Intel-name aliases unconditionally. Keep the original package policy.
        find "$_prefix/$a-w64-mingw32/bin" "$_prefix/$a-w64-mingw32/lib" -maxdepth 1 -name '*iomp5md*' -delete || return
    done
}

build() (
    set -euo pipefail
    _paths; rm -f "$_root/build-complete" "$_root/check-complete"; _host_setup
    # This calls the same validating prepare path for --noextract/incremental use.
    prepare
    mkdir -p "$_b" "$_prefix"
    # Refuse a changed configuration in an existing build, rather than mixing
    # installed libraries from incompatible builds. Choose another workroot.
    local key
    key=$( { printf '%s\n' "$_mode" "$_native" "$_i686" "$_lto" "$_host_bin" "$_host_version" "$_profile"; [[ -z $_profile ]] || sha256sum "$_profile"; cat "$srcdir/.llvm-mingw-patches.json"; sha256sum "$startdir/PKGBUILD"; } | sha256sum | cut -d' ' -f1)
    if [[ -f $_root/config-key && $(<"$_root/config-key") != "$key" ]]; then
        _die 'Build configuration changed. Choose a new LLVM_MINGW_WORKROOT (or remove this dedicated workroot after saving anything needed).'; exit 1
    fi
    printf '%s\n' "$key" > "$_root/config-key"
    _note "Building $pkgname ($_mode), jobs=$_jobs links=$_links; host=$_host_bin"
    _build_host
    _write_wrappers
    export PATH="$_prefix/bin:$_host_bin:$PATH"
    _build_headers_crt
    _build_builtins
    _build_pthreads
    _build_cxx
    _build_tools
    _build_openmp
    mkdir -p "$_prefix/share/licenses"
    cat > "$_prefix/share/licenses/wrappers.txt" <<'LICENSE'
Copyright (c) 2018 Martin Storsjo
Copyright (c) 2026 Alec Ari
Permission to use, copy, modify, and/or distribute this software for any
purpose with or without fee is hereby granted, provided that the above
copyright notice and this permission notice appear in all copies.
THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL WARRANTIES
WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF
MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR
ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES
WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN
ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF
OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
LICENSE
    install -m644 "$_mingw/COPYING" "$_prefix/share/licenses/mingw-w64.txt"
    install -m644 "$_mingw/mingw-w64-tools/gendef/COPYING" "$_prefix/share/licenses/gendef-GPL3.txt"
    sed '/^ \*\//q' "$_mingw/mingw-w64-tools/widl/src/widl.c" > "$_prefix/share/licenses/widl-notice.txt"
    printf '%s\n' "mode=$_mode" "llvm=$_llvmref" "mingw=$_mingwref" "config=$key" > "$_root/build-complete"
)

check() (
    set -euo pipefail
    _paths
    [[ -s $_root/build-complete ]] || { _die 'Build did not complete'; exit 1; }
    rm -f "$_root/check-complete"
    mkdir -p "$_root/check"
    cat > "$_root/check/c.c" <<'C'
#include <windows.h>
#include <stdint.h>
__attribute__((noinline)) int guard(const char *p) { char b[64]; lstrcpynA(b,p,sizeof b); return b[0]; }
int main(void) { return guard("x") != 'x' || GetCurrentProcessId()==0; }
C
    cat > "$_root/check/cxx.cpp" <<'CXX'
#include <vector>
#include <thread>
#include <stdexcept>
int main() { std::vector<int> v{20,22}; int value=0; std::thread t([&]{value=v[0]+v[1];}); t.join();
 try { throw std::runtime_error("test"); } catch (const std::exception&) { return value!=42; } }
CXX
    cat > "$_root/check/pthread.c" <<'C'
#include <pthread.h>
static void *worker(void *p) { *(int*)p=42; return 0; }
int main(void) { int v=0; pthread_t t; if(pthread_create(&t,0,worker,&v)) return 2;
 if(pthread_join(t,0)) return 3; return v!=42; }
C
    cat > "$_root/check/omp.c" <<'C'
#include <omp.h>
int main(void) { int n=0;
#pragma omp parallel reduction(+:n)
 n+=1;
 return n<1; }
C
    printf '1 RCDATA { 1, 2, 3, 4 }\n' > "$_root/check/resource.rc"
    printf 'import "oaidl.idl";\n' > "$_root/check/headers.idl"
    local a t f
    for a in "${_arches[@]}"; do
        t=$a-w64-mingw32
        for f in c cxx pthread omp resource; do
            local compiler=clang test_source=c.c
            local -a extra=()
            case $f in
                cxx) compiler=clang++; test_source=cxx.cpp;;
                pthread) test_source=pthread.c; extra+=(-lwinpthread);;
                omp) test_source=omp.c; extra+=(-fopenmp);;
                resource)
                    "$_prefix/bin/$t-windres" "$_root/check/resource.rc" -o "$_root/check/$a-resource.o"
                    extra+=("$_root/check/$a-resource.o");;
            esac
            "$_prefix/bin/$t-$compiler" -O2 -flto -fstack-protector-strong "$_root/check/$test_source" "${extra[@]}" -o "$_root/check/$a-$f.exe"
            "$_prefix/bin/llvm-readobj" --file-headers --coff-imports "$_root/check/$a-$f.exe" > "$_root/check/$a-$f.headers"
            local machine=IMAGE_FILE_MACHINE_I386
            [[ $a != x86_64 ]] || machine=IMAGE_FILE_MACHINE_AMD64
            grep -q "$machine" "$_root/check/$a-$f.headers"
            if [[ ${LLVM_MINGW_RUN_WINE:-0} == 1 ]]; then WINEPATH=$(winepath -w "$_prefix/$t/bin") wine "$_root/check/$a-$f.exe"; fi
        done
        "$_prefix/bin/llvm-nm" "$_root/check/$a-c.exe" > "$_root/check/$a-c.symbols"
        grep -q '__stack_chk_fail' "$_root/check/$a-c.symbols"
        "$_prefix/bin/$t-objdump" -f "$_root/check/$a-c.exe" > "$_root/check/$a-objdump.txt"
        grep -q 'file format pe-' "$_root/check/$a-objdump.txt"
        "$_prefix/bin/$t-widl" -h -H "$_root/check/$a-widl.h" "$_root/check/headers.idl"
    done
    touch "$_root/check-complete"
)

package() {
    _paths || return
    [[ -f $_root/build-complete && -f $_root/check-complete ]] || { _die 'Build/check completion required; do not use --nocheck'; return 1; }
    grep -qx 'mode=full' "$_root/build-complete" || { _die 'A smoke build is not a distributable LLVM toolchain'; return 1; }
    install -dm755 "$pkgdir/opt/llvm-mingw"
    cp -a "$_prefix/." "$pkgdir/opt/llvm-mingw/"
    install -Dm644 "$_llvm/LICENSE.TXT" "$pkgdir/usr/share/licenses/$pkgname/LLVM-LICENSE.txt"
    install -Dm644 "$_mingw/COPYING" "$pkgdir/usr/share/licenses/$pkgname/MINGW-COPYING.txt"
}
