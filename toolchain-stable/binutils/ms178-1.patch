From: ms178 <ms178@users.noreply.github.com>
Subject: [PATCH] binutils: gas speedups, consistent best-compression debug
 sections, and gold configure BPF-target tolerance

Consolidated binutils patch for the Arch/CachyOS toolchain build.

  A. gas: skip locale initialisation at startup (setlocale/bindtextdomain/
     textdomain).  Saves startup cost in the hot assembler path.
  B. gas: read the primary input file with mmap ('rm' mode).
  C. gas AND bfd/objcopy: compress debug sections with Z_BEST_COMPRESSION.
     Keeping only gas at Z_BEST while bfd used compress() (Z_DEFAULT)
     made 'as --compress-debug-sections' and 'objcopy --compress-debug-
     sections' produce different bytes, failing the cross-compression
     tests in binutils/testsuite/binutils-all/compress.exp.  Use
     Z_BEST_COMPRESSION in both so the tools agree (and the compressed
     debug output stays as small as possible).  Works regardless of
     whether the system zlib is stock or zlib-ng (CachyOS), because the
     comparison is within one build, both linked against the same zlib.
  D. gold: turn 'unsupported target' from a configure error into a warning
     (the BPF auxiliary target is not recognised by gold; the ld/bfd
     BPF-matching hunks are already upstream in 2.47).

NOTE on the .debug_addr readelf diagnostic: it is intentionally kept as
 upstream (one warning per indexed-address attribute).  The binutils
 tests pr26160 and pr26808 EXPECT this warning, so any attempt to silence
 it breaks the testsuite.  It correctly flags a CU that references an
 address table in a companion file.

VALIDATION: applies cleanly (fuzz=0) to binutils-gdb commit
 923cf4d372cf129cf7e77acf81ed1045c084ee4e (binutils 2.47.0).  Built with
 the ms178 GCC 16.1.1 + glibc 2.44 toolchain and run the testsuite:
   binutils: 348 expected passes, 0 failures
   gas:      2098 expected passes, 0 failures
 (previously compress.exp failed 5 tests and readelf.exp pr26160/pr26808
  failed).

=====================================================================
diff --git a/bfd/compress.c b/bfd/compress.c
index c9710178f3..4f67a2bd36 100644
--- a/bfd/compress.c
+++ b/bfd/compress.c
@@ -669,8 +669,9 @@ bfd_compress_section_contents (bfd *abfd, sec_ptr sec)
 	    }
 #endif
 	}
-      else if (compress ((Bytef *) buffer + new_header_size, &compressed_size,
-			 (const Bytef *) input_buffer, uncompressed_size)
+      else if (compress2 ((Bytef *) buffer + new_header_size, &compressed_size,
+			  (const Bytef *) input_buffer, uncompressed_size,
+			  Z_BEST_COMPRESSION)
 	       != Z_OK)
 	{
 	  bfd_release (abfd, buffer);
diff --git a/gas/as.c b/gas/as.c
index b652e81286..156d6971a7 100644
--- a/gas/as.c
+++ b/gas/as.c
@@ -1327,12 +1327,6 @@ gas_early_init (int *argcp, char ***argvp)
   start_time = get_run_time ();
   signal_init ();
 
-#ifdef HAVE_LC_MESSAGES
-  setlocale (LC_MESSAGES, "");
-#endif
-  setlocale (LC_CTYPE, "");
-  bindtextdomain (PACKAGE, LOCALEDIR);
-  textdomain (PACKAGE);
 
   if (debug_memory)
     chunksize = 64;
diff --git a/gas/compress-debug.c b/gas/compress-debug.c
index 3a2744d031..e3db226109 100644
--- a/gas/compress-debug.c
+++ b/gas/compress-debug.c
@@ -41,7 +41,7 @@ compress_init (bool use_zstd)
 
   static struct z_stream_s strm;
   memset (&strm, 0, sizeof (strm));
-  deflateInit (&strm, Z_DEFAULT_COMPRESSION);
+  deflateInit (&strm, Z_BEST_COMPRESSION);
   return &strm;
 }
 
diff --git a/gas/input-file.c b/gas/input-file.c
index eb8499f5ad..03f4b66a32 100644
--- a/gas/input-file.c
+++ b/gas/input-file.c
@@ -125,7 +125,7 @@ input_file_open (const char *filename,
   gas_assert (filename != 0);	/* Filename may not be NULL.  */
   if (filename[0])
     {
-      f_in = fopen (filename, FOPEN_RT);
+      f_in = fopen (filename, "rm");
       file_name = filename;
     }
   else
diff --git a/gold/configure b/gold/configure
index a81a04f053..cf8b3a8447 100755
--- a/gold/configure
+++ b/gold/configure
@@ -5277,7 +5277,8 @@ for targ in $target $canon_targets; do
     . ${srcdir}/configure.tgt
 
     if test "$targ_obj" = "UNKNOWN"; then
-      as_fn_error $? "\"unsupported target $targ\"" "$LINENO" 5
+      { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: \"unsupported target $targ\"" >&5
+$as_echo "$as_me: WARNING: \"unsupported target $targ\"" >&2;}
     else
       targetobjs="$targetobjs ${targ_obj}.\$(OBJEXT)"
       if test "$targ_extra_obj" != ""; then
diff --git a/gold/configure.ac b/gold/configure.ac
index fe6ace0169..880209e673 100644
--- a/gold/configure.ac
+++ b/gold/configure.ac
@@ -182,7 +182,7 @@ for targ in $target $canon_targets; do
     . ${srcdir}/configure.tgt
 
     if test "$targ_obj" = "UNKNOWN"; then
-      AC_MSG_ERROR("unsupported target $targ")
+      AC_MSG_WARN("unsupported target $targ")
     else
       targetobjs="$targetobjs ${targ_obj}.\$(OBJEXT)"
       if test "$targ_extra_obj" != ""; then
