From: ms178 <ms178@users.noreply.github.com>
Subject: [PATCH] binutils: gas startup/IO speedups, best-compression debug
 sections, and gold configure BPF-target tolerance

Consolidated binutils patch for the Arch/CachyOS toolchain build.  It
replaces the previous gold-warn-unsupported.patch, compilespeed.patch and
zlib-level.patch (and drops the obsolete 0001-strip patch, whose PR33246
fat-IR handling is already present in mainline binutils 2.47).

  A. gas: skip locale initialisation at startup (setlocale/bindtextdomain/
     textdomain).  Saves startup cost in the hot assembler path; messages
     are emitted as plain (English) text.  [was compilespeed.patch]

  B. gas: read the primary input file with mmap ('rm' mode).  Faster input
     for large sources.  [was compilespeed.patch]

  C. gas: use Z_BEST_COMPRESSION when assembling .debug_* sections.  Smaller
     compressed debug output (trade-off: slightly slower assembly).
     [was zlib-level.patch]

  D. gold: turn 'unsupported target' from a configure error into a warning.
     With --enable-targets=x86_64-pep,bpf-unknown-none the BPF target is
     not recognised by gold (gold is not the default linker), so a hard
     error aborted configure.  Warning lets the build proceed.  [was
     gold-warn-unsupported.patch; the ld/bfd BPF-matching hunks are now
     upstream in 2.47, and the previous 'NO REALLY'/'Honest.' fallback-text
     edits are dropped.]

VALIDATION: applies cleanly (fuzz=0) to binutils-gdb commit
 923cf4d372cf129cf7e77acf81ed1045c084ee4e (binutils 2.47); host build of
 bfd+opcodes+gas confirmed (see VALIDATION_REPORT.md).

=====================================================================
diff --git a/gas/as.c b/gas/as.c
index b652e81286..156d6971a7 100644
--- a/gas/as.c
+++ b/gas/as.c
@@ -1327,12 +1327,6 @@ gas_early_init (int *argcp, char ***argvp)
   start_time = get_run_time ();
   signal_init ();
 
-#ifdef HAVE_LC_MESSAGES
-  setlocale (LC_MESSAGES, "");
-#endif
-  setlocale (LC_CTYPE, "");
-  bindtextdomain (PACKAGE, LOCALEDIR);
-  textdomain (PACKAGE);
 
   if (debug_memory)
     chunksize = 64;
diff --git a/gas/compress-debug.c b/gas/compress-debug.c
index 3a2744d031..e3db226109 100644
--- a/gas/compress-debug.c
+++ b/gas/compress-debug.c
@@ -41,7 +41,7 @@ compress_init (bool use_zstd)
 
   static struct z_stream_s strm;
   memset (&strm, 0, sizeof (strm));
-  deflateInit (&strm, Z_DEFAULT_COMPRESSION);
+  deflateInit (&strm, Z_BEST_COMPRESSION);
   return &strm;
 }
 
diff --git a/gas/input-file.c b/gas/input-file.c
index eb8499f5ad..03f4b66a32 100644
--- a/gas/input-file.c
+++ b/gas/input-file.c
@@ -125,7 +125,7 @@ input_file_open (const char *filename,
   gas_assert (filename != 0);	/* Filename may not be NULL.  */
   if (filename[0])
     {
-      f_in = fopen (filename, FOPEN_RT);
+      f_in = fopen (filename, "rm");
       file_name = filename;
     }
   else
diff --git a/gold/configure b/gold/configure
index a81a04f053..cf8b3a8447 100755
--- a/gold/configure
+++ b/gold/configure
@@ -5277,7 +5277,8 @@ for targ in $target $canon_targets; do
     . ${srcdir}/configure.tgt
 
     if test "$targ_obj" = "UNKNOWN"; then
-      as_fn_error $? "\"unsupported target $targ\"" "$LINENO" 5
+      { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: \"unsupported target $targ\"" >&5
+$as_echo "$as_me: WARNING: \"unsupported target $targ\"" >&2;}
     else
       targetobjs="$targetobjs ${targ_obj}.\$(OBJEXT)"
       if test "$targ_extra_obj" != ""; then
diff --git a/gold/configure.ac b/gold/configure.ac
index fe6ace0169..880209e673 100644
--- a/gold/configure.ac
+++ b/gold/configure.ac
@@ -182,7 +182,7 @@ for targ in $target $canon_targets; do
     . ${srcdir}/configure.tgt
 
     if test "$targ_obj" = "UNKNOWN"; then
-      AC_MSG_ERROR("unsupported target $targ")
+      AC_MSG_WARN("unsupported target $targ")
     else
       targetobjs="$targetobjs ${targ_obj}.\$(OBJEXT)"
       if test "$targ_extra_obj" != ""; then
